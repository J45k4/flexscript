// Deferred canonicalization keeps intermediate floats in registers.
// Tag bits: low/high FP32 1/2; FP64 4; negative low/high NaN 8/16;
// signed high-lane extraction 64. Every observable word is normalized.
fn cc_builtins(){
    p_text("// Flexscript CPU kernel ABI1; C++17, -O3 -fno-fast-math -ffp-contract=off\n");
    p_text("// Generated intermediate; the application remains Flexscript.\n");
    p_text("#include <stdint.h>\n");
    p_text("#include <string.h>\n");
    p_text("#include <math.h>\n");
    p_text("#include <xmmintrin.h>\n");
    p_text("#if !defined(__x86_64__)\n");
    p_text("#error CPU kernels currently require x86-64\n");
    p_text("#endif\n");
    p_text("static_assert(sizeof(uintptr_t)==8,\"64-bit word ABI required\");\n");
    p_text("#define CC_INLINE __attribute__((always_inline)) inline\n");
    p_text("#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__\n");
    p_text("#error CPU kernels currently require little endian\n");
    p_text("#endif\n");
    p_text("struct W {\n");
    p_text(" uint64_t raw, tag;\n");
    p_text(" W(uint64_t v=0):raw(v),tag(0){}\n");
    p_text(" W(uint64_t v,uint64_t t):raw(v),tag(t){}\n");
    p_text(" __attribute__((always_inline)) operator uint64_t()const{\n");
    p_text("  uint64_t v=raw;\n");
    p_text("  if(tag&4){if((v&0x7fffffffffffffffULL)>0x7ff0000000000000ULL)v=0x7ff8000000000000ULL;return v;}\n");
    p_text("  if((tag&1) && ((uint32_t)v&0x7fffffffU)>0x7f800000U){uint32_t n=(tag&8)?0xffc00000U:0x7fc00000U;v=(v&0xffffffff00000000ULL)|n;if(tag&64)v=(uint64_t)(int64_t)(int32_t)n;}\n");
    p_text("  if((tag&2) && (((uint32_t)(v>>32))&0x7fffffffU)>0x7f800000U)v=(v&0xffffffffULL)|((tag&16)?0xffc0000000000000ULL:0x7fc0000000000000ULL);\n");
    p_text("  return v;\n");
    p_text(" }\n");
    p_text("};\n");
    p_text("static CC_INLINE W operator^(W a,W b){if(!b.tag && b.raw==0x80000000ULL && (a.tag==1 || a.tag==9))return W(a.raw^b.raw,a.tag^8);return W((uint64_t)a^(uint64_t)b);}\n");
    p_text("static CC_INLINE W operator&(W a,W b){\n");
    p_text(" if(!b.tag && b.raw==0xffffffffULL && !(a.tag&4))return W(a.raw&b.raw,a.tag&9);\n");
    p_text(" if(!b.tag && b.raw==0x7fffffffULL && (a.tag==1 || a.tag==9))return W(a.raw&b.raw,1);\n");
    p_text(" return W((uint64_t)a&(uint64_t)b);\n");
    p_text("}\n");
    p_text("static CC_INLINE W operator|(W a,W b){\n");
    p_text(" if(!(a.tag&~9ULL) && !(b.tag&~18ULL) && !(a.raw>>32) && !(uint32_t)b.raw)return W(a.raw|b.raw,a.tag|b.tag);\n");
    p_text(" if(!(b.tag&~9ULL) && !(a.tag&~18ULL) && !(b.raw>>32) && !(uint32_t)a.raw)return W(a.raw|b.raw,a.tag|b.tag);\n");
    p_text(" return W((uint64_t)a|(uint64_t)b);\n");
    p_text("}\n");
    p_text("static CC_INLINE W cc_shl(W a,W b){uint64_t n=(uint64_t)b&63;if(!n)return a;if(n==32 && !(a.tag&4))return W(a.raw<<32,(a.tag&1)*2+(a.tag&8)*2);return W((uint64_t)a<<n);}\n");
    p_text("static CC_INLINE W cc_shr(W a,W b){uint64_t n=(uint64_t)b&63;if(!n)return a;if(n==32 && !(a.tag&4))return W((uint64_t)((int64_t)a.raw>>32),(a.tag&2)/2+(a.tag&16)/2+((a.tag&2)?64:0));return W((uint64_t)((int64_t)(uint64_t)a>>n));}\n");
    p_text("\n");
    p_text("static CC_INLINE W hp_unaligned_load(W p){W v;memcpy(&v,(void*)(uintptr_t)p,8);return v;}\n");
    p_text("static CC_INLINE W hp_unaligned_store(W p,W v){uint64_t raw=(uint64_t)v;memcpy((void*)(uintptr_t)p,&raw,8);return v;}\n");
    p_text("static CC_INLINE W hp_div(W a,W b,int rem){if(!b || (a==0x8000000000000000ULL && b==~0ULL))__builtin_trap();return rem?(W)((int64_t)a%(int64_t)b):(W)((int64_t)a/(int64_t)b);}\n");
    p_text("static CC_INLINE float cc_float(W a){uint32_t w=(uint32_t)((a.tag&4)?(uint64_t)a:a.raw);float v;memcpy(&v,&w,4);return v;}\n");
    p_text("static CC_INLINE double cc_double(W a){double v;uint64_t bits=(a.tag&4)?a.raw:(uint64_t)a;memcpy(&v,&bits,8);return v;}\n");
    p_text("static CC_INLINE W cc_bits32(float f){uint32_t w;memcpy(&w,&f,4);return W(w,1);}\n");
    p_text("static CC_INLINE W cc_bits64(double f){uint64_t w;memcpy(&w,&f,8);return W(w,4);}\n");
    p_text("static CC_INLINE W cc_op30(W a,W b){return cc_bits32(cc_float(a)+cc_float(b));}\n");
    p_text("static CC_INLINE W cc_op31(W a,W b){return cc_bits32(cc_float(a)-cc_float(b));}\n");
    p_text("static CC_INLINE W cc_op32(W a,W b){return cc_bits32(cc_float(a)*cc_float(b));}\n");
    p_text("static CC_INLINE W cc_op33(W a,W b){return cc_bits32(cc_float(a)/cc_float(b));}\n");
    p_text("static CC_INLINE W cc_op34(W a){return cc_bits32(sqrtf(cc_float(a)));}\n");
    p_text("static CC_INLINE W cc_op40(W a,W b){return cc_bits64(cc_double(a)+cc_double(b));}\n");
    p_text("static CC_INLINE W cc_op41(W a,W b){return cc_bits64(cc_double(a)-cc_double(b));}\n");
    p_text("static CC_INLINE W cc_op42(W a,W b){return cc_bits64(cc_double(a)*cc_double(b));}\n");
    p_text("static CC_INLINE W cc_op43(W a,W b){return cc_bits64(cc_double(a)/cc_double(b));}\n");
    p_text("static CC_INLINE W cc_op44(W a){return cc_bits64(sqrt(cc_double(a)));}\n");
    p_text("static CC_INLINE W cc_op110(W x,W y,W z,W a,W b,W c){return cc_op30(cc_op30(cc_op32(x,a),cc_op32(y,b)),cc_op32(z,c));}\n");
    p_text("static CC_INLINE W cc_op111(W a,W b){return cc_op110(hp_unaligned_load(a),hp_unaligned_load(a+8),hp_unaligned_load(a+16),hp_unaligned_load(b),hp_unaligned_load(b+8),hp_unaligned_load(b+16));}\n");
    p_text("typedef float CC_V2 __attribute__((vector_size(8)));\n");
    p_text("static CC_INLINE CC_V2 cc_vec(W a){uint64_t bits=(a.tag&4)?(uint64_t)a:a.raw;CC_V2 v;memcpy(&v,&bits,8);return v;}\n");
    p_text("static CC_INLINE W cc_pair(CC_V2 v){uint64_t bits;memcpy(&bits,&v,8);return W(bits,3);}\n");
    p_text("static CC_INLINE W cc_op112(W a,W b){return cc_pair(cc_vec(a)+cc_vec(b));}\n");
    p_text("static CC_INLINE W cc_op113(W a,W b){return cc_pair(cc_vec(a)-cc_vec(b));}\n");
    p_text("static CC_INLINE W cc_op114(W a,W b){return cc_pair(cc_vec(a)*cc_vec(b));}\n");
    return 0;
}
