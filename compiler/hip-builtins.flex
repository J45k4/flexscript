// HIP device helpers emitted with the generated kernel.
fn hp_builtins() {
    p_text("// Flexscript word operations for AMD wave32 kernels.\n");
    p_text("#include <hip/hip_runtime.h>\n");
    p_text("#include <hip/hip_fp16.h>\n");
    p_text("using W=unsigned long long;\n");
    p_text("struct FWords {W v[8];};\n");
    p_text("extern __shared__ __align__(8) unsigned char flex_shared[];\n");
    p_text("#define FD __device__ __forceinline__\n");
    p_text("FD float hp_float(W a){return __uint_as_float((unsigned int)a);}\n");
    p_text("FD W hp_bits(float a){return __float_as_uint(a);}\n");
    p_text("FD double hp_double(W a){return __longlong_as_double(a);}\n");
    p_text("FD W hp_dbits(double a){return __double_as_longlong(a);}\n");
    p_text("FD W hp_div(W a,W b,int rem){if(!b || (a==0x8000000000000000ULL && b==~0ULL))__builtin_trap();return rem?(long long)a%(long long)b:(long long)a/(long long)b;}\n");
    p_text("FD W hp_unaligned_load(W p){W v;__builtin_memcpy(&v,(void*)p,8);return v;}\n");
    p_text("FD W hp_unaligned_store(W p,W v){__builtin_memcpy((void*)p,&v,8);return v;}\n");
    p_text("FD W hp_load16(W p){return *(unsigned short*)p;}\n");
    p_text("FD W hp_load32(W p){return *(unsigned int*)p;}\n");
    p_text("FD W hp_load64(W p){return *(W*)p;}\nFD W hp_stream64(W p){return __builtin_nontemporal_load((W*)p);}\n");
    p_text("FD W hp_store32(W p,W v){*(unsigned int*)p=(unsigned int)v;return v;}\n");
    p_text("FD W hp_bf16(W p){return W(*(unsigned short*)p)<<16;}\n");
    p_text("FD W hp_shared_load(W p){return *(W*)(flex_shared+p);}\n");
    p_text("FD W hp_shared_store(W p,W v){*(W*)(flex_shared+p)=v;return v;}\n");
    p_text("FD W hp_warp_sync(W mask){__syncwarp(mask);return 0;}\n");
    p_text("FD W hp_shuffle(W a,W lane,W mask){return W((unsigned int)__shfl((unsigned int)a,(int)lane,32))|(W((unsigned int)__shfl((unsigned int)(a>>32),(int)lane,32))<<32);}\n");
    p_text("FD W hp_ballot(W value,W mask){return (unsigned int)__ballot(value!=0)&mask;}\n");
    p_text("FD W hp_f32_0(W a,W b){return hp_bits(hp_float(a)+hp_float(b));}\n");
    p_text("FD W hp_f32_1(W a,W b){return hp_bits(hp_float(a)-hp_float(b));}\n");
    p_text("FD W hp_f32_2(W a,W b){return hp_bits(hp_float(a)*hp_float(b));}\n");
    p_text("FD W hp_f32_3(W a,W b){return hp_bits(hp_float(a)/hp_float(b));}\n");
    p_text("FD W hp_f32_4(W a){return hp_bits(sqrtf(hp_float(a)));}\n");
    p_text("FD W hp_f32_5(W a,W b,W c){return hp_bits(fmaf(hp_float(a),hp_float(b),hp_float(c)));}\n");
    p_text("FD W hp_f32_6(W a){return hp_bits((float)(long long)a);}\n");
    p_text("FD W hp_f32_7(W a){return (long long)hp_float(a);}\n");
    p_text("FD W hp_f64_0(W a,W b){return hp_dbits(hp_double(a)+hp_double(b));}\n");
    p_text("FD W hp_f64_1(W a,W b){return hp_dbits(hp_double(a)-hp_double(b));}\n");
    p_text("FD W hp_f64_2(W a,W b){return hp_dbits(hp_double(a)*hp_double(b));}\n");
    p_text("FD W hp_f64_3(W a,W b){return hp_dbits(hp_double(a)/hp_double(b));}\n");
    p_text("FD W hp_f64_4(W a){return hp_dbits(sqrt(hp_double(a)));}\n");
    p_text("FD W hp_f64_5(W a,W b,W c){return hp_dbits(fma(hp_double(a),hp_double(b),hp_double(c)));}\n");
    p_text("FD W hp_f64_6(W a){return hp_dbits((double)(long long)a);}\n");
    p_text("FD W hp_f64_7(W a){return (long long)hp_double(a);}\n");
    p_text("FD W hp_exp2(W a){return hp_bits(__builtin_amdgcn_exp2f(hp_float(a)));}\n");
    p_text("FD W hp_rcp(W a){return hp_bits(__builtin_amdgcn_rcpf(hp_float(a)));}\n");
    p_text("FD W hp_rsqrt(W a){return hp_bits(__builtin_amdgcn_rsqf(hp_float(a)));}\n");
    p_text("FD W hp_max(W a,W b){return hp_bits(fmaxf(hp_float(a),hp_float(b)));}\n");
    p_text("FD W hp_sum(W a){float x=hp_float(a);for(int d=16;d;d>>=1)x+=__shfl_xor(x,d,32);return hp_bits(x);}\n");
    p_text("FD W hp_half_pack(W a){return W(__half_as_ushort(__float2half_rn(hp_float(a))))|(W(__half_as_ushort(__float2half_rn(hp_float(a>>32))))<<16);}\n");
    p_text("FD W hp_half_unpack(W a){return hp_bits(__half2float(__ushort_as_half(a)))|(hp_bits(__half2float(__ushort_as_half(a>>16)))<<32);}\n");
    p_text("FD W hp_bf16_half(W a){return hp_half_pack((W((unsigned int)a<<16))|(W((unsigned int)a&0xffff0000U)<<32));}\n");
    p_text("FD W hp_texture(W texture,W index){return hp_bits(tex1Dfetch<float>((hipTextureObject_t)texture,(int)index));}\n");
    p_text("// Preserve the NVIDIA 16x8x8 fragment contract on wave32 for portable kernels.\n");
    p_text("// AMD-specific prefill uses a separate 16x16x16 WMMA kernel rather than this path.\n");
    p_text("FD W hp_mma(W a,W b,W c,W d,W offset){\n");
    p_text("  unsigned int lane=threadIdx.x&31,group=lane>>2,col=(lane&3)*2;\n");
    p_text("  float c0=hp_float(c),c1=hp_float(c>>32),d0=hp_float(d),d1=hp_float(d>>32);\n");
    p_text("  for(int k=0;k<8;k++){\n");
    p_text("    W av=hp_shuffle(a,group*4+(k>>1),0xffffffff);\n");
    p_text("    unsigned int b0=__shfl((unsigned int)b,col*4+(k>>1),32);\n");
    p_text("    unsigned int b1=__shfl((unsigned int)b,(col+1)*4+(k>>1),32);\n");
    p_text("    float w0=__half2float(__ushort_as_half(av>>((k&1)*16)));\n");
    p_text("    float w1=__half2float(__ushort_as_half(av>>(32+(k&1)*16)));\n");
    p_text("    float x0=__half2float(__ushort_as_half(b0>>((k&1)*16)));\n");
    p_text("    float x1=__half2float(__ushort_as_half(b1>>((k&1)*16)));\n");
    p_text("    c0=fmaf(w0,x0,c0);c1=fmaf(w0,x1,c1);d0=fmaf(w1,x0,d0);d1=fmaf(w1,x1,d1);\n");
    p_text("  }\n");
    p_text("  hp_shared_store(offset,hp_bits(d0)|(hp_bits(d1)<<32));return hp_bits(c0)|(hp_bits(c1)<<32);\n");
    p_text("}\n");
    p_text("FD W hp_mma_memory(W a,W b,W c,W out){W result=hp_mma(hp_load64(a),hp_load32(b),hp_load64(c),hp_load64(c+8),W(threadIdx.x)*8);hp_unaligned_store(out,result);hp_unaligned_store(out+8,hp_shared_load(W(threadIdx.x)*8));return 0;}\n");
    p_text("typedef _Float16 HPHalf8 __attribute__((ext_vector_type(8)));\n");
    p_text("typedef float HPFloat8 __attribute__((ext_vector_type(8)));\n");
    p_text("FD W hp_wmma(W a0,W a1,W b0,W b1,W c0,W c1,W c2,W c3,W offset){\n");
    p_text(" HPHalf8 a,b;HPFloat8 c;W av[2]={a0,a1},bv[2]={b0,b1},cv[4]={c0,c1,c2,c3},out[4];\n");
    p_text(" __builtin_memcpy(&a,av,16);__builtin_memcpy(&b,bv,16);__builtin_memcpy(&c,cv,32);\n");
    p_text(" c=__builtin_amdgcn_wmma_f32_16x16x16_f16_w32_gfx12(a,b,c);\n");
    p_text(" __builtin_memcpy(out,&c,32);hp_shared_store(offset,out[1]);hp_shared_store(offset+8,out[2]);hp_shared_store(offset+16,out[3]);return out[0];\n");
    p_text("}\n");
    return 0;
}
