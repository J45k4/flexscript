// Owned, disposable x86_64 Android emulator only. No physical UART/ISO oracle.
import "lib/android-usb-test.flex";
global ug_helper=0;global ug_helper_sha=0;global ug_gadget=0;global ug_remote=0;global ug_epoch=0;global ug_fault=0;global ug_daemon=0;
fn ug_words(text){let out=h_vec();let i=0;while load8(text+i){while load8(text+i)&&load8(text+i)<=32{i=i+1;}let start=i;while load8(text+i)>32{i=i+1;}if i>start{h_add(out,h_slice(text+start,i-start));}}return out;}
fn ug_less(a,b){let i=0;while load8(a+i)&&load8(a+i)==load8(b+i){i=i+1;}return load8(a+i)<load8(b+i);}
fn ug_sorted(text){let rows=ug_words(text);let i=1;while i<h_count(rows){let value=h_at(rows,i);let j=i;while j>0&&ug_less(value,h_at(rows,j-1)){store64(rows+8+j*8,h_at(rows,j-1));j=j-1;}store64(rows+8+j*8,value);i=i+1;}let out=j_array();i=0;while i<h_count(rows){j_push(out,j_string(h_at(rows,i)));i=i+1;}return out;}
fn ug_equal(a,b){if !a||!b{return a==b;}if j_kind(a)!=j_kind(b){return 0;}let kind=j_kind(a);if kind==4{let fields=j_value(a);if h_count(fields)!=h_count(j_value(b)){return 0;}let i=0;while i<h_count(fields){let pair=h_at(fields,i);if !ug_equal(load64(pair+8),j_get(b,load64(pair))){return 0;}i=i+1;}return 1;}if kind==3{if j_count(a)!=j_count(b){return 0;}let i=0;while i<j_count(a){if !ug_equal(j_at(a,i),j_at(b,i)){return 0;}i=i+1;}return 1;}return h_equal(j_dump(a),j_dump(b));}
fn ug_file(path){let p=ut_call(ut_args("exec-out","cat",path,0,0,0),"");if h_status(p)!=0{return 0;}return h_trim(h_out(p));}
fn ug_is(path,text){let value=ug_file(path);return value&&h_equal(value,text);}
fn ug_selected(){let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),"");if h_status(p)!=0{return 0;}let text=h_out(p);let at=h_find(text,"name=\"session\">");if at<0{return 0;}at=at+h_len("name=\"session\">");let n=h_find(text+at,"<");if n<1{return 0;}return h_slice(text+at,n);}
fn ug_link(pid){let p=ut_call(ut_args("shell","readlink",h_cat3("/proc/",h_int(pid),"/exe"),0,0,0),"");if h_status(p)!=0{return 0;}return h_trim(h_out(p));}
fn ug_exists(path){return h_status(ut_call(ut_args("shell","test","-e",path,0,0),""))==0;}
fn ug_put(path,text){return ut_ok(ut_args("shell","tee",path,0,0,0),h_cat(text,"\n"));}
fn ug_mkdir(path){return ut_ok(ut_args("shell","mkdir",path,0,0,0),"");}
fn ug_paths(){h_assert(ut_name(ut_prefix)&&h_starts(ut_prefix,"usb-iso-hw-serial-"),"Unsafe serial fixture prefix");ug_gadget=h_cat("/config/usb_gadget/",ut_prefix);ug_remote=h_cat3("/data/local/tmp/",ut_prefix,"-echo");return 0;}
fn ug_pad(n){h_assert(n>0&&n<1000,"Invalid kernel USB bus/address");let text=h_cat("000",h_int(n));return h_slice(text+h_len(text)-3,3);}
fn ug_bindings(){let rows=ug_words(h_out(ut_ok(ut_args("shell","ls","/config/usb_gadget",0,0,0),"")));let out=j_object();let i=0;while i<h_count(rows){let name=h_at(rows,i);h_assert(ut_name(name),"Unknown gadget name");let udc=ug_file(h_cat3("/config/usb_gadget/",name,"/UDC"));h_assert(udc,"Cannot read existing gadget binding");j_set(out,name,j_string(udc));i=i+1;}return out;}
fn ug_flags(text){let out=j_array();let i=0;while load8(text+i){let n=h_find(text+i,"\n");if n<0{n=h_len(text+i);}let line=h_slice(text+i,n);if h_has(line,"granted="){j_push(out,j_string(h_trim(line)));}i=i+n;if load8(text+i){i=i+1;}}return out;}
fn ug_permissions(text){let at=h_find(text,"permissions_manager={");if at<0{return 0;}let start=at;let depth=0;while load8(text+at){let c=load8(text+at);if c==123{depth=depth+1;}else if c==125{depth=depth-1;if depth==0{return h_slice(text+start,at-start+1);}}at=at+1;}return 0;}
// Android's legacy gadget uevent class can outlive configfs removal. Snapshot
// the real sysfs links and compare again after a synchronized guest reboot.
fn ug_android_class(){let names=ug_words(h_out(ut_ok(ut_args("shell","ls","/sys/class/android_usb",0,0,0),"")));let out=j_object();let i=0;while i<h_count(names){let name=h_at(names,i);h_assert(ut_name(name),"Unsafe Android USB class name");let link=h_trim(h_out(ut_ok(ut_args("shell","readlink",h_cat("/sys/class/android_usb/",name),0,0,0),"")));j_set(out,name,j_string(link));i=i+1;}return out;}
fn ug_manifest_worker(){let saved=ut_load(h_join(ut_out,"serial-recovery.json"));h_assert(h_equal(cj_text(saved,"serial"),ut_serial)&&h_equal(cj_text(saved,"helper_sha256"),ug_helper_sha)&&h_equal(cj_text(saved,"prefix"),ut_prefix)&&h_equal(cj_text(saved,"original"),ut_original)&&cj_int(saved,"epoch")==ug_epoch,"Worker recovery ownership mismatch");return 0;}
fn ug_find_device(){let entries=ug_words(h_out(ut_ok(ut_args("shell","ls","/sys/bus/usb/devices",0,0,0),"")));let found=0;let i=0;while i<h_count(entries){let name=h_at(entries,i);if ut_name(name){let base=h_cat("/sys/bus/usb/devices/",name);let vendor=ug_file(h_cat(base,"/idVendor"));let product=ug_file(h_cat(base,"/idProduct"));if vendor&&product&&h_equal(vendor,"1209")&&h_equal(product,"c012"){let serial=ug_file(h_cat(base,"/serial"));h_assert(serial&&h_equal(serial,ut_prefix),"A foreign device shares the controlled fixture identity");h_assert(!found,"More than one controlled gadget");let bus=h_number(ug_file(h_cat(base,"/busnum")));let device=h_number(ug_file(h_cat(base,"/devnum")));found=j_object();j_set(found,"sysfs",j_string(base));j_set(found,"path",j_string(h_cat3("/dev/bus/usb/",ug_pad(bus),h_cat("/",ug_pad(device)))));}}i=i+1;}return found;}
fn ug_setup(){
 h_assert(!ug_exists(ug_gadget)&&!ug_exists(ug_remote),"Owned fixture namespace already exists");h_assert(ug_is("/sys/class/udc/dummy_udc.0/function",""),"Dummy controller is already bound");ug_mkdir(ug_gadget);ug_put(h_cat(ug_gadget,"/idVendor"),"0x1209");ug_put(h_cat(ug_gadget,"/idProduct"),"0xc012");ug_put(h_cat(ug_gadget,"/bcdUSB"),"0x0200");ug_put(h_cat(ug_gadget,"/bcdDevice"),"0x0100");ug_put(h_cat(ug_gadget,"/bDeviceClass"),"0");
 ug_mkdir(h_cat(ug_gadget,"/strings/0x409"));ug_put(h_cat(ug_gadget,"/strings/0x409/manufacturer"),"Collie");ug_put(h_cat(ug_gadget,"/strings/0x409/product"),"Collie Virtual Serial");ug_put(h_cat(ug_gadget,"/strings/0x409/serialnumber"),ut_prefix);ug_mkdir(h_cat(ug_gadget,"/configs/c.1"));ug_mkdir(h_cat(ug_gadget,"/configs/c.1/strings/0x409"));ug_put(h_cat(ug_gadget,"/configs/c.1/strings/0x409/configuration"),"Owned CDC ACM fixture");ug_mkdir(h_cat(ug_gadget,"/functions/acm.collie"));ut_ok(ut_args("shell","ln","-s",h_cat(ug_gadget,"/functions/acm.collie"),h_cat(ug_gadget,"/configs/c.1/acm.collie"),0),"");
 ut_ok(ut_args("push",ug_helper,ug_remote,0,0,0),"");h_assert(h_bytes(h_out(ut_ok(ut_args("shell","sha256sum",ug_remote,0,0,0),"")),ug_helper_sha,64),"Copied fixture helper hash differs");ut_ok(ut_args("shell","chmod","755",ug_remote,0,0),"");let port=h_number(ug_file(h_cat(ug_gadget,"/functions/acm.collie/port_num")));h_assert(port>=0&&port<=15,"Invalid owned tty port");ug_put(h_cat(ug_gadget,"/UDC"),"dummy_udc.0");if ug_fault{h_die("Constructed setup interruption after owned bind");}
 let end=net_now()+15000;let device=0;while !device&&net_now()<end{device=ug_find_device();if !device{h_sleep(50);}}h_assert(device,"Owned gadget did not enumerate");let usb=h_out(ut_ok(ut_args("shell","dumpsys","usb",0,0,0),""));h_assert(h_has(usb,"Collie Virtual Serial"),"Android USB service has not enumerated the fixture");h_save(h_join(ut_out,"usb-attached.txt"),usb);j_set(device,"tty_port",j_int(port));j_save(h_join(ut_out,"gadget.json"),device);return 0;
}
fn ug_template(call){let source=h_read("apps/collie/tests/usb-serial-live.flex");let out="";let i=0;while load8(source+i){let n=h_find(source+i,"\n");if n<0{n=h_len(source+i);}let line=h_slice(source+i,n);if !h_starts(h_trim(line),"import "){out=h_cat3(out,line,"\n");}i=i+n;if load8(source+i){i=i+1;}}h_assert(h_find(out,"fn main()")>=0,"Missing no-op fixture entry");out=h_replace(out,"fn main()","fn usb_live_unused_main()");return h_cat3(out,"\nfn main(){return ",h_cat(call,";}\n"));}
fn ug_device(suffix,ask){let source=ug_template("usb_live_list()");let name=ut_program(suffix,source,ask);if ask{ut_phase(h_cat(ut_prefix,suffix),"permission",name);ut_click("Allow requested access","Allow",0,"logical-allow.xml");}let result=ut_observation(ut_result(name),0);let id=h_trim(cj_text(result,"stdout"));h_assert(h_starts(id,"usb-"),"No controlled SDK device");return id;}
fn ug_data(){let id=ug_device("-list",1);let call=h_cat3("usb_live_run(",j_dump(j_string(id)),h_cat3(",",h_int(ug_epoch),")"));let source=ug_template(call);h_save(h_join(ut_out,"serial-live-source.flex"),source);let name=ut_program("-data",source,0);ut_phase(h_cat(ut_prefix,"-data"),"platform_permission",name);ut_click(0,0,"android:id/button1","android-allow.xml");let observation=ut_observation(ut_result(name),0);j_save(h_join(ut_out,"serial-observation.json"),observation);h_assert(h_equal(h_trim(cj_text(observation,"stdout")),"CDC SERIAL_STATE a1200000000002000700\nCDC SERIAL_STATE a1200000000002000300"),"Actual kernel interrupt notification differs from the independently expected ACM frame");h_print(1,"PASS actual VM CDC line-coding readback,32768 unique binary bytes, kernel interrupt notification and DTR/RTS acknowledgements\n");return 0;}
fn ug_detach(){
 let id=ug_device("-detach-list",0);let device=ut_load(h_join(ut_out,"gadget.json"));let target=cj_text(device,"path");h_assert(h_starts(target,"/dev/bus/usb/"),"Missing actual kernel device path");let source=ug_template(h_cat3("usb_live_detach(",j_dump(j_string(id)),")"));h_save(h_join(ut_out,"detach-live-source.flex"),source);let name=ut_program("-detach",source,0);let end=net_now()+15000;let opened=0;let pid=0;
 while !opened&&net_now()<end{let process=ut_call(ut_args("shell","pidof","org.flexscript.collie",0,0,0),"");if h_status(process)==0{pid=h_number(h_trim(h_out(process)));if pid>0{let fds=ut_call(ut_args("shell","ls","-l",h_cat3("/proc/",h_int(pid),"/fd"),0,0),"");opened=h_status(fds)==0&&h_has(h_out(fds),target);}}let early=ut_read(h_cat3("files/test/",name,".result.json"));h_assert(!early,"Detach source returned before actual SDK open");if !opened{h_sleep(20);}}
 h_assert(opened,"Owned SDK USB descriptor was not observed");h_assert(ug_is(h_cat(ug_gadget,"/UDC"),"dummy_udc.0"),"Owned gadget no longer controls the dummy port");ug_put(h_cat(ug_gadget,"/UDC"),"");let observation=ut_observation(ut_result(name),0);j_save(h_join(ut_out,"detach-observation.json"),observation);end=net_now()+3000;let gone=0;while !gone&&net_now()<end{let fds=ut_ok(ut_args("shell","ls","-l",h_cat3("/proc/",h_int(pid),"/fd"),0,0),"");gone=!h_has(h_out(fds),target);if !gone{h_sleep(20);}}h_assert(gone,"SDK descriptor is still owned after detach");h_print(1,"PASS actual detach watch, invalid VM device and descriptor teardown in the same process\n");return 0;
}
fn ug_payload(epoch){let p=h_take(32768);let x=epoch;let i=0;while i<32768{x=x*6364136223846793005+1442695040888963407;store64(p+i,x);i=i+8;}store64(p,epoch);return p;}
fn ug_hash(epoch){let p=ug_payload(epoch);let hash=0xcbf29ce484222325;let i=0;while i<32768{hash=(hash^load8(p+i))*1099511628211;i=i+1;}let bytes=h_take(8);i=0;while i<8{store8(bytes+i,(hash>>((7-i)*8))&255);i=i+1;}return h_hex(bytes,8);}
fn ug_value(line,key){let at=h_find(line,h_cat(key,"="));if at<0{return "";}let start=line+at+h_len(key)+1;let end=h_find(start," ");if end<0{end=h_len(start);}return h_slice(start,end);}
fn ug_echo_ok(text,epoch){let line=ut_line(text,"DONE input=");if !line{return 0;}return h_equal(ug_value(line,"input"),"32768")&&h_equal(ug_value(line,"output"),"32768")&&h_equal(ug_value(line,"pending"),"0")&&h_equal(ug_value(line,"error"),"0")&&h_equal(ug_value(line,"input_hash"),ug_hash(epoch))&&h_equal(ug_value(line,"output_hash"),ug_hash(epoch))&&h_equal(ug_value(line,"break_set"),"1")&&h_equal(ug_value(line,"break_clear"),"1");}
fn ug_child_args(exe,mode){let args=h_args(exe,"--worker",mode,"--out",ut_out,"--serial");h_add(args,ut_serial);h_add(args,"--adb");h_add(args,ut_adb);h_add(args,"--prefix");h_add(args,ut_prefix);h_add(args,"--original");h_add(args,ut_original);h_add(args,"--helper");h_add(args,ug_helper);h_add(args,"--epoch");h_add(args,h_int(ug_epoch));if ug_fault{h_add(args,"--exercise-cleanup");}return args;}
fn ug_worker(exe,mode){let p=h_wait(h_spawn(ug_child_args(exe,mode),"",0));h_save(h_join(ut_out,h_cat3(mode,".stdout","")),h_out(p));h_save(h_join(ut_out,h_cat3(mode,".stderr","")),h_err(p));h_print(1,h_out(p));h_print(2,h_err(p));return p;}
fn ug_record_echo(){let lease=h_join(ut_out,"echo-lease.json");if ug_daemon&&h_has(h_out(ug_daemon),"READY owned-tty "){let words=ug_words(ut_line(h_out(ug_daemon),"READY owned-tty "));if h_count(words)==5&&h_equal(h_at(words,3),"pid"){let record=j_object();j_set(record,"pid",j_int(h_number(h_at(words,4))));j_set(record,"path",j_string(ug_remote));j_save(lease,record);}}return 0;}
fn ug_stop_echo(){
 let ids=h_vec();let lease=h_join(ut_out,"echo-lease.json");ug_record_echo();
 if h_exists(lease){let record=ut_load(lease);if h_equal(cj_text(record,"path"),ug_remote)&&cj_int(record,"pid")>0{h_add(ids,h_int(cj_int(record,"pid")));}}
 let p=ut_call(ut_args("shell","pidof",h_cat(ut_prefix,"-echo"),0,0,0),"");if h_status(p)==0{let more=ug_words(h_out(p));let i=0;while i<h_count(more){h_add(ids,h_at(more,i));i=i+1;}}
 let i=0;while i<h_count(ids){let pid=h_number(h_at(ids,i));let target=ug_link(pid);if target&&h_equal(target,ug_remote){ut_call(ut_args("shell","kill","-TERM",h_int(pid),0,0),"");}i=i+1;}
 let end=net_now()+5000;while net_now()<end{let live=0;i=0;while i<h_count(ids){let target=ug_link(h_number(h_at(ids,i)));if target&&h_equal(target,ug_remote){live=1;}i=i+1;}let extra=ut_call(ut_args("shell","pidof",h_cat(ut_prefix,"-echo"),0,0,0),"");live=live||(h_status(extra)==0&&h_len(h_trim(h_out(extra))));if !live{if ug_daemon{h_wait(ug_daemon);h_save(h_join(ut_out,"echo.log"),h_out(ug_daemon));h_save(h_join(ut_out,"echo.stderr"),h_err(ug_daemon));}return 1;}h_sleep(25);}return 0;
}
fn ug_cleanup_root(){
 let ok=ug_stop_echo();if ug_exists(ug_gadget){let binding=ug_file(h_cat(ug_gadget,"/UDC"));if !binding{return 0;}if h_len(binding){if !h_equal(binding,"dummy_udc.0"){return 0;}if h_status(ut_call(ut_args("shell","tee",h_cat(ug_gadget,"/UDC"),0,0,0),"\n"))!=0{ok=0;}}
 let paths=h_args(h_cat(ug_gadget,"/configs/c.1/acm.collie"),h_cat(ug_gadget,"/configs/c.1/strings/0x409"),h_cat(ug_gadget,"/configs/c.1"),h_cat(ug_gadget,"/functions/acm.collie"),h_cat(ug_gadget,"/strings/0x409"),ug_gadget);let i=0;while i<h_count(paths){let path=h_at(paths,i);if ug_exists(path){let op="rmdir";if i==0{op="rm";}if h_status(ut_call(ut_args("shell",op,path,0,0,0),""))!=0{ok=0;}}i=i+1;}}
 if ug_exists(ug_remote){let sha=ut_call(ut_args("shell","sha256sum",ug_remote,0,0,0),"");if ok&&h_status(sha)==0&&h_bytes(h_out(sha),ug_helper_sha,64){if h_status(ut_call(ut_args("shell","rm",ug_remote,0,0,0),""))!=0{ok=0;}}else{ok=0;}}return ok&&!ug_exists(ug_gadget)&&!ug_exists(ug_remote);
}
fn ug_recover_guard(saved){
 let sdk=h_number(h_trim(h_out(ut_ok(ut_args("shell","getprop","ro.build.version.sdk",0,0,0),""))));h_assert(sdk==cj_int(saved,"sdk"),"Recovery guest SDK changed");let installed=h_trim(h_out(ut_ok(ut_args("shell","pm","path","org.flexscript.collie",0,0),"")));h_assert(h_starts(installed,"package:/data/app/"),"Recovery app is missing");h_assert(h_bytes(h_out(ut_ok(ut_args("shell","sha256sum",installed+8,0,0,0),"")),cj_text(saved,"apk_sha256"),64),"Recovery APK changed; inspect the saved fixture before acting");let original=ut_read(h_cat3("files/workspaces/",ut_original,"/session.json"));h_assert(original&&ug_equal(original,cj_get(saved,"before")),"Recovery original conversation changed; leave unrelated work untouched");return 0;
}
fn ug_self(){
 let a=c_json("{\"b\":[1,2],\"a\":true}");let b=c_json("{\"a\":true,\"b\":[1,2]}");h_assert(ug_equal(a,b)&&!ug_equal(a,c_json("{\"a\":false,\"b\":[1,2]}")),"Exact state comparison is key-order independent");h_assert(h_equal(j_dump(ug_sorted("z\n a b\n")),"[\"a\",\"b\",\"z\"]"),"Workspace set normalization");h_assert(h_len(ug_template("usb_live_list()"))>1000,"Real live fixture template");h_assert(h_equal(ug_hash(305419896),"812d6fe696db4234")&&h_equal(h_sha_bytes(ug_payload(305419896),32768),"48d4a89b541e1fc07582d17a9876ca74ea8dd929fc3c55667fe9e10acdb6a5ec"),"Independent full-size payload/hash vector");let valid="READY owned-tty 0 pid 1\nDONE input=32768 output=32768 input_hash=812d6fe696db4234 output_hash=812d6fe696db4234 pending=0 error=0 reopens=1 break_set=1 break_clear=1\n";h_assert(ug_echo_ok(valid,305419896)&&!ug_echo_ok(h_replace(valid,"input=32768","input=65536"),305419896)&&!ug_echo_ok(h_replace(valid,"pending=0","pending=1"),305419896)&&!ug_echo_ok(valid,305419897)&&!ug_echo_ok("no completed echo",305419896),"Strict counter/epoch oracle rejects stale, pending and missing results");h_print(1,"PASS native serial fixture state comparison, full32768-byte hash vector and strict independent counter/epoch rejection\n");return 0;
}
fn main(argc,argv){
 h_environment(argc,argv);ut_adb="/opt/android-sdk/platform-tools/adb";h_timeout=180000;let mode=0;let fixture=0;let recover=0;let reboot=0;let i=1;
 if argc==2&&h_equal(load64(argv+8),"--self-test"){return ug_self();}
 while i<argc{let key=load64(argv+i*8);if h_equal(key,"--fixture-gadget"){fixture=1;}else if h_equal(key,"--fixture-reboot"){reboot=1;}else if h_equal(key,"--exercise-cleanup"){ug_fault=1;}else if h_equal(key,"--recover"){recover=1;}else{i=i+1;h_assert(i<argc,"Missing serial test value");let value=load64(argv+i*8);if h_equal(key,"--out"){ut_out=h_real(value);}else if h_equal(key,"--serial"){ut_serial=value;}else if h_equal(key,"--adb"){ut_adb=h_real(value);}else if h_equal(key,"--helper"){ug_helper=h_real(value);}else if h_equal(key,"--prefix"){ut_prefix=value;}else if h_equal(key,"--original"){ut_original=value;}else if h_equal(key,"--worker"){mode=value;}else if h_equal(key,"--epoch"){ug_epoch=h_number(value);}else{h_die(h_cat("Unknown serial test option: ",key));}}i=i+1;}
 h_assert(ut_out&&ut_serial,"Provide --out containing exact collie.apk and --serial");if !ug_helper&&recover{ug_helper=h_real(h_join(ut_out,"fixture-helper"));}h_assert(ug_helper,"Provide the built --helper");ut_validate_serial();ug_helper_sha=h_sha(ug_helper);
 if mode{ug_manifest_worker();ug_paths();if h_equal(mode,"setup"){return ug_setup();}if h_equal(mode,"data"){return ug_data();}if h_equal(mode,"detach"){return ug_detach();}h_assert(h_equal(mode,"restore"),"Unknown worker phase");ut_restore(ut_original);ut_remove();return 0;}
