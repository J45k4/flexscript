import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("requires writable_bytes(p,1);ensures result==(old(v)&255);fn byte(p,v){store8(p,v);return load8(p);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,8);reads bytes(p,8);modifies bytes(p,8);ensures load64(p)==old(v);fn word(p,v){store64(p,v);return load64(p);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,8);ensures result==old(v);fn wrong(p,v){store64(p,v+1);return load64(p);}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("requires readable_bytes(p,8);ensures result==old(load64(p));fn snapshot(p){return load64(p);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,8);ensures result==old(load64(p));fn snapshot(p){let v=load64(p);store64(p,99);return v;}",0,"Verified roots: 1/1");
    ps_verify("verify;fn null(){return load8(0);}",1,"COUNTEREXAMPLE: memory read safety");
    ps_verify("verify;fn null(){return store64(0,7);}",1,"COUNTEREXAMPLE: memory write safety");
    ps_verify("requires readable_bytes(p,1);fn too_wide(p){return load64(p);}",1,"COUNTEREXAMPLE: memory read safety");
    ps_verify("requires readable_bytes(p,1);fn readonly(p){return store8(p,1);}",1,"COUNTEREXAMPLE: memory write safety");
    ps_verify("requires writable_bytes(p,8);ensures load8(p+3)==0x76;fn endian(p){store64(p,0xfedcba9876543210);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,8);ensures load64(p)==0xfedcba98ff543210;fn overlap(p){store64(p,0xfedcba9876543210);store8(p+3,255);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);requires p==q;ensures load8(q)==42;fn alias(p,q){store8(p,42);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);requires readable_bytes(q,1);ensures load8(q)==old(load8(q));fn alias(p,q){store8(p,42);return 0;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("requires writable_bytes(p,1);requires readable_bytes(q,1);requires disjoint_bytes(p,1,q,1);ensures load8(q)==old(load8(q));fn separate(p,q){store8(p,42);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);modifies nothing;fn restore(p){let v=load8(p);store8(p,1);store8(p,v);return 0;}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("requires writable_bytes(p,1);reads nothing;modifies bytes(p,1);fn write(p){return store8(p,42);}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(p,1);reads nothing;fn read(p){return load8(p);}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("requires readable_bytes(p,1);reads nothing;ensures load8(p)==old(load8(p));fn specification(p){return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("requires writable_bytes(p,8);reads bytes(p,4),bytes(p+4,4);modifies bytes(p,4);modifies bytes(p+4,4);ensures result==old(v);fn union(p,v){store64(p,v);return load64(p);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,8);modifies bytes(p,7);fn outside(p){return store64(p,1);}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("requires writable_bytes(p,2);modifies bytes(p,1);fn entry_bounds(p){p=p+1;return store8(p,1);}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("requires writable_bytes(p,1);modifies nothing;requires flag==0;fn dead(p,flag){if flag{store8(p,1);}return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==(old(flag)!=0);fn branch(p,flag){if flag{store8(p,1);}else{store8(p,0);}return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==1;fn early(p,flag){if flag{store8(p,1);return 0;}store8(p,1);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);requires load8(p)==0;ensures load8(p)==(old(flag)!=0);fn short_and(p,flag){return flag && store8(p,1);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);requires load8(p)==0;ensures load8(p)==(old(flag)==0);fn short_or(p,flag){return flag || store8(p,1);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);requires load8(p)==0;ensures load8(p)==1;fn short_bad(p,flag){return flag && store8(p,1);}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==1;fn inline(p){return set(p);}fn set(p){return store8(p,1);}",0,"Verified roots: 1/1");
    ps_verify("requires writable_bytes(p,1);modifies nothing;fn inline(p){return set(p);}fn set(p){return store8(p,1);}",1,"COUNTEREXAMPLE: write frame in inline");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==42;fn caller(p){return set(p);}requires writable_bytes(p,1);modifies bytes(p,1);ensures load8(p)==42;fn set(p){return store8(p,42);}",0,"Verified roots: 2/2");
    ps_verify("requires writable_bytes(p,1);modifies nothing;fn caller(p){return set(p);}requires writable_bytes(p,1);modifies bytes(p,1);ensures load8(p)==42;fn set(p){return store8(p,42);}",1,"COUNTEREXAMPLE: write frame in caller");
    ps_verify("requires writable_bytes(p,1);requires readable_bytes(q,1);requires disjoint_bytes(p,1,q,1);ensures load8(q)==old(load8(q));fn caller(p,q){return set(p);}requires writable_bytes(p,1);modifies bytes(p,1);ensures load8(p)==42;fn set(p){return store8(p,42);}",0,"Verified roots: 2/2");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==0;fn caller(p){return set(p);}requires writable_bytes(p,1);modifies bytes(p,1);ensures load8(p)==42;fn set(p){return store8(p,42);}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("requires writable_bytes(p,1);ensures load8(p)==42;fn caller(p){return boundary(p);}trusted;terminates;requires writable_bytes(p,1);reads bytes(p,1);modifies bytes(p,1);ensures load8(old(p))==42;fn boundary(p){return store8(p,42);}",0,"CONDITIONAL:");
    ps_verify("requires readable_bytes(p,1);reads nothing;fn caller(p){return boundary(p);}trusted;terminates;requires readable_bytes(p,1);reads nothing;modifies nothing;ensures result==load8(old(p));fn boundary(p){return 0;}",1,"UNPROVED: read frame");
    ps_verify("requires readable_bytes(p,1);ensures result==old(load8(p));spec fn byte_at(p){return load8(p);}requires readable_bytes(p,1);ensures result==byte_at(p);fn read(p){return load8(p);}",0,"Verified roots: 2/2");
    ps_verify("requires readable_bytes(p,1);fn check(p){ghost let saved=load8(p);assert saved==load8(p);return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(p,2);requires load8(p)==1;reads bytes(p,1);fn ordered(p){return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(p,2);requires load8(p+1)==1;reads bytes(p,1);fn ordered(p){return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("requires writable_bytes(p,4);modifies bytes(p,4);ensures forall k in 0..4: load8(p+k)==0;fn clear(p){let i=0;invariant i>=0 && i<=4;invariant forall k in 0..4: k>=i || load8(p+k)==0;decreases 4-i;while i<4{store8(p+i,0);i=i+1;}return 0;}",0,"termination by checked loop measures");
    ps_verify("requires writable_bytes(p,4);modifies bytes(p,4);ensures forall k in 0..4: load8(p+k)==0;fn wrong(p){let i=0;invariant i>=0 && i<=4;invariant forall k in 0..4: k>=i || load8(p+k)==0;decreases 4-i;while i<4{store8(p+i,1);i=i+1;}return 0;}",1,"COUNTEREXAMPLE: invariant preservation");
    ps_verify("requires writable_bytes(p,1);modifies bytes(p,1);ensures load8(p)==3;fn loop(p){let i=0;store8(p,0);invariant i>=0 && i<=3;invariant load8(p)==i;decreases 3-i;while i<3{step(p);i=i+1;}return 0;}requires writable_bytes(p,1);requires load8(p)<3;modifies bytes(p,1);ensures load8(p)==old(load8(p))+1;fn step(p){return store8(p,load8(p)+1);}",0,"Verified roots: 2/2");
    ps_verify("global g=0;requires writable_bytes(g,2);reads g;modifies g,bytes(g,1);fn move(){g=g+1;return store8(g,1);}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("global g=0;requires writable_bytes(g,2);reads g,bytes(g,1);modifies g,bytes(g,1);ensures load8(old(g))==42;fn move(){store8(g,42);g=g+1;return 0;}",0,"Verified roots: 1/1");
    ps_verify("ensures readable_bytes(0,0) && writable_bytes(-1,0) && disjoint_bytes(0,0,0,0);fn empty(){return 0;}",0,"Verified roots: 1/1");
    ps_verify("ensures !readable_bytes(0,1) && !readable_bytes(0x7fffffffffffffff,2);fn invalid(){return 0;}",0,"Verified roots: 1/1");
    ps_verify("modifies bytes(0,1);fn invalid(){return 0;}",1,"COUNTEREXAMPLE: memory frame validity");
    ps_bad("modifies bytes(p);fn main(p){return 0;}","expected token");
    ps_bad("reads bytes(p,1);reads nothing;fn main(p){return 0;}","nothing cannot be mixed");
    ps_bad("requires readable_bytes(p);fn main(p){return 0;}","wrong memory operation argument count");
    ps_bad("ensures store8(p,1);fn main(p){return 0;}","proof expressions cannot modify or allocate memory");
    let program="requires writable_bytes(p,8);modifies bytes(p,8);ensures result==old(v);fn roundtrip(p,v){store64(p,v);return load64(p);}fn main(){let p=alloc(8);if p<0{return 1;}return roundtrip(p,42)!=42;}";
    t_native(program,0,"");h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),0,"");t_checks=t_checks+1;
    let annotated=h_sha(t_binary);t_program("fn roundtrip(p,v){store64(p,v);return load64(p);}fn main(){let p=alloc(8);if p<0{return 1;}return roundtrip(p,42)!=42;}");t_compile();
    t_assert(h_equal(annotated,h_sha(t_binary)),"memory annotation erasure changed executable bytes");
    t_program("requires writable_bytes(p,1);ensures load8(p)==0;fn wrong(p){return store8(p,1);}");
    let limited=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=1",0,0));h_check(limited,1,0);t_checks=t_checks+1;
    t_assert(h_has(h_out(limited),"UNPROVED:") && !h_has(h_out(limited),"COUNTEREXAMPLE:"),"memory exhaustion became an executable counterexample");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
