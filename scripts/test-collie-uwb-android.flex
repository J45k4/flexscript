// Real public UWB SDK, VM and consent checks; no physical RF claim.
import "lib/android-radio-test.flex";
fn uw_radio(){let value=h_trim(h_out(ut_ok(ut_args("shell","cmd","uwb","status",0,0),"")));h_assert(h_has(value,"enabled")||h_has(value,"disabled"),"Unknown actual UWB state");return !h_has(value,"disabled");}
fn uw_set(enabled){let action="disable-uwb";if enabled{action="enable-uwb";}ut_ok(ut_args("shell","cmd","uwb",action,0,0),"");return 0;}
fn uw_availability(expected){return at_vm(ut_prefix,h_cat3("fn main(){let h=db_word(state_get(\"watch\"));let seen=0;let i=0;while i<10 && !seen{let e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,\"event\")),\"capabilities\"){if db_word(device_field(device_field(e,\"uwb\"),\"availability\"))==",h_int(expected),"{if !db_word(device_field(e,\"sdk_callback\")){return 1;}seen=1;}}i=i+1;}if !seen{return 2;}return 0;}"),0);}
fn uw_setup(){return "let peers=db_list();db_add(peers,uwb_peer(\"12345678-1234-1234-1234-123456789abc\",16909060,1,db_blob(\"AB\",2),db_blob(\"CD\",2),9,10,1,2,db_blob(\"00000000\",8),-1,db_blob(\"\",0)));let opts=uwb_options(0,0,0,1,0,0,15000);";}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"uwb",j_object())<0{return at_self_test();}if at_cleanup{return uw_set(cj_int(at_extra,"uwb"));}if !at_child{at_extra=j_object();j_set(at_extra,"uwb",j_bool(uw_radio()));h_assert(cj_int(at_extra,"uwb"),"Enable the owned emulator UWB radio before testing");return at_parent(argc,argv);}
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let permissions=h_args("android.permission.RANGING","android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_ADVERTISE","android.permission.NEARBY_WIFI_DEVICES",0);let i=0;while i<5{ar_revoke(h_at(permissions,i));i=i+1;}
    let sid=h_cat(ut_prefix,"-consent");let name=at_conversation(sid,"fn main(){if !uwb_info(){return 1;}return 0;}",c_json("{\"uwb\":\"ask\"}"));at_pending(sid,"uwb","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));h_assert(at_bool(cj_get(cj_get(ut_read(h_cat3("files/workspaces/",sid,"/session.json")),"permissions"),"uwb")),"UWB approval not saved");at_pass("first-use UWB approval resumes the interrupted capability query without requiring Android runtime RANGING consent");
    let report=at_sdk(ut_prefix,c_json("{\"hardware_uwb_tests\":true,\"initial_permissions\":{\"uwb\":true,\"db_read\":true,\"db_write\":true}}"));h_assert(!at_bool(cj_get(report,"ranging_io_verified")),"SDK test misreported ranging proof");h_assert(!cj_int(cj_get(at_flags(at_package()),"android.permission.RANGING"),"granted"),"Capability query requested RANGING");at_pass("actual capability observation and SDK builders leave Android runtime RANGING permission denied");h_assert(cj_int(cj_get(report,"sdk_snapshot"),"availability")==3,"Owned emulator UWB radio is unavailable");
    at_vm(ut_prefix,"fn main(){let h=uwb_watch();if !h{return 1;}state_set(\"watch\",h);return 0;}",0);uw_set(0);uw_availability(1);at_pass("the actual Android UWB-off transition arrives as a user-disabled capability callback");uw_set(1);uw_availability(3);at_vm(ut_prefix,"fn main(){return device_close(db_word(state_get(\"watch\")))-1;}",0);at_pass("restoring the emulator radio yields an actual enabled callback without requesting runtime RANGING consent");
    sid=h_cat(ut_prefix,"-deny");name=at_conversation(sid,h_cat3("fn main(){",uw_setup(),"if uwb_range(0,peers,opts){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"permission_denied\"){return 2;}return 0;}"),c_json("{\"uwb\":true}"));at_pending(sid,"uwb","platform_permission",name);at_click("resource-id","permission_deny_button",1);at_observation(at_result(name));h_assert(!at_bool(cj_get(cj_get(ut_read(h_cat3("files/workspaces/",sid,"/session.json")),"permissions"),"uwb")),"UWB denial not saved");at_pass("denying actual Android Nearby ranging consent resumes the original caller with permission_denied and remembers the UWB denial");ar_clear("android.permission.RANGING");
    sid=h_cat(ut_prefix,"-allow");name=at_conversation(sid,h_cat3("fn main(){",uw_setup(),"let h=uwb_range(0,peers,opts);if !h{return 1;}state_set(\"range\",h);return 0;}"),c_json("{\"uwb\":true,\"db_read\":true,\"db_write\":true}"));at_pending(sid,"uwb","platform_permission",name);at_click("resource-id","permission_allow_button",1);at_observation(at_result(name));h_assert(cj_int(cj_get(at_flags(at_package()),"android.permission.RANGING"),"granted"),"Actual RANGING grant missing");at_pass("actual Android Nearby ranging approval resumes the original configured SDK session call");
    at_vm(sid,"fn main(){let h=db_word(state_get(\"range\"));let opened=0;let i=0;while i<12 && !opened{let e=device_wait(h,1000);if db_kind(e)==5{let name=device_field(e,\"event\");db_io(0,1,db_word(name),db_bytes(name));if worker_equal(db_word(name),\"open_failed\"){return 100+db_word(device_field(e,\"reason\"));}if worker_equal(db_word(name),\"opened\"){if !db_word(device_field(e,\"sdk_callback\")){return 1;}opened=1;}}i=i+1;}if !opened{return 2;}return 0;}",0);at_pass("a configured raw UWB responder receives an actual SDK opened callback, separately from proof of ranging measurements");
    at_vm(sid,"fn main(){let h=db_word(state_get(\"range\"));if db_word(uwb_stop(h))!=1{return 1;}let i=0;while i<12 && !db_word(device_field(device_info(h),\"sdk_terminal\")){device_wait(h,1000);i=i+1;}if !db_word(device_field(device_info(h),\"sdk_terminal\")){return 2;}return device_close(h)-1;}",0);at_pass("UWB stop remains observable until the actual SDK terminal callback, then explicit close invalidates the handle");at_sdk(sid,c_json("{\"hardware_uwb_tests\":true,\"hardware_uwb_lifecycle_tests\":true}"));let result=j_object();j_set(result,"ranging_io_verified",j_bool(0));j_set(result,"physical_devices_verified",j_bool(0));j_set(result,"sdk",report);return at_finish(result);
}
