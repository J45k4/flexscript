// Explicit opt-in real model test. Never run as part of offline CI.
import "lib/android-live-test.flex";
fn main(argc,argv){
    at_cleanup_hook=1;let options=c_json("{\"auth\":\"\"}");if at_init(argc,argv,"workers-live",options)<0{return at_self_test();}if at_cleanup{return al_cleanup();}if !at_child{return at_parent(argc,argv);}al_prepare();at_result_timeout=300000;
    let prompt="Use Flexscript to delegate to exactly one worker titled Counter. Its task: calculate 37 * 41 using its own Flexscript VM, then report the result. In your coordinator program save the worker ID in a typed list with state_set(\"team\",list), use worker_await to wait, check its terminal status, print its result, and read its messages with worker_messages. Then tell me the result. Please actually delegate and execute; do not do the calculation yourself.";
    let payload=j_object();j_set(payload,"prompt",j_string(prompt));j_set(payload,"initial_permissions",at_basic_grants());let r=at_case(ut_prefix,payload);let workers=cj_get(r,"workers");h_assert(j_count(workers)==1&&h_equal(j_value(j_at(j_at(j_at(workers,0),1),2)),"done"),"Expected exactly one completed real worker");let messages=cj_get(r,"messages");let source="";let i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call"){source=h_cat3(source,"\n",cj_text(m,"input"));}i=i+1;}h_assert(h_has(source,"worker_start")&&h_has(source,"worker_await")&&h_has(source,"worker_messages")&&h_has(source,"state_set"),"Coordinator did not use the requested worker/state APIs");h_assert(h_has(j_dump(messages),"1517")||h_has(j_dump(messages),"1,517"),"Coordinator result is incorrect");
    let worker=ut_read(h_cat3("files/workspaces/",ut_prefix,"/worker-1.json"));let calls=j_object();let wm=cj_get(worker,"messages");i=0;while i<j_count(wm){let m=j_at(wm,i);if h_equal(cj_text(m,"type"),"custom_tool_call"){j_set(calls,cj_text(m,"call_id"),j_bool(1));}i=i+1;}let executed=0;i=0;while i<j_count(wm){let m=j_at(wm,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output")&&cj_get(calls,cj_text(m,"call_id")){let o=c_json(cj_text(m,"output"));if cj_int(o,"executed")&&cj_int(o,"exit_code")==0&&h_has(cj_text(o,"stdout"),"1517"){executed=1;}}i=i+1;}h_assert(executed,"Real worker never executed a correlated VM result containing 1517");at_pass("real model delegates through Flexscript, worker executes its own VM, coordinator awaits and reads its DB messages");let report=j_object();j_set(report,"live_model",j_bool(1));j_set(report,"workers",workers);return at_finish(report);
}
