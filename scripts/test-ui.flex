// Shared AST/patch ABI across native, interpreter, JIT, ARM64 and real widgets.
import "lib/android-ui-test.flex";
import "lib/json-check.flex";
import "lib/collie-source.flex";
global pu_compiler=0;global pu_out=0;global pu_checks=0;
fn pu_pass(text){j_push(pu_checks,j_string(text));h_print(1,h_cat3("PASS ",text,"\n"));return 0;}
fn pu_json(args,input){let p=h_wait(h_spawn(args,input,0));h_check(p,0,0);return c_json(h_out(p));}
fn pu_ops(batch,kind,key){let result=j_array();let ops=cj_get(batch,"ops");let i=0;while i<j_count(ops){let op=j_at(ops,i);if h_equal(cj_text(op,"op"),kind)&&h_equal(cj_text(op,"key"),key){j_push(result,op);}i=i+1;}return result;}
fn pu_screen(binary,request){return pu_json(h_args(binary,0,0,0,0,0),j_dump(request));}
fn pu_offline(){
    let temp=h_temp();let binary=h_join(temp,"fixture");h_compile(pu_compiler,"tests/ui/portable.flex",binary);let packets=pu_json(h_args(binary,0,0,0,0,0),"");h_assert(j_count(packets)==10&&j_count(cj_get(j_at(packets,1),"ops"))==0,"Unexpected portable patch trace");let modes=h_args("--interpret","--jit",0,0,0,0);let i=0;while i<2{let args=h_args(pu_compiler,"run",h_at(modes,i),"--fuel=200000000","--timeout-ms=20000","tests/ui/portable.flex");h_assert(jc_equal(pu_json(args,""),packets),"Native/interpreter/JIT UI traces differ");i=i+1;}j_save("build/ui-portable-packets.json",packets);pu_pass("one UI AST produces identical native/interpreter/JIT patch traces");let initial=j_at(cj_get(j_at(packets,0),"ops"),0);h_assert(!cj_get(initial,"html")&&h_equal(cj_text(cj_get(initial,"node"),"kind"),"column"),"Portable AST contains host HTML");h_assert(j_count(pu_ops(j_at(packets,2),"text","value"))&&j_count(pu_ops(j_at(packets,2),"remove","branch"))&&j_count(pu_ops(j_at(packets,2),"insert","branch")),"Dynamic branch patches missing");i=1;while i<j_count(packets){let ops=cj_get(j_at(packets,i),"ops");let j=0;while j<j_count(ops){h_assert(!h_equal(cj_text(j_at(ops,j),"key"),"heading"),"Static heading was patched");j=j+1;}i=i+1;}h_assert(j_count(pu_ops(j_at(packets,3),"move","row-2"))&&j_count(pu_ops(j_at(packets,3),"move","row-1"))&&!j_count(pu_ops(j_at(packets,3),"insert","row-2")),"Keyed reordering recreated a row");h_assert(j_count(pu_ops(j_at(packets,4),"remove","row-1"))&&!j_count(pu_ops(j_at(packets,4),"remove","input-1")),"Keyed subtree removal broke child ownership");let inserted=cj_get(j_at(pu_ops(j_at(packets,5),"insert","row-3"),0),"node");h_assert(h_equal(cj_text(j_at(cj_get(inserted,"children"),1),"key"),"input-3"),"Inserted subtree lost its stable input key");let reset=cj_get(j_at(packets,8),"ops");h_assert(j_count(reset)==1&&h_equal(cj_text(cj_get(j_at(reset,0),"node"),"key"),"app"),"Full reset did not produce one app snapshot");pu_pass("compiled updates skip static nodes and preserve keyed subtrees through insert/move/remove/snapshot");
    let header=h_cat3("import ",cs_quote(h_real("libs/ui.flex")),h_cat3(";extend ",cs_quote(h_real("libs/ui/syntax.flex")),";"));let cases=c_json(h_read("tests/tooling/portable-ui-diagnostics.json"));h_assert(j_count(cases)==12,"Compile-time diagnostic fixture set changed");i=0;while i<j_count(cases){let row=j_at(cases,i);let source=h_join(temp,"invalid.flex");h_save(source,h_cat3(header,"view app_view(){",h_cat(j_value(j_at(row,0)),"}fn main(){return 0;}")));let p=h_run(h_args(pu_compiler,source,"-o",h_join(temp,"bad"),0,0));h_assert(h_status(p)!=0&&h_has(h_err(p),j_value(j_at(row,1))),h_err(p));i=i+1;}pu_pass("portable widget/property/structure errors are diagnosed at compile time");let source=h_join(temp,"boolean.flex");h_save(source,h_cat(header,"view app_view(){check(\"app\",checked:1,hidden:1,enabled:0);}fn main(){let b=m_buffer();uv_tree(b,app_view());m_print(1,m_data(b));return 0;}"));h_compile(pu_compiler,source,binary);let boolean=pu_json(h_args(binary,0,0,0,0,0),"");h_assert(at_bool(cj_get(boolean,"checked"))&&at_bool(cj_get(boolean,"hidden"))&&h_equal(cj_text(cj_get(boolean,"props"),"enabled"),"false"),"Checked/visibility/enabled ABI fields were conflated");pu_pass("checked, visibility and enabled state remain independent in the portable ABI");let screen=h_join(temp,"permissions");h_compile(pu_compiler,"tests/ui/permissions.flex",screen);let policy=c_json("{\"internet\":true,\"files_read\":true,\"files_write\":true,\"db_read\":true,\"db_write\":true,\"history\":true,\"workers\":true}");let snapshot=j_object();j_set(snapshot,"policy",policy);j_set(snapshot,"reset",j_bool(1));h_assert(j_count(cj_get(pu_screen(screen,snapshot),"ops"))==1,"Expected one initial permission snapshot");let request=j_object();j_set(request,"policy",policy);let next=at_copy(policy);j_set(next,"internet",j_bool(0));j_set(request,"next_policy",next);j_set(request,"event",c_json("{\"key\":\"deny-internet\",\"type\":\"click\",\"action\":\"internet\"}"));let update=pu_screen(screen,request);let ops=cj_get(update,"ops");h_assert(j_count(ops)==3,"Permission update was not minimal");let summary=pu_ops(update,"text","permissions-summary");h_assert(j_count(summary)==1&&h_equal(cj_text(j_at(summary,0),"value"),"6 allowed · 24 ask · 1 denied"),"Permission summary mismatch");h_assert(jc_equal(cj_get(update,"command"),c_json("{\"kind\":\"permission\",\"key\":\"internet\",\"allowed\":false}")),"Incorrect persistence effect");let invalid=c_json("[{\"key\":\"deny-internet\",\"type\":\"click\",\"action\":\"db_write\"},{\"key\":\"allow-internet\",\"type\":\"change\",\"action\":\"internet\",\"value\":true}]");i=0;while i<2{let r=j_object();j_set(r,"policy",policy);j_set(r,"event",j_at(invalid,i));h_assert(cj_get(pu_screen(screen,r),"error"),"Invalid UI event reached persistence");i=i+1;}pu_pass("shared Collie screen validates events and returns minimal updates plus persistence effects");
    if pu_out{let qemu=h_executable("qemu-aarch64-static");if syscall(21,qemu,1,0,0,0,0)!=0{qemu=h_executable("qemu-aarch64");}h_assert(syscall(21,qemu,1,0,0,0,0)==0,"ARM64 QEMU is required with --out");let inputs=j_array();j_push(inputs,snapshot);j_push(inputs,request);j_push(inputs,c_json("{\"policy\":{}}"));let back=j_object();j_set(back,"policy",policy);j_set(back,"event",c_json("{\"key\":\"permissions-back\",\"action\":\"back\",\"type\":\"click\"}"));j_push(inputs,back);i=0;while i<j_count(inputs){let r=j_at(inputs,i);let actual=pu_json(h_args(qemu,h_join(pu_out,"ui-native-test"),"10",temp,0,0),j_dump(r));h_assert(jc_equal(actual,pu_screen(screen,r)),"Production Android ARM64 and Linux screen output differ");i=i+1;}pu_pass("the production Android ARM64 engine matches Linux screen output exactly");}h_remove(temp);return packets;
}
fn main(argc,argv){
    h_environment(argc,argv);h_timeout=60000;let serial=0;let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--worker"){i=i+1;}else if h_equal(key,"--self-test"){h_assert(jc_equal(c_json("{\"b\":[true,1],\"a\":0}"),c_json("{\"a\":0,\"b\":[true,1]}"))&&!jc_equal(j_bool(1),j_int(1)),"Structural JSON comparison contract failed");return at_self_test();}else{i=i+1;h_assert(i<argc,"Portable UI option needs a value");let value=load64(argv+i*8);if h_equal(key,"--compiler"){pu_compiler=h_real(value);}else if h_equal(key,"--out"){pu_out=h_real(value);}else if h_equal(key,"--serial"){serial=value;}else{h_assert(h_equal(key,"--adb")||h_equal(key,"--prefix"),"Unknown portable UI option");}i=i+1;}}h_assert(pu_compiler,"Provide --compiler");pu_checks=j_array();if serial{at_init(argc,argv,"portable-ui",c_json("{\"compiler\":\"\"}"));if at_child{pu_checks=cj_get(at_extra,"checks");let payload=j_object();j_set(payload,"ui_packets",cj_get(at_extra,"packets"));let result=at_case(ut_prefix,payload);h_assert(cj_int(cj_get(result,"ui"),"ok"),j_dump(result));pu_pass("actual Android widgets preserve identity, focus, selection, drafts and action bindings across compiled patches");at_checks=pu_checks;j_save("build/ui-tests.json",c_json(h_cat3("{\"count\":",h_int(j_count(pu_checks)),h_cat3(",\"checks\":",j_dump(pu_checks),"}"))));return at_finish(j_object());}let packets=pu_offline();at_extra=j_object();j_set(at_extra,"packets",packets);j_set(at_extra,"checks",pu_checks);return at_parent(argc,argv);}pu_offline();let report=j_object();j_set(report,"count",j_int(j_count(pu_checks)));j_set(report,"checks",pu_checks);j_save("build/ui-tests.json",report);h_print(1,h_cat(h_int(j_count(pu_checks))," portable UI groups passed\n"));return 0;
}
