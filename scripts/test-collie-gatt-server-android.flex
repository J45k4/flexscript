fn main(argc,argv){
    at_cleanup_hook=1;let options=c_json("{\"netsim-port\":\"\",\"peer-python\":\"build/bluetooth-fixture-env/bin/python\"}");if at_init(argc,argv,"gatt-server",options)<0{return at_self_test();}if at_cleanup{bp_stop();return ar_restore();}let port=h_number(cj_text(options,"netsim-port"));h_assert(port>=1&&port<=65535,"Provide the owned localhost Netsim port");let python=h_absolute(cj_text(options,"peer-python"));h_assert(syscall(21,python,1,0,0,0,0)==0,"Missing external Bumble interpreter");if !at_child{at_extra=ar_snapshot(1,0);h_assert(cj_int(at_extra,"bluetooth"),"Enable the owned virtual Bluetooth controller first");return at_parent(argc,argv);}bp_source=h_read("apps/collie/tests/gatt-server-live.flex");let profile=j_object();let keys=h_args("service","characteristic","descriptor","slow","control",0);let values=h_vec();let i=0;while i<h_count(keys){let uuid=bp_uuid_new();j_set(profile,h_at(keys,i),j_string(uuid));h_add(values,bp_string(uuid));i=i+1;}let config=h_join(ut_out,h_cat(ut_prefix,"-peer-config.json"));bp_path=h_join(ut_out,h_cat(ut_prefix,"-peer.json"));h_assert(!h_exists(config)&&!h_exists(bp_path),"Preserve existing independent peer files");j_save(config,profile);ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let permissions=bp_permissions(1);i=h_count(permissions)-1;while i>0{ar_revoke(h_at(permissions,i));i=i-1;}bp_grant(h_at(permissions,0));at_vm(ut_prefix,bp_program("gatt_server_live_setup",values),c_json("{\"bluetooth\":true,\"location\":false,\"db_read\":true,\"db_write\":true}"));at_pass("real SDK server registration and duplicate local attributes work with only CONNECT; a second server rejects foreign attribute IDs");h_assert(!cj_int(cj_get(at_flags(at_package()),"android.permission.BLUETOOTH_ADVERTISE"),"granted"),"Server creation requested ADVERTISE");at_pass("server creation and service registration do not eagerly request ADVERTISE, SCAN or Location");h_sleep(15300);gs_vm("alive",h_vec());at_pass("successful SDK registration cancels its actual timer and remains open past the15-second registration deadline");bp_grant("android.permission.BLUETOOTH_ADVERTISE");gs_vm("advertise",h_args(h_at(values,0),0,0,0,0,0));let loop=bp_program("gatt_server_live_loop",h_vec());let payload=j_object();j_set(payload,"source",j_string(loop));let name=at_start(ut_prefix,payload);let transport=h_cat3("android-netsim:127.0.0.1:",h_int(port),h_cat(",name=collie-test-",ut_prefix));let args=h_args(python,"scripts/fixtures/collie-gatt-client.py","--transport",transport,"--config",config);h_add(args,"--out");h_add(args,bp_path);let child=bp_spawn(args);let end=net_now()+120000;let printed=0;let observation=0;let proof=j_object();let done=0;
    while net_now()<end&&!done{h_pump(child,0);h_save(h_join(ut_out,h_cat(ut_prefix,"-peer.stdout")),h_out(child));h_save(h_join(ut_out,h_cat(ut_prefix,"-peer.stderr")),h_err(child));if h_exists(bp_path){proof=bp_read();let checks=cj_get(proof,"checks");while printed<j_count(checks){at_pass(j_value(j_at(checks,printed)));printed=printed+1;}h_assert(!h_len(cj_text(proof,"error")),j_dump(proof));}let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{observation=at_observation(at_result(name));}done=cj_int(proof,"done")&&observation;if !done&&observation{payload=j_object();j_set(payload,"source",j_string(loop));name=at_start(ut_prefix,payload);observation=0;}h_assert(h_status(child)==-999||cj_int(proof,"done"),h_cat("Independent client exited before completing: ",h_err(child)));if !done{h_sleep(100);}}
    h_assert(done,"GATT server exchange deadline; preserve the active request and peer proof");end=net_now()+15000;while h_status(child)==-999||load64(child+40)>=0||load64(child+48)>=0{h_pump(child,10);h_assert(net_now()<end,"Independent client did not exit after completion");}h_assert(h_status(child)==0,h_err(child));gs_vm("finish",h_vec());at_pass("request snapshots, expired/replayed tokens, no-response events, peer disconnect and service-child cleanup are verified by the actual VM");at_pass("invalid definitions and non-byte ATT status codes are rejected before consuming service state or real request tokens");let flags=at_flags(at_package());let denied=h_args("android.permission.BLUETOOTH_SCAN","android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION",0,0,0);i=0;while i<h_count(denied){h_assert(!cj_int(cj_get(flags,h_at(denied,i)),"granted"),"Server traffic requested unrelated permission");i=i+1;}at_pass("server traffic never requests SCAN or Location; ADVERTISE is used only for the separately opened advertisement");let report=j_object();j_set(report,"gatt_server_verified",j_bool(1));j_set(report,"physical_radio_verified",j_bool(0));j_set(report,"peer",proof);return at_finish(report);
}
