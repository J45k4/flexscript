// GNU-assembled USER/FPU state transfers; same image for all three engines.
import "lib/esp32-test.flex";
fn fs_flag(argc,argv,name){let i=1;while i<argc{if h_equal(load64(argv+i*8),name){return 1;}i=i+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let work=b_option(argc,argv,"--work",0);h_assert(compiler && work,"requires --compiler --work");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_bios=b_option(argc,argv,"--bios",0);te_legacy=1;let assembler=h_real(h_executable(b_option(argc,argv,"--as","xtensa-esp32-elf-as")));let ld=h_real(h_executable(b_option(argc,argv,"--ld","xtensa-esp32-elf-ld")));let copy=h_real(h_executable(b_option(argc,argv,"--objcopy","xtensa-esp32-elf-objcopy")));let unit_object=h_join(te_work,"instructions.o");let raw=h_join(te_work,"instructions.bin");h_ok(h_args(assembler,"tests/xtensa/user-instructions.S","-o",unit_object,0,0));h_ok(h_args(copy,"-O","binary","--only-section=.text",unit_object,raw));let units=h_join(te_work,"user-tests");h_compile(te_compiler,"tests/xtensa/user.flex",units);let unit_result=h_run(h_args(units,raw,0,0,0,0));h_check(unit_result,0,0);h_print(1,h_out(unit_result));let object=h_join(te_work,"state.o");h_ok(h_args(assembler,"tests/esp32/fpu-state-oracle/state.S","-o",object,0,0));let unlinked=h_join(te_work,"unlinked.elf");h_ok(h_args(te_compiler,"--target","esp32-elf","tests/esp32/emulator-fpu-state.flex","-o",unlinked));let link=h_join(te_work,"link");h_compile(te_compiler,"scripts/esp32-link.flex",link);let linked=h_join(te_work,"state.elf");let image=h_join(te_work,"state.bin");let args=h_args(link,"--firmware",unlinked,"--output",linked,"--object");h_add(args,object);h_add(args,"--ld");h_add(args,ld);h_add(args,"--image");h_add(args,image);h_ok(args);let marker="PASS: GNU FPU state and6 disabled exceptions";let native=0;let output=0;let serial=h_join(te_work,"native.uart");if !fs_flag(argc,argv,"--qemu-only"){let runner=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",runner);let result=h_run(h_args(runner,linked,serial,"--fuel","300000000",0));h_check(result,0,0);output=h_out(result);h_print(1,output);native=h_read(serial);te_assert(h_has(native,marker),"native GNU FPU state completion");}let qemu_text=te_run(image,0,marker);h_save(h_join(te_work,"qemu.uart"),qemu_text);if native{h_print(1,"QEMU raw-state comparison is checked separately against silicon; reserved FCR/FSR bits differ.\n");}let report=b_option(argc,argv,"--report",0);if report{let r=j_object();j_set(r,"QEMU_pass",j_bool(1));j_set(r,"unit_result",j_string(h_out(unit_result)));j_set(r,"GNU_instructions_sha256",j_string(h_sha(raw)));j_set(r,"native_verified",j_bool(native!=0));j_set(r,"scope_complete",j_bool(0));j_set(r,"physical_hardware",j_bool(0));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_set(r,"ELF_sha256",j_string(h_sha(linked)));j_set(r,"UART_matches_QEMU",j_bool(native!=0 && h_has(qemu_text,native)));if native{j_set(r,"native_result",j_string(output));j_set(r,"native_UART_sha256",j_string(h_sha(serial)));}j_set(r,"QEMU_checks",j_int(te_checks));j_save(report,r);}h_print(1,"PASS: GNU FPU state image\n");return 0;}
