// Actual Wi-Fi Direct,32KiB TCP/UDP and strict cross-emulator DNS-SD checks.
import "lib/android-multi-test.flex";
fn pp_vm(index,call,args){md_select(index);return bp_vm(h_cat("p2p_live_",call),args);}
fn pp_program(call,args){return bp_program(h_cat("p2p_live_",call),args);}
fn pp_until(index,call){let end=net_now()+90000;while net_now()<end{let value=cj_text(pp_vm(index,call,h_vec()),"stdout");if h_len(value){return value;}h_sleep(100);}h_die(h_cat("Actual P2P callback deadline: ",call));return 0;}
fn pp_disabled(){let end=net_now()+90000;while net_now()<end{if h_has(h_out(ut_ok(ut_args("shell","dumpsys","wifip2p",0,0,0),"")),"curState=P2pDisabledState"){return 0;}h_sleep(100);}h_die("Actual P2P radio did not reach disabled state");return 0;}
fn pp_restore(){ar_set_wifi(0);pp_disabled();ar_set_wifi(cj_int(at_extra,"wifi"));if cj_int(at_extra,"wifi"){ut_ok(ut_args("shell","cmd","wifi","connect-network","AndroidWifi","open"),"");}ar_restore();return md_cleanup();}
fn pp_invitation(expected){let xml=at_xml();let labels=h_args("Accept","Connect","Allow","OK","ACCEPT","CONNECT");h_add(labels,"ALLOW");h_add(labels,"Ok");let i=0;while i<h_count(labels){let node=at_node(xml,"text",h_at(labels,i),0);if node{let package=ut_attr(node,"package");if h_equal(package,"android")||h_equal(package,"com.android.wifi.dialog")||h_equal(package,"com.google.android.wifi.dialog")||h_equal(package,"com.android.settings"){h_assert(h_len(expected)&&h_has(xml,expected),"P2P invitation does not name the known virtual partner");let shot=ut_ok(ut_args("exec-out","screencap","-p",0,0,0),"");h_save_bytes(h_join(ut_out,"p2p-invitation.png"),h_out(shot),h_size(load64(shot+16)),384);ut_tap(node);return 1;}}i=i+1;}return 0;}
fn pp_server(index,call){md_select(index);let p=j_object();j_set(p,"source",j_string(pp_program(call,h_vec())));return at_start(ut_prefix,p);}
fn main(argc,argv){
    at_cleanup_hook=1;let options=md_options(c_json("{\"peer\":\"\",\"services-only\":false,\"query-all\":false}"));if at_init(argc,argv,"p2p",options)<0{return at_self_test();}if at_cleanup{return pp_restore();}let peer=cj_text(options,"peer");h_assert(h_len(peer)>0,"Provide --peer for the second owned emulator");if cj_int(options,"guardian"){if at_child{return md_guardian();}md_redirect();}if !at_child{at_extra=ar_snapshot(0,0);j_set(at_extra,"wifi",j_bool(ar_wifi()));if cj_int(at_extra,"wifi"){h_assert(h_has(h_out(ut_ok(ut_args("shell","cmd","wifi","status",0,0),"")),"AndroidWifi"),"Preserve another configured Wi-Fi network; no P2P test submitted");}return at_parent(argc,argv);}md_start(argc,argv,peer);bp_source=h_read("apps/collie/tests/p2p-live.flex");let empty=h_vec();let permissions=h_args("android.permission.NEARBY_WIFI_DEVICES","android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION",0,0,0);let i=0;while i<2{md_select(i);ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ar_set_location("true");ar_set_wifi(0);i=i+1;}i=0;while i<2{md_select(i);pp_disabled();ar_set_wifi(1);i=i+1;}md_select(0);i=2;while i>=0{ar_revoke(h_at(permissions,i));i=i-1;}let name=at_conversation(ut_prefix,pp_program("open",empty),c_json("{\"db_read\":true,\"db_write\":true}"));at_pending(ut_prefix,"wifi","permission",name);at_click("text","Allow requested access",0);at_pending(ut_prefix,"location","permission",name);at_click("text","Allow requested access",0);at_pending(ut_prefix,"wifi","platform_permission",name);at_click("resource-id","permission_allow_button",1);at_pending(ut_prefix,"location","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));at_pass("P2P open checkpoints both Collie grants and yields for actual Android Nearby and precise Location dialogs");md_select(1);i=0;while i<3{bp_grant(h_at(permissions,i));i=i+1;}at_vm(ut_prefix,pp_program("open",empty),c_json("{\"wifi\":true,\"location\":true,\"db_read\":true,\"db_write\":true}"));pp_vm(0,"inventory",empty);pp_vm(1,"inventory",empty);at_pass("both actual Android P2P channels initialize, page typed peers and reject a second active channel without disturbing the first");pp_vm(0,"polls",empty);at_pass("100 hardware polls complete in one native invocation under the unchanged memory cap");
    if !cj_int(options,"services-only"){
        pp_vm(0,"discover",empty);pp_vm(1,"discover",empty);let partner0=pp_until(0,"host_peer");let partner1=pp_until(1,"host_peer");at_pass("the two emulators discover each other through real P2P radios and channel-scoped peer IDs");pp_vm(1,"create",empty);pp_until(1,"owner");at_pass("Android creates an ephemeral configured P2P group with a real interface and exposes its passphrase only via the owner-credentials call");pp_vm(1,"remove",empty);pp_until(1,"group_gone");pp_vm(0,"discover",empty);pp_vm(1,"discover",empty);pp_until(0,"host_peer");pp_until(1,"host_peer");pp_vm(0,"connect",empty);let end=net_now()+70000;let owner=0;while net_now()<end&&!owner{let info=cj_text(pp_vm(0,"connection",empty),"stdout");if h_len(info){owner=info;}else{md_select(0);pp_invitation(partner0);md_select(1);pp_invitation(partner1);h_sleep(100);}}h_assert(owner,"Actual P2P group negotiation did not complete");pp_vm(1,"attach",empty);at_pass("PBC pairing forms a real group; explicit incoming-group attach grants data access without removal rights or credentials");let port=h_number(cj_text(pp_vm(1,"tcp_listen",empty),"stdout"));h_assert(port>=1&&port<=65535,"Invalid actual P2P listener port");let server=pp_server(1,"tcp_server");pp_vm(0,"tcp_connect",h_args(bp_string(owner),h_int(port),0,0,0,0));md_select(1);at_observation(at_result(server));at_pass("32KiB of TCP data crosses the real P2P interface and two Flexscript VMs with every byte independently checked in both directions");port=h_number(cj_text(pp_vm(1,"udp_open",empty),"stdout"));h_assert(port>=1&&port<=65535,"Invalid actual P2P UDP port");server=pp_server(1,"udp_server");pp_vm(0,"udp_roundtrip",h_args(bp_string(owner),h_int(port),0,0,0,0));md_select(1);at_observation(at_result(server));at_pass("32KiB UDP round trips preserve source metadata and all binary values; traffic outside the P2P subnet is rejected");pp_vm(0,"remove",empty);i=0;while i<2{pp_until(i,"not_formed");pp_vm(i,"stale_udp",empty);i=i+1;}
    }
    let typ=h_cat3("_cf",h_slice(bp_uuid_new(),8),"._tcp");let instance=h_cat("collie-",h_slice(bp_uuid_new(),8));let browse=typ;if cj_int(options,"query-all"){browse="";}pp_vm(1,"publish",h_args(bp_string(instance),bp_string(typ),0,0,0,0));pp_vm(1,"discover",empty);pp_vm(0,"browse",h_args(bp_string(browse),bp_string(instance),bp_string(typ),0,0,0));pp_vm(0,"dns",h_args(bp_string(instance),bp_string(h_cat3(instance,".",h_cat(typ,".local."))),0,0,0,0));at_pass("real cross-emulator DNS-SD returns the published service and TXT through copied VM events; duplicate leases cannot remove the original registration");pp_vm(0,"close",empty);pp_vm(1,"close",empty);at_pass("parent closure releases discovery and service resources");md_select(0);at_sdk(ut_prefix,c_json("{\"hardware_revocation_tests\":true}"));let report=j_object();j_set(report,"peer",j_string(peer));j_set(report,"services_only",j_bool(cj_int(options,"services-only")));j_set(report,"query_all",j_bool(cj_int(options,"query-all")));return at_finish(report);
}
