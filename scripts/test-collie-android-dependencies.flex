// Native pin/archive policy checks, with no SDK download or Python process.
import "../apps/collie/android/dependencies.flex";
fn dt_child(executable,mode,value,path,message){let p=h_check(h_run(h_args(executable,mode,value,path,0,0)),1,0);h_assert(h_has(h_err(p),message),h_err(p));return 0;}
fn dt_pin(path,type){let row=j_object();let name=path+h_len(h_dir(path))+1;j_set(row,"id",j_string(h_cat("fixture:",name)));j_set(row,"file",j_string(name));j_set(row,"type",j_string(type));j_set(row,"url",j_string(h_cat("https://dl.google.com/dl/android/maven2/fixture/",name)));j_set(row,"bytes",j_int(ad_size(path)));j_set(row,"sha256",j_string(h_sha(path)));let licenses=j_array();j_push(licenses,j_string("owned test fixture"));j_set(row,"licenses",licenses);return row;}
fn main(argc,argv){
    h_environment(argc,argv);
    if h_equal(load64(argv),"curl"){let spy=h_getenv("COLLIE_CURL_SPY");if spy{h_save(spy,"unexpected network");}return 99;}
    if argc==4&&h_equal(load64(argv+8),"--artifact"){ad_artifact(c_json(load64(argv+16)),load64(argv+24),1);return 0;}
    if argc==4&&h_equal(load64(argv+8),"--protocol"){ad_protocol(load64(argv+24),c_json(load64(argv+16)));return 0;}
    let root=h_temp();let out=h_join(root,"out");let cache=h_join(root,"cache");h_mkdir(out);h_mkdir(cache);let executable=h_real(load64(argv));
    let data=h_take(32791);let i=0;while i<32791{store8(data+i,(i*131+i/17)&255);i=i+1;}
    let jar=h_join(root,"fixture.jar");let entries=h_vec();h_add(entries,az_new("owned/protocol/Peer.class","class bytes",11,1));h_add(entries,az_new("other/Impl.class","excluded",8,1));h_add(entries,az_new("META-INF/LICENSE.txt","nested license\n",15,1));az_write(jar,entries);
    let aar=h_join(root,"fixture.aar");entries=h_vec();h_add(entries,az_file("classes.jar",jar,0));let manifest="<?xml version='1.0'?><!-- <manifest package='wrong.name'/> --><manifest package='owned.fixture' />";h_add(entries,az_new("AndroidManifest.xml",manifest,h_len(manifest),1));
    h_add(entries,az_new("res/values/strings.xml","<resources/>",12,1));h_add(entries,az_new("assets/binary.bin",data,32791,1));h_add(entries,az_new("NOTICE","outer notice\n",13,1));h_add(entries,az_new("consumer-rules.pro","-keep class owned.** { *; }\n",28,1));az_write(aar,entries);
    let row=dt_pin(aar,"aar");let prefixes=j_array();j_push(prefixes,j_string("owned/protocol/"));j_set(row,"class_prefixes",prefixes);let raw=h_read(aar);let size=h_file_size;let cached=h_join(cache,h_cat3(cj_text(row,"sha256"),"-",cj_text(row,"file")));h_save_bytes(cached,raw,size,420);let lock=j_object();j_set(lock,"schema",j_int(1));let artifacts=j_array();j_push(artifacts,row);j_set(lock,"artifacts",artifacts);let lock_path=h_join(root,"dependencies.json");j_save(lock_path,lock);
    let saved_path=h_getenv("PATH");let bin=h_join(root,"bin");h_mkdir(bin);h_assert(syscall(88,executable,h_join(bin,"curl"),0,0,0,0)==0,"Cannot create owned network spy");let spy=h_join(root,"network-used");h_setenv("COLLIE_CURL_SPY",spy);h_setenv("PATH",bin);
    let result=ad_prepare(h_real("."),out,cache,1,lock_path);h_assert(!h_exists(spy),"Cached preparation invoked network tooling");h_assert(h_count(load64(result))==1&&h_count(load64(result+8))==1&&h_count(load64(result+16))==1&&h_equal(h_at(load64(result+16),0),"owned.fixture"),"Prepared SDK graph is incomplete");
    let selected=az_open(h_at(load64(result),0));h_assert(h_count(load64(selected+16))==1&&az_find(selected,"owned/protocol/Peer.class")&&!az_find(selected,"other/Impl.class"),"Protocol selection retained implementation classes");let original=az_find(az_open(jar),"owned/protocol/Peer.class");let kept=az_find(selected,"owned/protocol/Peer.class");h_assert(load64(original+24)==load64(kept+24)&&h_bytes(az_data(original),az_data(kept),load64(kept+24)),"Protocol class bytes changed");
    let assets=load64(result+32);let binary=0;i=0;while i<h_count(assets){let e=h_at(assets,i);if h_equal(load64(e),"assets/binary.bin"){binary=e;}i=i+1;}h_assert(binary&&load64(binary+24)==32791&&h_bytes(az_data(binary),data,32791),"SDK binary asset changed");h_assert(h_count(load64(result+40))==2,"Outer or nested SDK notice was lost");
    let corrupt=h_join(root,"corrupt");h_mkdir(corrupt);let bad=h_take(size);h_copy(bad,raw,size);store8(bad+size-1,load8(bad+size-1)^1);h_save_bytes(h_join(corrupt,h_cat3(cj_text(row,"sha256"),"-",cj_text(row,"file"))),bad,size,420);dt_child(executable,"--artifact",j_dump(row),corrupt,"Cached Android artifact digest mismatch");
    let missing=h_join(root,"missing");h_mkdir(missing);dt_child(executable,"--artifact",j_dump(row),missing,"absent from offline cache");h_assert(!h_exists(spy),"Offline cache miss invoked curl");
    i=0;while i<4{let changed=c_json(j_dump(row));if i==0{j_set(changed,"url",j_string("https://example.invalid/fixture.aar"));}else if i==1{j_set(changed,"file",j_string("../escape.aar"));}else if i==2{j_set(changed,"sha256",j_string(h_repeat("0",63)));}else{j_set(changed,"bytes",j_int(33554433));}dt_child(executable,"--artifact",j_dump(changed),cache,"Invalid pinned Android artifact");i=i+1;}
    let invalid=h_args("[]","[\"../\"]","[\"owned//\"]","[\"/owned/\"]","[\"owned/\",\"owned/\",\"owned/\",\"owned/\",\"owned/\"]",0);i=0;while i<h_count(invalid){dt_child(executable,"--protocol",h_at(invalid,i),jar,"Invalid SDK protocol class prefixes");i=i+1;}
    dt_child(executable,"--protocol","[\"absent/package/\"]",jar,"Empty SDK protocol class selection");h_assert(!h_exists(spy),"A rejected SDK pin used the network");h_setenv("PATH",saved_path);
    h_print(1,"PASS native SDK preparation preserves binary assets and nested notices, selects exact protocol bytes and works offline\n");h_print(1,"PASS corrupt caches, offline misses, malformed pins/prefixes and empty selections fail before network or packaging\n");
    if argc==3&&h_equal(load64(argv+8),"--cache"){let actual=h_join(root,"actual");h_mkdir(actual);let graph=ad_prepare(h_real("."),actual,h_real(load64(argv+16)),1,h_real("apps/collie/android/dependencies.json"));h_assert(h_count(load64(graph))>=30&&h_count(load64(graph+8))&&h_count(load64(graph+40)),"Incomplete pinned upstream SDK graph");h_print(1,"PASS complete pinned upstream SDK graph prepares offline through the native dependency implementation\n");}
    h_remove(root);return 0;
}
