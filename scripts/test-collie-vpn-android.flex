// Actual Android VPN consent and local TUN packets, with no remote gateway.
import "lib/collie-android-test.flex";
fn vp_dump(){return h_out(ut_ok(ut_args("shell","dumpsys","vpn_management",0,0,0),""));}
fn vp_mode(){let op=h_out(ut_ok(ut_args("shell","appops","get","org.flexscript.collie","ACTIVATE_VPN",0),""));let start=h_find(op,"ACTIVATE_VPN: ");if start<0{return "default";}start=start+14;let end=start;while load8(op+end)>=97&&load8(op+end)<=122{end=end+1;}h_assert(end>start,"Unknown ACTIVATE_VPN mode");return h_slice(op+start,end-start);}
fn vp_prepared(){let o=at_vm(ut_prefix,"fn main(){let s=vpn_status();let p=alloc(1);store8(p,48+db_word(device_field(s,\"prepared\")));db_io(0,1,p,1);return 0;}",0);let text=cj_text(o,"stdout");h_assert(h_equal(text,"0")||h_equal(text,"1"),"Malformed actual VPN preparation result");return h_equal(text,"1");}
fn vp_forget(){ut_ok(ut_args("shell","am","start","-a","android.settings.VPN_SETTINGS",0),"");let until=net_now()+20000;let gear=0;while !gear&&net_now()<until{let xml=at_xml();if h_has(xml,"package=\"com.android.settings\""){gear=at_row_gear(xml,"Collie");}if !gear{h_sleep(100);}}h_assert(gear,"No exact Collie VPN settings row");ut_tap(gear);let end=net_now()+15000;let button=0;while !button&&net_now()<end{let xml=at_xml();let labels=h_args("Forget VPN","FORGET VPN","Forget","FORGET",0,0);let i=0;while !button&&i<h_count(labels){button=at_node(xml,"text",h_at(labels,i),0);i=i+1;}if !button{h_sleep(100);}}h_assert(button,"No actual owned VPN Forget action");ut_tap(button);let xml=at_xml();button=at_node(xml,"text","Forget",0);if !button{button=at_node(xml,"text","FORGET",0);}if button{ut_tap(button);}ut_ok(ut_args("shell","am","start","-W","-n","org.flexscript.collie/.MainActivity"),"");return 0;}
fn vp_cleanup(){if cj_get(at_extra,"prepared")&&!cj_int(at_extra,"prepared")&&vp_prepared(){vp_forget();h_assert(!vp_prepared(),"Android still considers the owned VPN approved");}ut_ok(ut_args("shell","appops","set","org.flexscript.collie","ACTIVATE_VPN",cj_text(at_extra,"mode")),"");h_assert(h_equal(vp_mode(),cj_text(at_extra,"mode")),"ACTIVATE_VPN mode did not restore");h_assert(h_has(vp_dump(),"Active vpn type: -1"),"An owned VPN tunnel survived cleanup");return 0;}
fn main(argc,argv){
    at_preserve=0;at_cleanup_hook=1;if at_init(argc,argv,"vpn",j_object())<0{return at_self_test();}if at_cleanup{return vp_cleanup();}if !at_child{let dump=vp_dump();h_assert(h_has(dump,"Active vpn type: -1"),"Preserve an existing active VPN; no fixture submitted");h_assert(h_has(dump,"Active package name: [Legacy VPN]")||h_has(dump,"Active package name: org.flexscript.collie"),"A different package owns VPN authorization");at_extra=j_object();j_set(at_extra,"mode",j_string(vp_mode()));return at_parent(argc,argv);}
    at_vm(ut_prefix,"fn main(){return 0;}",c_json("{\"vpn\":true,\"network\":true,\"db_read\":true,\"db_write\":true}"));let prepared=vp_prepared();j_set(at_extra,"prepared",j_bool(prepared));at_checkpoint_extra();let source="fn main(){let addresses=db_list();let p=db_list();db_add(p,db_text(\"10.253.0.1\"));db_add(p,db_int(24));db_add(addresses,p);let routes=db_list();let r=db_list();db_add(r,db_text(\"10.253.0.0\"));db_add(r,db_int(24));db_add(routes,r);let h=vpn_open(\"Emulator consent check\",addresses,routes,db_list(),1500,db_list(),\"default\");if !h{db_io(0,2,db_error(),db_len(db_error()));return 1;}return device_close(db_word(h))-1;}";let name=at_conversation(ut_prefix,source,0);if !prepared{at_pending(ut_prefix,0,"platform_permission",name);let xml=at_xml();h_assert(h_has(xml,"package=\"com.android.vpndialogs\""),"Expected Android-owned VPN consent");at_click("resource-id","android:id/button1",0);}at_observation(at_result(name));if prepared{at_pass("the VM reuses existing Android VPN authorization without a duplicate system dialog");}else{at_pass("the VM yields for Android VPN consent and resumes its original call");}
    at_sdk(ut_prefix,c_json("{\"hardware_vpn_tests\":true}"));let until=net_now()+45000;let closed=0;while !closed&&net_now()<until{closed=h_has(vp_dump(),"Active vpn type: -1");if !closed{h_sleep(100);}}h_assert(closed,"Android retained the test VPN after VM close");at_pass("Android removes the VPN network after VM close, before force-stop cleanup");return at_finish(j_object());
}
