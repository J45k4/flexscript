// Actual native desktop service, fixture SSE, scheduler and VM capability broker.
import "lib/collie-test.flex";
fn ad_event(text){return ct_completed(ct_one(ct_message(text)));}
fn ad_send(child,kind,key,value){let command=j_object();j_set(command,"kind",j_string(kind));if key{j_set(command,key,value);}h_print(load64(child+32),h_cat(j_dump(command),"\n"));return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"test-collie-autoreview-desktop BUILD_DIRECTORY");h_timeout=30000;let out=h_real(load64(argv+8));let root=h_temp();let data=h_join(root,"data");h_mkdir(data);
    let source="fn main(){let a=fs_write(\"approved.txt\",db_text(\"once\"));let b=fs_write(\"approved.txt\",db_text(\"once\"));let c=fs_write(\"denied.txt\",db_text(\"no\"));if !a || !b || c{return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}";
    let reply=ct_program(source,"desktop-autoreview");let events=ct_one(ct_completed(cj_get(reply,"items")));let allow="{\"risk_level\":\"low\",\"user_authorization\":\"high\",\"outcome\":\"allow\",\"rationale\":\"Controlled desktop approval\"}";let deny="{\"risk_level\":\"high\",\"user_authorization\":\"low\",\"outcome\":\"deny\",\"rationale\":\"Controlled desktop denial\"}";j_push(events,ad_event(allow));j_push(events,ad_event(allow));j_push(events,ad_event(deny));j_push(events,ad_event("Controlled desktop autoreview complete"));let fixture=h_join(root,"fixture.json");j_save(fixture,events);
    let args=h_args(h_join(out,"service-native"),"--data",data,"--fixture",fixture,0);let child=h_spawn(args,0,0);h_until(child,"\"approval_reviewer\":\"user\"",20000);
    let command=c_json("{\"kind\":\"permission\",\"key\":\"approval_reviewer\",\"allowed\":\"auto_review\"}");h_print(load64(child+32),h_cat(j_dump(command),"\n"));h_until(child,"\"approval_reviewer\":\"auto_review\"",10000);ad_send(child,"submit","text",j_string("Exercise the controlled local workspace flow"));h_until(child,"Controlled desktop autoreview complete",20000);
    h_close(load64(child+32));store64(child+32,-1);h_check(h_wait(child),0,0);let raw=h_out(child);h_assert(h_has(raw,"Auto-review approved:")&&h_has(raw,"Auto-review denied:")&&!h_has(raw,"\"kind\":\"notice\""),raw);let settings=c_json(h_read(h_join(data,"settings.json")));let session=h_join(h_join(data,"sessions"),j_s(settings,"current"));let saved=c_json(h_read(h_join(session,"session.json")));h_assert(h_equal(cj_text(cj_get(saved,"permissions"),"approval_reviewer"),"auto_review")&&h_equal(cj_text(cj_get(saved,"permissions"),"files_write"),"ask"),"Desktop changed the underlying Ask grant");h_assert(h_equal(h_read(h_join(session,"files/approved.txt")),"once")&&!h_exists(h_join(session,"files/denied.txt")),"Native service failed exact operation enforcement");h_assert(h_equal(cj_text(saved,"phase"),"done"),"Native service did not finish");h_save(h_join(out,"autoreview-service-packets.jsonl"),raw);h_remove(root);h_print(1,"PASS native desktop service routes isolated fixture reviews, consumes exact grants, blocks a denied write and persists reviewer choice\n");return 0;
}
