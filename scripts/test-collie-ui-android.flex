// Shared navigation/forms on real Android widgets. No credentials or network.
import "lib/android-ui-test.flex";
fn un_night(){let text=h_trim(h_out(ut_ok(ut_args("shell","cmd","uimode","night",0,0),"")));h_assert(h_starts(text,"Night mode: "),"Unknown actual night mode");let value=text+h_len("Night mode: ");h_assert(h_equal(value,"auto")||h_equal(value,"yes")||h_equal(value,"no"),"Cannot restore unknown night mode");return value;}
fn un_set_night(value){ut_ok(ut_args("shell","cmd","uimode","night",value,0),"");h_assert(h_equal(un_night(),value),"Android night mode did not restore");return 0;}
fn un_cleanup(){un_set_night(cj_text(at_extra,"night"));let record=at_recovery();let before=h_cat("\n",cj_text(record,"workspaces"));let names=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),"")));let unknown=h_vec();let i=0;while i<h_count(names){let name=h_at(names,i);if !h_equal(name,ut_prefix)&&!at_owned(name)&&!h_has(before,h_cat3("\n",name,"\n")){h_add(unknown,name);}i=i+1;}h_assert(h_count(unknown)<=1,"Unexpected unrelated workspace appeared during owned UI navigation");if h_count(unknown){let name=h_at(unknown,0);h_assert(cj_int(at_extra,"new_pending")&&ut_name(name)&&!h_equal(name,cj_text(record,"original")),"Refusing unrelated UI workspace cleanup");let expected=cj_text(at_extra,"new_workspace");if h_len(expected){h_assert(h_equal(name,expected),"New UI workspace owner changed");}else{h_assert(h_equal(au_pref("session"),name),"Uncheckpointed UI workspace is not the selected new conversation");}ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-rf",h_cat("files/workspaces/",name)),"");}return 0;}
fn un_seed(suffix){let sid=h_cat(ut_prefix,h_cat("-",suffix));let title=h_cat3(ut_prefix," ",suffix);let second=j_at(ut_responses("fn main(){return 0;}"),1);let text=j_at(cj_get(j_at(cj_get(cj_get(second,"response"),"output"),0),"content"),0);j_set(text,"text",j_string(h_cat3("**",title,"** reply")));let events=j_array();j_push(events,second);let payload=j_object();j_set(payload,"prompt",j_string(title));j_set(payload,"responses",events);at_case(sid,payload);h_sleep(700);return sid;}
fn main(argc,argv){
    at_preserve=0;at_cleanup_hook=1;if at_init(argc,argv,"ui-navigation",j_object())<0{return at_self_test();}if at_cleanup{return un_cleanup();}if !at_child{at_extra=j_object();j_set(at_extra,"night",j_string(un_night()));return at_parent(argc,argv);}let directory=h_join(ut_out,"ui-navigation");let alpha=un_seed("Alpha");let beta=un_seed("Beta");au_tap("Message Collie");ut_ok(ut_args("shell","input","text","keep%smy%sdraft",0,0),"");h_sleep(400);let draft=au_value("Message Collie");h_assert(h_equal(draft,"keep my draft")||h_equal(draft,"Keep my draft"),"Composer did not retain typed draft");au_tap("Conversations");au_find("Search conversations");au_shot(directory,"conversations");au_edit("Search conversations",h_cat(ut_prefix," Alpha"));au_find(h_cat(ut_prefix," Alpha"));h_assert(!au_node(at_xml(),h_cat(ut_prefix," Beta")),"Conversation search leaked a nonmatching session");au_shot(directory,"conversation-search");au_tap("Back to conversation");h_assert(h_equal(au_value("Message Collie"),draft),"Navigation lost the draft");at_pass("Conversations open a separate shared screen; search filters real saved sessions and preserves the composer draft");
    au_tap("Conversations");au_tap(h_cat(ut_prefix," Alpha"));au_find(h_cat(ut_prefix," Alpha reply"));h_assert(h_equal(au_pref("session"),alpha)&&h_equal(au_value("Message Collie"),""),"Opening saved conversation did not load transcript and clear previous draft");at_pass("Opening a saved conversation loads its real transcript and clears the previous draft");au_tap("Menu");let model=au_pref("model");if !h_len(model){model="gpt-6.1-sol";}au_tap(h_cat("Model · ",model));au_edit("Model","bad!");au_tap("Save");au_find("Use 1–120 letters, digits, dots, underscores or hyphens.");au_shot(directory,"model-validation");au_edit("Model","gpt-6-sol");au_tap("Save");au_find("gpt-6-sol");h_assert(h_equal(au_pref("model"),"gpt-6-sol"),"Valid model did not persist");at_pass("The shared model form shows validation errors and persists a valid model through the Android host");
    j_set(at_extra,"new_pending",j_bool(1));at_checkpoint_extra();au_tap("New conversation");au_find("What are we\nworking on?");let created=au_pref("session");let record=at_recovery();h_assert(ut_name(created)&&!h_equal(created,alpha)&&!h_equal(created,beta)&&!h_equal(created,cj_text(record,"original"))&&!h_has(h_cat("\n",cj_text(record,"workspaces")),h_cat3("\n",created,"\n")),"New conversation reused an existing workspace");j_set(at_extra,"new_workspace",j_string(created));at_checkpoint_extra();au_shot(directory,"welcome");au_tap("Make a plan");h_assert(h_starts(au_value("Message Collie"),"Help me break down"),"Welcome suggestion did not populate composer");au_tap("Menu");au_tap("Permissions");au_find("Back to conversation");au_shot(directory,"permissions");au_tap("Back to conversation");h_assert(h_starts(au_value("Message Collie"),"Help me break down"),"Permissions navigation lost the draft");at_pass("New conversation, welcome suggestions, menu and permissions navigation use shared views without losing drafts");au_tap("Conversations");au_edit("Search conversations",h_cat(ut_prefix," Beta"));let night="yes";if h_equal(cj_text(at_extra,"night"),"yes"){night="no";}un_set_night(night);h_sleep(1000);h_assert(h_equal(au_value("Search conversations"),h_cat(ut_prefix," Beta")),"Activity recreation lost search state");au_find(h_cat(ut_prefix," Beta"));un_set_night(cj_text(at_extra,"night"));h_sleep(700);at_pass("Activity recreation retains the shared conversation page and search state");return at_finish(j_object());
}
