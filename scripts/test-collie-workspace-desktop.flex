// Actual native desktop service and an explicitly selected project directory.
import "lib/collie-test.flex";
global wd_view=0;global wd_at=0;
fn wd_send(child,kind,key,value){let command=j_object();j_set(command,"kind",j_string(kind));if key{j_set(command,key,value);}h_print(load64(child+32),h_cat(j_dump(command),"\n"));return 0;}
fn wd_wait(child,key,value){let end=net_now()+20000;while net_now()<end{
    h_pump(child,5);let raw=h_out(child);let offset=h_find(raw+wd_at,"\n");while offset>=0{let packet=c_json(h_slice(raw+wd_at,offset));wd_at=wd_at+offset+1;let data=cj_get(packet,"data");if data && h_equal(cj_text(packet,"action"),"update"){let pairs=j_value(data);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);j_set(wd_view,load64(pair),load64(pair+8));i=i+1;}}h_assert(!h_equal(cj_text(packet,"action"),"notice"),j_dump(packet));offset=h_find(raw+wd_at,"\n");}
    let got=cj_get(wd_view,key);if got && h_equal(j_dump(got),j_dump(value)){return 1;}h_assert(h_status(child)==-999,h_err(child));
}h_die(h_cat("Desktop workspace state did not reach: ",key));return 0;}
fn wd_start(out,data,fixture){wd_view=j_object();wd_at=0;let child=h_spawn(h_args(h_join(out,"service-native"),"--data",data,"--fixture",fixture,0),0,0);wd_wait(child,"workers",j_array());return child;}
fn wd_close(child){h_close(load64(child+32));store64(child+32,-1);return h_check(h_wait(child),0,0);}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"test-collie-workspace-desktop BUILD_DIRECTORY");h_timeout=30000;let out=h_real(load64(argv+8));let root=h_temp();let data=h_join(root,"data");let project=h_join(root,"selected-project");h_mkdir(data);h_mkdir(project);let entry=c_json("{\"id\":\"workspace-project\",\"name\":\"Workspace project\"}");j_set(entry,"path",j_string(project));j_save(h_join(data,"projects.json"),ct_one(entry));
    let source="fn main(){if !fs_write(\"local.txt\",db_text(\"selected workspace\")) || !db_begin(){return 1;}let s=db_schema();db_column(s,\"n\",1,0);if !db_create(\"local_values\",s) || !db_commit(){return 2;}return 0;}";let call=ct_program(source,"workspace-desktop");let fixture=h_join(root,"fixture.json");let events=ct_one(ct_completed(cj_get(call,"items")));j_push(events,ct_completed(ct_one(ct_message("Workspace local work complete"))));j_save(fixture,events);let child=wd_start(out,data,fixture);wd_send(child,"select_project","id",j_string("workspace-project"));wd_wait(child,"project_id",j_string("workspace-project"));
    let command=c_json("{\"kind\":\"permission\",\"key\":\"permission_profile\",\"allowed\":\"workspace\"}");h_print(load64(child+32),h_cat(j_dump(command),"\n"));let expected=c_json(j_dump(cj_get(wd_view,"policy")));j_set(expected,"files_read",j_bool(1));j_set(expected,"files_write",j_bool(1));j_set(expected,"db_read",j_bool(1));j_set(expected,"db_write",j_bool(1));j_set(expected,"permission_profile",j_string("workspace"));wd_wait(child,"policy",expected);wd_send(child,"submit","text",j_string("Write the selected project file and create a local database table"));wd_wait(child,"busy",j_bool(1));wd_wait(child,"busy",j_bool(0));h_assert(h_equal(h_read(h_join(project,"local.txt")),"selected workspace"),"Workspace wrote outside the selected project mapping");let session=j_s(wd_view,"session_id");h_assert(!h_exists(h_join(h_join(h_join(data,"sessions"),session),"files/local.txt")),"Project write went to private files instead");wd_close(child);
    child=wd_start(out,data,fixture);wd_wait(child,"project_id",j_string("workspace-project"));wd_wait(child,"policy",expected);wd_close(child);h_remove(root);h_print(1,"PASS native desktop Workspace persists, grants local file/transaction work without prompts, and respects the selected project root\n");return 0;
}
