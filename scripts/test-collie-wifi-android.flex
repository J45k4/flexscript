// Actual virtual-AP scans/leases, OS approval, callback I/O and crash recovery.
import "lib/android-radio-test.flex";
global wf_source=0;
fn wf_program(call){return h_cat3(wf_source,"\nfn main(){return wifi_live_",h_cat(call,"();}"));}
fn wf_model(suffix,call,policy){return at_conversation(h_cat(ut_prefix,suffix),wf_program(call),policy);}
fn wf_journal(){let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat","files/wifi-leases.json",0),"");if h_status(p)!=0||h_has(h_out(p),"No such file or directory"){return 0;}h_assert(h_starts(h_trim(h_out(p)),"{"),"Wi-Fi journal did not return actual JSON");let value=c_json(h_out(p));h_assert(value&&j_kind(value)==4,"Malformed actual Wi-Fi lease journal");return value;}
fn wf_cleanup(){ut_ok(ut_args("shell","am","force-stop","com.android.settings",0,0),"");ar_set_wifi(cj_int(at_extra,"wifi"));if cj_int(at_extra,"wifi"){ut_ok(ut_args("shell","cmd","wifi","connect-network","AndroidWifi","open"),"");}ar_restore();ut_ok(ut_args("shell","am","start","-W","-n","org.flexscript.collie/.MainActivity"),"");let until=net_now()+45000;let empty=0;while !empty&&net_now()<until{let rows=wf_journal();empty=!rows||j_count(rows)==0;if !empty{h_sleep(100);}}h_assert(empty,"Owned Wi-Fi leases did not recover after process death");if cj_int(at_extra,"journal_exists"){at_write("files/wifi-leases.json",cj_text(at_extra,"journal"));}else{ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f","files/wifi-leases.json"),"");}return 0;}
fn wf_picker(name){let end=net_now()+60000;while net_now()<end{let done=ut_read(h_cat3("files/test/",name,".result.json"));if done{return 0;}let xml=at_xml();let labels=h_args("Connect","CONNECT","Use this network","USE THIS NETWORK",0,0);let node=0;let i=0;while i<h_count(labels)&&!node{node=at_node(xml,"text",h_at(labels,i),0);i=i+1;}if node{return ut_tap(node);}let access=at_node(xml,"text","AndroidWifi",0);if access&&h_equal(ut_attr(access,"clickable"),"true"){ut_tap(access);}let retry=at_node(xml,"text","Try again",0);if !retry{retry=at_node(xml,"text","TRY AGAIN",0);}if retry{ut_tap(retry);}h_sleep(100);}h_die("Android's picker did not approve the exact virtual AndroidWifi request");return 0;}
fn main(argc,argv){
    at_preserve=0;at_cleanup_hook=1;if at_init(argc,argv,"wifi",j_object())<0{return at_self_test();}if at_cleanup{return wf_cleanup();}if !at_child{h_assert(ar_wifi(),"Enable the owned emulator's virtual Wi-Fi before this fixture");h_assert(h_has(h_out(ut_ok(ut_args("shell","cmd","wifi","status",0,0),"")),"AndroidWifi"),"The owned emulator must initially use its virtual AndroidWifi network");at_extra=ar_snapshot(0,0);j_set(at_extra,"wifi",j_bool(1));let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat","files/wifi-leases.json",0),"");let exists=h_starts(h_trim(h_out(p)),"{");h_assert(exists||h_has(h_out(p),"No such file or directory"),"Cannot preserve the actual Wi-Fi lease journal");j_set(at_extra,"journal_exists",j_bool(exists));if exists{let rows=c_json(h_out(p));h_assert(rows&&j_kind(rows)==4&&j_count(rows)==0,"Preserve existing live Wi-Fi leases; no fixture submitted");j_set(at_extra,"journal",j_string(h_out(p)));}return at_parent(argc,argv);}
    wf_source=h_read("apps/collie/tests/wifi-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ut_ok(ut_args("shell","am","force-stop","com.android.settings",0,0),"");let permissions=h_args("android.permission.NEARBY_WIFI_DEVICES","android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION","android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_ADVERTISE");let i=0;while i<h_count(permissions){ar_revoke(h_at(permissions,i));i=i+1;}
    let sid=h_cat(ut_prefix,"-status");let name=wf_model("-status","status",0);at_pending(sid,"wifi","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));at_pass("Wi-Fi status asks for its Collie grant without requesting Android Location or Nearby permission");at_observation(at_result(wf_model("-deny-location","location_denied",c_json("{\"wifi\":true,\"location\":false}"))));at_pass("Wi-Fi permission alone cannot expose cached scan identities");ar_set_location("true");sid=h_cat(ut_prefix,"-io");name=wf_model("-io","scan",c_json("{\"wifi\":true,\"network\":true,\"db_read\":true,\"db_write\":true}"));at_pending(sid,"location","permission",name);at_click("text","Allow requested access",0);at_pending(sid,"location","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));at_pass("Wi-Fi scans additionally yield for Collie Location and the real Android precise-location dialog");at_sdk(sid,c_json("{\"hardware_wifi_tests\":true}"));
    name=wf_model("-io","nearby_denied",0);at_pending(sid,"wifi","platform_permission",name);at_click("resource-id","permission_deny_button",1);at_observation(at_result(name));let state=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));let policy=cj_get(state,"permissions");h_assert(!at_bool(cj_get(policy,"wifi"))&&at_bool(cj_get(policy,"location")),"Nearby denial changed the independent Location grant");at_pass("denying Android Nearby permission updates only the Wi-Fi grant and resumes the original VM caller");ar_clear("android.permission.NEARBY_WIFI_DEVICES");sid=h_cat(ut_prefix,"-connect");name=wf_model("-connect","request",c_json("{\"wifi\":true,\"location\":true,\"network\":true,\"db_read\":true,\"db_write\":true}"));at_pending(sid,"wifi","platform_permission",name);at_click("resource-id","permission_allow_button",1);wf_picker(name);at_observation(at_result(name));at_pass("Nearby Wi-Fi consent and Android-owned network selection complete before the VM receives an available lease");at_sdk(sid,c_json("{\"hardware_wifi_request_tests\":true,\"hardware_preserve_handles\":true}"));
    name=wf_model("-connect","hotspot",0);let o=at_observation(at_result(name));if h_equal(cj_text(o,"stdout"),"started"){at_pass("Android LocalOnlyHotspot starts and exposes credentials only explicitly");}else{h_assert(h_equal(cj_text(o,"stdout"),"android_rejected"),j_dump(o));at_pass("Android rejects local-only hotspot mode on this emulator through its real SDK error callback");}ut_ok(ut_args("shell","cmd","wifi","connect-network","AndroidWifi","open"),"");let ssid=h_cat("Collie-crash-",h_int(syscall(39,0,0,0,0,0,0)));let source=h_cat3(wf_source,"\nfn main(){return wifi_live_crash(",h_cat(j_dump(j_string(ssid)),");}"));at_vm(sid,source,0);h_assert(j_count(wf_journal())==1,"The actual suggestion was not journaled once");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");at_sdk(sid,c_json("{\"hardware_wifi_recovery_tests\":true}"));name=wf_model("-connect","watch",0);ar_progress(sid,"Wi-Fi state watcher ready",name);ar_set_wifi(0);at_observation(at_result(name));at_pass("an actual Android Wi-Fi radio-state change reaches the VM through the registered state broadcast");return at_finish(j_object());
}
