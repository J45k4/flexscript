// Build a separate Android test provider with the owned Collie test certificate.
import "lib/host.flex";
fn df_run(args){return h_check(h_wait(h_spawn(args,"",0)),0,0);}
fn main(argc,argv){
    h_environment(argc,argv);let out=0;let collie=0;let sdk="/opt/android-sdk";let i=1;
    while i<argc{let key=load64(argv+i*8);i=i+1;h_assert(i<argc,"Missing provider builder value");let value=load64(argv+i*8);if h_equal(key,"--out"){out=h_absolute(value);}else if h_equal(key,"--collie-out"){collie=h_real(value);}else if h_equal(key,"--sdk"){sdk=h_real(value);}else{h_die(h_cat("Unknown provider builder argument: ",key));}i=i+1;}
    h_assert(out&&collie,"Provide --out and --collie-out");h_mkdir(out);out=h_real(out);let classes=h_join(out,"classes");let dex=h_join(out,"dex");h_mkdir(classes);h_mkdir(dex);let source=h_real("apps/collie/tests/android-document-provider");let jar=h_join(sdk,"platforms/android-36/android.jar");let tools=h_join(sdk,"build-tools/36.1.0");let key=h_join(collie,"development.keystore");h_assert(h_exists(key),"Missing owned Collie development certificate");
    let args=h_args(h_executable("javac"),"-source","8","-target","8","-classpath");h_add(args,jar);h_add(args,"-d");h_add(args,classes);h_add(args,h_join(source,"HardwareDocumentProviderFixture.java"));h_add(args,h_join(source,"HardwareDocumentControlFixture.java"));df_run(args);
    args=h_args(h_join(tools,"d8"),"--min-api","26","--lib",jar,"--output");h_add(args,dex);h_add(args,h_join(classes,"org/flexscript/collie/documentfixture/HardwareDocumentProviderFixture.class"));h_add(args,h_join(classes,"org/flexscript/collie/documentfixture/HardwareDocumentProviderFixture$Pipe.class"));h_add(args,h_join(classes,"org/flexscript/collie/documentfixture/HardwareDocumentProviderFixture$WritePipe.class"));h_add(args,h_join(classes,"org/flexscript/collie/documentfixture/HardwareDocumentControlFixture.class"));df_run(args);
    let unsigned=h_join(out,"unsigned.apk");args=h_args(h_join(tools,"aapt2"),"link","-I",jar,"--manifest",h_join(source,"AndroidManifest.xml"));h_add(args,"--version-code");h_add(args,"1");h_add(args,"--version-name");h_add(args,"0.1");h_add(args,"-o");h_add(args,unsigned);df_run(args);
    df_run(h_args(h_executable("zip"),"-q","-j",unsigned,h_join(dex,"classes.dex"),0));let aligned=h_join(out,"aligned.apk");df_run(h_args(h_join(tools,"zipalign"),"-f","4",unsigned,aligned,0));
    let apk=h_join(out,"provider.apk");args=h_args(h_join(tools,"apksigner"),"sign","--ks",key,"--ks-key-alias","development");h_add(args,"--ks-pass");h_add(args,"pass:android");h_add(args,"--key-pass");h_add(args,"pass:android");h_add(args,"--out");h_add(args,apk);h_add(args,aligned);df_run(args);df_run(h_args(h_join(tools,"apksigner"),"verify",apk,0,0,0));h_print(1,h_cat(apk,"\n"));return 0;
}
