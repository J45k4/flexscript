// Archive recall, permissions, UTF-8, pagination and filesystem isolation.
import "lib/collie-test.flex";
global rc_workspaces=0;
global rc_printer=0;
fn rc_save(id,archive,policy){let path=h_join(rc_workspaces,id);h_mkdir(path);let s=j_object();j_set(s,"archive",archive);j_set(s,"messages",j_array());if policy{j_set(s,"permissions",policy);}j_save(h_join(path,"session.json"),s);return path;}
fn rc_message(role,text){let m=j_object();j_set(m,"role",j_string(role));j_set(m,"content",j_string(text));return m;}
fn rc_run(expr,policy,error){let config=c_json(j_dump(ct_config));if policy{j_set(config,"permissions",policy);}let source=h_cat3(rc_printer,h_cat3("fn main(){let v=",expr,";if !v{let e=db_error();text(e,db_len(e));return 99;}dump(v);return 0;}"),"");let req=j_object();j_set(req,"config",config);j_set(req,"source",j_string(source));j_set(req,"history",j_array());let r=ct_call(3,req);h_assert(cj_int(r,"executed"),j_dump(r));if error{h_assert(cj_int(r,"exit_code")==99&&h_has(cj_text(r,"stdout"),error),j_dump(r));return j_string(cj_text(r,"stdout"));}ct_continued(r);let v=c_json(cj_text(r,"stdout"));h_assert(v,"Recall did not print JSON");return v;}
fn rc_search(query,session,offset,limit){let b=h_buffer();h_text(b,"memory_search(");h_text(b,j_dump(j_string(query)));h_text(b,",");h_text(b,j_dump(j_string(session)));h_text(b,",");h_text(b,h_int(offset));h_text(b,",");h_text(b,h_int(limit));h_text(b,")");return rc_run(h_data(b),0,0);}
fn rc_all(query,limit){let hits=j_array();let session="";let offset=0;let seen=j_object();let i=0;while i<100{let page=rc_search(query,session,offset,limit);let rows=j_at(page,0);let n=0;while n<j_count(rows){j_push(hits,j_at(rows,n));n=n+1;}session=j_value(j_at(page,1));offset=j_value(j_at(page,2));if !h_len(session){return hits;}let key=h_cat3(session,":",h_int(offset));h_assert(!cj_get(seen,key),"Recall pagination repeated a cursor");j_set(seen,key,j_bool(1));i=i+1;}h_die("Recall pagination did not terminate");return 0;}
fn rc_read(id,index,field,offset,limit,error){let b=h_buffer();h_text(b,"memory_read(");h_text(b,j_dump(j_string(id)));h_text(b,",");h_text(b,h_int(index));h_text(b,",");h_text(b,j_dump(j_string(field)));h_text(b,",");h_text(b,h_int(offset));h_text(b,",");h_text(b,h_int(limit));h_text(b,")");return rc_run(h_data(b),0,error);}
fn main(argc,argv){
    ct_init(argc,argv);let base=ct_root;rc_workspaces=h_join(base,"workspaces");h_mkdir(rc_workspaces);ct_root=h_join(rc_workspaces,"current");h_mkdir(h_join(ct_root,"files"));j_set(ct_config,"workspace_file",j_string(h_join(ct_root,"agent.flexdb")));j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));rc_printer=h_read("apps/collie/tests/print-json.flex");
    let old=c_json("[{\"role\":\"user\",\"content\":\"My preferred keyboard is the Moonlander.\"},{\"role\":\"assistant\",\"content\":\"I will keep that in mind.\"},{\"role\":\"assistant\",\"source\":\"fn main(){return 42;}\",\"observation\":{\"stdout\":\"Moonlander configuration saved\"}}]");let saved=rc_save("a-old",old,c_json("{\"history\":true}"));let state=c_json(h_read(h_join(saved,"session.json")));j_set(state,"messages_hidden",j_string("credential-marker"));j_save(h_join(saved,"session.json"),state);rc_save("b-private",ct_one(rc_message("user","Moonlander private secret")),c_json("{\"history\":false}"));rc_save("c-legacy",ct_one(rc_message("user","MOONLANDER works well with Collie.")),0);
    let rows=rc_all("moonlander",20);h_assert(j_count(rows)==3,j_dump(rows));let observed=0;let from_old=0;let from_legacy=0;let i=0;while i<j_count(rows){let row=j_at(rows,i);let id=j_value(j_at(row,0));h_assert(h_equal(id,"a-old")||h_equal(id,"c-legacy"),j_dump(row));from_old=from_old||h_equal(id,"a-old");from_legacy=from_legacy||h_equal(id,"c-legacy");observed=observed||h_equal(j_value(j_at(row,3)),"observation");h_assert(!h_has(j_value(j_at(row,4)),"private secret"),j_dump(row));i=i+1;}h_assert(observed&&from_old&&from_legacy,j_dump(rows));ct_pass("real VM searches separate saved chats case-insensitively and includes actual VM observations");
    let history=rc_run("memory_history(\"a-old\",0,2)",0,0);let first=j_at(j_at(history,0),1);h_assert(h_equal(j_value(j_at(first,0)),"user")&&h_has(j_value(j_at(first,1)),"Moonlander")&&h_equal(j_value(j_at(j_at(j_at(history,1),1),0)),"assistant"),j_dump(history));h_assert(h_equal(j_value(rc_read("a-old",1,"content",0,16384,0)),"My preferred keyboard is the Moonlander.")&&h_equal(j_value(rc_read("a-old",3,"source",0,100,0)),"fn main(){return 42;}")&&h_equal(j_value(rc_read("a-old",1,"content",10000,100,0)),"")&&j_count(rc_all("credential-marker",20))==0,"Recall context/chunk/provider isolation failed");ct_pass("matched messages can be read with surrounding context, source and chunked fields; provider-only data stays hidden");
    h_assert(h_equal(j_dump(rc_all("moonlander",1)),j_dump(rows)),"Result-limited pagination changed hit order");let long=h_cat3(h_repeat("ä",2600)," recall-target ",h_repeat("ö",2600));rc_save("d-long",ct_one(rc_message("user",long)),0);let hits=rc_all("RECALL-TARGET",20);h_assert(j_count(hits)==1&&h_has(j_value(j_at(j_at(hits,0),4)),"recall-target")&&h_len(j_value(j_at(j_at(hits,0),4)))<=512&&h_equal(j_value(rc_read("d-long",1,"content",0,16384,0)),long),j_dump(hits));ct_pass("search sees beyond history excerpts, preserves UTF-8 and resumes result-limited pages without duplicates");
    let grants=ct_grants(j_bool(1));j_set(grants,"history",j_bool(0));rc_run("memory_search(\"moonlander\",\"\",0,10)",grants,"Permission denied: history");let policies=c_json("[{\"history\":false},{\"history\":\"true\"},false,{}]");i=0;while i<j_count(policies){rc_save("e-denied",ct_one(rc_message("user","not-for-recall")),j_at(policies,i));h_assert(j_count(rc_all("not-for-recall",20))==0,"Source history denial leaked an archive");rc_read("e-denied",1,"content",0,10,"unavailable");i=i+1;}rc_run("memory_history(\"b-private\",0,2)",0,"unavailable");h_assert(!h_exists(h_join(ct_root,"session.json")),"Recall mutated the caller session");ct_pass("caller and source history permissions are enforced conservatively without mutating other conversations");
    let outside=h_join(base,"outside");h_mkdir(outside);state=j_object();j_set(state,"archive",ct_one(rc_message("user","escape-marker")));j_save(h_join(outside,"session.json"),state);h_assert(syscall(88,outside,h_join(rc_workspaces,"f-symlink"),0,0,0,0)==0,"Cannot create directory symlink fixture");let link=h_join(rc_workspaces,"g-linkfile");h_mkdir(link);h_assert(syscall(88,h_join(outside,"session.json"),h_join(link,"session.json"),0,0,0,0)==0,"Cannot create session symlink fixture");h_assert(j_count(rc_all("escape-marker",20))==0,"Recall followed a sibling symlink");let invalid=h_args("../outside","/etc/passwd","a-old/../b-private","a_old",0,0);i=0;while i<h_count(invalid){rc_read(h_at(invalid,i),1,"content",0,20,"Invalid conversation ID");i=i+1;}rc_read("f-symlink",1,"content",0,20,"unavailable");rc_read("g-linkfile",1,"content",0,20,"unavailable");let expressions=h_args("memory_search(\"\",\"\",0,1)","memory_search(\"x\",\"\",1,1)","memory_search(\"x\",\"\",0,21)","memory_read(\"a-old\",1,\"credentials\",0,20)",0,0);i=0;while i<h_count(expressions){let error="memory_search";if i==3{error="history";}rc_run(h_at(expressions,i),0,error);i=i+1;}ct_pass("archive-only storage refuses traversal, sibling symlinks, file symlinks and invalid field/range requests");
    let many=j_array();i=0;while i<1024{j_push(many,rc_message("user","ordinary message"));i=i+1;}j_push(many,rc_message("user","late-recall-marker"));rc_save("h-many",many,0);let page=rc_search("late-recall-marker","h-many",0,20);h_assert(j_count(j_at(page,0))==0&&h_equal(j_value(j_at(page,1)),"h-many")&&j_value(j_at(page,2))==1024,j_dump(page));page=rc_search("late-recall-marker",j_value(j_at(page,1)),j_value(j_at(page,2)),20);h_assert(j_value(j_at(j_at(j_at(page,0),0),1))==1025,j_dump(page));i=0;while i<12{let suffix=h_int(i);if i<10{suffix=h_cat("0",suffix);}rc_save(h_cat("i-page-",suffix),ct_one(rc_message("user","paging-marker")),0);i=i+1;}hits=rc_all("paging-marker",20);h_assert(j_count(hits)==12,j_dump(hits));let seen=j_object();i=0;while i<12{let id=j_value(j_at(j_at(hits,i),0));h_assert(!cj_get(seen,id),"Duplicate recall hit across archive pages");j_set(seen,id,j_bool(1));i=i+1;}ct_pass("bounded scans return continuations even for empty pages, across many conversations and long archives");
    let req=j_object();j_set(req,"config",ct_config);j_set(req,"messages",ct_one(rc_message("user","What keyboard did I mention before?")));let body=ct_call(1,req);let instructions=cj_text(body,"instructions");h_assert(h_has(instructions,"RECALL ACROSS CHATS")&&h_has(instructions,"Never fabricate memories")&&h_has(instructions,"memory_search")&&h_has(instructions,"historical data"),j_dump(body));ct_pass("model bootstrap teaches recall before guessing and treats archived text as historical data");ct_root=base;return ct_done(j_object(),"recall-report.json");
}
