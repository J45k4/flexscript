// Native spans/tables plus actual validated workspace-link navigation and a
// summary-only response. All fixtures are owned; no credentials or model I/O.
import "lib/android-ui-test.flex";
fn ma_reply(text){let events=j_array();j_push(events,at_answer_event(text,0));return at_result(at_task(ut_prefix,"Check the controlled Android presentation",events,0));}
fn ma_tap(label){let i=0;while i<12{let node=au_node(at_xml(),label);if node{ut_tap(node);h_sleep(300);return 0;}au_scroll(1);i=i+1;}h_die(h_cat("Missing Markdown control: ",label));return 0;}
fn ma_link(text){let node=au_find(text);let bounds=ut_attr(node,"bounds");let comma=h_find(bounds,",");h_assert(comma>1,"Missing link bounds");let x=h_number(h_slice(bounds+1,comma-1))+50;let vertical=at_vertical(node);ut_ok(ut_args("shell","input","tap",h_int(x),h_int((load64(vertical)+load64(vertical+8))/2),0),"");h_sleep(400);return 0;}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"markdown",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}
    at_vm(ut_prefix,"fn main(){fs_mkdir(\"notes\");return fs_write(\"notes/report one.txt\",db_text(\"linked-file-6049\"))-1;}",at_basic_grants());let data=h_read("tests/tooling/collie-view.png");let size=h_file_size;let path=h_cat3("files/workspaces/",ut_prefix,"/files/photo.png");let child=h_spawn(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'cat > ",path,"'")),data,0);store64(child+64,size);h_check(h_wait(child),0,0);
    ma_reply("[Open note](notes/report%20one.txt#L2)");ma_link("Open note");h_assert(h_has(at_xml(),"linked-file-6049"),"Actual file link did not open bounded workspace text");au_shot(ut_out,"markdown-file-link");au_tap("Close preview");at_pass("tapping rendered file link opens the actual app-private document with decoded path and fragment");
    ma_reply("[Open picture](photo.png)");ma_link("Open picture");h_assert(au_node(at_xml(),"Full image: /photo.png"),"Actual image link did not open its SDK-decoded snapshot");au_shot(ut_out,"markdown-image-link");au_tap("Close preview");at_pass("tapping image link opens an actual bounded immutable image preview");
    ma_reply("[Escape](../outside.txt)");ma_link("Escape");h_assert(h_has(at_xml(),"escapes this workspace"),"Workspace escape did not return a shared notice");au_tap("Got it");at_pass("rendered parent-traversal link is rejected before host file access");
    let body="## Android Markdown\n**Bold** *italic* ~~old~~ and `code`.\n\n| No. | Name | Note |\n| ---: | :--- | :---: |\n";let i=1;while i<48{body=h_cat3(body,h_cat3("| ",h_int(i)," | Person "),h_cat(h_int(i)," | **Rendered** |\n"));i=i+1;}ma_reply(body);ma_tap("Next");ma_tap("Next");h_assert(h_has(at_xml(),"Rows 41–47 of 47"),"Actual table paging did not reach all rows");au_shot(ut_out,"markdown-table-last-page");at_pass("native scrolling table pages reach all47 rows with formatted headers/cells");
    let events=c_json(h_read("tests/tooling/android-ui-reply-events.json"));let name=at_task(h_cat(ut_prefix,"-summary"),"Check the summary-only response",events,0);let end=net_now()+20000;let waiting=0;while net_now()<end&&!waiting{let xml=at_xml();waiting=h_has(xml,"Waiting for the model");}h_assert(waiting,"Actual Android pending response has no Thinking panel");let result=at_result(name);let xml=at_xml();h_assert(au_node(xml,"Expand thinking")&&h_has(xml,"Checking the source.")&&h_has(xml,"Styled answer.")&&!h_has(xml,"private-marker"),"Actual summary-only reply missing, conflated or private data exposed");au_tap("Expand thinking");h_assert(h_has(at_xml(),"Summary")&&!h_has(at_xml(),"Show program"),"Pure summary response fabricated a tool call");au_shot(ut_out,"thinking-summary-only");at_pass("summary-only API response shows waiting, styled public summary and separate answer without inventing tools");return at_finish(j_object());
}
