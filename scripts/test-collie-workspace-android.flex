// Actual Android controls, persisted policy and local VM effects on an owned emulator.
import "lib/android-ui-test.flex";
fn wa_policy(sid){return cj_get(ut_read(h_cat3("files/workspaces/",sid,"/session.json")),"permissions");}
fn wa_scope(sid){let p=wa_policy(sid);h_assert(h_equal(cj_text(p,"permission_profile"),"workspace")&&at_bool(cj_get(p,"files_read"))&&at_bool(cj_get(p,"files_write"))&&at_bool(cj_get(p,"db_read"))&&at_bool(cj_get(p,"db_write"))&&h_equal(cj_text(p,"internet"),"ask")&&h_equal(cj_text(p,"workers"),"ask")&&!at_bool(cj_get(p,"history")),"Android Workspace policy was not canonical or lost a denial");return p;}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"workspace",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}
    let sid=h_cat(ut_prefix,"-local");let p=j_object();let policy=at_basic_grants();j_set(policy,"history",j_bool(0));j_set(p,"resume_only",j_bool(1));j_set(p,"initial_permissions",policy);at_case(sid,p);
    au_tap("Menu");au_tap("Permissions");au_find("Access scope");au_tap("Use workspace permissions");wa_scope(sid);let shots=h_join(ut_out,"workspace-shots");au_shot(shots,"permissions");at_pass("actual Workspace control persists local grants, resets outside grants to Ask, and preserves explicit Deny");
    // The approval-mode card follows the scope card and may need scrolling.
    let i=0;while i<3&&!au_node(at_xml(),"Automatically review access requests"){au_scroll(1);i=i+1;}au_tap("Automatically review access requests");h_assert(h_equal(cj_text(wa_scope(sid),"approval_reviewer"),"auto_review"),"Reviewer changed Workspace scope");au_tap("Review access requests myself");h_assert(h_equal(cj_text(wa_scope(sid),"approval_reviewer"),"user"),"Manual reviewer did not persist");au_tap("Back to conversation");at_pass("actual reviewer buttons remain independent of Workspace scope");
    let source="fn main(){if !fs_write(\"workspace.txt\",db_text(\"local workspace\")) || !db_begin(){return 1;}let s=db_schema();db_column(s,\"n\",1,0);if !db_create(\"workspace_values\",s) || !db_commit(){return 2;}let t=fs_read(\"workspace.txt\",0,100);db_io(0,1,db_word(t),db_bytes(t));return 0;}";
    let name=at_conversation(sid,source,0);let o=at_observation(at_result(name));h_assert(cj_int(o,"exit_code")==0&&h_equal(cj_text(o,"stdout"),"local workspace"),j_dump(o));wa_scope(sid);au_shot(shots,"local-result");at_pass("real Android VM reads and writes private workspace files and commits a FlexDB transaction without a permission prompt");
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");at_case(sid,c_json("{\"resume_only\":true}"));wa_scope(sid);name=at_conversation(sid,"fn main(){let t=fs_read(\"workspace.txt\",0,100);if !t{return 1;}db_io(0,1,db_word(t),db_bytes(t));return 0;}",0);o=at_observation(at_result(name));h_assert(cj_int(o,"exit_code")==0&&h_equal(cj_text(o,"stdout"),"local workspace"),j_dump(o));at_pass("process recreation retains Workspace mode and its private file contents");
    name=at_conversation(sid,"fn main(){http_get(\"https://example.com/\");return 0;}",0);at_pending(sid,"internet","permission",name);au_shot(shots,"outside-prompt");at_click("text","Deny requested access",0);o=at_observation(at_result(name));h_assert(h_has(cj_text(o,"stderr"),"Permission denied")||h_has(cj_text(o,"stdout"),"Permission denied")||!at_bool(cj_get(wa_policy(sid),"internet")),j_dump(o));policy=wa_policy(sid);h_assert(h_equal(cj_text(policy,"permission_profile"),"custom")&&!at_bool(cj_get(policy,"internet"))&&at_bool(cj_get(policy,"files_write"))&&h_equal(cj_text(policy,"workers"),"ask"),"Customizing outside access changed unrelated grants");at_pass("outside Internet use pauses for real native consent; denying it switches to Custom while retaining local grants");
    return at_finish(j_object());
}
