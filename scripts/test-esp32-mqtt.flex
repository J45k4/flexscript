    h_ok(h_args(te_compiler,"--target","esp32-xip-elf","tests/esp32/mqtt-client-xip.flex","-o",te_fixture));a=h_args(link,"--firmware",te_fixture,"--output",h_join(te_work,"linked.elf"),"--xip");h_add(a,"--ld");h_add(a,b_option(argc,argv,"--ld","xtensa-esp32-elf-ld"));h_add(a,"--rom");h_add(a,h_join(b_option(argc,argv,"--rom","."),"esp32.rom.ld"));h_add(a,"--image");h_add(a,te_binary);h_ok(a);te_run(te_binary,0,0);
