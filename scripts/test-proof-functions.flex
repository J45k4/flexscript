import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("spec fn twice(x){return x+x;}ensures result==twice(x);fn double(x){return x*2;}",0,"Verified roots: 2/2");
    ps_verify("ensures result==twice(x);fn double(x){return x*2;}spec fn twice(x){return x+x;}",0,"Verified roots: 2/2");
    ps_verify("spec fn bump(x){x=x+1;let y=x+1;return y;}ensures result==x+2;fn ordinary(x){ghost let proof_value=bump(x);assert proof_value==x+2;return x+2;}",0,"Verified roots: 2/2");
    ps_verify("spec fn positive(x){return x>0;}requires positive(x);ensures result>0;fn keep(x){return x;}",0,"Verified roots: 2/2");
    ps_verify("requires x!=0;spec fn nonzero(x){return x!=0;}requires x==0;ensures nonzero(x);fn bad(x){return 0;}",1,"COUNTEREXAMPLE: callee requirement");
    ps_verify("requires x!=0;spec fn nonzero(x){return x!=0;}requires x==0;ensures nonzero(x);fn bad(x){return 0;}ensures result==0;fn caller(){return bad(0);}",1,"unresolved dependency: bad");
    ps_verify("requires x>0;spec fn positive(x){return x>0;}ensures positive(result);fn one(){return 1;}ensures result==1;fn caller(){return one();}",1,"abstract call countermodel");
    ps_verify("requires x!=0;spec fn inverse(x){return 1/x;}requires x==1;ensures inverse(result)==1;fn one(x){return x;}ensures result==1;fn caller(){return one(1);}",0,"Verified roots: 3/3");
    ps_verify("requires x!=0;spec fn inverse(x){return 1/x;}ensures result==1;ensures inverse(result)==1;fn one(){return 1;}ensures result==1;fn caller(){return one();}",0,"Verified roots: 3/3");
    ps_verify("global g=0;reads g;spec fn current(){return g;}requires g==2;ensures result==old(current()) && g==3;fn snapshot(){g=3;return 2;}",0,"Verified roots: 2/2");
    ps_verify("global g=0;reads g;spec fn current(){return g;}requires g==2;ensures result==old(current()) && g==3;fn snapshot(){g=3;return 3;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("global g=0;spec fn current(){return g;}reads nothing;ensures current()==0;fn frame(){return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0;reads nothing;spec fn current(){return g;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0;spec fn current(){return g;}requires g==2;ensures g==3;fn snapshot(){g=3;proof {assert current()==3;}return 0;}",0,"Verified roots: 2/2");
    ps_verify("spec fn tiny(x){return forall i in 0..3: i<3;}ensures forall i in 0..3: tiny(i) && i<3;fn outer(){return 0;}",0,"Verified roots: 2/2");
    ps_verify("spec fn tiny(x){return exists i in 4..5: i==4;}ensures forall i in 0..3: tiny(i) && i==0;fn outer(){return 0;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("requires n>=0;ensures result==old(n);decreases n;spec fn count(n){if n==0{return 0;}n=n-1;return count(n)+1;}requires n>=0;ensures result==count(n);fn same(n){return n;}",0,"Verified roots: 2/2");
    ps_verify("requires n>=0;ensures result==0;decreases n;spec fn left(n){if n==0{return 0;}return right(n-1);}requires n>=0;ensures result==0;decreases n;spec fn right(n){if n==0{return 0;}return left(n-1);}",0,"Verified roots: 2/2");
    let p=ps_verify("ensures result==0;spec fn forever(){return forever();}ensures result==0;fn caller(){assert forever()==0;return 0;}",1,"recursive calls require function decreases clauses");
    t_assert(!h_has(h_out(p),"PROVED: partial correctness"),"nonterminating spec helper allowed partial correctness");
    p=ps_verify("ensures result==0;spec fn forever(){while 1 {}return 0;}ensures result==0;fn caller(){assert forever()==0;return 0;}",1,"loop termination requires decreases");
    t_assert(!h_has(h_out(p),"PROVED: partial correctness"),"divergent spec loop proved an executable fact");
    ps_verify("requires self(x);spec fn self(x){return 1;}",1,"recursive calls in function contracts");
    ps_verify("ensures other(x);spec fn self(x){return 1;}spec fn other(x){return self(x);}",1,"recursive calls in function contracts");
    ps_verify("ensures result==0;spec fn liar(){return 1;}ensures result==1;fn caller(){assert liar()==0;return 1;}",1,"unresolved dependency: liar");
    p=ps_verify("ensures result==0;spec fn liar(){return 1;}requires liar()==1;fn caller(){return 0;}",1,"requirement consistency depends on unproved proof functions");
    t_assert(!h_has(h_out(p),"VACUOUS:"),"invalid specification contract certified vacuity");
    ps_verify("spec fn zero(){return 0;}requires zero();fn impossible(){return 0;}",1,"VACUOUS: requirements are unsatisfiable");
    p=ps_verify("requires n>=0;decreases n;spec fn zero(n){if n==0{return 0;}return zero(n-1);}requires n>=0;requires zero(n);fn impossible(n){return 0;}",1,"UNPROVED: requirement satisfiability");
    t_assert(!h_has(h_out(p),"RESULT impossible\nPROVED:"),"abstract spec result certified reachable requirements");
    ps_verify("requires n>=0;ensures result==0;decreases n;spec fn zero(n){if n==0{return 0;}return zero(n-1);}requires n>=0;requires zero(n);fn impossible(n){return 0;}",1,"VACUOUS: requirements are unsatisfiable");
    ps_verify("requires n>=0 && n<10;ensures result==n;spec fn counted(n){let i=0;invariant i>=0 && i<=n;decreases n-i;while i<n{i=i+1;}return i;}requires n>=0 && n<10;ensures counted(n)==result;fn same(n){return n;}",0,"Verified roots: 2/2");
    ps_verify("ensures x+x==x*2;lemma fn doubling(x){assert x+x==x*2;}ensures result==x*2;fn caller(x){proof {doubling(x);}return x+x;}",0,"Verified roots: 2/2");
    ps_verify("requires x>=0;ensures x>=0;lemma fn nonnegative(x){}requires x==-1;fn caller(x){proof {nonnegative(x);}return x;}",1,"COUNTEREXAMPLE: callee requirement");
    p=ps_verify("ensures 0;lemma fn invalid(){}ensures result==0;fn caller(){proof {invalid();}return 1;}",1,"unresolved dependency: invalid");
    t_assert(!h_has(h_out(p),"RESULT caller\nPROVED:"),"false lemma postcondition proved caller");
    ps_verify("requires n>=0;ensures n>=0;decreases n;lemma fn descent(n){if n {descent(n-1);}return 0;}",0,"Verified roots: 1/1");
    p=ps_verify("ensures 0;lemma fn circle(){circle();}fn caller(){proof {circle();}assert 0;return 0;}",1,"recursive calls require function decreases clauses");
    t_assert(!h_has(h_out(p),"PROVED: partial correctness"),"circular lemma established a theorem");
    ps_verify("spec fn twice(x){return x+x;}ensures twice(x)==x*2;lemma fn doubling(x){assert twice(x)==x*2;}",0,"Verified roots: 2/2");
    ps_verify("ensures x==old(x)+1;lemma fn mutable(x){x=x+1;}fn caller(x){proof {mutable(x);}assert x==x;return x;}",0,"Verified roots: 2/2");
    ps_verify("ensures x==old(x)+1;lemma fn mutable(x){x=x+1;}fn caller(x){proof {mutable(x);}assert x==x+1;return x;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("global g=0;ensures g==old(g);lemma fn read_global(){}reads nothing;fn caller(){proof {read_global();}return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("lemma fn empty(){}spec fn value(){empty();return 1;}ensures value()==1;fn caller(){return 0;}",0,"Verified roots: 3/3");
    ps_bad("spec fn pure(){return 1;}fn main(){return pure();}","executable code cannot call spec functions or lemmas");
    ps_bad("lemma fn pure(){}fn main(){pure();return 0;}","executable code cannot call spec functions or lemmas");
    ps_bad("lemma fn theorem(){}ensures theorem();fn main(){return 0;}","lemmas may be called only as proof statements");
    ps_bad("lemma fn theorem(){}fn main(){ghost let x=theorem();return 0;}","lemmas may be called only as proof statements");
    ps_bad("lemma fn theorem(){}spec fn bad(){return theorem();}","lemmas may be called only as proof statements");
    ps_bad("global g=0;spec fn bad(){g=1;return 0;}","proof code can assign only ghost variables");
    ps_bad("global g=0;lemma fn bad(){g=1;}","proof code can assign only ghost variables");
    ps_bad("global g=0;modifies g;spec fn bad(){return 0;}","proof functions cannot declare nonempty modifies frames");
    ps_bad("fn effect(){return 0;}spec fn bad(){return effect();}","specification calls require a supported spec function");
    ps_verify("spec fn bad(){return load64(0);}",1,"COUNTEREXAMPLE: memory read safety");
    ps_bad("lemma fn bad(){store64(0,1);}","proof expressions cannot modify or allocate memory");
    ps_bad("spec fn bad(){return missing();}","specification calls require a supported spec function");
    ps_bad("spec fn identity(x){return x;}ensures identity();fn bad(){return 0;}","wrong proof function argument count");
    ps_bad("lemma fn theorem(x){}fn bad(){proof {theorem();}return 0;}","wrong proof function argument count");
    ps_bad("ensures result==0;lemma fn bad(){}","lemma postconditions cannot use result");
    ps_bad("lemma fn bad(){return 1;}","lemma returns must be literal zero");
    ps_bad("spec fn bad(){proof {return 0;}return 0;}","proof code cannot return from an executable function");
    ps_bad("lemma fn bad(){proof {return 0;}}","proof code cannot return from an executable function");
    ps_bad("spec global g=0;","spec or lemma must directly precede fn");
    ps_bad("lemma verify;fn bad(){}","spec or lemma must directly precede fn");
    ps_bad("spec fn bad(){return \"hello\";}","strings are not supported in proof functions");
    t_native("ensures 0;lemma fn bad(){assert 0;}spec fn broken(){return 1/0;}fn main(){proof {bad();let x=broken();}return 42;}",42,"");
    h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let checksum=h_sha(t_binary);t_program("fn main(){return 42;}");t_compile();t_assert(h_equal(checksum,h_sha(t_binary)),"proof function erasure changed executable bytes");
    h_save(h_join(t_work,"logic.flex"),"spec fn twice(x){return x+x;}ensures twice(x)==x*2;lemma fn doubling(x){}");
    ps_verify("import \"logic.flex\";ensures result==twice(x);fn caller(x){proof {doubling(x);}return x+x;}",0,"Verified roots: 3/3");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
