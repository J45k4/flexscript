// Progress and feedback retain VM state across fresh native host processes.
import "lib/collie-test.flex";
fn sg_failure(t,text,cancelled){let r=ct_request("failure",cj_get(t,"state"));j_set(r,"error",j_string(text));j_set(r,"cancelled",j_bool(cancelled));return ct_step(r);}
fn sg_observation(t){return ct_transition("observation",t,"observation",ct_observe(t));}
fn sg_output(t){let messages=cj_get(cj_get(t,"state"),"messages");let results=j_array();let i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output"){j_push(results,m);}i=i+1;}h_assert(j_count(results)==1,j_dump(messages));return c_json(cj_text(j_at(results,0),"output"));}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));let original=c_json(j_dump(ct_config));
    let source="fn nested(){let p=alloc(8);store64(p,77);fs_write(\"once.txt\",db_text(\"original\"));if !progress(\"Files downloaded\"){return 1;}let answer=agent_ask(\"Which route should I take?\");if !answer{return 2;}db_io(0,1,db_word(answer),db_bytes(answer));if !progress(\"Applying feedback\"){return 3;}return load64(p)-77;}fn main(){return nested();}";
    let t=ct_begin(source,"main");let o=ct_observe(t);h_assert(h_equal(cj_text(o,"state"),"progress")&&h_equal(cj_text(cj_get(o,"signal"),"text"),"Files downloaded"),j_dump(o));t=ct_command(ct_transition("observation",t,"observation",o),"vm");h_assert(h_equal(cj_text(j_at(cj_get(t,"cards"),0),"text"),"Files downloaded")&&j_count(cj_get(cj_get(t,"state"),"messages"))==1&&cj_get(cj_get(t,"state"),"pending_execution")&&h_exists(h_join(ct_root,"vm-0.checkpoint")),j_dump(t));ct_pass("progress reaches the shared conversation before program completion or model continuation");
    o=ct_observe(t);h_assert(h_equal(cj_text(o,"state"),"feedback")&&cj_int(cj_get(o,"signal"),"id")==2,j_dump(o));t=ct_command(ct_transition("observation",t,"observation",o),"feedback");let messages=cj_get(cj_get(t,"command"),"messages");let i=0;while i<j_count(messages){h_assert(!h_equal(cj_text(j_at(messages,i),"type"),"custom_tool_call"),"Feedback leaked an unpaired tool call");i=i+1;}let req=j_object();j_set(req,"config",ct_config);j_set(req,"messages",messages);j_set(req,"feedback",j_bool(1));let body=ct_call(1,req);h_assert(j_count(cj_get(body,"tools"))==0&&h_has(cj_text(body,"instructions"),"agent_ask feedback"),j_dump(body));ct_pass("model feedback branches from completed context without an unpaired parent call or executable tools");
    let file=h_join(ct_root,"files/once.txt");h_save(file,"changed after suspension");t=ct_command(ct_transition("resume",c_json(j_dump(t)),0,0),"feedback");h_assert(h_equal(h_read(file),"changed after suspension"),"Resume replayed the earlier write");t=ct_transition("feedback",t,"reply",ct_reply("Take route B."));o=ct_observe(t);h_assert(h_equal(cj_text(o,"state"),"progress")&&h_equal(cj_text(o,"stdout"),"Take route B.")&&h_equal(h_read(file),"changed after suspension"),j_dump(o));t=ct_transition("observation",t,"observation",o);o=ct_continued(ct_observe(t));h_assert(h_equal(cj_text(o,"stdout"),""),j_dump(o));t=ct_command(ct_transition("observation",t,"observation",o),"model");h_assert(cj_int(cj_get(t,"command"),"response_index")==2,j_dump(t));let result=sg_output(t);h_assert(h_equal(cj_text(result,"stdout"),"Take route B.")&&j_count(cj_get(result,"signals"))==3&&h_equal(cj_text(cj_get(j_at(cj_get(result,"signals"),1),"answer"),"text"),"Take route B.")&&j_kind(cj_get(cj_get(t,"state"),"pending_execution"))==0,j_dump(result));ct_pass("feedback resumes original nested frames and locals across restarts without replay; one final tool result collects all output");
    source="fn main(){let answer=agent_ask(\"Advice\");if answer{return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}";i=0;while i<2{let key="nested";let error="no nested tool";if i{key="failure";error="transport unavailable";}t=sg_observation(ct_begin(source,key));if i{t=sg_failure(t,error,0);}else{t=ct_transition("feedback",t,"reply",ct_program("fn main(){return fs_write(\"forbidden.txt\",db_text(\"bad\"));}","bad"));}o=ct_continued(ct_observe(t));h_assert(h_has(cj_text(o,"stdout"),error),j_dump(o));i=i+1;}h_assert(!h_exists(h_join(ct_root,"files/forbidden.txt")),"Nested feedback program executed");ct_pass("feedback transport failures and attempted nested tools return a checked error to the caller without executing code");
    t=sg_failure(sg_observation(ct_begin(source,"cancel")),"Cancelled.",1);ct_command(t,"done");h_assert(j_kind(cj_get(cj_get(t,"state"),"pending_execution"))==0,j_dump(t));ct_pass("cancellation pairs the pending original tool call and does not request another model turn");
    t=sg_observation(ct_begin(source,"revoke"));let grants=ct_grants(j_bool(1));j_set(grants,"workers",j_bool(0));j_set(ct_config,"permissions",grants);t=ct_command(ct_transition("next",t,0,0),"vm");o=ct_observe(t);h_assert(h_has(cj_text(o,"stdout"),"Permission denied: workers"),j_dump(o));t=ct_transition("observation",t,"observation",o);result=sg_output(t);h_assert(h_equal(cj_text(cj_get(j_at(cj_get(result,"signals"),0),"answer"),"error"),"Permission denied: workers"),j_dump(result));o=ct_execute("fn main(){return progress(\"Computation still works\")-1;}","progress-denied-policy",0);h_assert(h_equal(cj_text(o,"state"),"progress"),j_dump(o));ct_config=c_json(j_dump(original));ct_pass("revocation prevents the feedback model request; ordinary progress remains available without worker permission");
    o=ct_continued(ct_execute("fn main(){return worker_start(\"Reviewer\",\"Review data\")-1;}","create-reviewer",0));j_set(ct_config,"agent_id",j_int(1));req=ct_request("open_worker",0);j_set(req,"revision",j_int(1));t=ct_step(req);t=ct_transition("reply",t,"reply",ct_program("fn main(){let answer=agent_ask(\"Review\");if !answer{return 1;}db_io(0,1,db_word(answer),db_bytes(answer));return 0;}","worker-review"));t=sg_observation(t);h_assert(cj_int(cj_get(t,"command"),"response_index")==1,j_dump(t));req=ct_request("open_worker",0);j_set(req,"revision",j_int(1));t=ct_command(ct_step(req),"feedback");h_assert(cj_int(cj_get(t,"command"),"response_index")==1,j_dump(t));t=ct_transition("feedback",t,"reply",ct_reply("Reviewed"));o=ct_continued(ct_observe(t));h_assert(h_equal(cj_text(o,"stdout"),"Reviewed"),j_dump(o));t=ct_transition("observation",t,"observation",o);h_assert(cj_int(cj_get(t,"command"),"response_index")==2,j_dump(t));ct_command(ct_transition("reply",t,"reply",ct_reply("Worker complete")),"done");j_set(ct_config,"agent_id",j_int(0));ct_pass("worker restart restores its pending feedback branch, request cursor and original program");
    let invalid=h_args("fn main(){syscall(10001,-1,0,0,0,0,0);return 0;}","fn main(){db_begin();progress(\"inside transaction\");let e=db_error();db_io(0,1,e,db_len(e));db_rollback();return 0;}",0,0,0,0);let needles=h_args("matching request","transaction",0,0,0,0);i=0;while i<2{o=ct_execute(h_at(invalid,i),"invalid",0);h_assert(h_has(h_cat(cj_text(o,"stderr"),cj_text(o,"stdout")),h_at(needles,i)),j_dump(o));i=i+1;}ct_pass("raw unprepared yields and open database transactions cannot publish incomplete progress");
    source="fn main(){let i=0;while i<33{if !progress(\"tick\"){let e=db_error();db_io(0,1,e,db_len(e));return i-32;}i=i+1;}return 1;}";i=0;while i<32{let resume=i>0;o=ct_execute(source,"budget",resume);h_assert(h_equal(cj_text(o,"state"),"progress")&&cj_int(cj_get(o,"signal"),"id")==i+1,j_dump(o));i=i+1;}o=ct_continued(ct_execute(source,"budget",1));h_assert(h_has(cj_text(o,"stdout"),"At most 32"),j_dump(o));ct_pass("signal quota and execution budgets persist across every native-process suspension");
    return ct_done(j_object(),"signals-report.json");
}
