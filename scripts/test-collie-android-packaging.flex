// Inspect actual APK entry bytes, DEX class definitions and compiled Android
// service metadata. Literal class-name references are not class definitions.
import "../apps/collie/android/build.flex";
global pt_aapt=0;
fn pt_indent(s){let n=0;while load8(s+n)==32{n=n+1;}return n;}
fn pt_line_end(s,at){while load8(s+at)&&load8(s+at)!=10{at=at+1;}return at;}
fn pt_sections(text,tag){let result=h_vec();let at=0;let marker=h_cat("E: ",tag);while load8(text+at){let end=pt_line_end(text,at);let line=h_slice(text+at,end-at);let indent=pt_indent(line);let n=h_len(marker);if h_starts(line+indent,marker)&&(!load8(line+indent+n)||cs_space(load8(line+indent+n))){let stop=end;if load8(text+stop){stop=stop+1;}let done=0;while load8(text+stop)&&!done{let next=pt_line_end(text,stop);let child=h_slice(text+stop,next-stop);let depth=pt_indent(child);if h_starts(child+depth,"E:")&&depth<=indent{done=1;}else{stop=next;if load8(text+stop){stop=stop+1;}}}h_add(result,h_slice(text+at,stop-at));at=stop;}else{at=end;if load8(text+at){at=at+1;}}}return result;}
fn pt_section(text,tag,needle){let list=pt_sections(text,tag);let found=0;let i=0;while i<h_count(list){let section=h_at(list,i);if h_has(section,needle){h_assert(!found,"Ambiguous compiled manifest section");found=section;}i=i+1;}h_assert(found,h_cat("Missing compiled manifest declaration: ",needle));return found;}
fn pt_attr(text,key){let marker=h_cat(":",key);let at=h_find(text,marker);h_assert(at>=0,h_cat("Missing compiled manifest attribute: ",key));let end=pt_line_end(text,at);let line=h_slice(text+at,end-at);let equal=h_find(line,"=");h_assert(equal>=0,"Malformed compiled attribute");let value=h_trim(line+equal+1);let size=0;while load8(value+size)&&!cs_space(load8(value+size)){size=size+1;}return h_slice(value,size);}
fn pt_hex(s){h_assert(h_starts(s,"0x"),"Expected compiled hexadecimal manifest flags");let n=0;let i=2;while load8(s+i){let c=load8(s+i);let digit=c-48;if c>=97&&c<=102{digit=c-87;}else if c>=65&&c<=70{digit=c-55;}h_assert(digit>=0&&digit<16&&i<18,"Invalid manifest hexadecimal value");n=n*16+digit;i=i+1;}return n;}
fn pt_xml(apk,file){return h_out(h_ok(h_args(pt_aapt,"dump","xmltree",apk,"--file",file)));}
fn pt_dex_string(data,size,ids,count,index){h_assert(index<count,"DEX string index");let at=az_u32(data+ids+index*4);h_assert(at<size,"DEX string offset");let i=0;let more=1;while more{h_assert(at<size&&i<5,"DEX string length");more=load8(data+at)&128;at=at+1;i=i+1;}let end=at;while end<size&&load8(data+end)&&end-at<=4096{end=end+1;}h_assert(end<size&&end-at<=4096,"DEX descriptor exceeds bound");return h_slice(data+at,end-at);}
fn pt_definitions(archive){
    let names=h_vec_sized(65535);let entries=load64(archive+16);let at=0;
    while at<h_count(entries){let e=h_at(entries,at);let name=load64(e);if h_starts(name,"classes")&&ad_suffix(name,".dex"){
        let data=az_data(e);let size=load64(e+24);h_assert(size>=112&&h_bytes(data,"dex\n",4)&&az_u32(data+32)==size&&az_u32(data+36)==112,"Unsupported DEX header");let strings=az_u32(data+56);let ids=az_u32(data+60);let types=az_u32(data+64);let type_ids=az_u32(data+68);let count=az_u32(data+96);let classes=az_u32(data+100);h_assert(ids+strings*4<=size&&type_ids+types*4<=size&&classes+count*32<=size&&count<=65535,"DEX tables exceed file");
        let i=0;while i<count{let type=az_u32(data+classes+i*32);h_assert(type<types,"DEX class type index");let string=az_u32(data+type_ids+type*4);h_add_sized(names,pt_dex_string(data,size,ids,strings,string));i=i+1;}
    }at=at+1;}h_assert(h_count(names)>0,"APK has no actual DEX class definitions");return names;
}
fn pt_has(names,name){let i=0;while i<h_count(names){if h_equal(h_at(names,i),name){return 1;}i=i+1;}return 0;}
fn pt_check(apk,debug){
    apk=h_real(apk);let archive=az_open(apk);let manifest=pt_xml(apk,"AndroidManifest.xml");let mode="false";if debug{mode="true";}h_assert(h_equal(pt_attr(manifest,"debuggable"),mode),"Compiled debuggable flag mismatch");let names=pt_definitions(archive);let fixtures=ab_files("apps/collie/tests/android",".java",0);let i=0;
    while i<h_count(fixtures){let path=h_at(fixtures,i);let name=path+h_len(h_dir(path))+1;let prefix=h_cat("Lorg/flexscript/collie/",h_slice(name,h_len(name)-5));let present=pt_has(names,h_cat(prefix,";"));h_assert(present==debug,h_cat("Debug-only class isolation failed: ",prefix));if !debug{let j=0;while j<h_count(names){h_assert(!h_starts(h_at(names,j),h_cat(prefix,"$")),"Debug nested class leaked into release");j=j+1;}}i=i+1;}
    h_assert(pt_has(names,"Lorg/flexscript/collie/HardwareUwbGms;")&&pt_has(names,"Lorg/flexscript/collie/HardwareSensorDirect;"),"Production SDK adapters missing from DEX");h_assert(!pt_has(names,"Lorg/flexscript/collie/uiprobe/UiProbe;")&&!pt_has(names,"Lorg/flexscript/collie/documentfixture/HardwareDocumentProviderFixture;"),"Separate fixture APK classes leaked into Collie");h_assert(az_find(archive,"lib/arm64-v8a/libcollie_hardware.so")&&(!!az_find(archive,"lib/arm64-v8a/libcollie_sensor_fixture.so"))==debug,"Native fixture isolation failed");
    let lock=az_find(archive,"assets/collie-android-dependencies.json");h_assert(lock,"Packaged SDK manifest is absent");let text=h_slice(az_data(lock),load64(lock+24));h_assert(h_equal(j_dump(c_json(text)),j_dump(c_json(h_read("apps/collie/android/dependencies.json")))),"Packaged SDK lock differs from reviewed pins");let artifacts=cj_get(c_json(text),"artifacts");i=0;while i<j_count(artifacts){h_assert(j_count(cj_get(j_at(artifacts,i),"licenses"))>0,"SDK license declaration missing");i=i+1;}
    let entries=load64(archive+16);let resource=0;i=0;while i<h_count(entries){let name=load64(h_at(entries,i));if h_has(name,"midi_loopback_fixture"){resource=1;}h_assert(!ad_suffix(name,".py")&&!ad_suffix(name,".pyc"),"Python source/bytecode in APK");i=i+1;}h_assert(resource==debug,"Debug-only resource isolation failed");
    let accessibility=pt_section(manifest,"service",".CollieAccessibilityService");h_assert(h_has(accessibility,"android.permission.BIND_ACCESSIBILITY_SERVICE")&&h_equal(pt_attr(accessibility,"exported"),"true")&&h_has(accessibility,"android.accessibilityservice.AccessibilityService")&&h_has(accessibility,"android.accessibilityservice"),"Accessibility service binding is not protected");let xml=pt_xml(apk,"res/xml/accessibility.xml");h_assert(h_equal(pt_attr(xml,"canRetrieveWindowContent"),"true")&&h_equal(pt_attr(xml,"canPerformGestures"),"true")&&!h_has(xml,"accessibilityEventTypes"),"Accessibility starts subscribed or lacks required capabilities");h_assert(!h_has(manifest,"FLAG_DONT_SUPPRESS")&&!h_count(pt_sections(manifest,"instrumentation")),"UI instrumentation leaked into Collie");
    let projection=pt_section(manifest,"service",".CollieProjectionService");h_assert(h_equal(pt_attr(projection,"exported"),"false")&&pt_hex(pt_attr(projection,"foregroundServiceType"))==160,"Projection service exposure/types mismatch");let permissions=h_args("android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION","android.permission.FOREGROUND_SERVICE_MICROPHONE","android.permission.FOREGROUND_SERVICE","android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED","android.permission.USE_BIOMETRIC","android.permission.HIGH_SAMPLING_RATE_SENSORS");h_add(permissions,"android.permission.RANGING");h_add(permissions,"android.permission.UWB_RANGING");h_add(permissions,"android.permission.CAMERA");i=0;while i<h_count(permissions){h_assert(h_has(manifest,h_cat3("\"",h_at(permissions,i),"\"")),"Required manifest permission missing");i=i+1;}
    let providers=pt_sections(manifest,"provider");i=0;while i<h_count(providers){h_assert(!h_has(h_at(providers,i),"HardwareDocumentProviderFixture"),"The document provider fixture leaked into Collie");i=i+1;}h_assert((!!h_has(manifest,"org.flexscript.collie.documentfixture.CONTROL"))==debug,"Fixture control permission leaked into release");let services=pt_sections(manifest,"service");let midi=0;let hce_peer=0;i=0;while i<h_count(services){let service=h_at(services,i);h_assert(!h_has(service,"com.google."),"Unrelated SDK service merged into Collie");if h_has(service,"MidiLoopbackFixture"){midi=1;}if h_has(service,"HardwareHcePeerFixture"){hce_peer=1;}i=i+1;}h_assert(midi==debug&&hce_peer==debug,"Debug-only Android service isolation failed");
    let vpn=pt_section(manifest,"service",".CollieVpnService");h_assert(h_has(vpn,"android.permission.BIND_VPN_SERVICE")&&pt_hex(pt_attr(vpn,"foregroundServiceType"))==1024&&h_has(vpn,"android.net.VpnService.SUPPORTS_ALWAYS_ON")&&h_equal(pt_attr(vpn,"value"),"false"),"VPN binding, foreground type or always-on policy mismatch");
    let optional=h_args("android.hardware.uwb","android.hardware.camera","android.hardware.camera.any","android.hardware.camera.autofocus","android.hardware.nfc.hce","android.hardware.nfc.hcef");i=0;while i<h_count(optional){let section=pt_section(manifest,"uses-feature",h_cat3("\"",h_at(optional,i),"\""));h_assert(h_equal(pt_attr(section,"required"),"false"),"Optional hardware became an install requirement");i=i+1;}
    let hce=h_args("CollieHceService","CollieHcePaymentService","CollieHceFService","CollieHceBackgroundService","CollieHceBackgroundPaymentService",0);i=0;while i<h_count(hce){let name=h_at(hce,i);let service=pt_section(manifest,"service",h_cat3(".",name,"\""));h_assert(h_has(service,"android.permission.BIND_NFC_SERVICE")&&h_equal(pt_attr(service,"enabled"),"false")&&h_equal(pt_attr(service,"exported"),"true"),"HCE service must be protected and disabled by default");let resource="hce_other";let action="HOST_APDU_SERVICE";if i==1||i==4{resource="hce_payment";}if i==2{resource="hce_f";action="HOST_NFCF_SERVICE";}h_assert(h_has(service,action),"HCE SDK action missing");if i>=3{h_assert(h_has(service,":hce_background"),"Background card callback process missing");}xml=pt_xml(apk,h_cat3("res/xml/",resource,".xml"));if i==2{h_assert(h_has(pt_section(xml,"system-code-filter","system-code-filter"),"\"NULL\"")&&h_has(pt_section(xml,"nfcid2-filter","nfcid2-filter"),"\"NULL\""),"A static NFC-F route leaked into APK");}else{h_assert(h_equal(pt_attr(xml,"requireDeviceUnlock"),"true"),"HCE unlock policy changed");}i=i+1;}
    let sha=h_sha(apk);h_assert(h_equal(sha,cj_text(c_json(h_read(h_join(h_dir(apk),"build.json"))),"sha256")),"APK differs from its build report");let report=j_object();j_set(report,"path",j_string(apk));j_set(report,"bytes",j_int(ad_size(apk)));j_set(report,"sha256",j_string(sha));j_set(report,"debug_fixtures",j_bool(debug));j_set(report,"dex_class_definitions",j_int(h_count(names)));j_set(report,"vpn_binding",j_string("BIND_VPN_SERVICE"));j_set(report,"vpn_foreground_type",j_string("systemExempted"));j_set(report,"vpn_always_on",j_bool(0));return report;
}
fn main(argc,argv){
    h_environment(argc,argv);let debug=0;let release=0;pt_aapt="/opt/android-sdk/build-tools/36.1.0/aapt2";let i=1;while i<argc{let key=load64(argv+i*8);i=i+1;h_assert(i<argc,"Missing packaging-check value");let value=load64(argv+i*8);if h_equal(key,"--debug"){debug=h_real(value);}else if h_equal(key,"--release"){release=h_real(value);}else if h_equal(key,"--aapt2"){pt_aapt=h_real(value);}else{h_die(h_cat("Unknown packaging check option: ",key));}i=i+1;}h_assert(debug&&release,"Provide --debug APK and --release APK");let report=j_object();j_set(report,"debug",pt_check(debug,1));j_set(report,"release",pt_check(release,0));j_save(h_join(h_dir(debug),"packaging-report.json"),report);h_print(1,h_cat(j_dump(report),"\n"));h_print(1,"PASS actual APK/DEX fixture isolation and protected Android service metadata\n");return 0;
}
