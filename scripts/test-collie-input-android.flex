// Owned-Activity touch, keyboard and kernel-backed emulator hotplug checks.
import "lib/collie-android-test.flex";
global in_source=0;
fn in_program(call){return h_cat3(in_source,"\nfn main(){return input_live_",h_cat(call,"();}"));}
fn in_vm(call){return at_vm(ut_prefix,in_program(call),0);}
fn in_device(){return h_cat("collie-input-fixture-",ut_prefix);}
fn in_remote(){return h_cat3("/data/local/tmp/",ut_prefix,"-keyboard");}
fn in_cleanup(){let end=net_now()+15000;let text="";while net_now()<end{let p=ut_ok(ut_args("shell","dumpsys","input",0,0,0),"");text=h_out(p);if !h_has(text,in_device()){ut_ok(ut_args("shell","rm","-f",in_remote(),0,0),"");return 0;}h_sleep(100);}h_die("Owned kernel keyboard has not been removed; preserve recovery evidence");return 1;}
fn in_stopped(text){let start=h_find(text,"packageName=org.flexscript.collie processName=org.flexscript.collie");if start<0{return 0;}let block=text+start;let end=h_find(block,"* Hist");if end>=0{block=h_slice(block,end);}return h_has(block,"state=STOPPED ");}
fn in_foreground(label){let text=h_out(ut_ok(ut_args("shell","dumpsys","activity","activities",0,0),""));h_save(h_join(ut_out,h_cat3("input-",label,"-activity.txt")),text);let rows=at_lines(text);let i=0;let found=0;while i<h_count(rows){let line=h_at(rows,i);if (h_has(line,"mResumedActivity")||h_has(line,"topResumedActivity"))&&h_has(line,"org.flexscript.collie"){found=1;}i=i+1;}h_assert(found,h_cat("Collie left foreground after ",label));return 0;}
fn in_line(child,offset,expected){let end=net_now()+10000;while net_now()<end{h_pump(child,10);let text=h_out(child);let at=h_find(text+offset,"\n");if at>=0{h_assert(h_equal(h_slice(text+offset,at+1),expected),h_cat("Unexpected kernel fixture reply: ",text));return offset+at+1;}h_assert(h_status(child)==-999,h_cat("Kernel fixture exited: ",h_err(child)));}h_die("Kernel input fixture response deadline");return 0;}
fn in_send(child,text){let offset=0;let end=net_now()+10000;while offset<h_len(text){let n=syscall(1,load64(child+32),text+offset,h_len(text)-offset,0,0,0);if n>0{offset=offset+n;}else{h_assert(n==-11||n==-4,"Kernel fixture input closed unexpectedly");h_pump(child,10);h_assert(net_now()<end&&h_status(child)==-999,"Kernel input write deadline");}}return 0;}
fn in_kernel(){
    h_assert(h_equal(h_trim(h_out(ut_ok(ut_args("shell","getprop","ro.product.cpu.abi",0,0,0),""))),"x86_64"),"Kernel fixture requires owned x86_64 emulator");let binary=h_join(ut_out,"input-device-fixture");let args=h_args(h_executable("gcc"),"-static","-O2","-Wall","-Wextra","-Werror");h_add(args,h_real("scripts/fixtures/collie-input-device.c"));h_add(args,"-o");h_add(args,binary);h_ok(args);in_vm("hotplug");ut_ok(ut_args("push",binary,in_remote(),0,0,0),"");ut_ok(ut_args("shell","chmod","700",in_remote(),0,0),"");let child=h_spawn(ut_args("shell","-T",in_remote(),in_device(),0,0),0,0);let offset=in_line(child,0,"created\n");at_vm(ut_prefix,h_cat3(in_source,"\nfn main(){return input_live_added(",h_cat(j_dump(j_string(in_device())),");}")),0);at_pass("a temporary kernel-backed keyboard reaches the actual Android device-added callback and VM inventory without recreating the Activity");
    in_vm("select");in_send(child,"key\n");offset=in_line(child,offset,"key sent\n");in_vm("selected_events");at_pass("real kernel keyboard F1 down/up events carry its actual Android device ID into the selected VM subscription");ut_ok(ut_args("shell","input","keyevent","131",0,0),"");in_vm("filter");at_pass("the selected-device filter excludes actual virtual-keyboard events whose delivery is independently observed by an all-device subscription");in_send(child,"quit\n");h_close(load64(child+32));store64(child+32,-1);let end=net_now()+10000;while h_status(child)==-999||load64(child+40)>=0||load64(child+48)>=0{h_pump(child,10);h_assert(net_now()<end,"Kernel device removal deadline");}h_assert(h_status(child)==0&&h_equal(h_out(child)+offset,"removed\n"),h_cat("Kernel removal failed: ",h_err(child)));in_vm("removed");at_pass("actual device removal closes its selected SDK subscription, preserves the global watcher and removes the device from inventory");ut_ok(ut_args("shell","rm","-f",in_remote(),0,0),"");return 0;
}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"input",j_object())<0{return at_self_test();}if at_cleanup{return in_cleanup();}if !at_child{return at_parent(argc,argv);}in_source=h_read("apps/collie/tests/input-live.flex");let sid=h_cat(ut_prefix,"-consent");let name=at_conversation(sid,"fn main(){let p=input_devices(0,16);if !p{return 1;}return 0;}",c_json("{\"input\":\"ask\"}"));at_pending(sid,"input","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));h_assert(at_bool(cj_get(cj_get(ut_read(h_cat3("files/workspaces/",sid,"/session.json")),"permissions"),"input")),"Input approval was not saved");at_pass("actual first-use Input approval resumes the original VM inventory call");at_vm(ut_prefix,in_program("inventory"),c_json("{\"input\":true,\"db_read\":true,\"db_write\":true}"));at_pass("actual Android device inventory, individual metadata, motion ranges and key capability query cross the VM");in_vm("invalid");at_pass("duplicate axes, invalid inventory bounds and absent devices return structured errors");in_vm("watch");ut_ok(ut_args("shell","input","touchscreen","tap","300","300"),"");ut_ok(ut_args("shell","input","keyevent","131",0,0),"");in_vm("touch_keys");at_pass("real emulator touch down/up coordinates and F1 key down/up are delivered through Activity callbacks to Flexscript");in_vm("close");at_pass("explicit close invalidates an owned input stream");in_vm("capacity");at_pass("eight actual SDK device listeners enforce the app subscription bound and closing releases capacity for a fresh listener");
    in_vm("motion_watch");ut_ok(ut_args("shell","input","stylus","tap","320","320"),"");in_foreground("stylus");let args=ut_args("shell","input","mouse","scroll","300","300");h_add(args,"--axis");h_add(args,"HSCROLL,-2.5");h_add(args,"--axis");h_add(args,"VSCROLL,1.25");ut_ok(args,"");in_foreground("mouse");ut_ok(ut_args("shell","input","joystick","roll","0.5","-0.25"),"");in_foreground("joystick");ut_ok(ut_args("shell","input","gamepad","keyevent","105",0),"");in_foreground("gamepad");in_vm("motion_events");at_pass("actual emulator stylus-source taps, fractional mouse scrolling, joystick axes and gamepad button events reach the VM");in_vm("background_watch");ut_ok(ut_args("shell","input","keyevent","3",0,0),"");let end=net_now()+60000;let stopped=0;while net_now()<end&&!stopped{let text=h_out(ut_ok(ut_args("shell","dumpsys","activity","activities",0,0),""));stopped=in_stopped(text);h_save(h_join(ut_out,"input-background-activity.txt"),text);if !stopped{h_sleep(50);}}h_assert(stopped,"Android did not stop the owned Activity");in_vm("background_closed");at_pass("leaving Collie closes input streams, and a visible return can open a fresh subscription");let sdk=at_sdk(ut_prefix,c_json("{\"hardware_input_tests\":true}"));h_assert(at_bool(cj_get(sdk,"constructed_motion_fixture")),"SDK fixture omitted constructed motion checks");in_kernel();let report=j_object();j_set(report,"physical_devices_verified",j_bool(0));return at_finish(report);
}
