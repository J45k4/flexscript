import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    let drop="trusted;terminates;reads nothing;modifies nothing;releases bytes(p,1);ensures !readable_bytes(old(p),1);fn drop(p){return 0;}";
    let maybe="trusted;terminates;reads nothing;modifies nothing;releases bytes(p,1);fn maybe(p){return 0;}";
    ps_verify("releases nothing;fn noop(){return 0;}",0,"Verified roots: 1/1");
    ps_verify("releases bytes(p,1);requires writable_bytes(p,1);ensures writable_bytes(p,1);fn upper_bound(p){return 0;}",0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);releases bytes(p,1);ensures !readable_bytes(p,1);fn caller(p){drop(p);return 0;}"),0,"CONDITIONAL:");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);modifies nothing;ensures !readable_bytes(p,1);fn caller(p){drop(p);return 0;}"),0,"modifies nothing; releases byte memory");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);ensures !readable_bytes(p,1);fn repeat(p){drop(p);drop(p);return 0;}"),0,"Verified roots: 1/1");
    let p=ps_verify(h_cat(drop,"requires writable_bytes(p,1);fn use_after_release(p){drop(p);return load8(p);}"),1,"UNPROVED: memory read safety");
    t_assert(h_has(h_out(p),"abstract call countermodel") && !h_has(h_out(p),"COUNTEREXAMPLE:"),"trusted release was reported as concrete execution");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);fn write_after_release(p){drop(p);return store8(p,1);}"),1,"UNPROVED: memory write safety");
    ps_verify(h_cat(maybe,"requires writable_bytes(p,1);ensures readable_bytes(p,1);fn stale(p){maybe(p);return 0;}"),1,"UNPROVED: postcondition");
    ps_verify(h_cat(maybe,"requires writable_bytes(p,1);ensures !readable_bytes(p,1);fn not_forced(p){maybe(p);return 0;}"),1,"UNPROVED: postcondition");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);releases nothing;fn forbidden(p){return drop(p);}"),1,"UNPROVED: release frame in forbidden");
    ps_verify(h_cat(drop,"requires writable_bytes(p,2);releases bytes(p,1);fn shifted(p){p=p+1;return drop(p);}"),1,"UNPROVED: release frame in shifted");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);requires readable_bytes(q,1);requires disjoint_bytes(p,1,q,1);releases bytes(p,1);ensures readable_bytes(q,1);ensures load8(q)==old(load8(q));fn outside(p,q){drop(p);return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);requires p==q;ensures readable_bytes(q,1);fn alias(p,q){drop(p);return 0;}"),1,"UNPROVED: postcondition");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);ensures old(writable_bytes(p,1));ensures !readable_bytes(p,1);fn snapshot(p){drop(p);return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);ensures result==old(load8(p));fn old_value(p){let saved=load8(p);drop(p);return saved;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);fn stale_ghost(p){ghost let allowed=writable_bytes(p,1);drop(p);proof {if allowed {assert writable_bytes(p,1);}}return 0;}"),1,"UNPROVED: assertion");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures !readable_bytes(old(p),1);fn impossible(p){return 0;}requires readable_bytes(p,1);fn caller(p){return impossible(p);}",1,"trusted normal-return contract admits no return state");
    ps_verify("trusted;terminates;reads nothing;modifies bytes(p,1);ensures !readable_bytes(old(p),1);fn content_only(p){return 0;}requires readable_bytes(p,1);fn caller(p){return content_only(p);}",1,"trusted normal-return contract admits no return state");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;releases bytes(p,1);ensures writable_bytes(old(p),1);fn cannot_grant(p){return 0;}requires readable_bytes(p,1) && !writable_bytes(p,1);fn caller(p){return cannot_grant(p);}",1,"trusted normal-return contract admits no return state");
    let keep_read="trusted;terminates;reads nothing;modifies nothing;releases bytes(p,1);ensures readable_bytes(old(p),1);fn keep_read(p){return 0;}";
    ps_verify(h_cat(keep_read,"requires writable_bytes(p,1);ensures load8(p)==old(load8(p));fn contents(p){keep_read(p);return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(keep_read,"requires writable_bytes(p,1);fn lost_write(p){keep_read(p);return store8(p,1);}"),1,"UNPROVED: memory write safety");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;releases nothing;fn preserve(){return 0;}requires writable_bytes(p,1);ensures writable_bytes(p,1);ensures load8(p)==old(load8(p));fn caller(p){preserve();return 0;}",0,"Verified roots: 1/1");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;releases bytes(0,0);fn empty(){return 0;}requires writable_bytes(p,1);releases nothing;ensures writable_bytes(p,1);fn caller(p){return empty();}",0,"Verified roots: 1/1");
    let wrapper=h_cat(drop,"requires writable_bytes(p,1);releases bytes(p,1);ensures !readable_bytes(p,1);fn wrapper(p){return drop(p);}");
    ps_verify(h_cat(wrapper,"requires writable_bytes(p,1);releases bytes(p,1);ensures !readable_bytes(p,1);fn outer(p){return wrapper(p);}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(wrapper,"requires writable_bytes(p,1);releases nothing;fn outer(p){return wrapper(p);}"),1,"UNPROVED: release frame in outer");
    ps_verify(h_cat(wrapper,"requires writable_bytes(p,1);requires readable_bytes(q,1);requires disjoint_bytes(p,1,q,1);ensures readable_bytes(q,1);fn outside(p,q){return wrapper(p);}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(drop,"requires p>0;requires n>=0 && n<=4;releases bytes(p,1);decreases n;ensures n==0 || !readable_bytes(p,1);fn recursive(p,n){if n {drop(p);recursive(p,n-1);}return 0;}"),0,"Verified roots: 1/1");
    let mixed=h_cat(drop,"fn write_tail(p){return store8(p+1,42);}requires writable_bytes(p,2);modifies bytes(p+1,1);releases bytes(p,1);ensures !readable_bytes(p,1) && load8(p+1)==42;fn mixed(p){drop(p);write_tail(p);return 0;}");
    ps_verify(h_cat(mixed,"requires writable_bytes(p,2);ensures !readable_bytes(p,1) && load8(p+1)==42;fn outer(p){return mixed(p);}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(mixed,"requires writable_bytes(p,2);ensures readable_bytes(p,1);fn outer(p){return mixed(p);}"),1,"UNPROVED: postcondition");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);requires flag==0;releases nothing;ensures writable_bytes(p,1);fn dead(p,flag){if flag {drop(p);}return 0;}"),0,"trusted external assumptions: none");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);ensures (old(flag)==0) || !readable_bytes(p,1);fn branch(p,flag){if flag {drop(p);}return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);ensures old(flag)!=0 || writable_bytes(p,1);fn short(p,flag){return flag && drop(p);}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);releases bytes(p,1);ensures !readable_bytes(p,1);fn loop(p){let i=0;invariant i>=0 && i<=2;invariant i==0 || !readable_bytes(p,1);decreases 2-i;while i<2{drop(p);i=i+1;}return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);releases bytes(p,1);fn stale_loop(p){let i=0;invariant i>=0 && i<=2;invariant writable_bytes(p,1);decreases 2-i;while i<2{drop(p);i=i+1;}return 0;}"),1,"UNPROVED: invariant preservation");
    ps_verify(h_cat(drop,"requires writable_bytes(p,1);requires readable_bytes(q,1);requires disjoint_bytes(p,1,q,1);releases bytes(p,1);ensures readable_bytes(q,1);fn outside_loop(p,q){let i=0;invariant i>=0 && i<=2;decreases 2-i;while i<2{drop(p);i=i+1;}return 0;}"),0,"Verified roots: 1/1");
    ps_verify(h_cat(drop,"requires writable_bytes(p,2);modifies bytes(p+1,1);releases bytes(p,1);ensures readable_bytes(p,1);fn mixed_loop(p){let i=0;invariant i>=0 && i<=2;invariant i==0 || !readable_bytes(p,1);decreases 2-i;while i<2{drop(p);store8(p+1,42);i=i+1;}return 0;}"),1,"UNPROVED: postcondition");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;releases bytes(p,2);ensures !readable_bytes(old(p),1);fn two(p){return 0;}requires p==16;requires writable_bytes(p,2);releases bytes(p,1);releases bytes(p+1,1);fn union(p){return two(p);}",0,"Verified roots: 1/1");
    ps_verify("releases bytes(0,1);fn invalid(){return 0;}",1,"COUNTEREXAMPLE: memory frame validity");
    ps_bad("releases nothing;releases bytes(p,1);fn bad(p){return 0;}","nothing cannot be mixed");
    ps_bad("releases bytes(p,1);releases nothing;fn bad(p){return 0;}","nothing cannot be mixed");
    ps_bad("global g=0;releases g;fn bad(){return 0;}","release frames require bytes");
    ps_bad("releases bytes(missing,1);fn bad(){return 0;}","undefined contract name");
    ps_bad("releases bytes(old(p),1);fn bad(p){return 0;}","old is allowed only once in a postcondition expression");
    ps_bad("releases bytes(store8(p,1),1);fn bad(p){return 0;}","proof expressions cannot modify or allocate memory");
    ps_bad("releases bytes(p,1);spec fn bad(p){return 0;}","proof functions cannot declare nonempty releases frames");
    ps_bad("releases bytes(p,1);lemma fn bad(p){return 0;}","proof functions cannot declare nonempty releases frames");
    ps_bad("releases nothing;", "function contract has no following function");
    ps_bad("releases nothing;global g=0;fn main(){return 0;}","function contract must attach to the next function");
    ps_verify("releases nothing;releases nothing;spec fn identity(x){return x;}",0,"Verified roots: 1/1");
    t_native("releases bytes(p,1);fn boundary(p){return 42;}fn main(){return boundary(0);}",42,"");
    h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let annotated=h_sha(t_binary);t_program("fn boundary(p){return 42;}fn main(){return boundary(0);}");t_compile();t_assert(h_equal(annotated,h_sha(t_binary)),"release annotations changed executable bytes");
    t_native("fn releases(x){return x+1;}fn main(){let releases=2;return releases(releases);}",3,"");
    t_program(h_cat(drop,"requires writable_bytes(p,1);fn caller(p){return drop(p);}"));
    let strict=h_run(h_args(t_compiler,"verify",t_fixture,"--no-trusted",0,0));h_check(strict,1,0);t_checks=t_checks+1;
    t_assert(h_has(h_out(strict),"--no-trusted") && h_has(h_out(strict),"releases byte memory"),"release assumptions bypassed strict policy");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
