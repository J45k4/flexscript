// Durable worker APIs and VM checkpoints, each call in a fresh ARM64 process.
import "lib/collie-test.flex";
fn wk_run(source,key,resume,owner,policy){let r=j_object();let c=c_json(j_dump(ct_config));j_set(c,"agent_id",j_int(owner));if policy{j_set(c,"permissions",policy);}j_set(r,"config",c);j_set(r,"source",j_string(source));j_set(r,"call_id",j_string(key));j_set(r,"history",j_array());j_set(r,"resume",j_int(resume));return ct_call(3,r);}
fn wk_good(source,key,owner,policy){return ct_continued(wk_run(source,key,0,owner,policy));}
fn wk_data(action,id,extra){let r=ct_request(action,0);j_set(r,"id",j_int(id));if extra{let pairs=j_value(extra);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);j_set(r,load64(pair),load64(pair+8));i=i+1;}}let result=ct_call(7,r);h_assert(!cj_get(result,"error"),j_dump(result));return result;}
fn wk_rows(){return cj_get(wk_data("list",0,0),"workers");}
fn wk_status(id,status){let rows=wk_rows();let row=j_at(j_at(rows,id-1),1);h_assert(h_equal(j_value(j_at(row,2)),status),j_dump(rows));return row;}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"agent_id",j_int(0));
    wk_good("fn main(){let ids=db_list();let a=worker_start(\"Reader\",\"Read the project\");let b=worker_start(\"Tester\",\"Run the tests\");if a!=1 || b!=2{return 1;}db_add(ids,db_int(a));db_add(ids,db_int(b));if !state_set(\"workers\",ids){return 2;}return 0;}","create",0,0);
    h_assert(j_count(wk_rows())==2,"Expected two durable workers");wk_status(1,"queued");wk_good("fn main(){let ids=state_get(\"workers\");if db_count(ids)!=2 || db_word(db_at(ids,1))!=2{return 1;}if db_count(worker_list())!=2{return 2;}return 0;}","read",0,0);ct_pass("workers are durable IDs in persistent typed lists across processes");
    wk_good("fn main(){if worker_start(\"Reader\",\"Read the project\")!=1{return 1;}if worker_start(\"Tester\",\"Run the tests\")!=2{return 2;}return 0;}","create",0,0);h_assert(j_count(wk_rows())==2,"Replayed tool created duplicate workers");ct_pass("stable tool call keys deduplicate worker creation");
    wk_good("fn main(){let m=worker_messages(1,0,10);if db_count(m)!=1{return 1;}let t=db_cell(db_at(m,0),2);db_io(0,1,db_word(t),db_bytes(t));return 0;}","messages",0,0);wk_good("fn main(){let m=db_scan(\"collie_messages\",0,10);return db_count(m)-2;}","db-read",0,0);ct_pass("worker messages are queryable using functions and ordinary FlexDB scans");
    let source="fn nested(id){let x=alloc(16);store64(x,123456);let before=worker_get(id);db_io(0,1,\"before\\n\",7);let result=worker_await(id);if load64(x)!=123456 || db_rowid(before)!=id || db_kind(worker_result(result))!=2{return 11;}db_io(0,1,\"after\\n\",6);return load64(x)-123456;}fn main(){let ids=state_get(\"workers\");return nested(db_word(db_at(ids,0)));}";
    let r=wk_run(source,"waiting",0,0,0);let snapshot=h_join(ct_root,"vm-0.checkpoint");h_assert(h_equal(cj_text(r,"state"),"waiting")&&cj_int(r,"waiting_for")==1&&h_equal(cj_text(r,"stdout"),"before\n")&&h_exists(snapshot),j_dump(r));h_assert(cj_int(wk_data("claim",1,0),"changed"),"Worker claim failed");wk_data("append",1,c_json("{\"role\":\"assistant\",\"text\":\"Read complete\",\"kind\":\"message\",\"key\":\"reader-answer\"}"));wk_data("finish",1,c_json("{\"status\":\"done\",\"revision\":1,\"result\":\"Read complete\",\"error\":\"\"}"));r=ct_continued(wk_run(source,"waiting",1,0,0));h_assert(h_equal(cj_text(r,"stdout"),"after\n")&&!h_exists(snapshot),j_dump(r));ct_pass("worker_await resumes nested frames, heap pointers and locals in a new ARM64 process without replaying output");
    wk_good("fn main(){if db_kind(state_get(\"workers\"))!=0{return 1;}return state_set(\"own\",db_text(\"worker private\"))-1;}","worker-state",1,0);wk_good("fn main(){return db_kind(state_get(\"own\"));}","owner-state",0,0);ct_pass("named persistent VM values are isolated by agent");
    r=wk_run("fn main(){worker_start(\"nested\",\"not allowed\");let e=db_error();db_io(0,1,e,db_len(e));return 0;}","nested",0,1,0);h_assert(h_has(cj_text(r,"stdout"),"Only the main")&&j_count(wk_rows())==2,j_dump(r));wk_good("fn main(){if !worker_send(1,\"Follow up\"){return 1;}return 0;}","send",0,0);wk_good("fn main(){return worker_send(1,\"Follow up\")-1;}","send",0,0);let row=wk_status(1,"queued");h_assert(j_value(j_at(row,5))==2&&j_count(cj_get(wk_data("messages",1,c_json("{\"after\":0}")),"messages"))==3,j_dump(row));ct_pass("only coordinator can create workers; follow-ups queue once with a new revision");
    h_assert(cj_int(wk_data("claim",1,0),"changed"),"Worker claim failed");wk_good("fn main(){return worker_send(1,\"Another follow up\")-1;}","send-next",0,0);wk_data("finish",1,c_json("{\"status\":\"done\",\"revision\":2,\"result\":\"old answer\",\"error\":\"\"}"));wk_status(1,"queued");ct_pass("follow-ups accepted during execution are not lost on worker completion");
    h_assert(cj_int(wk_data("claim",1,0),"changed"),"Worker claim failed");wk_data("pause",1,0);wk_status(1,"paused");h_assert(cj_int(wk_data("resume",1,0),"changed")&&cj_int(wk_data("claim",1,0),"changed"),"Pause/resume claim failed");wk_good("fn main(){return worker_cancel(1)-1;}","cancel",0,0);wk_data("finish",1,c_json("{\"status\":\"done\",\"revision\":3,\"result\":\"late answer\",\"error\":\"\"}"));wk_status(1,"cancelled");ct_pass("pause/resume works and late completions cannot overwrite cancellation");
    source="fn main(){let value=77;worker_await(2);return value-77;}";r=wk_run(source,"binding",0,0,0);h_assert(h_equal(cj_text(r,"state"),"waiting"),j_dump(r));r=wk_run(source,"wrong",1,0,0);h_assert(h_equal(cj_text(r,"state"),"error")&&h_has(cj_text(r,"stderr"),"another tool invocation"),j_dump(r));r=wk_run(source,"binding",0,0,0);h_assert(h_equal(cj_text(r,"state"),"waiting"),j_dump(r));r=wk_run(h_replace(source,"77","78"),"binding",1,0,0);h_assert(h_equal(cj_text(r,"state"),"error")&&h_has(cj_text(r,"stderr"),"code changed"),j_dump(r));ct_pass("checkpoints reject mismatched invocation IDs and changed bytecode");
    r=wk_run(source,"corrupt",0,0,0);h_assert(h_equal(cj_text(r,"state"),"waiting"),j_dump(r));let payload=h_read(snapshot);let bytes=h_file_size;h_assert(bytes>=32,"Short checkpoint fixture");store64(payload+24,-1);h_save_bytes(snapshot,payload,bytes,384);r=wk_run(source,"corrupt",1,0,0);h_assert(h_equal(cj_text(r,"state"),"error")&&h_has(cj_text(r,"stderr"),"bounds"),j_dump(r));ct_pass("corrupt checkpoint bounds are rejected before restoring VM memory");
    source="fn main(){let i=0;while i<4{http_get(\"https://example.com/\");i=i+1;}worker_await(2);http_get(\"https://example.com/\");let e=db_error();db_io(0,1,e,db_len(e));return 0;}";r=wk_run(source,"quotas",0,0,0);h_assert(h_equal(cj_text(r,"state"),"waiting"),j_dump(r));wk_data("cancel",2,0);r=ct_continued(wk_run(source,"quotas",1,0,0));h_assert(h_has(cj_text(r,"stdout"),"limit (4 per program)"),j_dump(r));ct_pass("network capability budgets survive a VM checkpoint and process restart");
    wk_good("fn main(){return worker_send(2,\"Try again\")-1;}","view-quota-queue",0,0);source="fn main(){fs_write(\"checkpoint-view.txt\",db_text(\"view\"));let i=0;while i<4{view_file(\"checkpoint-view.txt\");i=i+1;}worker_await(2);view_file(\"checkpoint-view.txt\");let e=db_error();db_io(0,1,e,db_len(e));return 0;}";r=wk_run(source,"view-quota",0,0,0);h_assert(h_equal(cj_text(r,"state"),"waiting")&&j_count(cj_get(r,"views"))==4,j_dump(r));wk_data("cancel",2,0);r=ct_continued(wk_run(source,"view-quota",1,0,0));let views=cj_get(r,"views");h_assert(h_has(cj_text(r,"stdout"),"four")&&(!views||j_count(views)==0),j_dump(r));ct_pass("file/image view budget survives suspension without allowing additional views");
    let cases=c_json("[[\"workers\",\"worker_start(\\\"No\\\",\\\"No\\\")\"],[\"db_write\",\"state_set(\\\"denied\\\",db_int(1))\"],[\"db_read\",\"state_get(\\\"workers\\\")\"],[\"history\",\"worker_messages(1,0,10)\"]]");let i=0;while i<j_count(cases){let c=j_at(cases,i);let key=j_value(j_at(c,0));let policy=ct_grants(j_bool(1));j_set(policy,key,j_bool(0));r=wk_run(h_cat3("fn main(){",j_value(j_at(c,1)),";let e=db_error();db_io(0,1,e,db_len(e));return 0;}"),h_cat("denied-",key),0,0,policy);h_assert(h_equal(cj_text(r,"stdout"),h_cat("Permission denied: ",key)),j_dump(r));i=i+1;}ct_pass("worker, state and message-history grants are independently enforced");
    cases=c_json("[[\"collie_messages\",\"history\"],[\"collie_messages\",\"workers\"],[\"collie_workers\",\"workers\"]]");i=0;while i<j_count(cases){let c=j_at(cases,i);let table=j_value(j_at(c,0));let permission=j_value(j_at(c,1));let p=ct_grants(j_bool(1));j_set(p,permission,j_bool(0));r=wk_good(h_cat3("fn main(){db_scan(\"",table,"\",0,10);let e=db_error();db_io(0,1,e,db_len(e));return 0;}"),h_cat3("raw-",table,permission),0,p);h_assert(h_equal(cj_text(r,"stdout"),h_cat("Permission denied: ",permission)),j_dump(r));i=i+1;}r=wk_good("fn main(){db_scan(\"collie_state\",0,10);let e=db_error();db_io(0,1,e,db_len(e));return 0;}","state-raw",1,0);h_assert(h_has(cj_text(r,"stdout"),"state_get/state_set"),j_dump(r));ct_pass("raw table reads cannot bypass message grants or private named-state ownership");
    i=2;while i<8{let task=j_dump(j_string(h_cat("task ",h_repeat("x",16000))));wk_good(h_cat3(h_cat3("fn main(){if !worker_start(\"Large ",h_int(i),"\","),task,"){return 1;}return 0;}"),h_cat("large-",h_int(i)),0,0);i=i+1;}wk_good("fn main(){return db_count(worker_list())-8;}","bounded-list",0,0);ct_pass("worker summary listing remains bounded with large task bodies");
    let codes=h_args("db_delete(\"collie_workers\",1)","db_update(\"collie_workers\",1,db_values())","db_drop_column(\"collie_messages\",\"role\")",0,0,0);i=0;while i<h_count(codes){let code=h_at(codes,i);r=wk_good(h_cat3("fn main(){db_begin();",code,";let e=db_error();db_io(0,1,e,db_len(e));db_rollback();return 0;}"),h_cat("reserved-",code),0,0);h_assert(h_has(cj_text(r,"stdout"),"read-only"),j_dump(r));i=i+1;}ct_pass("general database mutation cannot forge worker state or runtime messages");r=wk_good("fn main(){db_begin();worker_start(\"No\",\"inside transaction\");let e=db_error();db_io(0,1,e,db_len(e));db_rollback();return 0;}","transaction",0,0);h_assert(h_has(cj_text(r,"stdout"),"transaction"),j_dump(r));ct_pass("worker creation cannot commit an unrelated user transaction");
    return ct_done(j_object(),"worker-native-report.json");
}
