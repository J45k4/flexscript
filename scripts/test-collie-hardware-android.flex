import "../lib/f64.flex";
global ha_source=0;
fn ha_program(call){return h_cat3(ha_source,"\nfn main(){return hardware_live_",h_cat(call,"();}"));}
fn ha_float_close(bits,wanted){return f64_lt((f64_sub(bits,wanted)&9223372036854775807),4576918229304087675);}
fn main(argc,argv){
    at_preserve=0;at_cleanup_hook=1;if at_init(argc,argv,"hardware",j_object())<0{return at_self_test();}if at_cleanup{return ar_restore();}if !at_child{at_extra=ar_snapshot(0,0);return at_parent(argc,argv);}ha_source=h_read("apps/collie/tests/hardware-live.flex");
    let report=at_sdk(h_cat(ut_prefix,"-io"),c_json("{\"initial_permissions\":{\"internet\":true,\"files_read\":true,\"files_write\":true,\"db_read\":true,\"db_write\":true,\"history\":true,\"workers\":true,\"network\":true,\"device_status\":true,\"sensors\":true,\"infrared\":true,\"haptics\":true,\"usb\":true,\"keystore\":true,\"audio\":true,\"midi\":true}}"));
    let sid=h_cat(ut_prefix,"-ask");let name=at_conversation(sid,ha_program("network"),0);let state=at_pending(sid,"network","permission",name);h_assert(h_equal(cj_text(cj_get(state,"permissions"),"network"),"ask"),"Network policy did not start at Ask");h_assert(h_has(at_xml(),"Network connections"),"Actual network permission view missing");let image=ut_ok(ut_args("exec-out","screencap","-p",0,0,0),"");h_save_bytes(h_join(ut_out,"hardware-network-permission.png"),h_out(image),h_size(load64(image+16)),384);at_click("text","Allow requested access",0);at_observation(at_result(name));at_pass("network access asks lazily and resumes the original Flexscript program after approval");
    sid=h_cat(ut_prefix,"-deny");name=at_conversation(sid,ha_program("network"),0);at_pending(sid,"network","permission",name);at_click("text","Deny requested access",0);at_result(name);state=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));h_assert(!at_bool(cj_get(cj_get(state,"permissions"),"network")),"Network denial was not saved");at_pass("network denial is remembered without invoking an operating-system network operation");
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ar_revoke("android.permission.RECORD_AUDIO");sid=h_cat(ut_prefix,"-microphone");name=at_conversation(sid,ha_program("audio"),c_json("{\"microphone\":true}"));at_pending(sid,"microphone","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));at_pass("microphone access yields for the actual Android runtime dialog, then captures emulator PCM");at_sdk(sid,c_json("{\"hardware_microphone_tests\":true}"));
    ar_revoke("android.permission.ACCESS_FINE_LOCATION");ar_revoke("android.permission.ACCESS_COARSE_LOCATION");ar_set_location("true");sid=h_cat(ut_prefix,"-location");name=at_conversation(sid,ha_program("gps"),c_json("{\"location\":true}"));at_pending(sid,"location","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);let until=net_now()+25000;let result=0;while net_now()<until&&!result{ut_ok(ut_args("emu","geo","fix","22.18","60.45",0),"");result=ut_read(h_cat3("files/test/",name,".result.json"));if !result{h_sleep(300);}}h_assert(result,"Injected GPS fix did not complete the existing request");let observation=at_observation(at_result(name));let text=cj_text(observation,"stdout");let space=h_find(text," ");h_assert(space>0,"Expected two exact typed GPS measurements");h_assert(ha_float_close(h_number(h_slice(text,space)),4633704398480578970)&&ha_float_close(h_number(text+space+1),4626936332665571246),"Actual GPS callback coordinates differ from emulator injection");at_pass("the VM yields for the real Android location prompt, then receives an injected GPS callback as exact typed measurements");return at_finish(j_object());
}
