import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    let p=ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result>=0 && result<=1;fn choice(){return syscall(39,0,0,0,0,0,0);}ensures result==0 || result==1;fn caller(){return choice();}",0,"CONDITIONAL: supported arithmetic and memory safety");
    t_assert(h_has(h_out(p),"trusted external assumptions: choice"),"trusted assumption omitted");
    t_assert(h_has(h_out(p),"Conditionally verified roots: 1"),"conditional root count omitted");
    t_assert(!h_has(h_out(p),"VERIFY choice\n") && !h_has(h_out(p),"\nPROVED:"),"trusted implementation reported checked");
    ps_verify("trusted;reads nothing;modifies nothing;ensures result==1;fn external(){return 1;}ensures result==1;fn caller(){return external();}",1,"CONDITIONAL: partial correctness");
    ps_verify("trusted;reads nothing;modifies nothing;ensures result==1;fn external(){return 1;}ensures result==1;fn caller(){return external();}",1,"normal return and termination are unproved");
    p=ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn external(){return 1;}ensures result==0;fn caller(){return external();}",0,"Verified roots: 1/1; trusted external assumptions: external");
    t_assert(!h_has(h_out(p),"COUNTEREXAMPLE:"),"unchecked body was treated as proof evidence");
    p=ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn external(){syscall(1,1,\"DO_NOT_EXECUTE\",14,0,0,0);return 0;}ensures result==0;fn caller(){return external();}",0,"CONDITIONAL:");
    t_assert(!h_has(h_out(p),"DO_NOT_EXECUTE"),"verification executed trusted body");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;fn arbitrary(){return 7;}verify;fn caller(){return arbitrary();}",0,"Verified roots: 1/1");
    p=ps_verify("trusted;terminates;reads nothing;modifies nothing;fn arbitrary(){return 7;}ensures result==7;fn caller(){return arbitrary();}",1,"abstract call countermodel");
    t_assert(!h_has(h_out(p),"COUNTEREXAMPLE:"),"external nondeterminism reported as a reproduced bug");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;requires x>0;ensures result==old(x);fn keep(x){return x;}requires x==0;fn caller(x){return keep(x);}",1,"COUNTEREXAMPLE: callee requirement");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;requires x==0;ensures result==x;fn mutate(x){x=1;return x;}requires x==0;ensures result==0;fn caller(x){return mutate(x);}",1,"abstract call countermodel");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==old(x);fn keep(x){x=1;return x;}ensures result==x;fn caller(x){return keep(x);}",0,"CONDITIONAL:");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures x==old(x)+1;ensures result==x;fn mutate(x){x=x+1;return x;}requires x==0;ensures result==1 && x==0;fn caller(x){return mutate(x);}",0,"CONDITIONAL:");
    ps_verify("global g=0;trusted;terminates;reads g;modifies g;ensures g==old(g)+1;ensures result==g;fn bump(){g=g+1;return g;}requires g==0;ensures result==2 && g==2;fn caller(){bump();return bump();}",0,"Verified roots: 1/1");
    ps_verify("global g=0;trusted;terminates;reads nothing;modifies g;fn change(){return 0;}requires g==0;ensures g==0;fn caller(){change();return 0;}",1,"abstract call countermodel");
    ps_verify("global g=0;trusted;terminates;reads nothing;modifies g;fn change(){return 0;}requires g==0;ensures result==0;fn caller(){let saved=g;change();return saved;}",0,"CONDITIONAL:");
    ps_verify("global g=0;global h=0;trusted;terminates;reads nothing;modifies g;fn change(){return 0;}requires h==3;ensures h==3;fn caller(){return change();}",0,"CONDITIONAL:");
    ps_verify("global g=0;trusted;terminates;reads nothing;modifies g;fn change(){return 0;}modifies nothing;fn caller(){return change();}",1,"UNPROVED: write frame in caller");
    ps_verify("global g=0;trusted;terminates;reads g;modifies nothing;ensures result==g;fn read(){return g;}reads nothing;fn caller(){return read();}",1,"UNPROVED: read frame in caller");
    ps_verify("global g=0;trusted;terminates;reads nothing;modifies nothing;ensures g==g;fn bad(){return 0;}verify;fn caller(){return bad();}",1,"UNPROVED: read frame in bad");
    ps_verify("global g=0;trusted;terminates;reads nothing;modifies nothing;requires g==0;fn bad(){return 0;}requires g==0;fn caller(){return bad();}",1,"COUNTEREXAMPLE: read frame in bad");
    ps_verify("global g=0;spec fn value(){return g;}trusted;terminates;reads nothing;modifies nothing;ensures result==value();fn bad(){return g;}verify;fn caller(){return bad();}",1,"UNPROVED: read frame in bad");
    ps_verify("global g=0;spec fn value(){return g;}trusted;terminates;reads g;modifies nothing;ensures result==value();fn read(){return g;}requires g==7;ensures result==7;fn caller(){return read();}",0,"Conditionally verified roots: 1");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures 0;fn impossible(){return 0;}ensures 0;fn caller(){return impossible();}",1,"trusted normal-return contract admits no return state");
    ps_verify("trusted;reads nothing;modifies nothing;ensures 0;fn never(){while 1{}}ensures 0;fn caller(){return never();}",1,"CONDITIONAL: partial correctness");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result>0 && result<0;fn impossible(){return 0;}verify;fn caller(){return impossible();}",1,"trusted normal-return contract admits no return state");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn choice(){return 0;}ensures result==0;fn middle(){return choice();}ensures result==0;fn outer(){return middle();}ensures result==1;fn independent(){return 1;}",0,"Conditionally verified roots: 2");
    p=ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn boundary(){return unsafe();}fn unsafe(){return load64(0);}ensures result==0;fn caller(){return boundary();}",0,"CONDITIONAL:");
    t_assert(!h_has(h_out(p),"unsafe"),"unchecked implementation leaked into the checked closure");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn boundary(){return caller();}ensures result==0;fn caller(){return boundary();}",0,"CONDITIONAL:");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn boundary(){assert 0;return 9;}ensures result==0;fn caller(){return boundary();}",0,"Verified roots: 1/1");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn unused(){return load64(0);}ensures result==1;fn independent(){return 1;}",0,"trusted external assumptions: none");
    ps_verify("trusted;reads nothing;modifies nothing;fn unused(){return load64(0);}",0,"NO VERIFICATION REQUESTED");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;fn unsafe(){return load64(0);}ensures result==0;fn skipped(){if 0{return unsafe();}return 0;}",0,"trusted external assumptions: none");
    ps_verify("global g=0;trusted;terminates;reads g;modifies g;ensures g==0;fn zero(){g=0;return 0;}requires g==0;fn loop(){let n=2;invariant n>=0 && n<=2;invariant g==0;decreases n;while n {zero();n=n-1;}return 0;}",0,"CONDITIONAL:");
    ps_bad("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn external(){return 0;}spec fn wrong(){return external();}","specification calls require a supported spec function");
    ps_bad("trusted;fn bad(){return 0;}","trusted functions require explicit reads and modifies frames");
    ps_bad("trusted;reads nothing;fn bad(){return 0;}","trusted functions require explicit reads and modifies frames");
    ps_bad("trusted;modifies nothing;fn bad(){return 0;}","trusted functions require explicit reads and modifies frames");
    ps_bad("trusted;verify;reads nothing;modifies nothing;fn bad(){return 0;}","trusted and verify cannot annotate the same function");
    ps_bad("verify;trusted;reads nothing;modifies nothing;fn bad(){return 0;}","trusted and verify cannot annotate the same function");
    ps_bad("trusted;reads nothing;modifies nothing;decreases 0;fn bad(){return 0;}","trusted functions cannot use decreases");
    ps_bad("terminates;fn bad(){return 0;}","terminates requires a trusted boundary");
    ps_bad("trusted;trusted;reads nothing;modifies nothing;fn bad(){return 0;}","duplicate trusted marker");
    ps_bad("trusted;terminates;terminates;reads nothing;modifies nothing;fn bad(){return 0;}","duplicate terminates marker");
    ps_bad("trusted;reads nothing;modifies nothing;spec fn bad(){return 0;}","spec functions and lemmas cannot be trusted");
    ps_bad("trusted;reads nothing;modifies nothing;lemma fn bad(){}","spec functions and lemmas cannot be trusted");
    ps_bad("trusted;","function contract has no following function");
    ps_bad("trusted;global g=0;fn bad(){return 0;}","function contract must attach to the next function");
    ps_bad("trusted;reads nothing;modifies nothing;fn bad(){return missing();}fn main(){return 0;}","undefined function");
    ps_verify("fn trusted(){return 1;}fn terminates(){return 2;}ensures result==3;fn caller(){return trusted()+terminates();}",0,"Verified roots: 1/1");
    t_native("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn value(){return 42;}fn main(){return value();}",42,"");
    h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let checksum=h_sha(t_binary);t_program("fn value(){return 42;}fn main(){return value();}");t_compile();t_assert(h_equal(checksum,h_sha(t_binary)),"trusted annotations changed executable bytes");
    h_save(h_join(t_work,"external.flex"),"trusted;terminates;reads nothing;modifies nothing;ensures result==1;fn external(){return 1;}");
    ps_verify("import \"external.flex\";ensures result==1;fn caller(){return external();}",0,"trusted external assumptions: external");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--no-trusted",0,0));h_check(p,1,0);t_assert(h_has(h_out(p),"POLICY REJECTED:"),"strict policy accepted trusted dependency");
    t_program("trusted;terminates;reads nothing;modifies nothing;ensures result==0;fn ext(){return 0;}ensures result==0;fn middle(){return ext();}ensures result==0;fn caller(){return middle();}");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=200m","--no-trusted",0));h_check(p,1,0);t_assert(h_has(h_out(p),"POLICY REJECTED:"),"strict policy missed transitive assumption");
    t_program("trusted;reads nothing;modifies nothing;fn unused(){return 0;}ensures result==0;fn independent(){return 0;}");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--no-trusted","--budget=200m",0));h_check(p,0,0);t_assert(h_has(h_out(p),"trusted external assumptions: none"),"unused declaration violated strict policy");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--no-trusted","--no-trusted",0));h_check(p,1,0);t_assert(h_has(h_err(p),"duplicate --no-trusted"),"duplicate policy accepted");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=200m","--budget=200m",0));h_check(p,1,0);t_assert(h_has(h_err(p),"duplicate --budget"),"duplicate budget accepted");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
