// Progress, nested-frame feedback, restart, workers and real Stop cancellation.
import "lib/android-ui-test.flex";
global sg_source=0;
fn sg_program(call){return h_cat3(sg_source,"\nfn main(){return signals_live_",h_cat(call,"();}"));}
fn sg_events(key,delay,answer){let events=j_array();j_push(events,at_tool_event(sg_program("source"),key,0));j_push(events,at_answer_event("42",delay));j_push(events,at_answer_event(answer,0));return events;}
fn sg_feedback(sid,name){return at_pending(sid,0,"feedback",name);}
fn sg_file(sid,file){return h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",h_cat3("files/workspaces/",sid,h_cat("/files/",file)),0),""));}
fn sg_exists(sid,file){return h_status(ut_call(ut_args("shell","run-as","org.flexscript.collie","test","-f",h_cat3("files/workspaces/",sid,h_cat("/files/",file))),""))==0;}
fn sg_one(r){let values=at_outputs(r);h_assert(j_count(values)==1,"Expected exactly one correlated final VM result");return j_at(values,0);}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"signals",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}sg_source=h_read("apps/collie/tests/signals-live.flex");let name=at_task(ut_prefix,"Do work and ask for feedback",sg_events("signals",8000,"The program continued with the feedback."),0);let state=sg_feedback(ut_prefix,name);let cards=cj_get(state,"cards");let i=0;let seen=0;while i<j_count(cards){let card=j_at(cards,i);if h_equal(cj_text(card,"kind"),"progress")&&h_has(cj_text(card,"text"),"Downloaded files"){seen=1;}i=i+1;}h_assert(seen&&j_count(at_outputs(state))==0&&h_equal(sg_file(ut_prefix,"before.txt"),"started")&&!sg_exists(ut_prefix,"answer.txt"),"Progress did not precede the final result and feedback write");au_shot(ut_out,"signals-progress");at_pass("visible progress is saved while the original Flexscript program is suspended and before any final tool result");let o=sg_one(at_result(name));h_assert(h_equal(cj_text(o,"stdout"),"42")&&cj_int(o,"exit_code")==0&&j_count(cj_get(o,"signals"))==3&&h_equal(sg_file(ut_prefix,"answer.txt"),"42"),j_dump(o));at_pass("the real Android harness requests feedback and resumes the original VM frame with one correlated final result");
    let sid=h_cat(ut_prefix,"-restart");name=at_task(sid,"Work across restart",sg_events("restart",20000,"Done"),0);sg_feedback(sid,name);ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");at_write(h_cat3("files/workspaces/",sid,"/files/before.txt"),"changed");let resumed=j_array();j_push(resumed,at_answer_event("unused",0));j_push(resumed,at_answer_event("42",0));j_push(resumed,at_answer_event("Resumed",0));let payload=c_json("{\"resume_pending\":true}");j_set(payload,"responses",resumed);o=sg_one(at_case(sid,payload));h_assert(cj_int(o,"exit_code")==0&&h_equal(sg_file(sid,"before.txt"),"changed")&&h_equal(sg_file(sid,"answer.txt"),"42"),"Restart replayed earlier effects or lost VM locals");at_pass("app restart restores the pending feedback request and VM locals without replaying previous file writes");
    sid=h_cat(ut_prefix,"-worker");let events=j_array();j_push(events,at_tool_event(sg_program("coordinator"),"coordinator",0));j_push(events,at_answer_event("Worker finished",0));let workers=j_object();let replies=j_array();j_push(replies,at_tool_event(sg_program("worker_source"),"worker",0));j_push(replies,at_answer_event("42",0));j_push(replies,at_answer_event("Reviewed 42",0));j_set(workers,"1",replies);let result=at_result(at_task(sid,"Delegate to a worker",events,workers));h_assert(h_equal(j_value(j_at(j_at(j_at(cj_get(result,"workers"),0),1),2)),"done"),"Feedback worker did not finish");let saved=ut_read(h_cat3("files/workspaces/",sid,"/worker-1.json"));o=sg_one(saved);h_assert(h_equal(cj_text(o,"stdout"),"42")&&j_count(cj_get(o,"signals"))==2,"Worker did not publish progress and resume feedback");at_pass("workers can publish progress and ask for feedback while the coordinator awaits their final answer");
    sid=h_cat(ut_prefix,"-cancel");name=at_task(sid,"Cancel during feedback",sg_events("cancel",20000,"must not run"),0);sg_feedback(sid,name);au_tap("Stop response");result=at_result(name);o=sg_one(result);h_assert(!sg_exists(sid,"answer.txt")&&h_has(cj_text(o,"stderr"),"Cancelled")&&!h_has(j_dump(cj_get(result,"messages")),"must not run"),"Stop resumed the VM or allowed the late reply");at_pass("the Android Stop control cancels feedback and produces one explicit result without continuing the program");return at_finish(j_object());
}
