// Read-only diagnosis of one examined stock Bluetooth module, not an OS patch.
// Unknown module hashes remain unknown; the strict SDK callback gate stays intact.
import "../apps/collie/lib/state.flex";
fn hp_run(args){return h_out(h_check(h_wait(h_spawn(args,"",0)),0,0));}
fn hp_line(text,at){while at>0 && load8(text+at-1)!=10{at=at-1;}let end=h_find(text+at,"\n");if end<0{end=h_len(text+at);}return h_slice(text+at,end);}
fn hp_symbol(table,name){let at=h_find(table,h_cat3(" ",name,"\n"));h_assert(at>=0,h_cat("Missing actual debug symbol: ",name));while at>0&&load8(table+at-1)!=10{at=at-1;}let start=h_slice(table+at,16);let end=h_find(table+at,"\n");h_assert(end>=0,"Truncated debug symbol table");at=at+end+1;while load8(table+at){let next=h_slice(table+at,16);if !h_equal(start,next){return h_args(start,next,0,0,0,0);}end=h_find(table+at,"\n");h_assert(end>=0,"Missing next symbol address");at=at+end+1;}h_die("Missing next symbol address");return 0;}
fn hp_trim(hex){while load8(hex)==48&&load8(hex+1){hex=hex+1;}return hex;}
fn hp_disassemble(lib,range){return hp_run(h_args(h_executable("llvm-objdump"),"-d",h_cat("--start-address=0x",h_at(range,0)),h_cat("--stop-address=0x",h_at(range,1)),lib,0));}
fn hp_call(text,address){let at=h_find(text,h_cat("callq\t0x",hp_trim(address)));if at<0{at=h_find(text,h_cat("call\t0x",hp_trim(address)));}return at;}
fn hp_hex(c){return (c>=48&&c<=57)||(c>=97&&c<=102)||(c>=65&&c<=70);}
fn main(argc,argv){
    h_environment(argc,argv);let lib=0;let symbols=0;let report=0;let platform=0;let out=0;let i=1;
    while i<argc{let arg=load64(argv+i*8);i=i+1;h_assert(i<argc,"Missing diagnostic argument value");let value=load64(argv+i*8);if h_equal(arg,"--lib"){lib=value;}else if h_equal(arg,"--symbols"){symbols=value;}else if h_equal(arg,"--hid-report"){report=value;}else if h_equal(arg,"--platform"){platform=value;}else if h_equal(arg,"--out"){out=value;}else{h_die(h_cat("Unknown diagnostic argument: ",arg));}i=i+1;}
    h_assert(lib&&symbols&&report&&platform&&out,"Provide --lib, --symbols, --hid-report, --platform and --out");
    let hash=h_slice(hp_run(h_args(h_executable("sha256sum"),lib,0,0,0,0)),64);let result=j_object();j_set(result,"library_sha256",j_string(hash));j_set(result,"scope",j_string("exact examined stock x86_64 Bluetooth library only"));j_set(result,"os_modified",j_bool(0));j_set(result,"callback_fabricated",j_bool(0));j_set(result,"physical_radio_verified",j_bool(0));
    let known=h_equal(hash,"a0aaf7e51cfcce7dddf83b708086af6fffb8a97fd6b905e8ed27543d955de275");j_set(result,"recognized_library",j_bool(known));
    if !known{j_set(result,"status",j_string("unrecognized_module"));j_set(result,"ordering_defect_verified",j_bool(0));j_save(out,result);h_print(1,"UNKNOWN Bluetooth module; no platform diagnosis or callback success inferred\n");return 0;}
    let symbol_hash=h_slice(hp_run(h_args(h_executable("sha256sum"),symbols,0,0,0,0)),64);h_assert(h_equal(symbol_hash,"fa34395d331a34a1ea1e54f59e0bede174c1f2b8a5c73b5cf4827c907eeb1f98"),"Debug symbols do not match the examined library's extracted mini-debug ELF");j_set(result,"symbols_sha256",j_string(symbol_hash));
    let provenance=c_json(h_read(platform));h_assert(provenance&&h_equal(cj_text(provenance,"lib_sha256"),hash),"Platform provenance does not match actual library bytes");let hid=c_json(h_read(report));h_assert(hid&&j_kind(cj_get(hid,"unplug_callback_observed"))==5&&j_kind(cj_get(hid,"ok"))==5,"Missing strict HID observations");
    let table=hp_run(h_args(h_executable("llvm-nm"),"--defined-only","--numeric-sort","--demangle",symbols,0));let receive=hp_symbol(table,"hidd_l2cif_data_ind(unsigned short, BT_HDR*)");let disconnect=hp_symbol(table,"hidd_conn_disconnect()");let helper=hp_symbol(table,"hidd_l2cif_disconnect(unsigned short)");
    let recv=hp_disassemble(lib,receive);let disc=hp_disassemble(lib,disconnect);let close=hp_disassemble(lib,helper);let at=hp_call(recv,h_at(disconnect,0));h_assert(at>=0,"Actual receive path does not directly call the examined disconnect function");let newline=h_find(recv+at,"\n");h_assert(newline>=0,"Truncated receive instruction");let store=hp_line(recv,at+newline+1);h_assert(h_has(store,"movb")&&h_has(store,"$0x1,"),"Receive path no longer stores the flag immediately after disconnect");let flag=h_find(store,"# 0x");h_assert(flag>=0,"Missing actual flag reference");flag=flag+4;let n=0;while hp_hex(load8(store+flag+n)){n=n+1;}h_assert(n>0,"Invalid flag reference");let address=h_slice(store+flag,n);
    let needle=h_cat("# 0x",address);at=0;let compared=0;let searching=1;while searching&&load8(close+at){let next=h_find(close+at,needle);if next<0{searching=0;}else{at=at+next;let line=hp_line(close,at);if h_has(line,"cmpb")&&h_has(line,"$0x1,"){compared=1;}at=at+h_len(needle);}}
    h_assert(compared&&hp_call(disc,h_at(helper,0))>=0,"Actual synchronous teardown path does not check the same flag");let observed=cj_int(hid,"unplug_callback_observed");let strict=cj_int(hid,"ok");j_set(result,"ordering_defect_verified",j_bool(1));j_set(result,"receive_stores_flag_after_disconnect",j_bool(1));j_set(result,"synchronous_helper_checks_same_flag",j_bool(1));j_set(result,"public_callback_observed",j_bool(observed));j_set(result,"strict_hid_gate_passed",j_bool(strict));j_set(result,"hid_apk_sha256",j_string(cj_text(hid,"apk_sha256")));j_set(result,"strict_hid_checks",j_int(cj_int(hid,"count")));j_set(result,"platform",provenance);j_set(result,"status",j_string("ordering_defect_verified"));j_save(out,result);
    h_print(1,"PASS installed-library flag ordering and synchronous teardown verified; strict HID gate remains ");if strict{h_print(1,"passed\n");}else{h_print(1,"FAILED; no callback substituted\n");}return 0;
}
