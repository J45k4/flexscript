// Shared conversation/scheduler/provider tests against real native entry points.
// The engine runs in fresh ARM64 QEMU processes; optional core calls run natively.
import "lib/collie-test.flex";
fn sc_completed(output){let event=c_json("{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"usage\":{\"input_tokens\":100,\"output_tokens\":20,\"total_tokens\":120}}}");j_set(cj_get(event,"response"),"output",output);return event;}
fn sc_tool(source,id){let t=j_object();j_set(t,"type",j_string("custom_tool_call"));j_set(t,"id",j_string(h_cat("ctc_",id)));j_set(t,"call_id",j_string(h_cat("call_",id)));j_set(t,"name",j_string("flexscript"));j_set(t,"input",j_string(source));j_set(t,"status",j_string("completed"));return t;}
fn sc_request(action,state,id){let r=j_object();let config=c_json(j_dump(ct_config));j_set(config,"agent_id",j_int(id));j_set(r,"config",config);j_set(r,"action",j_string(action));if !state{state=j_object();}j_set(r,"state",state);j_set(r,"fixture",j_bool(1));return r;}
fn sc_parse(output){let r=j_object();j_set(r,"event",sc_completed(output));r=ct_call(2,r);h_assert(!cj_get(r,"error"),j_dump(r));return r;}
fn sc_reply(state,reply,id){let r=sc_request("reply",state,id);j_set(r,"reply",reply);return ct_step(r);}
fn sc_observe(t){let req=cj_get(cj_get(t,"command"),"request");j_set(req,"config",ct_config);j_set(req,"history",cj_get(cj_get(t,"state"),"archive"));return ct_call(3,req);}
fn sc_command(t,kind){h_assert(h_equal(cj_text(cj_get(t,"command"),"kind"),kind),j_dump(t));return 0;}
fn sc_observation(t,o){let r=sc_request("observation",cj_get(t,"state"),0);j_set(r,"observation",o);return ct_step(r);}
fn sc_plan(active,recover,allowed){let r=j_object();j_set(r,"config",ct_config);j_set(r,"action",j_string("plan"));j_set(r,"active",active);j_set(r,"recover",j_bool(recover));j_set(r,"allowed",j_bool(allowed));j_set(r,"authenticated",j_bool(1));return ct_call(9,r);}
fn sc_workers(action,id){let r=j_object();j_set(r,"config",ct_config);j_set(r,"action",j_string(action));j_set(r,"id",j_int(id));j_set(r,"after",j_int(0));return ct_call(7,r);}
fn sc_row_text(rows,text){let i=0;while i<j_count(rows){let values=j_at(j_at(rows,i),1);let value=j_at(values,2);if j_kind(value)==2&&h_equal(j_value(value),text){return 1;}i=i+1;}return 0;}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));
    let req=sc_request("begin",0,0);j_set(req,"text",j_string("Delegate and wait"));j_set(req,"attachments",j_array());let t=ct_step(req);sc_command(t,"model");h_assert(h_equal(cj_text(j_at(cj_get(cj_get(t,"state"),"messages"),0),"content"),"Delegate and wait"),"User message was not appended");
    let source="fn main(){let id=worker_start(\"Counter\",\"Calculate 6 times 7\");let local=alloc(8);store64(local,77);let result=worker_await(id);let text=worker_result(result);db_io(0,1,db_word(text),db_bytes(text));return load64(local)-77;}";
    t=sc_reply(cj_get(t,"state"),sc_parse(ct_one(sc_tool(source,"main"))),0);sc_command(t,"vm");h_assert(j_count(cj_get(cj_get(t,"state"),"messages"))==1&&cj_get(cj_get(t,"state"),"pending_execution"),j_dump(t));ct_pass("shared core appends user/source cards and checkpoints pending calls without dangling history");
    let o=sc_observe(t);h_assert(h_equal(cj_text(o,"state"),"waiting"),j_dump(o));t=sc_observation(t,o);sc_command(t,"wait");h_assert(cj_get(cj_get(cj_get(t,"state"),"pending_execution"),"resume"),j_dump(t));let plan=sc_plan(j_array(),1,1);h_assert(j_count(cj_get(plan,"start"))==1&&cj_int(j_at(cj_get(plan,"start"),0),"id")==1,j_dump(plan));
    req=sc_request("open_worker",0,1);j_set(req,"revision",j_int(1));let worker=ct_step(req);sc_command(worker,"model");h_assert(h_has(cj_text(j_at(cj_get(cj_get(worker,"state"),"messages"),0),"content"),"Calculate"),j_dump(worker));worker=sc_reply(cj_get(worker,"state"),sc_parse(ct_one(ct_message("42"))),1);sc_command(worker,"done");h_assert(h_exists(h_join(ct_root,"worker-1.json"))&&h_equal(cj_text(c_json(h_read(h_join(ct_root,"worker-1.json"))),"phase"),"done"),"Worker journal did not persist completion");
    t=ct_step(sc_request("next",cj_get(t,"state"),0));sc_command(t,"vm");h_assert(cj_int(cj_get(cj_get(t,"command"),"request"),"resume")==1,j_dump(t));o=sc_observe(t);h_assert(h_equal(cj_text(o,"stdout"),"42")&&cj_int(o,"exit_code")==0,j_dump(o));t=sc_observation(t,o);sc_command(t,"model");let messages=cj_get(cj_get(t,"state"),"messages");h_assert(j_count(messages)==3&&h_equal(cj_text(j_at(messages,2),"type"),"custom_tool_call_output"),j_dump(t));t=sc_reply(cj_get(t,"state"),sc_parse(ct_one(ct_message("The worker got 42"))),0);sc_command(t,"done");h_assert(j_kind(cj_get(cj_get(t,"state"),"pending_execution"))==0,j_dump(t));ct_pass("scheduler, worker context, journal, await/resume and tool correlation work with no Android UI or Java loop");
    h_assert(sc_row_text(cj_get(sc_workers("messages",1),"messages"),"42"),"Worker reply did not persist");ct_pass("worker replies and context persistence are written directly by shared Flexscript");
    req=sc_request("reply",cj_get(t,"state"),0);j_set(req,"reply",sc_parse(ct_one(sc_tool(source,"main"))));let r=ct_call(8,req);h_assert(h_has(cj_text(r,"error"),"Repeated tool call"),j_dump(r));req=sc_request("begin",0,0);j_set(req,"text",j_string("Interrupted"));j_set(req,"attachments",j_array());let pending=ct_step(req);pending=sc_reply(cj_get(pending,"state"),sc_parse(ct_one(sc_tool("fn main(){return fs_write(\"once.txt\",db_text(\"once\"))-1;}","uncertain"))),0);let restored=ct_step(sc_request("resume",cj_get(pending,"state"),0));sc_command(restored,"model");messages=cj_get(cj_get(restored,"state"),"messages");h_assert(h_has(cj_text(j_at(messages,j_count(messages)-1),"output"),"no safe checkpoint")&&!h_exists(h_join(ct_root,"files/once.txt")),j_dump(restored));ct_pass("repeated tool IDs and unsafe restarts are rejected by shared core without executing code");
    let stream=j_object();let events=j_array();j_push(events,c_json("{\"type\":\"response.output_text.delta\",\"delta\":\"Calculating\"}"));let e=j_object();j_set(e,"type",j_string("response.output_item.added"));j_set(e,"item",sc_tool("","stream"));j_push(events,e);j_push(events,c_json("{\"type\":\"response.custom_tool_call_input.delta\",\"item_id\":\"ctc_stream\",\"delta\":\"fn main(){return 0;}\"}"));let i=0;while i<j_count(events){req=sc_request("stream",0,0);j_set(req,"stream",stream);j_set(req,"event_json",j_string(j_dump(j_at(events,i))));r=ct_step(req);stream=cj_get(r,"stream");i=i+1;}
    let output=ct_one(ct_message("Calculating"));j_push(output,sc_tool("fn main(){return 0;}","stream"));req=sc_request("stream",0,0);j_set(req,"stream",stream);j_set(req,"event_json",j_string(j_dump(sc_completed(output))));r=ct_step(req);h_assert(cj_int(r,"complete")&&h_equal(cj_text(cj_get(cj_get(r,"reply"),"tool_call"),"input"),"fn main(){return 0;}"),j_dump(r));j_set(req,"event_json",j_string(j_dump(sc_completed(ct_one(sc_tool("fn main(){return 1;}","stream"))))));r=ct_call(8,req);h_assert(cj_get(r,"error"),j_dump(r));ct_pass("provider streaming assembles and verifies actual text/tool deltas independently of Java");
    let auth=c_json("{\"auth_mode\":\"chatgpt\",\"tokens\":{\"access_token\":\"synthetic-access\",\"account_id\":\"synthetic-account\"}}");req=sc_request("authenticate",0,0);j_set(req,"auth",auth);r=ct_step(req);let headers=cj_get(r,"headers");h_assert(h_equal(cj_text(headers,"Authorization"),"Bearer synthetic-access")&&h_equal(cj_text(headers,"ChatGPT-Account-ID"),"synthetic-account")&&h_equal(cj_text(r,"url"),"https://chatgpt.com/backend-api/codex/responses"),j_dump(r));j_set(auth,"auth_mode",j_string("apikey"));r=ct_call(8,req);h_assert(cj_get(r,"error"),j_dump(r));ct_pass("shared provider validates ChatGPT authentication without a Java policy copy");
    let compact=ct_step(sc_request("compact",cj_get(t,"state"),0));h_assert(cj_int(cj_get(compact,"command"),"compact"),j_dump(compact));req=j_object();j_set(req,"messages",cj_get(cj_get(t,"state"),"messages"));j_set(req,"event",sc_completed(ct_one(c_json("{\"type\":\"compaction\",\"encrypted_content\":\"opaque\"}"))));let reply=ct_call(5,req);req=sc_request("compacted",cj_get(compact,"state"),0);j_set(req,"reply",reply);compact=ct_step(req);sc_command(compact,"done");messages=cj_get(cj_get(compact,"state"),"messages");h_assert(h_equal(cj_text(j_at(messages,j_count(messages)-1),"encrypted_content"),"opaque")&&j_count(cj_get(cj_get(compact,"state"),"archive"))==j_count(cj_get(cj_get(t,"state"),"archive")),j_dump(compact));ct_pass("shared compaction state preserves archived history and encrypted checkpoints");
    let policies=c_json("[{}, {\"workers\":true}, {\"workers\":\"true\"}, false]");i=0;while i<j_count(policies){let policy=j_at(policies,i);req=sc_request("permissions",0,0);j_set(req,"saved",policy);r=ct_step(req);let p=cj_get(r,"policy");h_assert(j_count(cj_get(r,"entries"))==31&&!cj_int(p,"db_read"),j_dump(r));if j_kind(policy)==4{h_assert(h_equal(cj_text(p,"input"),"ask"),j_dump(r));}else{h_assert(!cj_int(p,"input"),j_dump(r));}let expected=0;let flag=cj_get(policy,"workers");if flag&&j_kind(flag)==5&&j_value(flag){expected=1;}h_assert(cj_int(p,"workers")==expected,j_dump(r));i=i+1;}r=ct_step(sc_request("permissions",0,0));let values=j_value(cj_get(r,"policy"));i=0;while i<h_count(values){let pair=h_at(values,i);let expected="ask";if h_equal(load64(pair),"approval_reviewer"){expected="user";}if h_equal(load64(pair),"permission_profile"){expected="custom";}h_assert(h_equal(j_value(load64(pair+8)),expected),"Default hardware policy is not Ask with manual review");i=i+1;}ct_pass("permission schema and conservative normalization live in the shared core");
    req=j_object();j_set(req,"config",ct_config);j_set(req,"source",j_string("fn main(){return worker_start(\"Pause\",\"Wait\")-2;}"));j_set(req,"history",j_array());j_set(req,"call_id",j_string("pause-create"));r=ct_call(3,req);h_assert(cj_int(r,"exit_code")==0,j_dump(r));plan=sc_plan(j_array(),0,1);h_assert(cj_int(j_at(cj_get(plan,"start"),0),"id")==2,j_dump(plan));req=sc_request("open_worker",0,2);j_set(req,"revision",j_int(1));let w=ct_step(req);plan=sc_plan(ct_one(j_int(2)),0,0);h_assert(j_count(cj_get(plan,"cancel"))==1&&j_value(j_at(cj_get(plan,"cancel"),0))==2,j_dump(plan));req=sc_request("failure",cj_get(w,"state"),2);j_set(req,"error",j_string("Cancelled."));j_set(req,"cancelled",j_bool(1));w=ct_step(req);let rows=cj_get(sc_workers("list",0),"workers");h_assert(h_equal(j_value(j_at(j_at(j_at(rows,1),1),2)),"paused"),j_dump(rows));req=j_object();j_set(req,"config",ct_config);j_set(req,"action",j_string("resume"));j_set(req,"id",j_int(2));r=ct_call(9,req);h_assert(cj_int(r,"changed"),j_dump(r));plan=sc_plan(j_array(),0,1);h_assert(cj_int(j_at(cj_get(plan,"start"),0),"id")==2,j_dump(plan));req=sc_request("open_worker",0,2);j_set(req,"revision",j_int(1));w=ct_step(req);w=sc_reply(cj_get(w,"state"),sc_parse(ct_one(ct_message("Recovered"))),2);rows=cj_get(sc_workers("list",0),"workers");let row=j_at(j_at(rows,1),1);h_assert(h_equal(j_value(j_at(row,2)),"done")&&h_equal(j_value(j_at(row,4)),""),j_dump(rows));h_assert(sc_row_text(cj_get(sc_workers("messages",2),"messages"),"Recovered"),"Resumed worker reply was not journaled");ct_pass("shared scheduler enforces revocation, pause/resume and unique resumed reply journaling");
    return ct_done(j_object(),"core-native-report.json");
}
