// Actual GATT client I/O and deadlines against the independent local server.
import "lib/android-peer-test.flex";
fn ga_vm(name,args){return bp_vm(h_cat("gatt_live_",name),args);}
fn main(argc,argv){
    let options=c_json("{\"peer-state\":\"\"}");if at_init(argc,argv,"gatt",options)<0{return at_self_test();}bp_path=h_real(cj_text(options,"peer-state"));let peer=bp_read();h_assert(at_bool(cj_get(peer,"ready"))&&!cj_int(peer,"connected"),"Use a fresh ready controlled GATT peer");let address=bp_address(peer);let keys=h_args("service","characteristic","descriptor","denied_characteristic","slow_characteristic",0);let i=0;while i<h_count(keys){bp_uuid(cj_text(peer,h_at(keys,i)));i=i+1;}if !at_child{return at_parent(argc,argv);}bp_source=h_read("apps/collie/tests/gatt-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let permissions=bp_permissions(1);i=h_count(permissions)-1;while i>0{ar_revoke(h_at(permissions,i));i=i-1;}bp_grant(h_at(permissions,0));let service=bp_string(cj_text(peer,"service"));let characteristic=bp_string(cj_text(peer,"characteristic"));let descriptor=bp_string(cj_text(peer,"descriptor"));let denied=bp_string(cj_text(peer,"denied_characteristic"));let slow=bp_string(cj_text(peer,"slow_characteristic"));let target=bp_string(address);at_vm(ut_prefix,bp_program("gatt_live_connect",h_args(target,0,0,0,0,0)),c_json("{\"bluetooth\":true,\"location\":false,\"db_read\":true,\"db_write\":true}"));at_pass("an actual asynchronous LE GATT connection completes with only CONNECT access and Collie Location denied");h_sleep(15300);ga_vm("alive",h_vec());at_pass("a completed GATT connection cancels its connection deadline and remains usable after that deadline passes");ga_vm("discover",h_args(service,characteristic,descriptor,0,0,0));at_pass("real service discovery produces paged owned services, distinct duplicate-UUID characteristics and actual descriptors");ga_vm("mtu",h_vec());at_pass("no-response payloads are checked against the actual MTU; Android14+ negotiates and reports517 rather than inventing the requested64");ga_vm("read",h_vec());at_pass("512 raw bytes survive real characteristic reads; duplicate UUIDs read different values and request IDs cannot be reused");ga_vm("descriptor",h_vec());at_pass("binary descriptor read/write/read crosses Android and the independent GATT server without text conversion");
    i=1;while i<=2{let cccd=7;let write=8;let category="notifications";if i==2{cccd=9;write=10;category="indications";}ga_vm("notify",h_args(h_int(i),h_int(cccd),h_int(write),0,0,0));let end=net_now()+40000;let observed=0;while net_now()<end&&!observed{peer=bp_read();h_assert(!h_len(cj_text(peer,"error")),j_dump(peer));observed=cj_int(peer,"writes")>=i&&cj_int(peer,category)>0;if !observed{h_sleep(100);}}h_assert(observed,"Independent peer did not confirm the write and subscribed update");at_pass(h_cat3("Flexscript configures the real CCCD for ",category,";512-byte acknowledged writes and copied updates match the independent peer oracle"));i=i+1;}
    ga_vm("rssi",h_vec());at_pass("actual RSSI/PHY callbacks and an SDK connection-priority request use the same serialized request channel");ga_vm("noresponse",h_vec());let end=net_now()+40000;while net_now()<end&&cj_int(bp_read(),"writes")!=3{h_sleep(100);}h_assert(cj_int(bp_read(),"writes")==3,"Independent peer did not receive the no-response write");at_pass("a512-byte no-response write is independently received by the peer, beyond the SDK completion callback");ga_vm("isolation",h_args(target,service,characteristic,0,0,0));at_pass("two actual GATT clients cannot exchange attribute IDs; closing one preserves the other SDK connection");ga_vm("rediscover",h_args(service,characteristic,denied,0,0,0));h_assert(cj_int(bp_read(),"denied")>0,"Remote authorization failure did not reach the independent peer");at_pass("rediscovery invalidates old attribute IDs and a real remote authorization error returns status8 without fabricated bytes");ga_vm("slow",h_args(slow,0,0,0,0,0));end=net_now()+40000;let proof=0;while net_now()<end&&!proof{peer=bp_read();if cj_int(peer,"closed")&&cj_int(peer,"slow_returned"){proof=peer;}else{h_sleep(100);}}h_assert(proof,"Delayed ATT reply/closure not independently confirmed");ga_vm("late",h_vec());at_pass("a delayed real ATT read keeps other requests busy, times out, disconnects the peer and cannot replace the recorded timeout with its late response");let flags=at_flags(at_package());i=1;while i<h_count(permissions){h_assert(!cj_int(cj_get(flags,h_at(permissions,i)),"granted"),"GATT requested an unrelated Android permission");i=i+1;}at_pass("GATT operations never requested Android SCAN/ADVERTISE or Location access");let report=j_object();j_set(report,"gatt_client_verified",j_bool(1));j_set(report,"gatt_server_binding_verified",j_bool(0));return at_finish(report);
}
