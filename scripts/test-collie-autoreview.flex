// Real VM checkpoints and shared review state machine; no credentials/model IO.
import "lib/collie-test.flex";
fn ar_policy(key,mode){let grants=ct_grants(j_bool(1));j_set(grants,"approval_reviewer",j_string("auto_review"));j_set(grants,key,j_string(mode));j_set(ct_config,"permissions",grants);return grants;}
fn ar_observe(t){return ct_transition("observation",t,"observation",ct_observe(t));}
fn ar_answer(t,text){let r=ct_request("reviewed",cj_get(t,"state"));let command=cj_get(t,"command");j_set(r,"request_id",j_need(command,"request_id"));j_set(r,"call_id",j_need(command,"call_id"));j_set(r,"attempt",j_need(command,"attempt"));j_set(r,"reply",ct_reply(text));return r;}
fn ar_allow(){return "{\"risk_level\":\"low\",\"user_authorization\":\"high\",\"outcome\":\"allow\",\"rationale\":\"Narrow reversible workspace action requested by the user.\"}";}
fn ar_deny(){return "{\"risk_level\":\"high\",\"user_authorization\":\"low\",\"outcome\":\"deny\",\"rationale\":\"The requested side effects are not authorized.\"}";}
fn ar_failed(t){let r=ct_request("failure",cj_get(t,"state"));j_set(r,"error",j_string("Controlled review transport failure"));return ct_step(r);}
fn ar_result(t){let messages=cj_get(cj_get(t,"state"),"messages");let i=j_count(messages)-1;while i>=0{let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output"){return c_json(j_s(m,"output"));}i=i-1;}return j_object();}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));
    let r=ct_request("permissions",0);j_set(r,"saved",c_json("{\"files_read\":false,\"files_write\":\"ask\",\"approval_reviewer\":\"auto_review\"}"));let normalized=ct_call(8,r);let policy=cj_get(normalized,"policy");h_assert(h_equal(cj_text(policy,"approval_reviewer"),"auto_review")&&j_kind(cj_get(policy,"files_read"))==5&&!cj_int(policy,"files_read")&&h_equal(cj_text(policy,"files_write"),"ask"),j_dump(normalized));r=ct_request("permissions",0);j_set(r,"saved",c_json("{\"approval_reviewer\":true}"));h_assert(h_equal(cj_text(cj_get(ct_call(8,r),"policy"),"approval_reviewer"),"user"),"Invalid stored reviewer enabled automatic approval");ct_pass("reviewer selection normalizes independently of Ask, Allow and Deny grants");
    ar_policy("files_write","ask");let source="fn main(){let p=alloc(2);store8(p,65);store8(p+1,10);db_io(0,1,p,2);fs_write(\"repeated.txt\",db_text(\"one\"));fs_write(\"repeated.txt\",db_text(\"one\"));fs_write(\"other.txt\",db_text(\"two\"));return 0;}";
    let t=ct_begin(source,"exact-calls");let i=0;let chain=0;while i<3{
        let o=ct_observe(t);h_assert(h_equal(cj_text(o,"state"),"permission"),j_dump(o));let signal=cj_get(o,"signal");h_assert(cj_int(signal,"review_chain")>chain,"A later identical operation reused an old approval chain");chain=cj_int(signal,"review_chain");
        t=ct_command(ct_transition("observation",t,"observation",o),"autoreview");let body=cj_get(cj_get(t,"command"),"body");h_assert(h_equal(cj_text(body,"model"),"codex-auto-review")&&j_count(cj_get(body,"tools"))==0&&h_equal(cj_text(body,"tool_choice"),"none")&&!h_has(j_dump(body),"encrypted_content"),"Reviewer is not isolated/tools-free");let evidence=c_json(cj_text(j_at(cj_get(body,"input"),0),"content"));h_assert(h_len(cj_text(cj_get(evidence,"request"),"request_hex"))&&h_has(j_dump(cj_get(evidence,"request")),"repeated.txt")==(i<2),"Exact target/arguments missing");
        if !i{h_assert(!h_exists(h_join(ct_root,"files/repeated.txt")),"Side effect occurred before review");let invalid=ar_answer(t,ar_allow());j_set(invalid,"request_id",j_int(999));h_assert(cj_get(ct_call(8,invalid),"error"),"Stale result accepted");}
        t=ct_command(ct_step(ar_answer(c_json(j_dump(t)),ar_allow())),"vm");i=i+1;
    }
    t=ct_transition("observation",t,"observation",ct_continued(ct_observe(t)));h_assert(h_equal(cj_text(ar_result(t),"stdout"),"A\n")&&h_equal(h_read(h_join(ct_root,"files/repeated.txt")),"one")&&h_equal(h_read(h_join(ct_root,"files/other.txt")),"two"),j_dump(t));h_assert(h_equal(cj_text(cj_get(ct_config,"permissions"),"files_write"),"ask"),"Review persisted a broad capability grant");ct_pass("exact operation approvals resume real VM state once, including identical consecutive calls and fresh host processes");
    source="fn main(){if fs_write(\"denied.txt\",db_text(\"no\")){return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}";
    t=ct_command(ar_observe(ct_begin(source,"denied")),"autoreview");t=ct_command(ct_step(ar_answer(t,ar_deny())),"vm");let o=ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/denied.txt"))&&h_has(cj_text(o,"stdout"),"Auto-review denied")&&h_has(cj_text(o,"stdout"),"Do not bypass"),j_dump(o));ct_pass("denials reach the guest as errors without executing the requested side effect");
    let bad=c_json("[\"not JSON\",\"{}\",\"{\\\"outcome\\\":\\\"allow\\\"}\",\"{\\\"risk_level\\\":\\\"critical\\\",\\\"user_authorization\\\":\\\"high\\\",\\\"outcome\\\":\\\"allow\\\",\\\"rationale\\\":\\\"bad\\\"}\",\"{\\\"risk_level\\\":\\\"high\\\",\\\"user_authorization\\\":\\\"unknown\\\",\\\"outcome\\\":\\\"allow\\\",\\\"rationale\\\":\\\"bad\\\"}\",\"{\\\"risk_level\\\":\\\"low\\\",\\\"user_authorization\\\":\\\"high\\\",\\\"outcome\\\":\\\"allow\\\",\\\"rationale\\\":\\\"ok\\\",\\\"extra\\\":true}\"]");
    i=0;while i<j_count(bad){t=ct_command(ar_observe(ct_begin(source,h_cat("bad-",h_int(i)))),"autoreview");t=ct_step(ar_answer(t,j_value(j_at(bad,i))));o=ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/denied.txt"))&&h_has(cj_text(o,"stdout"),"Auto-review denied"),j_dump(o));i=i+1;}t=ar_observe(ct_begin(source,"tool-review"));r=ar_answer(t,ar_allow());j_set(cj_get(r,"reply"),"tool_call",c_json("{\"name\":\"flexscript\",\"input\":\"fn main(){return 0;}\"}"));t=ct_step(r);ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/denied.txt")),"Reviewer tool call ran");ct_pass("malformed JSON, incomplete/extra fields, tool calls and contradictory risk assessments fail closed");
    t=ct_command(ar_observe(ct_begin(source,"fallback")),"autoreview");t=ct_command(ar_failed(t),"autoreview");h_assert(h_equal(cj_text(cj_get(cj_get(t,"command"),"body"),"model"),"gpt-6.1-sol")&&cj_int(cj_get(t,"command"),"attempt")==1&&!h_exists(h_join(ct_root,"files/denied.txt")),j_dump(t));t=ct_command(ar_failed(t),"vm");ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/denied.txt")),"Transport failure granted access");ct_pass("unavailable preferred reviewer retries the selected model in an isolated branch, then denies on transport failure");
    t=ct_command(ar_observe(ct_begin(source,"revoke")),"autoreview");r=ar_answer(t,ar_allow());j_set(cj_get(ct_config,"permissions"),"files_write",j_bool(0));j_set(r,"config",ct_config);t=ct_command(ct_step(r),"vm");ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/denied.txt")),"Review overrode revocation");ar_policy("files_write","ask");t=ar_observe(ct_begin(source,"manual-switch"));r=ar_answer(t,ar_allow());j_set(cj_get(ct_config,"permissions"),"approval_reviewer",j_string("user"));j_set(r,"config",ct_config);t=ct_command(ct_step(r),"permission");ct_pass("revocation and switching to manual approval invalidate an in-flight review");
    ar_policy("files_write","ask");t=ar_observe(ct_begin(source,"changed-user"));r=ar_answer(t,ar_allow());let user=c_json("{\"role\":\"user\",\"content\":\"Do not write any file.\"}");j_push(cj_get(cj_get(r,"state"),"archive"),user);t=ct_step(r);o=ct_continued(ct_observe(t));h_assert(h_has(cj_text(o,"stdout"),"instructions changed")&&!h_exists(h_join(ct_root,"files/denied.txt")),j_dump(o));ct_pass("changed user authorization invalidates review evidence before execution");
    t=ar_observe(ct_begin(source,"cancel"));r=ct_request("failure",cj_get(t,"state"));j_set(r,"error",j_string("Cancelled."));j_set(r,"cancelled",j_bool(1));ct_command(ct_step(r),"done");h_assert(!h_exists(h_join(ct_root,"files/denied.txt")),"Cancelled review executed");ct_pass("cancellation does not execute or grant the pending action");
    let grants=ar_policy("workers","ask");j_set(grants,"files_write",j_string("ask"));source="fn main(){let p=imagen(\"A small blue circle\",\"circle.png\");return 0;}";t=ct_command(ar_observe(ct_begin(source,"multi-key")),"autoreview");let first=cj_int(cj_get(cj_get(t,"command"),"signal"),"review_chain");t=ct_step(ar_answer(t,ar_allow()));t=ct_command(ar_observe(t),"autoreview");h_assert(cj_int(cj_get(cj_get(t,"command"),"signal"),"review_chain")==first&&h_equal(cj_text(cj_get(cj_get(t,"command"),"signal"),"key"),"files_write"),j_dump(t));t=ct_step(ar_answer(t,ar_allow()));t=ct_command(ar_observe(t),"imagegen");h_assert(j_count(cj_get(cj_get(cj_get(t,"command"),"signal"),"reviewed_permissions"))==2,"Deferred action lost its two scoped approvals");ct_pass("multi-permission calls keep their exact grants across checkpoints and authorize only their deferred image effect");
    ar_policy("workers","ask");t=ct_command(ar_observe(ct_begin("fn main(){let a=agent_ask(\"Check this supplied number:42\");return 0;}","feedback-ticket")),"autoreview");t=ct_step(ar_answer(t,ar_allow()));t=ct_command(ar_observe(t),"feedback");ct_pass("reviewed in-program feedback reaches the tools-free feedback branch without granting future worker calls");
    t=ct_command(ar_observe(ct_begin("fn main(){return worker_start(\"Helper\",\"Read the bounded workspace\")-1;}","worker-ticket")),"autoreview");t=ct_step(ar_answer(t,ar_allow()));ct_continued(ct_observe(t));r=ct_request("plan",0);j_set(r,"active",j_array());j_set(r,"allowed",j_bool(0));j_set(r,"authenticated",j_bool(1));let plan=ct_call(9,r);h_assert(j_count(cj_get(plan,"start"))==1,j_dump(plan));j_set(cj_get(ct_config,"permissions"),"workers",j_bool(0));plan=ct_call(9,r);h_assert(j_count(cj_get(plan,"start"))==0,j_dump(plan));ct_pass("review-created workers can run with inherited policy while an explicit worker denial still blocks scheduling");
    ar_policy("files_write","ask");source="fn main(){fs_write(\"circuit.txt\",db_text(\"no\"));fs_write(\"circuit.txt\",db_text(\"no\"));fs_write(\"circuit.txt\",db_text(\"no\"));return 0;}";t=ct_begin(source,"circuit");i=0;while i<3{t=ct_command(ar_observe(t),"autoreview");t=ct_step(ar_answer(t,ar_deny()));i=i+1;}ct_command(t,"done");h_assert(!h_exists(h_join(ct_root,"files/circuit.txt")),"Denial circuit breaker executed side effects");ct_pass("three consecutive denials stop the turn and pair the unfinished program with a real observation");
    ar_policy("files_write","ask");source="fn main(){if fs_write(\"restart-denied.txt\",db_text(\"no\")){return 1;}return 0;}";t=ct_command(ar_observe(ct_begin(source,"replace-review")),"autoreview");t=ct_command(ct_step(ar_answer(t,ar_allow())),"vm");t=ct_command(ct_transition("resume",c_json(j_dump(t)),0,0),"autoreview");t=ct_step(ar_answer(t,ar_deny()));ct_continued(ct_observe(t));h_assert(!h_exists(h_join(ct_root,"files/restart-denied.txt")),"An old approval overrode a new denial after restart");ct_pass("a fresh denial replaces the earlier unconsumed approval when a checkpoint is re-reviewed after restart");
    r=ct_request("observation",0);j_set(r,"observation",c_json("{\"state\":\"continue\",\"exit_code\":0,\"stdout\":\"\",\"stderr\":\"\"}"));h_assert(cj_get(ct_call(8,r),"error"),"Unexpected observation was accepted without a pending program");ct_pass("an observation without a pending program returns a recoverable error rather than replaying or crashing");
    r=ct_request("begin",0);j_set(r,"text",j_string(h_cat(h_repeat("x",8191),"中")));t=ct_step(r);t=ct_transition("reply",t,"reply",ct_program(source,"utf8-context"));t=ct_command(ar_observe(t),"autoreview");let body=cj_get(cj_get(t,"command"),"body");let evidence=c_json(cj_text(j_at(cj_get(body,"input"),0),"content"));let context=cj_get(evidence,"conversation");h_assert(j_count(context)==1&&h_len(cj_text(j_at(context,0),"content"))==8191&&cj_int(j_at(context,0),"truncated"),"Reviewer evidence split a UTF-8 character");ct_pass("bounded reviewer evidence clips at UTF-8 boundaries and marks omitted content");
    ar_policy("files_write","ask");source="fn main(){fs_write(\"guarded.txt\",db_text(\"original\"));fs_write(\"guard-next.txt\",db_text(\"later\"));return 0;}";t=ct_command(ar_observe(ct_begin(source,"interrupted-admission")),"autoreview");t=ct_step(ar_answer(t,ar_allow()));let checkpoint=h_join(ct_root,"vm-0.checkpoint");let snapshot=h_read(checkpoint);let snapshot_bytes=h_file_size;let advanced=ct_observe(t);h_assert(h_equal(cj_text(advanced,"state"),"permission")&&h_equal(h_read(h_join(ct_root,"files/guarded.txt")),"original"),j_dump(advanced));o=ct_observe(c_json(j_dump(t)));h_assert(cj_int(o,"execution_uncertain")&&!h_exists(h_join(ct_root,"files/guard-next.txt")),"An unobserved newer checkpoint reused an older approval");h_save_bytes(checkpoint,snapshot,snapshot_bytes,384);h_save(h_join(ct_root,"files/guarded.txt"),"sentinel after interrupted execution");o=ct_observe(c_json(j_dump(t)));h_assert(h_equal(cj_text(o,"state"),"error")&&cj_int(o,"execution_uncertain")&&!cj_int(o,"executed")&&h_equal(h_read(h_join(ct_root,"files/guarded.txt")),"sentinel after interrupted execution"),j_dump(o));ct_pass("durable checkpoint admission blocks replay after effects ran but the next VM observation was lost");
    return ct_done(j_object(),"autoreview-report.json");
}
