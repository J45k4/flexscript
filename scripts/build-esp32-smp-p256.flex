import "lib/esp32-elf.flex";
// Explicit pinned vendor archive andinstalled Xtensa toolchain only.
fn pbc_alias(a,b) {if h_equal(h_absolute(a),h_absolute(b)) {return 1;}let x=h_take(144);let y=h_take(144);if !syscall(4,a,x,0,0,0,0) && !syscall(4,b,y,0,0,0,0) {return load64(x)==load64(y) && load64(x+8)==load64(y+8);}return 0;}
fn pbc_config(args,header,include,p256) {h_add(args,"-DMBEDTLS_CONFIG_FILE=\"esp32-smp-p256-config.h\"");h_add(args,"-I");h_add(args,header);h_add(args,"-I");h_add(args,include);h_add(args,"-I");h_add(args,p256);return 0;}
fn main(argc,argv) {
    h_environment(argc,argv);let archive=b_option(argc,argv,"--archive",0);let output=b_option(argc,argv,"--output",0);let chip=b_option(argc,argv,"--chip","esp32");let s3=h_equal(chip,"esp32s3");h_assert(archive && output,"requires --archive mbedtls-3.6.7.tar.bz2 --output DIRECTORY [--chip esp32|esp32s3] [--prefix PREFIX]");h_assert(s3 || h_equal(chip,"esp32"),"P-256 chip must be esp32 or esp32s3");
    archive=h_real(archive);let pin="a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6";h_assert(h_equal(h_sha(archive),pin),"P-256 requires the pinned official Mbed TLS3.6.7 archive");let prefix="xtensa-esp32-elf-";if s3 {prefix="xtensa-esp32s3-elf-";}prefix=b_option(argc,argv,"--prefix",prefix);
    let gcc=h_real(h_executable(h_cat(prefix,"gcc")));let ar=h_real(h_executable(h_cat(prefix,"ar")));let objcopy=h_real(h_executable(h_cat(prefix,"objcopy")));let config=h_real("lib/platform/esp32-smp-p256-config.h");let profile=h_real("tests/esp32/abi-oracle/smp-p256-profile.c");output=h_absolute(output);
    let inputs=h_args(archive,gcc,ar,objcopy,config,profile);let targets=h_args("libsmpcurve.a","flexscript-smp-curve.json","LICENSE","p256-m.h","p256-m.README.md",0);let i=0;
    while i<h_count(targets) {let path=h_join(output,h_at(targets,i));let j=0;while j<h_count(inputs) {h_assert(!pbc_alias(path,h_at(inputs,j)),"P-256 output aliases input");j=j+1;}j=0;while j<i {h_assert(!pbc_alias(path,h_join(output,h_at(targets,j))),"P-256 outputs alias each other");j=j+1;}i=i+1;}
    let work=h_temp();h_ok(h_args("tar","-xjf",archive,"-C",work,0));let root=h_join(work,"mbedtls-3.6.7");h_assert(h_isdir(root),"unexpected pinned Mbed TLS archive layout");let include=h_join(root,"include");let p256=h_join(root,"3rdparty/p256-m/p256-m");let headers=h_real("lib/platform");
    let abi=h_join(work,"profile.o");let args=h_args(gcc,"-std=c11","-c",profile,"-o",abi);pbc_config(args,headers,include,p256);h_ok(args);let vector=h_join(work,"profile.bin");args=h_args(objcopy,"-O","binary","-j",".rodata.smp_curve_profile",abi);h_add(args,vector);h_ok(args);let bytes=h_read(vector);h_assert(h_file_size==32 && ee_u32(bytes)==32 && ee_u32(bytes+4)==64 && ee_u32(bytes+8)==32 && ee_u32(bytes+12)==4 && ee_u32(bytes+16)==4 && ee_u32(bytes+20)==4294967295 && ee_u32(bytes+24)==4294967294 && ee_u32(bytes+28)==4294967293,"unsupported P-256 byte-array ABI");
    let object=h_join(work,"p256.o");args=h_args(gcc,"-Os","-fno-builtin","-mlongcalls","-mtext-section-literals","-ffunction-sections");h_add(args,"-fdata-sections");pbc_config(args,headers,include,p256);h_add(args,"-c");h_add(args,h_join(p256,"p256-m.c"));h_add(args,"-o");h_add(args,object);h_ok(args);
    let namespaced=h_join(work,"smp-p256.o");h_ok(h_args(objcopy,"--prefix-symbols=smp_curve_vendor_",object,namespaced,0,0));let library=h_join(work,"libsmpcurve.a");h_ok(h_args(ar,"rcsD",library,namespaced,0,0));
    let report=j_object();j_set(report,"version",j_string("3.6.7"));j_set(report,"source_sha256",j_string(pin));j_set(report,"component_sha256",j_string(h_sha(h_join(p256,"p256-m.c"))));j_set(report,"profile_sha256",j_string(h_sha(config)));j_set(report,"chip",j_string(chip));j_set(report,"namespace",j_string("smp_curve_vendor_"));j_set(report,"private_bytes",j_int(32));j_set(report,"public_bytes",j_int(64));j_set(report,"shared_bytes",j_int(32));j_set(report,"archive_sha256",j_string(h_sha(library)));j_set(report,"gcc_sha256",j_string(h_sha(gcc)));j_set(report,"abi_oracle_sha256",j_string(h_sha(profile)));j_set(report,"heap_allocation",j_bool(0));
    h_mkdir(output);let data=h_read(library);let size=h_file_size;h_save_bytes(h_join(output,"libsmpcurve.a"),data,size,420);h_save(h_join(output,"LICENSE"),h_read(h_join(root,"LICENSE")));h_save(h_join(output,"p256-m.h"),h_read(h_join(p256,"p256-m.h")));h_save(h_join(output,"p256-m.README.md"),h_read(h_join(root,"3rdparty/p256-m/README.md")));j_save(h_join(output,"flexscript-smp-curve.json"),report);h_remove(work);h_print(1,h_cat3("Built pinned P-256 package: ",output,"\n"));return 0;
}
