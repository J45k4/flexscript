fn dt_tap(node){let b=dt_bounds(node);h_assert(b,"Invalid actual UI bounds");dt_ok(dt_args("shell","input","tap",h_int((load64(b)+load64(b+16))/2),h_int((load64(b+8)+load64(b+24))/2),0),"");return 0;}
