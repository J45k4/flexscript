fn dt_records(){let p=dt_call(dt_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/document-trees.xml",0),"");if h_status(p)!=0{return "[]";}let xml=h_out(p);let tag="<string name=\"records\">";let at=h_find(xml,tag);if at<0{return "[]";}let start=xml+at+h_len(tag);let end=h_find(start,"</string>");h_assert(end>=0,"Invalid saved document records");let value=h_slice(start,end);value=h_replace(value,"&quot;","\"");value=h_replace(value,"&lt;","<");value=h_replace(value,"&gt;",">");value=h_replace(value,"&apos;","'");return h_replace(value,"&amp;","&");}
