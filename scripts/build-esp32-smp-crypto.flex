import "lib/esp32-elf.flex";
// Explicit pinned vendor archive and installed toolchain. No compiler download.
fn smpc_alias(a,b) {if h_equal(h_absolute(a),h_absolute(b)) {return 1;}let x=h_take(144);let y=h_take(144);if !syscall(4,a,x,0,0,0,0) && !syscall(4,b,y,0,0,0,0) {return load64(x)==load64(y) && load64(x+8)==load64(y+8);}return 0;}
fn smpc_add_config(args,header,include) {h_add(args,"-DMBEDTLS_CONFIG_FILE=\"esp32-smp-mbedtls-config.h\"");h_add(args,"-I");h_add(args,header);h_add(args,"-I");h_add(args,include);return 0;}
fn main(argc,argv) {
    h_environment(argc,argv);let archive=b_option(argc,argv,"--archive",0);let output=b_option(argc,argv,"--output",0);let chip=b_option(argc,argv,"--chip","esp32");let s3=h_equal(chip,"esp32s3");
    h_assert(archive && output,"requires --archive mbedtls-3.6.7.tar.bz2 --output DIRECTORY [--chip esp32|esp32s3] [--prefix PREFIX]");h_assert(s3 || h_equal(chip,"esp32"),"SMP crypto chip must be esp32 or esp32s3");
    archive=h_real(archive);let pin="a7e8bcbec0e6f761b4af24f25677626b35f762f68eef79c08677a363212d11f6";h_assert(h_equal(h_sha(archive),pin),"SMP AES requires the pinned official Mbed TLS3.6.7 archive");
    let prefix="xtensa-esp32-elf-";if s3 {prefix="xtensa-esp32s3-elf-";}prefix=b_option(argc,argv,"--prefix",prefix);
    let gcc=h_real(h_executable(h_cat(prefix,"gcc")));let ar=h_real(h_executable(h_cat(prefix,"ar")));let objcopy=h_real(h_executable(h_cat(prefix,"objcopy")));output=h_absolute(output);
    let header=h_real("lib/platform/esp32-smp-mbedtls-config.h");let profile=h_real("tests/esp32/abi-oracle/smp-crypto-profile.c");let inputs=h_args(archive,gcc,ar,objcopy,header,profile);let targets=h_args("libsmpcrypto.a","flexscript-smp-crypto.json","LICENSE",0,0,0);let i=0;
    while i<h_count(targets) {let path=h_join(output,h_at(targets,i));let j=0;while j<h_count(inputs) {h_assert(!smpc_alias(path,h_at(inputs,j)),"SMP crypto output aliases input");j=j+1;}j=0;while j<i {h_assert(!smpc_alias(path,h_join(output,h_at(targets,j))),"SMP crypto outputs alias each other");j=j+1;}i=i+1;}
    let work=h_temp();h_ok(h_args("tar","-xjf",archive,"-C",work,0));let root=h_join(work,"mbedtls-3.6.7");h_assert(h_isdir(root),"unexpected pinned Mbed TLS archive layout");let include=h_join(root,"include");let headers=h_real("lib/platform");
    let abi=h_join(work,"profile.o");let args=h_args(gcc,"-std=c11","-c",profile,"-o",abi);smpc_add_config(args,headers,include);h_ok(args);
    let vector=h_join(work,"profile.bin");args=h_args(objcopy,"-O","binary","-j",".rodata.smp_profile",abi);h_add(args,vector);h_ok(args);let bytes=h_read(vector);h_assert(h_file_size==12 && ee_u32(bytes)<=256 && ee_u32(bytes+4)<=16 && ee_u32(bytes+8)==1,"unsupported Mbed TLS AES context ABI");let context=ee_u32(bytes);let alignment=ee_u32(bytes+4);
    let object=h_join(work,"aes.o");args=h_args(gcc,"-Os","-fno-builtin","-mlongcalls","-mtext-section-literals","-ffunction-sections");h_add(args,"-fdata-sections");smpc_add_config(args,headers,include);h_add(args,"-I");h_add(args,h_join(root,"library"));h_add(args,"-c");h_add(args,h_join(root,"library/aes.c"));h_add(args,"-o");h_add(args,object);h_ok(args);
    let namespaced=h_join(work,"smp-aes.o");h_ok(h_args(objcopy,"--prefix-symbols=smp_vendor_",object,namespaced,0,0));let library=h_join(work,"libsmpcrypto.a");h_ok(h_args(ar,"rcsD",library,namespaced,0,0));
    let report=j_object();j_set(report,"version",j_string("3.6.7"));j_set(report,"source_sha256",j_string(pin));j_set(report,"profile_sha256",j_string(h_sha(header)));j_set(report,"chip",j_string(chip));j_set(report,"namespace",j_string("smp_vendor_"));j_set(report,"context_size",j_int(context));j_set(report,"context_alignment",j_int(alignment));j_set(report,"context_capacity",j_int(256));j_set(report,"key_bits",j_int(128));j_set(report,"archive_sha256",j_string(h_sha(library)));j_set(report,"gcc_sha256",j_string(h_sha(gcc)));j_set(report,"abi_oracle_sha256",j_string(h_sha(profile)));
    h_mkdir(output);let data=h_read(library);let size=h_file_size;h_save_bytes(h_join(output,"libsmpcrypto.a"),data,size,420);h_save(h_join(output,"LICENSE"),h_read(h_join(root,"LICENSE")));j_save(h_join(output,"flexscript-smp-crypto.json"),report);h_remove(work);h_print(1,h_cat3("Built pinned SMP AES package: ",output,"\n"));return 0;
}
