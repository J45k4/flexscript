global vv_png=0;global vv_bytes=0;global vv_filename=0;global vv_directory=0;
fn vv_saved(){let s=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));h_assert(s,"Missing owned view session");return s;}
fn vv_case(payload){ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");if !cj_get(payload,"initial_permissions"){j_set(payload,"initial_permissions",at_basic_grants());}let r=at_case(ut_prefix,payload);h_sleep(500);return r;}
fn vv_execute(source){let p=j_object();j_set(p,"source",j_string(source));return at_observation(vv_case(p));}
fn vv_file(name){h_assert(h_find(name,"..")<0&&h_find(name,"/")<0,"Unsafe owned image filename");return h_cat3("files/workspaces/",ut_prefix,h_cat("/files/",name));}
fn vv_put(name,data,size){let path=vv_file(name);let args=ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'umask 077; cat > ",path,"'"));let p=h_spawn(args,data,0);h_assert(load64(p+32)>=0,"Binary input pipe closed before file transfer");store64(p+64,size);h_check(h_wait(p),0,0);return 0;}
fn vv_read(path){return ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),"");}
fn vv_hash(path){let p=vv_read(path);return h_sha_bytes(h_out(p),h_size(load64(p+16)));}
fn vv_pending(count){let until=net_now()+30000;while net_now()<until{let s=vv_saved();if j_count(cj_get(s,"pending_attachments"))==count{return s;}h_sleep(300);}h_die("Actual attachment count did not reach expected value");return 0;}
fn vv_node(xml,label){if !h_equal(label,"Expand thinking")&&!h_equal(label,"Show VM result"){return au_node(xml,label);}let offset=0;let found=0;while load8(xml+offset){let at=h_find(xml+offset,"<node ");if at<0{return found;}offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed activity row");let node=h_slice(xml+offset,end+1);if h_equal(ut_attr(node,"enabled"),"true")&&(h_equal(ut_attr(node,"content-desc"),label)||h_equal(ut_attr(node,"text"),label)){found=node;}offset=offset+end+1;}return found;}
fn vv_tap(label){let attempt=0;while attempt<6{let xml=at_xml();let node=vv_node(xml,label);if node{ut_tap(node);h_sleep(300);return 0;}let horizontal=at_node(xml,"class","android.widget.HorizontalScrollView",0);if horizontal&&(h_starts(label,"Remove attachment:")||h_starts(label,"Open attached image:")){let b=ut_attr(horizontal,"bounds");let values=h_take(32);let at=0;let n=0;while load8(b+at){if load8(b+at)>=48&&load8(b+at)<=57{let start=at;while load8(b+at)>=48&&load8(b+at)<=57{at=at+1;}h_assert(n<4,"Bad attachment scroll bounds");store64(values+n*8,h_number(h_slice(b+start,at-start)));n=n+1;}else{at=at+1;}}h_assert(n==4,"Missing attachment scroll bounds");let x=load64(values);let y=(load64(values+8)+load64(values+24))/2;let width=load64(values+16)-x;let args=ut_args("shell","input","swipe",h_int(x+width*3/4),h_int(y),h_int(x+width/4));h_add(args,h_int(y));h_add(args,"250");ut_ok(args,"");}else{au_scroll(1);}attempt=attempt+1;}au_shot(vv_directory,"missing-control");h_die(h_cat("Missing actual view control: ",label));return 0;}
fn vv_shot(name){return au_shot(vv_directory,name);}
fn vv_external(){let i=0;while i<5{let xml=at_xml();let offset=0;while load8(xml+offset){let at=h_find(xml+offset,"<node ");if at<0{offset=h_len(xml);}else{offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Invalid picker hierarchy");let node=h_slice(xml+offset,end+1);let pkg=ut_attr(node,"package");if pkg&&!h_equal(pkg,"org.flexscript.collie")&&!h_equal(pkg,"com.android.systemui"){return xml;}offset=offset+end+1;}}h_sleep(500);i=i+1;}h_die("Actual external picker/camera did not open");return 0;}
fn vv_scan(path){let args=ut_args("shell","am","broadcast","-a","android.intent.action.MEDIA_SCANNER_SCAN_FILE","-d");h_add(args,h_cat("file://",path));return ut_ok(args,"");}
fn vv_push(name,path){ut_ok(ut_args("push",h_join(vv_directory,name),path,0,0,0),"");return 0;}
fn vv_pick(filename){vv_tap("Attach file");vv_tap("Files");if !au_node(vv_external(),filename){vv_tap("Show roots");vv_tap("Downloads");}vv_tap(filename);return 0;}
fn vv_cleanup(){
    vv_filename=cj_text(at_extra,"filename");h_assert(h_equal(vv_filename,h_cat(ut_prefix,".png")),"Cleanup filename ownership mismatch");let download=h_cat("/sdcard/Download/",vv_filename);if cj_int(at_options,"picker"){ut_ok(ut_args("shell","rm","-f",download,h_cat(download,".txt"),0),"");}if cj_int(at_options,"media")||cj_int(at_options,"media-only"){let path=h_cat("/sdcard/Pictures/",vv_filename);ut_ok(ut_args("shell","rm","-f",path,0,0),"");vv_scan(path);let raw=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));let camera="";if h_find(raw,"name=\"camera_file\"")>=0{camera=ap_string(raw,"camera_file");}if h_len(camera){h_assert(h_find(camera,"/")<0&&!h_has(camera,"..")&&h_len(camera)==40&&h_equal(camera+36,".jpg"),"Camera cleanup escaped app-private camera cache");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",h_cat("cache/camera/",camera)),"");}}return 0;
}
fn vv_main(){
