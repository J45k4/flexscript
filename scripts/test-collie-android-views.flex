        }else{payload=j_object();j_set(payload,"prompt",j_string(h_cat3("Use view_image to inspect ",imported,". Describe the colored shapes and read the exact visible label. Do not guess; wait for actual image input.")));r=vv_case(payload);messages=cj_get(r,"messages");}let answer=cj_text(j_at(messages,j_count(messages)-1),"content");h_assert(h_has(answer,"KITE-5721")&&(h_has(answer,"red")||h_has(answer,"Red"))&&(h_has(answer,"blue")||h_has(answer,"Blue")),"Live vision missed actual shapes/hidden label");let used=0;let i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call")&&h_has(cj_text(m,"input"),"view_image"){used=1;}i=i+1;}h_assert(used&&!h_has(j_dump(vv_saved()),"data:image/"),"Live vision missing tool or base64 leaked into saved history");at_pass("live model sees actual image pixels/hidden fixture label; saved history has no base64");
