        let pending=cj_get(vv_saved(),"pending_attachments");let count=j_count(pending);vv_tap("Attach file");let xml=at_xml();h_assert(au_node(xml,"Gallery")&&au_node(xml,"Camera")&&au_node(xml,"Files"),"Attachment modes missing");let path=h_cat("/sdcard/Pictures/",vv_filename);vv_push("sample.png",path);vv_scan(path);vv_tap("Gallery");xml=vv_external();vv_shot("gallery_picker");let offset=0;let photo=0;while load8(xml+offset)&&!photo{let at=h_find(xml+offset,"<node ");if at<0{offset=h_len(xml);}else{offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed photo picker");let node=h_slice(xml+offset,end+1);let label=ut_attr(node,"content-desc");if label&&h_has(label,"Photo taken"){photo=node;}offset=offset+end+1;}}h_assert(photo,"No scanned synthetic photo in actual system picker");ut_tap(photo);let current=cj_get(vv_pending(count+1),"pending_attachments");let selected=j_at(current,count);h_assert(h_equal(cj_text(selected,"image_id"),cj_text(image,"image_id")),"System picker selected different pixels from the owned synthetic fixture");vv_tap(h_cat("Open attached image: ",cj_text(selected,"path")));vv_shot("gallery_preview");vv_tap("Close preview");vv_tap(h_cat("Remove attachment: ",cj_text(selected,"path")));h_assert(jc_equal(cj_get(vv_pending(count),"pending_attachments"),pending),"Gallery removal changed previous draft");
        let cache=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","ls","cache/camera",0),"");h_assert(!h_len(h_trim(h_out(cache))),"Existing camera cache must be empty before synthetic capture");vv_tap("Attach file");vv_tap("Camera");xml=at_xml();if h_has(xml,"permissioncontroller")&&h_has(xml,"Allow Collie"){at_click("resource-id","permission_allow_foreground_only_button",1);h_sleep(500);}xml=vv_external();vv_shot("camera");h_assert(h_has(xml,".camera")||h_has(xml,"Camera"),"Actual camera app did not open");vv_tap("Shutter");h_sleep(2000);xml=at_xml();vv_shot("camera_review");if au_node(xml,"Done"){vv_tap("Done");}else if au_node(xml,"OK"){vv_tap("OK");}current=cj_get(vv_pending(count+1),"pending_attachments");let captured=j_at(current,count);h_assert(h_starts(cj_text(captured,"path"),"/Camera-")&&h_len(cj_text(captured,"image_id"))&&cj_int(captured,"width")<=1536&&cj_int(captured,"height")<=1536&&cj_int(captured,"file_bytes")<=524288,"Synthetic capture is not a bounded actual image attachment");vv_tap(h_cat("Open attached image: ",cj_text(captured,"path")));vv_shot("camera_preview");vv_tap("Close preview");vv_tap(h_cat("Remove attachment: ",cj_text(captured,"path")));h_assert(jc_equal(cj_get(vv_pending(count),"pending_attachments"),pending),"Camera removal changed previous draft");h_assert(!h_len(au_pref("camera_file")),"Camera output preference survived completed capture");cache=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","ls","cache/camera",0),"");h_assert(!h_len(h_trim(h_out(cache))),"Camera private output was not cleaned");at_pass("Gallery/Camera/Files open from +; actual system photo import and synthetic camera capture preserve draft and clean private output");
    }
    if cj_int(at_options,"live"){
