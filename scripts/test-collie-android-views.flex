fn main(argc,argv){at_preserve=0;at_cleanup_hook=1;let options=c_json("{\"live\":false,\"picker\":false,\"media\":false,\"media-only\":false}");if at_init(argc,argv,"views",options)<0{return at_self_test();}if at_cleanup{return vv_cleanup();}if !at_child{return at_parent(argc,argv);}return vv_main();}
