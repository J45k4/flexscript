import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("requires x>=0 && x<100; ensures result==old(x)+1; fn increment(x){ghost let initial=x;x=x+1;assert x==initial+1;return x;}",0,"Verified roots: 1/1");
    ps_verify("fn snapshot(x){ghost let before=x;x=x+1;assert x==before;return x;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("fn block(x){proof {let twice=x+x;assert twice==x*2;}return x;}",0,"Verified roots: 1/1");
    ps_verify("fn modify(x){ghost let copy=x;proof {copy=copy+1;}assert copy==x+1;return x;}",0,"Verified roots: 1/1");
    ps_verify("fn branch(x){ghost let flag=0;proof {if x {flag=1;}else {flag=2;}}assert (x && flag==1) || (!x && flag==2);return x;}",0,"Verified roots: 1/1");
    ps_verify("requires n>=0 && n<10; fn loop(n){ghost let count=0;proof {invariant count>=0 && count<=n;decreases n-count;while count<n {count=count+1;}}assert count==n;return n;}",0,"Verified roots: 1/1");
    ps_verify("requires n>=0 && n<10; ensures result==n; fn loop(n){let i=0;ghost let count=0;invariant i>=0 && i<=n;invariant count==i;decreases n-i;while i<n {i=i+1;proof {count=count+1;}}assert count==n;return i;}",0,"Verified roots: 1/1");
    let p=ps_verify("fn block(){proof {let x=0;while x<1 {x=x+1;}}return 0;}",1,"loop termination requires decreases");
    t_assert(!h_has(h_out(p),"PROVED: partial correctness"),"unchecked proof termination allowed partial correctness");
    p=ps_verify("ensures 0;fn block(){proof {while 1 {}}return 0;}",1,"loop termination requires decreases");
    t_assert(!h_has(h_out(p),"PROVED: partial correctness"),"divergent erased code proved false runtime contract");
    p=ps_verify("ensures 0;fn caller(){return block();}ensures 0;fn block(){proof {while 1 {}}return 0;}",1,"unresolved dependency: block");
    t_assert(!h_has(h_out(p),"\nPROVED:"),"divergent erased callee code became a fact");
    ps_verify("fn arithmetic(){proof {let x=1/0;}return 0;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("fn arithmetic(){ghost let x=1/0;return 0;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("global g=0; reads nothing; fn frame(){ghost let x=g;return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("fn scopes(x){ghost let saved=x;{ghost let saved=7;assert saved==7;}assert saved==x;return x;}",0,"Verified roots: 1/1");
    ps_verify("fn scopes(x){proof {let copy=x;proof {let copy=5;assert copy==5;}assert copy==x;}return x;}",0,"Verified roots: 1/1");
    ps_verify("fn scopes(x){proof {let x=7;assert x==7;}return x;}",0,"Verified roots: 1/1");
    ps_bad("fn bad(){ghost let x=1;return x;}","ghost values cannot be used in executable expressions");
    ps_bad("fn bad(){ghost let x=1;if x {return 1;}return 0;}","ghost values cannot be used in executable expressions");
    ps_bad("fn bad(){ghost let x=1;while x {return 1;}return 0;}","ghost values cannot be used in executable expressions");
    ps_bad("global g=0; fn bad(){ghost let x=1;g=x;return 0;}","ghost values cannot be used in executable expressions");
    ps_bad("fn use(x){return x;} fn bad(){ghost let x=1;return use(x);}","ghost values cannot be used in executable expressions");
    ps_bad("fn bad(){ghost let x=1;let y=x;return y;}","ghost values cannot be used in executable expressions");
    ps_bad("fn bad(){ghost let x=1;x=2;return 0;}","ghost values cannot be used in executable expressions");
    ps_bad("fn bad(x){proof {x=0;}return x;}","proof code can assign only ghost variables");
    ps_bad("global g=0; fn bad(){proof {g=0;}return g;}","proof code can assign only ghost variables");
    ps_bad("fn bad(){let x=1;proof {x=0;}return x;}","proof code can assign only ghost variables");
    ps_bad("fn bad(){proof {return 1;}return 0;}","proof code cannot return from an executable function");
    ps_bad("fn bad(){proof {if 1 {return 1;}}return 0;}","proof code cannot return from an executable function");
    ps_bad("fn bad(){proof {store8(0,1);}return 0;}","proof expressions cannot modify or allocate memory");
    ps_verify("fn bad(){ghost let x=load8(0);return 0;}",1,"COUNTEREXAMPLE: memory read safety");
    ps_bad("fn effect(){return 0;} fn bad(){proof {effect();}return 0;}","specification calls require a supported spec function");
    ps_bad("fn bad(){proof {let x=0;}assert x==0;return 0;}","undefined name in verifier expression");
    ps_bad("fn bad(){ghost x=0;return 0;}","ghost must introduce a let declaration");
    ps_bad("fn bad(){proof let x=0;return 0;}","expected token");
    ps_bad("fn bad(){ghost let x=1;ghost let x=2;return 0;}","duplicate local");
    ps_verify("fn ghost(){return 1;} verify; fn main(){return ghost();}",0,"Verified roots: 1/1");
    ps_verify("fn proof(){return 1;} verify; fn main(){return proof();}",0,"Verified roots: 1/1");
    ps_verify("verify; fn main(){let ghost=1;let proof=2;return ghost+proof;}",0,"Verified roots: 1/1");
    let annotated="fn main(){ghost let saved=1;proof {let value=saved+1;assert value==2;proof {assert 0;}}return 42;}";
    t_native(annotated,42,"");h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let checksum=h_sha(t_binary);t_program("fn main(){return 42;}");t_compile();t_assert(h_equal(checksum,h_sha(t_binary)),"proof erasure changed native executable bytes");
    ps_verify(annotated,1,"COUNTEREXAMPLE: assertion");
    h_save(h_join(t_work,"ghost.flex"),"fn helper(x){ghost let before=x;proof {let after=before+1;assert after==x+1;}return x;}");
    ps_verify("import \"ghost.flex\";ensures result==x;fn caller(x){return helper(x);}",0,"Verified roots: 2/2");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
