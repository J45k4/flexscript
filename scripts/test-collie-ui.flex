global cu_state=0;global cu_binary=0;global cu_out=0;global cu_qemu=0;global cu_temp=0;global cu_packets=0;global cu_checks=0;
fn cu_pass(text){j_push(cu_checks,j_string(text));h_print(1,h_cat3("PASS ",text,"\n"));return 0;}
fn cu_run(args,request){let p=h_wait(h_spawn(args,j_dump(request),0));h_check(p,0,0);return c_json(h_out(p));}
fn cu_call(request){let result=cu_run(h_args(cu_binary,0,0,0,0,0),request);if cu_out{let android=cu_run(h_args(cu_qemu,h_join(cu_out,"ui-native-test"),"11",cu_temp,0,0),request);h_assert(jc_equal(android,result),"Linux/production Android UI state and patches differ");}return result;}
fn cu_step(action,data,extra){let request=j_object();j_set(request,"state",cu_state);j_set(request,"action",j_string(action));if data{j_set(request,"data",data);}if extra{let pairs=j_value(extra);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);j_set(request,load64(pair),load64(pair+8));i=i+1;}}let result=cu_call(request);h_assert(!cj_get(result,"error"),j_dump(result));cu_state=cj_get(result,"state");uw_apply(result);let packet=j_object();j_set(packet,"version",cj_get(result,"version"));j_set(packet,"ops",cj_get(result,"ops"));j_set(packet,"page",cj_get(cu_state,"page"));j_set(packet,"action",j_string(action));j_push(cu_packets,packet);return cj_get(result,"command");}
fn cu_update(data){return cu_step("update",data,0);}
fn cu_event(key,value,type){let node=uw_node(key);h_assert(cj_get(node,"action")&&cj_get(node,"action_id"),"Widget event has no actual rendered binding");let event=j_object();j_set(event,"key",j_string(key));j_set(event,"action",cj_get(node,"action"));j_set(event,"action_id",cj_get(node,"action_id"));if !value{value=j_node(0,0);}j_set(event,"value",value);j_set(event,"type",j_string(type));let extra=j_object();j_set(extra,"event",event);return cu_step("event",0,extra);}
fn cu_click(key){return cu_event(key,0,"click");}
fn cu_change(key,value){return cu_event(key,j_string(value),"change");}
fn cu_command(command,expected){h_assert(jc_equal(command,c_json(expected)),j_dump(command));return 0;}
fn cu_field(name,value){let data=j_object();j_set(data,name,value);return cu_update(data);}
fn main(argc,argv){
    h_environment(argc,argv);h_timeout=30000;let compiler=0;let i=1;while i<argc{let key=load64(argv+i*8);i=i+1;h_assert(i<argc,"UI test option needs a path");let value=load64(argv+i*8);if h_equal(key,"--compiler"){compiler=h_real(value);}else if h_equal(key,"--out"){cu_out=h_real(value);}else{h_die(h_cat("Unknown Collie UI option: ",key));}i=i+1;}h_assert(compiler,"Provide --compiler");cu_qemu=h_executable("qemu-aarch64-static");if syscall(21,cu_qemu,1,0,0,0,0)!=0{cu_qemu=h_executable("qemu-aarch64");}if cu_out{h_assert(syscall(21,cu_qemu,1,0,0,0,0)==0,"ARM64 QEMU is required with --out");}cu_temp=h_temp();cu_binary=h_join(cu_temp,"ui");h_compile(compiler,"apps/collie/tests/ui.flex",cu_binary);cu_state=j_object();cu_packets=j_array();cu_checks=j_array();uw_init();let fixtures=c_json(h_read("tests/tooling/collie-ui-fixtures.json"));let source="fn main(){return 42;}";
    cu_step("update",c_json("{\"model\":\"gpt-6.1-sol\",\"authenticated\":false}"),c_json("{\"reset\":true}"));h_assert(h_equal(uw_text("welcome-title"),"What are we\nworking on?")&&uw_has("welcome-connect"),"Welcome screen differs");cu_click("suggest-plan");h_assert(h_starts(cj_text(cu_state,"draft"),"Help me"),"Suggestion did not populate draft");cu_change("composer-draft","  calculate 6 * 7  ");cu_command(cu_click("composer-send"),"{\"kind\":\"submit\",\"text\":\"calculate 6 * 7\"}");h_assert(h_equal(cj_text(cu_state,"draft"),""),"Submit retained draft");cu_update(c_json("{\"busy\":true}"));h_assert(h_equal(cj_text(cu_click("composer-send"),"kind"),"cancel"),"Busy submit did not cancel");cu_click("chat-menu");h_assert(h_equal(cj_text(cu_state,"page"),"notice"),"Busy navigation policy bypassed");cu_click("notice-close");cu_update(c_json("{\"busy\":false}"));cu_pass("chat welcome, suggestions, drafts, submit, cancellation and busy navigation policy live in Flexscript");
    let data=c_json("{\"authenticated\":true,\"continuation\":true,\"used\":2200,\"total\":10000}");j_set(data,"cards",cj_get(fixtures,"cards"));cu_update(data);h_assert(h_equal(uw_text("chat-context"),"Context 2.2k / 10k"),"Context counter mismatch");h_assert(uw_has("chat-continue")&&!uw_has("card-1-source-body")&&!uw_has("card-2-result-stdout")&&!uw_has("card-1-source-toggle")&&h_equal(uw_text("card-thinking-0-title"),"Thinking"),"Tool groups did not start collapsed");cu_click("card-thinking-0-toggle");cu_click("card-1-source-toggle");h_assert(h_equal(uw_text("card-1-source-body"),source)&&h_equal(uw_text("card-1-source-numbers"),"1")&&h_equal(uw_text("card-1-source-lines"),"1 line")&&h_equal(uw_text("card-1-source-toggle"),"Hide program"),"Source formatting/folding differs");cu_command(cu_click("card-1-source-copy"),"{\"kind\":\"copy\",\"text\":\"fn main(){return 42;}\"}");cu_click("card-2-result-toggle");h_assert(h_equal(uw_text("card-2-result-stderr"),"real VM error")&&h_equal(uw_text("card-2-result-stdout"),"42"),"Real VM result was not displayed");let runs=c_json(cj_text(cj_get(uw_node("card-3-body"),"props"),"runs"));let bold=0;let link=0;i=0;while i<j_count(runs){let run=j_at(runs,i);if cj_int(run,"style")&1{bold=1;}if h_equal(cj_text(run,"href"),"https://example.com/"){link=1;}i=i+1;}h_assert(bold&&link,"Rich-text style/link information lost");cu_update(c_json("{\"stream\":\"Streaming **reply**\"}"));h_assert(h_equal(uw_text("chat-stream-body"),"Streaming **reply**")&&h_equal(cj_text(cu_click("chat-continue"),"kind"),"resume_main"),"Stream/resume state differs");cu_pass("shared message, stream, context, source/result folding, real error display, clipboard and rich text views");
