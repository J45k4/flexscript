    let abi=h_join(rr_work,"C-ABI");let abi_args=h_args("python3","tests/esp32/riscv-c-abi-reference.py","--compiler",rr_compiler,"--work",abi);h_add(abi_args,"--qemu");h_add(abi_args,rr_qemu);h_add(abi_args,"--clang");h_add(abi_args,b_option(argc,argv,"--clang","clang"));h_add(abi_args,"--ld");h_add(abi_args,b_option(argc,argv,"--ld","ld.lld"));h_add(abi_args,"--ar");h_add(abi_args,b_option(argc,argv,"--ar","llvm-ar"));if reference {h_add(abi_args,"--reference");h_add(abi_args,h_real(reference));}h_print(1,h_out(h_ok(rr_c6_args(abi_args))));rr_checks=rr_checks+1;
