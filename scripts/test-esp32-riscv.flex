// Compiler, ROM and frontend acceptance for direct C3/C6 RISC-V output.
// C6 execution is opt-in with its own official QEMU; default is package validation.
import "lib/build.flex";
global rr_compiler=0;
global rr_work=0;
global rr_qemu=0;
global rr_qemu_c6=0;
global rr_c6_uart_timeout=0;
global rr_c6_slowclk_store=0;
global rr_c6_boots=0;
global rr_cases=0;
global rr_id=0;
global rr_checks=0;
global rr_boots=0;
fn rr_c6_args(a) {if rr_qemu_c6 {h_add(a,"--execute-c6");h_add(a,"--qemu-c6");h_add(a,rr_qemu_c6);}return a;}
fn rr_c6_uart_args(a) {rr_c6_args(a);if rr_qemu_c6 {h_add(a,"--c6-uart-timeout");h_add(a,rr_c6_uart_timeout);}return a;}
fn rr_c6_osi_args(a) {rr_c6_args(a);if rr_qemu_c6 {h_add(a,"--c6-slowclk-store");h_add(a,rr_c6_slowclk_store);}return a;}
fn rr_assert(ok,message) {h_assert(ok,message);rr_checks=rr_checks+1;return 0;}
fn rr_args(source,target,path,language,frontend,platform) {
    let a=h_args(rr_compiler,"--target",target,0,0,0);if language {h_add(a,"--language");h_add(a,language);}if frontend {h_add(a,"--frontend");h_add(a,frontend);}if platform {h_add(a,"--platform");h_add(a,platform);}h_add(a,source);h_add(a,"-o");h_add(a,path);return a;
}
fn rr_case(name,source,trapped,language,frontend,platform,words,uart) {
    let id=rr_id;rr_id=rr_id+1;let chip=0;while chip<2 {
        let input=source;let target="esp32c3";if chip {target="esp32c6";if h_equal(name,"UART-GPIO") {input="tests/esp32/riscv-platform-c6.flex";}}let prefix=h_join(rr_work,h_cat3(h_int(id),"-",target));let image=h_cat(prefix,".bin");let elf=h_cat(prefix,".elf");
        let a=rr_args(input,target,image,language,frontend,platform);h_ok(a);let digest=h_sha(image);h_ok(a);rr_assert(h_equal(digest,h_sha(image)),"deterministic RISC-V firmware");
        h_ok(rr_args(input,h_cat(target,"-elf"),elf,language,frontend,platform));let report=h_cat(prefix,".json");let qemu=rr_qemu;if chip && rr_qemu_c6 {qemu=rr_qemu_c6;}a=h_args("python3","tests/esp32/riscv-rom-peer.py","--qemu",qemu,"--image",image);h_add(a,"--elf");h_add(a,elf);h_add(a,"--report");h_add(a,report);
        if chip && !rr_qemu_c6 {h_add(a,"--validate-only");}else {if trapped {h_add(a,"--trap");}if words {h_add(a,"--words");}if uart {h_add(a,"--uart");h_add(a,uart);}if chip {rr_c6_boots=rr_c6_boots+1;}else {rr_boots=rr_boots+1;}}
        h_print(1,h_out(h_ok(a)));rr_checks=rr_checks+1;let row=j_parse(h_read(report));j_set(row,"case",j_string(name));j_set(row,"source",j_string(h_absolute(input)));j_set(row,"elf_sha256",j_string(h_sha(elf)));j_push(rr_cases,row);chip=chip+1;
    }return 0;
}
fn rr_source(name,text,trapped) {let source=h_join(rr_work,h_cat(name,".flex"));h_save(source,text);return rr_case(name,source,trapped,0,0,0,0,0);}
fn rr_reject(name,text,message) {
    let source=h_join(rr_work,h_cat(name,".flex"));h_save(source,text);let targets=h_args("esp32c3","esp32c6","esp32c3-elf","esp32c6-elf",0,0);let i=0;while i<h_count(targets) {
        let path=h_join(rr_work,"rejected-output");h_save(path,"preserve existing firmware");let digest=h_sha(path);let result=h_run(rr_args(source,h_at(targets,i),path,0,0,0));h_check(result,1,0);rr_assert(h_has(h_err(result),message),h_err(result));rr_assert(h_equal(digest,h_sha(path)),"rejected compiler output preserved");i=i+1;
    }return 0;
}
fn rr_frontend(source) {
    let path=h_join(rr_work,"source-frontend.flex");let text=h_cat3("fn frontend_compile(text,size,version,path){let source=",j_dump(j_string(source)),";let n=");text=h_cat3(text,h_int(h_len(source)),";let p=alloc(64+n);store64(p,0x31585346);store64(p+8,64+n);store64(p+16,64);store64(p+24,n);let i=0;while i<n{store8(p+64+i,load8(source+i));i=i+1;}return p;}");h_save(path,text);return path;
}
