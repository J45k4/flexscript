// Real HCE/service/VM negative paths and labeled SDK fixtures; no RF claim.
import "lib/collie-android-test.flex";
global hc_polling=0;global hc_controls=0;
fn hc_sdk(flag){let flags=j_object();let mode="hardware_hce_tests";if cj_int(at_options,"controls"){mode="hardware_hce_control_tests";}j_set(flags,mode,j_bool(1));if flag{j_set(flags,flag,j_bool(1));}let r=at_sdk(ut_prefix,flags);h_assert(!at_bool(cj_get(r,"radio_exchange_verified"))&&!at_bool(cj_get(r,"routing_registration_verified")),"Constructed service fixtures cannot claim actual RF/routing registration");hc_polling=hc_polling||cj_int(r,"polling_binder_transport_verified");hc_controls=hc_controls||cj_int(r,"control_negative_paths_verified");return r;}
fn hc_cleanup(){if cj_int(at_options,"controls"){let result=cj_get(at_case(ut_prefix,c_json("{\"hardware_tests\":true,\"hardware_hce_control_tests\":true,\"hardware_hce_control_restore_tests\":true}")),"hardware");h_assert(result&&cj_int(result,"ok"),"HCE routing journal cleanup failed");}return 0;}
fn hc_label(argc,argv){let i=1;while i<argc{if h_equal(load64(argv+i*8),"--controls"){return "hce-controls";}i=i+1;}return "hce";}
fn main(argc,argv){
    at_foreground_marker="hce-fixture-foreground.json";at_cleanup_hook=1;if at_init(argc,argv,hc_label(argc,argv),c_json("{\"controls\":false}"))<0{return at_self_test();}
    if at_cleanup{return hc_cleanup();}if !at_child{return at_parent(argc,argv);}
    at_vm(h_cat(ut_prefix,"-deny"),"fn main(){if hce_info(){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"permission_denied\"){return 2;}return 0;}",c_json("{\"nfc\":false}"));at_pass("conversation NFC denial blocks HCE SDK access through the original VM tool");let name=at_conversation(ut_prefix,"fn main(){if !hce_info(){return 1;}return 0;}",c_json("{\"nfc\":\"ask\"}"));at_pending(ut_prefix,"nfc","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));let state=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));h_assert(at_bool(cj_get(cj_get(state,"permissions"),"nfc")),"HCE first-use approval did not persist NFC alone");at_pass("actual first-use NFC approval resumes HCE inventory without adding a model tool or unrelated grant");hc_sdk(0);
    let original=c_json(cj_text(at_recovery(),"session"));let pairs=j_value(cj_get(original,"permissions"));h_assert(h_count(pairs)>=31,"Missing actual permission schema");let denied=j_object();let i=0;while i<h_count(pairs){j_set(denied,load64(h_at(pairs,i)),j_bool(0));i=i+1;}j_set(denied,"approval_reviewer",j_string("user"));j_set(denied,"permission_profile",j_string("custom"));at_vm(h_cat(ut_prefix,"-caps"),"fn main(){let caps=hardware_capabilities();let i=0;let found=0;while i<db_count(caps){let c=db_at(caps,i);if worker_equal(db_word(device_field(c,\"id\")),\"nfc_hce_polling_frames\"){if !db_word(device_field(c,\"implemented\"))||!worker_equal(db_word(device_field(c,\"permission\")),\"nfc\")||db_word(device_field(c,\"maximum_frame_bytes\"))!=32768||!db_word(device_field(c,\"filter_registration_implemented\"))||!db_word(device_field(c,\"observe_control_implemented\")){return 1;}found=found+1;}i=i+1;}return found-1;}",denied);at_pass("polling capability discovery works with every conversation grant denied and identifies the implemented receiver and controls without claiming physical support");
    if cj_int(at_options,"controls"){hc_sdk("hardware_hce_control_orphan_tests");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");hc_sdk("hardware_hce_control_recovered_tests");}else{hc_sdk("hardware_hce_background_tests");let orphan=hc_sdk("hardware_hce_orphan_tests");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");hc_sdk("hardware_hce_recovered_tests");let source=h_cat3("fn main(){if hce_request(",j_dump(j_string(cj_text(orphan,"orphan_handle"))),"){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"stale_handle\"){return 2;}return 0;}");at_vm(ut_prefix,source,0);at_pass("actual process death invalidates the constructed live service handle while startup recovers component state");}
    let report=j_object();j_set(report,"ok",j_bool(1));j_set(report,"control_negative_paths_verified",j_bool(hc_controls));j_set(report,"control_sdk_success_verified",j_bool(0));j_set(report,"constructed_sdk_fixture",j_bool(1));j_set(report,"polling_binder_transport_verified",j_bool(hc_polling));j_set(report,"routing_registration_verified",j_bool(0));j_set(report,"radio_exchange_verified",j_bool(0));j_set(report,"physical_devices_verified",j_bool(0));return at_finish(report);
}
