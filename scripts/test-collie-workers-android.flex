// Real scheduler, independent worker tools and tap-to-view/resume/cancel UI.
import "lib/android-ui-test.flex";
global wr_source=0;
fn wr_program(name){return h_cat3(wr_source,"\nfn main(){return worker_live_",h_cat(name,"();}"));}
fn wr_event(event){j_set(cj_get(event,"response"),"usage",c_json("{\"input_tokens\":100,\"output_tokens\":20,\"total_tokens\":120}"));let output=cj_get(cj_get(event,"response"),"output");let i=0;while i<j_count(output){let item=j_at(output,i);if h_equal(cj_text(item,"type"),"custom_tool_call"){j_set(item,"status",j_string("completed"));}i=i+1;}return event;}
fn wr_events(program,key,answer,delay){let events=j_array();j_push(events,wr_event(at_tool_event(wr_program(program),key,delay)));j_push(events,wr_event(at_answer_event(answer,0)));return events;}
fn wr_last(result){let values=at_outputs(result);h_assert(j_count(values)>0,"Expected actual coordinator output");return j_at(values,j_count(values)-1);}
fn wr_pending(worker){let end=net_now()+12000;while net_now()<end{let s=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));if s&&cj_int(cj_get(s,"pending_execution"),"resume"){if !worker||ut_read(h_cat3("files/workspaces/",ut_prefix,h_cat3("/worker-",h_int(worker),".json"))){return s;}}h_sleep(100);}h_die("Coordinator did not save its durable continuation");return 0;}
fn wr_back(){ut_ok(ut_args("shell","input","keyevent","4",0,0),"");return 0;}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"workers",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}wr_source=h_read("apps/collie/tests/workers-live.flex");let workers=j_object();j_set(workers,"1",wr_events("reader","reader-code","Reader finished",5000));j_set(workers,"2",wr_events("calculator","calculator-code","Calculator got 42",0));let name=at_task(ut_prefix,"Use two workers and collect their results.",wr_events("source","coordinator","Both workers finished successfully.",0),workers);wr_pending(0);au_tap("View workers");au_tap_contains("content-desc","Reader · running");au_shot(ut_out,"worker-active");at_pass("active worker is inspectable while the coordinator is waiting");let r=at_result(name);let values=at_outputs(r);h_assert(j_count(values)==1,"Initial coordinator produced duplicate final results");let o=j_at(values,0);h_assert(h_equal(cj_text(o,"stdout"),"Reader finished | Calculator got 42")&&cj_int(o,"exit_code")==0&&h_equal(cj_text(j_at(cj_get(o,"views"),0),"text"),"preview survives await"),j_dump(o));let rows=cj_get(r,"workers");h_assert(j_count(rows)==2,"Expected exactly two independent workers");let i=0;while i<2{h_assert(h_equal(j_value(j_at(j_at(j_at(rows,i),1),2)),"done"),"Worker did not complete");i=i+1;}at_pass("real scheduler runs independent worker tool loops while coordinator VM awaits and resumes");
    wr_back();au_tap_contains("content-desc","Calculator · done");let xml=at_xml();h_assert(h_has(xml,"Calculator got 42")&&au_node(xml,"Expand thinking"),"Worker transcript or collapsed tools missing");au_tap("Expand thinking");xml=at_xml();h_assert(h_has(xml,"Show program")&&h_has(xml,"Show result"),"Worker source/result rows missing");au_shot(ut_out,"worker-detail");at_pass("tapping worker shows its real conversation with collapsed code and VM results");wr_back();wr_back();ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");o=at_vm(ut_prefix,wr_program("follow"),at_basic_grants());h_assert(h_equal(cj_text(o,"stdout"),"shared workspace"),j_dump(o));at_pass("restart preserves worker list, messages, typed state and shared files");
    workers=j_object();let replies=j_array();j_push(replies,wr_event(at_answer_event("Waiting worker finished",20000)));j_set(workers,"3",replies);name=at_task(ut_prefix,"Wait for another worker",wr_events("waitsource","waiting-main","Resumed successfully",0),workers);wr_pending(3);ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let resume=c_json("{\"resume_only\":true}");workers=j_object();replies=j_array();j_push(replies,wr_event(at_answer_event("Waiting worker finished",0)));j_set(workers,"3",replies);j_set(resume,"worker_responses",workers);at_case(ut_prefix,resume);h_sleep(1200);au_tap("View workers");au_tap_contains("content-desc","Waiting worker · paused");au_tap("Resume worker");let end=net_now()+12000;let done=0;while net_now()<end&&!done{done=h_has(at_xml(),"done");if !done{h_sleep(200);}}h_assert(done,"Worker did not resume through the real UI");wr_back();wr_back();h_assert(au_node(at_xml(),"Resume saved program"),"Saved main program resume control missing");at_pass("app restart pauses in-flight jobs; worker UI resumes a worker and offers the saved main program");resume=c_json("{\"resume_pending\":true,\"worker_responses\":{}}");replies=j_array();j_push(replies,wr_event(at_answer_event("unused",0)));j_push(replies,wr_event(at_answer_event("Resumed successfully",0)));j_set(resume,"responses",replies);r=at_case(ut_prefix,resume);o=wr_last(r);h_assert(h_equal(cj_text(o,"stdout"),"once\nresumed\n")&&cj_int(o,"exit_code")==0,j_dump(o));let messages=cj_get(r,"messages");let paired=0;i=0;while i<j_count(messages){let item=j_at(messages,i);if h_equal(cj_text(item,"type"),"custom_tool_call_output")&&h_equal(cj_text(item,"call_id"),"call_waiting-main"){paired=paired+1;}i=i+1;}h_assert(paired==1,"Saved main program produced duplicate tool results");at_pass("restored main VM continues with preserved locals, accumulated output and exactly one paired tool result");
    workers=j_object();replies=j_array();j_push(replies,wr_event(at_answer_event("This late answer must not win",20000)));j_set(workers,"4",replies);name=at_task(ut_prefix,"Start a cancellable worker",wr_events("stopsource","stop-main","Worker stopped",0),workers);wr_pending(0);au_tap("View workers");au_tap_contains("content-desc","Stop test · running");au_tap("Stop worker");r=at_result(name);o=wr_last(r);rows=cj_get(r,"workers");h_assert(h_equal(cj_text(o,"stdout"),"cancelled")&&h_equal(j_value(j_at(j_at(j_at(rows,j_count(rows)-1),1),2)),"cancelled"),j_dump(r));at_pass("Stop worker cancels only that job, unblocks await and retains cancelled status");wr_back();wr_back();au_tap("Menu");au_tap("Permissions");h_assert(h_has(at_xml(),"7 allowed · 24 ask · 0 denied"),"Shared Ask/Allow/Deny metadata summary differs");au_tap("Deny Internet access");h_assert(h_has(at_xml(),"6 allowed · 24 ask · 1 denied"),"Permission click did not persist");au_tap("Allow Internet access");at_pass("shared permission metadata renders shared Ask/Allow/Deny settings and saves changes");return at_finish(j_object());
}
