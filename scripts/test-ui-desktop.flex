// Render actual shared UI packets using SDL2/SDL2_ttf. --x11 must be run
// under an isolated display, e.g. xvfb-run -a; default uses SDL's dummy driver.
import "lib/build.flex";
import "../libs/image.flex";
fn ud_png(raw,path){
    let bytes=h_read(raw);h_assert(h_file_size==430*932*4,"Desktop RGBA dimensions differ");let colors=h_take(101*8);let distinct=0;let i=0;while i<430*932&&distinct<=100{let rgb=load8(bytes+i*4)*65536+load8(bytes+i*4+1)*256+load8(bytes+i*4+2);let found=0;let n=0;while n<distinct{if load64(colors+n*8)==rgb{found=1;}n=n+1;}if !found{store64(colors+distinct*8,rgb);distinct=distinct+1;}i=i+1;}h_assert(distinct>100,"Actual text/image pixels must be rendered");
    let context=image_context();let image=image_create(context,430,932,1);h_assert(image,image_error(context));h_copy(image_pixels(image),bytes,430*932*4);let png=image_encode_png(context,image);h_assert(png,image_error(context));h_save_bytes(path,image_blob_data(png),image_blob_size(png),384);image_blob_free(png);image_free(image);image_context_free(context);return 0;
}
fn ud_environment(driver){let environment=h_vec();let i=0;while load64(h_env+i*8){let entry=load64(h_env+i*8);if !h_starts(entry,"SDL_VIDEODRIVER=")&&!h_starts(entry,"FLEXSCRIPT_LIB="){h_add(environment,entry);}i=i+1;}h_add(environment,h_cat("SDL_VIDEODRIVER=",driver));h_add(environment,h_cat("FLEXSCRIPT_LIB=",h_real("libs")));h_env=environment+8;return 0;}
fn ud_count(output){let start=h_find(output,"PASS: ");h_assert(start>=0,"Native desktop fixture did not report assertions");let first=start+6;let end=first;while load8(output+end)>=48&&load8(output+end)<=57{end=end+1;}let n=h_number(h_slice(output+first,end-first));h_assert(n>0,"No desktop assertions executed");return n;}
fn ud_fixture(compiler,name,events,report){let binary=h_cat("build/test-ui-",name);h_compile(compiler,h_cat3("tests/ui/",name,".flex"),binary);let args=h_args(binary,events,report,0,0,0);let output=h_out(h_ok(args));h_print(1,output);return output;}
fn ud_median(values){let n=j_count(values);h_assert(n>0,"Empty selection timing sample");let sorted=h_take(n*8);let i=0;while i<n{let value=j_value(j_at(values,i));h_assert(value>=0,"Negative timing");let at=i;while at>0&&load64(sorted+(at-1)*8)>value{store64(sorted+at*8,load64(sorted+(at-1)*8));at=at-1;}store64(sorted+at*8,value);i=i+1;}if n%2{return j_int(load64(sorted+(n/2)*8));}let sum=load64(sorted+(n/2-1)*8)+load64(sorted+(n/2)*8);if sum%2{return j_node(6,h_cat(h_int(sum/2),".5"));}return j_int(sum/2);}
fn main(argc,argv){
    h_environment(argc,argv);h_timeout=120000;let compiler=0;let x11=0;let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--x11"){x11=1;}else{h_assert(h_equal(key,"--compiler"),"Unknown desktop UI option");i=i+1;h_assert(i<argc,"Provide compiler path");compiler=h_real(load64(argv+i*8));}i=i+1;}h_assert(compiler,"Provide --compiler");h_assert(h_exists("build/ui-portable-packets.json")&&h_exists("build/collie-ui-packets.json"),"Run test-ui and test-collie-ui first to generate actual compiler packets");if x11{h_assert(h_getenv("DISPLAY"),"--x11 requires an isolated DISPLAY, e.g. xvfb-run -a");}let driver="dummy";if x11{driver="x11";}ud_environment(driver);
    h_compile(compiler,"tests/ui/desktop.flex","build/test-ui-desktop");let args=h_args("cc","-shared","-fPIC","-O2","tests/ui/desktop-events.c","-o");h_add(args,"build/ui-desktop-events.so");h_add(args,"-ldl");h_ok(args);args=h_args("build/test-ui-desktop","build/ui-desktop-events.so",0,0,0,0);if x11{h_add(args,"--x11");}let output=h_out(h_ok(args));h_print(1,output);let count=ud_count(output);let names=h_args("collie","permissions","preview",0,0,0);let screens=j_array();i=0;while i<3{let stem=h_cat("build/ui-desktop-",h_at(names,i));let path=h_cat(stem,".png");ud_png(h_cat(stem,".rgba"),path);j_push(screens,j_string(path));i=i+1;}ud_environment("dummy");let text_count=ud_count(ud_fixture(compiler,"text-rendering",0,0));ud_fixture(compiler,"tables","build/ui-desktop-events.so",0);ud_fixture(compiler,"markdown-cache",0,0);ud_fixture(compiler,"scrolling","build/ui-desktop-events.so",0);ud_fixture(compiler,"selection-performance","build/ui-selection-performance.json",0);let selection=j_parse(h_read("build/ui-selection-performance.json"));let summary=j_object();j_set(summary,"hit_median_us",ud_median(j_get(selection,"hit_us")));j_set(summary,"drag_frame_median_us",ud_median(j_get(selection,"drag_frame_us")));j_set(summary,"warm_drag_layout_builds",j_get(selection,"warm_drag_layout_builds"));j_set(summary,"warm_drag_font_measurements",j_get(selection,"warm_drag_font_measurements"));j_set(summary,"warm_drag_retained_bytes",j_get(selection,"warm_drag_retained_bytes"));h_print(1,h_cat3("Selection performance: ",j_dump(summary),"\n"));ud_environment(driver);names=h_args("counter","permissions",0,0,0,0);i=0;while i<2{let name=h_at(names,i);let binary=h_cat("build/ui-desktop-",name);h_compile(compiler,h_cat3("examples/ui/desktop-",name,".flex"),binary);h_ok(h_args(binary,"2",0,0,0,0));i=i+1;}let report=j_object();j_set(report,"checks",j_int(count));j_set(report,"selection_performance",summary);j_set(report,"text_raster_checks",j_int(text_count));j_set(report,"text_density_tests",j_string("simulated 1x and 2x framebuffers"));j_set(report,"backend",j_string("native SDL2 canvas, SDL2_ttf and Flexscript image codecs"));j_set(report,"x11_mapped_windows_and_real_input",j_bool(x11));j_set(report,"same_android_browser_patches",j_bool(1));j_set(report,"screenshots",screens);j_save("build/ui-desktop-report.json",report);h_print(1,"PASS shared counter and live Collie permissions examples; rendered screenshots verified\n");return 0;
}
