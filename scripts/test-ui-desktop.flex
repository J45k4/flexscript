// Render actual shared UI packets using SDL2/SDL2_ttf. --x11 must be run
// under an isolated display, e.g. xvfb-run -a; default uses SDL's dummy driver.
import "lib/build.flex";
fn ud_png(raw,path){
    let bytes=h_read(raw);h_assert(h_file_size==430*932*4,"Desktop RGBA dimensions differ");let colors=h_take(101*8);let distinct=0;let i=0;while i<430*932&&distinct<=100{let rgb=load8(bytes+i*4)*65536+load8(bytes+i*4+1)*256+load8(bytes+i*4+2);let found=0;let n=0;while n<distinct{if load64(colors+n*8)==rgb{found=1;}n=n+1;}if !found{store64(colors+distinct*8,rgb);distinct=distinct+1;}i=i+1;}h_assert(distinct>100,"Actual text/image pixels must be rendered");
    let lib=ffi_open("libgdk_pixbuf-2.0.so.0");let objects=ffi_open("libgobject-2.0.so.0");h_assert(lib&&objects,"Desktop screenshot check needs system GdkPixbuf");let image=ffi_call(ffi_symbol(lib,"gdk_pixbuf_new"),0,1,8,430,932,0);h_assert(image,"Cannot allocate screenshot pixels");let pixels=ffi_call(ffi_symbol(lib,"gdk_pixbuf_get_pixels"),image,0,0,0,0,0);let stride=ffi_call_i32(ffi_symbol(lib,"gdk_pixbuf_get_rowstride"),image,0,0,0,0,0);h_assert(pixels&&stride>=430*4,"Invalid screenshot decoder stride");i=0;while i<932{h_copy(pixels+i*stride,bytes+i*430*4,430*4);i=i+1;}h_assert(ffi_call_i32(ffi_symbol(lib,"gdk_pixbuf_savev"),image,path,"png",0,0,0),"Cannot encode desktop PNG screenshot");ffi_call(ffi_symbol(objects,"g_object_unref"),image,0,0,0,0,0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_timeout=120000;let compiler=0;let x11=0;let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--x11"){x11=1;}else{h_assert(h_equal(key,"--compiler"),"Unknown desktop UI option");i=i+1;h_assert(i<argc,"Provide compiler path");compiler=h_real(load64(argv+i*8));}i=i+1;}h_assert(compiler,"Provide --compiler");h_assert(h_exists("build/ui-portable-packets.json")&&h_exists("build/collie-ui-packets.json"),"Run test-ui and test-collie-ui first to generate actual compiler packets");if x11{h_assert(h_getenv("DISPLAY"),"--x11 requires an isolated DISPLAY, e.g. xvfb-run -a");}let environment=h_vec();i=0;while load64(h_env+i*8){let entry=load64(h_env+i*8);if !h_starts(entry,"SDL_VIDEODRIVER="){h_add(environment,entry);}i=i+1;}let driver="dummy";if x11{driver="x11";}h_add(environment,h_cat("SDL_VIDEODRIVER=",driver));h_env=environment+8;
    h_compile(compiler,"tests/ui/desktop.flex","build/test-ui-desktop");let args=h_args("cc","-shared","-fPIC","-O2","tests/ui/desktop-events.c","-o");h_add(args,"build/ui-desktop-events.so");h_add(args,"-ldl");h_ok(args);args=h_args("build/test-ui-desktop","build/ui-desktop-events.so",0,0,0,0);if x11{h_add(args,"--x11");}let output=h_out(h_ok(args));h_print(1,output);let start=h_find(output,"PASS: ");h_assert(start>=0,"Native desktop fixture did not report assertions");let digits=start+6;let end=digits;while load8(output+end)>=48&&load8(output+end)<=57{end=end+1;}let count=h_number(h_slice(output+digits,end-digits));h_assert(count>0,"No desktop render checks executed");let names=h_args("collie","permissions","preview",0,0,0);let screens=j_array();i=0;while i<3{let stem=h_cat("build/ui-desktop-",h_at(names,i));let path=h_cat(stem,".png");ud_png(h_cat(stem,".rgba"),path);j_push(screens,j_string(path));i=i+1;}names=h_args("counter","permissions",0,0,0,0);i=0;while i<2{let name=h_at(names,i);let binary=h_cat("build/ui-desktop-",name);h_compile(compiler,h_cat3("examples/ui/desktop-",name,".flex"),binary);h_ok(h_args(binary,"2",0,0,0,0));i=i+1;}let report=j_object();j_set(report,"checks",j_int(count));j_set(report,"backend",j_string("native SDL2 canvas, SDL2_ttf and system image decoder"));j_set(report,"x11_mapped_windows_and_real_input",j_bool(x11));j_set(report,"same_android_browser_patches",j_bool(1));j_set(report,"screenshots",screens);j_save("build/ui-desktop-report.json",report);h_print(1,"PASS shared counter and live Collie permissions examples; rendered screenshots verified\n");return 0;
}
