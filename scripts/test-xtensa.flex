// Native Xtensa interpreter against GNU encodings and identical QEMU firmware.
import "lib/esp32-test.flex";
import "lib/esp32-elf.flex";
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);h_assert(compiler,"requires --compiler PATH");te_init(compiler);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));let assembler=h_real(h_executable(b_option(argc,argv,"--as","xtensa-esp32-elf-as")));let objcopy=h_real(h_executable(b_option(argc,argv,"--objcopy","xtensa-esp32-elf-objcopy")));
 let work=b_option(argc,argv,"--work",0);if work{h_mkdir(work);h_remove(te_work);te_work=h_real(work);}let object=h_join(te_work,"instructions.o");let raw=h_join(te_work,"instructions.bin");h_ok(h_args(assembler,"tests/xtensa/instructions.S","-o",object,0,0));h_ok(h_args(objcopy,"-O","binary","--only-section=.text",object,raw));let native=h_join(te_work,"cpu-test");h_compile(te_compiler,"tests/xtensa/cpu.flex",native);let cpu_result=h_run(h_args(native,raw,0,0,0,0));h_check(cpu_result,0,0);h_print(1,h_out(cpu_result));
 let runner=h_join(te_work,"firmware-run");h_compile(te_compiler,"tests/xtensa/firmware-run.flex",runner);let cases=j_array();let chip=0;while chip<2{te_legacy=!chip;let target="esp32-elf";if chip{target="esp32s3-elf";}let test=0;while test<2{let fixture="tests/esp32/emulator-words.flex";if test{fixture="tests/esp32/emulator-irq.flex";if chip{fixture="tests/esp32/emulator-irq-s3.flex";}}let name=h_cat3(target,"-",h_int(test));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target",target,fixture,"-o",path));let result=h_run(h_args(runner,path,0,0,0,0));h_check(result,0,0);h_print(1,h_out(result));let bytes=h_read(path);let elf=ee_open(bytes,h_file_size);let rom=ee_rom_image(elf);let image=h_join(te_work,h_cat(name,".bin"));h_save_bytes(image,rom,h_file_size,420);let serial=te_run(image,0,0);h_save(h_join(te_work,h_cat(name,".qemu.log")),serial);let row=j_object();j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"interpreter",j_string(h_out(result)));j_set(row,"qemu_rom_boot",j_bool(1));j_push(cases,row);test=test+1;}chip=chip+1;}
 let board_runner=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",board_runner);let devices=j_array();let i=0;while i<7{let fixture="tests/esp32/runtime.flex";let target="esp32s3-elf";te_legacy=0;if i==1{fixture="tests/esp32/legacy-interrupts.flex";target="esp32-elf";te_legacy=1;}if i==2{fixture="tests/esp32/interrupts.flex";}if i==3{fixture="tests/esp32/emulator-uart-tail.flex";target="esp32-elf";te_legacy=1;}if i==4{fixture="tests/esp32/emulator-uart-tail-s3.flex";}if i==5{fixture="tests/esp32/emulator-uart-loopback.flex";target="esp32-elf";te_legacy=1;}if i==6{fixture="tests/esp32/emulator-uart-loopback-s3.flex";}let name=h_cat("devices-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target",target,fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let result=h_run(h_args(board_runner,path,trace,0,0,0));h_check(result,0,0);h_print(1,h_out(result));let bytes=h_read(path);let elf=ee_open(bytes,h_file_size);let rom=ee_rom_image(elf);let image=h_join(te_work,h_cat(name,".bin"));h_save_bytes(image,rom,h_file_size,420);let serial=0;if i>=5{te_image(image);let peer=h_join(te_work,h_cat(name,"-peer"));let peer_report=h_cat(peer,".json");let chip="esp32s3";if te_legacy{chip="esp32";}let args=h_args("python3","tests/xtensa/uart-peer.py","--qemu",te_qemu,"--image",image);h_add(args,"--chip");h_add(args,chip);h_add(args,"--work");h_add(args,peer);h_add(args,"--report");h_add(args,peer_report);h_ok(args);serial=h_read(h_join(peer,"uart0.log"));te_runs=te_runs+1;}else{serial=te_run(image,0,0);}let emitted=h_read(trace);te_assert(h_len(emitted)>0 && h_has(serial,emitted),"identical emitted UART transcript in QEMU");h_save(h_join(te_work,h_cat(name,".qemu.log")),serial);let row=j_object();j_set(row,"fixture",j_string(fixture));if i>=5{j_set(row,"qemu_uart1_transport",j_string("external character-backend echo; QEMU does not model internal loopback"));}j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"interpreter",j_string(h_out(result)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"uart_matches_qemu",j_bool(1));j_push(devices,row);i=i+1;}
 let gpio_cases=j_array();i=0;while i<3{let fixture="tests/esp32/gpio-pulls-physical.flex";let target="esp32-elf";if i==1{fixture="tests/esp32/emulator-gpio-rtc.flex";}if i==2{fixture="tests/esp32/emulator-gpio-rtc-s3.flex";target="esp32s3-elf";}let name=h_cat("gpio-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target",target,fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let args=h_args(board_runner,path,trace,0,0,0);if i{h_add(args,"21");h_add(args,"19");}let result=h_run(args);h_check(result,0,0);let text=h_read(trace);if i{te_assert(h_has(text,"PASS: GPIO wire IRQ, RTC ownership and hold"),"native GPIO/RTC fixture");}else{te_assert(h_has(text,"PEER PASS"),"unchanged GPIO pull driver fixture");}h_print(1,h_out(result));let row=j_object();j_set(row,"fixture",j_string(fixture));j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"qemu_verified",j_bool(0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"interpreter",j_string(h_out(result)));j_push(gpio_cases,row);i=i+1;}
 let spi_cases=j_array();let spi_full=b_option(argc,argv,"--spi-full",0);i=0;while i<5{if i || spi_full{let fixture="tests/esp32/spi-peer-physical.flex";let target="esp32-radio-elf";if i==1{fixture="tests/esp32/emulator-spi.flex";target="esp32-elf";}if i==2{fixture="tests/esp32/emulator-spi-s3.flex";target="esp32s3-elf";}if i==3{fixture="tests/esp32/emulator-spi-phases.flex";target="esp32-elf";}if i==4{fixture="tests/esp32/emulator-spi-phases-s3.flex";target="esp32s3-elf";}let name=h_cat("spi-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target",target,fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let args=h_args(board_runner,path,trace,"21","19",0);if !i{h_add(args,"--fuel");h_add(args,"2000000000");}let timeout=h_timeout;if !i{h_timeout=600000;}let result=h_run(args);h_timeout=timeout;h_check(result,0,0);let text=h_read(trace);if i>=3{te_assert(h_has(text,"PASS: SPI phase/reset probe,128 completion callbacks"),"native SPI phase/reset fixture");}else if i{te_assert(h_has(text,"PASS: SPI2/3 modes, FIFO chunks, TX/RX and8 native WAITI completion callbacks"),"native SPI drivers and completion callbacks");}else{te_assert(h_has(text,"PEER PASS"),"unchanged176-case SPI matrix fixture");}h_print(1,h_out(result));let row=j_object();j_set(row,"fixture",j_string(fixture));j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"qemu_verified",j_bool(0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"interpreter",j_string(h_out(result)));j_push(spi_cases,row);}i=i+1;}
 let rmt_cases=j_array();let rmt_full=b_option(argc,argv,"--rmt-full",0);i=0;while i<5{if !i || rmt_full{let fixture="tests/esp32/emulator-rmt.flex";let marker="PASS: RMT8 channels,16 native WAITI completion callbacks";if i==1{fixture="tests/esp32/rmt-peer-physical.flex";marker="PEER PASS";}if i==2{fixture="tests/esp32/rmt-blocks-physical.flex";marker="PASS: RMT block capture,36 reservations";}if i==3{fixture="tests/esp32/spi-waveform-physical.flex";marker="PASS: SPI waveform capture";}if i==4{fixture="tests/esp32/spi-completion-physical.flex";marker="PASS: SPI waveform capture";}let name=h_cat("rmt-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));let target="esp32-elf";if i==2{target="esp32-radio-elf";}h_ok(h_args(te_compiler,"--target",target,fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let pin="19";if i>=2{pin="25";}let args=h_args(board_runner,path,trace,"21",pin,"--fuel");h_add(args,"2000000000");let timeout=h_timeout;if i{h_timeout=600000;}let result=h_run(args);h_timeout=timeout;h_check(result,0,0);let text=h_read(trace);te_assert(h_has(text,marker),"native RMT firmware completion");h_print(1,h_out(result));let row=j_object();j_set(row,"fixture",j_string(fixture));j_set(row,"target",j_string(target));j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"qemu_verified",j_bool(0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"interpreter",j_string(h_out(result)));j_push(rmt_cases,row);}i=i+1;}
 let i2c_cases=j_array();let i2c_full=b_option(argc,argv,"--i2c-full",0);i=0;while i<3{if !i || i2c_full{let fixture="tests/esp32/emulator-i2c.flex";let marker="PASS: I2C0/1 open-bus FIFO reads,12 native WAITI completion callbacks";if i==1{fixture="tests/esp32/i2c-peer-physical.flex";marker="PEER PASS";}if i==2{fixture="tests/esp32/bus-fifo-pulls-physical.flex";marker="PEER PASS";}let name=h_cat("i2c-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target","esp32-elf",fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let args=h_args(board_runner,path,trace,0,0,0);if i==1{h_add(args,"21");h_add(args,"19");}h_add(args,"--fuel");h_add(args,"2000000000");let timeout=h_timeout;if i{h_timeout=600000;}let result=h_run(args);h_timeout=timeout;h_check(result,0,0);te_assert(h_has(h_read(trace),marker),"native I2C firmware completion");h_print(1,h_out(result));let row=j_object();j_set(row,"fixture",j_string(fixture));j_set(row,"target",j_string("esp32-elf"));j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"qemu_verified",j_bool(0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"interpreter",j_string(h_out(result)));j_push(i2c_cases,row);}i=i+1;}
 let i2s_cases=j_array();let i2s_full=b_option(argc,argv,"--i2s-full",0);i=0;while i<2{if !i || i2s_full{let fixture="tests/esp32/emulator-i2s-irq.flex";let marker="PASS: I2S0/1,16 native WAITI completion pairs";if i{fixture="tests/esp32/emulator-i2s.flex";marker="PASS: I2S0/1 DMA,64 exact PCM exchanges,16/32-bit";}let name=h_cat("i2s-",h_int(i));let path=h_join(te_work,h_cat(name,".elf"));h_ok(h_args(te_compiler,"--target","esp32-elf",fixture,"-o",path));let trace=h_join(te_work,h_cat(name,".uart"));let args=h_args(board_runner,path,trace,"21","25","--fuel");h_add(args,"2000000000");let timeout=h_timeout;if i{h_timeout=600000;}let result=h_run(args);h_timeout=timeout;h_check(result,0,0);te_assert(h_has(h_read(trace),marker),"native I2S firmware completion");h_print(1,h_out(result));let row=j_object();j_set(row,"fixture",j_string(fixture));j_set(row,"target",j_string("esp32-elf"));j_set(row,"elf",j_string(path));j_set(row,"sha256",j_string(h_sha(path)));j_set(row,"uart_sha256",j_string(h_sha(trace)));j_set(row,"qemu_verified",j_bool(0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"rom_initialization_executed",j_bool(0));j_set(row,"clock_profile",j_string("explicit80MHz CPU/APB and PLL_D2=160MHz; not a ROM boot"));j_set(row,"interpreter",j_string(h_out(result)));j_push(i2s_cases,row);}i=i+1;}
 let report=b_option(argc,argv,"--report",0);if report{let r=j_object();j_set(r,"cases",cases);j_set(r,"device_cases",devices);j_set(r,"gpio_native_cases",gpio_cases);j_set(r,"spi_native_cases",spi_cases);j_set(r,"rmt_native_cases",rmt_cases);j_set(r,"i2c_native_cases",i2c_cases);j_set(r,"i2s_native_cases",i2s_cases);j_set(r,"i2s_full_requested",j_bool(i2s_full!=0));j_set(r,"i2c_full_requested",j_bool(i2c_full!=0));j_set(r,"rmt_full_requested",j_bool(rmt_full!=0));j_set(r,"spi_full_requested",j_bool(spi_full!=0));j_set(r,"cpu_result",j_string(h_out(cpu_result)));j_set(r,"gnu_text_sha256",j_string(h_sha(raw)));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_set(r,"qemu_checks",j_int(te_checks));j_set(r,"qemu_boots",j_int(te_runs));j_set(r,"physical_hardware",j_bool(0));j_set(r,"peripherals",j_string("CPU-only harness acknowledges startup watchdog writes. Device harness models UART FIFOs, GPIO/RTC, timer groups SPI master FIFO transactions and command/address/dummy phases, and original I2C master/slave GPIO wire engines and original I2S mapped-SRAM DMA/Philips GPIO audio in an explicit PLL clock profile; unsupported modes and full peripheral parity remain T223."));j_save(report,r);}h_print(1,"PASS: GNU CPU checks and 4 CPU and 7 device firmware/QEMU comparisons, plus3 native GPIO,4 SPI callback/phase fixtures and native RMT/I2C/I2S IRQ callbacks (optional --spi-full yes, --rmt-full yes --i2c-full yes and --i2s-full yes add long probes)\n");if !work{h_remove(te_work);}return 0;
}
