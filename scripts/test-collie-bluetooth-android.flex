// Actual Classic SDK inventory, distinct consent paths and bounded inquiry.
import "lib/android-radio-test.flex";
global bc_source=0;
fn bc_program(call){return h_cat3(bc_source,"\nfn main(){return bluetooth_live_",h_cat(call,"();}"));}
fn bc_model(suffix,call,policy){return at_conversation(h_cat(ut_prefix,suffix),bc_program(call),policy);}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"bluetooth",j_object())<0{return at_self_test();}if at_cleanup{return ar_restore();}if !at_child{at_extra=ar_snapshot(1,0);return at_parent(argc,argv);}
    bc_source=h_read("apps/collie/tests/bluetooth-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ar_set_bluetooth(1);ar_set_location("true");let permissions=h_args("android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_ADVERTISE","android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION",0);let i=h_count(permissions);while i>0{i=i-1;ar_revoke(h_at(permissions,i));}
    let sid=h_cat(ut_prefix,"-deny");let name=bc_model("-deny","denied",c_json("{\"bluetooth\":true}"));at_pending(sid,"bluetooth","platform_permission",name);at_click("resource-id","permission_deny_button",1);at_observation(at_result(name));let s=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));h_assert(!at_bool(cj_get(cj_get(s,"permissions"),"bluetooth")),"Android Nearby denial was not remembered");at_pass("denying Android Nearby consent returns permission_denied to the original VM and remembers only the Bluetooth denial");i=0;while i<3{ar_clear(h_at(permissions,i));i=i+1;}
    sid=h_cat(ut_prefix,"-allow");name=bc_model("-allow","info",c_json("{\"db_read\":true,\"db_write\":true}"));at_pending(sid,"bluetooth","permission",name);at_click("text","Allow requested access",0);at_pending(sid,"bluetooth","platform_permission",name);at_click("resource-id","permission_allow_button",1);at_observation(at_result(name));h_assert(!cj_int(cj_get(at_flags(at_package()),"android.permission.ACCESS_FINE_LOCATION"),"granted"),"Bluetooth inventory requested Android Location");at_pass("Bluetooth inventory asks lazily for Collie and actual Android Nearby consent without asking for Location");
    ar_set_bluetooth(0);name=bc_model("-allow","enable",0);at_pending(sid,"bluetooth","platform_permission",name);at_click("text","Allow",0);at_observation(at_result(name));h_assert(ar_bluetooth(),"System enable confirmation did not turn on the actual adapter");at_pass("radio enable yields outside the VM lock for Android-owned confirmation and resumes with the actual enabled adapter");
    name=bc_model("-allow","scan",0);at_pending(sid,"location","permission",name);at_click("text","Allow requested access",0);let end=net_now()+60000;let done=0;let seen=j_object();while !done&&net_now()<end{done=ut_read(h_cat3("files/test/",name,".result.json"));if !done{s=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));if h_equal(cj_text(s,"phase"),"platform_permission"){let signal=cj_get(cj_get(s,"pending_execution"),"signal");let signature=j_dump(signal);if !cj_get(seen,signature){j_set(seen,signature,j_bool(1));let key=cj_text(signal,"key");h_assert(h_equal(key,"location")||h_equal(key,"bluetooth"),"Classic inquiry requested unrelated permission");let location=h_equal(key,"location");let requested=cj_get(cj_get(signal,"request"),"permissions");let p=0;if requested{while p<j_count(requested){let permission=j_value(j_at(requested,p));if h_equal(permission,"android.permission.ACCESS_FINE_LOCATION")||h_equal(permission,"android.permission.ACCESS_COARSE_LOCATION"){location=1;}else{h_assert(h_equal(permission,"android.permission.BLUETOOTH_SCAN")||h_equal(permission,"android.permission.BLUETOOTH_CONNECT")||h_equal(permission,"android.permission.BLUETOOTH_ADVERTISE"),"Classic inquiry requested an unrelated Android permission");}p=p+1;}}j_save(h_join(ut_out,h_cat3("bluetooth-runtime-",h_int(j_count(seen)),".json")),signal);let button="permission_allow_button";if location{button="permission_allow_foreground_only_button";}at_click("resource-id",button,1);}}h_sleep(50);}}h_assert(done,"Actual Classic inquiry consent deadline");at_observation(at_result(name));at_vm(sid,bc_program("scan_wait"),0);at_pass("Classic discovery separately asks for Location, starts the actual Android inquiry and returns a bounded snapshot after its deadline");
    at_sdk(sid,c_json("{\"hardware_bluetooth_tests\":true}"));at_vm(h_cat(ut_prefix,"-deny-location"),bc_program("location_denied"),c_json("{\"bluetooth\":true,\"location\":false}"));at_pass("Bluetooth alone cannot bypass the independent Location grant for inquiry results");let report=j_object();j_set(report,"peer_payload_verified",j_bool(0));return at_finish(report);
}
