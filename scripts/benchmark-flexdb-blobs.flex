// Native single-file external blob compression/storage benchmark.
import "../libs/db/flexdb.flex";
import "lib/host.flex";
global clock=0;
fn now(){syscall(228,1,clock,0,0,0,0);return load64(clock)*1000000000+load64(clock+8);}
fn ms(ns){let f=h_int(ns/1000%1000);while h_len(f)<3 {f=h_cat("0",f);}return h_cat3(h_int(ns/1000000),".",f);}
fn payload(n,random){let p=h_take(n+1);let pattern="{\"timestamp\":1700000000000,\"device\":\"bus-0000\",\"level\":\"info\",\"message\":\"engine telemetry ok\",\"reading\":12.34,\"seq\":\"00000000\"}\n";let width=fd_len(pattern);let i=0;let x=123456789;while i<n {let b=load8(pattern+i%width);if random {x=(x^(x<<13))&4294967295;x=x^(x>>17);x=(x^(x<<5))&4294967295;b=x&255;}store8(p+i,b);i=i+1;}if !random {let row=0;let hex="0123456789abcdef";while (row+1)*width<=n {let at=(row+1)*width-11;let j=0;while j<8 {store8(p+at+j,load8(hex+((row>>((7-j)*4))&15)));j=j+1;}row=row+1;}}return p;}
fn find(p,n,key){let i=0;let k=fd_len(key);while i<=n-k {if fd_bytes(p+i,key,k) {return i;}i=i+1;}h_assert(0,"sample field");return 0;}
fn varied(n){let p=payload(n,0);let width=0;while load8(p+width)!=10 {width=width+1;}width=width+1;let ts=find(p,width,"1700000000000")+7;let device=find(p,width,"bus-0000")+4;let seq=width-11;let reading=find(p,width,"12.34");let hex="0123456789abcdef";let x=987654321;let row=0;while (row+1)*width<=n {let base=p+row*width;let j=0;while j<22 {x=(x^(x<<13))&4294967295;x=x^(x>>17);x=(x^(x<<5))&4294967295;let at=ts+j;let c=48+x%10;if j>=6 && j<10 {at=device+j-6;}if j>=10 && j<18 {at=seq+j-10;c=load8(hex+(x&15));}if j>=18 {at=reading+j-18;if j>=20 {at=at+1;}if j==18 {c=49+x%9;}}store8(base+at,c);j=j+1;}row=row+1;}return p;}
fn size(path){let st=h_take(144);h_assert(syscall(4,path,st,0,0,0,0)==0,"stat");return load64(st+48);}
fn run(work,label,p,n,level){let path=h_join(work,h_cat3(label,"-",h_cat(h_int(level),".db")));let db=open_flexdb(path);h_assert(db && flexdb_blob_options(db,4096,level) && flexdb_begin(db),"begin");let schema=flexdb_schema(db);flexdb_column(db,schema,"number",1,0);flexdb_column(db,schema,"data",3,0);let t=flexdb_create(db,"segments",schema);let q=flexdb_query(db);let values=flexdb_values(q);flexdb_add(q,values,flexdb_int(q,1));flexdb_add(q,values,flexdb_blob(q,p,n));let start=now();h_assert(flexdb_insert(t,values) && flexdb_commit(db),"blob commit");let insert=now()-start;flexdb_query_close(q);let v=flexdb_cell(flexdb_get(t,1),1);let stored=flexdb_blob_stored_bytes(v);let codec=flexdb_blob_codec(v);h_assert(stored<=n,"never expand payload");h_assert(close_flexdb(db),"close");start=now();db=open_flexdb(path);h_assert(db,"reopen");t=flexdb_table(db,"segments");v=flexdb_cell(flexdb_get(t,1),1);let opened=now()-start;let out=h_take(65536);start=now();let at=0;while at<n {let take=n-at;if take>65536 {take=65536;}h_assert(flexdb_blob_read(v,at,out,take)==take && fd_bytes(out,p+at,take),"range checksum");at=at+take;}let read=now()-start;h_assert(close_flexdb(db),"range connection close");db=open_flexdb(path);h_assert(db,"stream reopen");t=flexdb_table(db,"segments");v=flexdb_cell(flexdb_get(t,1),1);start=now();let reader=flexdb_blob_reader(v);h_assert(reader,"stream reader");at=0;while at<n {let got=flexdb_blob_reader_read(reader,out,65536);h_assert(got>0 && fd_bytes(out,p+at,got),"stream checksum");at=at+got;}h_assert(flexdb_blob_reader_read(reader,out,65536)==0 && flexdb_blob_reader_close(reader),"stream EOF/close");let streamed=now()-start;let before=size(path);h_assert(flexdb_begin(db),"metadata begin");let edit=flexdb_values(db);flexdb_add(db,edit,flexdb_int(db,2));flexdb_add(db,edit,v);h_assert(flexdb_update(t,1,edit) && flexdb_commit(db) && flexdb_checkpoint(db),"metadata/checkpoint");let growth=size(path)-before;h_assert(growth<2048,"no payload duplication on metadata/checkpoint");start=now();h_assert(flexdb_compact(db),"compact");let compact=now()-start;h_assert(close_flexdb(db),"finish");let final=size(path);let ratio=h_cat3(h_int(n/stored),".",h_int((n%stored)*100/stored));if (n%stored)*100/stored<10 {ratio=h_cat3(h_int(n/stored),".0",h_int((n%stored)*100/stored));}let name="raw";if codec {name="zstd";}h_print(1,h_cat3("| ",label,h_cat3(" | ",h_int(level)," | ")));h_print(1,h_cat3(h_int(n)," | ",h_cat3(h_int(stored)," | ",h_cat3(ratio,"x | ",h_cat3(name," | ",h_cat3(h_int(final)," | ",h_cat3(ms(insert)," | ",h_cat3(ms(opened)," | ",h_cat3(ms(read)," | ",h_cat3(ms(streamed)," | ",h_cat3(h_int(growth)," | ",h_cat(ms(compact)," |\n"))))))))))));return 1;}
fn main(argc,argv){h_environment(argc,argv);clock=h_take(16);h_assert(fd_zstd_init(),"libzstd required for compression benchmark");let work=h_temp();h_print(1,h_cat3("# FlexDB external blob benchmark\n\nArtifacts: `",work,"`\n\n"));h_print(1,"Native Flexscript; 4 MiB synthetic variable-sequence log records and deterministic high-entropy bytes. One measured sample per level, not a throughput ranking. Commit includes compression, extent writes and fsync; input construction excluded. Read validates the full blob using successive 64 KiB range requests; each compressed range request currently decodes from frame start. Stream-all uses a fresh connection, validates the stored CRC, and keeps one incremental decoder with a 64 KiB caller buffer. OS file cache remains warm; output byte validation is included. Compressed data is preserved through checkpoints/compaction.\n\n| Payload | Level | Logical bytes | Stored bytes | Ratio | Codec | Compacted file bytes | Commit ms | Reopen+row ms | All ranges ms | Stream all ms | Metadata+checkpoint growth bytes | Compact ms |\n| --- | ---: | ---: | ---: | ---: | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n");let n=4194304;let logs=payload(n,0);run(work,"logs",logs,n,1);run(work,"logs",logs,n,6);run(work,"logs",logs,n,9);run(work,"logs",logs,n,14);let mixed=varied(n);run(work,"varied-logs",mixed,n,1);run(work,"varied-logs",mixed,n,6);run(work,"varied-logs",mixed,n,9);run(work,"varied-logs",mixed,n,14);let noise=payload(n,1);run(work,"random",noise,n,1);run(work,"random",noise,n,9);let bound=ffi_call(fd_z_bound,n,0,0,0,0,0);let packed=h_take(bound);let compressed=ffi_call(fd_z_compress,packed,bound,logs,n,14,0);h_assert(!ffi_call(fd_z_error,compressed,0,0,0,0,0),"precompressed source");run(work,"already-zstd14",packed,compressed,9);h_print(1,"\nRatios describe these synthetic inputs, not production logs. Compression depends on source redundancy. Random input must fall back to raw; library size and temporary compaction/pinned-inode space are excluded from final file bytes.\n");return 0;}
