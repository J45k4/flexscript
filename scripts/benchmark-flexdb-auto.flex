import "lib/json.flex";
fn pin() {let mask=h_zero(h_take(128),128);let bytes=syscall(204,0,128,mask,0,0,0);h_assert(bytes>0,"CPU affinity");let cpu=0;while cpu<bytes*8 && !(load8(mask+cpu/8)&(1<<(cpu%8))) {cpu=cpu+1;}h_assert(cpu<bytes*8,"allowed CPU");h_zero(mask,128);store8(mask+cpu/8,1<<(cpu%8));h_assert(syscall(203,0,128,mask,0,0,0)==0,"pin CPU");return cpu;}
fn median(samples,key,runs) {let numbers=h_vec();let i=1;while i<=runs {h_add(numbers,j_n(j_at(samples,i),key));i=i+1;}i=1;while i<runs {let j=i;while j>0 && h_at(numbers,j)<h_at(numbers,j-1) {let a=h_at(numbers,j);let b=h_at(numbers,j-1);store64(numbers+8+j*8,b);store64(numbers+j*8,a);j=j-1;}i=i+1;}return h_at(numbers,runs/2);}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc>=2 && argc<=5,"compiler [rows=100000] [odd runs=5] [report.json]");let compiler=h_real(load64(argv+8));let rows=100000;let runs=5;if argc>2 {rows=h_number(load64(argv+16));}if argc>3 {runs=h_number(load64(argv+24));}h_assert(rows>=1000 && rows<=100000 && runs>=3 && runs<=15 && runs%2,"bounds");let cpu=pin();let work=h_temp();let flex=h_join(work,"flexdb");let sqlite=h_join(work,"sqlite");h_compile(compiler,"scripts/bench-flexdb-auto-worker.flex",flex);h_ok(h_args("cc","-O3","scripts/bench-flexdb-auto-sqlite.c","-o",sqlite,"-lsqlite3"));
 let data=j_object();j_set(data,"flexdb",j_array());j_set(data,"sqlite",j_array());let round=0;while round<=runs {let slot=0;while slot<2 {let mode=(round+slot)%2;let name="flexdb";let executable=flex;if mode {name="sqlite";executable=sqlite;}let path=h_join(work,h_cat3(name,h_int(round),".db"));j_push(j_get(data,name),j_parse(h_out(h_ok(h_args(executable,path,h_int(rows),0,0,0)))));slot=slot+1;}h_print(1,h_cat3("Completed adaptive round ",h_int(round),"\n"));round=round+1;}
 let keys=h_args("scan_100_ns","learn_build_ns","indexed_100000_ns","reopen_first_lookup_ns",0,0);h_add(keys,"indexed_update_1000_ns");h_add(keys,"checkpoint_close_ns");h_add(keys,"bytes");h_add(keys,"peak_kib");let medians=j_object();let mode=0;while mode<2 {let name="flexdb";if mode {name="sqlite";}let values=j_object();let i=0;while i<h_count(keys) {let key=h_at(keys,i);j_set(values,key,j_int(median(j_get(data,name),key,runs)));i=i+1;}j_set(medians,name,values);h_print(1,h_cat3(name," ",h_cat(j_dump(values),"\n")));mode=mode+1;}
 let report=j_object();j_set(report,"cpu",j_int(cpu));j_set(report,"rows",j_int(rows));j_set(report,"runs",j_int(runs));j_set(report,"medians",medians);j_set(report,"samples_including_warmup",data);j_set(report,"work_directory",j_string(work));j_set(report,"sqlite_version",j_string(h_out(h_ok(h_args("sqlite3","--version",0,0,0,0)))));j_set(report,"method",j_string("One pinned CPU, alternating order, excluded warmup, five-run default medians. Unique i64 secondary keys, 100 scans and 100000 indexed count lookups with varied keys, verified sums. FlexDB learns/builds automatically; SQLite explicitly creates B-tree index. Learning includes FlexDB's preliminary scans; SQLite build includes durable CREATE INDEX. Native Flexscript vs C -O3 prepared SQLite NOMUTEX, WAL FULL, 64MiB cache, one read transaction for repeated SQL. 1000 indexed-field updates in one durable transaction; FlexDB explicit checkpoint+close vs SQLite close/WAL checkpoint. Final file sizes include FlexDB history, not compacted; whole-process peak RSS includes harness memory. Warm OS cache reopen+first indexed lookup. RAM hash vs on-disk B-tree; different cache layout and persistence costs; no broad parity claim."));let path=h_join(work,"report.json");if argc>4 {path=load64(argv+32);}j_save(path,report);h_print(1,h_cat3("Report: ",path,"\n"));return 0;
}
