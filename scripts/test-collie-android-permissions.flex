// Real permission switches, per-conversation isolation and actual VM enforcement.
import "lib/android-ui-test.flex";
fn pe_page(){au_tap("Menu");au_tap("Permissions");let xml=at_xml();h_assert(au_node(xml,"Permissions")&&!au_node(xml,"Message Collie"),"Permissions did not open as its own shared screen");return 0;}
fn pe_policy(session,enabled){let policy=cj_get(ut_read(h_cat3("files/workspaces/",session,"/session.json")),"permissions");let expected=at_basic_grants();let pairs=j_value(expected);let i=0;while i<h_count(pairs){let key=load64(h_at(pairs,i));h_assert(at_bool(cj_get(policy,key))==enabled,"Saved basic grant differs from the actual UI selection");i=i+1;}return 0;}
fn pe_vm(source){return at_vm(ut_prefix,source,at_basic_grants());}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"permissions",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}let labels=c_json("{\"internet\":\"Internet access\",\"files_read\":\"Read workspace files\",\"files_write\":\"Write workspace files\",\"db_read\":\"Read database\",\"db_write\":\"Write database\",\"history\":\"Read past messages\",\"workers\":\"Manage workers\"}");pe_vm("fn main(){fs_write(\"note.txt\",db_text(\"private\"));db_begin();let s=db_schema();db_column(s,\"value\",2,0);db_create(\"notes\",s);let v=db_values();db_add(v,db_text(\"persistent\"));db_insert(\"notes\",v);return db_commit()-1;}");pe_policy(ut_prefix,1);pe_page();let directory=h_join(ut_out,"permissions");au_shot(directory,"all-enabled");at_pass("Dedicated permission page lists conversation grants with explicit legacy grants enabled");let pairs=j_value(labels);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);au_permission(ut_prefix,load64(pair),j_value(load64(pair+8)),0);i=i+1;}pe_policy(ut_prefix,0);at_pass("All seven settings persist their settings immediately");
    let probes=c_json("{\"internet\":\"http_get(\\\"https://example.com/\\\")\",\"files_read\":\"fs_read(\\\"note.txt\\\",0,100)\",\"files_write\":\"fs_write(\\\"note.txt\\\",db_text(\\\"forbidden\\\"))\",\"db_read\":\"db_tables()\",\"db_write\":\"db_begin()\",\"history\":\"db_history(0,10)\"}");let tests=j_value(probes);i=0;while i<h_count(tests){let pair=h_at(tests,i);let key=load64(pair);let source=h_cat3("fn main(){",j_value(load64(pair+8)),";let e=db_error();syscall(1,1,e,db_len(e),0,0,0);return 0;}");let o=pe_vm(source);h_assert(h_equal(cj_text(o,"stdout"),h_cat("Permission denied: ",key)),j_dump(o));i=i+1;}h_assert(h_equal(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",h_cat3("files/workspaces/",ut_prefix,"/files/note.txt"),0),"")),"private"),"Denied write changed the existing file");at_pass("Real device VM denies every disabled capability and preserves existing files");
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ut_ok(ut_args("shell","am","start","-n","org.flexscript.collie/.MainActivity",0),"");pe_policy(ut_prefix,0);pe_page();au_find("0 allowed · 24 ask · 7 denied");ut_ok(ut_args("shell","input","keyevent","KEYCODE_BACK",0,0),"");au_find("Message Collie");pe_page();au_tap("Back to conversation");au_find("Message Collie");at_pass("Grants survive process restart; header Back and Android Back return to chat");let other=h_cat(ut_prefix,"-other");at_vm(other,"fn main(){return 0;}",at_basic_grants());pe_policy(other,1);at_case(ut_prefix,c_json("{\"resume_only\":true}"));pe_policy(ut_prefix,0);at_pass("Permissions belong to their conversation and do not affect another session");pe_page();au_permission(ut_prefix,"files_read","Read workspace files",1);au_permission(ut_prefix,"db_read","Read database",1);au_tap("Back to conversation");let o=pe_vm("fn main(){let v=fs_read(\"note.txt\",0,100);syscall(1,1,db_word(v),db_bytes(v),0,0,0);return 0;}");h_assert(h_equal(cj_text(o,"stdout"),"private"),j_dump(o));o=pe_vm("fn main(){let v=db_cell(db_at(db_scan(\"notes\",0,10),0),0);syscall(1,1,db_word(v),db_bytes(v),0,0,0);return 0;}");h_assert(h_equal(cj_text(o,"stdout"),"persistent"),j_dump(o));o=pe_vm("fn main(){db_begin();let e=db_error();syscall(1,1,e,db_len(e),0,0,0);return 0;}");h_assert(h_equal(cj_text(o,"stdout"),"Permission denied: db_write"),j_dump(o));at_pass("Read-only files and database work while write permissions remain disabled");pe_page();au_permission(ut_prefix,"internet","Internet access",1);au_tap("Back to conversation");o=pe_vm("fn main(){let r=http_get(\"https://example.com/\");if !r{return 1;}let b=http_body(r);syscall(1,1,db_word(b),db_bytes(b),0,0,0);if http_status(r)!=200{return 2;}return 0;}");h_assert(h_has(cj_text(o,"stdout"),"Example Domain"),j_dump(o));at_pass("Re-enabling internet in the UI permits a genuine HTTPS fetch");return at_finish(j_object());
}
