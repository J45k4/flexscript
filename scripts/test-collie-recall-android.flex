// Actual cross-chat recall, history gates and collapsed retrieval UI after restart.
import "lib/android-ui-test.flex";
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"recall",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}let old=h_cat(ut_prefix,"-a");let current=h_cat(ut_prefix,"-b");let needle=h_cat(ut_prefix,"-fact");let fact=h_cat3("My keyboard preference for ",needle," is Moonlander.");let events=j_array();j_push(events,at_answer_event("Understood.",0));at_result(at_task(old,fact,events,0));let path=h_cat3("files/workspaces/",old,"/session.json");let raw=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),""));let original=h_sha_bytes(raw,h_len(raw));ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let source=h_cat3("fn main(){let cursor=\"\";let after=0;let page=0;let i=0;while i<100{page=memory_search(",j_dump(j_string(needle)),",cursor,after,10);if !page{return 1;}let rows=db_at(page,0);if db_count(rows){let row=db_at(rows,0);let value=memory_read(db_word(db_at(row,0)),db_word(db_at(row,1)),\"content\",0,16384);if !value{return 2;}db_io(0,1,db_word(value),db_bytes(value));return 0;}cursor=db_word(db_at(page,1));after=db_word(db_at(page,2));if !db_len(cursor){return 3;}i=i+1;}return 4;}");events=j_array();j_push(events,at_tool_event(source,"remember",0));j_push(events,at_answer_event("Earlier you said your keyboard preference is Moonlander.",0));let r=at_result(at_task(current,"What keyboard did I mention earlier?",events,0));let outputs=at_outputs(r);h_assert(j_count(outputs)==1&&cj_int(j_at(outputs,0),"exit_code")==0&&h_equal(cj_text(j_at(outputs,0),"stdout"),fact),j_dump(outputs));let after=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),""));h_assert(h_equal(h_sha_bytes(after,h_len(after)),original),"Recall changed the source conversation bytes");at_pass("a new conversation retrieves a fact from another saved chat after app restart without altering it");let xml=at_xml();h_assert(h_has(xml,"Earlier you said your keyboard preference is Moonlander.")&&au_node(xml,"Expand thinking"),"Actual recalled answer or collapsed retrieval UI missing");au_shot(ut_out,"recall-chat");at_pass("the remembered answer is visible in chat with the real retrieval result collapsed by default");
    let saved=c_json(raw);j_set(cj_get(saved,"permissions"),"history",j_bool(0));at_write(path,j_dump(saved));source=h_cat3("fn main(){let v=memory_read(",j_dump(j_string(old)),",1,\"content\",0,100);if v{return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}");let o=at_vm(current,source,at_basic_grants());h_assert(h_has(cj_text(o,"stdout"),"unavailable"),"Source history opt-out did not exclude its messages");at_pass("turning off history for the source conversation excludes its saved messages from recall");path=h_cat3("files/workspaces/",current,"/session.json");saved=ut_read(path);j_set(cj_get(saved,"permissions"),"history",j_bool(0));at_write(path,j_dump(saved));source=h_cat3("fn main(){let v=memory_search(",j_dump(j_string(needle)),",\"\",0,10);if v{return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}");o=at_vm(current,source,at_basic_grants());h_assert(h_equal(cj_text(o,"stdout"),"Permission denied: history"),"Caller history switch did not block cross-chat search");at_pass("the current conversation history switch also blocks cross-chat searching");return at_finish(j_object());
}
