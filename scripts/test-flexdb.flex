import "lib/harness.flex";
fn db_compile_reject(body,message) {
    let text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\n"));t_program(h_cat(text,body));let before=h_sha(t_binary);let result=h_run(h_args(t_compiler,t_fixture,"-o",t_binary,0,0));h_check(result,1,0);t_assert(h_has(h_err(result),message),h_err(result));t_assert(t_location(h_err(result)),"compiler query diagnostic location");t_assert(h_equal(before,h_sha(t_binary)),"rejected query preserves executable");return 0;
}
fn db_schema_reject(body,message) {
    let text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/schema.flex"),"\";\n"));t_program(h_cat(text,body));let before=h_sha(t_binary);let result=h_run(h_args(t_compiler,t_fixture,"-o",t_binary,0,0));h_check(result,1,0);t_assert(h_has(h_err(result),message),h_err(result));t_assert(t_location(h_err(result)),"schema diagnostic location");t_assert(h_equal(before,h_sha(t_binary)),"bad schema preserves executable");return 0;
}
