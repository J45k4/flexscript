    h_compile(t_compiler,"libs/db/tests/replay-index.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"replay-index.db"),0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/transactions.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"transactions.db"),0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/native-scan.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"native-scan.db"),0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/native-pack.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"native-pack.db"),0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    db_compile_reject("global changed=0;fn predicate(row){changed=1;return 1;}fn main(){return 0;}","must not mutate");
    db_compile_reject("fn helper(row){store64(row,5);return 1;}fn predicate(row){return helper(row);}fn main(){return 0;}","must not mutate");
    db_compile_reject("fn helper(row){return helper(row);}fn predicate(row){return helper(row);}fn main(){return 0;}","recursive predicate");
    db_compile_reject("fn predicate(){return 1;}fn main(){return 0;}","predicate takes a row");
    db_compile_reject("fn predicate(row){return 1;}fn predicate_count(table){return 5;}fn main(){return 0;}","name already exists");
    let extension=h_join(t_work,"replace-reader.flex");h_save(extension,h_cat3("import \"",h_real("compiler/transform-sdk.flex"),"\";fn transform_program(context,version){ext_init(context,version);ext_replace_function(ext_find_function(\"flexdb_rowid\"),\"fn flexdb_rowid(row){return load64(row)+1;}\");return ext_finish();}"));
    let text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",extension,"\";\n"));text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\nfn predicate(row,id){return flexdb_rowid(row)==id;}fn main(){return predicate_plan();}"));t_native(text,0,"");
    text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\nfn predicate(row){return flexdb_rowid(row)==\"pointer\";}fn main(){return predicate_plan();}"));t_native(text,0,"");
    let replacements=h_args("fn flexdb_word(v){return load64(v+8)+1;}","fn flexdb_cell(row,column){return load64(row+16+(column+1)*8);}","fn fd_same(a,b){return 1;}","fn fd_len(s){return 0;}","fn fd_bytes(a,b,n){return 1;}",0);let names=h_args("flexdb_word","flexdb_cell","fd_same","fd_len","fd_bytes",0);let ri=0;
    while ri<h_count(replacements) {let replacement=h_at(replacements,ri);let reader=h_at(names,ri);let source=h_cat3("import \"",h_real("compiler/transform-sdk.flex"),"\";fn transform_program(context,version){ext_init(context,version);ext_replace_function(ext_find_function(\"");source=h_cat(source,h_cat3(reader,"\"),\"",replacement));source=h_cat(source,"\");return ext_finish();}");h_save(extension,source);
        text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",extension,"\";\n"));text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\n"));let body="fn predicate(row,key){return flexdb_word(flexdb_cell(row,0))==key;}";if ri>=2 {body="fn predicate(row,key){return fd_same(flexdb_word(flexdb_cell(row,0)),key);}";}text=h_cat(text,h_cat(body,"fn main(){return predicate_plan();}"));t_native(text,0,"");ri=ri+1;
    }
    // Reader simplification must respect earlier user extension edits, also
    // when the reader is reached through schema getters and aliases.
    let checks=h_args("fn flexdb_word(v){return load64(v+8)+1;}","fn flexdb_cell(row,column){if column<0 || column+1>=load64(row+8){return 0;}return load64(row+16+(column+1)*8);}",0,0,0,0);ri=0;
    while ri<2 {let reader="flexdb_word";let expected=6;if ri {reader="flexdb_cell";expected=9;}h_save(extension,h_cat3("import \"",h_real("compiler/transform-sdk.flex"),h_cat3("\";fn transform_program(context,version){ext_init(context,version);ext_replace_function(ext_find_function(\"",reader,h_cat3("\"),\"",h_at(checks,ri),"\");return ext_finish();}"))));
        text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/schema.flex"),"\";\n"));text=h_cat(text,h_cat3("extend \"",extension,"\";\n"));text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\ndatabase D {table T {key:i64;other:i64;}}fn alias(row){return T_key(row);}fn predicate(row,key){return alias(row)==key;}fn main(){let a=alloc(32);let v=flexdb_values(a);flexdb_add(a,v,flexdb_int(a,5));flexdb_add(a,v,flexdb_int(a,9));let row=fd_row(a,1,v);return predicate_plan()==0 && T_key(row)=="));text=h_cat(text,h_cat3(h_int(expected)," && alias(row)==",h_cat(h_int(expected),";}")));t_native(text,1,"");ri=ri+1;
    }
    let inspect=h_join(t_work,"inspect-readers.flex");let inspection=h_cat3("import \"",h_real("compiler/transform-sdk.flex"),"\";fn same(f,s){let p=ext_function_source(f);let n=ext_function_size(f);if n!=ext_len(s){return 0;}let i=0;while i<n{if load8(p+i)!=load8(s+i){return 0;}i=i+1;}return 1;}fn transform_program(context,version){ext_init(context,version);if !same(ext_find_function(\"uncertain\"),\"fn uncertain(row){spin(row);return T_key(row);}\") || !same(ext_find_function(\"extra\"),\"fn extra(row){let unused=T_other(row);return T_key(row);}\"){ext_error(\"reader optimization dropped an unproven call or an extra field check\");}return ext_finish();}");h_save(inspect,inspection);
    text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/schema.flex"),"\";\n"));text=h_cat(text,h_cat3("extend \"",h_real("libs/db/compile.flex"),"\" with \"predicate\";\n"));text=h_cat(text,h_cat3("extend \"",inspect,"\";\n"));text=h_cat(text,"global reader_effects=0;database D {table T {key:i64;other:i64;}}fn spin(row){return spin(row);}fn uncertain(row){spin(row);return T_key(row);}fn extra(row){let unused=T_other(row);return T_key(row);}fn effect(row){reader_effects=reader_effects+1;return 0;}fn observed(row){effect(row);return T_key(row);}fn predicate(row,key){return T_key(row)==key;}fn main(){let a=alloc(32);let v=flexdb_values(a);flexdb_add(a,v,flexdb_int(a,5));flexdb_add(a,v,flexdb_int(a,9));let row=fd_row(a,1,v);return extra(row)==5 && observed(row)==5 && reader_effects==1 && predicate_plan()==2;}");t_native(text,1,"");
    h_compile(t_compiler,"libs/db/examples/schema.flex",t_binary);path=h_join(t_work,"schema-example.db");h_check(h_run(h_args(t_binary,path,0,0,0,0)),0,"Puppy\nAda\n");h_check(h_run(h_args(t_binary,path,0,0,0,0)),0,"Puppy\nAda\n");t_checks=t_checks+2;
    h_compile(t_compiler,"libs/db/tests/schema.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"schema.db"),h_join(t_work,"schema-mismatch.db"),0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/checkpoint.flex",t_binary);p=h_check(h_run(h_args(t_binary,t_work,0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/optimized.flex",t_binary);p=h_check(h_run(h_args(t_binary,h_join(t_work,"optimized.db"),0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/fastpaths.flex",t_binary);p=h_check(h_run(h_args(t_binary,t_work,0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    h_compile(t_compiler,"libs/db/tests/reconcile.flex",t_binary);p=h_check(h_run(h_args(t_binary,t_work,0,0,0,0)),0,0);h_print(1,h_out(p));t_checks=t_checks+1;
    db_schema_reject("database App { table Person { name: text; drop name; } } fn main(){return 0;}","cannot drop a declared field");
    db_schema_reject("database App { table Person { age: i64 = null; } } fn main(){return 0;}","null default requires nullable");
    db_schema_reject("database App { table Person { age: i64 = ; } } fn main(){return 0;}","expected default expression");
    db_schema_reject("database App { table Person { id: rowid = 1; name: text; } } fn main(){return 0;}","rowid cannot have reconciliation rules");
    db_schema_reject("database App { table Person { name: nope; } } fn main(){return 0;}","expected rowid, i64");
    db_schema_reject("database App { table Person { id: rowid?; name: text; } } fn main(){return 0;}","rowid must be non-null");
    db_schema_reject("database App { table Person { id: rowid; other: rowid; name: text; } } fn main(){return 0;}","declared only once");
    db_schema_reject("database App { table Person { name: text; name: i64; } } fn main(){return 0;}","duplicate field");
    db_schema_reject("database App { table Person { age: i64; age_column: i64; } } fn main(){return 0;}","duplicate generated name");
    db_schema_reject("database App { table Person { id: rowid; } } fn main(){return 0;}","at least one stored column");
    db_schema_reject("database App { table Person { name: text; }", "expected table declaration");
    let schema_import=h_join(t_work,"schema-import.flex");h_save(schema_import,"database One { table Imported { n: i64; } } database Two { table Other { value: text; } }");let schema_before=h_sha(schema_import);
    text=h_cat3("import \"",h_real("libs/db/flexdb.flex"),"\";\nimport \"schema-import.flex\";\n");text=h_cat(text,h_cat3("extend \"",h_real("libs/db/schema.flex"),"\";\nfn database(){return 42;}fn main(){return database()+Imported_n_column()+Other_value_column();}"));t_native(text,42,"");t_assert(h_equal(schema_before,h_sha(schema_import)),"imported schemas are transformed without modifying source");return t_done();
