// Independent Android package/permission oracle for the real guest API.
import "lib/collie-android-test.flex";
global ha_source=0;
fn ha_split(text,delimiter){let values=h_vec();let from=0;let i=0;while 1{let c=load8(text+i);if !c||c==delimiter{h_add(values,h_slice(text+from,i-from));from=i+1;if !c{return values;}}i=i+1;}return values;}
fn ha_word(text,key){let at=h_find(text,key);if at<0{return 0;}at=at+h_len(key);let end=at;while load8(text+end)&&load8(text+end)>32{end=end+1;}return h_slice(text+at,end-at);}
fn ha_protection(text){let bits=c_json("{\"normal\":0,\"dangerous\":1,\"signature\":2,\"signatureOrSystem\":3,\"internal\":4,\"privileged\":16,\"development\":32,\"appop\":64,\"pre23\":128,\"installer\":256,\"verifier\":512,\"preinstalled\":1024,\"setup\":2048,\"instant\":4096,\"runtime\":8192,\"oem\":16384,\"vendorPrivileged\":32768,\"textClassifier\":65536,\"configurator\":524288,\"incidentReportApprover\":1048576,\"appPredictor\":2097152,\"companion\":8388608,\"retailDemo\":16777216,\"recents\":33554432,\"role\":67108864,\"knownSigner\":134217728,\"module\":1073741824}");let names=ha_split(text,124);let value=0;let i=0;while i<h_count(names){let bit=cj_get(bits,h_at(names,i));h_assert(bit,h_cat("Unknown actual Android protection bit: ",h_at(names,i)));value=value|j_value(bit);i=i+1;}return value;}
fn ha_vm(session,body,policy){return at_vm(session,h_cat3(ha_source,"\n",body),policy);}
fn ha_snapshot(session,policy){return cj_text(ha_vm(session,"fn main(){return access_snapshot();}",policy),"stdout");}
fn main(argc,argv){
    if at_init(argc,argv,"hardware-access",j_object())<0{return at_self_test();}
    if !at_child{return at_parent(argc,argv);}
    ha_source=h_read("apps/collie/tests/hardware-access-live.flex");let denied=j_object();let original=c_json(cj_text(at_recovery(),"session"));let keys=j_value(cj_get(original,"permissions"));h_assert(h_count(keys)>=31,"Missing original permission schema");let i=0;while i<h_count(keys){j_set(denied,load64(h_at(keys,i)),j_bool(0));i=i+1;}
    let actual=ha_snapshot(ut_prefix,denied);let package=at_package();let definitions=h_out(ut_ok(ut_args("shell","dumpsys","package","permissions",0,0),""));let sdk=h_number(h_trim(h_out(ut_ok(ut_args("shell","getprop","ro.build.version.sdk",0,0,0),""))));let uid=h_number(h_trim(h_out(ut_ok(ut_args("shell","run-as","org.flexscript.collie","id","-u",0),""))));let target=h_number(ha_word(package,"targetSdk="));let lines=at_lines(package);let flags=0;i=0;while i<h_count(lines)&&!flags{let line=h_trim(h_at(lines,i));if h_starts(line,"flags=["){flags=line;}i=i+1;}h_assert(flags,"No actual Android app flags");let rows=at_lines(actual);h_assert(h_count(rows)==18,"Expected17 distinct restricted permission rows");let header=ha_split(h_at(rows,0),124);h_assert(h_count(header)==7,"Malformed access metadata header");let expected=h_args(h_int(sdk),h_int(target),h_int(uid),h_int(h_has(flags," SYSTEM ")),h_int(h_has(flags," UPDATED_SYSTEM_APP ")),h_int(h_has(flags," DEBUGGABLE ")));i=0;while i<6{h_assert(h_equal(h_at(header,i),h_at(expected,i)),h_cat("Access header differs from independent OS observations: ",h_at(rows,0)));i=i+1;}at_pass("SDK, target SDK, actual app UID and all three package flags match independent Android shell/package observations");
    let seen=j_object();i=1;while i<h_count(rows){let fields=ha_split(h_at(rows,i),124);h_assert(h_count(fields)==6,"Malformed restricted-permission row");let name=h_at(fields,0);h_assert(!cj_get(seen,name),"Duplicate OS permission fact");j_set(seen,name,j_bool(1));let marker=h_cat3("\n  Permission [",name,"]");let begin=h_find(definitions,marker);h_assert(h_number(h_at(fields,1))==(begin>=0),"Permission defined state differs from Android");if begin>=0{let section=definitions+begin+h_len(marker);let end=h_find(section,"\n  Permission [");if end>=0{section=h_slice(section,end);}let prot=ha_word(section,"prot=");h_assert(prot&&h_number(h_at(fields,4))==ha_protection(prot),h_cat("OS protection bitmask differs: ",name));}else{h_assert(h_equal(h_at(fields,4),"null"),"Undefined OS protection level must be typed null");}h_assert(h_equal(h_at(fields,2),"0")&&h_equal(h_at(fields,3),"0"),"Test APK requests/holds a restricted permission");let package_lines=at_lines(package);let n=0;while n<h_count(package_lines){let line=h_trim(h_at(package_lines,n));h_assert(!h_equal(line,name)&&!h_starts(line,h_cat(name,":")),h_cat("Restricted permission unexpectedly requested: ",name));n=n+1;}i=i+1;}
    at_pass("all17 OS permission definitions and complete protection bitmasks match independent PackageManager dumps; undefined definitions remain typed null");at_pass("the installed app requests and holds none of the17 restricted permissions");
    let source=h_cat3("fn main(){let report=hardware_restrictions();if !report{return 1;}if db_word(device_field(device_field(report,\"platform\"),\"uid\"))!=",h_int(uid),"{return 2;}let rows=device_field(report,\"restrictions\");let i=0;while i<db_count(rows){let r=db_at(rows,i);if db_word(device_field(r,\"implemented\"))||db_kind(device_field(r,\"supported\"))!=0||db_word(device_field(r,\"available\"))||!db_word(device_field(r,\"discovery_implemented\")){return 3;}if !worker_equal(db_word(device_field(r,\"code\")),\"adapter_unimplemented\")||!worker_equal(db_word(device_field(r,\"requires\")),\"privileged_or_vendor_integration\"){return 4;}field(r,\"id\");field(r,\"alternative\");s(\"\\n\");i=i+1;}return 0;}");let descriptions=cj_text(ha_vm(ut_prefix,source,0),"stdout");let restrictions=at_lines(descriptions);h_assert(h_count(restrictions)==16,"Expected16 restrictions");let ids=c_json("[\"wifi_monitor\",\"wifi_frame_injection\",\"cellular_raw_radio\",\"cellular_radio_control\",\"usb_gadget\",\"bluetooth_raw_hci\",\"internal_i2c\",\"internal_spi\",\"internal_gpio\",\"cpu_clock_control\",\"gpu_clock_control\",\"charging_control\",\"global_routing_control\",\"raw_input_injection\",\"raw_device_nodes\",\"vendor_hardware_services\"]");seen=j_object();i=0;while i<16{let field=ha_split(h_at(restrictions,i),124);h_assert(h_count(field)==3&&!cj_get(seen,h_at(field,0)),"Malformed/duplicate restriction ID");j_set(seen,h_at(field,0),j_bool(1));i=i+1;}i=0;while i<16{h_assert(cj_get(seen,j_value(j_at(ids,i))),"Missing privileged adapter description");i=i+1;}at_pass("all16 privileged/vendor descriptions return through the actual VM with absent-adapter, unknown-device-support and unavailable states kept separate");
    let index=cj_text(at_vm(ut_prefix,"fn main(){let v=hardware_api();if !v{return 1;}db_io(0,1,db_word(v),db_bytes(v));return 0;}",0),"stdout");i=0;while i<16{let fields=ha_split(h_at(restrictions,i),124);let alternatives=ha_split(h_at(fields,1),44);let n=0;while n<h_count(alternatives){let function=h_trim(h_at(alternatives,n));h_assert(h_has(index,h_cat(function,"(")),h_cat("Alternative is absent from the actual API index: ",function));n=n+1;}i=i+1;}h_assert(h_has(index,"hardware_access_info()")&&h_has(index,"hardware_restrictions()"),"Discovery functions missing from API index");at_pass("every proposed narrower alternative and both discovery functions exist in the generated API index");
    at_vm(ut_prefix,"fn main(){let rows=hardware_capabilities();if !rows||db_count(rows)<=16{return 1;}let i=0;let restricted=0;while i<db_count(rows){let r=db_at(rows,i);if db_word(device_field(r,\"discovery_implemented\")){if db_word(device_field(r,\"implemented\"))||db_word(device_field(r,\"available\"))||db_kind(device_field(r,\"supported\"))!=0{return 2;}restricted=restricted+1;}i=i+1;}if restricted!=16{return 3;}return 0;}",0);at_pass("the public capability inventory includes the16 restriction rows alongside existing SDK adapter capabilities");
    at_vm(ut_prefix,"fn main(){let args=db_list();db_add(args,db_int(1));if hardware_call(\"hardware_access_info\",args){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"invalid_argument\"){return 2;}return 0;}",0);at_pass("the shared operation registry rejects extra discovery arguments before Android dispatch");at_vm(ut_prefix,"fn main(){if battery_info(){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"permission_denied\"){return 2;}if hardware_call(\"usb_gadget\",db_list()){return 3;}if !db_len(db_error()){return 4;}return 0;}",0);at_pass("discovery grants no battery access and restriction identifiers do not become callable raw hardware operations");
    let session=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));h_assert(h_equal(j_dump(cj_get(session,"permissions")),j_dump(denied)),"Discovery changed a Deny choice");at_pass("all31 conversation Deny choices remain unchanged after metadata, capability and rejected-operation calls");let ask=h_cat(ut_prefix,"-ask");h_assert(h_equal(ha_snapshot(ask,0),actual),"Ask-only SDK metadata differs");let ask_policy=cj_get(ut_read(h_cat3("files/workspaces/",ask,"/session.json")),"permissions");let pairs=j_value(ask_policy);i=0;while i<h_count(pairs){h_assert(h_equal(j_value(load64(h_at(pairs,i)+8)),"ask"),"Discovery persisted a grant");i=i+1;}at_pass("fresh Ask-only conversations read the same SDK metadata without prompting or persisting a grant");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");h_assert(h_equal(ha_snapshot(ut_prefix,0),actual),"SDK facts changed across actual restart");session=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));h_assert(h_equal(j_dump(cj_get(session,"permissions")),j_dump(denied)),"Restart changed a Deny choice");at_pass("a real app process restart reads current SDK facts again without restored handles or permission changes");let report=j_object();j_set(report,"permission_records",j_int(17));j_set(report,"restriction_rows",j_int(16));j_set(report,"physical_devices_verified",j_bool(0));j_set(report,"privileged_hardware_access_verified",j_bool(0));j_set(report,"vendor_integration_configured",j_bool(0));return at_finish(report);
