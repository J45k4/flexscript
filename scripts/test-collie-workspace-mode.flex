// Workspace boundaries and transactions through the actual shared/native VM.
import "lib/collie-test.flex";
fn ws_change(saved,key,value){let r=ct_request("permission_update",0);j_set(r,"saved",saved);j_set(r,"key",j_string(key));j_set(r,"value",value);let result=ct_call(8,r);h_assert(!cj_get(result,"error"),j_dump(result));return result;}
fn ws_select(saved){return ws_change(saved,"permission_profile",j_string("workspace"));}
fn ws_has(list,text){let i=0;while i<j_count(list){if h_equal(j_value(j_at(list,i)),text){return 1;}i=i+1;}return 0;}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));let defaults=ct_call(8,ct_request("permissions",0));let original=cj_get(defaults,"policy");h_assert(h_equal(cj_text(original,"permission_profile"),"custom"),"Default profile changed");let selected=ws_select(original);let policy=cj_get(selected,"policy");let local=h_args("files_read","files_write","db_read","db_write",0,0);let i=0;while i<h_count(local){h_assert(cj_int(policy,h_at(local,i)),"Workspace did not grant local capability");i=i+1;}let outside=h_args("internet","network","history","workers","documents","usb");i=0;while i<h_count(outside){h_assert(h_equal(cj_text(policy,h_at(outside,i)),"ask"),"Workspace silently granted an outside capability");i=i+1;}ct_pass("Workspace grants local files and FlexDB while outside capabilities stay Ask; Custom remains the default");
    let old=ct_grants(j_bool(1));j_set(old,"network",j_bool(1));j_set(old,"usb",j_bool(0));j_set(old,"files_write",j_bool(0));let change=ws_select(old);let next=cj_get(change,"policy");h_assert(!cj_int(next,"files_write")&&j_kind(cj_get(next,"files_write"))==5&&!cj_int(next,"usb")&&h_equal(cj_text(next,"internet"),"ask")&&h_equal(cj_text(next,"workers"),"ask"),j_dump(change));h_assert(ws_has(cj_get(change,"revoked"),"network")&&ws_has(cj_get(change,"revoked"),"workers")&&ws_has(cj_get(change,"revoked"),"internet"),"Shared transition did not identify revoked native capabilities");ct_pass("existing Deny choices survive profile selection and broader grants produce explicit revocations");
    change=ws_change(policy,"approval_reviewer",j_string("auto_review"));h_assert(h_equal(cj_text(cj_get(change,"policy"),"permission_profile"),"workspace")&&j_count(cj_get(change,"revoked"))==0,"Reviewer selection changed workspace scope");change=ws_change(cj_get(change,"policy"),"internet",j_bool(1));next=cj_get(change,"policy");h_assert(h_equal(cj_text(next,"permission_profile"),"custom")&&cj_int(next,"internet")&&cj_int(next,"files_write")&&cj_int(next,"db_write")&&h_equal(cj_text(next,"usb"),"ask"),j_dump(change));change=ws_change(policy,"permission_profile",j_string("custom"));h_assert(cj_int(cj_get(change,"policy"),"files_write")&&h_equal(cj_text(cj_get(change,"policy"),"internet"),"ask"),"Custom restored an older broader policy");ct_pass("Auto-review is independent, and customizing one capability preserves every other current limit");
    let r=ct_request("permission_update",0);j_set(r,"saved",policy);j_set(r,"key",j_string("permission_profile"));j_set(r,"value",j_string("unrestricted"));h_assert(cj_get(ct_call(8,r),"error"),"Unknown profile accepted");j_set(r,"key",j_string("not_a_capability"));j_set(r,"value",j_bool(1));h_assert(cj_get(ct_call(8,r),"error"),"Unknown capability accepted");ct_pass("profile updates validate their keys and values before changing any grant");
    j_set(ct_config,"permissions",policy);let source="fn main(){if !fs_mkdir(\"notes\") || !fs_write(\"notes/local.txt\",db_text(\"workspace\")){return 1;}if !db_begin(){return 2;}let s=db_schema();db_column(s,\"value\",2,0);if !db_create(\"local_data\",s){return 3;}let v=db_values();db_add(v,db_text(\"persisted\"));if db_insert(\"local_data\",v)!=1 || !db_commit(){return 4;}let row=db_get(\"local_data\",1);if !worker_equal(db_word(db_cell(row,0)),\"persisted\"){return 5;}let text=fs_read(\"notes/local.txt\",0,100);db_io(0,1,db_word(text),db_bytes(text));return 0;}";let o=ct_continued(ct_execute(source,"workspace-local",0));h_assert(!cj_get(o,"signal")&&h_equal(cj_text(o,"stdout"),"workspace"),j_dump(o));ct_continued(ct_execute("fn main(){if !db_begin() || !db_delete(\"local_data\",1){return 1;}return 0;}","workspace-rollback",0));ct_continued(ct_execute("fn main(){return db_kind(db_get(\"local_data\",1))-5;}","workspace-durable",0));ct_pass("files and real FlexDB transactions run without approvals, persist committed rows and roll back uncommitted writes");
    h_save(h_join(ct_root,"outside.txt"),"sentinel");h_assert(syscall(88,h_join(ct_root,"outside.txt"),h_join(ct_root,"files/escape-link"),0,0,0,0)==0,"Could not create owned boundary fixture");source="fn main(){if fs_read(\"../outside.txt\",0,100) || fs_read(\"escape-link\",0,100) || fs_write(\"../outside.txt\",db_text(\"bad\")) || fs_read(\"../session.json\",0,100){return 1;}fs_write(\"escape-link\",db_text(\"safe atomic replacement\"));return 0;}";ct_continued(ct_execute(source,"workspace-escapes",0));h_assert(h_equal(h_read(h_join(ct_root,"outside.txt")),"sentinel"),"Workspace escaped into a sibling file");ct_pass("traversal, symlink escapes and private harness files stay outside the real filesystem boundary");
    let raw=ct_grants(j_bool(1));j_set(raw,"permission_profile",j_string("workspace"));j_set(raw,"network",j_bool(1));j_set(ct_config,"permissions",raw);let probes=c_json("{\"internet\":\"http_get(\\\"https://example.com/\\\")\",\"workers\":\"worker_start(\\\"Helper\\\",\\\"Check data\\\")\",\"history\":\"memory_search(\\\"test\\\",\\\"\\\",0,1)\",\"network\":\"net_list()\"}");let pairs=j_value(probes);i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let key=load64(pair);let body=h_cat3("fn main(){",j_value(load64(pair+8)),";return 0;}");let t=ct_begin(body,h_cat("workspace-outside-",key));o=ct_observe(t);h_assert(h_equal(cj_text(o,"state"),"permission")&&h_equal(cj_text(cj_get(o,"signal"),"key"),key),j_dump(o));ct_command(ct_transition("observation",t,"observation",o),"permission");i=i+1;}ct_pass("raw legacy Allow flags cannot bypass Workspace approval gates for network, workers or history");
    j_set(raw,"approval_reviewer",j_string("auto_review"));j_set(ct_config,"permissions",raw);let t=ct_begin("fn main(){http_get(\"https://example.com/\");return 0;}","workspace-autoreview");t=ct_transition("observation",t,"observation",ct_observe(t));ct_command(t,"autoreview");h_assert(h_equal(cj_text(cj_get(cj_get(t,"command"),"body"),"model"),"codex-auto-review"),"Outside request did not use the independent reviewer");j_set(raw,"files_write",j_bool(0));ct_continued(ct_execute("fn main(){if fs_write(\"must-not-exist.txt\",db_text(\"bad\")){return 1;}return 0;}","workspace-explicit-deny",0));h_assert(!h_exists(h_join(ct_root,"files/must-not-exist.txt")),"Explicit denial was overridden by Workspace");ct_pass("Workspace composes with Auto-review and still rejects explicitly denied local writes");
    return ct_done(j_object(),"workspace-mode-report.json");
}
