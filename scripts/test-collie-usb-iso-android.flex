// Disposable, owned headless emulator only. Cleanup reboots its guest to clear transient USB consent.
// The controller owns restoration even when its separate test worker fails.
import "../apps/collie/lib/state.flex";
global ut_adb=0;global ut_serial=0;global ut_out=0;global ut_prefix=0;global ut_sequence=0;global ut_original=0;
fn ut_args(a,b,c,d,e,f){let args=h_args(ut_adb,"-s",ut_serial,a,b,c);if d{h_add(args,d);}if e{h_add(args,e);}if f{h_add(args,f);}return args;}
fn ut_call(args,input){return h_wait(h_spawn(args,input,0));}
fn ut_ok(args,input){return h_check(ut_call(args,input),0,0);}
fn ut_read(path){let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),"");if h_status(p)!=0||!h_starts(h_out(p),"{"){return 0;}return c_json(h_out(p));}
fn ut_name(name){let n=h_len(name);if n<1||n>72{return 0;}let i=0;while i<n{let c=load8(name+i);if !((c>=48&&c<=57)||(c>=65&&c<=90)||(c>=97&&c<=122)||c==45||c==95){return 0;}i=i+1;}return 1;}
fn ut_start(sid,payload){h_assert(ut_name(sid),"Unsafe owned USB workspace");j_set(payload,"session",j_string(sid));j_set(payload,"hardware_preserve_handles",j_bool(1));ut_sequence=ut_sequence+1;let name=h_cat3(ut_prefix,h_cat3("-",h_int(syscall(39,0,0,0,0,0,0)),"-"),h_int(ut_sequence));let path=h_cat3("files/test/",name,".json");ut_ok(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'umask 077; cat > ",path,"'")),j_dump(payload));let args=ut_args("shell","am","start","-n","org.flexscript.collie/.MainActivity",0);h_add(args,"--es");h_add(args,"test_case");h_add(args,name);ut_ok(args,"");return name;}
fn ut_result(name){let end=net_now()+45000;while net_now()<end{let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{j_save(h_join(ut_out,h_cat3("case-",name,".json")),r);h_assert(cj_int(r,"ok"),j_dump(r));return r;}h_sleep(20);}h_die(h_cat("USB Android case deadline: ",name));return 0;}
fn ut_sdk(suffix,prepare){let p=j_object();j_set(p,"hardware_tests",j_bool(1));j_set(p,"hardware_usb_iso_tests",j_bool(1));if prepare{j_set(p,"hardware_usb_iso_prepare_tests",j_bool(1));}let grants=j_object();j_set(grants,"usb",j_bool(1));j_set(p,"initial_permissions",grants);return cj_get(ut_result(ut_start(h_cat(ut_prefix,suffix),p)),"hardware");}
fn ut_attr(node,key){let at=h_find(node,h_cat3(" ",key,"=\""));if at<0{return 0;}let start=node+at+h_len(key)+3;let n=h_find(start,"\"");if n<0{return 0;}return h_slice(start,n);}
fn ut_node(xml,label,resource){let at=0;while load8(xml+at){let n=h_find(xml+at,"<node ");if n<0{return 0;}at=at+n;let end=h_find(xml+at,">");if end<0{return 0;}let node=h_slice(xml+at,end+1);if h_equal(ut_attr(node,"enabled"),"true")&&h_equal(ut_attr(node,"class"),"android.widget.Button")&&((label&&h_equal(ut_attr(node,"text"),label))||(resource&&h_equal(ut_attr(node,"resource-id"),resource))){return node;}at=at+end+1;}return 0;}
fn ut_tap(node){let b=ut_attr(node,"bounds");h_assert(b,"Missing USB consent bounds");let a=alloc(32);let i=0;let count=0;while load8(b+i){let c=load8(b+i);if c>=48&&c<=57{let start=i;while load8(b+i)>=48&&load8(b+i)<=57{i=i+1;}h_assert(count<4,"Invalid USB consent coordinates");store64(a+count*8,h_number(h_slice(b+start,i-start)));count=count+1;}else{h_assert(c==91||c==93||c==44,"Invalid USB consent rectangle");i=i+1;}}h_assert(count==4&&load64(a+16)>load64(a)&&load64(a+24)>load64(a+8),"Empty USB consent rectangle");ut_ok(ut_args("shell","input","tap",h_int((load64(a)+load64(a+16))/2),h_int((load64(a+8)+load64(a+24))/2),0),"");return 0;}
fn ut_click(label,alternate,resource,file){let end=net_now()+15000;while net_now()<end{let path=h_cat3("/data/local/tmp/",ut_prefix,".xml");ut_ok(ut_args("shell","uiautomator","dump",path,0,0),"");let xml=h_out(ut_ok(ut_args("exec-out","cat",path,0,0,0),""));h_save(h_join(ut_out,file),xml);let node=ut_node(xml,label,resource);if !node&&alternate{node=ut_node(xml,alternate,0);}if node{return ut_tap(node);}h_sleep(50);}h_die("Expected actual USB consent button not found");return 0;}
fn ut_phase(sid,phase,name){let end=net_now()+20000;while net_now()<end{let r=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));if r&&h_equal(cj_text(r,"phase"),phase){return r;}let result=ut_read(h_cat3("files/test/",name,".result.json"));if result{h_die(h_cat3("Expected USB consent phase ",phase,j_dump(result)));}h_sleep(20);}h_die(h_cat("USB permission phase deadline: ",phase));return 0;}
fn ut_responses(source){let call=j_object();j_set(call,"type",j_string("custom_tool_call"));j_set(call,"id",j_string("ctc_usb_iso"));j_set(call,"call_id",j_string("call_usb_iso"));j_set(call,"name",j_string("flexscript"));j_set(call,"input",j_string(source));let output=j_array();j_push(output,call);let response=j_object();j_set(response,"status",j_string("completed"));j_set(response,"output",output);let first=j_object();j_set(first,"type",j_string("response.completed"));j_set(first,"response",response);let text=j_object();j_set(text,"type",j_string("output_text"));j_set(text,"text",j_string("Controlled USB check complete."));let content=j_array();j_push(content,text);let message=j_object();j_set(message,"type",j_string("message"));j_set(message,"role",j_string("assistant"));j_set(message,"content",content);output=j_array();j_push(output,message);response=j_object();j_set(response,"status",j_string("completed"));j_set(response,"output",output);let second=j_object();j_set(second,"type",j_string("response.completed"));j_set(second,"response",response);let events=j_array();j_push(events,first);j_push(events,second);return events;}
fn ut_program(suffix,source,ask){let p=j_object();j_set(p,"prompt",j_string("Inspect the controlled virtual USB fixture"));j_set(p,"responses",ut_responses(source));let grants=j_object();if ask{j_set(grants,"usb",j_string("ask"));}else{j_set(grants,"usb",j_bool(1));}j_set(p,"initial_permissions",grants);return ut_start(h_cat(ut_prefix,suffix),p);}
fn ut_observation(result,expected){let messages=cj_get(result,"messages");let i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output"){let r=c_json(cj_text(m,"output"));h_assert(h_equal(cj_text(r,"state"),"continue")&&cj_int(r,"exit_code")==expected,j_dump(r));return r;}i=i+1;}h_die("Missing actual USB VM observation");return 0;}
fn ut_load(path){return c_json(h_read(path));}
// Boot completion precedes wallpaper/overlay configuration changes. Warm the
// ordinary Activity first and observe one stable resumed instance before any
// test intent; an interrupted test is never retried or replayed.
fn ut_line(text,key){let at=h_find(text,key);if at<0{return 0;}let n=h_find(text+at,"\n");if n<0{return text+at;}return h_slice(text+at,n);}
fn ut_warm(){
    ut_ok(ut_args("shell","am","start","-W","-n","org.flexscript.collie/.MainActivity"),"");let end=net_now()+45000;let since=net_now();let prior=0;let ready=0;
    while !ready&&net_now()<end{let state=h_out(ut_ok(ut_args("shell","dumpsys","activity","activities",0,0),""));let resumed=ut_line(state,"topResumedActivity=");let config=ut_line(state,"CurrentConfiguration=");let signature="";if resumed&&config{signature=h_cat3(resumed,"\n",config);}if !resumed||!h_has(resumed,"org.flexscript.collie/")||!config||!prior||!h_equal(prior,signature){since=net_now();prior=signature;}else if net_now()-since>=10000{ready=1;h_save(h_join(ut_out,"warm-activity.txt"),state);}if !ready{h_sleep(250);}}
    h_assert(ready,"Owned guest Activity is still changing after boot; no test was submitted or replayed");return 0;
}
fn ut_worker(){
    let fixture=ut_load(h_join(ut_out,"usb-iso-fixture.json"));h_assert(cj_int(fixture,"virtual_fixture")&&!cj_int(cj_get(fixture,"device"),"permission"),"A fresh controlled fixture with no existing app USB grant is required");
    let suffix="-logical-deny";let name=ut_program(suffix,"fn main(){let r=usb_list(0,32);if r{return 1;}return 0;}",1);let state=ut_phase(h_cat(ut_prefix,suffix),"permission",name);h_assert(h_equal(cj_text(cj_get(cj_get(state,"pending_execution"),"signal"),"key"),"usb"),"Wrong lazy grant");ut_click("Deny requested access","Deny",0,"logical-deny.xml");ut_result(name);h_assert(!cj_int(cj_get(ut_read(h_cat3("files/workspaces/",h_cat(ut_prefix,suffix),"/session.json")),"permissions"),"usb"),"Collie denial not retained");h_assert(!cj_int(cj_get(ut_sdk("-after-logical-deny",1),"device"),"permission"),"Logical denial touched actual USB consent");
    let device=cj_text(cj_get(fixture,"device"),"id");let source=h_cat3("fn main(){let h=usb_open(",j_dump(j_string(device)),");if !h{return 1;}return device_close(db_word(h))-1;}");suffix="-android-deny";name=ut_program(suffix,source,0);ut_phase(h_cat(ut_prefix,suffix),"platform_permission",name);ut_click(0,0,"android:id/button2","android-deny.xml");ut_result(name);h_assert(!cj_int(cj_get(ut_sdk("-after-android-deny",1),"device"),"permission"),"Android denial granted USB access");
    suffix="-allow";name=ut_program(suffix,source,1);ut_phase(h_cat(ut_prefix,suffix),"permission",name);ut_click("Allow requested access","Allow",0,"logical-allow.xml");ut_phase(h_cat(ut_prefix,suffix),"platform_permission",name);ut_click(0,0,"android:id/button1","android-allow.xml");ut_observation(ut_result(name),0);h_assert(cj_int(cj_get(ut_sdk("-after-allow",1),"device"),"permission"),"Actual Android USB approval was not applied");
    let report=ut_sdk("-io",0);j_set(report,"actual_lazy_usb_consent_verified",j_bool(1));j_set(report,"actual_android_usb_denial_verified",j_bool(1));j_set(report,"actual_android_usb_approval_verified",j_bool(1));j_save(h_join(ut_out,"usb-iso-android-report.json"),report);let rows=cj_get(report,"checks");let i=0;while i<j_count(rows){h_print(1,h_cat3("PASS ",j_value(j_at(rows,i)),"\n"));i=i+1;}return 0;
}
fn ut_restore(original){let p=j_object();j_set(p,"resume_only",j_bool(1));ut_result(ut_start(original,p));return 0;}
fn ut_remove(){h_assert(ut_name(ut_prefix)&&h_starts(ut_prefix,"usb-iso-hw-"),"Unsafe owned cleanup prefix");ut_ok(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'rm -rf files/workspaces/",ut_prefix,"*'")),"");ut_ok(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'rm -f files/test/",ut_prefix,"*.json'")),"");return 0;}
fn main(argc,argv){
    h_environment(argc,argv);ut_adb="/opt/android-sdk/platform-tools/adb";h_timeout=45000;let worker=0;let reboot=0;let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--worker"){worker=1;}else if h_equal(key,"--fixture-reboot"){reboot=1;}else{i=i+1;h_assert(i<argc,"Missing USB test value");let value=load64(argv+i*8);if h_equal(key,"--out"){ut_out=h_real(value);}else if h_equal(key,"--serial"){ut_serial=value;}else if h_equal(key,"--adb"){ut_adb=h_real(value);}else if h_equal(key,"--prefix"){ut_prefix=value;}else if h_equal(key,"--original"){ut_original=value;}else{h_die(h_cat("Unknown USB test option: ",key));}}i=i+1;}
    h_assert(ut_out&&ut_serial&&h_starts(ut_serial,"emulator-"),"Provide --out and an explicitly owned --serial emulator-N");i=9;h_assert(h_len(ut_serial)>i,"Missing emulator port");while load8(ut_serial+i){h_assert(load8(ut_serial+i)>=48&&load8(ut_serial+i)<=57,"Invalid emulator port");i=i+1;}if worker{h_assert(ut_name(ut_prefix),"Missing worker prefix");return ut_worker();}h_assert(reboot,"This fixture reboots its guest during cleanup: pass --fixture-reboot for a disposable owned emulator");
    let lock=h_join(ut_out,h_cat3("usb-iso-",ut_serial,".lock"));let fd=syscall(257,-100,lock,655426,384,0,0);h_assert(fd>=0&&syscall(73,fd,6,0,0,0,0)==0,"Another USB test owns this artifact/emulator");let sha=h_slice(h_out(ut_ok(h_args(h_executable("sha256sum"),h_join(ut_out,"collie.apk"),0,0,0,0),"")),64);let path=h_out(ut_ok(ut_args("shell","pm","path","org.flexscript.collie",0,0),""));let n=h_find(path,"\n");h_assert(h_starts(path,"package:/data/app/")&&n>8,"Missing installed Collie APK");h_assert(h_bytes(h_out(ut_ok(ut_args("shell","sha256sum",h_slice(path+8,n-8),0,0,0),"")),sha,64),"Installed APK differs from --out");
    ut_ok(ut_args("shell","input","keyevent","224",0,0),"");ut_ok(ut_args("shell","input","keyevent","82",0,0),"");ut_warm();ut_prefix=h_cat3("usb-iso-hw-",h_int(syscall(39,0,0,0,0,0,0)),h_cat("-",h_int(net_now())));ut_ok(ut_args("shell","run-as","org.flexscript.collie","mkdir","-p","files/test"),"");if !ut_original{let prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));let start=h_find(prefs,"name=\"session\">");h_assert(start>=0,"Missing original workspace");start=start+h_len("name=\"session\">");n=h_find(prefs+start,"<");h_assert(n>0,"Invalid original workspace");ut_original=h_slice(prefs+start,n);}h_assert(ut_name(ut_original)&&!h_starts(ut_original,ut_prefix),"Unsafe original workspace");ut_restore(ut_original);let before=ut_read(h_cat3("files/workspaces/",ut_original,"/session.json"));h_assert(before,"Missing original conversation");let workspaces=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","files/workspaces",0),""));let fixture=ut_sdk("-baseline",1);j_save(h_join(ut_out,"usb-iso-fixture.json"),fixture);h_assert(cj_int(fixture,"virtual_fixture")&&!cj_int(cj_get(fixture,"device"),"permission"),"The controlled fixture must start without a USB grant");
    let recovery=j_object();j_set(recovery,"original",j_string(ut_original));j_set(recovery,"prefix",j_string(ut_prefix));j_set(recovery,"before",before);j_set(recovery,"workspaces",j_string(workspaces));j_save(h_join(ut_out,"usb-iso-recovery.json"),recovery);
    let args=h_args(h_real(load64(argv)),"--worker","--out",ut_out,"--serial",ut_serial);h_add(args,"--prefix");h_add(args,ut_prefix);let child=h_spawn(args,"",0);let end=net_now()+180000;let timed=0;while h_status(child)==-999||load64(child+40)>=0||load64(child+48)>=0{h_pump(child,10);if net_now()>=end{h_stop(child);timed=1;}}h_save(h_join(ut_out,"usb-iso-worker.stdout"),h_out(child));h_save(h_join(ut_out,"usb-iso-worker.stderr"),h_err(child));
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ut_restore(ut_original);let after=ut_read(h_cat3("files/workspaces/",ut_original,"/session.json"));let same=h_equal(j_dump(cj_get(before,"messages")),j_dump(cj_get(after,"messages")))&&h_equal(j_dump(cj_get(before,"permissions")),j_dump(cj_get(after,"permissions")))&&h_equal(j_dump(cj_get(before,"cards")),j_dump(cj_get(after,"cards")))&&h_equal(j_dump(cj_get(before,"archive")),j_dump(cj_get(after,"archive")))&&h_equal(j_dump(cj_get(before,"pending_attachments")),j_dump(cj_get(after,"pending_attachments")));ut_remove();let actual=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","files/workspaces",0),""));h_assert(same,"Original chat or grants changed during USB test");
    // The parent restore case creates no synthetic workspace; exclude its already removed prefix.
    h_assert(h_equal(actual,workspaces),"Owned USB workspace cleanup changed the baseline set");let prior_boot=h_trim(h_out(ut_ok(ut_args("shell","cat","/proc/sys/kernel/random/boot_id",0,0,0),"")));ut_ok(ut_args("reboot",0,0,0,0,0),"");end=net_now()+60000;let booted=0;while !booted&&net_now()<end{let p=ut_call(ut_args("shell","getprop","sys.boot_completed",0,0,0),"");if h_status(p)==0&&h_equal(h_trim(h_out(p)),"1"){let current=ut_call(ut_args("shell","cat","/proc/sys/kernel/random/boot_id",0,0,0),"");booted=h_status(current)==0&&!h_equal(h_trim(h_out(current)),prior_boot);}if !booted{h_sleep(100);}}h_assert(booted,"Same owned USB guest is still rebooting; do not restart its emulator process");end=net_now()+30000;let ready=0;while !ready&&net_now()<end{let args=ut_args("shell","cmd","package","resolve-activity","--brief","-n");h_add(args,"org.flexscript.collie/.MainActivity");let resolved=ut_call(args,"");let prefs=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),"");ready=h_status(resolved)==0&&h_has(h_out(resolved),"org.flexscript.collie/")&&h_status(prefs)==0&&h_starts(h_out(prefs),"<?xml");if !ready{h_sleep(100);}}h_assert(ready,"The rebooted guest has not finished package/user initialization");ut_ok(ut_args("shell","input","keyevent","224",0,0),"");ut_ok(ut_args("shell","input","keyevent","82",0,0),"");ut_warm();ut_restore(ut_original);let restored=ut_sdk("-restored",1);h_assert(!cj_int(cj_get(restored,"device"),"permission"),"Transient Android USB grant survived fixture guest reboot");ut_restore(ut_original);ut_remove();ut_ok(ut_args("shell","rm","-f",h_cat3("/data/local/tmp/",ut_prefix,".xml"),0,0),"");h_print(1,h_out(child));h_print(2,h_err(child));h_assert(!timed&&h_status(child)==0,"USB test worker failed; original conversation and transient USB permission were restored");let report=ut_load(h_join(ut_out,"usb-iso-android-report.json"));j_set(report,"apk_sha256",j_string(sha));j_set(report,"original_chat_and_grants_restored",j_bool(1));j_set(report,"transient_usb_permission_restored",j_bool(1));j_save(h_join(ut_out,"usb-iso-android-report.json"),report);h_print(1,"PASS original conversation, workspace set and transient Android USB permission restored\n");return 0;
}
