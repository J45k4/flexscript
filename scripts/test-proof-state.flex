import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("global count=0; requires count>=0 && count<100; modifies count; ensures count==old(count)+1; ensures result==count; fn increment(){count=count+1;return count;}",0,"reads count; modifies count");
    let p=ps_verify("global count=0; ensures result==0; fn initial(){return count;}",1,"COUNTEREXAMPLE: postcondition");
    t_assert(h_has(h_out(p),"global count@entry = "),"missing initial global witness");
    t_assert(h_has(h_out(p),"concrete replay: call initial"),"global counterexample was not replayed");
    ps_verify("global g=0; modifies nothing; fn restore(){let saved=g;g=1;g=saved;return 0;}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("global g=0; modifies nothing; fn same(){g=g;return 0;}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("global g=0; reads nothing; modifies g; fn write(){g=42;return 0;}",0,"reads nothing; modifies g");
    ps_verify("global g=0; reads nothing; modifies g; fn read(){g=g+1;return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0; reads nothing; ensures g==old(g); fn spec_read(){return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0; global h=0; reads g; reads h; modifies g; modifies h; ensures g==old(h) && h==old(g); fn swap(){let saved=g;g=h;h=saved;return 0;}",0,"reads g, h; modifies g, h");
    ps_verify("global g=0; global h=0; reads g,h; modifies g; ensures h==old(h); fn keep(){g=g+1;return h;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; reads nothing; reads nothing; modifies nothing; fn local(g){g=g+1;return g;}",0,"reads nothing; modifies nothing");
    ps_verify("global g=0; modifies nothing; requires flag==0; fn dead(flag){if flag {g=42;}return 0;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; modifies nothing; fn live(flag){if flag {g=42;}return 0;}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("global g=0; modifies nothing; fn root(){return helper();} fn helper(){g=1;return 0;}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("global g=0; reads nothing; fn root(){return helper();} fn helper(){return g;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0; requires g==5; ensures g==7; ensures result==7; fn root(){bump();return bump();} ensures g==old(g)+1; ensures result==g; fn bump(){g=g+1;return g;}",0,"Verified roots: 2/2");
    ps_verify("global g=0; requires g==0; ensures g==(flag!=0); fn root(flag){return flag && set();} fn set(){g=1;return 1;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures g==(flag==0); fn root(flag){return flag || set();} fn set(){g=1;return 1;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures g==0; fn root(flag){return flag && set();} fn set(){g=1;return 1;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("global g=0; requires g==0; ensures g==2 && result==12; fn order(){return pair(bump(),bump());} fn bump(){g=g+1;return g;} fn pair(a,b){return a*10+b;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures g==2 && result==1; fn order(){return g + bump() + g;} fn bump(){g=g+1;return 0;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("global g=0; requires g==0; ensures g==1 && result==1; fn order(){return g + bump() + g;} fn bump(){g=g+1;return 0;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures g==1; fn early(x){if x {g=1;return 0;}g=1;return 0;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures result==g; fn root(x){return choose(x);} fn choose(x){if x {g=1;return 1;}g=2;return 2;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; ensures result==g; fn root(x){return choose(x);} fn choose(x){if x {g=1;return 1;}g=2;return 1;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("global g=0; requires g==0; ensures g==2; fn root(x){choose(x);g=g+1;return 0;} fn choose(x){if x {g=1;return 1;}g=1;return 1;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==0; ensures g==2; fn root(){g=bump()+1;return 0;} fn bump(){g=7;return 1;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g!=0; verify; fn root(){clear();return 1/g;} fn clear(){g=0;return 0;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("global g=0; verify; fn root(){clear();return need();} fn clear(){g=0;return 0;} requires g!=0; fn need(){return 1/g;}",1,"COUNTEREXAMPLE: callee requirement");
    ps_verify("global g=0; requires g==5; ensures result==5 && g==6; fn snapshot(){let saved=g;bump();return saved;} fn bump(){g=g+1;return 0;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; requires g==5; ensures result==5; fn root(){return callee(bump());} fn bump(){g=g+1;return 0;} ensures result==old(g); fn callee(x){return g;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("global g=0; requires g==5; ensures result==6; fn root(){return callee(bump());} fn bump(){g=g+1;return 0;} ensures result==old(g); fn callee(x){return g;}",0,"Verified roots: 2/2");
    ps_verify("global g=0; ensures result==old(g*x); fn snapshot(x){let before=g*x;g=99;x=0;return before;}",0,"Verified roots: 1/1");
    ps_verify("global g=0; modifies nothing; fn early(x){if x{return 0;}if !x{return 0;}g=1;return 0;}",0,"Verified roots: 1/1");
    p=ps_verify("global g=0; modifies nothing; fn outer(){return middle();} fn middle(){return leaf();} fn leaf(){g=1;return 0;}",1,"COUNTEREXAMPLE: write frame in outer");
    t_assert(h_has(h_out(p),"concrete replay: call outer call middle call leaf"),"missing transitive frame replay");
    ps_verify("global g=0; requires g==1; reads nothing; fn root(){return 0;}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("global g=0; reads g,g; modifies g,g; fn duplicate(){g=g;return 0;}",0,"Verified roots: 1/1");
    t_native("global g=0; fn bump(){g=g+1;return g;} fn pair(a,b){return a*10+b;} fn main(){let result=pair(bump(),bump());return (result==12 && g==2);}",1,"");
    t_native("global g=0; fn set(){g=1;return 1;} fn main(){let a=0 && set();let b=1 || set();if g{return 0;}let c=1 && set();return g;}",1,"");
    t_native("global g=0; fn choose(x){if x{g=1;return 1;}g=2;return 2;} fn main(){let a=choose(1);if a!=g{return 0;}let b=choose(0);return b==g;}",1,"");
    ps_bad("global g=0; reads nothing; reads g; fn main(){return 0;}","nothing cannot be mixed");
    ps_bad("global g=0; modifies g; modifies nothing; fn main(){return 0;}","nothing cannot be mixed");
    ps_bad("global g=0; modifies nothing,g; fn main(){return 0;}","expected ';' after function contract");
    ps_bad("global g=0; reads g,nothing; fn main(){return 0;}","expected global name in effect frame");
    ps_bad("reads missing; fn main(){return 0;}","effect locations must name declared globals");
    ps_bad("modifies local; fn main(){let local=0;return 0;}","effect locations must name declared globals");
    ps_verify("modifies bytes(p,8); requires p==16; fn main(p){return 0;}",0,"Verified roots: 1/1");
    ps_bad("reads nothing;", "function contract has no following function");
    t_native("global g=0; reads nothing; modifies nothing; ensures 0; fn main(){g=42;return g;}",42,"");
    h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let with_frames=h_sha(t_binary);t_program("global g=0; fn main(){g=42;return g;}");t_compile();t_assert(h_equal(with_frames,h_sha(t_binary)),"effect frames changed executable bytes");
    h_save(h_join(t_work,"state.flex"),"global g=0; modifies g; fn set(){g=1;return g;}");
    ps_verify("import \"state.flex\"; modifies g; ensures g==1; fn root(){return set();}",0,"Verified roots: 2/2");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
