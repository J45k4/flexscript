// Actual SAF picker, durable URI grants, SDK I/O and process-restart ownership.
import "lib/android-preferences-test.flex";
global do_source=0;
fn do_folder(){return h_cat("Collie-SAF-",ut_prefix);}
fn do_remote(){return h_cat("/sdcard/Documents/",do_folder());}
fn do_program(name,args){let source=h_cat3(do_source,"\nfn main(){return document_live_",h_cat(name,"("));let i=0;while i<h_count(args){if i{source=h_cat(source,",");}source=h_cat(source,j_dump(j_string(h_at(args,i))));i=i+1;}return h_cat(source,");}");}
fn do_vm(sid,name,args){return at_vm(sid,do_program(name,args),0);}
fn do_label(a,b){let end=net_now()+20000;while net_now()<end{let xml=at_xml();let node=at_node(xml,"text",a,0);if !node{node=at_node(xml,"content-desc",a,0);}if !node&&b{node=at_node(xml,"text",b,0);}if node{return ut_tap(node);}h_sleep(50);}h_die(h_cat("Missing owned SAF picker action: ",a));return 0;}
fn do_choose(){let xml=at_xml();h_assert(h_has(xml,"documentsui"),"Expected the actual Android document picker");if at_node(xml,"text",h_cat("Files in ",do_folder()),0){do_label("USE THIS FOLDER","Use this folder");return do_label("ALLOW","Allow");}if !at_node(xml,"text","Documents",0){let drawer=at_node(xml,"content-desc","Show roots",0);if drawer{ut_tap(drawer);}xml=at_xml();let models=h_args("Internal storage","sdk_gphone64_x86_64","Collie_Biometrics_API36","Pixel 9",0,0);let i=0;let storage=0;while i<h_count(models)&&!storage{storage=at_node(xml,"text",h_at(models,i),0);i=i+1;}h_assert(storage,"Owned emulator storage root missing");ut_tap(storage);}do_label("Documents",0);do_label(do_folder(),0);do_label("USE THIS FOLDER","Use this folder");return do_label("ALLOW","Allow");}
fn do_cancel(){let i=0;while i<6{let xml=at_xml();if !h_has(xml,"package=\"com.google.android.documentsui\"")&&!h_has(xml,"package=\"com.android.documentsui\""){return 0;}ut_ok(ut_args("shell","input","keyevent","4",0,0),"");i=i+1;}h_die("Owned SAF picker did not close");return 0;}
fn do_pick(sid,ticket,writable,policy,ask){let source=h_cat3(do_source,"\nfn main(){return document_live_pick(",h_cat3(j_dump(j_string(ticket)),",",h_cat(h_int(writable),");}")));let name=at_conversation(sid,source,policy);if ask{at_pending(sid,"documents","permission",name);at_click("text","Allow requested access",0);}at_pending(sid,"documents","platform_permission",name);do_choose();at_observation(at_result(name));let value=cj_text(do_vm(sid,"ticket",h_args(ticket,0,0,0,0,0)),"stdout");h_assert(h_starts(value,"tree-")&&ut_name(value),"Picker returned an invalid durable grant identifier");return value;}
fn do_records(snapshot){if !cj_int(snapshot,"present"){return j_array();}let records=c_json(ap_string(cj_text(snapshot,"xml"),"records"));h_assert(records&&j_kind(records)==3,"Expected actual document grant records");return records;}
fn do_cleanup(){
    do_source=h_read("apps/collie/tests/documents-live.flex");do_cancel();let sessions=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),"")));let i=0;while i<h_count(sessions){let sid=h_at(sessions,i);if (h_equal(sid,ut_prefix)||at_owned(sid))&&!h_equal(sid,h_cat(ut_prefix,"-denied")){at_case(sid,c_json("{\"resume_only\":true}"));at_vm(sid,do_program("cleanup",h_vec()),c_json("{\"documents\":true,\"db_read\":true,\"db_write\":true}"));}i=i+1;}let current=do_records(ap_snapshot("shared_prefs/document-trees.xml"));h_assert(h_equal(j_dump(current),j_dump(cj_get(at_extra,"records"))),"Owned cleanup changed original URI grant records");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ap_restore("shared_prefs/document-trees.xml",cj_get(at_extra,"trees"));h_assert(h_starts(do_remote(),"/sdcard/Documents/Collie-SAF-ctest-documents-")&&ut_name(do_folder()),"Refusing unsafe SAF folder cleanup");ut_ok(ut_args("shell","rm","-rf",do_remote(),0,0),"");h_assert(h_status(ut_call(ut_args("shell","test","-e",do_remote(),0,0),""))!=0,"Owned SAF test folder remains");return 0;
}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"documents",j_object())<0{h_assert(h_equal(ap_string("<map><string name=\"records\">[&quot;A&amp;B&#10;&#x1F415;&quot;]</string></map>","records"),"[\"A&B\n🐕\"]"),"Actual XML preference decoding failed");return at_self_test();}if at_cleanup{return do_cleanup();}if !at_child{at_extra=j_object();let trees=ap_snapshot("shared_prefs/document-trees.xml");j_set(at_extra,"trees",trees);j_set(at_extra,"records",do_records(trees));h_assert(h_status(ut_call(ut_args("shell","test","-e",do_remote(),0,0),""))!=0,"Preserve existing SAF fixture directory");return at_parent(argc,argv);}do_source=h_read("apps/collie/tests/documents-live.flex");ut_ok(ut_args("shell","mkdir","-p",do_remote(),0,0),"");let empty=h_vec();let initial=c_json("{\"documents\":true,\"db_read\":true,\"db_write\":true}");let sid=h_cat(ut_prefix,"-denied");at_vm(sid,do_program("deny",empty),c_json("{\"documents\":false}"));at_pass("a conversation-level Documents denial prevents the real Android folder picker from opening");let ask=at_copy(initial);j_set(ask,"documents",j_string("ask"));let grant=do_pick(ut_prefix,"fixture-write",1,ask,1);at_pass("actual first-use Collie approval checkpoints before the real Android folder picker, whose approved read/write tree resumes the original VM call");do_vm(ut_prefix,"replay",h_args(grant,0,0,0,0,0));at_pass("replaying a completed selection ticket returns its durable grant without reopening Android UI");at_sdk(ut_prefix,c_json("{\"hardware_document_tests\":true}"));
    let readonly=do_pick(ut_prefix,"fixture-read",0,0,0);do_vm(ut_prefix,"readonly",h_args(readonly,0,0,0,0,0));at_pass("an actual read-only picker selection cannot create a document or open a writable SDK stream even when the app holds a separate writable grant for the same URI");sid=h_cat(ut_prefix,"-shared");let other=do_pick(sid,"fixture-shared",1,initial,0);do_vm(sid,"forget_other",h_args(other,0,0,0,0,0));do_vm(ut_prefix,"reopen",h_args(grant,0,0,0,0,0));at_pass("forgetting another conversation's independently approved selection preserves the original conversation's actual shared Android URI grant");do_vm(ut_prefix,"forget_write",h_args(grant,0,0,0,0,0));at_sdk(ut_prefix,c_json("{\"hardware_document_tests\":true,\"hardware_document_read_grant_tests\":true}"));grant=do_pick(ut_prefix,"fixture-write",1,0,0);do_vm(ut_prefix,"forget_read",h_args(readonly,0,0,0,0,0));
    sid=h_cat(ut_prefix,"-cancelled");let name=at_conversation(sid,do_program("cancel",empty),initial);at_pending(sid,"documents","platform_permission",name);do_cancel();at_observation(at_result(name));do_vm(sid,"cancelled",empty);at_pass("cancelling the actual Android picker returns a typed cancellation, persists that ticket outcome and permits explicit forgetting without a prompt loop");let old=cj_text(do_vm(ut_prefix,"live_handle",h_args(grant,0,0,0,0,0)),"stdout");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");at_case(ut_prefix,c_json("{\"resume_only\":true}"));do_vm(ut_prefix,"restart",h_args(old,grant,do_folder(),0,0,0));at_pass("actual process death invalidates live handles while the selected folder and its Android persisted grant reopen successfully after restart");at_sdk(ut_prefix,c_json("{\"hardware_document_tests\":true,\"hardware_document_live_tests\":true}"));at_sdk(ut_prefix,c_json("{\"hardware_document_tests\":true,\"hardware_document_revoke_tests\":true}"));let report=j_object();j_set(report,"physical_devices_verified",j_bool(0));return at_finish(report);
}
