// Existing Espressif QEMU validates actual emitted firmware; no model changes.
import "lib/esp32-test.flex";
import "lib/esp32-elf.flex";
fn main(argc,argv) {
    h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let work=b_option(argc,argv,"--work",0);h_assert(compiler && work,"requires --compiler and --work");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);te_fixture=h_join(te_work,"firmware-input.elf");te_binary=h_join(te_work,"firmware.bin");te_legacy=1;let chip=b_option(argc,argv,"--chip","esp32");if h_equal(chip,"esp32s3") {te_legacy=0;}else {h_assert(h_equal(chip,"esp32"),"--chip must be esp32 or esp32s3");}
    te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));let prefix=b_option(argc,argv,"--prefix","xtensa-esp32-elf-");let source=b_option(argc,argv,"--source","tests/esp32/sdk-preempt-ram.flex");let cached=b_option(argc,argv,"--xip",0);let target="esp32-radio-elf";if !te_legacy {target="esp32s3-elf";if b_option(argc,argv,"--sdk",0) {te_s3_sdk=1;target="esp32s3-sdk-elf";}}if cached {target="esp32-xip-elf";if !te_legacy {target="esp32s3-xip-elf";te_s3_xip=1;te_s3_sdk=0;}}let profile=b_option(argc,argv,"--profile",0);if profile {h_assert(!cached,"--profile cannot override --xip");if te_legacy {h_assert(h_equal(profile,"esp32-elf") || h_equal(profile,"esp32-radio-elf") || h_equal(profile,"esp32-btdm-elf"),"invalid original ESP32 RAM profile");te_btdm=h_equal(profile,"esp32-btdm-elf");if te_btdm {cached="yes";}}else {h_assert(h_equal(profile,"esp32s3-elf") || h_equal(profile,"esp32s3-sdk-elf") || h_equal(profile,"esp32s3-xip-elf"),"invalid ESP32-S3 RAM profile");te_s3_sdk=h_equal(profile,"esp32s3-sdk-elf");te_s3_xip=h_equal(profile,"esp32s3-xip-elf");if te_s3_xip {cached="yes";}}target=profile;}
    let args=h_args(te_compiler,"--target",target,source,"-o",te_fixture);h_ok(args);let linker=h_join(te_work,"link");h_compile(te_compiler,"scripts/esp32-link.flex",linker);let oracle=h_join(te_work,"oracle.o");args=h_args(h_cat(prefix,"gcc"),"-Os","-fno-optimize-sibling-calls","-fno-inline","-fno-builtin","-mlongcalls");h_add(args,"-mtext-section-literals");h_add(args,"-c");h_add(args,"tests/esp32/abi-oracle/abi-fixture.c");h_add(args,"-o");h_add(args,oracle);h_ok(args);
    let linked=h_join(te_work,"firmware.elf");args=h_args(linker,"--firmware",te_fixture,"--output",linked,"--ld");h_add(args,h_cat(prefix,"ld"));h_add(args,"--object");h_add(args,oracle);if cached {h_add(args,"--xip");}
    let extra=b_option(argc,argv,"--extra",0);if extra {h_add(args,"--object");h_add(args,extra);}let assembly=b_option(argc,argv,"--assembly",0);if assembly {h_add(args,"--object");h_add(args,assembly);}
    h_add(args,"--image");h_add(args,te_binary);h_add(args,"--map");h_add(args,h_join(te_work,"firmware.map"));h_ok(args);te_xip=cached!=0;let expected="PASS:";if h_has(source,"irq-epilogue") {expected=0;}let serial=te_run(te_binary,0,expected);h_save(h_join(te_work,"executed.uart"),serial);h_print(1,serial);
    let report=b_option(argc,argv,"--report",0);if report {let r=j_object();j_set(r,"pass",j_bool(1));j_set(r,"checks",j_int(te_checks));j_set(r,"source",j_string(h_absolute(source)));j_set(r,"source_sha256",j_string(h_sha(source)));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_set(r,"ELF",j_string(linked));j_set(r,"ELF_sha256",j_string(h_sha(linked)));j_set(r,"image",j_string(te_binary));j_set(r,"image_sha256",j_string(h_sha(te_binary)));j_set(r,"UART_sha256",j_string(h_sha(h_join(te_work,"executed.uart"))));j_set(r,"physical_hardware",j_bool(0));j_save(report,r);}return 0;
}
