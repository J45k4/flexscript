// Two actual public SDK UWB sessions on isolated AVDs; strict effective-interval
// gate is retained. Virtual measurements are not physical or position-oracle proof.
import "lib/android-multi-test.flex";
import "../lib/f64.flex";
global up_report=0;global up_measurements=0;global up_missing=0;
fn up_radio(){let value=h_trim(h_out(ut_ok(ut_args("shell","cmd","uwb","status",0,0),"")));h_assert(h_has(value,"enabled")||h_has(value,"disabled"),"Unknown UWB radio state");return !h_has(value,"disabled");}
fn up_restore(){let action="disable-uwb";if cj_int(at_extra,"uwb"){action="enable-uwb";}ut_ok(ut_args("shell","cmd","uwb",action,0,0),"");h_assert(up_radio()==cj_int(at_extra,"uwb"),"Original UWB radio not restored");return md_cleanup();}
fn up_vm(call,args){return bp_vm(h_cat("uwb_peer_live_",call),args);}
fn up_save(){let selected=md_index;md_select(0);j_set(up_report,"ranging_io_verified",j_bool(j_count(up_measurements)==2));at_finish(up_report);md_select(selected);return 0;}
fn up_pass(text){at_pass(text);return up_save();}
fn up_hexword(text){h_assert(h_len(text)==16,"Expected one complete SDK binary64/timestamp word");let bytes=h_unhex(text);let n=0;let i=0;while i<8{n=(n<<8)|load8(bytes+i);i=i+1;}return n;}
fn up_decimal(bits){let scaled=f64_to_i64_nearest(f64_mul(bits,f64_from_i64(1000000000)));let fraction=h_int(scaled%1000000000);while h_len(fraction)<9{fraction=h_cat("0",fraction);}return j_node(6,h_cat3(h_int(scaled/1000000000),".",fraction));}
fn up_distance(){let o=up_vm("distance",h_vec());let text=h_trim(cj_text(o,"stdout"));let bits=up_hexword(text);h_assert(f64_ge(bits,0)&&f64_lt(bits,f64_from_i64(10000)),"SDK distance is not finite and within the original oracle bounds");let row=cj_get(up_measurements,ut_serial);if !row{row=j_object();j_set(up_measurements,ut_serial,row);}j_set(row,"distance_m",up_decimal(bits));j_set(row,"distance_decimal_places",j_int(9));j_set(row,"binary64_hex",j_string(text));up_save();return j_dump(up_decimal(bits));}
fn up_period(){up_vm("drain",h_vec());h_sleep(3000);let lines=at_lines(cj_text(up_vm("stamps",h_vec()),"stdout"));h_assert(h_count(lines)>=4,"Fewer than four actual SDK timestamps");let deltas=h_vec();let i=1;while i<h_count(lines){let delta=up_hexword(h_at(lines,i))-up_hexword(h_at(lines,i-1));h_add(deltas,delta);i=i+1;}i=1;while i<h_count(deltas){let value=h_at(deltas,i);let j=i;while j>0&&h_at(deltas,j-1)>value{store64(deltas+8+j*8,h_at(deltas,j-1));j=j-1;}store64(deltas+8+j*8,value);i=i+1;}let n=h_count(deltas);if n%2{return 2*h_at(deltas,n/2);}return h_at(deltas,n/2-1)+h_at(deltas,n/2);}
fn up_half(n){return j_node(6,h_cat3(h_int(n/2),".",h_int((n%2)*5)));}
fn up_open(index){md_select(index);bp_grant("android.permission.RANGING");let local="AB";let remote="CD";let role="1";if index{local="CD";remote="AB";role="0";}at_vm(ut_prefix,bp_program("uwb_peer_live_open",h_args(bp_string(local),bp_string(remote),role,0,0,0)),c_json("{\"uwb\":true,\"db_read\":true,\"db_write\":true}"));up_vm("opened",h_vec());return 0;}
fn main(argc,argv){
    at_cleanup_hook=1;let options=md_options(c_json("{\"peer-serial\":\"\"}"));if at_init(argc,argv,"uwb-peer",options)<0{return at_self_test();}if at_cleanup{return up_restore();}let peer=cj_text(options,"peer-serial");h_assert(h_len(peer)>0,"Provide --peer-serial for the separately owned biometric AVD");if cj_int(options,"guardian"){h_assert(h_equal(ut_serial,peer)&&h_has(h_out(ut_ok(ut_args("emu","avd","name",0,0,0),"")),"Collie_Biometrics_API36"),"Only the separately owned peer AVD is allowed");if at_child{return md_guardian();}md_redirect();}if !at_child{at_extra=j_object();j_set(at_extra,"uwb",j_bool(up_radio()));h_assert(cj_int(at_extra,"uwb"),"Enable the owned UWB radio before testing");return at_parent(argc,argv);}md_start(argc,argv,peer);bp_source=h_read("apps/collie/tests/uwb-peer-live.flex");up_report=j_object();up_measurements=j_object();up_missing=j_array();j_set(up_report,"measurements",up_measurements);j_set(up_report,"missing_gates",up_missing);j_set(up_report,"diagnostics",j_object());j_set(up_report,"physical_devices_verified",j_bool(0));j_set(up_report,"position_oracle_verified",j_bool(0));j_set(up_report,"ok",j_bool(0));let serials=j_array();j_push(serials,j_string(peer));j_push(serials,j_string(md_primary_serial));j_set(up_report,"serials",serials);up_save();up_open(1);up_pass("the separately owned emulator opens its actual SDK UWB responder");up_open(0);up_pass("the controller opens the matching SDK UWB session with mirrored binary addresses and identical session/security parameters");let distance=up_distance();up_pass(h_cat3("the actual controller SDK delivers a copied UWB measurement through Flexscript: ",distance,"m"));md_select(1);distance=up_distance();up_pass(h_cat3("the actual responder SDK delivers a copied UWB measurement through Flexscript: ",distance,"m"));md_select(0);
    let before=up_period();up_vm("interval_skip",h_vec());h_sleep(500);let after=up_period();let row=cj_get(up_measurements,ut_serial);j_set(row,"interval_ms_before",up_half(before));j_set(row,"interval_ms_skip1",up_half(after));if 3*before<2*after&&after<3*before{up_pass(h_cat3("actual SDK measurement timestamps reflect interval skip reconfiguration: ",j_dump(up_half(before)),h_cat3("ms to ",j_dump(up_half(after)),"ms")));}else{j_push(up_missing,j_string("effective_interval_reconfiguration"));let diagnostics=j_object();j_set(diagnostics,"before_ms",up_half(before));j_set(diagnostics,"skip1_ms",up_half(after));j_set(cj_get(up_report,"diagnostics"),"effective_interval_reconfiguration",diagnostics);h_print(1,h_cat3("MISSING effective_interval_reconfiguration ",j_dump(up_half(before)),h_cat(" ",h_cat(j_dump(up_half(after)),"\n"))));up_save();}up_vm("interval_reset",h_vec());up_vm("add",h_vec());up_vm("added",h_vec());up_pass("adding a configured virtual peer yields its actual SDK started callback; this does not claim a third physical device");up_vm("remove",h_vec());up_pass("removing that configured peer yields its actual SDK stopped callback");up_distance();up_pass("the original actual peer still delivers measurements after dynamic-peer changes");j_set(up_report,"ok",j_bool(j_count(up_missing)==0));md_select(0);up_save();h_assert(j_count(up_missing)==0,j_dump(cj_get(up_report,"diagnostics")));return 0;
}
