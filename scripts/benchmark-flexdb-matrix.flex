// Run concrete variants from benchmark.md, with matched-result validation.
import "lib/json.flex";
fn pin() {let mask=h_zero(h_take(128),128);let bytes=syscall(204,0,128,mask,0,0,0);h_assert(bytes>0,"affinity");let cpu=0;while cpu<bytes*8 && !(load8(mask+cpu/8)&(1<<(cpu%8))) {cpu=cpu+1;}h_assert(cpu<bytes*8,"CPU");h_zero(mask,128);store8(mask+cpu/8,1<<(cpu%8));h_assert(syscall(203,0,128,mask,0,0,0)==0,"pin");return cpu;}
fn scenario(name,n,family,matches,width,shared,nullp) {let v=j_object();j_set(v,"name",j_string(name));j_set(v,"rows",j_int(n));j_set(v,"family",j_string(family));j_set(v,"matches",j_int(matches));j_set(v,"width",j_int(width));j_set(v,"shared",j_int(shared));j_set(v,"null_percent",j_int(nullp));j_set(v,"flexdb",j_array());j_set(v,"sqlite",j_array());return v;}
fn worker_args(exe,path,s) {let a=h_args(exe,path,h_int(j_n(s,"rows")),j_s(s,"family"),h_int(j_n(s,"matches")),h_int(j_n(s,"width")));h_add(a,h_int(j_n(s,"shared")));h_add(a,h_int(j_n(s,"null_percent")));return a;}
fn values(samples,which,key,runs) {let v=h_vec();let i=1;while i<=runs {let sample=j_at(samples,i);let item=sample;if which>=0 {item=j_at(j_get(sample,"cases"),which);}h_add(v,j_n(item,key));i=i+1;}i=1;while i<runs {let j=i;while j>0 && h_at(v,j)<h_at(v,j-1) {let x=h_at(v,j);store64(v+8+j*8,h_at(v,j-1));store64(v+j*8,x);j=j-1;}i=i+1;}return v;}
fn stats(samples,which,key,runs) {let v=values(samples,which,key,runs);let r=j_object();j_set(r,"median",j_int(h_at(v,runs/2)));j_set(r,"min",j_int(h_at(v,0)));j_set(r,"max",j_int(h_at(v,runs-1)));return r;}
fn validate(s,round) {let f=j_at(j_get(s,"flexdb"),round);let q=j_at(j_get(s,"sqlite"),round);let a=j_get(f,"cases");let b=j_get(q,"cases");h_assert(j_count(a)==j_count(b),"worker case count");let i=0;while i<j_count(a) {let x=j_at(a,i);let y=j_at(b,i);h_assert(h_equal(j_s(x,"case"),j_s(y,"case")),"worker case label");h_assert(j_n(x,"operations")==j_n(y,"operations"),"worker operation count");h_assert(j_n(x,"checksum")==j_n(y,"checksum"),h_cat3(j_s(s,"name")," checksum differs: ",j_s(x,"case")));i=i+1;}return 1;}
fn format_ms(ns) {let fraction=h_int(ns/1000%1000);while h_len(fraction)<3 {fraction=h_cat("0",fraction);}return h_cat3(h_int(ns/1000000),".",fraction);}
fn markdown(report,path) {let b=h_buffer();let head="# FlexDB roadmap comparison\n\nFive measured runs by default, with an excluded warmup and alternating engine order. Times below are median milliseconds; each row compares the same result checksum and operation count. See benchmark.md for full target scope.\n\n";h_append(b,head,h_len(head));let method=j_s(report,"method");h_append(b,method,h_len(method));let table="\n\n| Scenario | Case | Targets | Operations | FlexDB ms | SQLite ms | Faster (>10% margin) |\n| --- | --- | --- | ---: | ---: | ---: | --- |\n";h_append(b,table,h_len(table));let rows=j_get(report,"summary");let i=0;while i<j_count(rows) {let r=j_at(rows,i);let f=j_n(j_get(r,"flexdb_ns"),"median");let q=j_n(j_get(r,"sqlite_ns"),"median");let winner="Similar";if f*10<q*9 {winner="FlexDB";}else if q*10<f*9 {winner="SQLite";}let line=h_cat3("| ",j_s(r,"scenario")," | ");line=h_cat(line,h_cat3(j_s(r,"case")," | ",j_s(r,"ids")));line=h_cat(line,h_cat3(" | ",h_int(j_n(r,"operations"))," | "));line=h_cat(line,h_cat3(format_ms(f)," | ",format_ms(q)));line=h_cat(line,h_cat3(" | ",winner," |\n"));h_append(b,line,h_len(line));i=i+1;}h_save(path,h_data(b));return 1;}
fn case_ids(s,example) {let name=j_s(example,"case");let ids=j_s(example,"ids");if h_starts(name,"integer_") {ids=h_replace(h_replace(ids,",Q03",""),",A06","");}if h_starts(name,"text_") {ids=h_replace(ids,"Q02,","");if j_n(s,"shared")!=1 {ids=h_replace(ids,",A06","");}}if h_equal(name,"reopen_first_id") || h_equal(name,"first_equality_after_tail") {ids=h_replace(ids,",A07","");}if h_equal(name,"churn_total") {ids=h_replace(ids,",X02","");}return ids;}
fn summarize(report) {let runs=j_n(report,"runs");let source=j_get(report,"scenarios");let scenarios=j_array();let i=0;while i<j_count(source) {let s=j_at(source,i);if j_count(j_get(s,"flexdb"))==runs+1 {j_push(scenarios,s);}i=i+1;}j_set(report,"scenarios",scenarios);let count=j_count(scenarios);let summaries=j_array();let si=0;
 while si<count {let s=j_at(scenarios,si);let samples=j_get(s,"flexdb");let cases=j_get(j_at(samples,1),"cases");let i=0;while i<j_count(cases) {let example=j_at(cases,i);let row=j_object();j_set(row,"scenario",j_string(j_s(s,"name")));j_set(row,"case",j_string(j_s(example,"case")));j_set(row,"ids",j_string(case_ids(s,example)));j_set(row,"operations",j_int(j_n(example,"operations")));j_set(row,"checksum",j_int(j_n(example,"checksum")));j_set(row,"flexdb_ns",stats(samples,i,"ns",runs));j_set(row,"sqlite_ns",stats(j_get(s,"sqlite"),i,"ns",runs));if j_get(example,"rss_kib") {j_set(row,"flexdb_rss_kib",stats(samples,i,"rss_kib",runs));j_set(row,"sqlite_rss_kib",stats(j_get(s,"sqlite"),i,"rss_kib",runs));}if j_get(example,"p99_ns") {j_set(row,"flexdb_p99_ns",stats(samples,i,"p99_ns",runs));j_set(row,"sqlite_p99_ns",stats(j_get(s,"sqlite"),i,"p99_ns",runs));j_set(row,"flexdb_clock_pair_ns",stats(samples,i,"clock_pair_p50_ns",runs));j_set(row,"sqlite_clock_pair_ns",stats(j_get(s,"sqlite"),i,"clock_pair_p50_ns",runs));}j_push(summaries,row);i=i+1;}let resources=j_object();j_set(resources,"flexdb_bytes",stats(samples,-1,"bytes",runs));j_set(resources,"sqlite_bytes",stats(j_get(s,"sqlite"),-1,"bytes",runs));j_set(resources,"flexdb_peak_kib",stats(samples,-1,"peak_kib",runs));j_set(resources,"sqlite_peak_kib",stats(j_get(s,"sqlite"),-1,"peak_kib",runs));j_set(resources,"flexdb_write_bytes",stats(samples,-1,"write_bytes",runs));j_set(resources,"sqlite_write_bytes",stats(j_get(s,"sqlite"),-1,"write_bytes",runs));j_set(resources,"flexdb_read_bytes",stats(samples,-1,"read_bytes",runs));j_set(resources,"sqlite_read_bytes",stats(j_get(s,"sqlite"),-1,"read_bytes",runs));j_set(s,"resources",resources);si=si+1;}
 j_set(report,"summary",summaries);return report;}
fn main(argc,argv) {
 h_environment(argc,argv);if argc==4 && h_equal(load64(argv+8),"--summarize") {let report=j_parse(h_read(load64(argv+16)));summarize(report);j_save(load64(argv+24),report);markdown(report,h_cat(load64(argv+24),".md"));h_print(1,"Saved corrected medians/ranges from raw samples.\n");return 0;}h_assert(argc>=2 && argc<=5,"compiler [odd runs=5] [report.json] [smoke|extra|maintenance|storage|writes|indexes]");let runs=5;if argc>2 {runs=h_number(load64(argv+16));}h_assert(runs>=1 && runs<=9 && runs%2,"odd run count");h_timeout=180000;let cpu=pin();let work=h_temp();let flex=h_join(work,"flexdb");let sqlite=h_join(work,"sqlite");h_compile(h_real(load64(argv+8)),"scripts/bench-flexdb-matrix-worker.flex",flex);h_ok(h_args("cc","-O3","scripts/bench-flexdb-matrix-sqlite.c","-o",sqlite,"-lsqlite3"));
 let scenarios=j_array();j_push(scenarios,scenario("read_1k",1000,"read",1,32,0,10));j_push(scenarios,scenario("read_10k",10000,"read",1,32,0,10));j_push(scenarios,scenario("read_100k",100000,"read",1,32,0,10));
 j_push(scenarios,scenario("text8_10k",10000,"text",1,8,0,0));j_push(scenarios,scenario("text32_utf8_10k",10000,"text",1,32,2,10));j_push(scenarios,scenario("text256_10k",10000,"text",1,256,0,0));j_push(scenarios,scenario("text256_collision_1k",1000,"text",1,256,1,0));
 j_push(scenarios,scenario("duplicates10_10k",10000,"read",10,32,0,0));j_push(scenarios,scenario("duplicates100_10k",10000,"read",100,32,0,0));j_push(scenarios,scenario("duplicates1000_10k",10000,"read",1000,32,0,0));
 j_push(scenarios,scenario("nulls50_10k",10000,"read",1,32,0,50));j_push(scenarios,scenario("nulls90_10k",10000,"read",1,32,0,90));j_push(scenarios,scenario("write_10k",10000,"write",1,32,0,0));j_push(scenarios,scenario("lifecycle_100k",100000,"lifecycle",1,32,0,0));
 j_push(scenarios,scenario("join_unique_1k",1000,"join",1,32,0,0));j_push(scenarios,scenario("join_duplicates10_1k",1000,"join",10,32,0,0));j_push(scenarios,scenario("schema_10k",10000,"schema",1,32,0,10));
 j_push(scenarios,scenario("mixed95read_10k",10000,"mixed5",1,32,0,0));j_push(scenarios,scenario("mixed80read_10k",10000,"mixed20",1,32,0,0));j_push(scenarios,scenario("mixed50read_10k",10000,"mixed50",1,32,0,0));
 if argc>4 && (h_equal(load64(argv+32),"extra") || h_equal(load64(argv+32),"maintenance")) {scenarios=j_array();}if argc<=4 || h_equal(load64(argv+32),"extra") {j_push(scenarios,scenario("adaptive_10k",10000,"adaptive",1,32,0,0));j_push(scenarios,scenario("recovery_10k",10000,"recover",1,32,0,0));}
 if argc<=4 || (argc>4 && h_equal(load64(argv+32),"maintenance")) {j_push(scenarios,scenario("batch_1k",1000,"batch",1,32,0,0));j_push(scenarios,scenario("churn100_1k",1000,"churn",1,32,0,0));}
 if argc>4 && h_equal(load64(argv+32),"storage") {scenarios=j_array();j_push(scenarios,scenario("lifecycle_100k",100000,"lifecycle",1,32,0,0));j_push(scenarios,scenario("recovery_10k",10000,"recover",1,32,0,0));}
 if argc>4 && h_equal(load64(argv+32),"writes") {scenarios=j_array();j_push(scenarios,scenario("write_10k",10000,"write",1,32,0,0));j_push(scenarios,scenario("mixed95read_10k",10000,"mixed5",1,32,0,0));}
 if argc>4 && h_equal(load64(argv+32),"indexes") {scenarios=j_array();j_push(scenarios,scenario("read_10k",10000,"read",1,32,0,10));j_push(scenarios,scenario("duplicates10_10k",10000,"read",10,32,0,0));j_push(scenarios,scenario("duplicates100_10k",10000,"read",100,32,0,0));j_push(scenarios,scenario("duplicates1000_10k",10000,"read",1000,32,0,0));}
 let count=j_count(scenarios);if argc>4 && !h_equal(load64(argv+32),"extra") && !h_equal(load64(argv+32),"maintenance") && !h_equal(load64(argv+32),"storage") && !h_equal(load64(argv+32),"writes") && !h_equal(load64(argv+32),"indexes") {count=1;}let si=0;while si<count {let s=j_at(scenarios,si);let round=0;while round<=runs {let slot=0;while slot<2 {let engine=(round+slot)%2;let name="flexdb";let exe=flex;if engine {name="sqlite";exe=sqlite;}let path=h_join(work,h_cat3(j_s(s,"name"),h_cat(name,h_int(round)),".db"));if h_equal(j_s(s,"family"),"recover") {let a=worker_args(exe,path,s);store64(a+32,"crash");h_ok(a);}let result=h_ok(worker_args(exe,path,s));j_push(j_get(s,name),j_parse(h_out(result)));slot=slot+1;}validate(s,round);h_print(1,h_cat3(j_s(s,"name")," round ",h_cat(h_int(round)," done\n")));round=round+1;}si=si+1;}
 let report=j_object();j_set(report,"cpu",j_int(cpu));j_set(report,"runs",j_int(runs));j_set(report,"warmup_excluded",j_int(1));j_set(report,"work_directory",j_string(work));let binaries=j_object();j_set(binaries,"flexdb",j_string(h_sha(flex)));j_set(binaries,"sqlite",j_string(h_sha(sqlite)));j_set(report,"binary_sha256",binaries);j_set(report,"sqlite_version",j_string(h_out(h_ok(h_args("sqlite3","--version",0,0,0,0)))));j_set(report,"scenarios",scenarios);summarize(report);j_set(report,"method",j_string("Native Flexscript vs C -O3 SQLite WAL/FULL/NOMUTEX/64MiB cache. One pinned CPU, fresh file/process per variant/round, alternating engine order, excluded warmup. Seeded logical rows and cross-engine case checksum/operation validation. Read-family repeated SELECTs use one SQLite read transaction, with index creation in its own durable phase; mixed workload reads between durable writes use ordinary statement transactions. FlexDB automatic index versus SQLite explicit B-tree; build phase costs differ. Middle pagination uses the generated predicate_page scan, avoiding the previous full-query-plus-limit intermediate; it is not an indexed cursor. Duplicate integer count queries include a bounded exact-key count memo learned by earlier calls; invalidating writes and rebuild costs are timed separately. Ordered result delivery consumes id,key,text length and nullable value in both engines; SQLite streams rows, FlexDB materializes immutable handles. Warm OS cache; no physical-cold claim. Whole session includes dataset key generation, schema/population, query preparation and close; compilation excluded. Latency samples use forced kernel clocks in both engines with measured empty-clock overhead. Integrity, schema and compaction APIs have different internal implementations. RSS uses /proc/self/status VmHWM after exec, avoiding inherited launcher ru_maxrss; I/O uses whole-worker /proc/self/io storage-byte counters and includes setup/maintenance. Mutation phases construct fresh FlexDB value vectors versus prepared SQLite bindings. Session totals also include the benchmark latency calibration/sorting where present. Each ID tags a related representative variant, not complete checklist coverage; integer rows do not constitute text-key measurements, and reopen-by-ID does not measure mapped equality-index access."));let path=h_join(work,"report.json");if argc>3 {path=load64(argv+24);}j_save(path,report);markdown(report,h_cat(path,".md"));h_print(1,h_cat3("Report: ",path,"\n"));return 0;
}
