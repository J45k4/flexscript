// Pinned Unicode 17 default line-breaking properties; pure Flexscript generator.
import "lib/json.flex";
import "../lib/bytes.flex";
fn ulg_hex(s){let v=0;let i=0;while load8(s+i){let c=load8(s+i);let d=-1;if c>=48 && c<=57{d=c-48;}else if c>=65 && c<=70{d=c-55;}else if c>=97 && c<=102{d=c-87;}h_assert(d>=0,"Invalid line property scalar");v=v*16+d;i=i+1;}return v;}
fn ulg_class(s){if h_equal(s,"Unknown"){return 46;}if h_equal(s,"Ideographic"){return 24;}if h_equal(s,"Prefix_Numeric"){return 36;}let names="AI AK AL AP AS B2 BA BB BK CB CJ CL CM CP CR EB EM EX GL H2 H3 HH HL HY ID IN IS JL JT JV LF NL NS NU OP PO PR QU RI SA SG SP SY VF VI WJ XX ZW ZWJ";let at=0;let index=0;while load8(names+at){let start=at;while load8(names+at) && load8(names+at)!=32{at=at+1;}if h_equal(s,h_slice(names+start,at-start)){return index;}if load8(names+at){at=at+1;}index=index+1;}h_die(h_cat("Unknown line break class ",s));return 0;}
fn ulg_apply(map,path,kind,missing){
    let text=h_read(path);let at=0;while load8(text+at){let end=at;while load8(text+end) && load8(text+end)!=10{end=end+1;}let line=h_slice(text+at,end-at);at=end;if load8(text+at){at=at+1;}if missing{let pos=h_find(line,"@missing:");if pos<0{line="";}else{line=h_trim(line+pos+9);}}else{let pos=h_find(line,"#");if pos>=0{line=h_slice(line,pos);}line=h_trim(line);}if h_len(line){let semi=h_find(line,";");h_assert(semi>=0,"Line property field");let span=h_trim(h_slice(line,semi));let name=h_trim(line+semi+1);let dots=h_find(span,"..");let low=0;let high=0;if dots<0{low=ulg_hex(span);high=low;}else{low=ulg_hex(h_slice(span,dots));high=ulg_hex(span+dots+2);}h_assert(low<=high && high<1114112,"Line property range");let mask=63;let value=0;if kind==0{value=ulg_class(name);}else if kind==1{mask=64;if h_equal(name,"F") || h_equal(name,"W") || h_equal(name,"H"){value=64;}}else if kind==2{mask=1920;if h_equal(name,"Mn") || h_equal(name,"Mc"){value=128;}else if h_equal(name,"Pi"){value=256;}else if h_equal(name,"Pf"){value=512;}else if h_equal(name,"Cn"){value=1024;}}else{mask=2048;if h_equal(name,"Extended_Pictographic"){value=2048;}else{mask=0;}}let cp=low;while mask && cp<=high{bytes_store32(map+cp*4,(bytes_load32(map+cp*4)&~mask)|value);cp=cp+1;}}}return 0;
}
fn ulg_digit(out,v,n){let shift=(n-1)*6;while shift>=0{let c=63+((v>>shift)&63);if c==92{h_text(out,"\\");}let p=h_take(1);store8(p,c);h_append(out,p,1);shift=shift-6;}return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"unicode-line-properties UCD-directory output.flex");let base=load64(argv+8);let manifest=j_parse(h_read(h_join(base,"manifest.json")));h_assert(h_equal(j_s(manifest,"version"),"17.0.0"),"Expected Unicode 17.0.0");let files=j_need(manifest,"sources");let i=0;while i<j_count(files){let file=j_at(files,i);h_assert(h_equal(h_sha(h_join(base,j_s(file,"file"))),j_s(file,"sha256")),"Unicode source hash mismatch");i=i+1;}
    let map=alloc(1114112*4);h_assert(map>0,"Line property allocation");i=0;while i<1114112{bytes_store32(map+i*4,1070);i=i+1;}let path=h_join(base,"extracted/DerivedLineBreak.txt");ulg_apply(map,path,0,1);ulg_apply(map,path,0,0);ulg_apply(map,h_join(base,"EastAsianWidth.txt"),1,0);ulg_apply(map,h_join(base,"extracted/DerivedGeneralCategory.txt"),2,0);ulg_apply(map,h_join(base,"emoji/emoji-data.txt"),3,0);
    let out=h_buffer();h_text(out,"// Generated by scripts/unicode-line-properties.flex from Unicode 17.0.0.\n// Derived Unicode data (c) 2025 Unicode, Inc.; Unicode License V3: libs/unicode/LICENSE.txt.\n// start(4), end(4), flags(2), six-bit ASCII digits biased by 63.\n// LB class low6, EAW F/W/H64, Mn/Mc128, Pi256, Pf512, Cn1024, ExtPict2048.\n// Default XX|Cn=1070. Hangul H2/H3 with EAW Wide computed in lookup.\nfn unicode_line_property_data(){return \"");let count=0;i=0;while i<1114112{let value=bytes_load32(map+i*4);let end=i;while end+1<1114112 && bytes_load32(map+(end+1)*4)==value{end=end+1;}if value!=1070 && !(i>=0xac00 && end<=0xd7a3){ulg_digit(out,i,4);ulg_digit(out,end,4);ulg_digit(out,value,2);count=count+1;}i=end+1;}h_text(out,"\";}\nfn unicode_line_property_count(){return ");h_text(out,h_int(count));h_text(out,";}\n");h_save(load64(argv+16),h_data(out));syscall(11,map,1114112*4,0,0,0,0);h_print(1,h_cat3("Generated ",h_int(count)," Unicode line property ranges\n"));return 0;
}
