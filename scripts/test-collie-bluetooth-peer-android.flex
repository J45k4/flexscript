//32KiB RFCOMM exchange, actual pairing and independent localhost byte oracle.
import "lib/android-bluetooth-pair-test.flex";
fn rf_vm(name,args){return bp_vm(h_cat("rfcomm_peer_live_",name),args);}
fn rf_cleanup(){if cj_int(at_extra,"pair_started"){btp_forget(cj_text(at_extra,"peer_name"),cj_text(at_extra,"peer_address"));}return ar_restore();}
fn main(argc,argv){
    at_cleanup_hook=1;let options=c_json("{\"peer-state\":\"\",\"secure\":\"0\"}");if at_init(argc,argv,"bluetooth-peer",options)<0{return at_self_test();}if at_cleanup{return rf_cleanup();}let mode=cj_text(options,"secure");h_assert(h_equal(mode,"0")||h_equal(mode,"1"),"RFCOMM --secure must be0 or1");let secure=h_number(mode);bp_path=h_real(cj_text(options,"peer-state"));let peer=bp_read();let name=cj_text(peer,"name");h_assert(at_bool(cj_get(peer,"ready"))&&!cj_int(peer,"connected")&&h_starts(name,"Collie RFCOMM test peer ")&&h_len(name)==h_len("Collie RFCOMM test peer ")+8,"Use a fresh explicitly named local RFCOMM fixture");let tail=name+h_len("Collie RFCOMM test peer ");let i=0;while i<8{let c=load8(tail+i);h_assert((c>=48&&c<=57)||(c>=97&&c<=102),"Invalid controlled RFCOMM peer name");i=i+1;}let address=bp_address(peer);let uuid=bp_uuid(cj_text(peer,"uuid"));if !at_child{at_extra=ar_snapshot(1,0);h_assert(cj_int(at_extra,"bluetooth"),"Enable the owned Bluetooth controller first");j_set(at_extra,"peer_name",j_string(name));j_set(at_extra,"peer_address",j_string(address));return at_parent(argc,argv);}bp_source=h_read("apps/collie/tests/bluetooth-peer-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");bp_grant("android.permission.BLUETOOTH_CONNECT");h_assert(btp_unbonded(address),"Preserve an existing peer pairing");j_set(at_extra,"pair_started",j_bool(1));at_checkpoint_extra();rf_vm("connect",h_args(bp_string(address),bp_string(uuid),mode,0,0,0));at_pass("an actual Android RFCOMM connection starts asynchronously to the explicitly named local virtual peer");btp_confirm(cj_text(peer,"name"));rf_vm("connected",h_vec());at_pass("SDP resolution and the actual RFCOMM channel complete before the VM receives connected");rf_vm("echo",h_vec());let proof=bp_wait("echoed",40);h_assert(cj_int(proof,"bytes_received")==32768&&j_kind(cj_get(proof,"error"))==0,j_dump(proof));if secure{h_assert(at_bool(cj_get(proof,"encrypted")),"Secure RFCOMM peer did not observe actual link encryption");}at_pass("32KiB crosses the Android RFCOMM channel in both directions, checked independently by the Flexscript VM and virtual-peer byte oracle");rf_vm("timeout",h_vec());bp_wait("closed",40);at_pass("a real byte-read timeout closes the stream, invalidates the handle and reaches the peer as channel closure");let report=j_object();j_set(report,"peer_payload_verified",j_bool(1));j_set(report,"secure_pairing_verified",j_bool(secure));j_set(report,"encrypted",j_bool(cj_int(proof,"encrypted")));return at_finish(report);
}
