    lp_reset(j_bool(1));ct_continued(ct_execute("fn main(){return worker_start(\"Reader\",\"Read workspace\")-1;}","worker-create",0));j_set(ct_config,"agent_id",j_int(1));j_set(lp_policy(),"files_read",j_string("ask"));req=ct_request("open_worker",0);j_set(req,"revision",j_int(1));t=ct_step(req);t=ct_transition("reply",t,"reply",ct_program(lp_error("fs_list(\"/\");"),"worker-read"));o=lp_gate(ct_observe(t),"files_read");t=lp_observation(t,o);req=ct_request("open_worker",0);j_set(req,"revision",j_int(1));t=ct_command(ct_step(req),"permission");t=lp_decide(t,"files_read",j_bool(0));ct_continued(ct_observe(t));ct_pass("workers use the same lazy gates and restore pending requests from their own durable conversation");
