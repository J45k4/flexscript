// First-use capability checkpoint/resume and conservative policy normalization.
import "lib/collie-test.flex";
fn lp_boundary(){if ct_desktop{return "Desktop platform service is unavailable.";}return "requires the Android host";}
fn lp_reset(value){j_set(ct_config,"permissions",ct_grants(value));return 0;}
fn lp_policy(){return cj_get(ct_config,"permissions");}
fn lp_gate(o,key){h_assert(h_equal(cj_text(o,"state"),"permission")&&h_equal(cj_text(cj_get(o,"signal"),"key"),key)&&h_len(cj_text(cj_get(o,"signal"),"operation")),j_dump(o));return o;}
fn lp_observation(t,o){return ct_transition("observation",t,"observation",o);}
fn lp_decide(t,key,value){j_set(lp_policy(),key,value);return ct_command(ct_transition("next",t,0,0),"vm");}
fn lp_error(body){return h_cat3("fn main(){",body,"let e=db_error();db_io(0,1,e,db_len(e));return 0;}");}
fn lp_host(body,key,id){let approved=0;while approved<2{lp_reset(j_string("ask"));let t=ct_begin(lp_error(body),h_cat3(id,"-",h_int(approved)));let o=lp_gate(ct_observe(t),key);t=lp_observation(t,o);t=lp_decide(t,key,j_bool(approved));o=ct_continued(ct_observe(t));if approved{h_assert(h_has(cj_text(o,"stdout"),lp_boundary()),j_dump(o));}else{h_assert(h_equal(cj_text(o,"stdout"),h_cat("Permission denied: ",key)),j_dump(o));}approved=approved+1;}return 0;}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));lp_reset(j_string("ask"));
    let defaults=ct_step(ct_request("permissions",0));let policy=cj_get(defaults,"policy");let pairs=j_value(policy);let i=0;while i<h_count(pairs){h_assert(h_equal(j_value(load64(h_at(pairs,i)+8)),"ask"),"New conversations must start at Ask");i=i+1;}let keys=j_value(ct_grants(j_bool(1)));i=0;while i<h_count(keys){h_assert(cj_get(policy,load64(h_at(keys,i))),"Default permission key missing");i=i+1;}
    let legacy=ct_grants(j_bool(1));j_set(legacy,"internet",j_bool(0));let req=ct_request("permissions",0);j_set(req,"saved",legacy);let migrated=cj_get(ct_step(req),"policy");pairs=j_value(migrated);i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let key=load64(pair);let expected=cj_get(legacy,key);if expected{h_assert(h_equal(j_dump(load64(pair+8)),j_dump(expected)),"Legacy policy changed");}else{h_assert(h_equal(j_value(load64(pair+8)),"ask"),"New capability was preapproved during migration");}i=i+1;}j_set(req,"saved",c_json("{\"internet\":\"true\"}"));let malformed=cj_get(cj_get(ct_step(req),"policy"),"internet");h_assert(j_kind(malformed)==5&&!j_value(malformed),"Malformed permission did not fail closed");ct_pass("new conversations ask by default; old explicit allow/deny values survive; malformed grants fail closed");
    let t=ct_begin("fn main(){let b=alloc(8);store64(b,42);return load64(b)-42;}","compute");let o=ct_continued(ct_observe(t));h_assert(!cj_get(o,"signal"),j_dump(o));ct_pass("plain computation needs no prompt or grant");
    let probes=c_json("{\"internet\":\"http_get(\\\"https://example.com\\\")\",\"files_read\":\"fs_list(\\\"/\\\")\",\"files_write\":\"fs_write(\\\"new.txt\\\",db_text(\\\"data\\\"))\",\"db_read\":\"db_tables()\",\"db_write\":\"db_begin()\",\"history\":\"db_history(0,10)\",\"workers\":\"worker_start(\\\"Helper\\\",\\\"Check data\\\")\",\"vpn\":\"vpn_status()\",\"cellular\":\"cellular_info(-1)\",\"wifi\":\"wifi_info()\",\"bluetooth\":\"bt_info()\",\"nfc\":\"nfc_info()\",\"secure_element\":\"se_open(1000)\",\"input\":\"input_devices(0,16)\",\"biometrics\":\"biometric_info(255)\",\"uwb\":\"uwb_info()\",\"documents\":\"document_trees(0,16)\",\"camera\":\"camera_list(0,16)\",\"screen_capture\":\"screen_info()\",\"accessibility\":\"accessibility_info()\"}");pairs=j_value(probes);i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let key=load64(pair);lp_reset(j_string("ask"));t=ct_begin(lp_error(h_cat(j_value(load64(pair+8)),";")),h_cat("deny-",key));o=lp_gate(ct_observe(t),key);h_assert(!h_exists(h_join(ct_root,"files/new.txt")),"Effect ran before capability decision");t=ct_command(lp_observation(t,o),"permission");h_assert(j_count(cj_get(cj_get(t,"state"),"messages"))==1,j_dump(t));t=ct_command(ct_transition("resume",c_json(j_dump(t)),0,0),"permission");t=lp_decide(t,key,j_bool(0));o=ct_continued(ct_observe(t));h_assert(h_equal(cj_text(o,"stdout"),h_cat("Permission denied: ",key)),j_dump(o));t=lp_observation(t,o);h_assert(j_kind(cj_get(cj_get(t,"state"),"pending_execution"))==0,j_dump(t));i=i+1;}h_assert(!h_exists(h_join(ct_root,"files/new.txt")),"Denied file was created");ct_pass("all twenty tested first-use gates checkpoint before effects, survive restart, and return denial to the original caller");
    let multi=c_json("[[\"cellular_cells(-1,0)\",\"cellular\"],[\"aware_open()\",\"wifi\"],[\"bt_scan(1000)\",\"bluetooth\"],[\"ble_scan(\\\"\\\",\\\"\\\",1000,0)\",\"bluetooth\"]]");i=0;while i<j_count(multi){let row=j_at(multi,i);let op=j_value(j_at(row,0));let primary=j_value(j_at(row,1));lp_reset(j_string("ask"));t=ct_begin(h_cat3("fn main(){if ",op,"{return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}"),h_cat("two-grants-",h_int(i)));o=lp_gate(ct_observe(t),primary);t=lp_observation(t,o);t=lp_decide(t,primary,j_bool(1));o=lp_gate(ct_observe(t),"location");t=lp_observation(t,o);t=lp_decide(t,"location",j_bool(0));o=ct_continued(ct_observe(t));h_assert(h_has(cj_text(o,"stdout"),"denied"),j_dump(o));i=i+1;}ct_pass("multi-permission hardware calls checkpoint separately for each grant before Android I/O and propagate secondary denial");
    let direct=h_args("ble_connect(\"02:00:00:00:00:01\",1000,1000)","ble_server_open(1000)","hid_open(\"Collie\",\"HID\",\"Collie\",0,db_blob(\"x\",1),db_list(),db_list(),1000)","ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,1000)",0,0);i=0;while i<h_count(direct){let approved=0;while approved<2{lp_reset(j_string("ask"));j_set(lp_policy(),"location",j_bool(0));t=ct_begin(lp_error(h_cat(h_at(direct,i),";")),h_cat3(h_cat("direct-gatt-",h_int(i)),"-",h_int(approved)));o=lp_gate(ct_observe(t),"bluetooth");t=lp_observation(t,o);t=lp_decide(t,"bluetooth",j_bool(approved));o=ct_continued(ct_observe(t));if approved{h_assert(h_has(cj_text(o,"stdout"),lp_boundary()),j_dump(o));}else{h_assert(h_equal(cj_text(o,"stdout"),"Permission denied: bluetooth"),j_dump(o));}approved=approved+1;}i=i+1;}ct_pass("direct GATT client/server and HID calls checkpoint only Bluetooth and reach the real non-Android host boundary after approval even with Location denied");
    let approvals=c_json("[[\"nfc_info()\",\"nfc\"],[\"se_open(1000)\",\"secure_element\"],[\"input_devices(0,16)\",\"input\"],[\"biometric_info(255)\",\"biometrics\"],[\"uwb_info()\",\"uwb\"],[\"document_trees(0,16)\",\"documents\"],[\"camera_list(0,16)\",\"camera\"]]");i=0;while i<j_count(approvals){let row=j_at(approvals,i);let key=j_value(j_at(row,1));lp_reset(j_string("ask"));t=ct_begin(lp_error(h_cat(j_value(j_at(row,0)),";")),h_cat("approve-",key));o=lp_gate(ct_observe(t),key);t=lp_observation(t,o);t=lp_decide(t,key,j_bool(1));o=ct_continued(ct_observe(t));h_assert(h_has(cj_text(o,"stdout"),lp_boundary()),j_dump(o));i=i+1;}ct_pass("NFC, secure-element, input, biometric, UWB, document-folder and Camera approvals resume the actual interrupted call and reach the non-Android host boundary without requesting unrelated grants");
    lp_reset(j_string("ask"));t=ct_begin(lp_error("let o=camera_video_options(320,240,15,256000,2000,1048576,1);camera_video_audio_start(\"device-unopened\",o,db_list());"),"camera-audio-gates");o=lp_gate(ct_observe(t),"camera");t=lp_observation(t,o);t=lp_decide(t,"camera",j_bool(1));o=lp_gate(ct_observe(t),"microphone");t=lp_observation(t,o);t=lp_decide(t,"microphone",j_bool(0));o=ct_continued(ct_observe(t));h_assert(h_equal(cj_text(o,"stdout"),"Permission denied: microphone"),j_dump(o));ct_pass("camera video with audio checkpoints Camera and Microphone separately and propagates denial before SDK I/O");
    let hce=h_args("hce_info();","let a=db_list();db_add(a,db_text(\"F0434F4C4C494500\"));hce_open(0,a,1000);","hcef_open(\"4000\",\"02FE000000000001\",1000);","hce_background_status();","hce_background_state();","let a=db_list();db_add(a,db_text(\"F0434F4C4C494501\"));hce_background_install(0,a,\"fn main(){return 0;}\",db_null(),1000);");i=0;while i<h_count(hce){lp_host(h_at(hce,i),"nfc",h_cat("hce-",h_int(i)));i=i+1;}lp_reset(j_string("ask"));j_set(lp_policy(),"nfc",j_bool(0));t=ct_begin(lp_error("hce_background_remove(\"card-unknown\");"),"remove-card-denied");o=ct_continued(ct_observe(t));h_assert(h_has(cj_text(o,"stdout"),lp_boundary()),j_dump(o));ct_pass("HCE inventory, live ISO-DEP/NFC-F and durable callback registration/state checkpoint only NFC; owned removal needs no new grant");
    lp_reset(j_string("ask"));j_set(lp_policy(),"files_write",j_bool(1));let source="fn nested(){let b=alloc(8);store64(b,99);fs_write(\"once.txt\",db_text(\"initial\"));let v=fs_read(\"once.txt\",0,100);if !v{return 1;}db_io(0,1,db_word(v),db_bytes(v));return load64(b)-99;}fn main(){return nested();}";t=ct_begin(source,"allow");o=lp_gate(ct_observe(t),"files_read");let file=h_join(ct_root,"files/once.txt");h_assert(h_equal(h_read(file),"initial"),"Initial write did not finish before suspension");t=lp_observation(t,o);h_save(file,"changed while suspended");t=lp_decide(t,"files_read",j_bool(1));o=ct_continued(ct_observe(t));h_assert(h_equal(cj_text(o,"stdout"),"changed while suspended")&&h_equal(h_read(file),"changed while suspended"),j_dump(o));t=lp_observation(t,o);let messages=cj_get(cj_get(t,"state"),"messages");let outputs=0;i=0;while i<j_count(messages){if h_equal(cj_text(j_at(messages,i),"type"),"custom_tool_call_output"){outputs=outputs+1;}i=i+1;}h_assert(outputs==1,"Expected one correlated result after approval");ct_continued(ct_observe(ct_begin(source,"already-allowed")));ct_pass("approval resumes nested frames and locals without replaying prior effects, and subsequent calls do not prompt");
