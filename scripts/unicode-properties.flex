// Pure Flexscript generator for pinned Unicode grapheme properties.
// Application lookup uses immutable packed ASCII tables, no data-file loading.
import "lib/json.flex";
import "../lib/bytes.flex";
fn ug_hex(text){let value=0;let i=0;while load8(text+i){let c=load8(text+i);let d=-1;if c>=48 && c<=57{d=c-48;}else if c>=65 && c<=70{d=c-55;}else if c>=97 && c<=102{d=c-87;}h_assert(d>=0,"Invalid Unicode hexadecimal range");value=value*16+d;i=i+1;}return value;}
fn ug_property(name){let names=j_parse("[\"Other\",\"CR\",\"LF\",\"Control\",\"Extend\",\"ZWJ\",\"Regional_Indicator\",\"Prepend\",\"SpacingMark\",\"L\",\"V\",\"T\",\"LV\",\"LVT\"]");let i=0;while i<j_count(names){if h_equal(name,j_value(j_at(names,i))){return i;}i=i+1;}h_die(h_cat("Unknown grapheme property ",name));return 0;}
fn ug_read(map,path,kind){
    let text=h_read(path);let at=0;while load8(text+at){let end=at;while load8(text+end) && load8(text+end)!=10{end=end+1;}let line=h_slice(text+at,end-at);at=end;if load8(text+at){at=at+1;}let comment=h_find(line,"#");if comment>=0{line=h_slice(line,comment);}line=h_trim(line);if h_len(line){let semi=h_find(line,";");h_assert(semi>=0,"Unicode property separator");let range=h_trim(h_slice(line,semi));let name=h_trim(line+semi+1);let value=0;let mask=15;let use=1;
        if kind==0{value=ug_property(name);if value==12 || value==13{use=0;}}
        else if kind==1{if h_equal(name,"Extended_Pictographic"){value=16;mask=16;}else{use=0;}}
        else{let second=h_find(name,";");use=second>=0 && h_equal(h_trim(h_slice(name,second)),"InCB");if use{name=h_trim(name+second+1);mask=96;if h_equal(name,"Extend"){value=32;}else if h_equal(name,"Linker"){value=64;}else if h_equal(name,"Consonant"){value=96;}else{h_die("Unknown InCB property");}}}
        if use{let dots=h_find(range,"..");let low=0;let high=0;if dots>=0{low=ug_hex(h_slice(range,dots));high=ug_hex(range+dots+2);}else{low=ug_hex(range);high=low;}h_assert(low<=high && high<1114112,"Unicode scalar range");let i=low;while i<=high{store8(map+i,(load8(map+i)&~mask)|value);i=i+1;}}
    }}return 0;
}
fn ug_encode(out,value,digits){let shift=(digits-1)*6;while shift>=0{let c=63+((value>>shift)&63);if c==92{h_text(out,"\\");}let byte=h_take(1);store8(byte,c);h_append(out,byte,1);shift=shift-6;}return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"unicode-properties UCD-directory output.flex");let base=load64(argv+8);let manifest=j_parse(h_read(h_join(base,"manifest.json")));h_assert(h_equal(j_s(manifest,"version"),"17.0.0"),"Expected Unicode 17.0.0");let files=j_need(manifest,"sources");let i=0;while i<j_count(files){let file=j_at(files,i);h_assert(h_equal(h_sha(h_join(base,j_s(file,"file"))),j_s(file,"sha256")),"Unicode source hash mismatch");i=i+1;}
    let map=alloc(1114112);h_assert(map>0,"Unicode property allocation");bytes_fill(map,0,1114112);ug_read(map,h_join(base,"auxiliary/GraphemeBreakProperty.txt"),0);ug_read(map,h_join(base,"emoji/emoji-data.txt"),1);ug_read(map,h_join(base,"DerivedCoreProperties.txt"),2);
    let out=h_buffer();h_text(out,"// Generated by scripts/unicode-properties.flex from Unicode 17.0.0.\n// Derived Unicode data (c) 2025 Unicode, Inc.\n// Unicode License V3: libs/unicode/LICENSE.txt.\n// Packed records: start(4), end(4), flags(2); six bits per byte, biased by 63.\n// GCB low 4 bits; Extended_Pictographic bit16; InCB Extend32/Linker64/Consonant96.\nfn unicode_property_data(){return \"");let count=0;i=128;while i<1114112{let value=load8(map+i);let end=i;while end+1<1114112 && load8(map+end+1)==value{end=end+1;}if value{ug_encode(out,i,4);ug_encode(out,end,4);ug_encode(out,value,2);count=count+1;}i=end+1;}h_text(out,"\";}\nfn unicode_property_count(){return ");h_text(out,h_int(count));h_text(out,";}\n");h_save(load64(argv+16),h_data(out));syscall(11,map,1114112,0,0,0,0);h_print(1,h_cat3("Generated ",h_int(count)," Unicode property ranges\n"));return 0;
}
