// Separate, same-signature UI instrumentation APK; never part of Collie.
import "../apps/collie/android/build.flex";
fn main(argc,argv){
    h_environment(argc,argv);h_timeout=180000;let collie=0;ab_sdk="/opt/android-sdk";let i=1;
    while i<argc{let key=load64(argv+i*8);i=i+1;h_assert(i<argc,"Missing UI-probe builder value");let value=load64(argv+i*8);if h_equal(key,"--out"){collie=h_real(value);}else if h_equal(key,"--java-home"){ab_java=h_real(value);}else if h_equal(key,"--sdk"){ab_sdk=h_real(value);}else if h_equal(key,"--root"){ab_root=h_real(value);}else{h_die(h_cat("Unknown UI-probe option: ",key));}i=i+1;}
    h_assert(collie&&ab_java,"Provide --out and --java-home");if !ab_root{ab_root=ab_find_root();}ab_out=h_join(collie,"ui-probe");h_mkdir(ab_out);h_setenv("JAVA_HOME",ab_java);h_setenv("PATH",h_cat3(h_join(ab_java,"bin"),":",h_getenv("PATH")));let classes=h_join(ab_out,"classes");let dex=h_join(ab_out,"dex");h_remove(classes);h_remove(dex);h_mkdir(classes);h_mkdir(dex);
    let tools=h_join(ab_sdk,"build-tools/36.1.0");let jar=h_join(ab_sdk,"platforms/android-36/android.jar");let source=h_join(ab_root,"apps/collie/tests/android-ui-probe");let args=h_args(h_executable("javac"),"-source","8","-target","8","-classpath");h_add(args,jar);h_add(args,"-d");h_add(args,classes);h_add(args,h_join(source,"UiProbe.java"));ab_run(args);
    args=h_args(h_join(tools,"d8"),"--min-api","26","--lib",jar,"--output");h_add(args,dex);let files=ab_files(classes,".class",1);i=0;while i<h_count(files){h_add(args,h_at(files,i));i=i+1;}ab_run(args);
    let unsigned=h_join(ab_out,"unsigned.apk");args=h_args(h_join(tools,"aapt2"),"link","-I",jar,"--manifest",h_join(source,"AndroidManifest.xml"));h_add(args,"--version-code");h_add(args,"1");h_add(args,"--version-name");h_add(args,"0.1");h_add(args,"-o");h_add(args,unsigned);ab_run(args);
    let entries=load64(az_open(unsigned)+16);let packed=h_vec();i=0;while i<h_count(entries){h_add(packed,h_at(entries,i));i=i+1;}h_add(packed,az_file("classes.dex",h_join(dex,"classes.dex"),0));az_write(unsigned,packed);
    let aligned=h_join(ab_out,"aligned.apk");ab_run(h_args(h_join(tools,"zipalign"),"-f","4",unsigned,aligned,0));let key=h_join(collie,"development.keystore");h_assert(h_exists(key),"Missing owned Collie development certificate");let apk=h_join(ab_out,"probe.apk");args=h_args(h_join(tools,"apksigner"),"sign","--ks",key,"--ks-key-alias","development");h_add(args,"--ks-pass");h_add(args,"pass:android");h_add(args,"--key-pass");h_add(args,"pass:android");h_add(args,"--out");h_add(args,apk);h_add(args,aligned);ab_run(args);ab_run(h_args(h_join(tools,"apksigner"),"verify",apk,0,0,0));h_print(1,h_cat(apk,"\n"));return 0;
}
