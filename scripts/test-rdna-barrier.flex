// Cross-block acquire/release visibility and generation wrap checks.
import "../libs/os/gpu/driver.flex";
import "lib/build.flex";
fn main(argc,argv){h_environment(argc,argv);h_mkdir("build/llm");let compiler=b_option(argc,argv,"--compiler","build/flex");let source="build/llm/test-barrier-wrap.flex";let image="build/llm/test-barrier-wrap.hsaco";
 h_save(source,h_cat3("import \"",h_real("lib/rdna.flex"),"\";fn kernel(index,input,output,count){let i=0;while i<16{store64(output+index*8,i*100000+index);gpu_rdna_grid_barrier(input);let other=index+512;if other>=count{other=other-count;}if gpu_load_u64(output+other*8)!=i*100000+other{store64(gpu_launch_word(0)+index*8,1);}gpu_rdna_grid_barrier(input);i=i+1;}return 0;}fn main(){return 78;}"));h_ok(h_args(compiler,"--target","rdna-gfx1201",source,"-o",image));
 let context=hip_context_device(0);gd_check(hip_status);let module=gd_module(h_read(image));let function=gd_function(module,"flex_kernel");let stream=gd_stream();let work=gd_buffer(1024);let outputs=gd_buffer(32*512*8+32);let errors=gd_buffer(32*512*8+32);let zero=h_zero(h_take(32*512*8+32),32*512*8+32);let host=h_take(32*512*8+32);let scratch=h_zero(h_take(1024),1024);let workers=h_args(1,2,3,4,5,8);h_add(workers,16);h_add(workers,32);let run=0;
 while run<h_count(workers){let n=h_at(workers,run);let phase=0;while phase<2{let initial=0xffffffff;if phase {initial=-1;}store64(scratch+968,initial);gd_upload(work,scratch,1024);gd_upload(errors,zero,n*512*8+32);gd_upload(outputs,zero,n*512*8+32);let values=h_zero(h_take(88),88);store64(values,work);store64(values+8,outputs);store64(values+16,n*512);store64(values+24,errors);let args=h_take(88);let i=0;while i<11{store64(args+i*8,values+i*8);i=i+1;}gd_launch(function,n,stream,args);gd_wait(stream);
 gd_check(hip_download(host,errors,n*512*8+32));i=0;while i<n*512+4{h_assert(!load64(host+i*8),"barrier visibility/guard mismatch");i=i+1;}gd_check(hip_download(host,work,1024));h_assert(load64(host+968)==initial+32 && !load64(host+960),"barrier generation wrap/arrival mismatch");phase=phase+1;}h_print(1,h_cat3("Barrier visibility/wrap workers ",h_int(n)," pass\n"));run=run+1;}
 gd_free(work);gd_free(outputs);gd_free(errors);gd_unload(module);gd_stream_close(stream);gd_check(hip_close(context));return 0;}
