import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("fn ordinary(x){return x+1;}",0,"NO VERIFICATION REQUESTED");
    ps_verify("requires x < 0x7fffffffffffffff; ensures result == old(x)+1; ensures result>old(x); fn increment(x){return x+1;}",0,"Verified roots: 1/1");
    let p=ps_verify("ensures result>x; fn bad(x){return x+1;}",1,"COUNTEREXAMPLE: postcondition");
    t_assert(h_has(h_out(p),"x = 0x7fffffffffffffff"),"missing signed overflow witness");
    t_native("fn bad(x){return x+1;} fn main(){return bad(0x7fffffffffffffff)>0x7fffffffffffffff;}",0,"");
    ps_verify("ensures (result & mask)==(value & mask); ensures (result & ~mask)==(word & ~mask); fn field(word,mask,value){return (word & ~mask)|(value & mask);}",0,"Verified roots: 1/1");
    ps_verify("requires limit>=0; ensures result>=0 && result<=limit; fn clamp(x,limit){if x<0{return 0;} if x>limit{return limit;} return x;}",0,"Verified roots: 1/1");
    ps_verify("requires x==0; ensures result==1; fn mutate(x){x=x+1; assert x==1; return x;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==old(x)+1; ensures x==result; fn mutate(x){x=x+1;return x;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==old(x); fn scope(x){{let x=55;assert x==55;} return x;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==0; fn empty(){}",0,"Verified roots: 1/1");
    ps_verify("ensures result==2; fn branch(x){let a=1;if x{a=2;}else{a=2;}return a;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==1; fn early(x){if x{return 1;}else{return 2;}return 1;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("verify; fn bad(){let x=1/0;return x;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("verify; fn bad(){return 0x8000000000000000 / -1;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("verify; fn bad(){return 0x8000000000000000 % -1;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("verify; fn good(x){return x!=0 && 1/x;}",0,"Verified roots: 1/1");
    ps_verify("verify; fn good(x){return x==0 || 1/x;}",0,"Verified roots: 1/1");
    ps_verify("verify; fn bad(x){return x==0 && 1/x;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("requires x==1; requires 1/x; verify; fn good(x){return 1/x;}",0,"Verified roots: 1/1");
    ps_verify("requires 1/x; requires x!=0; fn bad(x){return 1;}",1,"COUNTEREXAMPLE: arithmetic safety");
    ps_verify("requires x==1; requires x==2; fn empty(x){return x;}",1,"VACUOUS: requirements are unsatisfiable");
    p=ps_verify("requires 1/x; requires 0; fn bad(x){return x;}",1,"VACUOUS: requirements are unsatisfiable");
    t_assert(h_has(h_out(p),"COUNTEREXAMPLE: arithmetic safety"),"vacuity hid unsafe requirement");
    ps_verify("ensures result==old(x); fn chain(x){return helper(x);} fn helper(x){return leaf(x);} fn leaf(x){return x;}",0,"checked call closure: chain helper leaf");
    ps_verify("requires x==1; ensures result==1; fn helper(x){return x;} verify; fn caller(){return helper(0);}",1,"COUNTEREXAMPLE: callee requirement");
    ps_verify("requires x==1; ensures result==1; fn helper(x){return x;} verify; fn caller(){return helper(1);}",0,"Verified roots: 2/2");
    ps_verify("fn assertion(x){assert x==x;return x;}",0,"Verified roots: 1/1");
    ps_verify("fn assertion(x){assert x==0;return x;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("ensures result==old(x); fn shift(x){return x<<64;}",0,"Verified roots: 1/1");
    ps_verify("ensures result== -1; fn sign(){return 0x8000000000000000>>63;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==0x8000000000000000; fn min(){return -0x8000000000000000;}",0,"Verified roots: 1/1");
    ps_verify("ensures result== -2; fn product(){return 0x7fffffffffffffff*2;}",0,"Verified roots: 1/1");
    ps_verify("ensures result== -2; fn quotient(){return -7/3;}",0,"Verified roots: 1/1");
    ps_verify("ensures result== -1; fn remainder(){return -7%3;}",0,"Verified roots: 1/1");
    ps_verify("ensures result== -3; fn quotient(){return -7/3;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("ensures result==1; fn truth(){return 0x8000000000000000 && 2;}",0,"Verified roots: 1/1");
    t_program("verify; fn bounded(x){return x+1;}");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=1",0,0));h_check(p,1,0);
    t_assert(h_has(h_out(p),"UNPROVED: requirement satisfiability"),"budget exhaustion was not reported");
    t_assert(!h_has(h_out(p),"PROVED: supported"),"exhausted proof reported success");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=0",0,0));h_check(p,1,0);t_assert(h_has(h_err(p),"verification budget"),"zero budget accepted");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=1000000001",0,0));h_check(p,1,0);t_assert(h_has(h_err(p),"verification budget"),"oversize budget accepted");
    p=h_run(h_args(t_compiler,"verify",t_fixture,"--budget=bad",0,0));h_check(p,1,0);t_assert(h_has(h_err(p),"verification budget"),"nonnumeric budget accepted");
    ps_verify("verify; fn recur(x){return recur(x);}",1,"UNPROVED: recursive calls");
    ps_verify("verify; fn loop(x){while x{x=x-1;}return x;}",1,"UNPROVED: loop termination requires decreases");
    ps_verify("global x=0; verify; fn read(){return x;}",0,"reads x; modifies nothing");
    ps_verify("global x=0; verify; fn write(){x=1;return 0;}",0,"reads nothing; modifies x");
    ps_verify("verify; fn memory(p){return load64(p);}",1,"COUNTEREXAMPLE: memory read safety");
    ps_verify("verify; fn foreign(p){return ffi_open(p);}",1,"UNPROVED: external or unsupported");
    ps_verify("verify; fn safe(){if 0{return load64(0);}return 1;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==0; // attachment\n fn zero() {return 0;}",0,"Verified roots: 1/1");
    ps_bad("requires x;", "function contract has no following function");
    ps_bad("requires x; global x=1; fn main(){return 0;}","function contract must attach");
    ps_bad("verify; verify; fn main(){return 0;}","duplicate verify marker");
    ps_bad("requires result; fn main(){return 0;}","undefined contract name");
    ps_bad("requires old(x); fn main(x){return 0;}","old is allowed only once in a postcondition");
    ps_bad("ensures old(old(x)); fn main(x){return 0;}","old is allowed only once in a postcondition");
    ps_bad("ensures old(result); fn main(){return 0;}","result is not available in old");
    ps_bad("ensures local; fn main(){let local=1;return local;}","undefined contract name");
    ps_bad("verify; fn main(){assert absent;return 0;}","undefined name in verifier");
    ps_bad("ensures helper(); fn main(){return 0;} fn helper(){return 1;}","specification calls require");
    ps_bad("verify; fn main(){if 0{missing();}return 0;}","undefined function");
    ps_bad("verify; fn main(){if 0{helper(1);}return 0;} fn helper(){return 0;}","wrong function argument count");
    ps_bad("verify; fn main(){if 0{load64();}return 0;}","wrong builtin argument count");
    ps_verify("modifies nothing; fn main(){return 0;}",0,"Verified roots: 1/1");
    ps_bad("verify; fn main(){ghost let x=1;return x;}","ghost values cannot be used in executable expressions");
    // Verification metadata is erased without evaluating it or adding checks.
    t_native("requires 0; ensures 0; fn main(){assert 0;return 42;}",42,"");
    h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),42,"");t_checks=t_checks+1;
    let annotated=h_sha(t_binary);t_program("fn main(){return 42;}");t_compile();
    t_assert(h_equal(annotated,h_sha(t_binary)),"annotations changed executable bytes");
    t_native("fn assert(x){return x+1;} fn main(){return assert(41);}",42,"");
    ps_verify("fn assert(x){return x+1;} fn main(){return assert(41);}",0,"NO VERIFICATION REQUESTED");
    let library=h_join(t_work,"helper.flex");h_save(library,"ensures result==old(x); fn helper(x){return x;}");
    ps_verify("import \"helper.flex\"; ensures result==x; fn outer(x){return helper(x);}",0,"Verified roots: 2/2");
    h_save(library,"requires x;");ps_bad("import \"helper.flex\"; fn main(){return 0;}","function contract has no following function");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
