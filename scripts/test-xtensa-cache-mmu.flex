// Same real-ROM MMU image in the native machine interpreter and QEMU.
import "lib/esp32-test.flex";
import "lib/esp32-elf.flex";
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let work=b_option(argc,argv,"--work",0);let rom=b_option(argc,argv,"--rom-image",0);h_assert(compiler && work && rom,"requires --compiler --work --rom-image");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_bios=h_dir(h_real(rom));te_legacy=1;let elf=h_join(te_work,"mmu.elf");h_ok(h_args(te_compiler,"--target","esp32-elf","tests/esp32/emulator-cache-mmu.flex","-o",elf));let data=h_read(elf);let parsed=ee_open(data,h_file_size);let image=ee_rom_image(parsed);let size=h_file_size;let path=h_join(te_work,"mmu.bin");h_save_bytes(path,image,size,420);let nor=h_join(te_work,"native-NOR.bin");let flash=h_take(4194304);let i=0;while i<4194304{store8(flash+i,255);i=i+1;}h_copy(flash+4096,image,size);h_save_bytes(nor,flash,4194304,420);let runner=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",runner);let uart=h_join(te_work,"native.uart");let args=h_args(runner,elf,uart,"--rom",h_real(rom),"--flash-nor");h_add(args,nor);h_add(args,"--fuel");h_add(args,"10000000");let result=h_run(args);h_check(result,0,0);h_print(1,h_out(result));let native=h_read(uart);let marker="PASS: real ROM MMU maps,core banks and invalid arguments";te_assert(h_has(native,marker),"native real-ROM MMU probe");let qemu=te_run(path,0,marker);h_save(h_join(te_work,"qemu.uart"),qemu);te_assert(h_has(qemu,native),"complete MMU firmware UART equals QEMU");let report=b_option(argc,argv,"--report",0);if report{let r=j_object();j_set(r,"pass",j_bool(1));j_set(r,"scope_complete",j_bool(0));j_set(r,"physical_hardware",j_bool(0));j_set(r,"ELF_sha256",j_string(h_sha(elf)));j_set(r,"native_result",j_string(h_out(result)));j_set(r,"UART_sha256",j_string(h_sha(uart)));j_set(r,"UART_matches_QEMU",j_bool(1));j_set(r,"QEMU_checks",j_int(te_checks));j_set(r,"ROM_sha256",j_string(h_sha(rom)));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_save(report,r);}h_print(1,"PASS: same real ROM MMU mappings native/QEMU\n");return 0;}
