// Real provider summary events, durable public cards and private continuation.
import "lib/collie-test.flex";
fn th_reasoning(id,texts){let r=j_object();j_set(r,"type",j_string("reasoning"));j_set(r,"id",j_string(id));j_set(r,"encrypted_content",j_string("opaque-private-reasoning"));let parts=j_array();let i=0;while i<j_count(texts){let p=j_object();j_set(p,"type",j_string("summary_text"));j_set(p,"text",j_at(texts,i));j_push(parts,p);i=i+1;}j_set(r,"summary",parts);return r;}
fn th_contains(list,text){let i=0;while i<j_count(list){let v=j_at(list,i);if j_kind(v)==2&&h_equal(j_value(v),text){return 1;}i=i+1;}return 0;}
fn th_body(mode,messages){let r=j_object();j_set(r,"config",ct_config);j_set(r,"messages",messages);return ct_call(mode,r);}
fn main(argc,argv){
    ct_init(argc,argv);j_set(ct_config,"model",j_string("gpt-6.1-sol"));j_set(ct_config,"agent_id",j_int(0));
    let body=th_body(1,c_json("[{\"role\":\"user\",\"content\":\"Calculate\"}]"));h_assert(h_equal(cj_text(cj_get(body,"reasoning"),"summary"),"auto")&&th_contains(cj_get(body,"include"),"reasoning.encrypted_content"),j_dump(body));ct_pass("model requests opt into API reasoning summaries while preserving encrypted continuation");
    let pending=ct_packet(j_object(),c_json("{\"type\":\"response.created\"}"));let display=cj_get(pending,"display");h_assert(cj_int(display,"active")&&h_equal(cj_text(display,"text"),"")&&j_count(cj_get(display,"summaries"))==0,"Pending public stream must be visible without inventing summary text");ct_pass("pending model streams expose activity before the first public summary without generating reasoning text");
    let events=c_json("[{\"type\":\"response.reasoning_summary_part.added\",\"item_id\":\"rs_one\",\"summary_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"\"}},{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_one\",\"summary_index\":0,\"delta\":\"Checking \"},{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_one\",\"summary_index\":0,\"delta\":\"the inputs.\"},{\"type\":\"response.reasoning_summary_text.done\",\"item_id\":\"rs_one\",\"summary_index\":0,\"text\":\"Checking the inputs.\"},{\"type\":\"response.reasoning_summary_part.done\",\"item_id\":\"rs_one\",\"summary_index\":0,\"part\":{\"type\":\"summary_text\",\"text\":\"Checking the inputs.\"}},{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_one\",\"summary_index\":1,\"delta\":\"Now calculating.\"}]");
    let stream=j_object();let e=j_object();j_set(e,"type",j_string("response.output_item.added"));j_set(e,"item",th_reasoning("rs_one",j_array()));let r=ct_packet(stream,e);h_assert(!cj_get(r,"error"),j_dump(r));stream=cj_get(r,"stream");let i=0;
    while i<j_count(events){r=ct_packet(stream,j_at(events,i));h_assert(!cj_get(r,"error")&&h_equal(cj_text(r,"preview"),"")&&!h_has(j_dump(cj_get(r,"stream")),"opaque-private-reasoning"),j_dump(r));stream=cj_get(r,"stream");i=i+1;}
    let texts=c_json("[\"Checking the inputs.\",\"Now calculating.\"]");e=j_object();j_set(e,"type",j_string("response.output_item.done"));j_set(e,"item",th_reasoning("rs_one",texts));r=ct_packet(stream,e);h_assert(!cj_get(r,"error"),j_dump(r));stream=cj_get(r,"stream");let summaries=cj_get(stream,"summaries");h_assert(j_count(summaries)==2&&h_equal(cj_text(j_at(summaries,0),"text"),"Checking the inputs.")&&h_equal(cj_text(j_at(summaries,1),"text"),"Now calculating."),j_dump(stream));
    r=ct_packet(stream,c_json("{\"type\":\"response.reasoning_text.delta\",\"item_id\":\"rs_one\",\"content_index\":0,\"delta\":\"raw-reasoning-must-not-show\"}"));h_assert(h_equal(j_dump(cj_get(r,"stream")),j_dump(stream))&&!h_has(j_dump(cj_get(r,"display")),"opaque-private-reasoning")&&h_equal(cj_text(cj_get(r,"display"),"text"),""),j_dump(r));
    let req=ct_request("stream",0);j_set(req,"stream",c_json("{\"text\":\"Feedback for the program\"}"));j_set(req,"event_json",j_string("[DONE]"));j_set(req,"feedback",j_bool(1));r=ct_step(req);h_assert(h_equal(cj_text(cj_get(r,"display"),"text"),"")&&h_equal(cj_text(cj_get(r,"display"),"feedback"),"Feedback for the program"),j_dump(r));ct_pass("summary deltas, parts and done events preserve multiple parts without duplication or exposing raw/encrypted reasoning");
    r=ct_packet(stream,c_json("{\"type\":\"response.output_text.delta\",\"delta\":\"The answer is 42.\"}"));stream=cj_get(r,"stream");h_assert(h_equal(cj_text(r,"preview"),"The answer is 42."),j_dump(r));let output=ct_one(th_reasoning("rs_one",texts));j_push(output,ct_message("The answer is 42."));r=ct_packet(stream,ct_completed(output));h_assert(cj_int(r,"complete")&&j_count(cj_get(cj_get(r,"reply"),"summaries"))==2&&h_equal(cj_text(cj_get(r,"reply"),"message"),"The answer is 42."),j_dump(r));let reply=cj_get(r,"reply");
    req=ct_request("begin",0);j_set(req,"text",j_string("Calculate"));let t=ct_step(req);req=ct_request("reply",cj_get(t,"state"));j_set(req,"reply",reply);t=ct_step(req);let state=cj_get(t,"state");let cards=cj_get(state,"cards");let kinds=h_args("user","thinking","thinking","assistant",0,0);h_assert(j_count(cards)==4&&!h_has(j_dump(cards),"opaque-private-reasoning"),j_dump(cards));i=0;while i<4{h_assert(h_equal(cj_text(j_at(cards,i),"kind"),h_at(kinds,i)),j_dump(cards));i=i+1;}
    let archive=cj_get(state,"archive");i=0;while i<j_count(archive){h_assert(!h_equal(cj_text(j_at(archive,i),"type"),"reasoning"),"Private reasoning entered public archive");i=i+1;}h_assert(h_equal(cj_text(j_at(cj_get(j_at(cj_get(state,"messages"),1),"summary"),1),"text"),"Now calculating."),j_dump(state));let empty=th_body(6,ct_one(th_reasoning("rs_tokens",j_array())));let full=th_body(6,ct_one(th_reasoning("rs_tokens",ct_one(j_string(h_repeat("t",4000))))));h_assert(cj_int(cj_get(full,"usage"),"total_tokens")>=cj_int(cj_get(empty,"usage"),"total_tokens")+1000,"Summary tokens were not counted");ct_pass("completed summaries become persistent public cards while assistant text, archives and private reasoning stay separate");
    output=ct_one(th_reasoning("rs_final",ct_one(j_string("Only in the completed response."))));j_push(output,ct_message("Done"));r=ct_packet(j_object(),ct_completed(output));h_assert(h_equal(cj_text(j_at(cj_get(cj_get(r,"reply"),"summaries"),0),"text"),"Only in the completed response."),j_dump(r));r=ct_packet(stream,ct_completed(ct_one(ct_message("The answer is 42."))));h_assert(j_count(cj_get(cj_get(r,"reply"),"summaries"))==2,j_dump(r));ct_pass("non-streamed summaries and summaries omitted from the final event retain the actual API text");
    let invalid=c_json("[{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_bad\",\"summary_index\":-1,\"delta\":\"bad\"},{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_bad\",\"summary_index\":\"0\",\"delta\":\"bad\"},{\"type\":\"response.reasoning_summary_text.delta\",\"item_id\":\"rs_bad\",\"summary_index\":0}]");j_set(j_at(invalid,2),"delta",j_string(h_repeat("x",65537)));let needles=h_args("identity","index","64 KiB",0,0,0);i=0;while i<3{r=ct_packet(j_object(),j_at(invalid,i));h_assert(h_has(cj_text(r,"error"),h_at(needles,i)),j_dump(r));i=i+1;}
    output=ct_one(th_reasoning("rs_bad",ct_one(j_string(h_repeat("x",65537)))));j_push(output,ct_message("Done"));req=j_object();j_set(req,"event",ct_completed(output));r=ct_call(2,req);h_assert(cj_get(r,"error"),j_dump(r));ct_pass("stream identities, part types and aggregate summary sizes are checked before display or persistence");
    r=ct_execute("fn main(){return worker_start(\"Checker\",\"Check a value\")-1;}",0,0);h_assert(cj_int(r,"exit_code")==0,j_dump(r));j_set(ct_config,"agent_id",j_int(1));req=ct_request("open_worker",0);j_set(req,"revision",j_int(1));t=ct_step(req);output=ct_one(th_reasoning("rs_worker",c_json("[\"First summary.\",\"Second summary.\"]")));j_push(output,ct_message("Checked 42."));req=j_object();j_set(req,"event",ct_completed(output));reply=ct_call(2,req);h_assert(!cj_get(reply,"error"),j_dump(reply));req=ct_request("reply",cj_get(t,"state"));j_set(req,"reply",reply);t=ct_step(req);h_assert(h_equal(cj_text(cj_get(t,"command"),"kind"),"done"),j_dump(t));j_set(ct_config,"agent_id",j_int(0));req=ct_request("messages",0);j_set(req,"id",j_int(1));j_set(req,"after",j_int(0));r=ct_call(7,req);let rows=cj_get(r,"messages");texts=j_array();let answer=0;i=0;while i<j_count(rows){let row=j_at(j_at(rows,i),1);if h_equal(j_value(j_at(row,3)),"thinking"){j_push(texts,j_at(row,2));}if h_equal(j_value(j_at(row,2)),"Checked 42."){answer=1;}i=i+1;}h_assert(answer&&j_count(texts)==2&&h_equal(j_value(j_at(texts,0)),"First summary.")&&h_equal(j_value(j_at(texts,1)),"Second summary."),j_dump(rows));ct_pass("worker summaries persist independently in the journal and do not replace its actual assistant reply");
    return ct_done(j_object(),"thinking-report.json");
}
