fn main(argc,argv){
    ca_calc="fn main(){let p=alloc(3);store8(p,52);store8(p+1,50);store8(p+2,10);syscall(1,1,p,3,0,0,0);return 0;}";ca_create="fn main(){if(!db_begin()){return 10;}let s=db_schema();db_column(s,\"value\",2,0);if(!db_create(\"notes\",s)){return 11;}let v=db_values();db_add(v,db_text(\"persistent\"));if(!db_insert(\"notes\",v)){return 12;}if(!db_commit()){return 13;}return 0;}";ca_read="fn main(){let r=db_scan(\"notes\",0,10);let v=db_cell(db_at(r,0),0);syscall(1,1,db_word(v),db_bytes(v),0,0,0);return 0;}";
    h_environment(argc,argv);let serial=0;let child=0;let out="build/android-collie";let qemu=0;let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--self-test"){return at_self_test();}if h_equal(key,"--worker")||h_equal(key,"--cleanup"){child=1;i=i+1;}else{i=i+1;h_assert(i<argc,"Test option needs a value");let value=load64(argv+i*8);if h_equal(key,"--serial"){serial=value;}else if h_equal(key,"--out"){out=value;}else if h_equal(key,"--qemu"){qemu=value;}else{h_assert(h_equal(key,"--adb")||h_equal(key,"--auth")||h_equal(key,"--prefix"),"Unknown Android core test option");}i=i+1;}}
    if !child{let saved_env=h_env;let args=h_args(load64(argv),"--out",out,0,0,0);if qemu{h_add(args,"--qemu");h_add(args,qemu);}ct_init(h_count(args),args+8);h_env=saved_env;ca_core();let report=j_object();j_set(report,"engine",j_string("shared Flexscript compiler + checked interpreter + FlexDB"));j_set(report,"physical_arm64_phone",j_bool(0));j_set(report,"native_engine_sha256",j_string(h_sha(h_join(ct_out,"native-test"))));ct_done(report,"android-report.json");}
    if serial{at_cleanup_hook=1;let options=c_json("{\"auth\":\"\",\"qemu\":\"\"}");at_init(argc,argv,"android-core",options);if at_cleanup{return al_cleanup();}if at_child{return ca_android();}return at_parent(argc,argv);}return 0;
}
