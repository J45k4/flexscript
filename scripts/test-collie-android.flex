fn ca_run(source){return ca_execute(source,0,0);}
fn ca_exit(source,code){let r=ca_run(source);h_assert(cj_int(r,"exit_code")==code,j_dump(r));return r;}
fn ca_error(source,text){let r=ca_run(source);h_assert(h_has(cj_text(r,"stdout"),text),j_dump(r));return r;}
