// Refresh the committed browser bundle after changing its JS or CSS sources.
import "../libs/monolith/internal/schema.flex";
fn main() {
    let code=h_buffer();h_text(code,"// Generated by scripts/monolith-assets.flex from client.js and style.css.\n");
    sc_fn(code,"mono_client_js",h_read("libs/monolith/client.js"));
    sc_fn(code,"mono_style_css",h_read("libs/monolith/style.css"));
    h_save("libs/monolith/assets.flex",h_data(code));return 0;
}
