import "lib/esp32-test.flex";
fn ts_reject(args,output,message) {h_save(output,"preserve TLS output");let before=h_sha(output);let p=h_run(args);h_check(p,1,0);te_assert(h_has(h_cat(h_out(p),h_err(p)),message),h_err(p));te_assert(h_equal(before,h_sha(output)),"TLS rejection preserves output");return 0;}
fn main(argc,argv) {
    h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let vendor=b_option(argc,argv,"--vendor",0);let rom=b_option(argc,argv,"--rom",0);let tls=b_option(argc,argv,"--tls",0);let prefix=b_option(argc,argv,"--prefix","xtensa-esp32-elf-");
    h_assert(compiler && vendor && rom && tls,"requires --compiler PATH --vendor RADIO --rom ROM_DIRECTORY --tls TLS_ARCHIVES [--prefix GNU_PREFIX --qemu PATH]");te_init(compiler);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_legacy=1;te_xip=1;
    h_compile(te_compiler,"tests/esp32/civil-time-runtime.flex",te_fixture);h_check(h_run(h_args(te_fixture,0,0,0,0,0)),0,"");te_checks=te_checks+1;
    let link=h_join(te_work,"link");h_compile(te_compiler,"scripts/esp32-link.flex",link);h_ok(h_args(te_compiler,"--target","esp32-xip-elf","tests/esp32/civil-time-xip.flex","-o",te_fixture));let a=h_args(link,"--firmware",te_fixture,"--output",h_join(te_work,"linked.elf"),"--xip");h_add(a,"--ld");h_add(a,h_cat(prefix,"ld"));h_add(a,"--rom");h_add(a,h_join(rom,"esp32.rom.ld"));h_add(a,"--image");h_add(a,te_binary);h_ok(a);te_run(te_binary,0,0);
    h_ok(h_args(te_compiler,"--target","esp32-radio-elf","tests/esp32/native-sdk-heap.flex","-o",te_fixture));let ram=h_args(link,"--firmware",te_fixture,"--output",h_join(te_work,"ram.elf"),"--ld");h_add(ram,h_cat(prefix,"ld"));h_add(ram,"--rom");h_add(ram,h_join(rom,"esp32.rom.ld"));h_add(ram,"--image");h_add(ram,te_binary);h_ok(ram);te_xip=0;te_run(te_binary,0,0);
    h_ok(h_args(te_compiler,"--target","esp32-xip-elf","tests/esp32/native-sdk-heap-xip.flex","-o",te_fixture));h_ok(a);te_xip=1;te_run(te_binary,0,0);
    let builder=h_join(te_work,"radio-build");h_compile(te_compiler,"scripts/build-esp32-radio.flex",builder);let certificates=h_join(te_work,"certificates");h_ok(h_args("python3","tests/esp32/tls-certificates.py",certificates,0,0,0));
    let names=h_args("tls13-ecdsa","tls12-rsa","wrong-host","untrusted-ca","expired","future");h_add(names,"tampered-record");h_add(names,"truncated-stream");h_add(names,"backpressure");h_add(names,"tcp-refused");h_add(names,"native-no-memory");h_add(names,"scheduler-progress");let i=0;
    while i<h_count(names) {
        let name=h_at(names,i);a=h_args("python3","tests/esp32/tls-interop.py","--compiler",te_compiler,"--builder",builder);h_add(a,"--qemu");h_add(a,te_qemu);h_add(a,"--prefix");h_add(a,prefix);h_add(a,"--vendor");h_add(a,h_absolute(vendor));h_add(a,"--rom");h_add(a,h_absolute(rom));h_add(a,"--tls");h_add(a,h_absolute(tls));h_add(a,"--work");h_add(a,h_join(te_work,"interop"));h_add(a,"--certificates");h_add(a,certificates);h_add(a,"--case");h_add(a,name);let p=h_ok(a);te_assert(h_has(h_out(p),h_cat("PASS: ",name)),h_out(p));h_print(1,h_cat3("TLS/OpenSSL ",name,": passed\n"));i=i+1;
    }
    // Wrong source bytes, a mismatched profile and a corrupted archive must
    // fail without replacing a previously good firmware output.
    let output=h_join(te_work,"protected.bin");let bad=h_join(te_work,"bad-tls");h_mkdir(bad);let report=j_parse(h_read(h_join(tls,"flexscript-tls.json")));j_set(report,"profile_sha256",j_string("wrong profile"));h_save(h_join(bad,"flexscript-tls.json"),j_dump(report));
    a=h_args(builder,"--compiler",te_compiler,"--vendor",h_absolute(vendor),"--rom");h_add(a,h_absolute(rom));h_add(a,"--source");h_add(a,h_absolute("examples/esp32-vendor-probe.flex"));h_add(a,"--output");h_add(a,output);h_add(a,"--ld");h_add(a,h_cat(prefix,"ld"));h_add(a,"--gcc");h_add(a,h_cat(prefix,"gcc"));h_add(a,"--tls");h_add(a,bad);ts_reject(a,output,"TLS vendor profile mismatch");
    h_save(h_join(bad,"flexscript-tls.json"),h_read(h_join(tls,"flexscript-tls.json")));h_save(h_join(bad,"libmbedtls.a"),"corrupt vendor archive");ts_reject(a,output,"TLS archive checksum mismatch");
    let vendor_build=h_join(te_work,"tls-build");h_compile(te_compiler,"scripts/build-esp32-tls.flex",vendor_build);let archive=h_join(te_work,"bad.tar.bz2");h_save(archive,"wrong source archive");a=h_args(vendor_build,"--archive",archive,"--output",bad,0);let rejected=h_run(a);h_check(rejected,1,0);te_assert(h_has(h_err(rejected),"official 3.6.7 release checksum"),h_err(rejected));
    h_print(1,"TLS client, certificate policy, authenticated records, clock ABI and ownership checks passed\n");te_done();return 0;
}
