// Raw legacy BLE discovery/advertising against the independent local peer.
import "lib/android-peer-test.flex";
fn main(argc,argv){
    at_cleanup_hook=1;let options=c_json("{\"peer-state\":\"\"}");if at_init(argc,argv,"ble",options)<0{return at_self_test();}if at_cleanup{return ar_restore();}bp_path=h_real(cj_text(options,"peer-state"));let peer=bp_read();h_assert(at_bool(cj_get(peer,"ready"))&&cj_int(peer,"seen")==0,"Use a fresh ready controlled BLE peer");let address=bp_address(peer);let service=bp_uuid(cj_text(peer,"service"));let packet=cj_text(peer,"packet");let payload=cj_text(peer,"android_payload");h_unhex(packet);h_unhex(payload);if !at_child{at_extra=ar_snapshot(1,0);h_assert(cj_int(at_extra,"bluetooth"),"Enable the owned virtual Bluetooth controller before testing");return at_parent(argc,argv);}bp_source=h_read("apps/collie/tests/ble-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");ar_set_location("true");let permissions=bp_permissions(1);let i=2;while i>=0{ar_revoke(h_at(permissions,i));i=i-1;}at_vm(h_cat(ut_prefix,"-caps"),bp_program("ble_live_capabilities",h_vec()),c_json("{\"bluetooth\":false,\"location\":false}"));at_pass("capability discovery remains permission-free and distinguishes missing runtime access from known hardware absence");i=0;while i<h_count(permissions){bp_grant(h_at(permissions,i));i=i+1;}at_vm(ut_prefix,bp_program("ble_live_info",h_vec()),c_json("{\"bluetooth\":true,\"location\":true,\"db_read\":true,\"db_write\":true}"));at_pass("actual BLE controller metadata and advertised legacy-advertisement support cross the VM bridge");bp_vm("ble_live_invalid",h_vec());at_pass("invalid UUIDs, addresses, deadlines and anonymous data fields fail before BLE radio operations");bp_vm("ble_live_scan",h_args(bp_string(service),bp_string(address),0,0,0,0));at_vm(ut_prefix,h_cat3(bp_source,"\nfn main(){",h_cat3(bp_blob("expected",packet),"return ble_live_found(",h_cat3(bp_string(address),",expected,",h_cat(h_int(h_len(packet)/2),");}")))),0);at_pass("service-data UUID and exact-address scan filters receive independently generated raw BLE bytes, including zero and high-bit values");bp_vm("ble_live_finished",h_vec());at_pass("bounded scan pages and the real SDK deadline retain a finished snapshot until explicit close");at_vm(ut_prefix,h_cat3(bp_source,"\nfn main(){",h_cat3(bp_blob("data",payload),"return ble_live_advertise(",h_cat3(bp_string(service),",data,",h_cat(h_int(h_len(payload)/2),");}")))),0);bp_wait("seen",40);at_pass("Android starts a real legacy BLE advertisement whose UUID and binary service data are independently observed by the virtual peer");bp_vm("ble_live_close_ad",h_vec());h_sleep(1000);let seen=cj_int(bp_read(),"seen");h_sleep(1000);h_assert(cj_int(bp_read(),"seen")==seen,"Closed advertisement still reaches peer");at_pass("closing the advertisement actually stops its matching radio packets at the independent peer");bp_vm("ble_live_wrong_handle",h_vec());at_pass("a real Classic Bluetooth watcher cannot be used as a BLE scan snapshot");bp_vm("ble_live_oversize",h_args(bp_string(service),0,0,0,0,0));at_pass("an oversized but well-formed field combination reaches Android and reports its actual ADVERTISE_FAILED_DATA_TOO_LARGE callback");at_vm(h_cat(ut_prefix,"-deny-bt"),bp_program("ble_live_deny",h_args("1",0,0,0,0,0)),c_json("{\"bluetooth\":false,\"location\":true}"));at_pass("BLE enforces independent Bluetooth denial even with Android runtime access already granted");at_vm(h_cat(ut_prefix,"-deny-location"),bp_program("ble_live_deny",h_args("0",0,0,0,0,0)),c_json("{\"bluetooth\":true,\"location\":false}"));at_pass("BLE enforces independent Location denial even with Android runtime access already granted");let report=j_object();j_set(report,"scan_payload_verified",j_bool(1));j_set(report,"advertisement_payload_verified",j_bool(1));j_set(report,"gatt_verified",j_bool(0));return at_finish(report);
}
