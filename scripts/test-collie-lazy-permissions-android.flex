// First-use policy, checkpoint/restart and worker approvals through real views.
import "lib/collie-android-test.flex";
global lp_source=0;
fn lp_program(call){return h_cat3(lp_source,"\nfn main(){return lazy_live_",h_cat(call,"();}"));}
fn lp_state(sid){return ut_read(h_cat3("files/workspaces/",sid,"/session.json"));}
fn lp_policy(sid){return cj_get(lp_state(sid),"permissions");}
fn lp_exists(sid,file){return h_status(ut_call(ut_args("shell","run-as","org.flexscript.collie","test","-f",h_cat3("files/workspaces/",sid,h_cat("/files/",file))),""))==0;}
fn lp_ask(policy){let pairs=j_value(policy);let i=0;h_assert(j_count(policy)==31,"Expected all capabilities at Ask");while i<h_count(pairs){h_assert(h_equal(j_value(load64(h_at(pairs,i)+8)),"ask"),"Unexpected permission outside Ask");i=i+1;}return 0;}
fn lp_file(sid,text){return at_write(h_cat3("files/workspaces/",sid,"/files/once.txt"),text);}
fn lp_worker_wait(sid,one){let end=net_now()+40000;while net_now()<end{let i=1;while i<=2{let s=ut_read(h_cat3("files/workspaces/",sid,h_cat3("/worker-",h_int(i),".json")));if s&&h_equal(cj_text(s,"phase"),"permission"){return s;}if one{i=2;}i=i+1;}h_sleep(50);}h_die("No actual worker approval request");return 0;}
fn lp_workers(source,two){let workers=j_object();let i=1;let limit=1;if two{limit=2;}while i<=limit{let events=ut_responses(source);let call=j_at(cj_get(cj_get(j_at(events,0),"response"),"output"),0);j_set(call,"id",j_string(h_cat("ctc_reader",h_int(i))));j_set(call,"call_id",j_string(h_cat("call_reader",h_int(i))));j_set(workers,h_int(i),events);i=i+1;}let p=j_object();j_set(p,"worker_responses",workers);return p;}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"lazy-permissions",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}lp_source=h_read("apps/collie/tests/lazy-permissions-live.flex");let sid=h_cat(ut_prefix,"-allow");let name=at_conversation(sid,lp_program("write_read"),0);let s=at_pending(sid,"files_write","permission",name);lp_ask(cj_get(s,"permissions"));h_assert(!lp_exists(sid,"once.txt")&&h_has(at_xml(),"text=\"Allow access?\""),"Actual approval must precede write");let shot=ut_ok(ut_args("exec-out","screencap","-p",0,0,0),"");h_save_bytes(h_join(ut_out,"lazy-permission-prompt.png"),h_out(shot),h_size(load64(shot+16)),384);at_pass("new conversations start at Ask; the actual access prompt appears before the file write");
    at_click("text","Allow requested access",0);at_pending(sid,"files_read","permission",name);h_assert(lp_exists(sid,"once.txt"),"Earlier approved write did not run");lp_file(sid,"changed");at_click("text","Allow requested access",0);let o=at_observation(at_result(name));h_assert(h_equal(cj_text(o,"stdout"),"changed"),"Checkpoint replayed the earlier write");let policy=lp_policy(sid);h_assert(at_bool(cj_get(policy,"files_read"))&&at_bool(cj_get(policy,"files_write"))&&h_equal(cj_text(policy,"internet"),"ask"),"Approval changed unrelated policy");at_pass("Allow persists only the used capabilities and resumes original locals without replaying the earlier write");
    name=at_conversation(sid,lp_program("read"),0);h_assert(h_equal(cj_text(at_observation(at_result(name)),"stdout"),"changed"),"Later call did not reuse approval");at_pass("later calls reuse the grant without another prompt");sid=h_cat(ut_prefix,"-deny");name=at_conversation(sid,lp_program("deny"),0);at_pending(sid,"files_write","permission",name);at_click("text","Deny requested access",0);o=at_observation(at_result(name));h_assert(h_equal(cj_text(o,"stdout"),"Permission denied: files_write")&&!lp_exists(sid,"denied.txt")&&!at_bool(cj_get(lp_policy(sid),"files_write")),"Deny did not return the real error without writing");at_pass("Deny returns the real VM error and performs no requested file operation");
    sid=h_cat(ut_prefix,"-restart");name=at_conversation(sid,lp_program("write_read"),0);at_pending(sid,"files_write","permission",name);at_click("text","Allow requested access",0);at_pending(sid,"files_read","permission",name);ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");lp_file(sid,"after-restart");let resume=c_json("{\"resume_pending\":true}");j_set(resume,"responses",c_json("[{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"unused\"}]}]}},{\"type\":\"response.completed\",\"response\":{\"status\":\"completed\",\"output\":[{\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"Resumed\"}]}]}}]"));let resumed=at_start(sid,resume);at_pending(sid,"files_read","permission",resumed);at_click("text","Allow requested access",0);o=at_observation(at_result(resumed));h_assert(h_equal(cj_text(o,"stdout"),"after-restart"),"Restart replayed completed effects");at_pass("process restart restores the unresolved request and checkpoint without replaying completed effects");
    sid=h_cat(ut_prefix,"-cancel");name=at_conversation(sid,lp_program("cancel"),0);at_pending(sid,"files_write","permission",name);at_click("text","Stop this task",0);let r=at_result(name);let messages=cj_get(r,"messages");o=0;let i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output"){o=c_json(cj_text(m,"output"));}h_assert(!h_equal(cj_text(m,"role"),"assistant")||!h_equal(cj_text(m,"type"),"message"),"Stop continued the model reply");i=i+1;}h_assert(o&&h_has(cj_text(o,"stderr"),"Cancelled")&&!lp_exists(sid,"cancelled.txt")&&h_equal(cj_text(lp_policy(sid),"files_write"),"ask"),"Stop changed Ask or ran an effect");at_pass("Stop cancels the task, leaves Ask unchanged and does not continue the model loop");
    sid=h_cat(ut_prefix,"-workers");name=at_conversation_payload(sid,lp_program("coordinator"),0,lp_workers(lp_program("reader"),1));at_pending(sid,"workers","permission",name);at_click("text","Allow requested access",0);lp_worker_wait(sid,0);at_click("text","Allow requested access",0);r=at_result(name);let workers=cj_get(r,"workers");h_assert(j_count(workers)==2,"Expected both actual workers");i=0;while i<2{h_assert(h_equal(j_value(j_at(j_at(j_at(workers,i),1),2)),"done"),"Worker did not complete");i=i+1;}h_assert(at_bool(cj_get(lp_policy(sid),"files_read")),"Workers did not share approval");at_pass("worker requests use the same approval UI and one conversation grant serves both workers without blocking the VM engine");
    let expected=at_copy(lp_policy(sid));j_set(expected,"files_read",j_string("ask"));at_click("text","Menu",0);at_click("text","Permissions",0);at_click("text","Ask for Read workspace files",0);let end=net_now()+10000;while net_now()<end&&!h_equal(j_dump(lp_policy(sid)),j_dump(expected)){h_sleep(50);}h_assert(h_equal(j_dump(lp_policy(sid)),j_dump(expected)),"Settings changed unrelated policy");shot=ut_ok(ut_args("exec-out","screencap","-p",0,0,0),"");h_save_bytes(h_join(ut_out,"lazy-permission-settings.png"),h_out(shot),h_size(load64(shot+16)),384);at_pass("Ask/Allow/Deny settings persist and an allowed capability can be reset to Ask");
    sid=h_cat(ut_prefix,"-background");name=at_conversation_payload(sid,lp_program("background"),0,lp_workers(lp_program("background_write"),0));at_pending(sid,"workers","permission",name);at_click("text","Allow requested access",0);at_result(name);lp_worker_wait(sid,1);let other=h_cat(ut_prefix,"-switched");at_case(other,c_json("{\"resume_only\":true}"));lp_ask(lp_policy(other));h_assert(!lp_exists(sid,"old-conversation.txt")&&!h_has(at_xml(),"text=\"Allow access?\""),"Old worker prompt affected the new workspace");at_pass("changing conversations cancels old worker requests and cannot grant access to the new workspace");return at_finish(j_object());
}
