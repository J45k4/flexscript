// Real shared views, PlatformTask model effects and resumed VM on an owned emulator.
import "lib/android-ui-test.flex";
fn aa_event(text){let event=at_copy(j_at(ut_responses("fn main(){return 0;}"),1));j_set(j_at(cj_get(j_at(cj_get(cj_get(event,"response"),"output"),0),"content"),0),"text",j_string(text));return event;}
fn aa_review(allowed,delay){let outcome="deny";if allowed{outcome="allow";}let verdict=c_json("{\"risk_level\":\"low\",\"user_authorization\":\"high\",\"rationale\":\"Controlled exact-call review\"}");j_set(verdict,"outcome",j_string(outcome));let event=aa_event(j_dump(verdict));j_set(event,"_delay_ms",j_int(delay));return event;}
fn aa_responses(source,allowed,count,delay){let normal=ut_responses(source);let call=j_at(cj_get(cj_get(j_at(normal,0),"response"),"output"),0);j_set(call,"id",j_string(h_cat("ctc_auto_",h_int(ut_sequence+1))));j_set(call,"call_id",j_string(h_cat("call_auto_",h_int(ut_sequence+1))));let list=j_array();j_push(list,j_at(normal,0));let i=0;while i<count{j_push(list,aa_review(allowed,delay));i=i+1;}j_push(list,aa_event("Controlled auto-review check complete."));return list;}
fn aa_saved(sid){return ut_read(h_cat3("files/workspaces/",sid,"/session.json"));}
fn aa_exists(sid,name){return h_status(ut_call(ut_args("shell","run-as","org.flexscript.collie","test","-f",h_cat3("files/workspaces/",sid,h_cat("/files/",name))),""))==0;}
fn aa_prompt(sid,source,allowed,count,delay){let p=j_object();j_set(p,"prompt",j_string("Exercise the controlled local workspace operation."));j_set(p,"responses",aa_responses(source,allowed,count,delay));return at_start(sid,p);}
fn main(argc,argv){
    at_preserve=0;if at_init(argc,argv,"autoreview",j_object())<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}
    let sid=h_cat(ut_prefix,"-ui");let policy=at_basic_grants();j_set(policy,"files_write",j_string("ask"));let p=j_object();j_set(p,"resume_only",j_bool(1));j_set(p,"initial_permissions",policy);at_case(sid,p);
    au_tap("Menu");au_tap("Permissions");au_find("Approval mode");au_tap("Automatically review access requests");let saved=aa_saved(sid);h_assert(h_equal(cj_text(cj_get(saved,"permissions"),"approval_reviewer"),"auto_review")&&h_equal(cj_text(cj_get(saved,"permissions"),"files_write"),"ask"),"Actual Auto-review button did not persist independently of capability grants");let shots=h_join(ut_out,"autoreview-shots");au_shot(shots,"permissions");au_tap("Back to conversation");at_pass("actual Android approval-mode controls persist Auto-review without allowing the underlying Ask capability");
    let source="fn main(){let p=alloc(3);store8(p,52);store8(p+1,50);store8(p+2,10);db_io(0,1,p,3);if !fs_write(\"approved.txt\",db_text(\"once\")){return 1;}if !fs_write(\"approved.txt\",db_text(\"once\")){return 2;}return 0;}";
    let name=aa_prompt(sid,source,1,2,1200);let result=at_result(name);let o=at_observation(result);h_assert(cj_int(o,"exit_code")==0&&h_equal(cj_text(o,"stdout"),"42\n")&&aa_exists(sid,"approved.txt"),j_dump(o));saved=aa_saved(sid);let cards=cj_get(saved,"cards");let reviews=0;let i=0;while i<j_count(cards){if h_starts(cj_text(j_at(cards,i),"text"),"Auto-review approved:"){reviews=reviews+1;}i=i+1;}h_assert(reviews==2&&h_equal(cj_text(cj_get(saved,"permissions"),"files_write"),"ask"),"Approval was broadened or an identical later call skipped review");au_find("Expand thinking");au_tap("Expand thinking");h_assert(h_has(at_xml(),"Auto-review approved: Write workspace files. Controlled exact-call review"),"Expanded native Thinking panel omitted review decisions");au_shot(shots,"approved");at_pass("PlatformTask consumes two isolated reviewer replies, resumes the same VM, and displays real review decisions inside Thinking");
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");p=j_object();j_set(p,"resume_only",j_bool(1));at_case(sid,p);saved=aa_saved(sid);h_assert(h_equal(cj_text(cj_get(saved,"permissions"),"approval_reviewer"),"auto_review"),"Restart lost reviewer selection");at_pass("approval mode survives process recreation");
    source="fn main(){if fs_write(\"denied.txt\",db_text(\"no\")){return 1;}let e=db_error();db_io(0,1,e,db_len(e));return 0;}";name=aa_prompt(sid,source,0,1,0);o=at_observation(at_result(name));h_assert(cj_int(o,"exit_code")==0&&h_has(cj_text(o,"stdout"),"Auto-review denied")&&!aa_exists(sid,"denied.txt"),j_dump(o));at_pass("a denied reviewer reply prevents the actual Android workspace write and reaches the model observation");
    name=aa_prompt(sid,source,1,1,15000);let end=net_now()+20000;let pending=0;while net_now()<end&&!pending{saved=aa_saved(sid);pending=cj_int(cj_get(saved,"pending_execution"),"reviewing");if !pending{h_sleep(100);}}h_assert(pending&&!aa_exists(sid,"denied.txt"),"Review did not pause before side effects");au_tap("Stop response");at_result(name);h_assert(!aa_exists(sid,"denied.txt"),"Cancelled review wrote a file");at_pass("stopping an in-flight Android review leaves the paused operation unexecuted");
    au_tap("Menu");au_tap("Permissions");au_tap("Review access requests myself");saved=aa_saved(sid);h_assert(h_equal(cj_text(cj_get(saved,"permissions"),"approval_reviewer"),"user"),"Manual mode did not persist");au_tap("Back to conversation");name=aa_prompt(sid,source,1,0,0);at_pending(sid,"files_write","permission",name);at_click("text","Deny requested access",0);o=at_observation(at_result(name));h_assert(!aa_exists(sid,"denied.txt"),"Manual denial wrote a file");at_pass("switching back to Ask me restores the native lazy-permission prompt");return at_finish(j_object());
}
