// Independent GNU window instructions and the same linked native C image in
// our machine-code emulator and Espressif QEMU. No compiler bootstrap/download.
import "lib/esp32-test.flex";
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let work=b_option(argc,argv,"--work",0);h_assert(compiler && work,"requires --compiler PATH --work DIR");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_legacy=1;let assembler=h_real(h_executable(b_option(argc,argv,"--as","xtensa-esp32-elf-as")));let copy=h_real(h_executable(b_option(argc,argv,"--objcopy","xtensa-esp32-elf-objcopy")));let cc=h_real(h_executable(b_option(argc,argv,"--cc","xtensa-esp32-elf-gcc")));let ld=h_real(h_executable(b_option(argc,argv,"--ld","xtensa-esp32-elf-ld")));
 let object=h_join(te_work,"instructions.o");let elf=h_join(te_work,"instructions.elf");let raw=h_join(te_work,"instructions.bin");let meta=h_join(te_work,"metadata.bin");h_ok(h_args(assembler,"tests/xtensa/window-instructions.S","-o",object,0,0));let args=h_args(ld,"-Ttext=0x1000","--section-start=.windowmeta=0x3000","-e","_start",object);h_add(args,"-o");h_add(args,elf);h_ok(args);h_ok(h_args(copy,"-O","binary","--only-section=.text",elf,raw));h_ok(h_args(copy,"-O","binary","--only-section=.windowmeta",elf,meta));let units=h_join(te_work,"windows");h_compile(te_compiler,"tests/xtensa/windows.flex",units);let result=h_run(h_args(units,raw,meta,0,0,0));h_check(result,0,0);let unit_output=h_out(result);h_print(1,unit_output);
 let c_object=h_join(te_work,"oracle.o");args=h_args(cc,"-Os","-fno-optimize-sibling-calls","-fno-inline","-fno-builtin","-mlongcalls");h_add(args,"-mtext-section-literals");h_add(args,"-c");h_add(args,"tests/esp32/abi-oracle/abi-fixture.c");h_add(args,"-o");h_add(args,c_object);h_ok(args);let asm_object=h_join(te_work,"abi-windows.o");h_ok(h_args(assembler,"tests/esp32/abi-oracle/abi-windows.S","-o",asm_object,0,0));let unlinked=h_join(te_work,"unlinked.elf");h_ok(h_args(te_compiler,"--target","esp32-elf","tests/esp32/emulator-windows.flex","-o",unlinked));let link=h_join(te_work,"link");h_compile(te_compiler,"scripts/esp32-link.flex",link);let linked=h_join(te_work,"linked.elf");let image=h_join(te_work,"linked.bin");args=h_args(link,"--firmware",unlinked,"--output",linked,"--object");h_add(args,c_object);h_add(args,"--object");h_add(args,asm_object);h_add(args,"--image");h_add(args,image);h_add(args,"--ld");h_add(args,ld);h_ok(args);
 let board=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",board);let serial=h_join(te_work,"native.uart");result=h_run(h_args(board,linked,serial,"--fuel","100000000",0));h_check(result,0,0);let output=h_out(result);h_print(1,output);te_assert(h_has(output,"Windows: overflow="),"native GNU recursion exercised window exceptions");let text=h_read(serial);let marker="PASS: GNU C windows,8 arguments,deep spills/refills and reentrant callbacks";te_assert(h_has(text,marker),"native GNU window ABI probe");let qemu_text=te_run(image,0,marker);h_save(h_join(te_work,"qemu.uart"),qemu_text);te_assert(h_has(qemu_text,text),"same linked C image and complete UART in QEMU");let report=b_option(argc,argv,"--report",0);if report{let r=j_object();j_set(r,"pass",j_bool(1));j_set(r,"scope_complete",j_bool(0));j_set(r,"physical_hardware",j_bool(0));j_set(r,"rom_services_executed",j_bool(0));j_set(r,"unit_result",j_string(unit_output));j_set(r,"native_result",j_string(output));j_set(r,"qemu_boots",j_int(te_runs));j_set(r,"qemu_checks",j_int(te_checks));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_set(r,"elf_sha256",j_string(h_sha(linked)));j_set(r,"image_sha256",j_string(h_sha(image)));j_set(r,"uart_sha256",j_string(h_sha(serial)));j_set(r,"gnu_instruction_sha256",j_string(h_sha(raw)));j_set(r,"metadata_sha256",j_string(h_sha(meta)));j_set(r,"uart_matches_qemu",j_bool(1));j_set(r,"limitations",j_string("Original ESP32 linked integer C probe; no ROM calls, FPU or full ISA/exception/S3 parity. Real ROM-linked I2S replay remains T272/T264."));j_save(report,r);}h_print(1,"PASS: GNU window instructions and linked C image match QEMU\n");return 0;}
