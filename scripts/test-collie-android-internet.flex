// Actual public HTTPS capability, URL/budget/redirect/body/deadline and Stop.
// --live explicitly opts into the existing account's real model transport.
import "lib/android-ui-test.flex";
fn ni_fetch(url,extra){return h_cat3("fn main(){let r=http_get(",j_dump(j_string(url)),h_cat(");if !r{let e=db_error();syscall(1,2,e,db_len(e),0,0,0);return 1;}",h_cat(extra,"}")));}
fn ni_request(source){let payload=j_object();j_set(payload,"source",j_string(source));j_set(payload,"initial_permissions",at_basic_grants());return payload;}
fn ni_result(name){let r=at_result(name);let o=cj_get(r,"observation");h_assert(o&&cj_int(o,"executed"),j_dump(r));return o;}
fn ni_vm(source){return ni_result(at_start(ut_prefix,ni_request(source)));}
fn ni_failure(o,text){h_assert(cj_int(o,"exit_code")==1&&h_has(cj_text(o,"stderr"),text),j_dump(o));return 0;}
fn ni_delay(){return h_cat("https://httpbingo.org/delay/10?nocache=",h_int(net_now()));}
fn main(argc,argv){
    at_preserve=0;let options=c_json("{\"live\":false}");if at_init(argc,argv,"internet",options)<0{return at_self_test();}if !at_child{return at_parent(argc,argv);}let o=ni_vm(ni_fetch("https://example.com/","let b=http_body(r);syscall(1,1,db_word(b),db_bytes(b),0,0,0);if http_status(r)!=200{return 2;}return 0;"));h_assert(cj_int(o,"exit_code")==0&&h_has(cj_text(o,"stdout"),"Example Domain"),j_dump(o));at_pass("Guest HTTPS GET fetches Example Domain on selected Android device");let invalid=h_args("http://example.com/","file:///etc/passwd","https://user:secret@example.com/",0,0,0);let i=0;while i<h_count(invalid){ni_failure(ni_vm(ni_fetch(h_at(invalid,i),"return 0;")),"absolute HTTPS URL");i=i+1;}at_pass("Cleartext, local file and user-info URLs return explicit errors");o=ni_vm("fn main(){let i=0;while i<5{http_get(\"http://invalid/\");i=i+1;}let e=db_error();syscall(1,1,e,db_len(e),0,0,0);return 0;}");h_assert(h_has(cj_text(o,"stdout"),"limit (4 per program)"),j_dump(o));at_pass("Four-request budget enforced on device");o=ni_vm(ni_fetch("https://httpbingo.org/redirect-to?url=https%3A%2F%2Fexample.com%2F","let u=http_url(r);syscall(1,1,db_word(u),db_bytes(u),0,0,0);if http_status(r)!=200{return 2;}return 0;"));h_assert(cj_int(o,"exit_code")==0&&h_equal(cj_text(o,"stdout"),"https://example.com/"),j_dump(o));at_pass("HTTPS redirect followed and final URL returned");ni_failure(ni_vm(ni_fetch("https://httpbingo.org/redirect-to?url=http%3A%2F%2Fexample.com%2F","return 0;")),"absolute HTTPS URL");at_pass("Redirect to HTTP rejected");o=ni_vm(ni_fetch("https://httpbingo.org/status/404","if http_status(r)!=404{return 2;}return 0;"));h_assert(cj_int(o,"exit_code")==0,j_dump(o));at_pass("HTTP error status is available to guest");o=ni_vm(ni_fetch("https://httpbingo.org/drip?duration=0&numbytes=40000&code=200","if db_bytes(http_body(r))!=32768{return 2;}if !http_truncated(r){return 3;}return 0;"));h_assert(cj_int(o,"exit_code")==0,j_dump(o));at_pass("Large body bounded at32KiB with truncation flag");let started=net_now();o=ni_vm(ni_fetch(ni_delay(),"return 0;"));let error=cj_text(o,"stderr");h_assert(cj_int(o,"exit_code")==1&&(h_has(error,"8 seconds")||h_has(error,"timeout")||h_has(error,"timed out")||h_has(error,"Timeout"))&&net_now()-started<13000,j_dump(o));at_pass("Slow request times out and returns an observation");started=net_now();let name=at_start(ut_prefix,ni_request(ni_fetch(ni_delay(),"return 0;")));h_sleep(1000);ut_tap(au_find("Stop response"));o=ni_result(name);error=cj_text(o,"stderr");h_assert((h_has(error,"cancel")||h_has(error,"Cancel"))&&net_now()-started<7000,j_dump(o));at_pass("Stop button cancels an in-flight guest HTTPS request");
    if cj_int(options,"live"){let payload=j_object();j_set(payload,"prompt",j_string("Use Flexscript http_get to fetch https://example.com/ now. Print the returned page body, then tell me its heading and HTTP status from the real result. Do not guess."));j_set(payload,"initial_permissions",at_basic_grants());let r=at_case(ut_prefix,payload);let messages=cj_get(r,"messages");let used=0;let actual=0;let answer="";i=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call")&&h_has(cj_text(m,"input"),"http_get"){used=1;}if h_equal(cj_text(m,"type"),"custom_tool_call_output"){let result=c_json(cj_text(m,"output"));if cj_int(result,"exit_code")==0&&h_has(cj_text(result,"stdout"),"Example Domain"){actual=1;}}if h_equal(cj_text(m,"role"),"assistant"){answer=cj_text(m,"content");}i=i+1;}h_assert(used&&actual&&h_has(answer,"Example Domain")&&h_has(answer,"200"),"Live model did not answer from an actual successful HTTP tool result");at_pass("Live agent generates Flexscript HTTPS fetch and answers using real VM output");}
    let report=j_object();j_set(report,"live_model",j_bool(cj_int(options,"live")));return at_finish(report);
}
