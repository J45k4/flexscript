// Actual cellular diagnostics, separate grants and emulator service callbacks.
import "lib/android-radio-test.flex";
global ce_source=0;
fn ce_program(call){return h_cat3(ce_source,"\nfn main(){return cellular_live_",h_cat(call,"();}"));}
fn ce_model(suffix,call,policy){return at_conversation(h_cat(ut_prefix,suffix),ce_program(call),policy);}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"cellular",j_object())<0{return at_self_test();}if at_cleanup{return ar_restore();}if !at_child{at_extra=ar_snapshot(0,1);return at_parent(argc,argv);}
    ce_source=h_read("apps/collie/tests/cellular-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let permissions=h_args("android.permission.READ_PHONE_STATE","android.permission.ACCESS_COARSE_LOCATION","android.permission.ACCESS_FINE_LOCATION",0,0,0);let i=0;while i<3{ar_revoke(h_at(permissions,i));i=i+1;}
    let sid=h_cat(ut_prefix,"-denied-phone");let name=ce_model("-denied-phone","phone_denied",c_json("{\"cellular\":true}"));at_pending(sid,"cellular","platform_permission",name);at_click("resource-id","permission_deny_button",1);at_observation(at_result(name));let state=ut_read(h_cat3("files/workspaces/",sid,"/session.json"));h_assert(!at_bool(cj_get(cj_get(state,"permissions"),"cellular")),"Phone-state denial was not remembered");at_pass("denying Android phone-state consent returns to the original caller and remembers only the cellular denial");ar_clear("android.permission.READ_PHONE_STATE");sid=h_cat(ut_prefix,"-consent");name=ce_model("-consent","info",0);at_pending(sid,"cellular","permission",name);at_click("text","Allow requested access",0);at_pending(sid,"cellular","platform_permission",name);at_click("resource-id","permission_allow_button",1);at_observation(at_result(name));at_pass("cellular diagnostics ask lazily, yield for the real Android phone-state dialog and resume the original VM call");
    name=ce_model("-deny-location","location_denied",c_json("{\"cellular\":true,\"location\":false}"));at_observation(at_result(name));h_assert(!cj_int(cj_get(at_flags(at_package()),"android.permission.ACCESS_FINE_LOCATION"),"granted"),"Cellular alone requested Android Location");at_pass("cellular permission alone cannot read cell identities or trigger Android location approval");ar_set_location("true");sid=h_cat(ut_prefix,"-cells");name=ce_model("-cells","cells",c_json("{\"cellular\":true,\"db_read\":true,\"db_write\":true}"));at_pending(sid,"location","permission",name);at_click("text","Allow requested access",0);at_pending(sid,"location","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));at_pass("cell data additionally asks for Collie Location and Android precise-location consent before reading the modem");at_sdk(sid,c_json("{\"hardware_cellular_tests\":true}"));
    ut_ok(ut_args("emu","gsm","voice","home",0,0),"");name=ce_model("-cells","roaming",0);ar_progress(sid,"Cellular service listener ready",name);ut_ok(ut_args("emu","gsm","voice","roaming",0,0),"");at_observation(at_result(name));at_pass("an injected emulator roaming transition reaches Flexscript through an actual Android service-state callback");ar_set_location("false");at_vm(sid,ce_program("disabled"),0);at_pass("Android Location-switch disablement returns an actionable structured error");return at_finish(j_object());
}
