// Camera2 consent and actual image/video I/O on an owned headless emulator.
import "lib/collie-android-test.flex";
import "lib/image-check.flex";
global cam_source=0;
fn cam_program(call){return h_cat3(cam_source,"\nfn main(){return camera_live_",h_cat(call,"();}"));}
fn cam_at(suffix,call,policy){return at_vm(h_cat(ut_prefix,suffix),cam_program(call),policy);}
fn cam_vm(call){return cam_at("",call,0);}
fn cam_model(suffix,call,policy){return at_conversation(h_cat(ut_prefix,suffix),cam_program(call),policy);}
fn cam_wait(state){let end=net_now()+20000;while net_now()<end{let o=cam_vm("state");if h_equal(cj_text(o,"stdout"),state){return 0;}h_sleep(50);}h_die(h_cat("Camera callback deadline: ",state));return 0;}
fn cam_shutdown(){cam_vm("shutdown");let ready=0;let end=net_now()+20000;while !ready&&net_now()<end{ready=h_equal(cj_text(cam_vm("terminal"),"stdout"),"ready");if !ready{h_sleep(50);}}h_assert(ready,"Camera SDK cleanup did not release its lease");cam_vm("close");return 0;}
fn cam_granted(permission){let flags=at_flags(at_package());return cj_int(cj_get(flags,permission),"granted");}
fn cam_clear(){let args=ut_args("shell","pm","clear-permission-flags","org.flexscript.collie","android.permission.CAMERA","user-set");h_add(args,"user-fixed");ut_ok(args,"");return 0;}
fn cam_finish_video(){h_sleep(1500);cam_vm("video_finish");return at_sdk(ut_prefix,c_json("{\"hardware_camera_tests\":true,\"hardware_camera_video_tests\":true}"));}
fn cam_merge(to,from){if from{let pairs=j_value(from);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);j_set(to,load64(pair),load64(pair+8));i=i+1;}}return 0;}
fn main(argc,argv){
    if at_init(argc,argv,"camera",j_object())<0{return at_self_test();}
    at_result_timeout=300000;at_parent_timeout=1800000;
    if !at_child{return at_parent(argc,argv);}
    cam_source=h_read("apps/collie/tests/camera-live.flex");let permissions=h_args("android.permission.CAMERA","android.permission.RECORD_AUDIO",0,0,0,0);let i=0;while i<2{let permission=h_at(permissions,i);if cam_granted(permission){ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie",permission,0),"");}i=i+1;}
    cam_at("-deny","deny",c_json("{\"camera\":false}"));at_pass("Camera denial prevents SDK inventory access without opening Android permission UI");let name=cam_model("-ask","inventory",c_json("{\"camera\":\"ask\"}"));at_pending(h_cat(ut_prefix,"-ask"),"camera","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));h_assert(!cam_granted("android.permission.CAMERA"),"Inventory requested Android capture permission");at_pass("actual first-use Collie Camera approval resumes public inventory without asking Android for capture access");
    cam_clear();name=cam_model("-os-deny","open_denied",c_json("{\"camera\":true}"));at_pending(h_cat(ut_prefix,"-os-deny"),"camera","platform_permission",name);at_click("resource-id","permission_deny_button",1);at_observation(at_result(name));let s=ut_read(h_cat3("files/workspaces/",ut_prefix,"-os-deny/session.json"));h_assert(!at_bool(cj_get(cj_get(s,"permissions"),"camera")),"OS denial was not remembered");at_pass("declining the actual Android camera dialog resumes the interrupted agent call with denial and remembers it without a prompt loop");
    cam_at("","choose",c_json("{\"camera\":true,\"db_read\":true,\"db_write\":true}"));at_pass("actual SDK camera inventory is accessible through the VM without Android CAMERA runtime access");cam_vm("codecs");h_assert(!cam_granted("android.permission.CAMERA"),"Codec metadata requested Android CAMERA");at_pass("actual recommended and named codec/profile/capability inventory is accessible without Android CAMERA or microphone runtime permission");
    cam_clear();name=cam_model("","open",0);at_pending(ut_prefix,"camera","platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));at_pass("actual Android while-using Camera approval resumes the original VM open request");cam_wait("open");at_pass("Camera2 delivers its actual opened callback through the VM");
    cam_vm("jpeg_configure");cam_wait("configured");at_pass("an exact SDK-advertised JPEG output receives a real configured callback");cam_vm("capture");cam_vm("capture_wait");at_pass("the actual still capture delivers both an ImageReader frame and a completed SDK result");let hex=cj_text(cam_vm("jpeg_read"),"stdout");let jpeg=h_unhex(hex);let path=h_join(ut_out,"camera-capture.jpg");h_save_bytes(path,jpeg,h_len(hex)/2,420);let image=ic_jpeg(path);let expected=h_number(cj_text(cam_vm("dimensions"),"stdout"));h_assert(load64(image)*100000+load64(image+8)==expected,"Independent JPEG dimensions differ from the SDK-selected output");at_pass("an independent JPEG decoder validates the VM-paged encoded frame and exact SDK-selected dimensions");
    cam_vm("timestamps");at_pass("actual image/result sensor timestamps match and explicit frame close invalidates its ID");cam_vm("result_path");at_pass("retained SDK result path queries preserve actual timestamps and reject stale parents before path traversal");cam_vm("yuv_configure");cam_wait("configured");cam_vm("yuv_capture");let yuv=at_sdk(ut_prefix,c_json("{\"hardware_camera_tests\":true,\"hardware_camera_yuv_tests\":true}"));let physical=at_sdk(ut_prefix,c_json("{\"hardware_camera_tests\":true,\"hardware_camera_physical_tests\":true}"));h_assert(at_bool(cj_get(physical,"actual_empty_physical_results_verified"))&&!at_bool(cj_get(physical,"physical_overrides_verified"))&&!at_bool(cj_get(physical,"physical_result_values_verified")),"Synthetic/empty physical camera values cannot be counted as actual physical overrides");cam_shutdown();at_pass("shutdown waits for actual CameraDevice.onClosed and SDK component cleanup before releasing its lease");
    let sdk=at_sdk(ut_prefix,c_json("{\"hardware_camera_tests\":true}"));let encoders=at_copy(cj_get(sdk,"encoder_profiles"));cam_vm("reopen");cam_wait("open");cam_vm("video_open");cam_vm("video_wait");h_assert(!cam_granted("android.permission.RECORD_AUDIO"),"Silent video requested microphone access");at_pass("silent Camera2 recording starts without requesting Android microphone permission");h_sleep(700);cam_vm("video_pause");h_sleep(300);cam_vm("video_resume");at_pass("the real MediaRecorder accepts pause and resume within the active camera recording");let video=cam_finish_video();cam_merge(encoders,cj_get(video,"encoder_profiles"));
    name=cam_model("","audio_start",0);at_pending(ut_prefix,"microphone","permission",name);at_click("text","Allow requested access",0);at_pending(ut_prefix,0,"platform_permission",name);at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));cam_vm("video_wait");at_pass("audio video asks for the separate Collie Microphone grant and actual Android microphone approval before recording");video=cam_finish_video();cam_merge(encoders,cj_get(video,"encoder_profiles"));cam_shutdown();at_sdk(ut_prefix,c_json("{\"hardware_camera_tests\":true,\"hardware_camera_lifecycle_tests\":true}"));
    let report=j_object();j_set(report,"ok",j_bool(1));j_set(report,"output_profiles",cj_get(sdk,"output_profiles"));j_set(report,"raw_depth",cj_get(sdk,"raw_depth"));j_set(report,"encoder_profiles",encoders);j_set(report,"manual_sensor_supported",cj_get(yuv,"manual_sensor_supported"));j_set(report,"manual_sensor_verified",cj_get(yuv,"manual_sensor_verified"));j_set(report,"physical_devices_verified",j_bool(0));j_set(report,"physical_overrides_verified",cj_get(physical,"physical_overrides_verified"));j_set(report,"physical_result_values_verified",cj_get(physical,"physical_result_values_verified"));j_set(report,"actual_empty_physical_results_verified",cj_get(physical,"actual_empty_physical_results_verified"));return at_finish(report);
}
