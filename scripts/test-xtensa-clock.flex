// Same real-ROM PLL/CPU/APB/timer/WAITI image in our emulator and QEMU.
// --qemu-only explicitly records the native probe as unverified.
import "lib/esp32-test.flex";
fn tc_flag(argc,argv,name){let i=1;while i<argc{if h_equal(load64(argv+i*8),name){return 1;}i=i+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let rom=b_option(argc,argv,"--rom-image",0);let symbols=b_option(argc,argv,"--rom-symbols",0);let work=b_option(argc,argv,"--work",0);h_assert(compiler && rom && symbols && work,"requires --compiler --rom-image --rom-symbols --work");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);rom=h_real(rom);symbols=h_real(symbols);h_assert(h_equal(h_sha(rom),"9115bbcd03da9f54d3baca5ad94d588a43da54ed332347137ba3dc9010df258b"),"supplied original ECO3 ROM hash mismatch");te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_legacy=1;te_bios=h_dir(rom);h_assert(h_exists(h_join(te_bios,"esp32-v3-rom-app.bin")),"QEMU requires adjacent app-core ROM");let ld=h_real(h_executable(b_option(argc,argv,"--ld","xtensa-esp32-elf-ld")));let unlinked=h_join(te_work,"unlinked.elf");h_ok(h_args(te_compiler,"--target","esp32-elf","tests/esp32/emulator-clock.flex","-o",unlinked));let link=h_join(te_work,"link");h_compile(te_compiler,"scripts/esp32-link.flex",link);let linked=h_join(te_work,"clock.elf");let image=h_join(te_work,"clock.bin");let args=h_args(link,"--firmware",unlinked,"--output",linked,"--rom");h_add(args,symbols);h_add(args,"--ld");h_add(args,ld);h_add(args,"--image");h_add(args,image);h_ok(args);let marker="PASS: ROM PLL,3 CPU/APB ratios and2 WAITI clocks";let native=0;let native_output=0;let native_serial=h_join(te_work,"native.uart");if !tc_flag(argc,argv,"--qemu-only"){let runner=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",runner);args=h_args(runner,linked,native_serial,"--rom",rom,"--download-clock");h_add(args,"--fuel");h_add(args,"100000000");let result=h_run(args);h_check(result,0,0);native_output=h_out(result);h_print(1,native_output);native=h_read(native_serial);te_assert(h_has(native,marker),"native CPU/APB/WAITI clock probe");}let serial=te_run(image,0,marker);h_save(h_join(te_work,"qemu.uart"),serial);if native{te_assert(h_has(serial,native),"same clock probe UART matches QEMU");}let report=b_option(argc,argv,"--report",0);if report{let row=j_object();j_set(row,"QEMU_pass",j_bool(1));j_set(row,"native_verified",j_bool(native!=0));j_set(row,"physical_hardware",j_bool(0));j_set(row,"ROM_sha256",j_string(h_sha(rom)));j_set(row,"compiler_sha256",j_string(h_sha(te_compiler)));j_set(row,"ELF_sha256",j_string(h_sha(linked)));j_set(row,"image_sha256",j_string(h_sha(image)));j_set(row,"QEMU_checks",j_int(te_checks));j_set(row,"QEMU_boots",j_int(te_runs));if native{j_set(row,"native_result",j_string(native_output));j_set(row,"native_UART_sha256",j_string(h_sha(native_serial)));j_set(row,"UART_matches_QEMU",j_bool(1));}j_set(row,"scope_complete",j_bool(0));j_save(report,row);}if native{h_print(1,"PASS: native/QEMU ROM PLL and CPU/APB/WAITI clocks\n");}else{h_print(1,"PASS: QEMU clock probe only; native verification remains required\n");}return 0;}
