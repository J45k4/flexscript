    if ri_radio()!=was_on{let command="disable";if was_on{command="enable";}ut_ok(ut_args("shell","svc","bluetooth",command,0,0),"");let end_radio=net_now()+15000;while ri_radio()!=was_on&&net_now()<end_radio{h_sleep(50);}h_assert(ri_radio()==was_on,"Original Bluetooth adapter state did not return");}
    ri_restore_permissions(package);ut_restore(ut_original);let after=ut_read(h_cat3("files/workspaces/",ut_original,"/session.json"));h_assert(after&&h_equal(j_dump(after),j_dump(original)),"Full original conversation JSON changed; preserve recovery evidence");let after_prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));h_assert(h_equal(after_prefs,prefs)&&h_equal(ri_flags(ri_package()),ri_flags(package)),"Original preferences or any Android grant flag changed");ri_remove_owned();h_assert(h_equal(workspaces,h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),""))),"Complete original workspace set changed");
