    while load8(rest){let n=h_find(rest,"\n");if n<0{n=h_len(rest);}let name=h_slice(rest,n);if h_starts(name,ut_prefix){h_assert(ut_name(name),"Unsafe owned RFCOMM workspace");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-rf",h_cat("files/workspaces/",name)),"");}rest=rest+n;if load8(rest){rest=rest+1;}}
    rest=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/test"),""));while load8(rest){let n=h_find(rest,"\n");if n<0{n=h_len(rest);}let name=h_slice(rest,n);if h_starts(name,ut_prefix){h_assert(h_find(name,"/")<0,"Unsafe owned RFCOMM case name");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",h_cat("files/test/",name)),"");}rest=rest+n;if load8(rest){rest=rest+1;}}return 0;
}
fn ri_finish(baseline){
    ut_prefix=cj_text(baseline,"prefix");ut_original=cj_text(baseline,"original");ri_peer=cj_text(baseline,"peer_name");ri_seed=cj_int(baseline,"epoch");ri_uuid=cj_text(baseline,"service_uuid");ri_target=cj_text(baseline,"target");let prefs=cj_text(baseline,"prefs");let package=cj_text(baseline,"package");let workspaces=cj_text(baseline,"workspaces");let was_on=cj_int(baseline,"radio_enabled");let original=cj_get(baseline,"session");let expected=cj_text(baseline,"apk_sha256");
    h_assert(ut_name(ut_prefix)&&h_starts(ut_prefix,"bt-in-")&&h_len(ut_prefix)>16&&ut_name(ut_original)&&!h_starts(ut_original,ut_prefix)&&ri_peer&&original&&h_equal(expected,ri_apk()),"Invalid owned incoming recovery record");
