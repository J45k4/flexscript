    h_assert(h_equal(expected,ri_apk()),"APK changed during incoming RFCOMM checks");let audit=j_object();j_set(audit,"ok",j_bool(1));j_set(audit,"full_original_state_restored",j_bool(1));j_set(audit,"all_android_grant_flags_restored",j_bool(1));j_set(audit,"radio_restored",j_bool(1));j_set(audit,"owned_workspaces_removed",j_bool(1));j_save(h_join(ut_out,"cleanup-audit.json"),audit);
    return 0;
}
