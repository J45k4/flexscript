// Native host for actual Android incoming RFCOMM and an installed local Bumble
// CLI. No Python source/dependency is added. A parent restores owned state even
// when its worker fails; virtual peer/probe processes die with their owner.
import "lib/android-usb-test.flex";

global ri_executable=0;global ri_bridge=0;global ri_probe=0;global ri_netsim=0;
global ri_secure=0;global ri_authenticate=-1;global ri_encrypt=-1;global ri_seed=0;global ri_uuid=0;global ri_peer=0;global ri_target=0;
global ri_source=0;global ri_bridge_process=0;global ri_bridge_log=0;
global ri_checks=0;global ri_finish_mode=0;
fn ri_q(s){return j_dump(j_string(s));}
fn ri_pass(text){j_push(ri_checks,j_string(text));h_print(1,h_cat3("PASS ",text,"\n"));return 0;}
fn ri_mac(s){if h_len(s)!=17{return 0;}let i=0;while i<17{let c=load8(s+i);if i%3==2{if c!=58{return 0;}}else if !((c>=48&&c<=57)||(c>=65&&c<=70)){return 0;}i=i+1;}return 1;}
fn ri_uuid_new(){let raw=h_take(16);h_assert(syscall(318,raw,16,0,0,0,0)==16,"Cannot create unique RFCOMM fixture UUID");store8(raw+6,(load8(raw+6)&15)|64);store8(raw+8,(load8(raw+8)&63)|128);let hex=h_hex(raw,16);return h_cat3(h_slice(hex,8),"-",h_cat3(h_slice(hex+8,4),"-",h_cat3(h_slice(hex+12,4),"-",h_cat3(h_slice(hex+16,4),"-",hex+20))));}
fn ri_xml(){let path=h_cat3("/data/local/tmp/",ut_prefix,".xml");ut_ok(ut_args("shell","uiautomator","dump",path,0,0),"");let xml=h_out(ut_ok(ut_args("exec-out","cat",path,0,0,0),""));h_save(h_join(ut_out,"last-ui.xml"),xml);return xml;}
fn ri_node(xml,key,value){let rest=xml;let i=0;while i<2048{let at=h_find(rest,"<node ");if at<0{return 0;}rest=rest+at;let end=h_find(rest,">");h_assert(end>=0,"Malformed actual RFCOMM UI hierarchy");let node=h_slice(rest,end+1);if h_equal(ut_attr(node,"enabled"),"true")&&h_equal(ut_attr(node,key),value){return node;}rest=rest+end+1;i=i+1;}h_die("Actual RFCOMM UI hierarchy exceeds node bound");return 0;}
fn ri_click(key,value,alternate){let end=net_now()+20000;while net_now()<end{let xml=ri_xml();let node=ri_node(xml,key,value);if !node&&alternate{node=ri_node(xml,key,alternate);}if node{return ut_tap(node);}h_sleep(50);}h_die(h_cat("Actual RFCOMM UI target missing: ",value));return 0;}
fn ri_observation(result){let value=cj_get(result,"observation");if !value{return ut_observation(result,0);}h_assert(h_equal(cj_text(value,"state"),"continue")&&cj_int(value,"exit_code")==0,j_dump(value));return value;}
fn ri_vm_at(sid,call){let request=j_object();j_set(request,"source",j_string(h_cat3(ri_source,"\nfn main(){return ",h_cat(call,";}"))));let name=ut_start(sid,request);j_save(h_join(ut_out,h_cat3("request-",name,".json")),request);return ri_observation(ut_result(name));}
fn ri_vm(call){return ri_vm_at(ut_prefix,call);}
fn ri_consent(name){
    let end=net_now()+90000;let previous="";
    while net_now()<end{
        let result=ut_read(h_cat3("files/test/",name,".result.json"));if result{j_save(h_join(ut_out,"setup-result.json"),result);h_assert(cj_int(result,"ok"),j_dump(result));return ri_observation(result);}
        let session=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));let phase=cj_text(session,"phase");let signal=cj_get(cj_get(session,"pending_execution"),"signal");let signature=phase;if signal{signature=h_cat(phase,j_dump(signal));}
        if h_equal(cj_text(signal,"key"),"bluetooth")&&!h_equal(previous,signature){
            if h_equal(phase,"permission"){ri_click("text","Allow","Allow requested access");previous=signature;}
            else if h_equal(phase,"platform_permission"){
                let request=cj_get(signal,"request");let kind=cj_text(request,"type");
                if h_equal(kind,"runtime"){let permissions=cj_get(request,"permissions");h_assert(j_count(permissions)>0,"Missing actual Nearby permission request");let i=0;while i<j_count(permissions){let p=j_value(j_at(permissions,i));h_assert(h_equal(p,"android.permission.BLUETOOTH_CONNECT")||h_equal(p,"android.permission.BLUETOOTH_SCAN")||h_equal(p,"android.permission.BLUETOOTH_ADVERTISE"),"RFCOMM fixture must not request unrelated runtime permissions");i=i+1;}ri_click("resource-id","com.android.permissioncontroller:id/permission_allow_button","com.google.android.permissioncontroller:id/permission_allow_button");}
                else{h_assert(h_equal(kind,"bluetooth_enable"),"Unexpected Bluetooth platform consent");ri_click("text","Allow",0);}previous=signature;
            }
        }
        h_sleep(25);
    }
    h_die("RFCOMM first-use consent deadline; preserve the current request");return 0;
}
fn ri_bridge_text(){if !h_exists(ri_bridge_log){return "";}return h_read(ri_bridge_log);}
fn ri_wait_bridge(marker,timeout){let end=net_now()+timeout;while net_now()<end{h_pump(ri_bridge_process,0);let text=ri_bridge_text();if h_has(text,marker){return text;}h_assert(h_status(ri_bridge_process)==-999,h_cat("Installed local RFCOMM bridge exited; inspect ",ri_bridge_log));h_sleep(20);}h_die(h_cat("Actual bridge event deadline: ",marker));return "";}
fn ri_notice(xml){let rest=xml;let i=0;while i<2048{let at=h_find(rest,"<node ");if at<0{return 0;}rest=rest+at;let size=h_find(rest,">");h_assert(size>=0,"Malformed owned pairing notification");let node=h_slice(rest,size+1);if h_equal(ut_attr(node,"package"),"com.android.systemui")&&h_has(ut_attr(node,"text"),ri_peer){return node;}rest=rest+size+1;i=i+1;}return 0;}
fn ri_pair(){
    let end=net_now()+40000;let expanded=0;
    while net_now()<end{
        h_pump(ri_bridge_process,0);let text=ri_bridge_text();let ready="@@@ Bluetooth connection: ";if ri_authenticate{ready="Bluetooth connection authenticated";}if ri_encrypt{ready="Bluetooth connection encrypted";}if h_has(text,ready){ut_ok(ut_args("shell","cmd","statusbar","collapse",0,0),"");if ri_secure{h_assert(h_has(text,"Bluetooth connection authenticated")&&h_has(text,"Bluetooth connection encrypted"),"Secure peer requires actual completed authentication/encryption");}return 0;}
        h_assert(h_status(ri_bridge_process)==-999,"Local RFCOMM bridge ended before channel setup");let xml=ri_xml();
        if h_has(xml,ri_peer){let pair=ri_node(xml,"text","Pair");if pair{ut_tap(pair);ut_ok(ut_args("shell","cmd","statusbar","collapse",0,0),"");}else{let notice=ri_notice(xml);if notice{ut_tap(notice);}}}
        else if !expanded{ut_ok(ut_args("shell","cmd","statusbar","expand-notifications",0,0),"");expanded=1;}
        h_sleep(50);
    }
    h_die("No actual incoming channel/pairing for the uniquely named owned virtual peer");return 0;
}
fn ri_bridge_exec(argc,argv){
    h_assert(argc==13,"Invalid private bridge invocation");let log=load64(argv+16);let cli=load64(argv+24);let config=load64(argv+32);let grpc=h_number(load64(argv+40));let port=h_number(load64(argv+48));let target=load64(argv+56);let service=load64(argv+64);let name=load64(argv+72);let encrypt=h_number(load64(argv+80));let authenticate=h_number(load64(argv+88));
    h_assert(grpc>0&&grpc<=65535&&port>=1024&&port<=65535&&ri_mac(target)&&h_len(service)==36&&h_starts(name,"collie-test-bt-in-")&&(encrypt==0||encrypt==1)&&(authenticate==0||authenticate==1)&&(!encrypt||authenticate)&&h_equal(load64(argv+96),"owned"),"Bridge is restricted to the owned local Netsim controller");
    let fd=syscall(2,log,0xa02c1,384,0,0,0);h_assert(fd>=0,"Cannot exclusively open owned bridge log");h_assert(syscall(33,fd,1,0,0,0,0)==1&&syscall(33,fd,2,0,0,0,0)==2,"Cannot capture installed bridge output");h_close(fd);
    let args=h_args("/usr/bin/env","PYTHONUNBUFFERED=1",cli,"--device-config",config,"--hci-transport");h_add(args,h_cat3("android-netsim:127.0.0.1:",h_int(grpc),h_cat(",name=",name)));h_add(args,"--uuid");h_add(args,service);h_add(args,"client");h_add(args,target);h_add(args,"--tcp-host");h_add(args,"127.0.0.1");h_add(args,"--tcp-port");h_add(args,h_int(port));if authenticate{h_add(args,"--authenticate");}if encrypt{h_add(args,"--encrypt");}
    let pointers=h_zero(h_take((h_count(args)+1)*8),(h_count(args)+1)*8);let i=0;while i<h_count(args){store64(pointers+i*8,h_at(args,i));i=i+1;}syscall(59,"/usr/bin/env",pointers,h_env,0,0,0);h_die("Cannot execute the installed local bridge");return 1;
}
fn ri_proc(pid){let path=h_cat3("/proc/",h_int(pid),"/stat");if !h_exists(path){return 0;}let raw=h_read(path);let at=h_find(raw,") ");h_assert(at>=0,"Malformed owned process status");let rest=raw+at+2;let state=load8(rest);let field=3;while field<22{let n=h_find(rest," ");h_assert(n>=0,"Incomplete owned process status");rest=rest+n+1;field=field+1;}let n=h_find(rest," ");h_assert(n>0,"Missing owned process start time");let value=j_object();j_set(value,"state",j_int(state));j_set(value,"start_ticks",j_string(h_slice(rest,n)));return value;}
fn ri_end_peers(){let path=h_join(ut_out,"worker-processes.json");if !h_exists(path){return 0;}let owner=c_json(h_read(path));let names=h_args("bridge","probe",0,0,0,0);let i=0;while i<2{let kind=h_at(names,i);let pid=cj_int(owner,h_cat(kind,"_pid"));let tick=cj_text(owner,h_cat(kind,"_start_ticks"));if pid>0{h_assert(h_len(tick),"Missing exact virtual-peer process identity; preserve recovery evidence");let current=ri_proc(pid);if current&&h_equal(cj_text(current,"start_ticks"),tick)&&cj_int(current,"state")!=90&&cj_int(current,"state")!=88{h_assert(syscall(62,pid,9,0,0,0,0)==0,"Cannot stop the exact still-live owned virtual peer");let end=net_now()+3000;while current&&h_equal(cj_text(current,"start_ticks"),tick)&&cj_int(current,"state")!=90&&cj_int(current,"state")!=88&&net_now()<end{h_sleep(20);current=ri_proc(pid);}h_assert(!current||!h_equal(cj_text(current,"start_ticks"),tick)||cj_int(current,"state")==90||cj_int(current,"state")==88,"Owned virtual peer is still live; preserve its existing process and evidence");}}i=i+1;}let result=j_object();j_set(result,"original_owned_processes_terminal",j_bool(1));j_save(h_join(ut_out,"peer-cleanup-audit.json"),result);return 0;}
fn ri_worker(){
    ri_checks=j_array();let setup=j_object();let grants=j_object();j_set(grants,"bluetooth",j_string("ask"));j_set(grants,"db_read",j_bool(1));j_set(grants,"db_write",j_bool(1));j_set(setup,"initial_permissions",grants);j_set(setup,"prompt",j_string("Open the owned incoming RFCOMM test listener"));
    let call=h_cat3("ri_setup(",ri_q(ri_peer),",");call=h_cat3(call,ri_q(ri_uuid),",");call=h_cat3(call,h_int(ri_secure),")");let code=h_cat3(ri_source,"\nfn main(){return ",h_cat(call,";}"));j_set(setup,"responses",ut_responses(code));let setup_case=ut_start(ut_prefix,setup);j_save(h_join(ut_out,h_cat3("request-",setup_case,".json")),setup);ri_consent(setup_case);let baseline=c_json(h_read(h_join(ut_out,"baseline.json")));let initial_package=cj_text(baseline,"package");let current_package=ri_package();h_assert(h_equal(ri_permission_line(initial_package,"android.permission.ACCESS_FINE_LOCATION"),ri_permission_line(current_package,"android.permission.ACCESS_FINE_LOCATION"))&&h_equal(ri_permission_line(initial_package,"android.permission.ACCESS_COARSE_LOCATION"),ri_permission_line(current_package,"android.permission.ACCESS_COARSE_LOCATION")),"Incoming RFCOMM must preserve both independent Location grant flags");ri_pass("actual Android Nearby/radio consent opens the VM RFCOMM listener without a Location grant");
    let before=cj_text(ri_vm("ri_bonds(\"\")"),"stdout");h_save(h_join(ut_out,"bonds-before.txt"),before);h_assert(!h_len(before),"Incoming fixture requires this owned emulator to start without bonds; existing bonds are preserved");
    ri_vm("ri_empty_accept()");ri_pass("an actual empty SDK accept returns timeout and preserves its VM listener handle");
    let listener=tcp_listen("127.0.0.1","0",1);h_assert(listener>=0,"Cannot reserve a local bridge port");let address=h_zero(h_take(16),16);let size=h_take(8);store64(size,16);h_assert(syscall(51,listener,address,size,0,0,0)==0,"Cannot inspect local bridge port");let port=load8(address+2)*256+load8(address+3);tcp_close(listener);
    let config=j_object();j_set(config,"name",j_string(ri_peer));j_set(config,"classic_enabled",j_bool(1));j_set(config,"le_enabled",j_bool(0));j_set(config,"keystore",cj_null());let config_path=h_join(ut_out,"bridge-config.json");j_save(config_path,config);ri_bridge_log=h_join(ut_out,"bridge.log");
    let args=h_args(ri_executable,"--bridge-exec",ri_bridge_log,ri_bridge,config_path,h_int(ri_netsim));h_add(args,h_int(port));h_add(args,ri_target);h_add(args,ri_uuid);h_add(args,h_cat("collie-test-",ut_prefix));h_add(args,h_int(ri_encrypt));h_add(args,h_int(ri_authenticate));h_add(args,"owned");ri_bridge_process=h_spawn(args,"",0);
    let ownership=j_object();j_set(ownership,"bridge_pid",j_int(load64(ri_bridge_process)));j_set(ownership,"bridge_start_ticks",cj_get(ri_proc(load64(ri_bridge_process)),"start_ticks"));j_set(ownership,"peer_name",j_string(ri_peer));j_set(ownership,"target",j_string(ri_target));j_set(ownership,"uuid",j_string(ri_uuid));j_save(h_join(ut_out,"worker-processes.json"),ownership);
    ri_wait_bridge("Listening for TCP connections on port",15000);
    let probe_report=h_join(ut_out,"probe.json");let probe_stop=h_join(ut_out,"probe.stop");let probe=h_spawn(h_args(ri_probe,h_int(port),h_int(ri_seed),probe_report,probe_stop,0),"",0);j_set(ownership,"probe_pid",j_int(load64(probe)));j_set(ownership,"probe_start_ticks",cj_get(ri_proc(load64(probe)),"start_ticks"));j_save(h_join(ut_out,"worker-processes.json"),ownership);
    ri_pair();let accept_request=j_object();j_set(accept_request,"source",j_string(h_cat(ri_source,"\nfn main(){return ri_accept();}")));let accept_case=ut_start(ut_prefix,accept_request);j_save(h_join(ut_out,h_cat3("request-",accept_case,".json")),accept_request);ri_wait_bridge("*** Opening RFCOMM channel",7000);let accepted=ri_observation(ut_result(accept_case));let remote=h_trim(cj_text(accepted,"stdout"));h_assert(ri_mac(remote),"Actual accepted SDK socket must identify its remote address");h_save(h_join(ut_out,"peer-address.txt"),remote);let peer_log=ri_bridge_text();let peer_at=h_find(peer_log,"self_address=");h_assert(peer_at>=0&&h_equal(h_slice(peer_log+peer_at+13,17),remote),"Accepted Android socket must match the independent virtual controller address");ri_wait_bridge("*** RFCOMM channel open:",10000);ri_pass("the real Android SDK accepts the virtual peer's incoming RFCOMM channel");
    ri_vm("ri_close_listener()");ri_pass("closing the parent listener releases its UUID for re-registration while its accepted SDK child stays connected");
    ri_vm(h_cat3("ri_exchange(",h_int(ri_seed),")"));let end=net_now()+5000;let exchanged=0;while !exchanged&&net_now()<end{h_pump(probe,1);if h_exists(probe_report){let row=c_json(h_read(probe_report));exchanged=h_equal(cj_text(row,"phase"),"exchanged")&&cj_int(row,"sent")==32791&&cj_int(row,"received")==32791&&cj_int(row,"pid")==load64(probe)&&cj_int(row,"seed")==ri_seed;}if !exchanged{h_sleep(10);}}
    h_assert(exchanged&&h_status(probe)==-999,"Independent native peer did not confirm the complete bidirectional payload before either endpoint closed");ri_pass("32791 unique binary bytes cross actual incoming RFCOMM both ways after parent closure, verified independently by the VM and native peer");
    if h_equal(ri_finish_mode,"deadline"){
        let request=j_object();j_set(request,"hardware_tests",j_bool(1));j_set(request,"hardware_bluetooth_deadline_tests",j_bool(1));let name=ut_start(ut_prefix,request);j_save(h_join(ut_out,h_cat3("request-",name,".json")),request);let tested=ut_result(name);let receipt=cj_get(tested,"hardware");h_assert(receipt&&cj_int(receipt,"ok"),j_dump(tested));j_save(h_join(ut_out,"byte-deadline-report.json"),receipt);
    }else if h_equal(ri_finish_mode,"cancel")||h_equal(ri_finish_mode,"revoke"){
        let request=j_object();j_set(request,"hardware_tests",j_bool(1));j_set(request,"hardware_bluetooth_io_tests",j_bool(1));j_set(request,"hardware_bluetooth_revoke_tests",j_bool(h_equal(ri_finish_mode,"revoke")));let name=ut_start(ut_prefix,request);j_save(h_join(ut_out,h_cat3("request-",name,".json")),request);let tested=ut_result(name);let receipt=cj_get(tested,"hardware");h_assert(receipt&&cj_int(receipt,"ok")&&h_equal(cj_text(receipt,"action"),ri_finish_mode),j_dump(tested));j_save(h_join(ut_out,"blocked-io-report.json"),receipt);
    }else{ri_vm("ri_close_stream()");}
    ri_wait_bridge("*** RFCOMM channel closed",8000);h_assert(h_status(probe)==-999,"The host TCP peer must remain live until the actual SDK child-close callback");if h_equal(ri_finish_mode,"deadline"){ri_pass("a real blocked VM read times out independently of the held callback Handler, closes its SDK socket and reaches the remote RFCOMM-close callback while TCP stays open");}else if h_equal(ri_finish_mode,"cancel")||h_equal(ri_finish_mode,"revoke"){ri_pass(h_cat3("the real UI ",ri_finish_mode," action cancels an observed native SDK read, closes its socket/receiver and reaches the remote RFCOMM-close callback while TCP stays open"));}else{ri_pass("explicit VM child close invalidates its handle and reaches the real remote RFCOMM callback while TCP is still open");}
    h_save(probe_stop,"stop");h_check(h_wait(probe),0,0);h_pump(ri_bridge_process,10);h_stop(ri_bridge_process);
    let result=j_object();j_set(result,"complete",j_bool(1));j_set(result,"checks",ri_checks);j_set(result,"count",j_int(j_count(ri_checks)));j_set(result,"secure",j_bool(ri_secure));j_set(result,"finish_mode",j_string(ri_finish_mode));j_set(result,"epoch",j_int(ri_seed));j_set(result,"service_uuid",j_string(ri_uuid));j_set(result,"peer_name",j_string(ri_peer));j_set(result,"android_address",j_string(ri_target));j_set(result,"peer_authentication_requested",j_bool(ri_authenticate));j_set(result,"peer_encryption_requested",j_bool(ri_encrypt));let auth=cj_null();if h_has(ri_bridge_text(),"Bluetooth connection authenticated"){auth=j_bool(1);}let encryption=cj_null();if h_has(ri_bridge_text(),"Bluetooth connection encrypted"){encryption=j_bool(1);}j_set(result,"authenticated",auth);j_set(result,"encrypted",encryption);j_set(result,"peer_address",j_string(remote));j_set(result,"physical_radio_verified",j_bool(0));j_set(result,"bytes_each_direction",j_int(32791));j_save(h_join(ut_out,"incoming-worker-report.json"),result);return 0;
}
fn ri_package(){return h_out(ut_ok(ut_args("shell","dumpsys","package","org.flexscript.collie",0,0),""));}
fn ri_flags(package){let result=h_buffer();let rest=package;while load8(rest){let n=h_find(rest,"\n");if n<0{n=h_len(rest);}let row=h_trim(h_slice(rest,n));if h_has(row,"granted="){h_append(result,row,h_len(row));h_append(result,"\n",1);}rest=rest+n;if load8(rest){rest=rest+1;}}return h_data(result);}
fn ri_radio(){let text=h_out(ut_ok(ut_args("shell","dumpsys","bluetooth_manager",0,0,0),""));let row=ut_line(text,"enabled: ");h_assert(row&&(h_has(row,"enabled: true")||h_has(row,"enabled: false")),"Cannot observe actual Bluetooth adapter state");return h_has(row,"enabled: true");}
fn ri_apk(){let expected=h_sha(h_join(ut_out,"collie.apk"));let path=h_trim(h_out(ut_ok(ut_args("shell","pm","path","org.flexscript.collie",0,0),"")));h_assert(h_starts(path,"package:/data/app/")&&h_find(path,"\n")<0,"Ambiguous installed APK path");let sum=h_out(ut_ok(ut_args("exec-out","sha256sum",path+8,0,0,0),""));h_assert(h_equal(h_slice(sum,64),expected),"Installed APK differs from owned output artifact");return expected;}
fn ri_permission_line(package,name){let row=ut_line(package,h_cat(name,": granted="));h_assert(row,"Missing Android runtime permission state");return row;}
fn ri_restore_permissions(package){
    let names=h_args("android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_ADVERTISE",0,0,0);let i=0;
    while i<3{let name=h_at(names,i);let row=ri_permission_line(package,name);let action="revoke";if h_has(row,": granted=true"){action="grant";}ut_ok(ut_args("shell","pm",action,"org.flexscript.collie",name,0),"");ut_ok(ut_args("shell","pm","clear-permission-flags","org.flexscript.collie",name,"user-set"),"");ut_ok(ut_args("shell","pm","clear-permission-flags","org.flexscript.collie",name,"user-fixed"),"");if h_has(row,"USER_SET"){ut_ok(ut_args("shell","pm","set-permission-flags","org.flexscript.collie",name,"user-set"),"");}if h_has(row,"USER_FIXED"){ut_ok(ut_args("shell","pm","set-permission-flags","org.flexscript.collie",name,"user-fixed"),"");}i=i+1;}return 0;
}
fn ri_unique_node(xml,key,value){let rest=xml;let found=0;let i=0;while i<2048{let at=h_find(rest,"<node ");if at<0{return found;}rest=rest+at;let size=h_find(rest,">");h_assert(size>=0,"Malformed owned device settings hierarchy");let node=h_slice(rest,size+1);if h_equal(ut_attr(node,"enabled"),"true")&&h_equal(ut_attr(node,key),value){if found{return 0;}found=node;}rest=rest+size+1;i=i+1;}return 0;}
fn ri_details(){let end=net_now()+20000;while net_now()<end{let xml=ri_xml();let node=ri_node(xml,"content-desc",h_cat(ri_peer,". Configure device detail."));if !node&&h_has(xml,ri_peer){node=ri_unique_node(xml,"resource-id","com.android.settings:id/settings_button");}if node{return ut_tap(node);}h_sleep(50);}h_die("Owned peer settings control is absent or ambiguous; retain recovery evidence");return 0;}
fn ri_cleanup_bond(){
    let current=ri_package();if !h_has(ri_permission_line(current,"android.permission.BLUETOOTH_CONNECT"),": granted=true"){return 0;}
    let sid=h_cat(ut_prefix,"-cleanup");let prepare=j_object();j_set(prepare,"source",j_string("fn main(){return 0;}"));let grants=j_object();j_set(grants,"bluetooth",j_bool(1));j_set(grants,"db_read",j_bool(1));j_set(grants,"db_write",j_bool(1));j_set(prepare,"initial_permissions",grants);ri_observation(ut_result(ut_start(sid,prepare)));
    let peer=h_trim(cj_text(ri_vm_at(sid,h_cat3("ri_bonds(",ri_q(ri_peer),")")),"stdout"));
