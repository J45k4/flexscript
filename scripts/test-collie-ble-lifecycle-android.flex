// Delayed genuine SDK callbacks, radio/process loss and conversation revocation.
import "lib/android-ble-set-test.flex";
fn bl_program(call,preamble,args){return bp_guest(h_cat("ble_lifecycle_live_",call),preamble,args);}
fn bl_vm(sid,call,preamble,args){return at_vm(sid,bl_program(call,preamble,args),0);}
fn bl_setup(sid){let source=h_cat3("fn main(){state_set(\"ble_lifecycle_service\",db_text(",bp_string(bs_service),"));");let phases=h_args("startup_timeout","startup_close","operation_before","operation_after","after_timeout","live_revoke");h_add(phases,"radio_shutdown");h_add(phases,"process_death");h_add(phases,"conversation");h_add(phases,"queued_close");h_add(phases,"after_restart");h_add(phases,"runtime_revoke");h_add(phases,"blocked_reopen");h_add(phases,"background_before");h_add(phases,"background_update");h_add(phases,"background_start");h_add(phases,"queued_expired");let i=0;while i<h_count(phases){let phase=h_at(phases,i);let value=bs_hex("ads",phase);source=h_cat3(source,"state_set(",h_cat3(bp_string(h_cat("ble_lifecycle_",phase)),",db_text(",h_cat(bp_string(value),"));")));i=i+1;}at_vm(sid,h_cat(source,"return 0;}"),c_json("{\"bluetooth\":true,\"location\":false,\"db_read\":true,\"db_write\":true}"));return 0;}
fn bl_result(sid,name,hidden){let end=net_now()+120000;let cursor=0;let acked=0;while net_now()<end{let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{j_save(h_join(ut_out,h_cat3("case-",name,".json")),r);return r;}if hidden&&!acked{let state=bs_read();if cj_int(cj_get(state,"ad_seen"),"background_start")>0&&cj_int(cj_get(state,"periodic_seen"),"background_start")>0{h_assert(at_owned(sid),"Refusing background ACK outside owned workspace");at_write(h_cat3("files/workspaces/",sid,"/ble-background-peer-ack"),"verified");j_save(h_join(ut_out,h_cat3("peer-ack-",name,".json")),state);acked=1;}}let raw=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat",h_cat3("files/workspaces/",sid,"/ble-lifecycle-progress.json"),0),"");if h_starts(h_out(raw),"["){let progress=c_json(h_out(raw));while cursor<j_count(progress){h_print(1,h_cat3("SDK progress: ",j_value(j_at(progress,cursor)),"\n"));cursor=cursor+1;}}h_sleep(100);}h_die(h_cat("Actual BLE lifecycle deadline; preserve request ",name));return 0;}
fn bl_sdk(sid,hidden){let flags=c_json("{\"hardware_tests\":true,\"hardware_ble_set_tests\":true}");if hidden{j_set(flags,"hardware_ble_hidden_tests",j_bool(1));}let r=bl_result(sid,at_start(sid,flags),hidden);h_assert(cj_int(r,"ok"),j_dump(r));let report=cj_get(r,"hardware");h_assert(cj_int(report,"ok")&&!at_bool(cj_get(report,"synthetic_sdk_callbacks")),j_dump(report));let checks=cj_get(report,"checks");h_assert(j_count(checks)>0,"Actual SDK fixture returned no assertions");let i=0;while i<j_count(checks){at_pass(j_value(j_at(checks,i)));i=i+1;}return report;}
fn bl_open(sid,phase){return cj_text(bl_vm(sid,"open",bs_data("data",bs_hex("ads",phase),0,0),h_args("data",0,0,0,0,0)),"stdout");}
fn bl_stop(sid){return bl_vm(sid,"stop","",h_vec());}
fn bl_radio(sid,value){let end=net_now()+20000;while net_now()<end{if h_equal(cj_text(bl_vm(sid,"radio","",h_args(h_int(value),0,0,0,0,0)),"stdout"),"ready"){return 0;}h_sleep(100);}h_die("Actual public Bluetooth state deadline");return 0;}
fn bl_pid(){return h_trim(h_out(ut_call(ut_args("shell","pidof","org.flexscript.collie",0,0,0),"")));}
fn bl_dead(){let end=net_now()+10000;while net_now()<end{if !h_len(bl_pid()){return 0;}h_sleep(100);}h_die("Android process did not exit after revocation/force-stop");return 0;}
fn main(argc,argv){
    let suite="ble-lifecycle";let i=1;while i<argc{if h_equal(load64(argv+i*8),"--expect-deadline-failures"){suite="ble-deadline-before";}i=i+1;}at_cleanup_hook=1;let options=c_json("{\"peer-state\":\"\",\"expect-deadline-failures\":false}");if at_init(argc,argv,suite,options)<0{return at_self_test();}if at_cleanup{return ar_restore();}bp_path=h_real(cj_text(options,"peer-state"));bs_peer=bs_read();let pairs=j_value(cj_get(bs_peer,"ad_seen"));i=0;while i<h_count(pairs){h_assert(j_value(load64(h_at(pairs,i)+8))==0,"Use a fresh lifecycle byte oracle");i=i+1;}bs_service=bp_uuid(cj_text(bs_peer,"service"));if !at_child{at_extra=ar_snapshot(1,0);h_assert(cj_int(at_extra,"bluetooth"),"Preserve an initially disabled radio; no lifecycle test submitted");return at_parent(argc,argv);}bp_source=h_read("apps/collie/tests/ble-lifecycle-live.flex");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");bp_grant("android.permission.BLUETOOTH_CONNECT");bp_grant("android.permission.BLUETOOTH_ADVERTISE");let empty=h_vec();let baseline=j_array();let before=cj_int(options,"expect-deadline-failures");
    if before{let flags=h_args("hardware_ble_startup_deadline_tests","hardware_ble_request_deadline_tests",0,0,0,0);let messages=h_args("late SDK startup must retain its elapsed timeout","late SDK request callback must retain its elapsed timeout",0,0,0,0);i=0;while i<2{let sid=h_cat3(ut_prefix,"-baseline-",h_int(i));ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");bl_setup(sid);let request=c_json("{\"hardware_tests\":true,\"hardware_ble_set_tests\":true}");j_set(request,h_at(flags,i),j_bool(1));let r=bl_result(sid,at_start(sid,request),0);h_assert(!at_bool(cj_get(r,"ok"))&&h_has(cj_text(r,"error"),h_at(messages,i)),j_dump(r));j_push(baseline,r);h_print(1,h_cat3("CONFIRMED baseline failure: ",cj_text(r,"error"),"\n"));i=i+1;}bs_seen("ad_seen","startup_timeout",1,10);bs_seen("ad_seen","operation_after",1,10);
    }else{
        let sid=h_cat(ut_prefix,"-sdk");bl_setup(sid);bl_sdk(sid,0);let phases=h_args("startup_timeout","startup_close","operation_after","after_timeout","live_revoke",0);i=0;while i<h_count(phases){bs_seen("ad_seen",h_at(phases,i),1,10);i=i+1;}let state=bs_read();h_assert(cj_int(cj_get(state,"ad_seen"),"queued_close")==0&&cj_int(cj_get(state,"ad_seen"),"queued_expired")==0,"Cancelled queued SDK work transmitted marker bytes");at_pass("the independent virtual peer received exact bytes while actual SDK result delivery was delayed");at_pass("the independent peer never received the marker from locally cancelled queued startup/update work");bs_quiet("ad_seen","live_revoke");at_pass("actual live conversation revocation stops its matching packets at the independent peer");sid=h_cat(ut_prefix,"-hidden");bl_setup(sid);bl_sdk(sid,1);bs_seen("ad_seen","background_update",1,10);state=bs_seen("ad_seen","background_start",1,10);h_assert(cj_int(cj_get(state,"periodic_seen"),"background_start")>0,"Independent periodic background report missing");bs_quiet("ad_seen","background_update");bs_quiet("ad_seen","background_start");bs_quiet("periodic_seen","background_start");at_pass("the independent peer verifies exact extended and periodic payloads from a newly started background set, plus silence after hidden shutdown");
        sid=h_cat(ut_prefix,"-radio");bl_setup(sid);h_assert(h_equal(cj_text(bl_vm(sid,"enabled","",empty),"stdout"),"1"),"Preserve an initially disabled radio");let handle=bl_open(sid,"radio_shutdown");bs_seen("ad_seen","radio_shutdown",1,10);ut_ok(ut_args("shell","cmd","bluetooth_manager","disable",0,0),"");bl_radio(sid,10);h_assert(h_equal(cj_text(bl_vm(sid,"enabled","",empty),"stdout"),"0"),"Actual radio still enabled");bl_vm(sid,"terminal","",empty);bs_quiet("ad_seen","radio_shutdown");at_pass("actual public Android STATE_OFF stops matching peer packets and releases the set only after an SDK terminal callback or actual OFF observation plus local cleanup");bl_vm(sid,"off","",empty);at_pass("radio-off opens fail bluetooth_disabled and capability queries report unknown controller support rather than false hardware absence");let previous=cj_int(cj_get(bs_read(),"ad_seen"),"radio_shutdown");ut_ok(ut_args("shell","cmd","bluetooth_manager","enable",0,0),"");bl_radio(sid,12);h_assert(h_equal(cj_text(bl_vm(sid,"enabled","",empty),"stdout"),"1"),"Actual radio did not enable");h_sleep(500);bl_vm(sid,"close","",empty);let fresh=bl_open(sid,"radio_shutdown");h_assert(!h_equal(fresh,handle),"Fresh set inherited the old handle");bs_seen("ad_seen","radio_shutdown",previous+1,10);bl_stop(sid);bs_quiet("ad_seen","radio_shutdown");at_pass("after actual public Android STATE_ON a new SDK set transmits fresh matching peer packets and completes real teardown without inheriting the old set");
        sid=h_cat(ut_prefix,"-switch");bl_setup(sid);bl_open(sid,"conversation");bs_seen("ad_seen","conversation",1,10);at_case(h_cat(ut_prefix,"-other"),c_json("{\"resume_only\":true}"));bs_quiet("ad_seen","conversation");bl_vm(sid,"stale","",empty);at_pass("a real conversation switch stops its radio packets and cannot restore the previous workspace-owned handle");sid=h_cat(ut_prefix,"-death");bl_setup(sid);bl_open(sid,"process_death");bs_seen("ad_seen","process_death",1,10);let pid=bl_pid();h_assert(h_len(pid),"No owning Android process");ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");bl_dead();bs_quiet("ad_seen","process_death");bl_vm(sid,"stale","",empty);let new_pid=bl_pid();h_assert(h_len(new_pid)&&!h_equal(new_pid,pid),"Android process identity did not change");bl_open(sid,"after_restart");bs_seen("ad_seen","after_restart",1,10);bl_stop(sid);bs_quiet("ad_seen","after_restart");at_pass("actual process death stops advertisements through Android Binder cleanup; persisted VM tokens are stale after cold restart and a fresh set works");
        sid=h_cat(ut_prefix,"-runtime");bl_setup(sid);bl_open(sid,"runtime_revoke");bs_seen("ad_seen","runtime_revoke",1,10);pid=bl_pid();h_assert(h_len(pid),"No runtime permission owner");ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie","android.permission.BLUETOOTH_ADVERTISE",0),"");bl_dead();bs_quiet("ad_seen","runtime_revoke");at_case(sid,c_json("{\"resume_only\":true}"));bl_vm(sid,"stale","",empty);let payload=j_object();j_set(payload,"source",j_string(bl_program("blocked",bs_data("data",bs_hex("ads","blocked_reopen"),0,0),h_args("data",0,0,0,0,0))));let denied=cj_get(at_case(sid,payload),"observation");let signal=cj_get(denied,"signal");h_assert(h_equal(cj_text(denied,"state"),"platform_permission")&&h_equal(cj_text(signal,"kind"),"platform_permission")&&h_equal(cj_text(signal,"key"),"bluetooth")&&h_has(j_dump(cj_get(cj_get(signal,"request"),"permissions")),"android.permission.BLUETOOTH_ADVERTISE"),j_dump(denied));h_assert(cj_int(cj_get(bs_read(),"ad_seen"),"blocked_reopen")==0,"Revoked request transmitted marker bytes");at_pass("actual OS ADVERTISE revocation kills this Android process, stops matching packets and makes a reopened request checkpoint for the missing runtime grant before transmitting");bp_grant("android.permission.BLUETOOTH_ADVERTISE");previous=cj_int(cj_get(bs_read(),"ad_seen"),"after_restart");bl_open(sid,"after_restart");bs_seen("ad_seen","after_restart",previous+1,10);bl_stop(sid);bs_quiet("ad_seen","after_restart");h_assert(cj_int(cj_get(bs_read(),"ad_seen"),"blocked_reopen")==0,"Old checkpointed advertisement was replayed");at_pass("restoring the runtime grant enables only a new explicit SDK request and does not replay the previously checkpointed advertisement");
    }
    let report=j_object();j_set(report,"peer",bs_read());j_set(report,"physical_devices_verified",j_bool(0));if before{j_set(report,"feature_verified",j_bool(0));j_set(report,"confirmed_failures",j_int(j_count(baseline)));j_set(report,"cases",baseline);}else{j_set(report,"radio_public_states_verified",c_json("[10,12]"));}return at_finish(report);
}
