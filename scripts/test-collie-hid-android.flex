// Actual HID SDK/VM reports, control tokens and lifecycle checks on owned AVDs.
import "lib/android-bluetooth-pair-test.flex";
global hi_child=0;global hi_command=0;global hi_timeout=10000;global hi_scenario=0;global hi_host_reconnect=0;
fn hi_pass(text){at_pass(text);j_save(h_join(ut_out,h_cat(ut_prefix,"-checks.json")),at_checks);return 0;}
fn hi_load(){let source=h_read("apps/collie/tests/hid-live.flex");let lines=at_lines(h_read("apps/collie/tests/hid-lifecycle.flex"));let i=0;while i<h_count(lines){let line=h_at(lines,i);if !h_starts(line,"import "){source=h_cat3(source,"\n",line);}i=i+1;}h_assert(h_find(source,"fn main(){return 0;}")>=0,"Unexpected lifecycle entry point");return h_replace(source,"fn main(){return 0;}","fn hl_unused_main(){return 0;}");}
fn hi_program(call,args){return bp_guest(h_cat("hid_live_",call),h_cat3("hid_fixture_timeout=",h_int(hi_timeout),";"),args);}
fn hi_vm(call,args){return at_vm(ut_prefix,hi_program(call,args),0);}
fn hi_step(mode){return at_vm(ut_prefix,h_cat3(bp_source,"\nfn main(){let n=hl_step(",h_cat(h_int(mode),");if n{return fail(n);}return 0;}")),0);}
fn hi_poll(){h_pump(hi_child,0);h_save(h_join(ut_out,h_cat(ut_prefix,"-peer.stdout")),h_out(hi_child));h_save(h_join(ut_out,h_cat(ut_prefix,"-peer.stderr")),h_err(hi_child));let proof=j_object();if h_exists(bp_path){proof=bp_read();h_assert(!h_len(cj_text(proof,"error")),j_dump(proof));}h_assert(h_status(hi_child)==-999,h_cat("Independent HID host exited unexpectedly: ",h_err(hi_child)));return proof;}
fn hi_phase(name,seconds){let end=net_now()+seconds*1000;while net_now()<end{let proof=hi_poll();if h_equal(cj_text(proof,"phase"),name){return proof;}h_sleep(100);}h_die(h_cat("Independent HID phase deadline: ",name));return 0;}
fn hi_done(seconds){let end=net_now()+seconds*1000;while net_now()<end{let proof=hi_poll();if cj_int(proof,"done"){return proof;}h_sleep(100);}h_die("Independent HID completion deadline");return 0;}
fn hi_marker(phase){let marker=j_object();j_set(marker,"phase",j_string(phase));let t=net_now();let fraction=h_int(t%1000);while h_len(fraction)<3{fraction=h_cat("0",fraction);}j_set(marker,"at",j_node(6,h_cat3(h_int(t/1000),".",fraction)));let temp=h_cat(hi_command,".tmp");j_save(temp,marker);h_assert(syscall(82,temp,hi_command,0,0,0,0)==0,"Cannot publish owned HID command atomically");return 0;}
fn hi_radio(value){let end=net_now()+25000;while net_now()<end{if h_equal(cj_text(hi_vm("radio",h_args(h_int(value),0,0,0,0,0)),"stdout"),"yes"){return 0;}h_sleep(100);}h_die("Actual HID radio transition deadline");return 0;}
fn hi_ui(allowed,phase){at_click("text","Menu",0);at_click("text","Permissions",0);let label="Deny Bluetooth devices";if allowed{label="Allow Bluetooth devices";}let i=0;while i<12{let node=at_node(at_xml(),"content-desc",label,0);if node{if phase{hi_marker(phase);}ut_tap(node);let end=net_now()+10000;while net_now()<end{let saved=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));let policy=cj_get(cj_get(saved,"permissions"),"bluetooth");if policy&&j_kind(policy)==5&&at_bool(policy)==allowed{return 0;}h_sleep(50);}h_die("Actual Bluetooth policy click did not save");}let text=h_out(ut_ok(ut_args("shell","wm","size",0,0,0),""));let at=h_find(text,"Physical size: ");h_assert(at>=0,"Missing owned display geometry");let size=text+at+h_len("Physical size: ");let x=h_find(size,"x");let end=h_find(size,"\n");h_assert(x>0&&end>x,"Invalid owned display geometry");let width=h_number(h_slice(size,x));let height=h_number(h_slice(size+x+1,end-x-1));let args=ut_args("shell","input","swipe",h_int(width/2),h_int(height*4/5),h_int(width/2));h_add(args,h_int(height/3));h_add(args,"200");ut_ok(args,"");i=i+1;}h_die("Named Collie Bluetooth permission control is not visible");return 0;}
fn hi_checks(proof){let checks=cj_get(proof,"checks");h_assert(j_count(checks)>0,"Independent HID proof returned no assertions");let i=0;while i<j_count(checks){hi_pass(j_value(j_at(checks,i)));i=i+1;}return 0;}
fn hi_controls(){let empty=h_vec();hi_timeout=2500;hi_vm("control_open",empty);hi_phase("timeout_request_sent",25);hi_vm("capture",empty);hi_vm("retired",h_args(bp_string("timeout"),0,0,0,0,0));hi_phase("waiting_overlap_channels",25);hi_pass("actual unanswered SDK request exposes one token, rejects invalid success/disconnect, then expires with timeout, empty ownership and no late reply");hi_vm("control_open",empty);hi_phase("overlap_first_sent",25);hi_vm("capture",empty);hi_marker("overlap_first_observed");hi_vm("retired",h_args(bp_string("callback_mismatch"),0,0,0,0,0));hi_phase("waiting_fresh_channels",25);hi_pass("actual overlapping SDK requests retire the ambiguous registration, invalidate its token and confirm teardown before reopening");hi_vm("control_open",empty);hi_vm("fresh_request",empty);hi_phase("fresh_report_received",25);hi_marker("fresh_survived");hi_vm("control_close",empty);let proof=hi_done(25);h_assert(cj_int(proof,"connections")==3&&cj_int(proof,"closed_channels")==6&&at_bool(cj_get(proof,"encrypted")),j_dump(proof));h_assert(cj_int(proof,"timeout_close_ms")>=2000&&cj_int(proof,"timeout_close_ms")<=6000&&cj_int(proof,"overlap_close_ms")<=5000,j_dump(proof));hi_checks(proof);hi_pass("old tokens cannot answer a fresh registration, and cancelled old request deadlines do not retire the fresh answered connection");hi_timeout=10000;return proof;}
fn hi_connect(label){let mode=1;if hi_host_reconnect{mode=8;}hi_step(mode);if hi_host_reconnect{hi_marker(h_cat(label,"_connect_requested"));}return 0;}
fn hi_lifecycle(address){hi_vm("address",h_args(bp_string(address),0,0,0,0,0));hi_radio(12);hi_step(1);hi_phase("radio_request_sent",40);hi_step(2);hi_marker("radio_started");ut_ok(ut_args("shell","cmd","bluetooth_manager","disable",0,0),"");hi_radio(10);let observed=cj_text(hi_step(3),"stdout");h_assert(h_equal(observed,"bluetooth_disabled")||h_equal(observed,"service_disconnected")||h_equal(observed,"unregistered"),observed);hi_phase("waiting_collie_revoke_channels",40);hi_pass(h_cat("actual Android STATE_OFF retires the pending HID request, clears peers/tokens and confirms teardown; observed error ",observed));ut_ok(ut_args("shell","cmd","bluetooth_manager","enable",0,0),"");hi_radio(12);hi_connect("collie_revoke");hi_phase("collie_revoke_request_sent",40);hi_step(2);hi_ui(0,"collie_revoke_started");hi_phase("waiting_runtime_revoke_channels",40);hi_step(4);hi_pass("the real Collie Deny Bluetooth control closes its pending SDK channels, invalidates the handle and denies reopening");hi_ui(1,0);hi_connect("runtime_revoke");hi_phase("runtime_revoke_request_sent",40);hi_step(2);let pid=h_trim(h_out(ut_ok(ut_args("shell","pidof","org.flexscript.collie",0,0,0),"")));h_assert(h_len(pid)>0,"No Android CONNECT owner");hi_marker("runtime_revoke_started");ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie","android.permission.BLUETOOTH_CONNECT",0),"");let end=net_now()+15000;let changed=0;while net_now()<end&&!changed{changed=!h_equal(h_trim(h_out(ut_call(ut_args("shell","pidof","org.flexscript.collie",0,0,0),""))),pid);if !changed{h_sleep(100);}}h_assert(changed,"Revocation did not replace the owning process");hi_phase("waiting_fresh_channels",40);hi_step(5);h_assert(!cj_int(cj_get(at_flags(at_package()),"android.permission.BLUETOOTH_CONNECT"),"granted"),"CONNECT remains granted after real revocation");hi_pass("actual Android CONNECT revocation replaces the owning app process, closes its pending channels and leaves durable tokens without live SDK handles");bp_grant("android.permission.BLUETOOTH_CONNECT");hi_connect("fresh");hi_step(6);hi_phase("fresh_report_received",40);hi_step(7);let proof=hi_done(25);h_assert(cj_int(proof,"connections")==4&&cj_int(proof,"closed_channels")==8&&at_bool(cj_get(proof,"encrypted"))&&at_bool(cj_get(proof,"all_opened_channels_closed")),j_dump(proof));hi_checks(proof);return proof;}
fn hi_reports(){let empty=h_vec();hi_vm("reports_open",empty);let loop=hi_program("loop",empty);let payload=j_object();j_set(payload,"source",j_string(loop));let name=at_start(ut_prefix,payload);let printed=0;let disconnected=0;let reconnected=0;let end=net_now()+150000;let observation=0;let proof=0;let done=0;while net_now()<end&&!done{proof=hi_poll();let checks=cj_get(proof,"checks");while printed<j_count(checks){hi_pass(j_value(j_at(checks,printed)));printed=printed+1;}let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{observation=at_observation(at_result(name));}if observation{if h_equal(cj_text(proof,"phase"),"disconnect_ready")&&!disconnected{hi_vm("disconnect",empty);disconnected=1;}if disconnected&&!reconnected&&cj_int(proof,"closed_channels")>=2{hi_vm("reconnect",empty);reconnected=1;}if cj_int(proof,"done"){done=1;}else{payload=j_object();j_set(payload,"source",j_string(loop));name=at_start(ut_prefix,payload);observation=0;}}if !done{h_sleep(100);}}h_assert(done,"Actual HID report exchange deadline");let result=hi_vm("reports_finish",empty);h_assert(at_bool(cj_get(proof,"encrypted")),"Independent HID host did not observe link encryption");hi_pass("the independent HID host observes actual Classic link encryption for the paired report exchange");let unplug=h_equal(cj_text(result,"stdout"),"observed");hi_pass("real request snapshots, invalid response arguments, token replay, protocol callbacks and expired peer IDs are verified by the VM");if unplug{hi_pass("the public virtual-cable unplug callback reaches the VM");}else{h_print(1,"UNVERIFIED Android closed the channels but did not deliver its public unplug callback\n");}return unplug;}
fn hi_stopped(text){let start=h_find(text,"packageName=org.flexscript.collie processName=org.flexscript.collie");if start<0{return 0;}let block=text+start;let end=h_find(block,"* Hist");if end>=0{block=h_slice(block,end);}return h_has(block,"state=STOPPED ");}
fn hi_cleanup(){bp_source=hi_load();ar_set_bluetooth(cj_int(at_extra,"bluetooth"));if cj_int(at_extra,"pair_started"){bp_grant("android.permission.BLUETOOTH_CONNECT");let owned=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));let permission=cj_get(cj_get(owned,"permissions"),"bluetooth");if permission&&(j_kind(permission)!=5||!at_bool(permission)){at_case(ut_prefix,c_json("{\"resume_only\":true}"));hi_ui(1,0);}btp_forget(cj_text(at_extra,"peer_name"),cj_text(at_extra,"peer_address"));}bp_stop();ar_restore();let report=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-report.json")));let current=0;if h_exists(report){current=c_json(h_read(report));}if !current||!h_equal(cj_text(current,"prefix"),ut_prefix){let partial=h_join(ut_out,h_cat(ut_prefix,"-checks.json"));if h_exists(partial){at_checks=c_json(h_read(partial));}let failure=j_object();j_set(failure,"ok",j_bool(0));j_set(failure,"scenario",j_string(cj_text(at_options,"scenario")));j_set(failure,"physical_radio_verified",j_bool(0));j_set(failure,"public_unplug_gate_tested",j_bool(0));let stderr=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-worker.stderr")));if h_exists(stderr){j_set(failure,"error",j_string(h_read(stderr)));}let peer_path=cj_text(at_extra,"peer_path");if h_len(peer_path)&&h_exists(peer_path){j_set(failure,"peer",c_json(h_read(peer_path)));}at_finish(failure);}return 0;}
fn main(argc,argv){
    let scenario="reports";let i=1;while i<argc{if h_equal(load64(argv+i*8),"--scenario")&&i+1<argc{scenario=load64(argv+(i+1)*8);}i=i+1;}h_assert(h_equal(scenario,"reports")||h_equal(scenario,"controls")||h_equal(scenario,"lifecycle"),"Unknown HID scenario");at_cleanup_hook=1;let options=c_json("{\"netsim-port\":\"\",\"peer-python\":\"build/bluetooth-fixture-env/bin/python\",\"scenario\":\"reports\",\"secure-reconnect\":false,\"host-reconnect\":false}");if at_init(argc,argv,h_cat("hid-",scenario),options)<0{return at_self_test();}hi_scenario=cj_text(options,"scenario");hi_host_reconnect=cj_int(options,"host-reconnect");h_assert(!(hi_host_reconnect&&cj_int(options,"secure-reconnect")),"Choose one controlled reconnect mode");if at_cleanup{return hi_cleanup();}let port=h_number(cj_text(options,"netsim-port"));h_assert(port>=1&&port<=65535,"Provide the owned localhost Netsim port");let python=h_absolute(cj_text(options,"peer-python"));h_assert(syscall(21,python,1,0,0,0,0)==0,"Missing external Bumble interpreter");if !at_child{at_extra=ar_snapshot(1,0);h_assert(cj_int(at_extra,"bluetooth"),"Preserve an initially disabled Bluetooth controller");return at_parent(argc,argv);}bp_source=hi_load();let empty=h_vec();ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let permissions=bp_permissions(1);i=h_count(permissions)-1;while i>0{ar_revoke(h_at(permissions,i));i=i-1;}bp_grant(h_at(permissions,0));at_vm(ut_prefix,hi_program("capabilities",empty),c_json("{\"bluetooth\":true,\"location\":false,\"db_read\":true,\"db_write\":true}"));hi_vm("registration",empty);hi_vm("unpaired",empty);hi_pass("permission-free capability metadata stays unknown until an actual HID profile is observed; invalid descriptors do not reserve registration");hi_pass("actual SDK registration/unregistration succeeds, concurrent registration is rejected, confirmed teardown permits reopening and unpaired HID connect fails before I/O");
    bp_path=h_join(ut_out,h_cat(ut_prefix,"-hid-host.json"));hi_command=h_join(ut_out,h_cat(ut_prefix,"-hid-command.json"));h_assert(!h_exists(bp_path)&&!h_exists(hi_command),"Preserve existing owned HID proof files");j_set(at_extra,"peer_path",j_string(bp_path));let args=h_args(python,"scripts/fixtures/collie-hid-host.py","--transport",h_cat3("android-netsim:127.0.0.1:",h_int(port),h_cat(",name=collie-test-",ut_prefix)),"--out",bp_path);h_add(args,"--scenario");h_add(args,hi_scenario);h_add(args,"--command");h_add(args,hi_command);if cj_int(options,"secure-reconnect"){h_add(args,"--secure-reconnect");}if hi_host_reconnect{h_add(args,"--host-reconnect");}hi_child=bp_spawn(args);let end=net_now()+40000;let peer=0;while net_now()<end&&!peer{let value=hi_poll();if cj_int(value,"ready"){peer=value;}else{h_sleep(100);}}h_assert(peer,"Independent HID host did not become ready");let name=cj_text(peer,"name");let prefix="Collie HID test peer ";h_assert(h_starts(name,prefix)&&h_len(name)==h_len(prefix)+8,"Unexpected controlled HID host name");h_unhex(name+h_len(prefix));let address=bp_address(peer);h_assert(btp_unbonded(address),"Preserve an existing HID host pairing");j_set(at_extra,"peer_name",j_string(name));j_set(at_extra,"peer_address",j_string(address));j_set(at_extra,"pair_started",j_bool(1));at_checkpoint_extra();hi_vm("bond",h_args(bp_string(address),0,0,0,0,0));btp_confirm(name);hi_vm("bonded",empty);hi_pass("the explicitly named virtual HID host is paired through Android confirmation before registration, without requesting Location or scanning");let proof=0;let unplug=0;if h_equal(hi_scenario,"controls"){proof=hi_controls();}else if h_equal(hi_scenario,"lifecycle"){proof=hi_lifecycle(address);}else{unplug=hi_reports();proof=hi_poll();}
    hi_vm("foreground",empty);let home=ut_args("shell","am","start","-a","android.intent.action.MAIN","-c");h_add(home,"android.intent.category.HOME");ut_ok(home,"");end=net_now()+60000;let stopped=0;while net_now()<end&&!stopped{let state=h_out(ut_ok(ut_args("shell","dumpsys","activity","activities",0,0),""));stopped=hi_stopped(state);h_save(h_join(ut_out,h_cat(ut_prefix,"-background-activity.txt")),state);if !stopped{h_sleep(100);}}h_assert(stopped,"Collie's own Activity did not stop");hi_vm("background_closed",empty);hi_pass("actual Activity onStop invalidates the HID handle and unregisters the SDK app; returning foreground permits fresh registration");let flags=at_flags(at_package());i=1;while i<h_count(permissions){h_assert(!cj_int(cj_get(flags,h_at(permissions,i)),"granted"),"HID traffic requested SCAN/ADVERTISE or Location");i=i+1;}hi_pass("all HID report traffic and lifecycle checks keep Android SCAN/ADVERTISE and Location denied");let report=j_object();j_set(report,"scenario",j_string(hi_scenario));j_set(report,"physical_radio_verified",j_bool(0));j_set(report,"peer",proof);let success=1;if h_equal(hi_scenario,"reports"){success=unplug;j_set(report,"hid_payload_verified",j_bool(1));j_set(report,"unplug_callback_observed",j_bool(unplug));let missing=j_array();if !unplug{j_push(missing,j_string("public virtual-cable unplug callback"));}j_set(report,"missing_gates",missing);}else{j_set(report,"public_unplug_gate_tested",j_bool(0));if h_equal(hi_scenario,"controls"){j_set(report,"hid_controls_verified",j_bool(1));}else{j_set(report,"hid_lifecycle_verified",j_bool(1));j_set(report,"peer_initiates_reconnect",j_bool(hi_host_reconnect));j_set(report,"android_initiated_after_radio_verified",j_bool(!hi_host_reconnect));}}j_set(report,"ok",j_bool(success));at_finish(report);h_assert(success,"Android unplug callback was not observed; strict HID verification remains incomplete");return 0;
}
