// Actual user take-photo intent and runtime consent on an owned emulator.
import "lib/collie-android-test.flex";
import "lib/image-check.flex";
fn mc_prefs(){return h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));}
fn mc_cleanup(){let prefs=mc_prefs();if !h_has(prefs,ut_prefix){return 0;}let i=0;while i<6{let xml=at_xml();if !h_has(xml,"package=\"com.android.camera2\"")&&!h_has(xml,"permissioncontroller"){return 0;}ut_ok(ut_args("shell","input","keyevent","4",0,0),"");i=i+1;}h_die("Owned take-photo UI did not close after Back navigation");return 1;}
fn mc_request(){let r=c_json("{\"hardware_tests\":true,\"hardware_camera_tests\":true,\"hardware_camera_manual_tests\":true}");let result=cj_get(at_case(ut_prefix,r),"hardware");h_assert(result&&cj_int(result,"manual_action_requested"),j_dump(r));return 0;}
fn mc_clear(){let args=ut_args("shell","pm","clear-permission-flags","org.flexscript.collie","android.permission.CAMERA","user-set");h_add(args,"user-fixed");ut_ok(args,"");return 0;}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"camera-manual",j_object())<0{return at_self_test();}
    if at_cleanup{return mc_cleanup();}if !at_child{return at_parent(argc,argv);}
    let camera=cj_get(at_flags(at_package()),"android.permission.CAMERA");if cj_int(camera,"granted"){ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie","android.permission.CAMERA",0),"");}mc_clear();let first=c_json("{\"hardware_tests\":true,\"hardware_camera_tests\":true,\"hardware_camera_manual_tests\":true,\"initial_permissions\":{\"camera\":false}}");let r=cj_get(at_case(ut_prefix,first),"hardware");h_assert(r&&cj_int(r,"manual_action_requested"),"Manual photo action was not requested");at_click("resource-id","permission_deny_button",1);let end=net_now()+45000;while h_has(mc_prefs(),"manual_camera_session")&&net_now()<end{h_sleep(50);}h_assert(!h_has(mc_prefs(),"manual_camera_session")&&!h_has(mc_prefs(),"camera_file"),"Denied photo left a pending output URI");let session=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));h_assert(!at_bool(cj_get(cj_get(session,"permissions"),"camera")),"Manual photo denial changed the agent grant");at_pass("denying actual Android consent for the explicit user take-photo action creates no output and leaves the agent Camera grant denied");
    mc_clear();mc_request();at_click("resource-id","permission_allow_foreground_only_button",1);at_click("resource-id","shutter_button",1);at_click("resource-id","done_button",1);end=net_now()+60000;let attachment=0;while !attachment&&net_now()<end{session=ut_read(h_cat3("files/workspaces/",ut_prefix,"/session.json"));let attachments=cj_get(session,"pending_attachments");if attachments&&j_count(attachments)==1{attachment=j_at(attachments,0);}else{h_sleep(50);}}h_assert(attachment,"System capture returned no photo attachment");let path=cj_text(attachment,"path");h_assert(cj_int(attachment,"file_bytes")>0&&h_starts(path,"/")&&!h_has(path,".."),"Invalid captured attachment path");h_assert(!at_bool(cj_get(cj_get(session,"permissions"),"camera")),"Manual photo approval changed the agent grant");let process=ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",h_cat3("files/workspaces/",ut_prefix,h_cat("/files",path)),0),"");let local=h_join(ut_out,"manual-camera-attachment.jpg");h_save_bytes(local,h_out(process),h_size(load64(process+16)),420);ic_jpeg(local);h_assert(!h_has(mc_prefs(),"camera_file")&&!h_has(mc_prefs(),"manual_camera_session"),"Completed photo left a pending output URI");at_pass("the real system capture app writes its granted output URI and returns a decodable photo attachment while the agent Camera permission remains denied");
    at_vm(ut_prefix,"fn main(){if camera_list(0,16){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),\"permission_denied\"){return 2;}return 0;}",0);at_pass("manual photo approval never enables later agent Camera SDK access");let report=j_object();j_set(report,"ok",j_bool(1));j_set(report,"physical_devices_verified",j_bool(0));return at_finish(report);
}
