import "lib/proof-harness.flex";
fn suite(compiler) {
    t_init(compiler);
    ps_verify("ensures result<0;fn zero(){return alloc(0);}",0,"Verified roots: 1/1");
    ps_verify("requires n<=0;ensures result<0;fn negative(n){return alloc(n);}",0,"Verified roots: 1/1");
    ps_verify("ensures result<0 || result>0;fn allocate(){return alloc(1);}",0,"allocates byte memory");
    ps_verify("ensures result<0 || writable_bytes(result,1);fn allocate(){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("reads nothing;modifies nothing;ensures result<0 || load8(result)==0;fn zeroed(){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("requires n>0 && n<=8;ensures result<0 || writable_bytes(result,old(n));fn allocate(n){return alloc(n);}",0,"Verified roots: 1/1");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn own(){let p=alloc(8);if p<0{return 0;}assert load64(p)==0;store64(p,42);assert load64(p)==42;return 0;}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(q,1);ensures readable_bytes(q,1);ensures load8(q)==old(load8(q));ensures result<0 || disjoint_bytes(result,1,q,1);fn existing(q){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(q,1);ensures load8(q)==old(load8(q));fn existing(q){let p=alloc(1);if p>0{store8(p,42);}return p;}",0,"Verified roots: 1/1");
    ps_verify("verify;fn two(){let p=alloc(1);let q=alloc(1);assert p<0 || q<0 || p!=q;return 0;}",0,"Verified roots: 1/1");
    ps_verify("verify;fn fail(){let p=alloc(1);return load8(p);}",1,"COUNTEREXAMPLE: memory read safety");
    let wrong=ps_verify("verify;fn wrong(){let p=alloc(1);if p<0{return 0;}assert load8(p)==1;return 0;}",1,"COUNTEREXAMPLE: assertion");
    t_assert(h_has(h_out(wrong),"alloc@"),"allocation counterexample omitted its concrete allocation choice");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn wrong(){let p=alloc(1);if p<0{return 0;}store8(p,2);return load8(p);}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("reads nothing;verify;fn tail(){let p=alloc(1);if p<0{return 0;}return load8(p+1);}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("modifies nothing;verify;fn tail(){let p=alloc(1);if p<0{return 0;}return store8(p+1,1);}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("requires writable_bytes(q,1);modifies nothing;fn unrelated(q){let p=alloc(1);return store8(q,1);}",1,"COUNTEREXAMPLE: write frame");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn inline(){let p=allocate();if p<0{return 0;}store8(p,42);assert load8(p)==42;return 0;}fn allocate(){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("verify;fn repeated(){let p=allocate();let q=allocate();assert p<0 || q<0 || p!=q;return 0;}fn allocate(){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("verify;fn repeated_bad(){let p=allocate();let q=allocate();if p<0 || q<0{return 0;}store8(p,42);assert load8(q)==42;return 0;}fn allocate(){return alloc(1);}",1,"COUNTEREXAMPLE: assertion");
    let set="requires writable_bytes(p,1);reads bytes(p,1);modifies bytes(p,1);ensures load8(p)==42;fn set(p){return store8(p,42);}";
    ps_verify(h_cat(set,"reads nothing;modifies nothing;ensures result==0;fn caller(){let p=alloc(1);if p<0{return 0;}set(p);return load8(p)-42;}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(set,"reads nothing;modifies nothing;ensures result==0;fn caller(){let p=alloc(1);if p<0{return 0;}set(p);return load8(p);}"),1,"COUNTEREXAMPLE: postcondition");
    ps_verify("reads nothing;modifies nothing;fn caller(){let p=alloc(1);if p<0{return 0;}return helper(p);}reads nothing;fn helper(p){return load8(p);}",1,"COUNTEREXAMPLE: read frame in helper");
    ps_verify("modifies nothing;fn caller(){let p=alloc(1);if p<0{return 0;}return helper(p);}modifies nothing;fn helper(p){return store8(p,1);}",1,"COUNTEREXAMPLE: write frame in helper");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn branch(flag){let p=0;if flag {p=alloc(1);}else {p=alloc(1);}if p<0{return 0;}store8(p,42);return load8(p)-42;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==0;fn branch(flag){let p=0;if flag {p=alloc(1);}else {p=alloc(1);}if p<0{return 0;}return load8(p)+1;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("ensures result==0;fn short(flag){let p=flag && alloc(1);return 0;}",0,"Verified roots: 1/1");
    ps_verify("ensures result==0;fn early(flag){if flag {let p=alloc(1);if p<0{return 0;}return load8(p);}let q=alloc(1);if q<0{return 0;}return load8(q);}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(q,1);ensures old(readable_bytes(q,1));ensures load8(q)==old(load8(q));fn failure(q){return alloc(0);}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(q,1);ensures old(readable_bytes(q,1));fn old_heap(q){return alloc(1);}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(q,1);reads nothing;fn old_frame(q){let p=alloc(1);return load8(q);}",1,"COUNTEREXAMPLE: read frame");
    ps_verify("ensures result==0;fn reused_name(p){let q=alloc(1);if q<0{return 0;}p=q;assert writable_bytes(p,1);store8(p,42);return load8(q)-42;}",0,"Verified roots: 1/1");
    ps_verify("ensures result<0 || writable_bytes(result,1);fn allocate(){return alloc(1);}verify;fn caller(){return allocate();}",0,"Verified roots: 2/2");
    let factory="reads nothing;modifies nothing;ensures result<0 || (fresh_bytes(result,1) && writable_bytes(result,1) && load8(result)==0);fn allocate(){return alloc(1);}";
    ps_verify(h_cat(factory,"reads nothing;modifies nothing;ensures result==0;fn caller(){let p=allocate();if p<0{return 0;}store8(p,42);return load8(p)-42;}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(factory,"requires readable_bytes(q,1);modifies nothing;ensures load8(q)==old(load8(q));fn preserve(q){return allocate();}"),0,"Verified roots: 2/2");
    ps_verify(h_cat(factory,"ensures result==1;fn wrong(){let p=allocate();if p<0{return 1;}return load8(p);}"),1,"COUNTEREXAMPLE: postcondition");
    ps_verify("verify;fn loop(){let i=0;invariant i>=0 && i<=2;decreases 2-i;while i<2{alloc(1);i=i+1;}return 0;}",0,"Verified roots: 1/1");
    ps_verify("modifies nothing;fn fresh_loop(){let p=alloc(1);if p<0{return 0;}let i=0;invariant i>=0 && i<=2;decreases 2-i;while i<2{store8(p,42);i=i+1;}assert load8(p)==0;return 0;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn fresh_loop(){let p=alloc(1);if p<0{return 0;}let i=0;invariant i>=0 && i<=2;invariant load8(p)==i;decreases 2-i;while i<2{store8(p,i+1);i=i+1;}return load8(p)-2;}",0,"Verified roots: 1/1");
    ps_verify("reads nothing;modifies nothing;ensures result==0;fn allocating_loop(){let p=0;let i=0;invariant i>=0 && i<=2;invariant i==0 || (fresh_bytes(p,1) && writable_bytes(p,1) && load8(p)==42);decreases 2-i;while i<2{p=alloc(1);if p<0{return 0;}store8(p,42);i=i+1;}return load8(p)-42;}",0,"Verified roots: 1/1");
    ps_verify("requires n>=0 && n<=3;reads nothing;modifies nothing;decreases n;ensures result<0 || (fresh_bytes(result,1) && writable_bytes(result,1));fn recursive(n){if n==0{return alloc(1);}return recursive(n-1);}",0,"Verified roots: 1/1");
    ps_verify(h_cat(factory,"verify;fn separate(){let p=allocate();let q=allocate();assert p<0 || q<0 || p!=q;return 0;}"),0,"Verified roots: 2/2");
    ps_verify("requires readable_bytes(p,1);ensures !fresh_bytes(p,1);ensures !old(fresh_bytes(p,1));fn existing(p){return 0;}",0,"Verified roots: 1/1");
    ps_verify("ensures fresh_bytes(0,0) && !fresh_bytes(0,1) && !fresh_bytes(1,-1);fn geometry(){return 0;}",0,"Verified roots: 1/1");
    ps_verify("verify;fn wrong_fresh(p){assert fresh_bytes(p,1);return 0;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("requires readable_bytes(p,1);ensures fresh_bytes(p,1);fn wrong(p){return 0;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("reads nothing;modifies nothing;ensures result<0 || fresh_bytes(result,8);fn whole(){return alloc(8);}",0,"Verified roots: 1/1");
    let wide="reads nothing;modifies nothing;ensures result<0 || (fresh_bytes(result,8) && writable_bytes(result,8));fn wide(){return alloc(8);}";
    ps_verify(h_cat(wide,"reads nothing;modifies nothing;ensures result==0;fn caller(){let p=wide();if p<0{return 0;}store64(p,42);return load64(p)-42;}"),0,"Verified roots: 2/2");
    ps_verify("verify;fn too_wide(){let p=alloc(1);if p<0{return 0;}assert fresh_bytes(p,2);return 0;}",1,"COUNTEREXAMPLE: assertion");
    ps_verify("trusted;terminates;reads nothing;modifies nothing;ensures fresh_bytes(result,1);fn invent(){return alloc(1);}verify;fn caller(){return invent();}",1,"trusted normal-return contract admits no return state");
    let release="trusted;terminates;reads nothing;modifies nothing;releases bytes(p,1);ensures !readable_bytes(old(p),1);fn release(p){return 0;}";
    let renew=h_cat(release,"requires writable_bytes(p,1);reads nothing;modifies nothing;releases bytes(p,1);ensures result<0 || (fresh_bytes(result,1) && writable_bytes(result,1));ensures old(writable_bytes(p,1));fn renew(p){release(p);return alloc(1);}");
    ps_verify(h_cat(renew,"requires writable_bytes(p,1);releases bytes(p,1);ensures result<0 || fresh_bytes(result,1);fn caller(p){return renew(p);}"),0,"CONDITIONAL:");
    ps_verify(h_cat(release,"verify;fn no_grant(){let p=alloc(1);if p<0{return 0;}release(p);proof{if fresh_bytes(p,1){assert readable_bytes(p,1);}}return 0;}"),1,"UNPROVED: assertion");
    ps_verify(h_cat(release,"reads nothing;modifies nothing;releases nothing;ensures result==0;fn recycle(){let p=alloc(1);if p<0{return 0;}let i=0;invariant i>=0 && i<=2;invariant fresh_bytes(p,1) && writable_bytes(p,1);decreases 2-i;while i<2{release(p);p=alloc(1);if p<0{return 0;}i=i+1;}return 0;}"),0,"CONDITIONAL:");
    ps_verify(h_cat(release,"reads nothing;modifies nothing;releases nothing;fn wrong_rank(){let p=alloc(1);if p<0{return 0;}let i=0;invariant i>=0 && i<=2;invariant fresh_bytes(p,1) && writable_bytes(p,1);decreases i;while i<2{release(p);p=alloc(1);if p<0{return 0;}i=i+1;}return 0;}"),1,"UNPROVED: decreases progress");
    // A weakened path may discard an indirect equality chain. That SAT
    // attempt must fall back to the complete query, never become a verdict.
    ps_verify("requires readable_bytes(p,1);requires x==a && a==b && b==y;ensures result==y;fn linked(p,x,a,b,y){return x;}",0,"Verified roots: 1/1");
    ps_verify("requires readable_bytes(p,1);requires x==a && b==y;ensures result==y;fn missing_link(p,x,a,b,y){return x;}",1,"COUNTEREXAMPLE: postcondition");
    ps_verify("fn fresh_bytes(p,n){return p+n;}ensures result==3;fn shadow(){return fresh_bytes(1,2);}",0,"Verified roots: 1/1");
    ps_bad("ensures fresh_bytes(p);fn invalid(p){return 0;}","wrong memory operation argument count");
    ps_verify("verify;fn unreachable(){while 0{alloc(1);}return 0;}",0,"Verified roots: 1/1");
    ps_verify("ensures result<0 || writable_bytes(result,1);fn after_loop(){let i=0;invariant i>=0 && i<=2;decreases 2-i;while i<2{i=i+1;}return alloc(1);}",0,"Verified roots: 1/1");
    ps_bad("ensures alloc(1)>0;fn invalid(){return 0;}","proof expressions cannot modify or allocate memory");
    ps_bad("spec fn invalid(){return alloc(1);}","proof expressions cannot modify or allocate memory");
    let program="reads nothing;modifies nothing;ensures result==0;fn main(){let p=alloc(8);if p<0{return 0;}store64(p,42);return load64(p)-42;}";
    t_native(program,0,"");h_check(h_run(h_args(t_compiler,t_fixture,0,0,0,0)),0,"");t_checks=t_checks+1;
    let annotated=h_sha(t_binary);t_program("fn main(){let p=alloc(8);if p<0{return 0;}store64(p,42);return load64(p)-42;}");t_compile();
    t_assert(h_equal(annotated,h_sha(t_binary)),"allocation annotations changed executable bytes");
    return t_done();
}
fn main(argc,argv) {return t_entry(argc,argv);}
