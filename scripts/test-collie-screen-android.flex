// Actual MediaProjection chooser, frames/video/audio and screen-lock teardown.
import "lib/android-radio-test.flex";
global sc_source=0;
fn sc_program(call){return h_cat3(sc_source,"\nfn main(){return screen_live_",h_cat(call,"();}"));}
fn sc_vm(call){return at_vm(ut_prefix,sc_program(call),0);}
fn sc_info(key,field){return cj_text(at_vm(ut_prefix,h_cat3(sc_source,"\nfn main(){return screen_live_info(",h_cat3(j_dump(j_string(key)),",",h_cat(j_dump(j_string(field)),");}"))),0),"stdout");}
fn sc_wait(key,field,value,seconds){let end=net_now()+seconds*1000;while net_now()<end{if h_equal(sc_info(key,field),value){return 0;}h_sleep(50);}h_die(h_cat3("Actual screen lifecycle deadline: ",field,h_cat("=",value)));return 0;}
fn sc_fixture(flags){j_set(flags,"hardware_screen_tests",j_bool(1));return at_sdk(ut_prefix,flags);}
fn sc_approve(){let end=net_now()+20000;while net_now()<end{let xml=at_xml();let labels=h_args("Share screen","Start now","Start recording","Share",0,0);let i=0;while i<h_count(labels){let node=at_node(xml,"text",h_at(labels,i),0);if node&&h_equal(ut_attr(node,"class"),"android.widget.Button"){h_assert(h_equal(ut_attr(node,"package"),"com.android.systemui"),"Capture approval belongs to another app");h_save(h_join(ut_out,"screen-consent.xml"),xml);return ut_tap(node);}i=i+1;}h_sleep(50);}h_die("Expected real SystemUI projection chooser");return 0;}
fn sc_unlock(){ut_ok(ut_args("shell","input","keyevent","KEYCODE_WAKEUP",0,0),"");ut_ok(ut_args("shell","input","keyevent","82",0,0),"");let node=at_node(at_xml(),"password","true",0);if node{h_assert(h_equal(ut_attr(node,"package"),"com.android.systemui")&&h_has(h_out(ut_ok(ut_args("emu","avd","name",0,0,0),"")),"Collie_Biometrics_API36"),"Only the existing public owned biometric fixture PIN may be entered");ut_ok(ut_args("shell","input","text","135790",0,0),"");ut_ok(ut_args("shell","input","keyevent","66",0,0),"");}return 0;}
fn sc_cleanup(){sc_unlock();let projection=h_out(ut_ok(ut_args("shell","dumpsys","media_projection",0,0,0),""));h_assert(h_has(projection,"null"),"Owned projection did not stop after app shutdown");let path="shared_prefs/screen-capture-tickets.xml";if cj_int(at_extra,"tickets_present"){at_write(path,cj_text(at_extra,"tickets"));h_assert(h_equal(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),"")),cj_text(at_extra,"tickets")),"Original projection tickets not restored");}else{ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",path),"");}return 0;}
fn sc_video_start(duration){at_vm(ut_prefix,h_cat3(sc_source,"\nfn main(){return screen_live_video(",h_cat(h_int(duration),");}")),0);return sc_wait("screen_video","state","recording",60);}
fn sc_video_stop(){sc_vm("video_stop");sc_wait("screen_video","state","stopped",60);return sc_fixture(c_json("{\"hardware_screen_video_tests\":true}"));}
fn main(argc,argv){
    at_cleanup_hook=1;if at_init(argc,argv,"screen",j_object())<0{return at_self_test();}if at_cleanup{return sc_cleanup();}if !at_child{let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/screen-capture-tickets.xml",0),"");let raw=h_out(p);at_extra=j_object();j_set(at_extra,"tickets_present",j_bool(h_starts(h_trim(raw),"<?xml")));if cj_int(at_extra,"tickets_present"){j_set(at_extra,"tickets",j_string(raw));}else{h_assert(h_has(raw,"No such file or directory"),"Could not snapshot existing projection tickets");}h_assert(h_has(h_out(ut_ok(ut_args("shell","dumpsys","media_projection",0,0,0),"")),"null"),"Existing projection must be preserved; no screen test submitted");return at_parent(argc,argv);}
    sc_source=h_read("apps/collie/tests/screen-live.flex");ar_revoke("android.permission.RECORD_AUDIO");at_vm(h_cat(ut_prefix,"-deny"),sc_program("deny"),c_json("{\"screen_capture\":false}"));at_pass("Collie screen denial prevents SDK access without starting OS consent");let sid=h_cat(ut_prefix,"-ask");let name=at_conversation(sid,sc_program("inventory"),c_json("{\"screen_capture\":\"ask\"}"));at_pending(sid,"screen_capture","permission",name);at_click("text","Allow requested access",0);at_observation(at_result(name));at_pass("first-use Collie screen approval resumes inventory without opening the Android capture chooser");let initial=c_json("{\"screen_capture\":true,\"db_read\":true,\"db_write\":true}");sid=h_cat(ut_prefix,"-os-deny");name=at_conversation(sid,sc_program("os_deny"),initial);at_pending(sid,"screen_capture","platform_permission",name);at_click("text","Cancel",0);at_observation(at_result(name));h_assert(!at_bool(cj_get(cj_get(ut_read(h_cat3("files/workspaces/",sid,"/session.json")),"permissions"),"screen_capture")),"OS capture denial not saved");at_pass("declining real Android session consent resumes with denial and remembers the choice");
    name=at_conversation(ut_prefix,sc_program("open"),initial);at_pending(ut_prefix,"screen_capture","platform_permission",name);sc_approve();at_observation(at_result(name));sc_wait("screen","state","capturing",20);at_pass("actual SystemUI session approval starts the foreground service and creates one real projection display");sc_vm("idempotent");at_pass("live ticket replay is idempotent; changed options, live forget and excessive geometry fail");sc_fixture(c_json("{\"hardware_screen_frame_tests\":true}"));sc_vm("resize");h_sleep(700);sc_vm("resized");at_pass("surface pause/resume and resizing the existing display deliver frames at the requested dimensions");sc_fixture(c_json("{\"hardware_screen_background_tests\":true}"));
    sc_video_start(10000);h_sleep(2000);sc_vm("video_pause");h_sleep(1000);sc_video_stop();sc_vm("video_close");at_pass("explicit video pause/resume/stop uses the same consented projection and restores frame output");sc_video_start(1500);sc_wait("screen_video","state","stopped",15);sc_fixture(c_json("{\"hardware_screen_video_tests\":true}"));sc_vm("video_close");at_pass("real recorder duration-limit callback finalizes screen recording automatically");name=at_conversation(ut_prefix,sc_program("video_audio"),0);at_pending(ut_prefix,"microphone","permission",name);at_click("text","Allow requested access",0);let runtime=at_pending(ut_prefix,0,"platform_permission",name);h_assert(h_has(j_dump(cj_get(cj_get(runtime,"pending_execution"),"signal")),"android.permission.RECORD_AUDIO"),"Screen audio did not request actual Android microphone access");at_click("resource-id","permission_allow_foreground_only_button",1);at_observation(at_result(name));sc_wait("screen_video","state","recording",60);h_sleep(2000);sc_video_stop();sc_vm("video_close");at_pass("audio recording asks for separate Collie Microphone and actual Android runtime approval, then produces a real audio track");sc_video_start(10000);h_sleep(2000);sc_vm("shutdown");sc_wait("screen","lease_released","yes",20);sc_wait("screen_video","state","stopped",20);sc_fixture(c_json("{\"hardware_screen_video_tests\":true}"));sc_vm("video_close");at_pass("projection shutdown finalizes the active recording and releases the SDK display, projection and foreground service");sc_vm("forget");at_pass("ended consent cannot be reused; terminal ticket forgetting and explicit handle close succeed");
    name=at_conversation(ut_prefix,sc_program("lock_open"),0);at_pending(ut_prefix,"screen_capture","platform_permission",name);sc_approve();at_observation(at_result(name));sc_wait("screen","state","capturing",20);ut_ok(ut_args("shell","input","keyevent","KEYCODE_SLEEP",0,0),"");let end=net_now()+15000;let stopped=0;while net_now()<end&&!stopped{stopped=h_has(h_out(ut_ok(ut_args("shell","dumpsys","media_projection",0,0,0),"")),"null");if !stopped{h_sleep(50);}}h_assert(stopped,"Android did not stop projection on actual screen lock");sc_unlock();sc_wait("screen","lease_released","yes",20);h_assert(h_equal(sc_info("screen","sdk_terminal"),"yes")&&h_equal(sc_info("screen","display_release_returned"),"yes")&&h_equal(sc_info("screen","service_stopped"),"yes"),"SDK lock teardown incomplete");at_pass("actual screen lock triggers Android projection onStop and completed display/service cleanup before releasing the lease");sc_vm("lock_forget");let report=j_object();j_set(report,"physical_devices_verified",j_bool(0));return at_finish(report);
}
