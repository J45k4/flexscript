// Pure Flexscript generator for pinned Unicode 17 bidirectional properties.
import "lib/json.flex";
import "../lib/bytes.flex";
fn ubg_hex(s){let v=0;let i=0;while load8(s+i){let c=load8(s+i);let d=-1;if c>=48 && c<=57{d=c-48;}else if c>=65 && c<=70{d=c-55;}else if c>=97 && c<=102{d=c-87;}h_assert(d>=0,"Invalid bidi hexadecimal scalar");v=v*16+d;i=i+1;}return v;}
fn ubg_class(s){
    let names=j_parse("[\"L\",\"R\",\"AL\",\"EN\",\"ES\",\"ET\",\"AN\",\"CS\",\"NSM\",\"BN\",\"B\",\"S\",\"WS\",\"ON\",\"LRE\",\"LRO\",\"RLE\",\"RLO\",\"PDF\",\"LRI\",\"RLI\",\"FSI\",\"PDI\"]");
    if h_equal(s,"Left_To_Right"){return 0;}if h_equal(s,"Right_To_Left"){return 1;}if h_equal(s,"Arabic_Letter"){return 2;}if h_equal(s,"European_Terminator"){return 5;}
    let i=0;while i<j_count(names){if h_equal(s,j_value(j_at(names,i))){return i;}i=i+1;}h_die(h_cat("Unknown bidi class ",s));return 0;
}
fn ubg_encode(out,v,digits){let shift=(digits-1)*6;while shift>=0{let c=63+((v>>shift)&63);if c==92{h_text(out,"\\");}let p=h_take(1);store8(p,c);h_append(out,p,1);shift=shift-6;}return 0;}
fn ubg_header(out,kind){h_text(out,"// Generated by scripts/unicode-bidi-properties.flex from Unicode 17.0.0.\n// Derived Unicode data (c) 2025 Unicode, Inc.; Unicode License V3: libs/unicode/LICENSE.txt.\n// Six-bit ASCII digits biased by 63; ");h_text(out,kind);h_text(out,"\n");return 0;}
fn ubg_classes(map,path,missing){
    let text=h_read(path);let at=0;while load8(text+at){let end=at;while load8(text+end) && load8(text+end)!=10{end=end+1;}let line=h_slice(text+at,end-at);at=end;if load8(text+at){at=at+1;}
        if missing{let mark=h_find(line,"@missing:");if mark>=0{line=h_trim(line+mark+9);}else{line="";}}
        else{let mark=h_find(line,"#");if mark>=0{line=h_slice(line,mark);}line=h_trim(line);}
        if h_len(line){let semi=h_find(line,";");h_assert(semi>=0,"Bidi class separator");let span=h_trim(h_slice(line,semi));let value=ubg_class(h_trim(line+semi+1));let dots=h_find(span,"..");let first=0;let last=0;if dots<0{first=ubg_hex(span);last=first;}else{first=ubg_hex(h_slice(span,dots));last=ubg_hex(span+dots+2);}h_assert(first<=last && last<1114112,"Bidi range bounds");let i=first;while i<=last{store8(map+i,value);i=i+1;}}
    }return 0;
}
fn ubg_pairs(out,path,brackets){
    let text=h_read(path);let at=0;let count=0;let previous=-1;while load8(text+at){let end=at;while load8(text+end) && load8(text+end)!=10{end=end+1;}let line=h_slice(text+at,end-at);at=end;if load8(text+at){at=at+1;}let comment=h_find(line,"#");if comment>=0{line=h_slice(line,comment);}line=h_trim(line);if h_len(line){let semi=h_find(line,";");h_assert(semi>=0,"Bidi pair separator");let cp=ubg_hex(h_trim(h_slice(line,semi)));line=h_trim(line+semi+1);let pair=0;let kind=0;if brackets{semi=h_find(line,";");h_assert(semi>=0,"Bidi bracket kind");pair=ubg_hex(h_trim(h_slice(line,semi)));let name=h_trim(line+semi+1);if h_equal(name,"o"){kind=1;}else{h_assert(h_equal(name,"c"),"Bidi bracket type");kind=2;}}else{pair=ubg_hex(line);}h_assert(cp>previous && cp<1114112 && pair<1114112,"Bidi pairs sorted and in range");previous=cp;ubg_encode(out,cp,4);ubg_encode(out,pair,4);if brackets{ubg_encode(out,kind,1);}count=count+1;}}
    return count;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"unicode-bidi-properties UCD-directory output.flex");let base=load64(argv+8);let manifest=j_parse(h_read(h_join(base,"manifest.json")));h_assert(h_equal(j_s(manifest,"version"),"17.0.0"),"Expected Unicode 17.0.0");let sources=j_need(manifest,"sources");let i=0;while i<j_count(sources){let f=j_at(sources,i);h_assert(h_equal(h_sha(h_join(base,j_s(f,"file"))),j_s(f,"sha256")),"Unicode source hash mismatch");i=i+1;}
    let map=alloc(1114112);h_assert(map>0,"Bidi property allocation");bytes_fill(map,0,1114112);let path=h_join(base,"extracted/DerivedBidiClass.txt");ubg_classes(map,path,1);ubg_classes(map,path,0);
    let out=h_buffer();ubg_header(out,"class ranges start(4), end(4), class(1); brackets cp(4), pair(4), type(1); mirrors cp(4), mirror(4).");h_text(out,"fn unicode_bidi_class_data(){return \"");let count=0;i=0;while i<1114112{let value=load8(map+i);let end=i;while end+1<1114112 && load8(map+end+1)==value{end=end+1;}if value{ubg_encode(out,i,4);ubg_encode(out,end,4);ubg_encode(out,value,1);count=count+1;}i=end+1;}h_text(out,"\";}\nfn unicode_bidi_class_count(){return ");h_text(out,h_int(count));h_text(out,";}\nfn unicode_bidi_bracket_data(){return \"");let brackets=ubg_pairs(out,h_join(base,"BidiBrackets.txt"),1);h_text(out,"\";}\nfn unicode_bidi_bracket_count(){return ");h_text(out,h_int(brackets));h_text(out,";}\nfn unicode_bidi_mirror_data(){return \"");let mirrors=ubg_pairs(out,h_join(base,"BidiMirroring.txt"),0);h_text(out,"\";}\nfn unicode_bidi_mirror_count(){return ");h_text(out,h_int(mirrors));h_text(out,";}\n");h_save(load64(argv+16),h_data(out));syscall(11,map,1114112,0,0,0,0);h_print(1,h_cat3("Generated bidi ranges/brackets/mirrors: ",h_int(count),h_cat3("/",h_int(brackets),h_cat3("/",h_int(mirrors),"\n"))));return 0;
}
