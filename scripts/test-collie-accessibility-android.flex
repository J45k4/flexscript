fn ac_cleanup(){if ac_enabled(){ac_disable();}h_assert(!ac_enabled(),"Owned service was left enabled");let settings=h_out(ut_ok(ut_args("shell","settings","get","secure","enabled_accessibility_services",0),""));h_assert(h_equal(settings,cj_text(at_extra,"services")),"Unrelated accessibility service settings changed");h_assert(h_equal(h_out(ut_ok(ut_args("shell","settings","get","secure","accessibility_enabled",0),"")),cj_text(at_extra,"enabled")),"Original accessibility enablement did not restore");at_verify_package(ac_probe(),"org.flexscript.collie.uiprobe");if !cj_int(at_extra,"probe_installed"){ut_ok(ut_args("uninstall","org.flexscript.collie.uiprobe",0,0,0,0),"");}return 0;}
