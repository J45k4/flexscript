// Shared native Android test host. A parent restores app state after child
// failure as well as success. Only explicitly selected owned emulators run.
import "android-usb-test.flex";
global at_result_timeout=180000;global at_parent_timeout=900000;
global at_expected_calls=0;global at_probe_xml=0;
global at_preserve=1;
global at_cleanup=0;global at_cleanup_hook=0;global at_extra=0;
global at_foreground_marker=0;global at_seen_requests=0;
global at_child=0;global at_options=0;global at_suite=0;global at_checks=0;global at_sha=0;global at_sequence=0;
fn at_bool(value){h_assert(value&&j_kind(value)==5,"Expected an actual JSON boolean");return j_value(value);}
fn at_copy(value){return c_json(j_dump(value));}
fn at_pass(text){j_push(at_checks,j_string(text));h_print(1,h_cat3("PASS ",text,"\n"));return 0;}
fn at_lines(text){let rows=h_vec();let start=0;let i=0;while load8(text+i){if load8(text+i)==10{h_add(rows,h_slice(text+start,i-start));start=i+1;}i=i+1;}if i>start{h_add(rows,h_slice(text+start,i-start));}return rows;}
fn at_owned(name){return ut_name(name)&&h_starts(name,h_cat(ut_prefix,"-"));}
fn at_write(path,text){h_assert(h_starts(path,"files/")||(h_equal(path,"shared_prefs/MainActivity.xml")||h_equal(path,"shared_prefs/document-trees.xml")||h_equal(path,"shared_prefs/screen-capture-tickets.xml")),"Unsafe app fixture destination");let i=0;while load8(path+i){let c=load8(path+i);h_assert((c>=48&&c<=57)||(c>=65&&c<=90)||(c>=97&&c<=122)||c==47||c==46||c==45||c==95,"Unsafe app fixture path");i=i+1;}h_assert(!h_has(path,".."),"Parent traversal in app fixture path");return ut_ok(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'umask 077; cat > ",path,"'")),text);}
fn at_verify_package(apk,package){let expected=h_sha(apk);let path=h_trim(h_out(ut_ok(ut_args("shell","pm","path",package,0,0),"")));h_assert(h_starts(path,"package:/data/app/")&&!h_has(path,"\n"),"Expected one installed Collie APK");let process=ut_call(ut_args("exec-out","cat",path+8,0,0,0),"");h_check(process,0,0);let actual=h_sha_bytes(h_out(process),h_size(load64(process+16)));h_assert(h_equal(actual,expected),"Installed Collie APK differs from the named test artifact; install it before testing");return expected;}
fn at_verify_apk(){return at_verify_package(h_join(ut_out,"collie.apk"),"org.flexscript.collie");}
fn at_flags(text){let rows=at_lines(text);let result=j_object();let i=0;while i<h_count(rows){let line=h_trim(h_at(rows,i));let at=h_find(line,": granted=");if at>0{let key=h_slice(line,at);let flags=h_find(line,"flags=[");if flags>=0{let end=h_find(line+flags+7,"]");h_assert(end>=0,"Malformed actual Android grant flags");let record=j_object();j_set(record,"granted",j_bool(h_starts(line+at+10,"true")));j_set(record,"flags",j_string(h_slice(line+flags+7,end)));j_set(result,key,record);}}i=i+1;}h_assert(j_count(result)>0,"No Android permission records found");return result;}
fn at_package(){return h_out(ut_ok(ut_args("shell","dumpsys","package","org.flexscript.collie",0,0),""));}
fn at_bounded(args,input,timeout){let process=h_spawn(args,input,0);let until=net_now()+timeout;while h_status(process)==-999||load64(process+40)>=0||load64(process+48)>=0{h_pump(process,10);if net_now()>=until{h_stop(process);}}return process;}
fn at_selected(flags){let i=0;while load8(flags+i){let end=i;while load8(flags+end)&&load8(flags+end)!=124{end=end+1;}let flag=h_trim(h_slice(flags+i,end-i));if h_equal(flag,"524288")||h_equal(flag,"SELECTED_LOCATION_ACCURACY"){return 1;}i=end;if load8(flags+i){i=i+1;}}return 0;}
fn at_accuracy_probe(wanted){
    let directory=h_join(ut_out,"permission-state-probe");let classes=h_join(directory,"classes");let dex=h_join(directory,"dex");h_mkdir(classes);h_mkdir(dex);let source=h_real("apps/collie/tests/android-permission-probe/PermissionState.java");let args=h_args(h_executable("javac"),"--release","8","-d",classes,source);let p=at_bounded(args,"",45000);if h_status(p)!=0{h_save(h_join(directory,"javac-error.txt"),h_err(p));return 0;}
    let sdk=h_getenv("ANDROID_HOME");if !sdk||!h_exists(h_join(sdk,"build-tools/36.1.0/d8")){sdk="/opt/android-sdk";}args=h_args(h_join(sdk,"build-tools/36.1.0/d8"),"--min-api","26","--lib",h_join(sdk,"platforms/android-36/android.jar"),"--output");h_add(args,dex);h_add(args,h_join(classes,"org/flexscript/collie/test/PermissionState.class"));p=at_bounded(args,"",45000);if h_status(p)!=0{h_save(h_join(directory,"d8-error.txt"),h_err(p));return 0;}
    let remote=h_cat3("/data/local/tmp/",ut_prefix,"-permission-flags.dex");p=at_bounded(ut_args("push",h_join(dex,"classes.dex"),remote,0,0,0),"",45000);if h_status(p)!=0{return 0;}args=ut_args("shell","env",h_cat("CLASSPATH=",remote),"app_process","/system/bin","org.flexscript.collie.test.PermissionState");h_add(args,h_int(wanted));p=at_bounded(args,"",45000);h_save(h_join(directory,"readback.stdout"),h_out(p));h_save(h_join(directory,"readback.stderr"),h_err(p));let removed=at_bounded(ut_args("shell","rm","-f",remote,0,0),"",45000);if h_status(p)!=0||h_status(removed)!=0{return 0;}let result=c_json(h_out(p));return result&&cj_int(result,"selected")==wanted;
}
fn at_restore_flags(before){
    let pairs=j_value(before);let current=at_flags(at_package());let i=0;
    // Grouped runtime grants can affect their siblings. Restore all grants
    // before restoring any per-permission flags, matching Android's ownership.
    while i<h_count(pairs){let pair=h_at(pairs,i);let permission=load64(pair);let expected=load64(pair+8);let now=cj_get(current,permission);h_assert(now,"Android permission record disappeared");if !cj_int(expected,"granted")&&cj_int(now,"granted"){ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie",permission,0),"");}i=i+1;}
    current=at_flags(at_package());i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let permission=load64(pair);let expected=load64(pair+8);let now=cj_get(current,permission);if cj_int(expected,"granted")&&!cj_int(now,"granted"){ut_ok(ut_args("shell","pm","grant","org.flexscript.collie",permission,0),"");}i=i+1;}
    current=at_flags(at_package());let flags=h_args("USER_SET","USER_FIXED","ONE_TIME","AUTO_REVOKED","REVIEW_REQUIRED","REVOKE_WHEN_REQUESTED");i=0;
    while i<h_count(pairs){let pair=h_at(pairs,i);let permission=load64(pair);let expected=load64(pair+8);let now=cj_get(current,permission);let n=0;while n<h_count(flags){let flag=h_at(flags,n);let was=h_has(cj_text(expected,"flags"),flag);let actual=h_has(cj_text(now,"flags"),flag);if was!=actual{let name=h_take(h_len(flag)+1);let k=0;while load8(flag+k){let c=load8(flag+k);if c>=65&&c<=90{c=c+32;}if c==95{c=45;}store8(name+k,c);k=k+1;}let action="clear-permission-flags";if was{action="set-permission-flags";}ut_ok(ut_args("shell","pm",action,"org.flexscript.collie",permission,name),"");}n=n+1;}i=i+1;}
    let accuracy_ok=1;let expected_accuracy=cj_get(before,"android.permission.ACCESS_FINE_LOCATION");let actual_accuracy=cj_get(at_flags(at_package()),"android.permission.ACCESS_FINE_LOCATION");if expected_accuracy&&actual_accuracy&&at_selected(cj_text(expected_accuracy,"flags"))!=at_selected(cj_text(actual_accuracy,"flags")){accuracy_ok=at_accuracy_probe(at_selected(cj_text(expected_accuracy,"flags")));}
    let after=at_flags(at_package());let same=h_equal(j_dump(before),j_dump(after));if !same{let report=j_object();j_set(report,"expected",before);j_set(report,"actual",after);j_set(report,"precision_probe_ok",j_bool(accuracy_ok));j_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-flags-mismatch.json"))),report);}return same&&accuracy_ok;
}
fn at_start(session,payload){h_assert(ut_name(session),"Unsafe fixture conversation");if !cj_get(payload,"hardware_preserve_handles"){j_set(payload,"hardware_preserve_handles",j_bool(at_preserve));}let name=ut_start(session,payload);j_save(h_join(ut_out,h_cat3("request-",name,".json")),payload);return name;}
fn at_result(name){let end=net_now()+at_result_timeout;while net_now()<end{let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{let expected=cj_get(at_expected_calls,name);if expected{j_set(r,"driver_call_id",expected);}j_save(h_join(ut_out,h_cat3("case-",name,".json")),r);h_assert(cj_int(r,"ok"),j_dump(r));return r;}if at_foreground_marker{let request=ut_read(h_cat3("files/workspaces/",ut_prefix,h_cat("/",at_foreground_marker)));let token=cj_text(request,"request_id");if h_len(token)&&!cj_get(at_seen_requests,token){j_set(at_seen_requests,token,j_bool(1));j_save(h_join(ut_out,h_cat3("foreground-",ut_prefix,h_cat3("-",h_int(j_count(at_seen_requests)),".json"))),request);ut_ok(ut_args("shell","am","start","-n","org.flexscript.collie/.MainActivity",0),"");}}h_sleep(50);}h_die(h_cat("Android case deadline; preserve the existing request: ",name));return 0;}
fn at_case(session,payload){return at_result(at_start(session,payload));}
fn at_observation(r){let o=cj_get(r,"observation");if !o{let expected=cj_text(r,"driver_call_id");let messages=cj_get(r,"messages");let i=0;let matches=0;while i<j_count(messages){let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output")&&(!h_len(expected)||h_equal(cj_text(m,"call_id"),expected)){o=c_json(cj_text(m,"output"));matches=matches+1;}i=i+1;}if h_len(expected){h_assert(matches==1,"Expected exactly one VM result correlated to this program");}}h_assert(o&&h_equal(cj_text(o,"state"),"continue")&&cj_int(o,"exit_code")==0,j_dump(r));return o;}
fn at_vm(session,source,policy){let p=j_object();j_set(p,"source",j_string(source));if policy{j_set(p,"initial_permissions",policy);}return at_observation(at_case(session,p));}
fn at_conversation_reply(session,source,policy,p,answer){j_set(p,"prompt",j_string("Exercise the controlled Android fixture"));let events=ut_responses(source);if answer{let message=j_at(cj_get(cj_get(j_at(events,1),"response"),"output"),0);j_set(j_at(cj_get(message,"content"),0),"text",j_string(answer));}let call=j_at(cj_get(cj_get(j_at(events,0),"response"),"output"),0);let token=h_cat3(ut_prefix,"-",h_int(ut_sequence+1));j_set(call,"id",j_string(h_cat("ctc_",token)));j_set(call,"call_id",j_string(h_cat("call_",token)));j_set(p,"responses",events);if policy{j_set(p,"initial_permissions",policy);}let name=at_start(session,p);j_set(at_expected_calls,name,j_string(h_cat("call_",token)));return name;}
fn at_conversation_payload(session,source,policy,p){return at_conversation_reply(session,source,policy,p,0);}
fn at_conversation(session,source,policy){return at_conversation_payload(session,source,policy,j_object());}
fn at_pending(session,key,phase,name){let end=net_now()+45000;while net_now()<end{let s=ut_read(h_cat3("files/workspaces/",session,"/session.json"));if s&&h_equal(cj_text(s,"phase"),phase){let signal=cj_get(cj_get(s,"pending_execution"),"signal");if !key||h_equal(cj_text(signal,"key"),key){j_save(h_join(ut_out,h_cat3("pending-",name,".json")),s);return s;}}let done=ut_read(h_cat3("files/test/",name,".result.json"));if done{h_die(h_cat("Fixture completed before the expected consent: ",j_dump(done)));}h_sleep(50);}h_die(h_cat3("Missing actual ",phase,h_cat(" gate: ",key)));return 0;}
fn at_xml(){if at_probe_xml{let reply=h_out(ut_ok(ut_args("shell","am","instrument","-w","-r","org.flexscript.collie.uiprobe/.UiProbe"),""));h_assert(h_has(reply,"INSTRUMENTATION_CODE: 0"),reply);let xml=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie.uiprobe","cat","files/hierarchy.xml",0),""));at_sequence=at_sequence+1;h_save(h_join(ut_out,h_cat3("probe-ui-",ut_prefix,h_cat3("-",h_int(at_sequence),".xml"))),xml);return xml;}let path=h_cat3("/data/local/tmp/",ut_prefix,".xml");ut_ok(ut_args("shell","uiautomator","dump",path,0,0),"");let xml=h_out(ut_ok(ut_args("exec-out","cat",path,0,0,0),""));at_sequence=at_sequence+1;h_save(h_join(ut_out,h_cat3("ui-",ut_prefix,h_cat3("-",h_int(syscall(39,0,0,0,0,0,0)),h_cat3("-",h_int(at_sequence),".xml")))),xml);return xml;}
fn at_node(xml,key,value,suffix){let offset=0;let found=0;while load8(xml+offset){let at=h_find(xml+offset,"<node ");if at<0{return found;}offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed actual Android UI hierarchy");let node=h_slice(xml+offset,end+1);let actual=ut_attr(node,key);let match=actual&&h_equal(actual,value);if suffix&&actual{let n=h_len(actual);let m=h_len(value);match=n>=m&&h_equal(actual+n-m,value);}if match&&h_equal(ut_attr(node,"enabled"),"true"){h_assert(!found||h_equal(found,node),"Ambiguous enabled Android UI action");found=node;}offset=offset+end+1;}return found;}
fn at_click(key,value,suffix){let end=net_now()+20000;while net_now()<end{let xml=at_xml();let node=at_node(xml,key,value,suffix);if !node&&h_equal(key,"text"){node=at_node(xml,"content-desc",value,0);}if !node&&suffix&&h_equal(value,"permission_deny_button"){node=at_node(xml,key,"permission_deny_and_dont_ask_again_button",1);}if !node&&h_equal(value,"Allow requested access"){node=at_node(xml,"text","Allow",0);}if !node&&h_equal(value,"Deny requested access"){node=at_node(xml,"text","Deny",0);}if node{return ut_tap(node);}h_sleep(50);}h_die(h_cat("Missing enabled Android action: ",value));return 0;}
fn at_sdk(session,flags){j_set(flags,"hardware_tests",j_bool(1));let r=cj_get(at_case(session,flags),"hardware");h_assert(r&&cj_int(r,"ok"),j_dump(r));let checks=cj_get(r,"checks");h_assert(checks&&j_count(checks)>0,"SDK fixture returned no assertions");let i=0;while i<j_count(checks){at_pass(j_value(j_at(checks,i)));i=i+1;}return r;}
fn at_init(argc,argv,suite,options){
    h_environment(argc,argv);h_timeout=45000;ut_adb="/opt/android-sdk/platform-tools/adb";at_suite=suite;at_options=options;at_checks=j_array();at_seen_requests=j_object();at_expected_calls=j_object();let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--worker"){at_child=1;}else if h_equal(key,"--cleanup"){h_assert(at_cleanup_hook,"This Android suite has no custom cleanup mode");at_cleanup=1;at_child=1;}else if h_equal(key,"--self-test"){return -1;}else{h_assert(h_starts(key,"--"),"Expected a named Android test option");let custom=cj_get(options,key+2);if custom&&j_kind(custom)==5{j_set(options,key+2,j_bool(1));}else{i=i+1;h_assert(i<argc,"Android test option needs a value");let value=load64(argv+i*8);if h_equal(key,"--out"){ut_out=h_real(value);}else if h_equal(key,"--serial"){ut_serial=value;}else if h_equal(key,"--adb"){ut_adb=h_real(value);}else if h_equal(key,"--prefix"){ut_prefix=value;}else{h_assert(custom,h_cat("Unknown Android test option: ",key));j_set(options,key+2,j_string(value));}}}i=i+1;}
    h_assert(ut_out&&ut_serial,"Provide --out and --serial emulator-N");ut_validate_serial();if !ut_prefix{ut_prefix=h_cat3(h_cat3("ctest-",suite,"-"),h_int(syscall(39,0,0,0,0,0,0)),h_cat("-",h_int(net_now())));}h_assert(ut_name(ut_prefix)&&h_starts(ut_prefix,h_cat3("ctest-",suite,"-")),"Invalid private fixture prefix");if at_child{let record=at_recovery();h_assert(cj_int(record,"parent_pid")==syscall(110,0,0,0,0,0,0),"Private worker requires its live restoring parent");at_extra=cj_get(record,"extra");}return 0;
}
fn at_self_test(){ut_prefix="ctest-probe-123";h_assert(at_owned("ctest-probe-123-child")&&!at_owned("ctest-probe-123evil")&&!at_owned("../ctest-probe-123-x")&&!ut_name("a/../b"),"Owned path boundary failed");let flags=at_flags(" android.permission.CAMERA: granted=true, flags=[ USER_SET|USER_SENSITIVE_WHEN_GRANTED]\n android.permission.RECORD_AUDIO: granted=false, flags=[USER_FIXED]\n");h_assert(cj_int(cj_get(flags,"android.permission.CAMERA"),"granted")&&!cj_int(cj_get(flags,"android.permission.RECORD_AUDIO"),"granted")&&h_equal(cj_text(cj_get(flags,"android.permission.RECORD_AUDIO"),"flags"),"USER_FIXED"),"Actual grant/flag parser failed");let xml="<node text=\"Allow\" enabled=\"false\"/><node text=\"Allow\" enabled=\"true\" bounds=\"[0,0][10,20]\"/>";h_assert(at_node(xml,"text","Allow",0)&&!at_node(xml,"text","Deny",0),"Consent parser accepted a disabled/wrong action");let row="<node><node text=\"Other\" package=\"com.android.settings\" enabled=\"true\" bounds=\"[0,0][100,50]\"/><node content-desc=\"Settings\" package=\"com.android.settings\" enabled=\"true\" bounds=\"[100,0][150,50]\"/></node>";let own="<node><node text=\"Collie\" package=\"com.android.settings\" enabled=\"true\" bounds=\"[0,100][100,150]\"/><node content-desc=\"Settings\" package=\"com.android.settings\" enabled=\"true\" bounds=\"[100,100][150,150]\"/></node>";h_assert(at_row_gear(h_cat3("<node>",row,h_cat(own,"</node>")),"Collie"),"Owned Settings row gear was not selected");let missing="<node><node text=\"Collie\" package=\"com.android.settings\" enabled=\"true\" bounds=\"[0,100][100,150]\"/></node>";h_assert(!at_row_gear(h_cat3("<node>",row,h_cat(missing,"</node>")),"Collie"),"An unrelated row gear was selected for Collie");let repeated="<node text=\"Allow\" enabled=\"true\" bounds=\"[0,0][10,20]\"/>";h_assert(at_node(h_cat(repeated,repeated),"text","Allow",0),"Identical SDK nodes were treated as distinct physical actions");let r=j_object();let messages=j_array();let first=j_object();j_set(first,"type",j_string("custom_tool_call_output"));j_set(first,"call_id",j_string("earlier"));j_set(first,"output",j_string("{\"state\":\"continue\",\"exit_code\":0,\"stdout\":\"earlier\"}"));j_push(messages,first);let second=at_copy(first);j_set(second,"call_id",j_string("current"));j_set(second,"output",j_string("{\"state\":\"continue\",\"exit_code\":0,\"stdout\":\"42\"}"));j_push(messages,second);j_set(r,"messages",messages);j_set(r,"driver_call_id",j_string("current"));h_assert(h_equal(cj_text(at_observation(r),"stdout"),"42"),"VM observation did not correlate to the current program");h_print(1,"PASS owned workspace boundaries, full Android grant flags, enabled actions, scoped Settings rows, duplicate SDK nodes and current-call result correlation\n");return 0;}
fn at_finish(report){j_set(report,"prefix",j_string(ut_prefix));if !at_sha{at_sha=h_sha(h_join(ut_out,"collie.apk"));}j_set(report,"checks",at_checks);j_set(report,"count",j_int(j_count(at_checks)));j_set(report,"serial",j_string(ut_serial));j_set(report,"apk_sha256",j_string(at_sha));j_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-report.json"))),report);return 0;}
fn at_subtree(xml,start){let at=start;let depth=0;let length=h_len(xml);while at<length{if h_starts(xml+at,"<node ")||h_starts(xml+at,"<node>"){let end=h_find(xml+at,">");h_assert(end>=0,"Malformed Android XML node");if load8(xml+at+end-1)!=47{depth=depth+1;}else if depth==0{return h_slice(xml+start,at+end+1-start);}at=at+end+1;}else if h_starts(xml+at,"</node>"){depth=depth-1;at=at+7;if depth==0{return h_slice(xml+start,at-start);}}else{at=at+1;}}h_die("Unclosed Android XML subtree");return 0;}
fn at_vertical(node){let bounds=ut_attr(node,"bounds");h_assert(bounds,"Missing Settings row bounds");let comma=h_find(bounds,",");let close=h_find(bounds,"]");h_assert(comma>0&&close>comma,"Invalid Settings row bounds");let next=bounds+close+1;let comma2=h_find(next,",");let close2=h_find(next,"]");h_assert(comma2>0&&close2>comma2,"Invalid Settings row bounds");let result=h_take(16);store64(result,h_number(h_slice(bounds+comma+1,close-comma-1)));store64(result+8,h_number(h_slice(next+comma2+1,close2-comma2-1)));return result;}
fn at_same_row(label,gear){if !h_equal(ut_attr(label,"package"),"com.android.settings")||!h_equal(ut_attr(gear,"package"),"com.android.settings"){return 0;}let a=at_vertical(label);let b=at_vertical(gear);return load64(a)<load64(b+8)&&load64(b)<load64(a+8);}
fn at_row_gear(xml,label){let stack=h_take(128*8);let depth=0;let at=0;let length=h_len(xml);while at<length{if h_starts(xml+at,"<node ")||h_starts(xml+at,"<node>"){let end=h_find(xml+at,">");h_assert(end>=0,"Malformed Android settings hierarchy");let node=h_slice(xml+at,end+1);let closed=load8(xml+at+end-1)==47;if !closed{h_assert(depth<128,"Android settings hierarchy exceeds depth bound");store64(stack+depth*8,at);depth=depth+1;}if h_equal(ut_attr(node,"text"),label){let i=depth;while i>0{i=i-1;let row=at_subtree(xml,load64(stack+i*8));let gear=at_node(row,"resource-id","settings_button",1);if !gear{gear=at_node(row,"content-desc","Settings",0);}if gear{if at_same_row(node,gear){return gear;}return 0;}}return 0;}at=at+end+1;}else if h_starts(xml+at,"</node>"){h_assert(depth>0,"Unbalanced Android settings hierarchy");depth=depth-1;at=at+7;}else{at=at+1;}}return 0;}
fn at_checkpoint_extra(){let record=at_recovery();j_set(record,"extra",at_extra);let path=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-recovery.json")));let temp=h_cat(path,".tmp");j_save(temp,record);h_assert(syscall(82,temp,path,0,0,0,0)==0,"Cannot save owned cleanup state atomically");return 0;}
fn at_dismiss_permission(){let i=0;while i<6{let state=h_out(ut_ok(ut_args("shell","dumpsys","activity","activities",0,0),""));let top=ut_line(state,"topResumedActivity=");if !top||!h_has(top,"permissioncontroller")||!h_has(top,"GrantPermissionsActivity"){return 1;}let xml=at_xml();if !h_has(xml,"text=\"Allow Collie"){return 0;}ut_ok(ut_args("shell","input","keyevent","4",0,0),"");h_sleep(100);i=i+1;}return 0;}
fn at_recovery(){let r=c_json(h_read(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-recovery.json")))));h_assert(r&&h_equal(cj_text(r,"prefix"),ut_prefix),"Recovery record belongs to another test run");return r;}
fn at_parent(argc,argv){
    let lock=ut_lock();at_sha=at_verify_apk();h_assert(h_equal(h_trim(h_out(ut_ok(ut_args("shell","getprop","ro.kernel.qemu",0,0,0),""))),"1"),"The selected target is not an Android emulator");ut_ok(ut_args("shell","input","keyevent","224",0,0),"");ut_ok(ut_args("shell","input","keyevent","82",0,0),"");ut_warm();ut_ok(ut_args("shell","run-as","org.flexscript.collie","mkdir","-p","files/test"),"");let prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));let at=h_find(prefs,"name=\"session\">");h_assert(at>=0,"Missing original conversation");let start=prefs+at+h_len("name=\"session\">");let end=h_find(start,"<");h_assert(end>0,"Invalid original conversation");let original=h_slice(start,end);h_assert(ut_name(original),"Unsafe original conversation ID");let original_path=h_cat3("files/workspaces/",original,"/session.json");let session=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",original_path,0),""));let state=c_json(session);h_assert(state&&(!cj_get(state,"pending_execution")||j_kind(cj_get(state,"pending_execution"))==0),"The original conversation has pending work; no fixture submitted");let workspaces=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),""));let permissions=at_flags(at_package());let recovery=j_object();j_set(recovery,"parent_pid",j_int(syscall(39,0,0,0,0,0,0)));if !at_extra{at_extra=j_object();}j_set(recovery,"extra",at_extra);j_set(recovery,"original",j_string(original));j_set(recovery,"prefs",j_string(prefs));j_set(recovery,"session",j_string(session));j_set(recovery,"workspaces",j_string(workspaces));j_set(recovery,"flags",permissions);j_set(recovery,"prefix",j_string(ut_prefix));j_set(recovery,"sha256",j_string(at_sha));let recovery_path=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-recovery.json")));j_save(recovery_path,recovery);
    let args=h_vec();let i=0;while i<argc{h_add(args,load64(argv+i*8));i=i+1;}h_add(args,"--worker");h_add(args,"--prefix");h_add(args,ut_prefix);let child=h_spawn(args,"",0);let deadline=net_now()+at_parent_timeout;let timed=0;while h_status(child)==-999||load64(child+40)>=0||load64(child+48)>=0{h_pump(child,10);if net_now()>=deadline{h_stop(child);timed=1;}}h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-worker.stdout"))),h_out(child));h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-worker.stderr"))),h_err(child));
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let custom_ok=1;if at_cleanup_hook{let restore_args=h_vec();i=0;while i<argc{h_add(restore_args,load64(argv+i*8));i=i+1;}h_add(restore_args,"--cleanup");h_add(restore_args,"--prefix");h_add(restore_args,ut_prefix);let cleanup=h_spawn(restore_args,"",0);let until=net_now()+180000;while h_status(cleanup)==-999||load64(cleanup+40)>=0||load64(cleanup+48)>=0{h_pump(cleanup,10);if net_now()>=until{h_stop(cleanup);custom_ok=0;}}h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-custom-cleanup.stdout"))),h_out(cleanup));h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-custom-cleanup.stderr"))),h_err(cleanup));custom_ok=custom_ok&&h_status(cleanup)==0;ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");}let dialog_ok=at_dismiss_permission();let flags_ok=at_restore_flags(permissions);let names=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),"")));i=0;while i<h_count(names){let name=h_at(names,i);if custom_ok&&(h_equal(name,ut_prefix)||at_owned(name)){h_assert(!h_equal(name,original),"Refusing original workspace cleanup");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-rf",h_cat("files/workspaces/",name)),"");}i=i+1;}names=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/test"),"")));i=0;while i<h_count(names){let name=h_at(names,i);if custom_ok&&h_starts(name,h_cat(ut_prefix,"-")){h_assert(h_find(name,"/")<0,"Unsafe fixture filename");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",h_cat("files/test/",name)),"");}i=i+1;}at_write(original_path,session);at_write("shared_prefs/MainActivity.xml",prefs);ut_ok(ut_args("shell","rm","-f",h_cat3("/data/local/tmp/",ut_prefix,".xml"),0,0),"");ut_ok(ut_args("shell","am","start","-W","-n","org.flexscript.collie/.MainActivity"),"");let restored=ut_read(original_path);let restored_prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));h_assert(h_equal(j_dump(restored),j_dump(state))&&h_equal(restored_prefs,prefs),"Original conversation/preferences changed after restoration");if custom_ok{h_assert(h_equal(workspaces,h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),""))),"Original workspace set changed");}h_assert(flags_ok&&h_equal(j_dump(permissions),j_dump(at_flags(at_package()))),"Android grant flags changed");h_assert(custom_ok,"Custom Android cleanup failed; original conversation restored, preserve owned recovery records");h_assert(dialog_ok,"An owned permission dialog did not close; original conversation restored");h_assert(h_equal(at_verify_apk(),at_sha),"Installed test artifact changed");ut_ok(ut_args("shell","sync",0,0,0,0),"");h_print(1,h_out(child));h_print(2,h_err(child));let audit=j_object();j_set(audit,"restored",j_bool(1));j_set(audit,"prefix",j_string(ut_prefix));j_set(audit,"child_exit",j_int(h_status(child)));j_set(audit,"timed_out",j_bool(timed));j_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-cleanup.json"))),audit);let report_path=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-report.json")));let report=0;if h_exists(report_path){report=c_json(h_read(report_path));}if !report||!h_equal(cj_text(report,"prefix"),ut_prefix){report=j_object();j_set(report,"ok",j_bool(0));j_set(report,"prefix",j_string(ut_prefix));j_set(report,"checks",j_array());j_set(report,"error",j_string(h_err(child)));}j_set(report,"suite_passed",j_bool(!timed&&h_status(child)==0));j_set(report,"child_exit",j_int(h_status(child)));let check_list=cj_get(report,"checks");j_push(check_list,j_string("complete original conversation/preferences/workspaces and every Android grant flag restored"));j_set(report,"count",j_int(j_count(check_list)));j_set(report,"original_state_restored",j_bool(1));j_set(report,"all_android_flags_restored",j_bool(1));j_set(report,"workspace_set_restored",j_bool(1));j_set(report,"apk_sha256",j_string(at_sha));j_save(report_path,report);h_print(1,"PASS complete original conversation/preferences/workspaces and every Android grant flag restored\n");h_close(lock);h_assert(!timed&&h_status(child)==0,h_cat("Android suite failed; parent restored original state; worker exit=",h_int(h_status(child))));return 0;
}

fn at_basic_grants(){return c_json("{\"internet\":true,\"files_read\":true,\"files_write\":true,\"db_read\":true,\"db_write\":true,\"history\":true,\"workers\":true}");}
fn at_message(text){let message=j_object();j_set(message,"type",j_string("message"));j_set(message,"role",j_string("assistant"));let content=j_array();let part=j_object();j_set(part,"type",j_string("output_text"));j_set(part,"text",j_string(text));j_push(content,part);j_set(message,"content",content);return message;}
fn at_completed(output,delay){let response=j_object();j_set(response,"status",j_string("completed"));j_set(response,"output",output);let event=j_object();j_set(event,"type",j_string("response.completed"));j_set(event,"response",response);if delay{j_set(event,"_delay_ms",j_int(delay));}return event;}
fn at_answer_event(text,delay){let output=j_array();j_push(output,at_message(text));return at_completed(output,delay);}
fn at_tool_event(source,key,delay){let call=j_object();j_set(call,"type",j_string("custom_tool_call"));j_set(call,"id",j_string(h_cat("ctc_",key)));j_set(call,"call_id",j_string(h_cat("call_",key)));j_set(call,"name",j_string("flexscript"));j_set(call,"input",j_string(source));let output=j_array();j_push(output,call);return at_completed(output,delay);}
fn at_outputs(result){let outputs=j_array();let messages=cj_get(result,"messages");let i=0;while i<j_count(messages){let item=j_at(messages,i);if h_equal(cj_text(item,"type"),"custom_tool_call_output"){j_push(outputs,c_json(cj_text(item,"output")));}i=i+1;}return outputs;}
fn at_task(session,prompt,events,workers){let payload=j_object();j_set(payload,"prompt",j_string(prompt));j_set(payload,"responses",events);j_set(payload,"initial_permissions",at_basic_grants());if workers{j_set(payload,"worker_responses",workers);}return at_start(session,payload);}
