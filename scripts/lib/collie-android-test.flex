// Shared native Android test host. A parent restores app state after child
// failure as well as success. Only explicitly selected owned emulators run.
import "android-usb-test.flex";
global at_child=0;global at_options=0;global at_suite=0;global at_checks=0;global at_sha=0;global at_sequence=0;
fn at_bool(value){h_assert(value&&j_kind(value)==5,"Expected an actual JSON boolean");return j_value(value);}
fn at_copy(value){return c_json(j_dump(value));}
fn at_pass(text){j_push(at_checks,j_string(text));h_print(1,h_cat3("PASS ",text,"\n"));return 0;}
fn at_lines(text){let rows=h_vec();let start=0;let i=0;while load8(text+i){if load8(text+i)==10{h_add(rows,h_slice(text+start,i-start));start=i+1;}i=i+1;}if i>start{h_add(rows,h_slice(text+start,i-start));}return rows;}
fn at_owned(name){return ut_name(name)&&h_starts(name,h_cat(ut_prefix,"-"));}
fn at_write(path,text){h_assert(h_starts(path,"files/")||h_equal(path,"shared_prefs/MainActivity.xml"),"Unsafe app fixture destination");let i=0;while load8(path+i){let c=load8(path+i);h_assert((c>=48&&c<=57)||(c>=65&&c<=90)||(c>=97&&c<=122)||c==47||c==46||c==45||c==95,"Unsafe app fixture path");i=i+1;}h_assert(!h_has(path,".."),"Parent traversal in app fixture path");return ut_ok(ut_args("shell","run-as","org.flexscript.collie","sh","-c",h_cat3("'umask 077; cat > ",path,"'")),text);}
fn at_verify_apk(){let apk=h_join(ut_out,"collie.apk");let expected=h_sha(apk);let path=h_trim(h_out(ut_ok(ut_args("shell","pm","path","org.flexscript.collie",0,0),"")));h_assert(h_starts(path,"package:/data/app/")&&!h_has(path,"\n"),"Expected one installed Collie APK");let process=ut_call(ut_args("exec-out","cat",path+8,0,0,0),"");h_check(process,0,0);let actual=h_sha_bytes(h_out(process),h_size(load64(process+16)));h_assert(h_equal(actual,expected),"Installed Collie APK differs from the named test artifact; install it before testing");return expected;}
fn at_flags(text){let rows=at_lines(text);let result=j_object();let i=0;while i<h_count(rows){let line=h_trim(h_at(rows,i));let at=h_find(line,": granted=");if at>0{let key=h_slice(line,at);let flags=h_find(line,"flags=[");if flags>=0{let end=h_find(line+flags+7,"]");h_assert(end>=0,"Malformed actual Android grant flags");let record=j_object();j_set(record,"granted",j_bool(h_starts(line+at+10,"true")));j_set(record,"flags",j_string(h_slice(line+flags+7,end)));j_set(result,key,record);}}i=i+1;}h_assert(j_count(result)>0,"No Android permission records found");return result;}
fn at_package(){return h_out(ut_ok(ut_args("shell","dumpsys","package","org.flexscript.collie",0,0),""));}
fn at_restore_flags(before){let after=at_flags(at_package());let pairs=j_value(before);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let permission=load64(pair);let expected=load64(pair+8);let current=cj_get(after,permission);h_assert(current,"Android permission record disappeared");if cj_int(expected,"granted")!=cj_int(current,"granted"){let action="revoke";if cj_int(expected,"granted"){action="grant";}ut_ok(ut_args("shell","pm",action,"org.flexscript.collie",permission,0),"");}let flags=h_args("USER_SET","USER_FIXED","ONE_TIME","AUTO_REVOKED","REVIEW_REQUIRED","REVOKE_WHEN_REQUESTED");let n=0;while n<h_count(flags){let flag=h_at(flags,n);let was=h_has(cj_text(expected,"flags"),flag);let now=h_has(cj_text(current,"flags"),flag);if was!=now{let name=h_take(h_len(flag)+1);let k=0;while load8(flag+k){let c=load8(flag+k);if c>=65&&c<=90{c=c+32;}if c==95{c=45;}store8(name+k,c);k=k+1;}let action="clear-permission-flags";if was{action="set-permission-flags";}let args=ut_args("shell","pm",action,"org.flexscript.collie",permission,name);ut_ok(args,"");}n=n+1;}i=i+1;}return h_equal(j_dump(before),j_dump(at_flags(at_package())));}
fn at_start(session,payload){h_assert(ut_name(session),"Unsafe fixture conversation");let name=ut_start(session,payload);j_save(h_join(ut_out,h_cat3("request-",name,".json")),payload);return name;}
fn at_result(name){let end=net_now()+180000;while net_now()<end{let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{j_save(h_join(ut_out,h_cat3("case-",name,".json")),r);h_assert(cj_int(r,"ok"),j_dump(r));return r;}h_sleep(50);}h_die(h_cat("Android case deadline; preserve the existing request: ",name));return 0;}
fn at_case(session,payload){return at_result(at_start(session,payload));}
fn at_observation(r){let o=cj_get(r,"observation");if !o{let messages=cj_get(r,"messages");let i=0;while i<j_count(messages)&&!o{let m=j_at(messages,i);if h_equal(cj_text(m,"type"),"custom_tool_call_output"){o=c_json(cj_text(m,"output"));}i=i+1;}}h_assert(o&&h_equal(cj_text(o,"state"),"continue")&&cj_int(o,"exit_code")==0,j_dump(r));return o;}
fn at_vm(session,source,policy){let p=j_object();j_set(p,"source",j_string(source));if policy{j_set(p,"initial_permissions",policy);}return at_observation(at_case(session,p));}
fn at_conversation(session,source,policy){let p=j_object();j_set(p,"prompt",j_string("Exercise the controlled Android fixture"));j_set(p,"responses",ut_responses(source));if policy{j_set(p,"initial_permissions",policy);}return at_start(session,p);}
fn at_pending(session,key,phase,name){let end=net_now()+45000;while net_now()<end{let s=ut_read(h_cat3("files/workspaces/",session,"/session.json"));if s&&h_equal(cj_text(s,"phase"),phase){let signal=cj_get(cj_get(s,"pending_execution"),"signal");if !key||h_equal(cj_text(signal,"key"),key){return s;}}let done=ut_read(h_cat3("files/test/",name,".result.json"));if done{h_die(h_cat("Fixture completed before the expected consent: ",j_dump(done)));}h_sleep(50);}h_die(h_cat3("Missing actual ",phase,h_cat(" gate: ",key)));return 0;}
fn at_xml(){let path=h_cat3("/data/local/tmp/",ut_prefix,".xml");ut_ok(ut_args("shell","uiautomator","dump",path,0,0),"");let xml=h_out(ut_ok(ut_args("exec-out","cat",path,0,0,0),""));at_sequence=at_sequence+1;h_save(h_join(ut_out,h_cat3("ui-",ut_prefix,h_cat3("-",h_int(at_sequence),".xml"))),xml);return xml;}
fn at_node(xml,key,value,suffix){let offset=0;let found=0;while load8(xml+offset){let at=h_find(xml+offset,"<node ");if at<0{return found;}offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed actual Android UI hierarchy");let node=h_slice(xml+offset,end+1);let actual=ut_attr(node,key);let match=actual&&h_equal(actual,value);if suffix&&actual{let n=h_len(actual);let m=h_len(value);match=n>=m&&h_equal(actual+n-m,value);}if match&&h_equal(ut_attr(node,"enabled"),"true"){h_assert(!found,"Ambiguous enabled Android UI action");found=node;}offset=offset+end+1;}return found;}
fn at_click(key,value,suffix){let end=net_now()+20000;while net_now()<end{let xml=at_xml();let node=at_node(xml,key,value,suffix);if !node&&h_equal(key,"text"){node=at_node(xml,"content-desc",value,0);}if !node&&h_equal(value,"Allow requested access"){node=at_node(xml,"text","Allow",0);}if !node&&h_equal(value,"Deny requested access"){node=at_node(xml,"text","Deny",0);}if node{return ut_tap(node);}h_sleep(50);}h_die(h_cat("Missing enabled Android action: ",value));return 0;}
fn at_sdk(session,flags){j_set(flags,"hardware_tests",j_bool(1));let r=cj_get(at_case(session,flags),"hardware");h_assert(r&&cj_int(r,"ok"),j_dump(r));let checks=cj_get(r,"checks");h_assert(checks&&j_count(checks)>0,"SDK fixture returned no assertions");let i=0;while i<j_count(checks){at_pass(j_value(j_at(checks,i)));i=i+1;}return r;}
fn at_init(argc,argv,suite,options){
    h_environment(argc,argv);h_timeout=45000;ut_adb="/opt/android-sdk/platform-tools/adb";at_suite=suite;at_options=options;at_checks=j_array();let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--worker"){at_child=1;}else if h_equal(key,"--self-test"){return -1;}else{h_assert(h_starts(key,"--"),"Expected a named Android test option");let custom=cj_get(options,key+2);if custom&&j_kind(custom)==5{j_set(options,key+2,j_bool(1));}else{i=i+1;h_assert(i<argc,"Android test option needs a value");let value=load64(argv+i*8);if h_equal(key,"--out"){ut_out=h_real(value);}else if h_equal(key,"--serial"){ut_serial=value;}else if h_equal(key,"--adb"){ut_adb=h_real(value);}else if h_equal(key,"--prefix"){ut_prefix=value;}else{h_assert(custom,h_cat("Unknown Android test option: ",key));j_set(options,key+2,j_string(value));}}}i=i+1;}
    h_assert(ut_out&&ut_serial,"Provide --out and --serial emulator-N");ut_validate_serial();if !ut_prefix{ut_prefix=h_cat3(h_cat3("ctest-",suite,"-"),h_int(syscall(39,0,0,0,0,0,0)),h_cat("-",h_int(net_now())));}h_assert(ut_name(ut_prefix)&&h_starts(ut_prefix,h_cat3("ctest-",suite,"-")),"Invalid private fixture prefix");return 0;
}
fn at_self_test(){ut_prefix="ctest-probe-123";h_assert(at_owned("ctest-probe-123-child")&&!at_owned("ctest-probe-123evil")&&!at_owned("../ctest-probe-123-x")&&!ut_name("a/../b"),"Owned path boundary failed");let flags=at_flags(" android.permission.CAMERA: granted=true, flags=[ USER_SET|USER_SENSITIVE_WHEN_GRANTED]\n android.permission.RECORD_AUDIO: granted=false, flags=[USER_FIXED]\n");h_assert(cj_int(cj_get(flags,"android.permission.CAMERA"),"granted")&&!cj_int(cj_get(flags,"android.permission.RECORD_AUDIO"),"granted")&&h_equal(cj_text(cj_get(flags,"android.permission.RECORD_AUDIO"),"flags"),"USER_FIXED"),"Actual grant/flag parser failed");let xml="<node text=\"Allow\" enabled=\"false\"/><node text=\"Allow\" enabled=\"true\" bounds=\"[0,0][10,20]\"/>";h_assert(at_node(xml,"text","Allow",0)&&!at_node(xml,"text","Deny",0),"Consent parser accepted a disabled/wrong action");h_print(1,"PASS owned workspace boundaries, Android grant flags and enabled consent parsing\n");return 0;}
fn at_finish(report){if !at_sha{at_sha=h_sha(h_join(ut_out,"collie.apk"));}j_set(report,"checks",at_checks);j_set(report,"count",j_int(j_count(at_checks)));j_set(report,"serial",j_string(ut_serial));j_set(report,"apk_sha256",j_string(at_sha));j_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-report.json"))),report);return 0;}
fn at_recovery(){let r=c_json(h_read(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-recovery.json")))));h_assert(r&&h_equal(cj_text(r,"prefix"),ut_prefix),"Recovery record belongs to another test run");return r;}
fn at_parent(argc,argv){
    let lock=ut_lock();at_sha=at_verify_apk();h_assert(h_equal(h_trim(h_out(ut_ok(ut_args("shell","getprop","ro.kernel.qemu",0,0,0),""))),"1"),"The selected target is not an Android emulator");ut_warm();ut_ok(ut_args("shell","run-as","org.flexscript.collie","mkdir","-p","files/test"),"");let prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));let at=h_find(prefs,"name=\"session\">");h_assert(at>=0,"Missing original conversation");let start=prefs+at+h_len("name=\"session\">");let end=h_find(start,"<");h_assert(end>0,"Invalid original conversation");let original=h_slice(start,end);h_assert(ut_name(original),"Unsafe original conversation ID");let original_path=h_cat3("files/workspaces/",original,"/session.json");let session=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",original_path,0),""));let state=c_json(session);h_assert(state&&(!cj_get(state,"pending_execution")||j_kind(cj_get(state,"pending_execution"))==0),"The original conversation has pending work; no fixture submitted");let workspaces=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),""));let permissions=at_flags(at_package());let recovery=j_object();j_set(recovery,"original",j_string(original));j_set(recovery,"prefs",j_string(prefs));j_set(recovery,"session",j_string(session));j_set(recovery,"workspaces",j_string(workspaces));j_set(recovery,"flags",permissions);j_set(recovery,"prefix",j_string(ut_prefix));j_set(recovery,"sha256",j_string(at_sha));let recovery_path=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-recovery.json")));j_save(recovery_path,recovery);
    let args=h_vec();let i=0;while i<argc{h_add(args,load64(argv+i*8));i=i+1;}h_add(args,"--worker");h_add(args,"--prefix");h_add(args,ut_prefix);let child=h_spawn(args,"",0);let deadline=net_now()+900000;let timed=0;while h_status(child)==-999||load64(child+40)>=0||load64(child+48)>=0{h_pump(child,10);if net_now()>=deadline{h_stop(child);timed=1;}}h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-worker.stdout"))),h_out(child));h_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-worker.stderr"))),h_err(child));
    ut_ok(ut_args("shell","am","force-stop","org.flexscript.collie",0,0),"");let flags_ok=at_restore_flags(permissions);let names=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),"")));i=0;while i<h_count(names){let name=h_at(names,i);if h_equal(name,ut_prefix)||at_owned(name){h_assert(!h_equal(name,original),"Refusing original workspace cleanup");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-rf",h_cat("files/workspaces/",name)),"");}i=i+1;}names=at_lines(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/test"),"")));i=0;while i<h_count(names){let name=h_at(names,i);if h_starts(name,h_cat(ut_prefix,"-")){h_assert(h_find(name,"/")<0,"Unsafe fixture filename");ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",h_cat("files/test/",name)),"");}i=i+1;}at_write(original_path,session);at_write("shared_prefs/MainActivity.xml",prefs);ut_ok(ut_args("shell","rm","-f",h_cat3("/data/local/tmp/",ut_prefix,".xml"),0,0),"");ut_ok(ut_args("shell","am","start","-W","-n","org.flexscript.collie/.MainActivity"),"");let restored=ut_read(original_path);let restored_prefs=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));h_assert(h_equal(j_dump(restored),j_dump(state))&&h_equal(restored_prefs,prefs),"Original conversation/preferences changed after restoration");h_assert(h_equal(workspaces,h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","ls","-1","files/workspaces"),""))),"Original workspace set changed");h_assert(flags_ok&&h_equal(j_dump(permissions),j_dump(at_flags(at_package()))),"Android grant flags changed");h_assert(h_equal(at_verify_apk(),at_sha),"Installed test artifact changed");ut_ok(ut_args("shell","sync",0,0,0,0),"");h_print(1,h_out(child));h_print(2,h_err(child));let audit=j_object();j_set(audit,"restored",j_bool(1));j_set(audit,"prefix",j_string(ut_prefix));j_set(audit,"child_exit",j_int(h_status(child)));j_set(audit,"timed_out",j_bool(timed));j_save(h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-cleanup.json"))),audit);h_assert(!timed&&h_status(child)==0,h_cat("Android suite failed; parent restored original state; worker exit=",h_int(h_status(child))));let report_path=h_join(ut_out,h_cat3(at_suite,"-",h_cat(ut_serial,"-report.json")));let report=c_json(h_read(report_path));let check_list=cj_get(report,"checks");j_push(check_list,j_string("complete original conversation/preferences/workspaces and every Android grant flag restored"));j_set(report,"count",j_int(j_count(check_list)));j_set(report,"original_state_restored",j_bool(1));j_set(report,"all_android_flags_restored",j_bool(1));j_set(report,"workspace_set_restored",j_bool(1));j_set(report,"apk_sha256",j_string(at_sha));j_save(report_path,report);h_print(1,"PASS complete original conversation/preferences/workspaces and every Android grant flag restored\n");h_close(lock);return 0;
}
