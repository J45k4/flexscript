    cud_clear("{\"platform\":\"android\",\"busy\":false,\"live\":{},\"stream\":\"\",\"authenticated\":true}");
    let body="## Android Markdown\n**Bold** *italic* ~~old~~ and `code`. [Document](notes/report%20one.txt#L2) [Picture](photo.png) [Web](https://example.com/).\n\n| No. | Name | Note |\n| ---: | :--- | :---: |\n";let i=1;while i<48{body=h_cat3(body,h_cat3("| ",h_int(i)," | Person "),h_cat3(h_int(i)," | **Term** ",h_cat(h_int(i)," |\n")));i=i+1;}body=h_cat(body,"\nAfter the table.\n```flexscript\nfn main(){return 42;}\n```\n");cud_cards("assistant",body);
    let key="card-0-body-block-1";h_assert(uw_has(h_cat(key,"-scroll"))&&uw_has(h_cat(key,"-row-20-cell-2"))&&!uw_has(h_cat(key,"-row-21-cell-0")),"Mobile table did not use bounded native rows");h_assert(h_equal(cj_text(uw_node(h_cat(key,"-scroll")),"kind"),"hscroll")&&h_equal(cj_text(cj_get(uw_node(h_cat(key,"-row-0-cell-0")),"props"),"align"),"end")&&h_equal(cj_text(cj_get(uw_node(h_cat(key,"-row-0-cell-2")),"props"),"align"),"center"),"Mobile table lost scrolling/alignment");let runs=cud_runs("card-0-body-block-0");h_assert(cud_run(runs,"Bold",0,1)&&cud_run(runs,"italic",0,16)&&cud_run(runs,"old",0,32)&&cud_run(runs,"code",0,2),"Mobile Markdown styles missing");h_assert(h_has(uw_text("card-0-body-block-2"),"After the table.")&&h_has(uw_text("card-0-body-block-2"),"fn main()"),"Text/code after table lost");let copied=cu_click(h_cat(key,"-copy"));h_assert(h_equal(cj_text(copied,"kind"),"copy")&&h_starts(cj_text(copied,"text"),"No.\tName\tNote\n")&&h_has(cj_text(copied,"text"),"47\tPerson 47\tTerm 47\n"),"Copy table lost off-page rows or retained Markdown");cu_click(h_cat(key,"-next"));h_assert(uw_has(h_cat(key,"-row-40-cell-0"))&&!uw_has(h_cat(key,"-row-20-cell-0")),"Second table page missing");cu_click(h_cat(key,"-next"));h_assert(uw_has(h_cat(key,"-row-47-cell-0"))&&h_equal(uw_text(h_cat(key,"-range")),"Rows 41–47 of 47"),"Final table rows unreachable");cu_click(h_cat(key,"-previous"));h_assert(uw_has(h_cat(key,"-row-21-cell-0"))&&cj_int(cj_get(cud_nav(),"table_offsets"),key)==20,"Table page navigation not retained");cu_pass("Android Markdown keeps inline styles, fenced code, aligned scrolling table cells, all rows through paging and complete TSV copy");
    cu_command(cu_event("card-0-body-block-0",j_string("notes/report%20one.txt#L2"),"link"),"{\"kind\":\"open_link\",\"href\":\"notes/report%20one.txt#L2\"}");let target=cap_target("notes/report%20one.txt#L2");h_assert(h_equal(cj_text(cj_get(target,"file"),"path"),"/notes/report one.txt")&&h_equal(cj_text(cj_get(target,"file"),"type"),"file"),"Encoded workspace link not normalized");h_assert(h_equal(cj_text(cj_get(cap_target("photo.png"),"file"),"type"),"image")&&h_equal(cj_text(cap_target("https://example.com/"),"kind"),"web"),"File/image/web link routing differs");let bad=c_json("[\"../secret\",\"%2e%2e/secret\",\"%2fetc/passwd\",\"file:///etc/passwd\",\"javascript:alert(1)\",\"bad%00.txt\",\"bad%zz\",\"x%\",\"x%2\"]");i=0;while i<j_count(bad){h_assert(cj_get(cap_target(j_value(j_at(bad,i))),"error"),"Unsafe/invalid workspace link accepted");i=i+1;}let invalid=c_json("{\"action\":\"event\",\"event\":{\"key\":\"card-0-body-block-0\",\"action\":\"\",\"action_id\":0,\"type\":\"link\",\"value\":\"not-rendered.txt\"}}");j_set(invalid,"state",cu_state);h_assert(cj_get(cu_call(invalid),"error"),"Unrendered Android link reached host");cu_pass("Android links use shared rendered-link validation, bounded file/image targets and workspace escape checks");
    cud_clear("{\"platform\":\"android\",\"busy\":true,\"live\":{},\"cards\":[{\"kind\":\"user\",\"text\":\"Question\"}]}");h_assert(h_equal(uw_text("card-thinking-0-preview"),"Waiting for the model…"),"Android waiting panel absent");cud_data("{\"live\":{\"active\":true,\"summaries\":[{\"text\":\"**Checking** the source.\"}]}}");h_assert(h_equal(uw_text("card-thinking-0-preview"),"**Checking** the source."),"Actual summary not used for collapsed preview");cu_click("card-thinking-0-toggle");h_assert(cud_run(cud_runs("card-thinking-0-live-summary-0"),"Checking",0,1),"Live public summary Markdown not rendered");cud_data("{\"busy\":false,\"cards\":[{\"kind\":\"user\",\"text\":\"Question\"},{\"kind\":\"thinking\",\"text\":\"**Checking** the source.\"},{\"kind\":\"assistant\",\"text\":\"Answer.\"}]}");h_assert(h_equal(uw_text("card-2-body"),"Answer.")&&h_has(uw_text("card-thinking-0-preview"),"Checking"),"Summary disappeared or became assistant answer");cu_pass("Android thinking shows waiting, streams actual styled public summaries and retains them separately from assistant replies");cud_clear("{\"platform\":\"\",\"busy\":false}");return 0;
}
