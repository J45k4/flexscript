// Native scenario/oracle helpers. Only the external Bumble library peers use Python.
import "android-radio-test.flex";
global bp_path=0;global bp_source=0;
fn bp_read(){let value=c_json(h_read(bp_path));h_assert(value&&j_kind(value)==4,"Independent peer state is not an object");return value;}
fn bp_address(peer){let text=cj_text(peer,"address");h_assert(h_len(text)>=17&&(load8(text+17)==0||load8(text+17)==47),"Invalid controlled peer address");let value=h_slice(text,17);let i=0;while i<17{let c=load8(value+i);if i%3==2{h_assert(c==58,"Invalid peer address separator");}else{h_assert((c>=48&&c<=57)||(c>=65&&c<=70),"Invalid controlled peer address digit");}i=i+1;}return value;}
fn bp_uuid(value){h_assert(h_len(value)==36,"Invalid controlled peer UUID length");let i=0;while i<36{let c=load8(value+i);if i==8||i==13||i==18||i==23{h_assert(c==45,"Invalid UUID separator");}else{h_assert((c>=48&&c<=57)||(c>=97&&c<=102),"Invalid UUID digit");}i=i+1;}return value;}
fn bp_wait(key,seconds){let end=net_now()+seconds*1000;while net_now()<end{let state=bp_read();h_assert(!h_len(cj_text(state,"error")),j_dump(state));if cj_int(state,key){return state;}h_sleep(100);}h_die(h_cat("Independent peer observation deadline: ",key));return 0;}
fn bp_blob(name,hex){h_assert(ut_name(name),"Invalid guest byte literal name");let bytes=h_unhex(hex);let length=h_len(hex)/2;h_assert(length>0&&length<=65536,"Invalid peer byte oracle length");let source=h_cat3("let ",name,h_cat3("=alloc(",h_int(length),");"));let i=0;while i<length{source=h_cat3(source,"store8(",h_cat3(name,"+",h_cat3(h_int(i),",",h_cat(h_int(load8(bytes+i)),");"))));i=i+1;}return source;}
fn bp_guest(name,preamble,args){let source=h_cat3(bp_source,"\nfn main(){",h_cat3(preamble,"return ",h_cat(name,"(")));let i=0;while i<h_count(args){if i{source=h_cat(source,",");}source=h_cat(source,h_at(args,i));i=i+1;}return h_cat(source,");}");}
fn bp_program(name,args){return bp_guest(name,"",args);}
fn bp_string(value){return j_dump(j_string(value));}
fn bp_vm(name,args){return at_vm(ut_prefix,bp_program(name,args),0);}
fn bp_grant(permission){ut_ok(ut_args("shell","pm","grant","org.flexscript.collie",permission,0),"");return 0;}
fn bp_nearby(){return h_args("android.permission.BLUETOOTH_CONNECT","android.permission.BLUETOOTH_SCAN","android.permission.BLUETOOTH_ADVERTISE",0,0,0);}
fn bp_permissions(location){let p=bp_nearby();if location{h_add(p,"android.permission.ACCESS_COARSE_LOCATION");h_add(p,"android.permission.ACCESS_FINE_LOCATION");}return p;}
fn bp_uuid_new(){let raw=h_take(16);h_assert(syscall(318,raw,16,0,0,0,0)==16,"Cannot create unique peer UUID");store8(raw+6,(load8(raw+6)&15)|64);store8(raw+8,(load8(raw+8)&63)|128);let hex=h_hex(raw,16);return h_cat3(h_slice(hex,8),"-",h_cat3(h_slice(hex+8,4),"-",h_cat3(h_slice(hex+12,4),"-",h_cat3(h_slice(hex+16,4),"-",hex+20))));}
fn bp_proc(pid){let path=h_cat3("/proc/",h_int(pid),"/stat");if !h_exists(path){return 0;}let raw=h_read(path);let at=h_find(raw,") ");h_assert(at>=0,"Malformed owned process status");let rest=raw+at+2;let state=load8(rest);let field=3;while field<22{let n=h_find(rest," ");h_assert(n>=0,"Incomplete owned process status");rest=rest+n+1;field=field+1;}let n=h_find(rest," ");h_assert(n>0,"Missing owned process start time");let value=j_object();j_set(value,"state",j_int(state));j_set(value,"start_ticks",j_string(h_slice(rest,n)));return value;}
fn bp_alive(pid,ticks){let current=bp_proc(pid);return current&&h_equal(cj_text(current,"start_ticks"),ticks)&&cj_int(current,"state")!=90&&cj_int(current,"state")!=88;}
fn bp_spawn(args){let child=h_spawn(args,"",0);let pid=load64(child);let state=bp_proc(pid);h_assert(state,"Owned peer exited before recording its process identity");j_set(at_extra,"peer_pid",j_int(pid));j_set(at_extra,"peer_start_ticks",cj_get(state,"start_ticks"));at_checkpoint_extra();return child;}
fn bp_stop(){let pid=cj_int(at_extra,"peer_pid");let ticks=cj_text(at_extra,"peer_start_ticks");if pid>0{h_assert(h_len(ticks),"Missing owned virtual-peer process identity");if bp_alive(pid,ticks){h_assert(syscall(62,pid,15,0,0,0,0)==0,"Cannot stop the exact owned virtual peer");let end=net_now()+5000;while net_now()<end&&bp_alive(pid,ticks){h_sleep(20);}if bp_alive(pid,ticks){h_assert(syscall(62,pid,9,0,0,0,0)==0,"Cannot end the exact still-live owned virtual peer");end=net_now()+3000;while net_now()<end&&bp_alive(pid,ticks){h_sleep(20);}}h_assert(!bp_alive(pid,ticks),"Owned virtual peer is still live; preserve recovery evidence");}}return 0;}
