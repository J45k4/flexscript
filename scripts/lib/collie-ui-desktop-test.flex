// Desktop additions to the shared reducer test. Uses the independent retained
// widget oracle and the same native/ARM64 comparison as the portable screens.
fn cud_data(json){return cu_update(c_json(json));}
fn cud_clear(json){return cu_step("clear",c_json(json),0);}
fn cud_nav(){let r=c_json("{\"action\":\"navigation\"}");j_set(r,"state",cu_state);return cu_call(r);}
fn cud_cards(kind,text){let card=j_object();j_set(card,"kind",j_string(kind));j_set(card,"text",j_string(text));let cards=j_array();j_push(cards,card);return cu_field("cards",cards);}
fn cud_runs(key){return c_json(cj_text(cj_get(uw_node(key),"props"),"runs"));}
fn cud_visible(runs){let text="";let i=0;while i<j_count(runs){text=h_cat(text,cj_text(j_at(runs,i),"text"));i=i+1;}return text;}
fn cud_run(runs,text,href,style){let i=0;while i<j_count(runs){let r=j_at(runs,i);if (!text||h_equal(cj_text(r,"text"),text))&&(!href||h_equal(cj_text(r,"href"),href))&&(!style||(cj_int(r,"style")&style)){return 1;}i=i+1;}return 0;}
fn cud_children(key){return cj_get(uw_node(key),"children");}
fn cud_index(children,key){let i=0;while i<j_count(children){if h_equal(j_value(j_at(children,i)),key){return i;}i=i+1;}h_die("Missing retained sidebar child");return -1;}
fn cud_request(action,data,id){let extra=j_object();j_set(extra,"session_request",j_int(id));return cu_step(action,data,extra);}
fn cu_desktop(){
    cud_clear("{\"platform\":\"linux\",\"viewport_width\":1280,\"viewport_height\":860,\"busy\":true,\"live\":{},\"stream\":\"\",\"cards\":[{\"kind\":\"user\",\"text\":\"How does it work?\"}]}");h_assert(h_equal(uw_text("card-thinking-0-title"),"Thinking")&&h_equal(uw_text("card-thinking-0-preview"),"Waiting for the model…"),"Initial thinking/waiting state missing");cu_click("card-thinking-0-toggle");h_assert(h_equal(uw_text("card-thinking-0-waiting"),"The model has not sent a public summary yet."),"Waiting panel missing");cud_data("{\"live\":{\"summaries\":[{\"text\":\"Checking the game controls.\"}]}}");h_assert(h_equal(uw_text("card-thinking-0-preview"),"Checking the game controls.")&&!uw_has("card-thinking-0-waiting")&&h_equal(uw_text("card-thinking-0-live-summary-0"),"Checking the game controls."),"Real summary did not replace waiting");cud_clear("{\"busy\":true,\"live\":{},\"stream\":\"\",\"cards\":[{\"kind\":\"user\",\"text\":\"Next request\"}]}");cud_data("{\"stream\":\"A direct reply\",\"live\":{\"text\":\"A direct reply\"}}");h_assert(h_equal(uw_text("card-thinking-0-preview"),"Writing reply…"),"Direct reply status missing");cud_data("{\"busy\":false,\"cards\":[{\"kind\":\"user\",\"text\":\"Next request\"},{\"kind\":\"assistant\",\"text\":\"A direct reply\"}]}");h_assert(!uw_has("card-thinking-0-title"),"Empty thinking activity survived completion");let cards=cj_get(cu_state,"cards");let i=0;while i<j_count(cards){h_assert(!h_equal(cj_text(j_at(cards,i),"kind"),"thinking"),"Synthetic thinking card retained");i=i+1;}cu_pass("thinking appears before first summary, replaces waiting with actual summaries and removes empty activity after completion");
    cud_clear("{\"platform\":\"linux\",\"viewport_width\":1280,\"viewport_height\":860}");let modes=c_json("[true,false,\"ask\"]");i=0;while i<3{let policy=c_json(j_dump(cj_get(cu_state,"policy")));j_set(policy,"workers",j_at(modes,i));let data=c_json("{\"page\":\"permissions\"}");j_set(data,"policy",policy);cu_update(data);let prior=j_dump(cj_get(cu_state,"policy"));cu_command(cu_click("desktop-workers"),"{\"kind\":\"hide_keyboard\"}");h_assert(h_equal(cj_text(cu_state,"page"),"workers")&&h_equal(j_dump(cj_get(cu_state,"policy")),prior),"Workers navigation changed grant");cu_click("workers-back");cu_click("desktop-settings");cu_click("settings-nav-access");h_assert(h_equal(uw_text("settings-nav-access"),"Permissions")&&h_equal(uw_text("settings-access-title"),"Permissions"),"Access settings label differs");let choices=c_json("[[\"allow\",true],[\"deny\",false],[\"ask\",\"ask\"]]");let n=0;while n<3{let row=j_at(choices,n);let command=c_json("{\"kind\":\"permission\",\"key\":\"workers\"}");j_set(command,"allowed",j_at(row,1));h_assert(jc_equal(cu_click(h_cat(j_value(j_at(row,0)),"-workers")),command),"Worker permission effect mismatch");n=n+1;}cu_click("desktop-settings");h_assert(h_equal(cj_text(cu_state,"page"),"settings"),"Settings route lost");cu_step("back",0,0);i=i+1;}cud_data("{\"page\":\"chat\"}");cu_pass("workers navigation from workspace access is separate from worker grants and never changes policy");
    cud_data("{\"draft\":\"Keep my settings draft\"}");cu_click("desktop-settings");cu_click("settings-nav-model");h_assert(h_equal(cj_text(cu_state,"page"),"settings")&&uw_has("settings-title")&&!uw_has("desktop-permissions")&&!uw_has("menu-panel"),"Dedicated settings failed");cu_click("settings-model-change");h_assert(h_equal(cj_text(cu_state,"page"),"model")&&h_equal(cj_text(cu_state,"model_return"),"settings"),"Model picker return target lost");cu_step("back",0,0);h_assert(h_equal(cj_text(cu_state,"page"),"settings")&&h_equal(cj_text(cu_state,"draft"),"Keep my settings draft"),"Settings lost editor draft");cu_click("settings-model-change");h_assert(h_equal(cj_text(cu_click("model-option-1"),"model"),"gpt-6-astra")&&h_equal(cj_text(cu_state,"page"),"settings"),"Model selection return failed");cud_data("{\"model\":\"gpt-6-astra\"}");h_assert(h_equal(uw_text("settings-model-current"),"GPT-6 Astra"),"Selected model display differs");
    cud_data("{\"authenticated\":true,\"account\":{\"name\":\"Alex Example\",\"email\":\"alex@example.test\",\"plan\":\"Plus\",\"account_id\":\"synthetic-account\"}}");cu_command(cu_click("settings-nav-account"),"{\"kind\":\"refresh_account\"}");h_assert(uw_has("settings-account-title")&&h_equal(uw_text("settings-account-name"),"Alex Example")&&h_equal(uw_text("settings-account-email"),"alex@example.test")&&h_number(cj_text(cj_get(uw_node("settings-account-email"),"props"),"selectable"))==1&&h_equal(uw_text("settings-account-plan"),"Plan · Plus"),"Public synthetic account fields/selectability differ");cu_command(cu_click("settings-account-login"),"{\"kind\":\"start_account_login\",\"method\":\"browser\"}");h_assert(h_equal(cj_text(cu_state,"page"),"settings"),"Login left settings");cu_command(cu_click("settings-account-device"),"{\"kind\":\"start_account_login\",\"method\":\"device\"}");h_assert(h_equal(cj_text(cu_click("settings-account-import"),"kind"),"import_auth"),"Auth import route missing");cud_data("{\"account_login\":{\"running\":true,\"status\":\"waiting\",\"method\":\"device\",\"url\":\"https://auth.openai.com/codex/device\",\"code\":\"TEST-CODE\",\"message\":\"Sign in\"}}");h_assert(h_equal(uw_text("settings-signin-code"),"TEST-CODE")&&!uw_has("settings-account-login"),"Device login progress missing");cu_command(cu_click("settings-signin-open"),"{\"kind\":\"open_account_login\"}");cu_command(cu_click("settings-signin-copy"),"{\"kind\":\"copy\",\"text\":\"https://auth.openai.com/codex/device\"}");cu_command(cu_click("settings-signin-cancel"),"{\"kind\":\"cancel_account_login\"}");h_assert(!cj_get(cud_nav(),"account_login"),"Login state leaked to navigation snapshot");cud_data("{\"account_login\":{}}");let nav=cud_nav();h_assert(h_equal(cj_text(nav,"settings_section"),"account")&&!cj_get(nav,"account"),"Account leaked to navigation snapshot");cud_data("{\"account\":{\"account_id\":\"synthetic-account\"}}");h_assert(!uw_has("settings-account-email")&&uw_has("settings-account-id"),"Account fallback ID missing");cud_data("{\"authenticated\":false,\"account\":{}}");h_assert(!uw_has("settings-account-name")&&!uw_has("settings-account-id"),"Signed-out account details retained");
    cud_data("{\"authenticated\":true,\"accounts\":[{\"id\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"name\":\"Alex Example\",\"email\":\"alex@example.test\",\"active\":true,\"available\":true},{\"id\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\"name\":\"Blair Example\",\"email\":\"blair@example.test\",\"active\":false,\"available\":true}],\"account_busy\":false}");cu_command(cu_click("settings-account-use-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"),"{\"kind\":\"select_account\",\"id\":\"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}");h_assert(h_equal(cj_text(cu_state,"page"),"settings")&&uw_has("settings-saved-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa-selected"),"Saved account selection state lost");cud_data("{\"account_busy\":true}");cu_command(cu_click("settings-account-use-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"),"{\"kind\":\"none\"}");h_assert(uw_has("settings-account-busy"),"Account switch busy status missing");nav=cud_nav();h_assert(!cj_get(nav,"accounts")&&!cj_get(nav,"account"),"Saved accounts leaked to navigation snapshot");cud_data("{\"accounts\":[],\"account_busy\":false}");cu_click("settings-back");h_assert(h_equal(cj_text(cu_state,"page"),"chat")&&h_equal(cj_text(cu_state,"draft"),"Keep my settings draft"),"Settings roundtrip lost draft");cud_data("{\"draft\":\"\"}");cu_pass("desktop settings retain model-picker context, account/login state and drafts without navigation leaks");
    let markdown="## Project\nCreated [**tetris.html**](tetris.html), [guide](https://example.com/guide_(desktop)) with *controls*, ~~old~~ and `score`.\n\n- First item";let data=c_json("{\"cards\":[{\"kind\":\"user\",\"text\":\"Make a game\"}]}");let card=j_object();j_set(card,"kind",j_string("assistant"));j_set(card,"text",j_string(markdown));j_push(cj_get(data,"cards"),card);cu_update(data);let runs=cud_runs("card-1-body");h_assert(h_equal(cud_visible(runs),"Project\nCreated tetris.html, guide with controls, old and score.\n\n•  First item")&&cud_run(runs,0,"tetris.html",1)&&cud_run(runs,0,"https://example.com/guide_(desktop)",0)&&cud_run(runs,"controls",0,16)&&cud_run(runs,"old",0,32),"Markdown runs/style/link text differ");cu_command(cu_event("card-1-body",j_string("tetris.html"),"link"),"{\"kind\":\"open_link\",\"href\":\"tetris.html\"}");let invalid=c_json("{\"action\":\"event\",\"event\":{\"key\":\"card-1-body\",\"action\":\"\",\"action_id\":0,\"type\":\"link\",\"value\":\"https://other.example\"}}");j_set(invalid,"state",cu_state);h_assert(cj_get(cu_call(invalid),"error"),"Unrendered Markdown link accepted");cud_cards("assistant","[blocked](javascript:alert(1)) [local](file:///etc/passwd)");runs=cud_runs("card-0-body");i=0;while i<j_count(runs){h_assert(!h_len(cj_text(j_at(runs,i),"href")),"Unsafe Markdown URL retained");i=i+1;}cu_pass("desktop Markdown formats text/workspace links and validates clicked URLs against rendered content");
    let table="A table follows.\n\n| No. | President | Years |\n| ---: | :--- | :---: |\n";i=1;while i<48{table=h_cat3(table,h_cat3("| ",h_int(i)," | Person "),h_cat3(h_int(i)," | Term ",h_cat(h_int(i)," |\n")));i=i+1;}cud_cards("assistant",h_cat(table,"\nAfter the table."));runs=cud_runs("card-0-body");let cells=j_object();let maxrow=0;let alignment=j_object();i=0;while i<j_count(runs){let cell=cj_get(j_at(runs,i),"cell");if cell{let key=h_cat3(h_int(cj_int(cell,"table")),":",h_cat3(h_int(cj_int(cell,"row")),":",h_int(cj_int(cell,"column"))));j_set(cells,key,j_bool(1));if cj_int(cell,"row")>maxrow{maxrow=cj_int(cell,"row");}let column=h_int(cj_int(cell,"column"));if !cj_get(alignment,column){j_set(alignment,column,cj_get(cell,"align"));}}i=i+1;}h_assert(j_count(cells)==48*3&&maxrow==47&&h_starts(cud_visible(runs),"A table follows.\n\nNo.\tPresident\tYears\n1\tPerson 1\tTerm 1\n")&&h_equal(cj_text(alignment,"0"),"end")&&h_equal(cj_text(alignment,"1"),"start")&&h_equal(cj_text(alignment,"2"),"center"),"Pipe table lost rows/alignment/copy order");let malformed=c_json("[\"| A | B |\\n| --- |\\n| one | two |\",\"```text\\n| A | B |\\n| --- | --- |\\n| one | two |\\n```\"]");i=0;while i<2{cud_cards("assistant",j_value(j_at(malformed,i)));runs=cud_runs("card-0-body");let n=0;while n<j_count(runs){h_assert(!cj_get(j_at(runs,n),"cell"),"Malformed/fenced Markdown became a table");n=n+1;}i=i+1;}cud_cards("assistant","| A | B |\n| --- | --- |\n| [file](tetris.html) | `a\\|b` |");cu_command(cu_event("card-0-body",j_string("tetris.html"),"link"),"{\"kind\":\"open_link\",\"href\":\"tetris.html\"}");cu_pass("desktop pipe tables retain all 47 rows, alignment and selectable copy order while respecting code fences/invalid delimiters");
    cud_data("{\"cards\":[{\"kind\":\"image\",\"text\":\"Generated image: assets/circle.png\",\"observation\":{\"type\":\"image\",\"path\":\"assets/circle.png\",\"image_id\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"width\":64,\"height\":64,\"bytes\":128,\"file_bytes\":256,\"mime\":\"image/jpeg\",\"provider\":\"codex\"}}]}");h_assert(uw_has("card-0-generated-image")&&h_equal(uw_text("card-0-generated-title"),"Image · assets/circle.png"),"Generated image tile missing");cu_click("card-0-generated");h_assert(h_equal(cj_text(cu_state,"page"),"preview")&&h_equal(cj_text(cj_get(cu_state,"preview"),"path"),"assets/circle.png"),"Generated image snapshot route missing");cu_step("back",0,0);h_assert(h_equal(cj_text(cu_state,"page"),"chat"),"Image preview back route failed");cu_pass("generated images render as preview tiles and open persisted snapshots");
    cud_data("{\"model\":\"gpt-6.1-sol\"}");cu_click("desktop-model");h_assert(uw_has("model-option-0")&&uw_has("model-option-1")&&h_equal(cj_text(cj_get(uw_node("model-input"),"props"),"value"),""),"Initial model picker state differs");cu_change("model-input","gpt 6 astra");h_assert(uw_has("model-option-1")&&!uw_has("model-option-0"),"Model display-name search failed");cu_command(cu_click("model-option-1"),"{\"kind\":\"save_model\",\"model\":\"gpt-6-astra\",\"keyboard\":\"hide\"}");cud_data("{\"model\":\"gpt-6-astra\"}");cu_click("desktop-model");cu_change("model-input","does not exist");h_assert(uw_has("model-empty"),"Empty model result missing");cu_command(cu_event("model-input",j_string("does not exist"),"submit"),"{\"kind\":\"none\"}");cu_change("model-input","sol");cu_command(cu_event("model-input",j_string("sol"),"submit"),"{\"kind\":\"save_model\",\"model\":\"gpt-6.1-sol\",\"keyboard\":\"hide\"}");cud_data("{\"model\":\"gpt-6.1-sol\"}");cu_pass("desktop model picker filters display names/IDs and selects with click or Enter");
    cud_data("{\"projects\":[{\"id\":\"alpha\",\"name\":\"Alpha\",\"path\":\"/home/demo/Alpha\"},{\"id\":\"beta\",\"name\":\"Beta\",\"path\":\"/home/demo/Beta\"}],\"project_id\":\"alpha\",\"project_name\":\"Alpha\",\"sessions\":[{\"id\":\"alpha-chat\",\"title\":\"Alpha chat\",\"preview\":\"Shared folder\",\"project_id\":\"alpha\"},{\"id\":\"beta-chat\",\"title\":\"Beta chat\",\"preview\":\"Another folder\",\"project_id\":\"beta\"},{\"id\":\"personal-chat\",\"title\":\"Personal chat\",\"preview\":\"Private files\"}],\"query\":\"\",\"session_offset\":0}");h_assert(uw_has("desktop-session-alpha-chat")&&uw_has("desktop-session-beta-chat")&&uw_has("desktop-session-personal-chat")&&cud_index(cud_children("desktop-sessions"),"sidebar-group-alpha")<cud_index(cud_children("desktop-sessions"),"desktop-session-alpha-chat"),"Grouped project conversations missing/order differs");cu_click("desktop-collapse");cu_click("chat-project");h_assert(h_equal(cj_text(cu_state,"page"),"projects")&&h_equal(uw_text("project-alpha-path"),"/home/demo/Alpha")&&h_equal(cj_text(cj_get(uw_node("project-alpha"),"props"),"background"),"#28382d"),"Project picker state missing");cu_command(cu_click("projects-add"),"{\"kind\":\"choose_project_folder\"}");cu_command(cu_click("project-beta"),"{\"kind\":\"select_project\",\"id\":\"beta\"}");cud_data("{\"project_id\":\"beta\",\"project_name\":\"Beta\"}");cu_click("desktop-toggle");h_assert(uw_has("desktop-session-beta-chat")&&uw_has("desktop-session-alpha-chat"),"Project switch hid other groups");cu_click("desktop-collapse");cu_click("chat-project");cu_command(cu_click("project-personal"),"{\"kind\":\"select_project\",\"id\":\"\"}");cud_data("{\"project_id\":\"\",\"project_name\":\"Personal chats\"}");cu_click("desktop-toggle");h_assert(uw_has("desktop-session-personal-chat")&&uw_has("desktop-session-beta-chat"),"Personal project lost grouped conversations");cu_pass("desktop project picker exposes host folders and retains grouped conversations");
    cu_change("desktop-search","Alpha");cu_command(cu_click("desktop-new-project"),"{\"kind\":\"choose_project_folder\"}");h_assert(h_equal(cj_text(cu_state,"query"),""),"New project did not clear sidebar search");cu_command(cu_click("sidebar-projects-add"),"{\"kind\":\"choose_project_folder\"}");cu_command(cu_click("sidebar-new-beta"),"{\"kind\":\"new_session\",\"project_id\":\"beta\",\"keyboard\":\"hide\"}");cu_click("sidebar-fold-alpha");h_assert(!uw_has("desktop-session-alpha-chat")&&cj_int(cj_get(cu_state,"sidebar_closed"),"alpha"),"Project group did not collapse");cu_click("sidebar-mode-timeline");h_assert(h_equal(cj_text(cu_state,"sidebar_mode"),"timeline")&&!uw_has("sidebar-group-alpha")&&h_equal(cj_text(uw_node("desktop-session-alpha-chat"),"parent"),"desktop-sessions")&&h_equal(uw_text("desktop-session-alpha-chat-project"),"Alpha")&&h_equal(uw_text("desktop-session-personal-chat-project"),"Personal chats"),"Timeline group/project labels differ");let actual=j_array();let children=cud_children("desktop-sessions");i=0;while i<j_count(children){let key=j_value(j_at(children,i));if h_starts(key,"desktop-session-")&&!h_equal(key,"desktop-session-pager"){j_push(actual,j_string(key));}i=i+1;}h_assert(jc_equal(actual,c_json("[\"desktop-session-alpha-chat\",\"desktop-session-beta-chat\",\"desktop-session-personal-chat\"]")),"Timeline order differs");cu_change("desktop-search","Beta");h_assert(uw_has("desktop-session-beta-chat")&&!uw_has("desktop-session-alpha-chat"),"Global sidebar search failed");cu_click("sidebar-mode-projects");h_assert(uw_has("sidebar-group-beta")&&!uw_has("sidebar-group-alpha"),"Project search included wrong group");cu_change("desktop-search","Alpha");h_assert(uw_has("desktop-session-alpha-chat"),"Search did not expose collapsed-group match");cu_change("desktop-search","");h_assert(!uw_has("desktop-session-alpha-chat"),"Clearing search lost collapsed state");cu_click("sidebar-fold-alpha");h_assert(uw_has("desktop-session-alpha-chat"),"Group did not expand");nav=cud_nav();h_assert(h_equal(cj_text(nav,"sidebar_mode"),"projects")&&!cj_int(cj_get(nav,"sidebar_closed"),"alpha"),"Sidebar navigation snapshot differs");cu_pass("sidebar modes group projects or show activity timeline, search all groups and retain collapse state");
    cud_data("{\"sessions\":[{\"id\":\"first\",\"title\":\"first\",\"preview\":\"Saved reply\"},{\"id\":\"second\",\"title\":\"second\",\"preview\":\"Saved reply\"},{\"id\":\"third\",\"title\":\"third\",\"preview\":\"Saved reply\"}],\"session_id\":\"first\",\"query\":\"\",\"session_offset\":0,\"draft\":\"Original draft\"}");cu_command(cu_click("desktop-session-second"),"{\"kind\":\"open_session\",\"id\":\"second\",\"request_id\":1,\"keyboard\":\"hide\"}");h_assert(h_equal(cj_text(cu_state,"session_id"),"first")&&h_equal(cj_text(cu_state,"pending_session_id"),"second")&&h_equal(cj_text(cu_state,"draft"),"Original draft")&&h_equal(cj_text(cj_get(uw_node("desktop-session-second"),"props"),"background"),"#28382d")&&h_equal(cj_text(cj_get(uw_node("desktop-session-first"),"props"),"background"),"#151c21")&&h_equal(uw_text("chat-title"),"second")&&uw_has("desktop-session-loading-label")&&!uw_has("composer-draft"),"Optimistic chat switch exposed old transcript/draft");h_assert(cj_int(cu_click("desktop-session-third"),"request_id")==2,"Session request generation did not advance");let snapshot=j_dump(cu_state);cud_request("clear",0,1);cud_request("update",c_json("{\"session_id\":\"second\",\"pending_session_id\":\"\",\"cards\":[{\"kind\":\"assistant\",\"text\":\"Stale reply\"}]}"),1);h_assert(h_equal(j_dump(cu_state),snapshot)&&h_equal(cj_text(cj_get(uw_node("desktop-session-third"),"props"),"background"),"#28382d"),"Stale session result replaced latest selection");cud_request("clear",0,2);cud_request("restore",c_json("{\"draft\":\"Third draft\"}"),2);cud_request("update",c_json("{\"session_id\":\"third\",\"pending_session_id\":\"\",\"cards\":[{\"kind\":\"assistant\",\"text\":\"Latest reply\"}]}"),2);h_assert(h_equal(cj_text(cu_state,"draft"),"Third draft")&&h_equal(uw_text("card-0-body"),"Latest reply")&&uw_has("composer-draft"),"Latest selected conversation failed to load");h_assert(cj_int(cu_click("desktop-session-first"),"request_id")==3,"Session request generation reused");cu_step("notice",0,c_json("{\"text\":\"Synthetic load failure\",\"session_request\":3}"));h_assert(!h_len(cj_text(cu_state,"pending_session_id"))&&h_equal(cj_text(cu_state,"session_id"),"third")&&h_equal(cj_text(cj_get(uw_node("desktop-session-third"),"props"),"background"),"#28382d"),"Session load failure did not recover selection");cu_click("notice-close");cu_pass("desktop chat selection hides old transcripts, rejects stale loads and recovers from errors");cud_clear("{\"platform\":\"\"}");return 0;
}
