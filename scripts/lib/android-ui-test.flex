// Native real-widget navigation and form helpers for owned emulator tests.
import "android-preferences-test.flex";
fn au_select(xml,key,label,partial){let offset=0;let found=0;while load8(xml+offset){let start=h_find(xml+offset,"<node ");if start<0{return found;}offset=offset+start;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed actual Android UI node");let node=h_slice(xml+offset,end+1);let value=ut_attr(node,key);if value&&h_equal(ut_attr(node,"enabled"),"true")&&(h_equal(ap_unescape(value),label)||(partial&&h_has(ap_unescape(value),label))){h_assert(!found||h_equal(found,node),"Ambiguous actual shared-view control");found=node;}offset=offset+end+1;}return found;}
fn au_node_key(xml,key,label){return au_select(xml,key,label,0);}
fn au_contains(key,label){let end=net_now()+20000;while net_now()<end{let node=au_select(at_xml(),key,label,1);if node{return node;}h_sleep(100);}h_die(h_cat("Missing actual shared-view item: ",label));return 0;}
fn au_tap_contains(key,label){ut_tap(au_contains(key,label));h_sleep(400);return 0;}
fn au_node(xml,label){let node=au_node_key(xml,"content-desc",label);if !node{node=au_node_key(xml,"text",label);}return node;}
// Transcript controls repeat across turns. Explicitly target the last rendered
// matching row when a scenario is inspecting its newest program/result.
fn au_latest(xml,label){let offset=0;let found=0;while load8(xml+offset){let at=h_find(xml+offset,"<node ");if at<0{return found;}offset=offset+at;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed transcript control");let node=h_slice(xml+offset,end+1);if h_equal(ut_attr(node,"enabled"),"true")&&(h_equal(ut_attr(node,"content-desc"),label)||h_equal(ut_attr(node,"text"),label)){found=node;}offset=offset+end+1;}return found;}
fn au_find(label){let end=net_now()+20000;while net_now()<end{let node=au_node(at_xml(),label);if node{return node;}h_sleep(100);}h_die(h_cat("Missing actual shared-view control: ",label));return 0;}
fn au_tap(label){ut_tap(au_find(label));h_sleep(300);return 0;}
fn au_value(label){let node=au_find(label);let text=ut_attr(node,"text");let hint=ut_attr(node,"hint");if !text||h_equal(text,hint){return "";}return ap_unescape(text);}
fn au_edit(label,text){let current=au_value(label);au_tap(label);ut_ok(ut_args("shell","input","keyevent","123",0,0),"");if h_len(current){h_assert(h_len(current)<=4096,"Owned test field exceeds edit bound");let args=ut_args("shell","input","keyevent",0,0,0);let i=0;while i<h_len(current){h_add(args,"67");i=i+1;}ut_ok(args,"");}if h_len(text){ut_ok(ut_args("shell","input","text",h_replace(text," ","%s"),0,0),"");}h_sleep(300);h_assert(h_equal(au_value(label),text),h_cat("Actual Android field did not retain input: ",label));return 0;}
fn au_pref(key){let raw=h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat","shared_prefs/MainActivity.xml",0),""));if h_find(raw,h_cat3("<string name=\"",key,"\">"))<0{return "";}return ap_string(raw,key);}
fn au_shot(directory,name){h_assert(ut_name(name),"Unsafe screenshot name");h_mkdir(directory);let shot=ut_ok(ut_args("exec-out","screencap","-p",0,0,0),"");h_save_bytes(h_join(directory,h_cat(name,".png")),h_out(shot),h_size(load64(shot+16)),384);return 0;}
fn au_display(){let rows=at_lines(h_out(ut_ok(ut_args("shell","wm","size",0,0,0),"")));let result=h_zero(h_take(16),16);let i=0;while i<h_count(rows){let line=h_at(rows,i);let colon=h_find(line,": ");if colon>=0{let value=line+colon+2;let x=h_find(value,"x");if x>0{store64(result,h_number(h_slice(value,x)));store64(result+8,h_number(value+x+1));}}i=i+1;}h_assert(load64(result)>0&&load64(result+8)>0,"Unknown actual Android display size");return result;}
fn au_scroll(down){let size=au_display();let width=load64(size);let height=load64(size+8);let first=height*32/100;let last=height*76/100;if down{first=height*76/100;last=height*32/100;}let args=ut_args("shell","input","swipe",h_int(width/2),h_int(first),h_int(width/2));h_add(args,h_int(last));h_add(args,"250");return ut_ok(args,"");}
fn au_permission(session,key,label,allowed){let text=h_cat("Deny ",label);if allowed{text=h_cat("Allow ",label);}let i=0;while i<8{let node=au_node(at_xml(),text);if node{let bounds=at_vertical(node);let size=au_display();if load64(bounds+8)<load64(size+8)-40{ut_tap(node);let end=net_now()+2000;while net_now()<end{let saved=ut_read(h_cat3("files/workspaces/",session,"/session.json"));let value=cj_get(cj_get(saved,"permissions"),key);if value&&j_kind(value)==5&&at_bool(value)==allowed{return 0;}h_sleep(100);}}}au_scroll(1);i=i+1;}h_die(h_cat("Permission choice is not reachable: ",key));return 0;}
