// Read Android's serialized preference strings without a host-language parser.
import "collie-android-test.flex";
fn ap_unescape(text){let out=h_buffer();let i=0;while load8(text+i){if load8(text+i)!=38{h_append(out,text+i,1);i=i+1;}else{let end=h_find(text+i,";");h_assert(end>1&&end<16,"Malformed Android preference XML entity");let entity=h_slice(text+i+1,end-1);let code=-1;if h_equal(entity,"amp"){code=38;}else if h_equal(entity,"lt"){code=60;}else if h_equal(entity,"gt"){code=62;}else if h_equal(entity,"quot"){code=34;}else if h_equal(entity,"apos"){code=39;}else if load8(entity)==35{let radix=10;let offset=1;if load8(entity+1)==120{radix=16;offset=2;}h_assert(load8(entity+offset),"Empty XML character reference");code=0;while load8(entity+offset){let c=load8(entity+offset);let digit=c-48;if c>=97&&c<=102{digit=c-87;}else if c>=65&&c<=70{digit=c-55;}h_assert(digit>=0&&digit<radix&&code<=1114111/radix,"Invalid XML character reference");code=code*radix+digit;offset=offset+1;}}h_assert(code>0&&code<=1114111&&(code<55296||code>57343),"Invalid Android XML character scalar");j_utf8(out,code);i=i+end+1;}}return h_data(out);}
fn ap_string(xml,key){h_assert(ut_name(key)&&!h_has(xml,"<!DOCTYPE"),"Unexpected Android preference XML");let marker=h_cat3("<string name=\"",key,"\">");let start=h_find(xml,marker);h_assert(start>=0,"Required Android preference string is absent");let data=xml+start+h_len(marker);let end=h_find(data,"</string>");h_assert(end>=0&&h_find(data,marker)<0,"Ambiguous Android preference string");return ap_unescape(h_slice(data,end));}
fn ap_snapshot(path){let p=ut_call(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),"");let raw=h_out(p);let r=j_object();j_set(r,"present",j_bool(h_starts(h_trim(raw),"<?xml")));if cj_int(r,"present"){j_set(r,"xml",j_string(raw));}else{h_assert(h_has(raw,"No such file or directory"),"Existing Android preferences could not be read");}return r;}
fn ap_restore(path,snapshot){if cj_int(snapshot,"present"){at_write(path,cj_text(snapshot,"xml"));h_assert(h_equal(h_out(ut_ok(ut_args("exec-out","run-as","org.flexscript.collie","cat",path,0),"")),cj_text(snapshot,"xml")),"Original Android preferences were not restored exactly");}else{ut_ok(ut_args("shell","run-as","org.flexscript.collie","rm","-f",path),"");h_assert(h_status(ut_call(ut_args("shell","run-as","org.flexscript.collie","test","-e",path),""))!=0,"Originally absent Android preference file remains");}return 0;}
