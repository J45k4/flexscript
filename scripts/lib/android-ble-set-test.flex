// Native construction/observation helpers shared by the two set scenario suites.
import "android-peer-test.flex";
global bs_peer=0;global bs_service=0;
fn bs_data(name,hex,large,oversized){let source=bp_blob(h_cat(name,"_bytes"),hex);source=h_cat3(source,"let ",h_cat3(name,"_services=db_list();db_add(",h_cat3(name,"_services,ble_ad_service(",h_cat3(bp_string(bs_service),",db_blob(",h_cat3(name,"_bytes,",h_cat3(h_int(h_len(hex)/2),")));let ",h_cat(name,"_manufacturers=db_list();")))))));if large{let category="manufacturers";if oversized{category="oversized_manufacturers";}let fields=cj_get(bs_peer,category);h_assert(fields&&j_kind(fields)==4,"Independent manufacturer fields missing");let pairs=j_value(fields);let i=0;while i<h_count(pairs){let pair=h_at(pairs,i);let key=load64(pair);let number=h_number(key);h_assert(number>=0&&number<=65535&&h_equal(h_int(number),key),"Invalid manufacturer ID");let value=j_value(load64(pair+8));let bytes=h_cat3(name,"_manufacturer_",h_int(i));source=h_cat(source,bp_blob(bytes,value));source=h_cat3(source,"db_add(",h_cat3(name,"_manufacturers,ble_ad_manufacturer(",h_cat3(key,",db_blob(",h_cat3(bytes,",",h_cat(h_int(h_len(value)/2),")));")))));i=i+1;}}return h_cat3(source,"let ",h_cat3(name,"=ble_set_data_value(db_list(),",h_cat3(name,"_services,",h_cat(name,"_manufacturers,db_list(),0,0);"))));}
fn bs_program(name,preamble,args){return bp_guest(h_cat("ble_set_live_",name),preamble,args);}
fn bs_vm(name,preamble,args){return at_vm(ut_prefix,bs_program(name,preamble,args),0);}
fn bs_read(){let state=bp_read();h_assert(at_bool(cj_get(state,"ready"))&&j_count(cj_get(state,"errors"))==0,j_dump(state));return state;}
fn bs_seen(category,name,minimum,seconds){let end=net_now()+seconds*1000;while net_now()<end{let state=bs_read();if cj_int(cj_get(state,category),name)>=minimum{return state;}h_sleep(100);}h_die(h_cat3("Independent BLE packet observation deadline: ",category,h_cat("/",name)));return 0;}
fn bs_quiet(category,name){h_sleep(1000);let before=cj_int(cj_get(bs_read(),category),name);h_sleep(1000);h_assert(cj_int(cj_get(bs_read(),category),name)==before,h_cat("Stopped advertising still reaches independent peer: ",name));return 0;}
fn bs_hex(category,name){let hex=cj_text(cj_get(bs_peer,category),name);h_assert(h_len(hex)>0,"Missing independent packet bytes");h_unhex(hex);return hex;}
