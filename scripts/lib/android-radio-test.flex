// Emulator radio/switch setup and independently observed restoration.
import "collie-android-test.flex";
fn ar_token(text,marker){let at=h_find(text,marker);h_assert(at>=0,h_cat("Missing actual Android field: ",marker));let start=at+h_len(marker);let end=start;while load8(text+end)&&load8(text+end)>32{end=end+1;}h_assert(end>start,"Empty Android status field");return h_slice(text+start,end-start);}
fn ar_location(){let value=h_trim(h_out(ut_ok(ut_args("shell","cmd","location","is-location-enabled",0,0),"")));h_assert(h_equal(value,"true")||h_equal(value,"false"),"Unknown Android Location switch state");return value;}
fn ar_set_location(value){h_assert(h_equal(value,"true")||h_equal(value,"false"),"Invalid Location switch fixture value");ut_ok(ut_args("shell","cmd","location","set-location-enabled",value,0),"");h_assert(h_equal(ar_location(),value),"Android Location switch did not change");return 0;}
fn ar_bluetooth(){let rows=at_lines(h_out(ut_ok(ut_args("shell","dumpsys","bluetooth_manager",0,0,0),"")));let i=0;while i<h_count(rows){let line=h_trim(h_at(rows,i));if h_equal(line,"enabled: true"){return 1;}if h_equal(line,"enabled: false"){return 0;}i=i+1;}h_die("Unknown actual Android Bluetooth radio state");return 0;}
fn ar_set_bluetooth(enabled){let action="disable";if enabled{action="enable";}ut_ok(ut_args("shell","svc","bluetooth",action,0,0),"");let end=net_now()+45000;while net_now()<end{if ar_bluetooth()==enabled{return 0;}h_sleep(100);}h_die("Android Bluetooth radio transition deadline");return 0;}
fn ar_voice(){let text=h_out(ut_ok(ut_args("emu","gsm","status",0,0,0),""));let voice=ar_token(text,"gsm voice state: ");h_assert(h_has("|home|roaming|searching|denied|unregistered|off|",h_cat3("|",voice,"|")),"Unknown emulator voice state; cannot safely restore it");return voice;}
fn ar_snapshot(bluetooth,voice){let state=j_object();j_set(state,"location",j_string(ar_location()));if bluetooth{j_set(state,"bluetooth",j_bool(ar_bluetooth()));}if voice{j_set(state,"voice",j_string(ar_voice()));}return state;}
fn ar_restore(){if cj_get(at_extra,"voice"){let value=cj_text(at_extra,"voice");ut_ok(ut_args("emu","gsm","voice",value,0,0),"");h_assert(h_equal(ar_voice(),value),"Emulator modem state did not restore");}if cj_get(at_extra,"bluetooth"){ar_set_bluetooth(cj_int(at_extra,"bluetooth"));}ar_set_location(cj_text(at_extra,"location"));return 0;}
fn ar_clear(permission){let args=ut_args("shell","pm","clear-permission-flags","org.flexscript.collie",permission,"user-set");h_add(args,"user-fixed");ut_ok(args,"");return 0;}
fn ar_revoke(permission){let row=cj_get(at_flags(at_package()),permission);h_assert(row,"Missing fixture runtime permission");if cj_int(row,"granted"){ut_ok(ut_args("shell","pm","revoke","org.flexscript.collie",permission,0),"");}ar_clear(permission);return 0;}
fn ar_progress(session,text,name){let end=net_now()+45000;while net_now()<end{let s=ut_read(h_cat3("files/workspaces/",session,"/session.json"));let cards=cj_get(s,"cards");if cards{let i=0;while i<j_count(cards){let card=j_at(cards,i);if h_equal(cj_text(card,"kind"),"progress")&&h_equal(cj_text(card,"text"),text){return 0;}if h_equal(cj_text(card,"kind"),"error"){h_die(cj_text(card,"text"));}i=i+1;}}let r=ut_read(h_cat3("files/test/",name,".result.json"));if r{h_die(h_cat("Fixture completed before actual listener progress: ",j_dump(r)));}h_sleep(50);}h_die("Actual listener readiness deadline");return 0;}

fn ar_wifi(){let state=h_out(ut_ok(ut_args("shell","cmd","wifi","status",0,0),""));if h_has(state,"Wifi is enabled"){return 1;}h_assert(h_has(state,"Wifi is disabled"),"Unknown actual emulator Wi-Fi state");return 0;}
fn ar_set_wifi(enabled){let action="disabled";if enabled{action="enabled";}ut_ok(ut_args("shell","cmd","wifi","set-wifi-enabled",action,0),"");let until=net_now()+30000;while net_now()<until{if ar_wifi()==enabled{return 0;}h_sleep(100);}h_die("Actual emulator Wi-Fi transition deadline");return 0;}
