// One restoring parent per owned emulator. A guardian checkpoints the peer's
// complete baseline and restores it when the coordinator exits, even on failure.
import "android-peer-test.flex";
global md_primary_serial=0;global md_primary_prefix=0;global md_peer_serial=0;global md_peer_prefix=0;global md_index=0;
fn md_options(options){j_set(options,"guardian",j_bool(0));j_set(options,"coordinator",j_string(""));j_set(options,"coordinator-pid",j_string(""));j_set(options,"coordinator-ticks",j_string(""));return options;}
fn md_path(prefix,serial,suffix){h_assert(ut_name(prefix)&&h_starts(serial,"emulator-"),"Invalid owned guardian artifact");return h_join(ut_out,h_cat3(prefix,"-",h_cat3(serial,"-",suffix)));}
fn md_redirect(){let pid=h_number(cj_text(at_options,"coordinator-pid"));let ticks=cj_text(at_options,"coordinator-ticks");h_assert(pid==syscall(110,0,0,0,0,0,0)&&bp_alive(pid,ticks),"Guardian must be spawned by its live owning coordinator");h_assert(syscall(157,1,0,0,0,0,0)==0&&bp_alive(pid,ticks),"Cannot detach the restoring guardian from coordinator death");let signal=h_zero(h_take(8),8);h_assert(syscall(157,2,signal,0,0,0,0)==0&&load64(signal)==0,"Restoring guardian still has a coordinator-death signal");let log=md_path(cj_text(at_options,"coordinator"),ut_serial,"guardian.log");let fd=syscall(257,-100,log,524865,384,0,0);h_assert(fd>=0&&syscall(33,fd,1,0,0,0,0)==1&&syscall(33,fd,2,0,0,0,0)==2,"Cannot open owned guardian log");h_close(fd);return 0;}
fn md_guardian(){let prefix=cj_text(at_options,"coordinator");let pid=h_number(cj_text(at_options,"coordinator-pid"));let ticks=cj_text(at_options,"coordinator-ticks");h_assert(ut_name(prefix)&&h_starts(prefix,h_cat3("ctest-",at_suite,"-")),"Guardian belongs to another suite");let parent=at_recovery();let ready=j_object();j_set(ready,"prefix",j_string(ut_prefix));j_set(ready,"parent_pid",cj_get(parent,"parent_pid"));j_set(ready,"parent_ticks",cj_get(bp_proc(cj_int(parent,"parent_pid")),"start_ticks"));j_set(ready,"coordinator",j_string(prefix));let path=md_path(prefix,ut_serial,"guardian-ready.json");h_assert(!h_exists(path),"Preserve existing guardian readiness record");j_save(path,ready);let stop=md_path(prefix,ut_serial,"guardian-stop");let end=net_now()+1500000;while bp_alive(pid,ticks)&&!h_exists(stop)&&net_now()<end{h_sleep(100);}h_assert(net_now()<end,"Coordinator exceeded its bounded dual-emulator session");if h_exists(stop){h_assert(h_equal(h_read(stop),prefix),"Unexpected guardian stop marker");}let report=j_object();j_set(report,"guardian_only",j_bool(1));j_set(report,"coordinator",j_string(prefix));return at_finish(report);}
fn md_start(argc,argv,peer){
    md_primary_serial=ut_serial;md_primary_prefix=ut_prefix;md_peer_serial=peer;h_assert(!h_equal(peer,ut_serial),"Two distinct owned emulators are required");let owner=syscall(39,0,0,0,0,0,0);let ticks=cj_text(bp_proc(owner),"start_ticks");let args=h_args(load64(argv),0,0,0,0,0);let i=1;while i<argc{let key=load64(argv+i*8);if h_equal(key,"--worker"){i=i+1;}else if h_equal(key,"--prefix")||h_equal(key,"--serial"){i=i+2;}else{h_add(args,key);i=i+1;}}h_add(args,"--serial");h_add(args,peer);h_add(args,"--guardian");h_add(args,"--coordinator");h_add(args,ut_prefix);h_add(args,"--coordinator-pid");h_add(args,h_int(owner));h_add(args,"--coordinator-ticks");h_add(args,ticks);j_set(at_extra,"md_peer_serial",j_string(peer));j_set(at_extra,"md_coordinator",j_string(ut_prefix));at_checkpoint_extra();let child=h_spawn(args,"",0);let pid=load64(child);j_set(at_extra,"md_guardian_pid",j_int(pid));j_set(at_extra,"md_guardian_ticks",cj_get(bp_proc(pid),"start_ticks"));at_checkpoint_extra();let ready_path=md_path(ut_prefix,peer,"guardian-ready.json");let end=net_now()+90000;let ready=0;while net_now()<end&&!ready{h_pump(child,0);h_assert(h_status(child)==-999,h_cat("Peer guardian failed before testing; inspect its owned guardian log: ",h_err(child)));if h_exists(ready_path){ready=c_json(h_read(ready_path));}else{h_sleep(100);}}h_assert(ready&&h_equal(cj_text(ready,"coordinator"),ut_prefix)&&cj_int(ready,"parent_pid")==pid&&h_equal(cj_text(ready,"parent_ticks"),cj_text(at_extra,"md_guardian_ticks")),"Peer guardian readiness mismatch");md_peer_prefix=cj_text(ready,"prefix");h_assert(ut_name(md_peer_prefix)&&h_starts(md_peer_prefix,h_cat3("ctest-",at_suite,"-")),"Unsafe peer guardian workspace");j_set(at_extra,"md_peer_prefix",j_string(md_peer_prefix));at_checkpoint_extra();return 0;
}
fn md_select(index){h_assert(index==0||index==1,"Invalid owned emulator index");md_index=index;ut_serial=md_primary_serial;ut_prefix=md_primary_prefix;if index{ut_serial=md_peer_serial;ut_prefix=md_peer_prefix;}return 0;}
fn md_cleanup(){if cj_int(at_options,"guardian")||!cj_get(at_extra,"md_guardian_pid"){return 0;}let peer=cj_text(at_extra,"md_peer_serial");let coordinator=cj_text(at_extra,"md_coordinator");let stop=md_path(coordinator,peer,"guardian-stop");h_save(stop,coordinator);let pid=cj_int(at_extra,"md_guardian_pid");let ticks=cj_text(at_extra,"md_guardian_ticks");let end=net_now()+150000;while net_now()<end&&bp_alive(pid,ticks){h_sleep(100);}h_assert(!bp_alive(pid,ticks),"Peer guardian is still restoring; preserve its live process and recovery record");let ready_path=md_path(coordinator,peer,"guardian-ready.json");h_assert(h_exists(ready_path),"Peer guardian never published its baseline owner");let ready=c_json(h_read(ready_path));let expected=cj_text(ready,"prefix");h_assert(ut_name(expected)&&h_equal(cj_text(ready,"coordinator"),coordinator),"Peer restoration owner mismatch");let cleanup=c_json(h_read(h_join(ut_out,h_cat3(at_suite,"-",h_cat(peer,"-cleanup.json")))));let report=c_json(h_read(h_join(ut_out,h_cat3(at_suite,"-",h_cat(peer,"-report.json")))));h_assert(h_equal(cj_text(cleanup,"prefix"),expected)&&cj_int(cleanup,"restored")&&cj_int(cleanup,"child_exit")==0&&!cj_int(cleanup,"timed_out")&&h_equal(cj_text(report,"prefix"),expected)&&cj_int(report,"guardian_only")&&cj_int(report,"suite_passed")&&cj_int(report,"all_android_flags_restored")&&cj_int(report,"workspace_set_restored"),"Peer guardian did not verify the complete original baseline");let audit=j_object();j_set(audit,"peer_serial",j_string(peer));j_set(audit,"peer_prefix",j_string(expected));j_set(audit,"original_peer_state_restored",j_bool(1));j_save(md_path(coordinator,peer,"guardian-cleanup.json"),audit);return 0;}
