// Independent retained widget oracle for compiled portable patch batches.
import "../../apps/collie/lib/state.flex";
global uw_nodes=0;
fn uw_drop(object,key){let pairs=j_value(object);let i=0;while i<h_count(pairs){if h_equal(load64(h_at(pairs,i)),key){let j=i+1;while j<h_count(pairs){store64(pairs+8+(j-1)*8,h_at(pairs,j));j=j+1;}store64(pairs,h_count(pairs)-1);return 0;}i=i+1;}return 0;}
fn uw_node(key){let value=cj_get(uw_nodes,key);h_assert(value,h_cat("Patch references an absent widget: ",key));return value;}
fn uw_children_remove(parent,key){let node=uw_node(parent);let old=cj_get(node,"children");let children=j_array();let count=0;let i=0;while i<j_count(old){let item=j_at(old,i);if h_equal(j_value(item),key){count=count+1;}else{j_push(children,item);}i=i+1;}h_assert(count==1,"Widget parent does not contain exactly one owned child");j_set(node,"children",children);return 0;}
fn uw_remove(key){let node=uw_node(key);let children=cj_get(node,"children");let i=0;while i<j_count(children){uw_remove(j_value(j_at(children,i)));i=i+1;}let parent=cj_text(node,"parent");if h_len(parent){uw_children_remove(parent,key);}uw_drop(uw_nodes,key);return 0;}
fn uw_tree(raw,parent){let key=cj_text(raw,"key");h_assert(h_len(key)&&!cj_get(uw_nodes,key),"Duplicate stable widget identity");let node=c_json(j_dump(raw));j_set(node,"children",j_array());if parent{j_set(node,"parent",j_string(parent));}else{j_set(node,"parent",j_node(0,0));}j_set(uw_nodes,key,node);let children=cj_get(raw,"children");let i=0;while i<j_count(children){let child=j_at(children,i);uw_tree(child,key);j_push(cj_get(node,"children"),j_string(cj_text(child,"key")));i=i+1;}return 0;}
fn uw_attach(key,parent,after){let node=uw_node(key);let previous=cj_text(node,"parent");if h_len(previous){uw_children_remove(previous,key);}let owner=uw_node(parent);let old=cj_get(owner,"children");let index=0;if h_len(after){index=-1;let i=0;while i<j_count(old){if h_equal(j_value(j_at(old,i)),after){index=i+1;}i=i+1;}h_assert(index>=0,"Patch insertion predecessor is absent from its actual parent");}let children=j_array();let i=0;while i<=j_count(old){if i==index{j_push(children,j_string(key));}if i<j_count(old){j_push(children,j_at(old,i));}i=i+1;}j_set(owner,"children",children);j_set(node,"parent",j_string(parent));return 0;}
fn uw_init(){uw_nodes=j_object();j_set(uw_nodes,"mount",c_json("{\"children\":[]}"));return 0;}
fn uw_apply(packet){let ops=cj_get(packet,"ops");let i=0;while i<j_count(ops){let op=j_at(ops,i);let key=cj_text(op,"key");let kind=cj_text(op,"op");if h_equal(kind,"insert"){if cj_get(uw_nodes,key){uw_remove(key);}uw_tree(cj_get(op,"node"),0);}else{uw_node(key);}if h_equal(kind,"remove"){uw_remove(key);}else if h_equal(kind,"insert")||h_equal(kind,"move"){uw_attach(key,cj_text(op,"parent"),cj_text(op,"after"));}else if h_equal(kind,"text")||h_equal(kind,"label")||h_equal(kind,"placeholder"){j_set(uw_node(key),"text",cj_get(op,"value"));}else if h_equal(kind,"checked")||h_equal(kind,"hidden"){j_set(uw_node(key),kind,cj_get(op,"value"));}else if h_equal(kind,"attribute"){let node=uw_node(key);let name=cj_text(op,"name");let value=cj_get(op,"value");if h_equal(name,"action"){let text="";if value&&j_kind(value)==2{text=j_value(value);}j_set(node,name,j_string(text));}else if h_equal(name,"action_id"){let id=0;if value&&j_kind(value)!=0{id=h_number(j_value(value));}j_set(node,name,j_int(id));}else if !value||j_kind(value)==0{uw_drop(cj_get(node,"props"),name);}else{j_set(cj_get(node,"props"),name,value);}}else{h_die(h_cat("Unsupported actual widget patch: ",kind));}i=i+1;}return 0;}
fn uw_text(key){return cj_text(uw_node(key),"text");}
fn uw_has(key){return cj_get(uw_nodes,key)!=0;}
