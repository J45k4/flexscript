// Real system pairing and removal, scoped to an explicitly named local fixture.
import "android-peer-test.flex";
fn btp_confirm(name){ut_ok(ut_args("shell","cmd","statusbar","expand-notifications",0,0),"");let i=0;while i<8{let xml=at_xml();if h_has(xml,name){let pair=at_node(xml,"text","Pair",0);if pair{ut_tap(pair);ut_ok(ut_args("shell","cmd","statusbar","collapse",0,0),"");return 0;}let offset=0;let target=0;while load8(xml+offset)&&!target{let start=h_find(xml+offset,"<node ");if start<0{offset=h_len(xml);}else{offset=offset+start;let end=h_find(xml+offset,">");h_assert(end>=0,"Malformed pairing UI");let node=h_slice(xml+offset,end+1);if h_equal(ut_attr(node,"enabled"),"true")&&h_has(ut_attr(node,"text"),name){target=node;}offset=offset+end+1;}}if target{ut_tap(target);}}h_sleep(300);i=i+1;}h_die("No actual pairing confirmation for the explicitly named local fixture");return 0;}
fn btp_unbonded(address){let o=at_vm(ut_prefix,h_cat3("fn main(){let d=bt_device(",bp_string(address),");if !d{return 1;}if db_word(device_field(device_info(db_word(d)),\"bond_state\"))==10{db_io(0,1,\"unbonded\",8);}return device_close(db_word(d))-1;}"),c_json("{\"bluetooth\":true,\"db_read\":true,\"db_write\":true}"));return h_equal(cj_text(o,"stdout"),"unbonded");}
fn btp_forget(name,address){ut_ok(ut_args("shell","cmd","statusbar","collapse",0,0),"");let xml=at_xml();if h_has(xml,name)&&at_node(xml,"text","Pair",0){ut_ok(ut_args("shell","input","keyevent","4",0,0),"");}if !btp_unbonded(address){ut_ok(ut_args("shell","am","start","-a","android.settings.BLUETOOTH_SETTINGS",0),"");let end=net_now()+20000;let gear=0;while net_now()<end&&!gear{xml=at_xml();gear=at_node(xml,"content-desc",h_cat(name,". Configure device detail."),0);if !gear{gear=at_row_gear(xml,name);}if !gear{h_sleep(50);}}h_assert(gear,"Owned Bluetooth device Settings row missing");ut_tap(gear);xml=at_xml();h_assert(h_has(xml,name)&&h_has(xml,address),"Refusing to forget an unrelated Bluetooth device");at_click("text","Forget",0);at_click("text","Forget device",0);}h_assert(btp_unbonded(address),"Owned virtual peer remains paired");return 0;}
