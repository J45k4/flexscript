import "lib/esp32-test.flex";
import "lib/esp32-elf.flex";
fn main(argc,argv){h_environment(argc,argv);let compiler=b_option(argc,argv,"--compiler",0);let work=b_option(argc,argv,"--work",0);h_assert(compiler && work,"requires --compiler --work");te_init(compiler);h_remove(te_work);h_mkdir(work);te_work=h_real(work);te_qemu=h_real(h_executable(b_option(argc,argv,"--qemu","qemu-system-xtensa")));te_bios=b_option(argc,argv,"--bios",0);let board=h_join(te_work,"board-run");h_compile(te_compiler,"tests/xtensa/board-run.flex",board);let results=j_array();let chip=0;while chip<2{let source="tests/esp32/timer-width.flex";let target="esp32-elf";te_legacy=1;let prefix="esp32";if chip{source="tests/esp32/timer-width-s3.flex";target="esp32s3-elf";te_legacy=0;prefix="esp32s3";}let elf=h_join(te_work,h_cat(prefix,".elf"));h_ok(h_args(te_compiler,"--target",target,source,"-o",elf));let bytes=h_read(elf);let parsed=ee_open(bytes,h_file_size);let image=ee_rom_image(parsed);let path=h_join(te_work,h_cat(prefix,".bin"));h_save_bytes(path,image,h_file_size,420);let uart=h_join(te_work,h_cat(prefix,".native.uart"));let result=h_run(h_args(board,elf,uart,"--fuel","100000000",0));h_check(result,0,0);h_print(1,h_out(result));let native=h_read(uart);te_assert(h_has(native,"PASS: timer width cases"),"native timer-width image completed");let qemu=te_run(path,0,"PASS: timer width cases");h_save(h_join(te_work,h_cat(prefix,".qemu.uart")),qemu);te_assert(h_has(qemu,native),"same full-width timer image UART equals QEMU");let row=j_object();j_set(row,"chip",j_string(prefix));j_set(row,"ELF_sha256",j_string(h_sha(elf)));j_set(row,"UART_sha256",j_string(h_sha(uart)));j_set(row,"native",j_string(h_out(result)));j_set(row,"QEMU_match",j_bool(1));j_set(row,"physical_hardware",j_bool(0));j_push(results,row);chip=chip+1;}let report=b_option(argc,argv,"--report",0);if report{let r=j_object();j_set(r,"pass",j_bool(1));j_set(r,"scope_complete",j_bool(0));j_set(r,"chips",results);j_set(r,"QEMU_checks",j_int(te_checks));j_set(r,"compiler_sha256",j_string(h_sha(te_compiler)));j_save(report,r);}h_print(1,"PASS: timer-width firmware on both native/QEMU chips\n");return 0;}
