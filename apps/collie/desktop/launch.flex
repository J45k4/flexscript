// Respect explicit sessions/backends; discover only an unambiguous owned socket.
fn cd_has_option(argc,argv,option){let i=1;while i<argc{if h_equal(load64(argv+i*8),option){return 1;}i=i+1;}return 0;}
fn cd_setenv(key,value){h_setenv(key,value);let libc=ffi_open("libc.so.6");ffi_call_i32(ffi_symbol(libc,"setenv"),key,value,1,0,0,0);return 0;}
fn cd_display_environment(argc,argv){if h_len(h_getenv("SDL_VIDEODRIVER")) || h_len(h_getenv("SDL_VIDEO_DRIVER")) || h_equal(h_getenv("COLLIE_HEADLESS"),"1") || cd_has_option(argc,argv,"--hidden") || h_len(h_getenv("WAYLAND_DISPLAY")) || h_len(h_getenv("DISPLAY")){return 0;}let uid=syscall(102,0,0,0,0,0,0);let runtime=h_getenv("XDG_RUNTIME_DIR");if !h_len(runtime){runtime=h_cat("/run/user/",h_int(uid));}let stat=h_take(144);if syscall(4,runtime,stat,0,0,0,0)<0 || (load64(stat+24)&61440)!=16384 || (load64(stat+24)>>32)!=uid{return 0;}let fd=syscall(2,runtime,0x90000,0,0,0,0);if fd<0{return 0;}let buffer=h_take(32768);let count=0;let name=0;let n=syscall(217,fd,buffer,32768,0,0,0);while n>0{let at=0;while at<n{let size=load8(buffer+at+16)|(load8(buffer+at+17)<<8);if size<20 || at+size>n{h_close(fd);return 0;}let candidate=buffer+at+19;if h_starts(candidate,"wayland-"){let path=h_join(runtime,candidate);if syscall(6,path,stat,0,0,0,0)==0 && (load64(stat+24)&61440)==49152 && (load64(stat+24)>>32)==uid{count=count+1;name=h_slice(candidate,h_len(candidate));}}at=at+size;}n=syscall(217,fd,buffer,32768,0,0,0);}h_close(fd);if count==1{cd_setenv("XDG_RUNTIME_DIR",runtime);cd_setenv("WAYLAND_DISPLAY",name);cd_setenv("XDG_SESSION_TYPE","wayland");}return 0;}
fn cd_display_report(){let out=j_object();let keys=h_args("XDG_RUNTIME_DIR","WAYLAND_DISPLAY","DISPLAY","XDG_SESSION_TYPE","SDL_VIDEODRIVER","SDL_VIDEO_DRIVER");let i=0;while i<h_count(keys){let key=h_at(keys,i);let value=h_getenv(key);if value{j_set(out,key,j_string(value));}i=i+1;}h_print(1,j_dump(out));h_print(1,"\n");return 0;}
