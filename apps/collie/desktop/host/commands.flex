import "login.flex";
fn sv_run_process(args,cwd,timeout){let record=sh_process(args,"",cwd,-1,-1);let proc=load64(record);let start=net_now();while load64(proc+8)==-999 || load64(proc+40)>=0{sh_process_pump(record);cn_pump();sv_poll_input();if sv_cancelled() || net_now()-start>timeout{sh_process_close(record);return sh_fail("Desktop operation cancelled or timed out");}h_sleep(2);}let status=load64(proc+8);let out=h_slice(h_out(proc),h_len(h_out(proc)));sh_process_close(record);if status==127{return sh_fail("Required desktop program is unavailable");}if status{return 0;}return out;}
fn sv_open_external(target){if h_equal(h_getenv("COLLIE_HEADLESS"),"1"){return 0;}let out=sv_run_process(h_args("xdg-open",target,0,0,0,0),0,10000);return out!=0;}
fn sv_choose(title,folder){if h_equal(h_getenv("COLLIE_HEADLESS"),"1"){return sh_fail("File dialogs are disabled during headless testing");}let zenity=h_executable("zenity");let args=h_vec();if syscall(21,zenity,1,0,0,0,0)==0{h_add(args,zenity);h_add(args,"--file-selection");h_add(args,h_cat("--title=",title));if folder{h_add(args,"--directory");}}else{let kdialog=h_executable("kdialog");if syscall(21,kdialog,1,0,0,0,0)<0{return sh_fail("Install zenity or kdialog for file selection, or use --auth PATH");}h_add(args,kdialog);let option="--getopenfilename";if folder{option="--getexistingdirectory";}h_add(args,option);h_add(args,h_getenv("HOME"));h_add(args,"--title");h_add(args,title);}let out=sv_run_process(args,0,86400000);if !out || !h_len(h_trim(out)){return 0;}return h_trim(out);}
fn sv_utf8(bytes,n){let at=0;while at<n{let c=load8(bytes+at);let count=1;let cp=c;if c>=128{if c>=194 && c<=223{count=2;cp=c&31;}else if c>=224 && c<=239{count=3;cp=c&15;}else if c>=240 && c<=244{count=4;cp=c&7;}else{return 0;}if at+count>n{return 0;}let i=1;while i<count{let next=load8(bytes+at+i);if next<128 || next>191{return 0;}cp=(cp<<6)|(next&63);i=i+1;}if (count==3 && cp<2048) || (count==4 && cp<65536) || cp>1114111 || (cp>=55296 && cp<=57343){return 0;}}if !cp{return 0;}at=at+count;}return 1;}
fn sv_attach(path){let attachments=sh_array(sv,"attachments");if j_count(attachments)>=4{return sh_fail("At most four attachments per message");}let stat=sh_stat(path,1);if !stat || (load64(stat+24)&61440)!=32768 || load64(stat+48)>2097152{return sh_fail("Choose a regular file up to 2 MiB");}let bytes=sh_read(path,2097152);if !bytes{return sh_fail("Could not read attachment");}let n=h_file_size;let name=h_slice(sh_leaf(path),h_len(sh_leaf(path)));let i=0;while load8(name+i){let c=load8(name+i);if !((c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122)||c==32||c==46||c==45||c==95||c>=128){store8(name+i,95);}i=i+1;}if i>100{i=100;while i>0 && (load8(name+i)&192)==128{i=i-1;}name=h_slice(name,i);}if !h_len(name){name="attachment";}let relative=h_cat3("attachments/",h_slice(sh_id(),12),h_cat("-",name));if !sh_write_project(sv_files(),relative,bytes,n){return 0;}let file=j_object();sh_s(file,"type","file");sh_s(file,"path",relative);sh_s(file,"name",name);sh_n(file,"file_bytes",n);sh_n(file,"bytes",n);let lower=h_slice(name,h_len(name));i=0;while load8(lower+i){let c=load8(lower+i);if c>=65 && c<=90{store8(lower+i,c+32);}i=i+1;}let len=h_len(lower);let image=(len>=4 && (h_equal(lower+len-4,".png") || h_equal(lower+len-4,".jpg"))) || (len>=5 && (h_equal(lower+len-5,".jpeg") || h_equal(lower+len-5,".webp")));if image{let preview=si_image(sv_s("root"),bytes,n,2097152);if !preview{return 0;}sh_merge(file,preview);}else{let limit=n;if limit>16384{limit=16384;}if sv_utf8(bytes,limit){sh_s(file,"text",h_slice(bytes,limit));sh_b(file,"truncated",n>limit);}}j_push(attachments,file);j_set(sv,"attachments",attachments);if !sv_save(){return 0;}return sv_facts();}
fn sv_add_project(folder){let path=sh_real(folder);if !path || !h_isdir(path){return sh_fail("Choose a project folder");}let rows=sh_array(sv,"projects");let i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(cj_text(row,"path"),path){return row;}i=i+1;}if j_count(rows)>=128{return sh_fail("Up to 128 project folders are supported");}let row=j_object();sh_s(row,"id",sh_id());let name=sh_leaf(path);if !h_len(name){name=path;}sh_s(row,"name",name);sh_s(row,"path",path);let next=j_array();i=0;while i<j_count(rows){j_push(next,j_at(rows,i));i=i+1;}j_push(next,row);if !sh_save_json(h_join(sv_s("data"),"projects.json"),next){return 0;}j_set(sv,"projects",next);return row;}
fn sv_select_project(id){if sv_task(0){return sh_fail("Stop the current reply before changing projects");}if h_len(id) && !sv_project(id){return 0;}let settings=sv_get("settings");let closed=cj_get(settings,"sidebar_closed");if !closed || j_kind(closed)!=4{closed=j_object();}sh_b(closed,id,0);j_set(settings,"sidebar_closed",closed);let target=0;let rows=sh_array(sv,"sessions");let i=0;while i<j_count(rows) && !target{let row=j_at(rows,i);if h_equal(cj_text(row,"project_id"),id){target=cj_text(row,"id");}i=i+1;}return sv_open(target,id);}
fn sv_account_idle(){if j_count(sv_tasks()){return sh_fail("Stop active replies and workers before adding or switching accounts");}if c_flag(sv_get("login_view"),"running"){return sh_fail("Finish or cancel sign-in before switching accounts");}return 1;}
fn sv_refresh_account(){if sv_n("account_metadata"){sa_refresh(0);}return sv_update(sv_account_facts());}
fn sv_unquote(text){let out=h_buffer();let i=0;while load8(text+i){let c=load8(text+i);if c==37{let a=load8(text+i+1);let b=0;if a{b=load8(text+i+2);}let digits="0123456789abcdef";let av=-1;let bv=-1;let j=0;if a>=65 && a<=70{a=a+32;}if b>=65 && b<=70{b=b+32;}while j<16{if load8(digits+j)==a{av=j;}if load8(digits+j)==b{bv=j;}j=j+1;}if av<0 || bv<0{return sh_fail("Invalid link escape");}c=av*16+bv;i=i+2;}if c<32 || c==127{return sh_fail("Invalid message link");}let p=h_take(1);store8(p,c);h_append(out,p,1);i=i+1;}return h_data(out);}
fn sv_uri(text){let out=h_buffer();let hex="0123456789ABCDEF";let i=0;while load8(text+i){let c=load8(text+i);if (c>=65 && c<=90)||(c>=97 && c<=122)||(c>=48 && c<=57)||c==47||c==45||c==95||c==46||c==126{h_append(out,text+i,1);}else{let p=h_take(3);store8(p,37);store8(p+1,load8(hex+(c>>4)));store8(p+2,load8(hex+(c&15)));h_append(out,p,3);}i=i+1;}return h_data(out);}
fn sv_open_link(href){let n=h_len(href);if !n || n>8192{return sh_fail("Invalid message link");}let i=0;while i<n{let c=load8(href+i);if c<32 || c==127{return sh_fail("Invalid message link");}i=i+1;}let target=href;if h_starts(href,"http://") || h_starts(href,"https://"){let start=7;if h_starts(href,"https://"){start=8;}if !load8(href+start) || load8(href+start)==47{return sh_fail("Invalid web link");}}else{if h_find(href,":")>=0 || h_starts(href,"//"){return sh_fail("Only web links and project files can be opened");}let at=0;while load8(href+at) && load8(href+at)!=63 && load8(href+at)!=35{at=at+1;}let relative=sv_unquote(h_slice(href,at));if !relative{return 0;}let bytes=sh_read_project(sv_files(),relative,67108864);if !bytes{return 0;}target=h_cat3("file://",sv_uri(h_join(sv_files(),relative)),href+at);}if h_equal(h_getenv("COLLIE_HEADLESS"),"1"){return sh_fail("Browser launch is disabled during headless testing");}if !sv_open_external(target){return sh_fail("Could not open the link in your browser");}return 1;}
fn sv_camera(){if h_equal(h_getenv("COLLIE_HEADLESS"),"1"){return sh_fail("Physical camera capture is disabled during headless testing");}let ffmpeg=h_executable("ffmpeg");if syscall(21,ffmpeg,1,0,0,0,0)<0{return sh_fail("Install ffmpeg to capture a camera image, or attach an existing image");}let names=sh_names("/sys/class/video4linux");let devices=j_array();let i=0;while i<j_count(names){let id=j_value(j_at(names,i));let path=h_join("/dev",id);if h_starts(id,"video") && syscall(21,path,4,0,0,0,0)==0{j_push(devices,j_string(path));}i=i+1;}if !j_count(devices){return sh_fail("No readable Linux camera device is available");}let device=j_value(j_at(devices,0));if j_count(devices)>1 && syscall(21,h_executable("zenity"),1,0,0,0,0)==0{let args=h_vec();h_add(args,"zenity");h_add(args,"--list");h_add(args,"--title=Choose a camera");h_add(args,"--column=Device");h_add(args,"--column=Camera");i=0;while i<j_count(devices){let path=j_value(j_at(devices,i));h_add(args,path);h_add(args,sp_sysfile(h_join(h_join("/sys/class/video4linux",sh_leaf(path)),"name")));i=i+1;}let selected=sv_run_process(args,0,86400000);if !selected{return 0;}selected=h_trim(selected);let found=0;i=0;while i<j_count(devices){if h_equal(selected,j_value(j_at(devices,i))){found=1;}i=i+1;}if !found{return sh_fail("Invalid camera selection");}device=selected;}let path=h_join(sv_s("root"),h_cat3("capture-",sh_id(),".jpg"));sv_update(sh_s(j_object(),"status","Capturing camera image…"));let args=h_vec();let words=j_parse("[\"-hide_banner\",\"-loglevel\",\"error\",\"-nostdin\",\"-f\",\"v4l2\",\"-i\"]");h_add(args,ffmpeg);i=0;while i<j_count(words){h_add(args,j_value(j_at(words,i)));i=i+1;}h_add(args,device);words=j_parse("[\"-frames:v\",\"1\",\"-vf\",\"scale=1536:1536:force_original_aspect_ratio=decrease\",\"-update\",\"1\"]");i=0;while i<j_count(words){h_add(args,j_value(j_at(words,i)));i=i+1;}h_add(args,path);let out=sv_run_process(args,0,12000);let ok=0;if out{ok=sv_attach(path);}else if !se{se="Camera capture failed";}syscall(87,path,0,0,0,0,0);sv_update(sh_s(j_object(),"status",""));return ok;}
fn sv_command(command){let kind=cj_text(command,"kind");
    if h_equal(kind,"submit"){let attachments=sh_array(sv,"attachments");let event=j_object();sh_s(event,"text",cj_text(command,"text"));j_set(event,"attachments",attachments);if !st_start("begin",event){sv_update(sh_s(j_object(),"draft",cj_text(command,"text")));return 0;}j_set(sv,"attachments",j_array());let data=j_object();j_set(data,"attachments",j_array());sv_update(data);}
    else if h_equal(kind,"cancel"){let fields=j_value(sv_tasks());let i=0;while i<h_count(fields){sh_b(load64(h_at(fields,i)+8),"cancelled",1);i=i+1;}sp_close(sv_s("root"),0);st_show_prompt();}
    else if h_equal(kind,"new_session"){let project=0;if cj_get(command,"project_id"){project=cj_text(command,"project_id");}sv_open(0,project);}
    else if h_equal(kind,"open_session"){if cj_get(command,"request_id"){sh_n(sv,"session_request",cj_int(command,"request_id"));}sv_open(cj_text(command,"id"),0);}
    else if h_equal(kind,"load_sessions"){sv_load_sessions(1);}
    else if h_equal(kind,"choose_project_folder"){if sv_task(0){return sh_fail("Stop the current reply before changing projects");}let path=cj_text(command,"path");if !h_len(path){path=sv_choose("Choose a project folder",1);}if path{let project=sv_add_project(path);if project{sv_select_project(cj_text(project,"id"));}}}
    else if h_equal(kind,"select_project"){sv_select_project(cj_text(command,"id"));}
    else if h_equal(kind,"load_worker"){let request=sv_request("messages");sh_n(request,"id",cj_int(command,"id"));let result=sv_call(9,-1,request);if result{let data=j_object();sh_n(data,"worker_owner",cj_int(command,"id"));j_set(data,"worker_messages",j_get(result,"messages"));sv_update(data);}}
    else if h_equal(kind,"worker_action"){let request=sv_request(cj_text(command,"action"));let id=cj_int(command,"id");sh_n(request,"id",id);if !sv_call(9,-1,request){return 0;}if h_equal(cj_text(command,"action"),"cancel") && sv_task(id){sh_b(sv_task(id),"cancelled",1);}st_schedule(0);}
    else if h_equal(kind,"permission"){let key=cj_text(command,"key");let value=cj_get(command,"allowed");if !value || !sv_permission(key,value){return 0;}if !(j_kind(value)==5 && j_value(value)){sp_close(sv_s("root"),key);let fields=j_value(sv_tasks());let i=0;while i<h_count(fields){sh_b(load64(h_at(fields,i)+8),"cancelled",1);i=i+1;}}st_show_prompt();let data=j_object();j_set(data,"policy",sv_get("permissions"));sv_update(data);st_schedule(0);}
    else if h_equal(kind,"permission_decision"){let prompts=sh_array(sv,"prompts");if !j_count(prompts) || cj_int(j_at(prompts,0),"request_id")!=cj_int(command,"request_id"){return sh_fail("Stale permission request");}let pending=j_at(prompts,0);let task=sv_task(cj_int(pending,"agent_id"));if c_flag(command,"stop"){if task{sh_b(task,"cancelled",1);}}else{if !sv_permission(cj_text(pending,"key"),j_bool(c_flag(command,"allowed"))){return 0;}}st_show_prompt();let data=j_object();j_set(data,"policy",sv_get("permissions"));sv_update(data);}
    else if h_equal(kind,"save_model"){let model=cj_text(command,"model");if !sh_valid(model,120){return sh_fail("Invalid model name");}sh_s(sv,"model",model);sv_save();sv_facts();}
    else if h_equal(kind,"save_model_network"){if !h_equal(cj_text(command,"network"),"default"){return sh_fail("Desktop uses the system default network for model requests");}sv_update(sh_s(j_object(),"model_network","default"));}
    else if h_equal(kind,"resume_main"){st_start("resume",0);}
    else if h_equal(kind,"compact"){st_start("compact",0);}
    else if h_equal(kind,"start_account_login"){let method=cj_text(command,"method");if !h_len(method){method="browser";}sl_start(method);}
    else if h_equal(kind,"cancel_account_login"){sl_cancel(1);}
    else if h_equal(kind,"open_account_login"){if !sl_browser(){se=0;let view=sv_get("login_view");sh_s(view,"message","Could not open a browser automatically. Copy the sign-in link or try device code.");let data=j_object();j_set(data,"account_login",view);sv_update(data);}}
    else if h_equal(kind,"refresh_account"){sv_refresh_account();}
    else if h_equal(kind,"import_auth"){if !sv_account_idle(){return 0;}let path=cj_text(command,"path");if !h_len(path){path=sv_choose("Add OpenAI account · Choose Codex auth.json",0);}if path{path=sh_real(path);if !path{return 0;}let auth=sh_read_json(path,j_object(),1048576);if !auth{return 0;}let request=sv_request("authenticate");j_set(request,"auth",auth);if !sv_call(8,-1,request){return 0;}if !sa_add(auth,path,0){return 0;}sh_b(sv,"account_metadata",1);sh_s(sv,"auth_file",sa_path(sa_active()));j_set(sv,"settings",sh_without(sv_get("settings"),"auth_file"));sv_save();sv_refresh_account();}}
    else if h_equal(kind,"select_account"){if !sv_account_idle(){return 0;}let id=cj_text(command,"id");if !sa_entry(id){return 0;}sa_refresh(id);let auth=sa_auth(id);if !auth{return 0;}let request=sv_request("authenticate");j_set(request,"auth",auth);if !sv_call(8,-1,request){return 0;}let registry=sh_copy(sa_registry());sh_s(registry,"active",id);if !sa_save(registry){return 0;}sh_b(sv,"account_metadata",1);sh_s(sv,"auth_file",sa_path(id));j_set(sv,"settings",sh_without(sv_get("settings"),"auth_file"));sv_save();sv_refresh_account();}
    else if h_equal(kind,"files") || h_equal(kind,"gallery"){let path=cj_text(command,"path");if !h_len(path){let title="Attach a file";if h_equal(kind,"gallery"){title="Attach an image";}path=sv_choose(title,0);}if path{sv_attach(path);}}
    else if h_equal(kind,"camera"){sv_camera();}
    else if h_equal(kind,"remove_attachment"){let index=cj_int(command,"index");let old=sh_array(sv,"attachments");if index<0 || index>=j_count(old){return sh_fail("Stale attachment");}let next=j_array();let i=0;while i<j_count(old){if i!=index{j_push(next,j_at(old,i));}i=i+1;}j_set(sv,"attachments",next);sv_save();let data=j_object();j_set(data,"attachments",next);sv_update(data);}
    else if h_equal(kind,"open_link"){sv_open_link(cj_text(command,"href"));}
    else if h_equal(kind,"read_preview"){let file=sh_copy(cj_get(command,"file"));let bytes=sh_read_project(sv_files(),cj_text(file,"path"),2097152);if !bytes{return 0;}let n=h_file_size;if h_equal(cj_text(file,"type"),"image"){let image=si_image(sv_s("root"),bytes,n,2097152);if !image{return 0;}sh_merge(file,image);sv_facts();}else{let limit=n;if limit>16384{limit=16384;}if !sv_utf8(bytes,limit){return sh_fail("Preview is not UTF-8 text");}sh_s(file,"text",h_slice(bytes,limit));sh_b(file,"truncated",n>limit);}let packet=sv_request("preview");j_set(packet,"file",file);sv_emit(packet);}
    else if h_equal(kind,"sidebar_width"){let width=cj_int(command,"width");if width<220 || width>520{return sh_fail("Invalid sidebar width");}sh_n(sv_get("settings"),"sidebar_width",width);sv_save();}
    else if h_equal(kind,"navigation"){let navigation=sh_copy(cj_get(command,"data"));let width=cj_get(navigation,"sidebar_width");if width && j_kind(width)==1{let n=j_value(width);if n<220{n=220;}if n>520{n=520;}sh_n(sv_get("settings"),"sidebar_width",n);}let mode=cj_text(navigation,"sidebar_mode");if h_equal(mode,"projects") || h_equal(mode,"timeline"){sh_s(sv_get("settings"),"sidebar_mode",mode);}let closed=cj_get(navigation,"sidebar_closed");if closed && j_kind(closed)==4{j_set(sv_get("settings"),"sidebar_closed",closed);}navigation=sh_without(navigation,"sidebar_width");navigation=sh_without(navigation,"sidebar_mode");navigation=sh_without(navigation,"sidebar_closed");j_set(sv,"navigation",navigation);sv_save();}
    else{return sh_fail("Unknown desktop effect");}return !se;
}
