import "tasks.flex";
fn sim_start(task,command){let settings=sv_get("settings");let provider=cj_text(settings,"image_provider");if !h_len(provider){provider="codex";}if !h_equal(provider,"codex"){return sh_fail("Unknown image provider");}let signal=cj_get(command,"signal");let prompt=cj_text(signal,"prompt");let path=cj_text(signal,"path");let n=h_len(path);if !h_len(h_trim(prompt)) || h_len(prompt)>16384{return sh_fail("Image prompt must be nonempty and at most 16 KiB");}if n<5 || !h_equal(path+n-4,".png") || !sh_relative(path){return sh_fail("imagen requires a project-relative .png output path");}let output=sh_parent(sv_files(),path,1);if output<0{return 0;}sh_n(task,"output_fd",output);let st=h_zero(h_take(144),144);if syscall(262,output,sh_leaf(path),st,256,0,0)==0 && (load64(st+24)&61440)!=32768{return sh_fail("Image output must be a regular file");}let options=j_object();let keys=j_parse("[\"size\",\"quality\",\"background\",\"model\"]");let defaults=j_parse("[\"1024x1024\",\"auto\",\"auto\",\"\"]");let i=0;while i<4{let key=j_value(j_at(keys,i));let value=cj_text(settings,h_cat("image_",key));if !h_len(value){value=j_value(j_at(defaults,i));}if h_len(value){sh_s(options,key,value);}i=i+1;}let identity=j_array();j_push(identity,j_string(provider));j_push(identity,j_string(prompt));j_push(identity,j_string(path));j_push(identity,options);let encoded=sh_canonical(identity);let digest=h_sha_bytes(encoded,h_len(encoded));let jobkey=h_cat3(h_int(cj_int(task,"id")),":",h_cat3(cj_text(command,"call_id"),":",h_int(cj_int(signal,"id"))));let journal=h_join(h_join(sv_s("root"),"imagegen"),h_cat(h_sha_bytes(jobkey,h_len(jobkey)),".json"));let saved=sh_read_json(journal,0,1048576);if saved{if !h_equal(cj_text(saved,"digest"),digest){return sh_fail("Image job does not match its saved request");}if h_equal(cj_text(saved,"state"),"complete"){let stat=h_zero(h_take(144),144);if syscall(262,output,sh_leaf(path),stat,256,0,0)<0 || (load64(stat+24)&61440)!=32768{return sh_fail("Generated image file no longer exists");}let event=j_object();j_set(event,"file",j_get(saved,"file"));h_close(output);sh_n(task,"output_fd",-1);st_next(task,"image_generated",event);return 1;}return sh_fail("This image request was interrupted or failed after dispatch and was not retried; make a new imagen call");}if se{return 0;}let fixtures=sh_array(sv_get("fixture"),"images");let fixtureimage=sv_n("fixture_enabled") && j_count(fixtures)>0;let transport=0;if !fixtureimage{let request=sv_request("imagegen_transport");let auth=sa_read_auth();if !auth{return 0;}j_set(request,"auth",auth);transport=sv_call(8,-1,request);if !transport{return 0;}if !h_equal(cj_text(transport,"url"),"https://chatgpt.com/backend-api/codex/images/generations"){return sh_fail("Invalid Codex image endpoint");}}let requestid=sh_id();let record=j_object();sh_s(record,"state","sent");sh_s(record,"digest",digest);sh_s(record,"request_id",requestid);if !sh_save_json(journal,record){return 0;}let body=sh_copy(options);sh_s(body,"prompt",prompt);sh_n(body,"n",1);sh_s(body,"output_format","png");if fixtureimage{let index=sv_n("image_fixture_index");if index>=j_count(fixtures){return sh_fail("Image fixture sequence is exhausted");}j_set(task,"image_fixture",j_at(fixtures,index));sh_n(sv,"image_fixture_index",index+1);}else{let headers=sh_copy(cj_get(transport,"headers"));sh_s(headers,"x-codex-imagegen-request-id",requestid);let slot=cn_start(cj_text(transport,"url"),headers,j_dump(body),16777216,240000,0);if !slot{return 0;}sh_n(task,"network_slot",slot);}sh_s(task,"stage","image");sh_s(task,"image_path",path);sh_s(task,"image_provider",provider);sh_s(task,"image_journal",journal);j_set(task,"image_record",record);return 1;}
fn sim_poll(task){let slot=cj_int(task,"network_slot");let response=cj_get(task,"image_fixture");if !response{if !slot{return sh_fail("Image response is unavailable");}if !load64(slot+32){return 0;}let error=cn_error(slot);if error{return sh_fail(error);}response=sj_parse(h_slice(load64(slot+8),load64(slot+16)));}if !response{return sh_fail("Image provider returned invalid JSON");}let rows=sh_array(response,"data");if j_count(rows)!=1 || !h_len(cj_text(j_at(rows,0),"b64_json")){return sh_fail("Image provider did not return exactly one image");}let bytes=sh_unbase64(cj_text(j_at(rows,0),"b64_json"));if !bytes{return 0;}let n=h_file_size;if n<8 || n>12582912 || load8(bytes)!=137 || !h_bytes(bytes+1,"PNG",3){return sh_fail("Provider must return a PNG up to 12 MiB");}let image=si_image(sv_s("root"),bytes,n,12582912);if !image{return 0;}sh_s(image,"path",cj_text(task,"image_path"));sh_s(image,"name",sh_leaf(cj_text(task,"image_path")));sh_n(image,"file_bytes",n);sh_s(image,"provider",cj_text(task,"image_provider"));let output=cj_int(task,"output_fd");if !sh_atomic_at(output,sh_leaf(cj_text(task,"image_path")),bytes,n){return 0;}let record=sh_copy(cj_get(task,"image_record"));sh_s(record,"state","complete");j_set(record,"file",image);if !sh_save_json(cj_text(task,"image_journal"),record){return 0;}st_dispose(task);let event=j_object();j_set(event,"file",image);st_next(task,"image_generated",event);return 1;}
