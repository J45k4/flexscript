import "network.flex";
import "images.flex";
global sp_failure_code=0;
fn sp_fail(code,message){sp_failure_code=code;return sh_fail(message);}
fn sp_error(code,message){let error=j_object();sh_s(error,"code",code);sh_s(error,"message",message);let out=j_object();j_set(out,"error",error);return out;}
fn sp_handles(){return cj_array(sv,"handles");}
fn sp_handle(root,key){let rows=sp_handles();let i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(cj_text(row,"id"),key) && h_equal(cj_text(row,"root"),root){return row;}i=i+1;}return sp_fail("stale_handle","Resource is closed or belongs to another conversation");}
fn sp_close(root,permission){let rows=sp_handles();let next=j_array();let i=0;while i<j_count(rows){let row=j_at(rows,i);if (!root || h_equal(root,cj_text(row,"root"))) && (!permission || h_equal(permission,cj_text(row,"permission"))){syscall(48,cj_int(row,"fd"),2,0,0,0,0);h_close(cj_int(row,"fd"));}else{j_push(next,row);}i=i+1;}j_set(sv,"handles",next);return 0;}
fn sp_add(root,fd,kind){if fd<0{return sh_fail("Could not open network resource");}let rows=sp_handles();if j_count(rows)>=32{h_close(fd);return sp_fail("resource_limit","At most 32 resources per conversation");}let row=j_object();sh_s(row,"id",h_cat("linux-",sh_id()));sh_s(row,"root",root);sh_s(row,"permission","network");sh_s(row,"kind",kind);sh_n(row,"fd",fd);j_push(rows,row);return j_string(cj_text(row,"id"));}
fn sp_entries(entries){let out=j_array();let generic="|internet|files_read|files_write|db_read|db_write|history|workers|network|usb|sensors|device_status|";let i=0;while i<j_count(entries){let row=sh_copy(j_at(entries,i));let key=cj_text(row,"key");if h_has(generic,h_cat3("|",key,"|")){if h_equal(key,"network"){sh_s(row,"detail","Use bounded TCP, UDP and HTTPS connections through the Linux system default route.");}if h_equal(key,"usb"){sh_s(row,"detail","Inspect Linux USB device metadata. Desktop USB transfers are not implemented yet.");}if h_equal(key,"sensors"){sh_s(row,"title","Sensors");sh_s(row,"detail","Inspect Linux IIO sensor metadata. Desktop measurement streaming is not implemented yet.");}if h_equal(key,"device_status"){sh_s(row,"title","System status");sh_s(row,"detail","Read actual Linux power-supply and thermal-zone information.");}j_push(out,row);}i=i+1;}return out;}
fn sp_integer(args,index,low,high){let value=j_at(args,index);if !value || j_kind(value)!=1 || j_value(value)<low || j_value(value)>high{sp_fail("invalid_argument","Integer argument is outside its allowed range");return low;}return j_value(value);}
fn sp_arg(args,index){let v=j_at(args,index);if !v || j_kind(v)!=2{sp_fail("invalid_argument","Text argument expected");return "";}return j_value(v);}
fn sp_network(args){if !h_equal(sp_arg(args,0),"default"){return sp_fail("unsupported_operation","Linux sockets support the system default route only");}return 1;}
fn sp_bytes(value){if value && j_kind(value)==2{h_file_size=h_len(j_value(value));return j_value(value);}let text=cj_text(value,"$bytes");if !h_len(text){h_file_size=0;return "";}return sh_unbase64(text);}
fn sp_binary(bytes,n){let out=j_object();sh_s(out,"$bytes",sh_base64(bytes,n));return out;}
fn sp_sysfile(path){let raw=sh_read(path,4096);if !raw{return "";}return h_trim(raw);}
fn sp_metadata(folder,id,fields){let row=j_object();sh_s(row,"id",id);let i=0;while i<j_count(fields){let field=j_value(j_at(fields,i));let path=h_join(folder,field);if h_exists(path){sh_s(row,field,sp_sysfile(path));}i=i+1;}return row;}
fn sp_http(url,timeout,binary){let slot=cn_start(url,0,0,32769,timeout,3);if !slot{return 0;}store64(slot+80,1);while !load64(slot+32){cn_pump();sv_poll_input();if sv_cancelled(){cn_close(slot);return sh_fail("Cancelled.");}h_sleep(2);}if load64(slot+40) && !load64(slot+88){let message=h_cat("HTTPS request failed (curl ",h_cat(h_int(load64(slot+40)),")"));cn_close(slot);return sh_fail(message);}let n=load64(slot+16);let truncated=n>32768;if truncated{n=32768;}let out=j_object();sh_n(out,"status",cn_status(slot));let effective=h_take(8);ffi_call_i32(cn_symbol("curl_easy_getinfo"),load64(slot),0x100001,effective,0,0,0);sh_s(out,"url",h_slice(load64(effective),h_len(load64(effective))));let bytes=h_slice(load64(slot+8),n);if !binary && !sv_utf8(bytes,n){cn_close(slot);return sh_fail("HTTPS body is not UTF-8 text");}if binary{j_set(out,"body",sp_binary(bytes,n));}else{sh_s(out,"body",bytes);}sh_b(out,"truncated",truncated);cn_close(slot);return out;}
fn sp_address(host,port,socktype){if !net_init(){return sh_fail("System resolver is unavailable");}let hints=h_zero(h_take(48),48);store64(hints+8,socktype);let out=h_take(8);if ffi_call_i32(net_resolve,host,h_int(port),hints,out,0,0){return sh_fail("Could not resolve host");}return load64(out);}
fn sp_wait(fd,events,milliseconds){let p=h_take(8);let end=net_now()+milliseconds;let first=1;while first || net_now()<end{first=0;let left=end-net_now();if left>20{left=20;}if left<0{left=0;}store64(p,(fd&0xffffffff)|(events<<32));if syscall(7,p,1,left,0,0,0)>0{return 1;}sv_poll_input();cn_pump();if sv_cancelled() || (!sg_ignores_cancel && sg_agent>=0 && sv_task_cancelled(sg_agent)){return 0;}}return 0;}
fn sp_connect(host,port,milliseconds){let addresses=sp_address(host,port,1);if !addresses{return -1;}let row=addresses;let connected=-1;while row && connected<0{let fd=syscall(41,load64(row)>>32,0x80801,0,0,0,0);if fd>=0{let result=syscall(42,fd,load64(row+24),load64(row+16)&0xffffffff,0,0,0);if result==-115 && sp_wait(fd,4,milliseconds){let error=h_zero(h_take(8),8);let size=h_take(8);store64(size,4);result=syscall(55,fd,1,4,error,size,0);if load64(error){result=-1;}}if !result{connected=fd;}else{h_close(fd);}}row=load64(row+40);}ffi_call(net_free_addresses,addresses,0,0,0,0,0);return connected;}
fn sp_device(root,op,args){let row=sp_handle(root,sp_arg(args,0));if !row{return 0;}let fd=cj_int(row,"fd");if h_equal(op,"device_close"){let rows=sp_handles();let next=j_array();let i=0;while i<j_count(rows){if j_at(rows,i)!=row{j_push(next,j_at(rows,i));}i=i+1;}h_close(fd);j_set(sv,"handles",next);return j_int(1);}if h_equal(op,"device_info"){let out=j_object();sh_s(out,"kind",cj_text(row,"kind"));sh_s(out,"network","default");let addr=h_take(128);let size=h_take(8);store64(size,128);if syscall(51,fd,addr,size,0,0,0)==0{let port=(load8(addr+2)<<8)|load8(addr+3);sh_n(out,"port",port);let host=h_take(256);let family=load8(addr)|(load8(addr+1)<<8);let address=addr+4;if family==10{address=addr+8;}if ffi_call(ffi_symbol(sh_libc,"inet_ntop"),family,address,host,256,0,0){sh_s(out,"local",h_cat3(host,":",h_int(port)));}}return out;}
    if h_equal(op,"device_read"){let n=sp_integer(args,1,1,32768);let ms=sp_integer(args,2,1,8000);if se{return 0;}if !sp_wait(fd,1,ms){return cj_null();}let bytes=h_take(n);let got=syscall(0,fd,bytes,n,0,0,0);if got<=0{return cj_null();}return sp_binary(bytes,got);}
    if h_equal(op,"device_write"){let bytes=sp_bytes(j_at(args,1));let n=h_file_size;if se{return 0;}if n>32768{return sp_fail("size_limit","Write exceeds 32 KiB");}if !sp_wait(fd,4,8000){return sh_fail("Network write timed out");}let sent=syscall(44,fd,bytes,n,16384,0,0);if sent<0{return sh_fail("Network write failed");}return j_int(sent);}
    if h_equal(op,"device_wait"){let ms=sp_integer(args,1,0,1000);if se{return 0;}if !sp_wait(fd,1,ms){return cj_null();}return sh_s(j_object(),"type","readable");}return sp_fail("unsupported_operation","Unknown resource operation");
}
fn sp_hardware(root,op,args){
    if h_equal(op,"hardware_access_info") || h_equal(op,"hardware_capabilities"){let names=j_parse("[\"net_list\",\"net_info\",\"net_resolve\",\"net_tcp_connect\",\"net_tcp_open\",\"net_tcp_dial\",\"net_tcp_listen\",\"net_tcp_accept\",\"net_udp_open\",\"net_udp_send\",\"net_udp_receive\",\"net_http\",\"battery_info\",\"thermal_info\",\"sensor_list\",\"sensor_info\",\"usb_list\",\"usb_info\",\"device_read\",\"device_write\",\"device_info\",\"device_wait\",\"device_close\"]");if h_equal(op,"hardware_access_info"){let info=j_object();sh_s(info,"platform","linux");sh_n(info,"uid",syscall(102,0,0,0,0,0,0));sh_s(info,"device_access","normal user permissions");sh_b(info,"privileged_adapter",0);j_set(info,"implemented_operations",names);return info;}let rows=j_array();let i=0;while i<j_count(names){let name=j_value(j_at(names,i));let row=j_object();sh_s(row,"id",name);sh_b(row,"implemented",1);sh_b(row,"supported",1);sh_b(row,"available",1);let grant="network";if h_starts(name,"usb_"){grant="usb";}if h_starts(name,"sensor_"){grant="sensors";}if h_equal(name,"battery_info") || h_equal(name,"thermal_info"){grant="device_status";}sh_s(row,"permission",grant);j_push(rows,row);i=i+1;}return rows;}
    if h_starts(op,"device_"){return sp_device(root,op,args);}
    if h_equal(op,"net_list"){let row=j_object();sh_s(row,"id","default");sh_s(row,"transport","system");j_set(row,"interfaces",sh_names("/sys/class/net"));let out=j_array();j_push(out,row);return out;}
    if h_equal(op,"net_info"){if !sp_network(args){return 0;}let out=j_object();sh_s(out,"id","default");sh_s(out,"transport","system");sh_b(out,"bound",0);return out;}
    if h_equal(op,"net_http"){if !sp_network(args){return 0;}let ms=sp_integer(args,2,1,8000);if se{return 0;}return sp_http(sp_arg(args,1),ms,1);}
    if h_equal(op,"net_resolve"){if !sp_network(args){return 0;}let addresses=sp_address(sp_arg(args,1),0,1);if !addresses{return 0;}let out=j_array();let row=addresses;while row && j_count(out)<32{let family=load64(row)>>32;let address=load64(row+24)+4;if family==10{address=load64(row+24)+8;}let host=h_take(256);if ffi_call(ffi_symbol(net_libc,"inet_ntop"),family,address,host,256,0,0){let duplicate=0;let i=0;while i<j_count(out){if h_equal(j_value(j_at(out,i)),host){duplicate=1;}i=i+1;}if !duplicate{j_push(out,j_string(host));}}row=load64(row+40);}ffi_call(net_free_addresses,addresses,0,0,0,0,0);return out;}
    if h_equal(op,"net_tcp_connect"){if !sp_network(args){return 0;}let host=sp_arg(args,1);let port=sp_integer(args,2,1,65535);let ms=sp_integer(args,3,1,8000);if se{return 0;}return sp_add(root,sp_connect(host,port,ms),"tcp");}
    if h_equal(op,"net_tcp_open"){if !sp_network(args){return 0;}return sp_add(root,syscall(41,2,0x80801,0,0,0,0),"tcp");}
    if h_equal(op,"net_tcp_dial"){let row=sp_handle(root,sp_arg(args,0));let host=sp_arg(args,1);let port=sp_integer(args,2,1,65535);let ms=sp_integer(args,3,1,8000);if !row || se{return 0;}let addresses=sp_address(host,port,1);if !addresses{return 0;}let fd=cj_int(row,"fd");let code=syscall(42,fd,load64(addresses+24),load64(addresses+16)&0xffffffff,0,0,0);ffi_call(net_free_addresses,addresses,0,0,0,0,0);if code==-115 && sp_wait(fd,4,ms){let err=h_zero(h_take(8),8);let size=h_take(8);store64(size,4);code=syscall(55,fd,1,4,err,size,0);if load64(err){code=-1;}}if code{return sh_fail("Network connection failed");}return j_int(1);}
    if h_equal(op,"net_tcp_listen"){if !sp_network(args){return 0;}let port=sp_integer(args,1,0,65535);let backlog=sp_integer(args,2,1,32);if se{return 0;}return sp_add(root,tcp_listen("0.0.0.0",h_int(port),backlog),"tcp_listener");}
    if h_equal(op,"net_tcp_accept"){let row=sp_handle(root,sp_arg(args,0));let ms=sp_integer(args,1,1,8000);if !row || se{return 0;}let listener=cj_int(row,"fd");if !sp_wait(listener,1,ms){return cj_null();}let fd=syscall(288,listener,0,0,0x80800,0,0);if fd<0{return cj_null();}return sp_add(root,fd,"tcp");}
    if h_equal(op,"net_udp_open"){if !sp_network(args){return 0;}let port=sp_integer(args,1,0,65535);if se{return 0;}let fd=syscall(41,2,0x80802,0,0,0,0);let addr=h_zero(h_take(16),16);store8(addr,2);store8(addr+2,port>>8);store8(addr+3,port&255);if fd<0 || syscall(49,fd,addr,16,0,0,0)<0{h_close(fd);return sh_fail("Could not bind UDP socket");}return sp_add(root,fd,"udp");}
    if h_equal(op,"net_udp_send"){let row=sp_handle(root,sp_arg(args,0));let host=sp_arg(args,1);let port=sp_integer(args,2,1,65535);let bytes=sp_bytes(j_at(args,3));let n=h_file_size;if !row || se{return 0;}if n>32768{return sp_fail("size_limit","Datagram exceeds 32 KiB");}let addresses=sp_address(host,port,2);if !addresses{return 0;}let sent=syscall(44,cj_int(row,"fd"),bytes,n,16384,load64(addresses+24),load64(addresses+16)&0xffffffff);ffi_call(net_free_addresses,addresses,0,0,0,0,0);if sent<0{return sh_fail("UDP send failed");}return j_int(sent);}
    if h_equal(op,"net_udp_receive"){let row=sp_handle(root,sp_arg(args,0));let n=sp_integer(args,1,1,32768);let ms=sp_integer(args,2,1,8000);if !row || se{return 0;}let fd=cj_int(row,"fd");if !sp_wait(fd,1,ms){return cj_null();}let bytes=h_take(n);let address=h_take(128);let length=h_take(8);store64(length,128);let got=syscall(45,fd,bytes,n,0,address,length);if got<0{return cj_null();}let out=j_object();j_set(out,"data",sp_binary(bytes,got));let host=h_take(256);ffi_call(ffi_symbol(sh_libc,"inet_ntop"),2,address+4,host,256,0,0);sh_s(out,"host",host);sh_n(out,"port",(load8(address+2)<<8)|load8(address+3));return out;}
    if h_equal(op,"battery_info"){let rows=j_array();let names=sh_names("/sys/class/power_supply");let i=0;while i<j_count(names) && i<16{let id=j_value(j_at(names,i));j_push(rows,sp_metadata(h_join("/sys/class/power_supply",id),id,j_parse("[\"type\",\"status\",\"capacity\",\"online\",\"voltage_now\",\"current_now\",\"energy_now\",\"energy_full\"]")));i=i+1;}let out=j_object();j_set(out,"supplies",rows);sh_b(out,"present",j_count(rows)>0);return out;}
    if h_equal(op,"thermal_info"){let rows=j_array();let names=sh_names("/sys/class/thermal");let i=0;while i<j_count(names) && j_count(rows)<32{let id=j_value(j_at(names,i));if h_starts(id,"thermal_zone"){let path=h_join("/sys/class/thermal",id);let row=j_object();sh_s(row,"id",id);sh_s(row,"type",sp_sysfile(h_join(path,"type")));let raw=sp_sysfile(h_join(path,"temp"));let temp=0;if h_len(raw){if load8(raw)==45{temp=-h_number(raw+1);}else{temp=h_number(raw);}}sh_n(row,"temperature_millicelsius",temp);j_push(rows,row);}i=i+1;}let out=j_object();j_set(out,"zones",rows);return out;}
    if h_equal(op,"sensor_list"){let rows=j_array();let names=sh_names("/sys/bus/iio/devices");let i=0;while i<j_count(names) && j_count(rows)<32{let id=j_value(j_at(names,i));if h_starts(id,"iio:device"){j_push(rows,sp_metadata(h_join("/sys/bus/iio/devices",id),id,j_parse("[\"name\"]")));}i=i+1;}let out=j_object();j_set(out,"sensors",rows);sh_n(out,"total",j_count(rows));sh_n(out,"next",-1);return out;}
    if h_equal(op,"sensor_info"){let id=sp_arg(args,0);if !h_starts(id,"iio:device") || !sh_valid(id+10,20){return sh_fail("Invalid IIO sensor ID");}return sp_metadata(h_join("/sys/bus/iio/devices",id),id,j_parse("[\"name\"]"));}
    if h_equal(op,"usb_list"){let offset=sp_integer(args,0,0,65535);let limit=sp_integer(args,1,1,32);if se{return 0;}let all=j_array();let names=sh_names("/sys/bus/usb/devices");let i=0;while i<j_count(names){let id=j_value(j_at(names,i));let path=h_join("/sys/bus/usb/devices",id);if h_exists(h_join(path,"idVendor")){j_push(all,sp_metadata(path,id,j_parse("[\"idVendor\",\"idProduct\",\"manufacturer\",\"product\",\"serial\",\"busnum\",\"devnum\"]")));}i=i+1;}let rows=j_array();i=offset;while i<j_count(all) && i<offset+limit{j_push(rows,j_at(all,i));i=i+1;}let out=j_object();j_set(out,"devices",rows);sh_n(out,"total",j_count(all));let next=-1;if i<j_count(all){next=i;}sh_n(out,"next",next);return out;}
    if h_equal(op,"usb_info"){let id=sp_arg(args,0);if !sh_valid(id,64){return sh_fail("Invalid USB device ID");}return sp_metadata(h_join("/sys/bus/usb/devices",id),id,j_parse("[\"idVendor\",\"idProduct\",\"manufacturer\",\"product\",\"serial\",\"busnum\",\"devnum\"]"));}
    return sp_fail("unsupported_operation","This operation has no Linux desktop adapter");
}
fn sp_call(root,name,bytes,n){
    if h_equal(name,"vmHttpGet"){return sp_http(h_slice(bytes,n),8000,0);}
    if h_equal(name,"vmViewImage"){return si_image(root,bytes,n,2097152);}
    if h_equal(name,"vmImageBytes"){let key=h_slice(bytes,n);if n!=64 || !sh_valid(key,64){return sh_fail("Invalid image ID");}let raw=sh_read(h_join(h_join(root,"images"),h_cat(key,".jpg")),2097152);return raw;}
    if !h_equal(name,"vmHardware"){return sh_fail("Unknown platform operation");}sp_failure_code=0;let packet=sj_parse(h_slice(bytes,n));if !packet || j_kind(packet)!=4{return sp_error("invalid_argument","Invalid platform request");}let args=sh_array(packet,"args");let value=0;if h_equal(cj_text(packet,"phase"),"permission"){let row=sp_handle(root,sp_arg(args,0));if row{value=j_object();sh_s(value,"permission",cj_text(row,"permission"));sh_s(value,"also","");}}else{value=sp_hardware(root,cj_text(packet,"operation"),args);}if se{let message=se;se=0;let code=sp_failure_code;if !code{code="platform_error";}sp_failure_code=0;return sp_error(code,message);}let out=j_object();j_set(out,"value",value);return out;
}
