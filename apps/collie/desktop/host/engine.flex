import "platform.flex";
global sg_agent=-1;global sg_ignores_cancel=0;
fn sg_call(op,request,root){
    let binary=cj_text(sv,"engine");let channel=-1;let child=-1;let workspace=-1;let record=0;let env=h_env;
    if op==11{record=sh_process(h_args(h_join(h_dir(binary),"ui-host"),0,0,0,0,0),j_dump(request),0,-1,-1);}
    else{let pair=h_take(8);if syscall(53,1,0x80001,0,pair,0,0)<0{return sh_fail("Cannot open engine platform channel");}channel=load64(pair)&0xffffffff;child=load64(pair)>>32;syscall(72,channel,4,2048,0,0,0);h_setenv("COLLIE_PLATFORM_FD",h_int(child));let directory=cj_text(cj_get(request,"config"),"files_directory");h_setenv("COLLIE_WORKSPACE_FD",0);if h_len(directory){workspace=syscall(2,directory,0xb0000,0,0,0,0);h_setenv("COLLIE_WORKSPACE_FD",h_int(workspace));}record=sh_process(h_args(binary,h_int(op),root,h_join(h_dir(binary),"broker.so"),0,0),j_dump(request),0,child,workspace);h_env=env;h_close(child);h_close(workspace);}
    let proc=load64(record);let buffer=h_buffer();let scratch=h_take(65536);let start=net_now();let done=0;let result=0;
    while !done{sh_process_pump(record);if channel>=0{let n=syscall(0,channel,scratch,65536,0,0,0);while n>0{if h_size(buffer)+n>2097270{se="Invalid platform frame";done=1;n=0;}else{h_append(buffer,scratch,n);n=syscall(0,channel,scratch,65536,0,0,0);}}
            let more=1;while more && h_size(buffer)>=16{let raw=h_data(buffer);let names=load64(raw);let size=load64(raw+8);if names<=0 || names>=100 || size<0 || size>2097152{se="Invalid platform frame";done=1;more=0;}else if h_size(buffer)<16+names+size{more=0;}else{let name=h_slice(raw+16,names);let response=sp_call(root,name,raw+16+names,size);let wire=0;let bytes=0;if h_equal(name,"vmImageBytes") && response && !se{wire=response;bytes=h_file_size;}else{if se{let error=sh_s(j_object(),"error",se);response=error;se=0;}wire=j_dump(response);bytes=h_len(wire);}if bytes>2097152{wire="{\"error\":\"Platform response exceeds limit\"}";bytes=h_len(wire);}let header=h_take(8);store64(header,bytes);let outgoing=h_buffer();h_append(outgoing,header,8);h_append(outgoing,wire,bytes);let sent=0;while sent<h_size(outgoing){let n=syscall(44,channel,h_data(outgoing)+sent,h_size(outgoing)-sent,16384,0,0);if n>0{sent=sent+n;}else if n==-11{sp_wait(channel,4,100);}else if n!=-4{done=1;sent=h_size(outgoing);}}let rest=h_slice(raw+16+names+size,h_size(buffer)-16-names-size);let count=h_size(buffer)-16-names-size;buffer=h_buffer();h_append(buffer,rest,count);}}
        }
        if load64(proc+8)!=-999 && load64(proc+40)<0{done=1;if load64(proc+8){if !se{se="Native engine operation failed";}}else{let text=h_out(proc);if h_len(text)>8388608{se="Engine response exceeds 8 MiB";}else{result=sj_parse(h_slice(text,h_len(text)));if cj_get(result,"error"){se=cj_text(result,"error");result=0;}}}}
        sv_poll_input();if (!sg_ignores_cancel && (sv_cancelled() || (sg_agent>=0 && sv_task_cancelled(sg_agent)))) || (sv_n("shutdown_at") && net_now()>=sv_n("shutdown_at")){se="Cancelled.";done=1;result=0;}if net_now()-start>40000{se="Native engine operation timed out";done=1;result=0;}if !done{cn_pump();h_sleep(1);}
    }h_close(channel);sh_process_close(record);return result;
}
