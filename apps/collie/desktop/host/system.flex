// Native desktop services. All application policy and I/O orchestration is Flexscript.
import "json.flex";
global sv=0;
global se=0;
global sh_libc=0;
global sh_process_scratch=0;global sh_process_status=0;
fn sh_fail(message){se=message;return 0;}
fn sh_s(o,key,value){j_set(o,key,j_string(value));return o;}
fn sh_n(o,key,value){j_set(o,key,j_int(value));return o;}
fn sh_b(o,key,value){j_set(o,key,j_bool(value));return o;}
fn sh_merge(o,patch){if patch && j_kind(patch)==4{let fields=j_value(patch);let i=0;while i<h_count(fields){let pair=h_at(fields,i);j_set(o,load64(pair),load64(pair+8));i=i+1;}}return o;}
fn sh_copy(o){return sh_merge(j_object(),o);}
fn sh_without(o,key){let out=j_object();let fields=j_value(o);let i=0;while i<h_count(fields){let p=h_at(fields,i);if !h_equal(load64(p),key){j_set(out,load64(p),load64(p+8));}i=i+1;}return out;}
fn sh_array(o,key){let a=cj_get(o,key);if a && j_kind(a)==3{return a;}return j_array();}
fn sh_id(){let bytes=h_take(16);h_assert(syscall(318,bytes,16,0,0,0,0)==16,"getrandom failed");return h_hex(bytes,16);}
fn sh_valid(text,limit){let n=h_len(text);if !n || n>limit{return 0;}let i=0;while i<n{let c=load8(text+i);if !((c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122)||c==45||c==95||c==46){return 0;}i=i+1;}return !h_equal(text,".") && !h_equal(text,"..");}
fn sh_clock(){let ts=h_take(16);syscall(228,0,ts,0,0,0,0);return load64(ts)*1000+load64(ts+8)/1000000;}
fn sh_stat(path,follow){let st=h_zero(h_take(144),144);let op=6;if follow{op=4;}if syscall(op,path,st,0,0,0,0)<0{return 0;}return st;}
fn sh_real(path){let out=h_take(4096);if !sh_libc{sh_libc=ffi_open("libc.so.6");}if !ffi_call(ffi_symbol(sh_libc,"realpath"),path,out,0,0,0,0){return sh_fail("Folder or file is unavailable");}return out;}
fn sh_read(path,limit){let fd=syscall(2,path,0x80000,0,0,0,0);if fd<0{return 0;}let out=h_buffer();let scratch=h_take(65536);let more=1;while more{let n=syscall(0,fd,scratch,65536,0,0,0);if n>0{if h_size(out)+n>limit{h_close(fd);return sh_fail("File exceeds its size limit");}h_append(out,scratch,n);}else if n!=-4{more=0;if n<0{h_close(fd);return sh_fail("Could not read file");}}}h_close(fd);h_file_size=h_size(out);return h_data(out);}
fn sh_read_json(path,fallback,limit){let raw=sh_read(path,limit);if !raw{return fallback;}let value=sj_parse(raw);if !value{return sh_fail("Invalid saved JSON file");}return value;}
fn sh_names(path){let out=j_array();let fd=syscall(2,path,0x90000,0,0,0,0);if fd<0{return out;}let buffer=h_take(32768);let n=syscall(217,fd,buffer,32768,0,0,0);while n>0{let at=0;while at<n{let size=load8(buffer+at+16)|(load8(buffer+at+17)<<8);if size<20 || at+size>n{h_close(fd);return out;}let name=buffer+at+19;if !h_equal(name,".") && !h_equal(name,".."){j_push(out,j_string(h_slice(name,h_len(name))));}at=at+size;}n=syscall(217,fd,buffer,32768,0,0,0);}h_close(fd);return out;}
fn sh_atomic_at(dir,leaf,bytes,n){let temp=h_cat(".collie-",sh_id());let fd=syscall(257,dir,temp,0xa00c1,384,0,0);if fd<0{return sh_fail("Cannot create private temporary file");}let ok=h_write(fd,bytes,n)==n && syscall(74,fd,0,0,0,0,0)==0;h_close(fd);if ok{ok=syscall(264,dir,temp,dir,leaf,0,0)==0 && syscall(74,dir,0,0,0,0,0)==0;}syscall(263,dir,temp,0,0,0,0);if !ok{return sh_fail("Cannot save file atomically");}return 1;}
fn sh_atomic(path,bytes,n){h_mkdir(h_dir(path));let fd=syscall(2,h_dir(path),0xb0000,0,0,0,0);if fd<0{return sh_fail("Private storage directory is unavailable");}let ok=sh_atomic_at(fd,path+h_len(h_dir(path))+1,bytes,n);h_close(fd);return ok;}
fn sh_save_json(path,value){let encoded=j_dump(value);return sh_atomic(path,encoded,h_len(encoded));}
fn sh_relative(path){let n=h_len(path);if !n || n>1024 || load8(path)==47{return 0;}let start=0;let i=0;while i<=n{let c=load8(path+i);if c==92 || (c && c<32){return 0;}if !c || c==47{let len=i-start;if !len || len>255 || (len==1 && load8(path+start)==46) || (len==2 && load8(path+start)==46 && load8(path+start+1)==46){return 0;}start=i+1;}i=i+1;}return 1;}
fn sh_parent(root,relative,create){if !sh_relative(relative){sh_fail("File path must stay inside the project folder");return -1;}let fd=syscall(2,root,0xb0000,0,0,0,0);if fd<0{sh_fail("Project folder is unavailable");return -1;}let at=0;let start=0;while load8(relative+at){if load8(relative+at)==47{let part=h_slice(relative+start,at-start);if create{let r=syscall(258,fd,part,448,0,0,0);if r<0 && r!=-17{h_close(fd);sh_fail("Cannot create output folder");return -1;}}let next=syscall(257,fd,part,0xb0000,0,0,0);h_close(fd);if next<0{sh_fail("Project path contains an unavailable or symbolic-link folder");return -1;}fd=next;start=at+1;}at=at+1;}return fd;}
fn sh_leaf(path){let at=h_len(path);while at>0 && load8(path+at-1)!=47{at=at-1;}return path+at;}
fn sh_write_project(root,path,bytes,n){let fd=sh_parent(root,path,1);if fd<0{return 0;}let st=h_zero(h_take(144),144);let r=syscall(262,fd,sh_leaf(path),st,256,0,0);if r==0 && (load64(st+24)&61440)!=32768{h_close(fd);return sh_fail("Output must be a regular file");}let ok=sh_atomic_at(fd,sh_leaf(path),bytes,n);h_close(fd);return ok;}
fn sh_read_project(root,path,limit){let fd=sh_parent(root,path,0);if fd<0{return 0;}let file=syscall(257,fd,sh_leaf(path),0xa0000,0,0,0);h_close(fd);if file<0{return sh_fail("Project file is unavailable");}let st=h_take(144);if syscall(5,file,st,0,0,0,0)<0 || (load64(st+24)&61440)!=32768 || load64(st+48)>limit{h_close(file);return sh_fail("Choose a regular file within the size limit");}let n=load64(st+48);let out=h_take(n+1);let got=sh_read_exact(file,out,n);h_close(file);if got!=n{return sh_fail("Project file read failed");}store8(out+n,0);h_file_size=n;return out;}
// Each subprocess owns an arena independent of service state/frame compaction.
fn sh_process(args,input,cwd,fd1,fd2){let old=h_blocks;let used=h_used;let cap=h_capacity;let env=h_env;h_blocks=0;h_used=0;h_capacity=0;let localargs=h_vec();let i=0;while i<h_count(args){h_add(localargs,h_slice(h_at(args,i),h_len(h_at(args,i))));i=i+1;}if input{input=h_slice(input,h_len(input));}h_inherit_fd=fd1;h_inherit_fd2=fd2;let proc=h_spawn(localargs,input,cwd);h_inherit_fd=-1;h_inherit_fd2=-1;let record=h_take(32);store64(record,proc);store64(record+8,h_blocks);store64(record+16,h_used);store64(record+24,h_capacity);h_blocks=old;h_used=used;h_capacity=cap;h_env=env;return record;}
fn sh_process_io(proc){if !sh_process_scratch{sh_process_scratch=alloc(8192);sh_process_status=alloc(8);}if load64(proc+8)==-999 && syscall(61,load64(proc),sh_process_status,1,0,0,0)==load64(proc){let status=load64(sh_process_status)&65535;let code=(status>>8)&255;if status&127{code=-(status&127);}store64(proc+8,code);}let i=0;while i<2{let fd=load64(proc+40+i*8);if fd>=0{let more=1;while more{let n=syscall(0,fd,sh_process_scratch,8192,0,0,0);if n>0{let buffer=load64(proc+16+i*8);if h_size(buffer)+n>33554432{h_stop(proc);return sh_fail("Child output exceeds its limit");}h_append(buffer,sh_process_scratch,n);}else if n!=-4{more=0;if n==0 || n==-5{h_close(fd);store64(proc+40+i*8,-1);}}}}i=i+1;}let fd=load64(proc+32);if fd>=0 && load64(proc+56){let left=load64(proc+64)-load64(proc+72);if left>0{let n=syscall(1,fd,load64(proc+56)+load64(proc+72),left,0,0,0);if n>0{store64(proc+72,load64(proc+72)+n);}else if n!=-11 && n!=-4{h_close(fd);store64(proc+32,-1);}}if load64(proc+32)>=0 && load64(proc+72)==load64(proc+64){h_close(fd);store64(proc+32,-1);}}return load64(proc+8)!=-999;}
fn sh_process_pump(record){let old=h_blocks;let used=h_used;let cap=h_capacity;h_blocks=load64(record+8);h_used=load64(record+16);h_capacity=load64(record+24);let done=sh_process_io(load64(record));store64(record+8,h_blocks);store64(record+16,h_used);store64(record+24,h_capacity);h_blocks=old;h_used=used;h_capacity=cap;return done;}
fn sh_process_close(record){if !record{return 0;}let old=h_blocks;let used=h_used;let cap=h_capacity;h_blocks=load64(record+8);h_used=load64(record+16);h_capacity=load64(record+24);h_stop(load64(record));h_reset(0);h_blocks=old;h_used=used;h_capacity=cap;return 0;}
fn sh_base64_digit(c){if c>=65 && c<=90{return c-65;}if c>=97 && c<=122{return c-71;}if c>=48 && c<=57{return c+4;}if c==43 || c==45{return 62;}if c==47 || c==95{return 63;}return -1;}
fn sh_unbase64(text){let n=h_len(text);let out=h_take(n*3/4+4);let bits=0;let value=0;let size=0;let i=0;while i<n && load8(text+i)!=61{let d=sh_base64_digit(load8(text+i));if d<0{return sh_fail("Invalid base64 image or token");}value=(value<<6)|d;bits=bits+6;if bits>=8{bits=bits-8;store8(out+size,(value>>bits)&255);size=size+1;}i=i+1;}store8(out+size,0);h_file_size=size;return out;}
fn sh_base64(bytes,n){let alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";let out=h_take((n+2)/3*4+1);let i=0;let at=0;while i<n{let count=n-i;let v=load8(bytes+i)<<16;if count>1{v=v|(load8(bytes+i+1)<<8);}if count>2{v=v|load8(bytes+i+2);}store8(out+at,load8(alphabet+((v>>18)&63)));store8(out+at+1,load8(alphabet+((v>>12)&63)));let c=61;if count>1{c=load8(alphabet+((v>>6)&63));}store8(out+at+2,c);c=61;if count>2{c=load8(alphabet+(v&63));}store8(out+at+3,c);i=i+3;at=at+4;}store8(out+at,0);return out;}

fn sh_read_exact(fd,out,n){let at=0;while at<n{let got=syscall(0,fd,out+at,n-at,0,0,0);if got>0{at=at+got;}else if got!=-4{return -1;}}return at;}
// Preserve hashes of image journals written by earlier desktop builds.
fn sh_less(a,b){let i=0;while load8(a+i) && load8(a+i)==load8(b+i){i=i+1;}return load8(a+i)<load8(b+i);}
fn sh_u16(n){let hex="0123456789abcdef";let out=h_take(7);store8(out,92);store8(out+1,117);let i=0;while i<4{store8(out+2+i,load8(hex+((n>>(12-i*4))&15)));i=i+1;}store8(out+6,0);return out;}
fn sh_ascii_quote(text){let out=h_buffer();h_text(out,"\"");let i=0;while load8(text+i){let c=load8(text+i);if c<128{if c==34 || c==92{h_text(out,"\\");h_append(out,text+i,1);}else if c==8{h_text(out,"\\b");}else if c==12{h_text(out,"\\f");}else if c==10{h_text(out,"\\n");}else if c==13{h_text(out,"\\r");}else if c==9{h_text(out,"\\t");}else if c<32{h_text(out,sh_u16(c));}else{h_append(out,text+i,1);}i=i+1;}else{let count=2;let cp=c&31;if c>=240{count=4;cp=c&7;}else if c>=224{count=3;cp=c&15;}let at=1;while at<count{cp=(cp<<6)|(load8(text+i+at)&63);at=at+1;}if cp>65535{cp=cp-65536;h_text(out,sh_u16(55296+(cp>>10)));h_text(out,sh_u16(56320+(cp&1023)));}else{h_text(out,sh_u16(cp));}i=i+count;}}h_text(out,"\"");return h_data(out);}
fn sh_canonical(value){let kind=j_kind(value);if kind==2{return sh_ascii_quote(j_value(value));}if kind!=3 && kind!=4{return j_dump(value);}let out=h_buffer();let count=j_count(value);let i=0;if kind==3{h_text(out,"[");while i<count{if i{h_text(out,", ");}h_text(out,sh_canonical(j_at(value,i)));i=i+1;}h_text(out,"]");}else{h_text(out,"{");let previous=0;let fields=j_value(value);while i<count{let smallest=0;let at=0;while at<count{let pair=h_at(fields,at);let key=load64(pair);if (!previous || sh_less(previous,key)) && (!smallest || sh_less(key,load64(smallest))){smallest=pair;}at=at+1;}if i{h_text(out,", ");}h_text(out,sh_ascii_quote(load64(smallest)));h_text(out,": ");h_text(out,sh_canonical(load64(smallest+8)));previous=load64(smallest);i=i+1;}h_text(out,"}");}return h_data(out);}
