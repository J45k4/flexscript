import "system.flex";
fn sa_text(value,limit){if !value || j_kind(value)!=2 || h_len(j_value(value))>limit{return "";}let source=j_value(value);let out=h_buffer();let i=0;while load8(source+i){let c=load8(source+i);if c>=32 && c!=127{h_append(out,source+i,1);}i=i+1;}return h_trim(h_data(out));}
fn sa_claims(token){let n=h_len(token);if n>65536{return j_object();}let start=h_find(token,".");if start<0{return j_object();}let end=h_find(token+start+1,".");if end<0 || h_find(token+start+end+2,".")>=0{return j_object();}let encoded=h_slice(token+start+1,end);let raw=sh_unbase64(encoded);if !raw{se=0;return j_object();}let parsed=sj_parse(raw);if !parsed || j_kind(parsed)!=4{return j_object();}return parsed;}
fn sa_details(auth){let out=j_object();if !h_equal(cj_text(auth,"auth_mode"),"chatgpt"){return out;}let tokens=cj_get(auth,"tokens");if !h_len(cj_text(tokens,"access_token")){return out;}let access=sa_claims(cj_text(tokens,"access_token"));let identity=sa_claims(cj_text(tokens,"id_token"));let profile=cj_get(access,"https://api.openai.com/profile");let name=sa_text(cj_get(profile,"name"),160);if !h_len(name){name=sa_text(cj_get(identity,"name"),160);}let email=sa_text(cj_get(profile,"email"),254);if !h_len(email){email=sa_text(cj_get(identity,"email"),254);}let account=sa_text(cj_get(tokens,"account_id"),256);if h_len(name){sh_s(out,"name",name);}if h_len(email){sh_s(out,"email",email);}if h_len(account){sh_s(out,"account_id",account);}let i=0;while i<2{let claims=access;if i{claims=identity;}let extra=cj_get(claims,"https://api.openai.com/auth");if h_equal(cj_text(extra,"chatgpt_account_id"),account){let plan=sa_text(cj_get(extra,"chatgpt_plan_type"),64);if h_len(plan){let p=h_slice(plan,h_len(plan));let at=0;let capital=1;while load8(p+at){let c=load8(p+at);if c==95{c=32;}else if capital && c>=97 && c<=122{c=c-32;}store8(p+at,c);capital=c==32;at=at+1;}sh_s(out,"plan",p);i=2;}}i=i+1;}return out;}
fn sa_key(auth){if !h_equal(cj_text(auth,"auth_mode"),"chatgpt"){return sh_fail("Choose a ChatGPT Codex login");}let tokens=cj_get(auth,"tokens");let account=cj_text(tokens,"account_id");let token=cj_text(tokens,"access_token");if !h_len(account) || h_len(account)>256 || !h_len(token) || h_len(token)>65536{return sh_fail("Login is missing a valid access token or account ID");}let both=h_cat(account,token);let i=0;while load8(both+i){let c=load8(both+i);if c<33 || c>126{return sh_fail("Login contains invalid token or account ID fields");}i=i+1;}let access=sa_claims(token);let identity=sa_claims(cj_text(tokens,"id_token"));let user=cj_text(cj_get(access,"https://api.openai.com/auth"),"chatgpt_user_id");if !h_len(user){user=cj_text(access,"sub");}if !h_len(user){user=cj_text(identity,"sub");}if !h_len(user){user=cj_text(sa_details(auth),"email");let lower=h_slice(user,h_len(user));i=0;while load8(lower+i){let c=load8(lower+i);if c>=65 && c<=90{store8(lower+i,c+32);}i=i+1;}user=lower;}if !h_len(user){user=h_sha_bytes(token,h_len(token));}let raw=h_buffer();h_append(raw,account,h_len(account)+1);h_text(raw,user);return h_sha_bytes(h_data(raw),h_size(raw));}
fn sa_registry(){return cj_get(sv,"accounts_registry");}
fn sa_rows(){return sh_array(sa_registry(),"entries");}
fn sa_active(){return cj_text(sa_registry(),"active");}
fn sa_entry(id){let rows=sa_rows();let i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(id,cj_text(row,"id")){return row;}i=i+1;}return sh_fail("Saved account no longer exists");}
fn sa_path(id){return h_join(h_join(cj_text(sv,"data"),"accounts"),h_cat(id,".json"));}
fn sa_save(registry){if !sh_save_json(h_join(cj_text(sv,"data"),"accounts.json"),registry){return 0;}j_set(sv,"accounts_registry",registry);return 1;}
fn sa_auth(id){let row=sa_entry(id);if !row{return 0;}let auth=sh_read_json(sa_path(id),j_object(),1048576);if !auth{return 0;}let key=sa_key(auth);if !key || !h_equal(key,cj_text(row,"key")){return sh_fail("Saved login does not match this account; import it again");}return auth;}
fn sa_refresh(id){let rows=sa_rows();let i=0;while i<j_count(rows){let row=j_at(rows,i);let source=cj_text(row,"source");if (!id || h_equal(cj_text(row,"id"),id)) && h_len(source){let st=sh_stat(source,1);if st && load64(st+48)<=1048576{let stamp=h_cat3(h_int(load64(st+48)),":",h_cat3(h_int(load64(st+88)),":",h_cat3(h_int(load64(st+96)),":",h_int(load64(st+8)))));let cache=cj_array(sv,"auth_stamps");let key=h_cat(cj_text(row,"id"),source);let seen=0;let at=0;while at<j_count(cache){let saved=j_at(cache,at);if h_equal(cj_text(saved,"key"),key) && h_equal(cj_text(saved,"stamp"),stamp){seen=1;}at=at+1;}if !seen{let auth=sh_read_json(source,j_object(),1048576);let digest=0;if auth{digest=sa_key(auth);}if digest && h_equal(digest,cj_text(row,"key")){sh_save_json(sa_path(cj_text(row,"id")),auth);}se=0;let saved=j_object();sh_s(saved,"key",key);sh_s(saved,"stamp",stamp);j_push(cache,saved);if j_count(cache)>128{j_set(sv,"auth_stamps",j_array());}}}}i=i+1;}return 0;}
fn sa_add(auth,source,activate){let key=sa_key(auth);if !key{return 0;}let rows=sa_rows();let found=0;let i=0;while i<j_count(rows){if h_equal(cj_text(j_at(rows,i),"key"),key){found=sh_copy(j_at(rows,i));}i=i+1;}if !found{if j_count(rows)>=32{return sh_fail("Up to 32 accounts can be saved");}found=j_object();sh_s(found,"id",sh_id());sh_s(found,"key",key);}let dir=h_join(cj_text(sv,"data"),"accounts");let st=sh_stat(dir,0);if st && (load64(st+24)&61440)!=16384{return sh_fail("Account storage must be a private directory");}h_mkdir(dir);syscall(90,dir,448,0,0,0,0);if source && !h_equal(h_dir(source),dir){sh_s(found,"source",source);}if !sh_save_json(sa_path(cj_text(found,"id")),auth){return 0;}let next=j_array();let replaced=0;i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(cj_text(row,"id"),cj_text(found,"id")){row=found;replaced=1;}j_push(next,row);i=i+1;}if !replaced{j_push(next,found);}let active=sa_active();if activate || !h_len(active){active=cj_text(found,"id");}let registry=j_object();sh_s(registry,"active",active);j_set(registry,"entries",next);if !sa_save(registry){return 0;}return found;}
fn sa_display(){let out=j_array();if !cj_int(sv,"account_metadata"){return out;}let rows=sa_rows();let i=0;while i<j_count(rows){let id=cj_text(j_at(rows,i),"id");let auth=sa_auth(id);let available=auth!=0;let row=sa_details(auth);se=0;sh_s(row,"id",id);sh_b(row,"active",h_equal(id,sa_active()));sh_b(row,"available",available);j_push(out,row);i=i+1;}return out;}
fn sa_read_auth(){if cj_int(sv,"account_metadata") && h_len(sa_active()){sa_refresh(sa_active());return sa_auth(sa_active());}return sh_read_json(cj_text(sv,"auth_file"),j_object(),1048576);}
fn sa_authenticated(){if cj_int(sv,"fixture_enabled"){return 1;}let auth=sa_read_auth();let ok=auth && h_equal(cj_text(auth,"auth_mode"),"chatgpt") && h_len(cj_text(cj_get(auth,"tokens"),"access_token"));se=0;return ok;}
fn sa_account(){if !cj_int(sv,"account_metadata"){return j_object();}let auth=sa_read_auth();se=0;return sa_details(auth);}
fn sa_init(){let registry=sh_read_json(h_join(cj_text(sv,"data"),"accounts.json"),j_parse("{\"active\":\"\",\"entries\":[]}"),1048576);if !registry || j_kind(registry)!=4 || j_kind(cj_get(registry,"entries"))!=3 || j_count(cj_get(registry,"entries"))>32{return sh_fail("Invalid saved account registry");}let rows=j_get(registry,"entries");let ids=j_object();let keys=j_object();let i=0;while i<j_count(rows){let row=j_at(rows,i);let id=cj_text(row,"id");let key=cj_text(row,"key");let source=cj_text(row,"source");if h_len(id)!=32 || !sh_valid(id,32) || h_len(key)!=64 || !sh_valid(key,64) || j_get(ids,id) || j_get(keys,key) || (h_len(source) && load8(source)!=47){return sh_fail("Invalid saved account entry");}j_set(ids,id,j_bool(1));j_set(keys,key,j_bool(1));i=i+1;}let active=cj_text(registry,"active");if (j_count(rows) && !j_get(ids,active)) || (!j_count(rows) && h_len(active)){return sh_fail("The selected account is missing from the registry");}j_set(sv,"accounts_registry",registry);if cj_int(sv,"account_metadata") && (cj_int(sv,"explicit_auth") || !j_count(rows)){let auth=sh_read_json(cj_text(sv,"auth_file"),j_object(),1048576);if auth && sa_key(auth){sa_add(auth,cj_text(sv,"auth_file"),cj_int(sv,"explicit_auth"));}se=0;}return 1;}
