import "controller.flex";
fn st_dispose(task){let output=cj_get(task,"output_fd");if output && j_value(output)>=0{h_close(j_value(output));sh_n(task,"output_fd",-1);}let slot=cj_int(task,"network_slot");if slot{cn_close(slot);sh_n(task,"network_slot",0);}return 0;}
fn st_live(task,display){if cj_int(task,"cancelled"){return 0;}let data=j_object();if cj_int(task,"id"){let workers=sv_get("worker_streams");if !workers{workers=j_object();}j_set(workers,h_int(cj_int(task,"id")),display);j_set(sv,"worker_streams",workers);j_set(data,"worker_streams",workers);}else{sh_s(data,"stream",cj_text(display,"text"));j_set(data,"live",display);}return sv_update(data);}
fn st_clear_live(task){let data=j_object();if cj_int(task,"id"){let workers=sv_get("worker_streams");if !workers{workers=j_object();}workers=sh_without(workers,h_int(cj_int(task,"id")));j_set(sv,"worker_streams",workers);j_set(data,"worker_streams",workers);}else{sh_s(data,"stream","");j_set(data,"live",j_object());}return sv_update(data);}
fn st_show_prompt(){let prompts=sh_array(sv,"prompts");let next=j_array();let i=0;while i<j_count(prompts){let pending=j_at(prompts,i);let task=sv_task(cj_int(pending,"agent_id"));let value=cj_get(sv_get("permissions"),cj_text(pending,"key"));if task && !cj_int(task,"cancelled") && value && j_kind(value)==2 && h_equal(j_value(value),"ask"){j_push(next,pending);}i=i+1;}j_set(sv,"prompts",next);let request=j_object();if j_count(next){request=j_at(next,0);}let data=j_object();j_set(data,"permission_request",request);return sv_update(data);}
fn st_fail(task,message,cancelled){st_dispose(task);sh_s(task,"stage","transition");sh_s(task,"action","failure");let event=j_object();sh_s(event,"error",message);sh_b(event,"cancelled",cancelled);j_set(task,"event",event);se=0;return 0;}
fn st_next(task,action,event){sh_s(task,"stage","transition");sh_s(task,"action",action);if !event{event=j_object();}j_set(task,"event",event);return 0;}
fn st_finish(task,error){let id=cj_int(task,"id");st_dispose(task);if error && h_len(error){sv_notice(error);}j_set(sv,"tasks",sh_without(sv_tasks(),h_int(id)));st_clear_live(task);sv_update(sh_b(j_object(),"account_busy",j_count(sv_tasks())>0));st_show_prompt();sh_b(sv,"schedule_needed",1);if !id{let data=j_object();sh_b(data,"busy",0);sh_s(data,"stream","");j_set(data,"live",j_object());sh_s(data,"status","");let pending=cj_get(sv_get("state"),"pending_execution");sh_b(data,"continuation",pending && j_kind(pending)!=0);sv_update(data);sv_save();}return 0;}
fn st_apply(task,state,cards){if cj_int(task,"id"){return 1;}j_set(sv,"state",state);if j_count(cards){let stamp=sh_clock();if stamp<=sv_n("last_activity"){stamp=sv_n("last_activity")+1;}sh_n(sv,"last_activity",stamp);}if !sv_save(){return 0;}if j_count(cards){let packet=sv_request("append");j_set(packet,"append_cards",cards);sv_emit(packet);}let updateentry=h_equal(cj_text(state,"phase"),"done") || h_equal(cj_text(state,"phase"),"failed");let images=0;let i=0;while i<j_count(cards){let card=j_at(cards,i);if h_equal(cj_text(card,"kind"),"user"){updateentry=1;}if h_equal(cj_text(card,"kind"),"image") || cj_get(cj_get(card,"observation"),"views"){images=1;}i=i+1;}if updateentry && !sv_session_entry(){return 0;}let limits=sv_call(6,-1,sh_copy(state));if !limits{return 0;}let data=j_object();let pending=cj_get(state,"pending_execution");sh_b(data,"continuation",pending && j_kind(pending)!=0);let usage=cj_get(limits,"usage");sh_n(data,"used",cj_int(usage,"total_tokens"));sh_n(data,"total",cj_int(limits,"usable_context_window"));sh_b(data,"estimated",c_flag(usage,"estimated"));sv_update(data);if images{sv_facts();}return !se;}
fn st_new(id,action,state,event){let task=j_object();sh_n(task,"id",id);sh_s(task,"stage","transition");sh_s(task,"action",action);j_set(task,"state",state);if !event{event=j_object();}j_set(task,"event",event);sh_b(task,"cancelled",0);j_set(sv_tasks(),h_int(id),task);return task;}
fn st_start(action,event){if sv_task(0){return sh_fail("A conversation task is already running");}if h_equal(action,"begin") && !sa_authenticated(){return sh_fail("Sign in with ChatGPT before sending a message");}st_new(0,action,sv_get("state"),event);let data=j_object();sh_b(data,"busy",1);sh_b(data,"account_busy",1);sv_update(data);return 1;}
fn st_schedule(recover){if sv_n("closing"){return 0;}let request=sv_request("plan");let active=j_array();let fields=j_value(sv_tasks());let i=0;while i<h_count(fields){let task=load64(h_at(fields,i)+8);if cj_int(task,"id"){j_push(active,j_int(cj_int(task,"id")));}i=i+1;}j_set(request,"active",active);sh_b(request,"recover",recover);let grant=cj_get(sv_get("permissions"),"workers");sh_b(request,"allowed",grant && j_kind(grant)==5 && j_value(grant));sh_b(request,"authenticated",sa_authenticated());let plan=sv_call(9,-1,request);if !plan{return 0;}let cancel=sh_array(plan,"cancel");i=0;while i<j_count(cancel){let task=sv_task(j_value(j_at(cancel,i)));if task{sh_b(task,"cancelled",1);}i=i+1;}let start=sh_array(plan,"start");i=0;while i<j_count(start){let entry=j_at(start,i);let event=j_object();j_set(event,"revision",j_get(entry,"revision"));st_new(cj_int(entry,"id"),"open_worker",j_object(),event);i=i+1;}if j_count(start){sv_update(sh_b(j_object(),"account_busy",1));}let workers=sh_array(plan,"workers");let encoded=j_dump(workers);if !h_equal(encoded,sv_s("last_workers")){sh_s(sv,"last_workers",encoded);let data=j_object();j_set(data,"workers",workers);sh_s(data,"workers_error","");sv_update(data);}sh_n(sv,"schedule_at",net_now()+500);sh_b(sv,"schedule_needed",0);return 1;}
fn st_model(task,command,feedback){let request=j_object();let state=cj_get(task,"state");let messages=sh_array(state,"messages");let op=cj_int(command,"engine_op");if feedback{messages=sh_array(command,"messages");op=1;sh_b(request,"feedback",1);}j_set(request,"messages",messages);let body=sv_call(op,cj_int(task,"id"),request);if !body{return 0;}j_set(task,"response_messages",messages);sh_b(task,"compact",c_flag(command,"compact"));sh_b(task,"feedback",feedback);j_set(task,"stream",j_object());if !cj_int(task,"id"){sv_update(sh_s(j_object(),"status",""));}
    if sv_n("fixture_enabled"){let fixture=sv_get("fixture");let sequence=fixture;if j_kind(fixture)==4{if cj_int(task,"id"){sequence=cj_get(cj_get(fixture,"workers"),h_int(cj_int(task,"id")));}else{sequence=cj_get(fixture,"main");}}let index=cj_int(command,"response_index");if !sequence || j_kind(sequence)!=3 || index>=j_count(sequence){return sh_fail("Fixture response sequence is exhausted");}let entry=j_at(sequence,index);let events=cj_get(entry,"events");if !events{events=j_array();j_push(events,entry);}j_set(task,"response_events",events);sh_n(task,"response_at",0);sh_n(task,"next_at",net_now());sh_s(task,"stage","fixture");return 1;}
    let auth=sa_read_auth();if !auth{return 0;}request=sv_request("authenticate");j_set(request,"auth",auth);let transport=sv_call(8,-1,request);if !transport{return 0;}let slot=cn_start(cj_text(transport,"url"),cj_get(transport,"headers"),j_dump(body),8388608,240000,0);if !slot{return 0;}sh_n(task,"network_slot",slot);sh_s(task,"stage","network");sh_s(task,"event_data","");return 1;
}
fn st_feed(task,raw){let request=sv_request("stream");j_set(request,"stream",cj_get(task,"stream"));sh_s(request,"event_json",raw);sh_b(request,"compact",c_flag(task,"compact"));sh_b(request,"feedback",c_flag(task,"feedback"));j_set(request,"messages",sh_array(task,"response_messages"));let packet=sv_call(8,cj_int(task,"id"),request);if !packet{return 0;}j_set(task,"stream",j_get(packet,"stream"));st_live(task,j_get(packet,"display"));if c_flag(packet,"complete"){let event=j_object();j_set(event,"reply",j_get(packet,"reply"));let action="reply";if c_flag(task,"compact"){action="compacted";}if c_flag(task,"feedback"){action="feedback";}st_dispose(task);st_clear_live(task);st_next(task,action,event);return 2;}return 1;}
fn st_network(task){let slot=cj_int(task,"network_slot");let bytes=load64(slot+8);let at=load64(slot+56);let end=load64(slot+16);let start=at;let complete=0;let consumed=0;while at<end && !complete && consumed<32{if load8(bytes+at)==10{let n=at-start;if n>1048576{return sh_fail("Model stream line exceeds 1 MiB");}if n && load8(bytes+start+n-1)==13{n=n-1;}let line=h_slice(bytes+start,n);if h_starts(line,"data:"){let value=line+5;while load8(value)==32{value=value+1;}let old=cj_text(task,"event_data");let joined=value;if h_len(old){joined=h_cat3(old,"\n",value);}sh_s(task,"event_data",joined);}else if !n && h_len(cj_text(task,"event_data")){let raw=cj_text(task,"event_data");sh_s(task,"event_data","");let reply=st_feed(task,raw);if !reply{return 0;}if reply==2{complete=1;}consumed=consumed+1;}start=at+1;if !complete{store64(slot+56,start);}}at=at+1;}if !complete && end-start>1048576{return sh_fail("Model stream line exceeds 1 MiB");}if !complete && load64(slot+32) && at>=end{let error=cn_error(slot);if error{return sh_fail(error);}return sh_fail("Model stream ended before a completed response");}return 1;}
fn st_step(task){let id=cj_int(task,"id");let action=cj_text(task,"action");if cj_int(task,"cancelled") && !h_equal(action,"failure"){st_fail(task,"Cancelled.",1);}let stage=cj_text(task,"stage");
    if h_equal(stage,"fixture"){if net_now()<cj_int(task,"next_at"){return 0;}let events=sh_array(task,"response_events");let at=cj_int(task,"response_at");if at>=j_count(events){se="Fixture must contain a completed response";}else{sh_n(task,"response_at",at+1);sh_n(task,"next_at",net_now()+25);st_feed(task,j_dump(j_at(events,at)));}}
    else if h_equal(stage,"network"){st_network(task);}
    else if h_equal(stage,"image"){sim_poll(task);}
    else if h_equal(stage,"wait"){if net_now()>=cj_int(task,"next_at"){st_next(task,"next",0);}}
    else if h_equal(stage,"permission"){let signal=cj_get(task,"permission");let mode=cj_get(sv_get("permissions"),cj_text(signal,"key"));if !mode || j_kind(mode)!=2 || !h_equal(j_value(mode),"ask"){st_next(task,"next",0);st_show_prompt();}}
    else if h_equal(stage,"transition"){
        let request=sv_request(cj_text(task,"action"));j_set(request,"state",cj_get(task,"state"));sh_b(request,"fixture",sv_n("fixture_enabled"));sh_merge(request,cj_get(task,"event"));sg_ignores_cancel=h_equal(cj_text(task,"action"),"failure");let transition=sv_call(8,id,request);sg_ignores_cancel=0;
        if transition{let state=j_get(transition,"state");j_set(task,"state",state);if !st_apply(task,state,sh_array(transition,"cards")){st_finish(task,se);se=0;return 0;}let command=j_get(transition,"command");j_set(task,"command",command);let kind=cj_text(command,"kind");if h_equal(kind,"done"){st_finish(task,cj_text(command,"error"));return 0;}if h_equal(cj_text(task,"action"),"failure") && cj_int(task,"cancelled"){st_finish(task,0);return 0;}
            if h_equal(kind,"model"){st_model(task,command,0);}
            else if h_equal(kind,"feedback"){st_model(task,command,1);}
            else if h_equal(kind,"imagegen"){sv_update(sh_s(j_object(),"status","Generating image…"));sim_start(task,command);}
            else if h_equal(kind,"vm"){sv_update(sh_s(j_object(),"status","Running Flexscript…"));let vm=sh_copy(cj_get(command,"request"));j_set(vm,"history",sh_array(state,"archive"));let observation=sv_call(3,id,vm);if observation{let event=j_object();j_set(event,"observation",observation);st_next(task,"observation",event);sh_b(sv,"schedule_needed",1);}}
            else if h_equal(kind,"permission"){let signal=sh_copy(cj_get(command,"signal"));sh_n(sv,"prompt_sequence",sv_n("prompt_sequence")+1);sh_n(signal,"request_id",sv_n("prompt_sequence"));sh_n(signal,"agent_id",id);j_push(cj_array(sv,"prompts"),signal);j_set(task,"permission",signal);sh_s(task,"stage","permission");st_show_prompt();}
            else if h_equal(kind,"platform_permission"){se="This operation requires Android platform consent and has no Linux adapter";}
            else if h_equal(kind,"wait"){sh_s(task,"stage","wait");sh_n(task,"next_at",net_now()+cj_int(command,"milliseconds"));sh_b(sv,"schedule_needed",1);}
            else{se="Unknown shared engine effect";}
        }
    }
    if se{let message=se;se=0;if h_equal(cj_text(task,"action"),"failure"){st_finish(task,message);}else{st_fail(task,message,cj_int(task,"cancelled"));}}return 0;
}
