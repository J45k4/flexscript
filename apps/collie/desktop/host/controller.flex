import "engine.flex";
import "accounts.flex";
global sv_input=0;global sv_input_used=0;global sv_eof=0;global sv_scratch=0;global sv_idle_poll=0;global sv_dirty=0;
fn sv_get(key){return cj_get(sv,key);}
fn sv_s(key){return cj_text(sv,key);}
fn sv_n(key){return cj_int(sv,key);}
fn sv_tasks(){let tasks=sv_get("tasks");if !tasks{tasks=j_object();j_set(sv,"tasks",tasks);}return tasks;}
fn sv_task(id){return cj_get(sv_tasks(),h_int(id));}
fn sv_task_cancelled(id){return cj_int(sv_task(id),"cancelled");}
fn sv_cancelled(){return sv_n("closing");}
fn sv_poll_input(){if !sv_scratch{sv_scratch=alloc(8192);}let scratch=sv_scratch;let n=syscall(0,0,scratch,8192,0,0,0);while n>0{sv_dirty=1;if sv_input_used+n>8388608{return sh_fail("Desktop command exceeds 8 MiB");}h_copy(sv_input+sv_input_used,scratch,n);sv_input_used=sv_input_used+n;store8(sv_input+sv_input_used,0);let start=0;let i=0;while i<sv_input_used{if load8(sv_input+i)==10{store8(sv_input+i,0);let command=sj_parse(sv_input+start);if !command || j_kind(command)!=4{sv_notice("Invalid desktop command");}else{let kind=cj_text(command,"kind");if h_equal(kind,"cancel") || (h_equal(kind,"permission") && !c_flag(command,"allowed")){let fields=j_value(sv_tasks());let at=0;while at<h_count(fields){let task=load64(h_at(fields,at)+8);sh_b(task,"cancelled",1);at=at+1;}}let queue=cj_array(sv,"commands");if j_count(queue)<128{j_push(queue,command);}else{sv_notice("Too many pending desktop commands");}}start=i+1;}i=i+1;}if start{h_copy(sv_input,sv_input+start,sv_input_used-start);sv_input_used=sv_input_used-start;}n=syscall(0,0,scratch,8192,0,0,0);}if n==0{sv_eof=1;sh_b(sv,"closing",1);}return 0;}
fn sv_emit(packet){if sv_n("session_request"){sh_n(packet,"session_request",sv_n("session_request"));}h_print(1,j_dump(packet));h_print(1,"\n");return 0;}
fn sv_update(data){let packet=j_object();sh_s(packet,"action","update");j_set(packet,"data",data);return sv_emit(packet);}
fn sv_notice(message){let packet=j_object();sh_s(packet,"action","notice");sh_s(packet,"text",message);return sv_emit(packet);}
fn sv_project(id){if !h_len(id){return 0;}let rows=sh_array(sv,"projects");let i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(cj_text(row,"id"),id){return row;}i=i+1;}return sh_fail("Project no longer exists");}
fn sv_project_name(){let project=sv_project(sv_s("project_id"));if project{return cj_text(project,"name");}return "Personal chats";}
fn sv_files(){let project=sv_project(sv_s("project_id"));if project{return cj_text(project,"path");}return h_join(sv_s("root"),"files");}
fn sv_config(agent){let config=j_object();sh_s(config,"workspace_file",h_join(sv_s("root"),"agent.flexdb"));sh_s(config,"model",sv_s("model"));let policy=sv_get("permissions");if !policy{policy=j_object();}j_set(config,"permissions",policy);let id=agent;if id<0{id=0;}sh_n(config,"agent_id",id);sh_s(config,"files_directory",sv_files());sh_s(config,"project_name",sv_project_name());return config;}
fn sv_call(op,agent,request){if !request{request=j_object();}j_set(request,"config",sv_config(agent));let prior=sg_agent;sg_agent=agent;let out=sg_call(op,request,sv_s("root"));sg_agent=prior;return out;}
fn sv_request(action){return sh_s(j_object(),"action",action);}
fn sv_save(){if !h_len(sv_s("root")){return 1;}let saved=sh_copy(sv_get("state"));j_set(saved,"permissions",sv_get("permissions"));j_set(saved,"pending_attachments",sh_array(sv,"attachments"));j_set(saved,"navigation",sv_get("navigation"));sh_s(saved,"model",sv_s("model"));sh_n(saved,"last_activity",sv_n("last_activity"));sh_s(saved,"project_id",sv_s("project_id"));let path=h_join(sv_s("root"),"session.json");let text=j_dump(saved);if h_len(text)>8388608{return sh_fail("Conversation exceeds 8 MiB. Start a new conversation.");}let digest=h_sha_bytes(text,h_len(text));if !h_equal(digest,sv_s("saved_digest")) || !h_equal(path,sv_s("saved_path")){if !sh_atomic(path,text,h_len(text)){return 0;}sh_s(sv,"saved_digest",digest);sh_s(sv,"saved_path",path);}let settings=sv_get("settings");sh_s(settings,"current",sh_leaf(sv_s("root")));sh_s(settings,"model",sv_s("model"));text=j_dump(settings);digest=h_sha_bytes(text,h_len(text));if !h_equal(digest,sv_s("settings_digest")){if !sh_atomic(h_join(sv_s("data"),"settings.json"),text,h_len(text)){return 0;}sh_s(sv,"settings_digest",digest);}return 1;}
fn sv_sort(rows){let out=j_array();let i=0;while i<j_count(rows){let row=j_at(rows,i);let next=j_array();let inserted=0;let at=0;while at<j_count(out){let other=j_at(out,at);if !inserted && (cj_int(row,"updated")>cj_int(other,"updated") || (cj_int(row,"updated")==cj_int(other,"updated") && sh_less(cj_text(other,"id"),cj_text(row,"id")))){j_push(next,row);inserted=1;}j_push(next,other);at=at+1;}if !inserted{j_push(next,row);}out=next;i=i+1;}return out;}
fn sv_activity(saved,path){let value=cj_get(saved,"last_activity");if value && j_kind(value)==1 && j_value(value)>=0{return j_value(value);}let st=sh_stat(path,1);if st{return load64(st+88)*1000+load64(st+96)/1000000;}return sh_clock();}
fn sv_summary(saved){let request=sv_request("summary");j_set(request,"saved",saved);return sv_call(11,-1,request);}
fn sv_load_sessions(emit){let rows=j_array();let names=sh_names(h_join(sv_s("data"),"sessions"));let cache=sv_get("sessions_cache");if !cache{cache=j_object();}let nextcache=j_object();let i=0;while i<j_count(names){let id=j_value(j_at(names,i));if sh_valid(id,80){let path=h_join(h_join(h_join(sv_s("data"),"sessions"),id),"session.json");let st=sh_stat(path,1);if st{let stamp=h_cat3(h_int(load64(st+48)),":",h_cat3(h_int(load64(st+88)),":",h_int(load64(st+96))));let old=cj_get(cache,id);let row=0;if old && h_equal(cj_text(old,"stamp"),stamp){row=sh_copy(cj_get(old,"entry"));}else{let saved=sh_read_json(path,j_object(),8388608);if saved{row=sv_summary(saved);if row{sh_s(row,"id",id);sh_n(row,"updated",sv_activity(saved,path));sh_s(row,"project_id",cj_text(saved,"project_id"));}}}if row{let entry=j_object();sh_s(entry,"stamp",stamp);j_set(entry,"entry",sh_copy(row));j_set(nextcache,id,entry);sh_b(row,"current",h_equal(id,sh_leaf(sv_s("root"))));j_push(rows,row);}if se{return 0;}}}i=i+1;}j_set(sv,"sessions_cache",nextcache);rows=sv_sort(rows);j_set(sv,"sessions",rows);if emit{let data=j_object();j_set(data,"sessions",rows);sh_s(data,"session_id",sh_leaf(sv_s("root")));sh_b(data,"sessions_loading",0);sv_update(data);}return 1;}
fn sv_session_entry(){let row=sv_summary(sv_get("state"));if !row{return 0;}let id=sh_leaf(sv_s("root"));sh_s(row,"id",id);sh_b(row,"current",1);sh_n(row,"updated",sv_n("last_activity"));sh_s(row,"project_id",sv_s("project_id"));let rows=j_array();j_push(rows,row);let old=sh_array(sv,"sessions");let i=0;while i<j_count(old){let entry=j_at(old,i);if !h_equal(cj_text(entry,"id"),id){entry=sh_copy(entry);sh_b(entry,"current",0);j_push(rows,entry);}i=i+1;}rows=sv_sort(rows);j_set(sv,"sessions",rows);let data=j_object();j_set(data,"sessions",rows);sh_s(data,"session_id",id);sv_update(data);return 1;}
fn sv_account_facts(){let data=j_object();sh_b(data,"authenticated",sa_authenticated());j_set(data,"account",sa_account());j_set(data,"accounts",sa_display());sh_b(data,"account_busy",j_count(sv_tasks())>0);let login=sv_get("login_view");if !login{login=j_object();}j_set(data,"account_login",login);return data;}
fn sv_facts(){let limits=sv_call(6,-1,sh_copy(sv_get("state")));if !limits{return 0;}let usage=cj_get(limits,"usage");let data=sv_account_facts();sh_s(data,"platform","linux");j_set(data,"permission_entries",sv_get("permission_entries"));sh_s(data,"model",sv_s("model"));sh_s(data,"model_network","default");let settings=sv_get("settings");let width=cj_int(settings,"sidebar_width");if width<220 || width>520{width=252;}sh_n(data,"sidebar_width",width);let mode=cj_text(settings,"sidebar_mode");if !h_len(mode){mode="projects";}sh_s(data,"sidebar_mode",mode);let closed=cj_get(settings,"sidebar_closed");if !closed{closed=j_object();}j_set(data,"sidebar_closed",closed);j_set(data,"projects",sh_array(sv,"projects"));sh_s(data,"project_id",sv_s("project_id"));sh_s(data,"project_name",sv_project_name());sh_s(data,"project_path",sv_files());j_set(data,"sessions",sh_array(sv,"sessions"));sh_s(data,"session_id",sh_leaf(sv_s("root")));sh_b(data,"sessions_loading",0);sh_s(data,"pending_session_id","");j_set(data,"policy",sv_get("permissions"));j_set(data,"cards",sh_array(sv_get("state"),"cards"));j_set(data,"attachments",sh_array(sv,"attachments"));sh_b(data,"continuation",cj_get(sv_get("state"),"pending_execution")!=0 && j_kind(cj_get(sv_get("state"),"pending_execution"))!=0);sh_b(data,"busy",sv_task(0)!=0);sh_n(data,"used",cj_int(usage,"total_tokens"));sh_n(data,"total",cj_int(limits,"usable_context_window"));let estimated=cj_get(usage,"estimated");sh_b(data,"estimated",!estimated || c_flag(usage,"estimated"));sv_update(data);
    let images=j_object();sh_s(images,"resource:mipmap/ic_launcher",h_join(h_dir(sv_s("app")),"android/res/drawable-nodpi/collie_border_collie.png"));let icons=j_parse("[\"new-chat\",\"new-project\",\"settings\"]");let i=0;while i<3{let name=j_value(j_at(icons,i));sh_s(images,h_cat("resource:collie/",name),h_join(h_join(sv_s("app"),"icons"),h_cat(name,".svg")));i=i+1;}let folder=h_join(sv_s("root"),"images");let names=sh_names(folder);i=0;while i<j_count(names){let name=j_value(j_at(names,i));let len=h_len(name);if len==68 && h_equal(name+64,".jpg"){let key=h_slice(name,64);let path=h_join(folder,name);sh_s(images,h_cat("preview:",key),path);sh_s(images,h_cat("attachment:",key),path);}i=i+1;}let packet=sv_request("update");j_set(packet,"data",j_object());j_set(packet,"images",images);sv_emit(packet);return 1;
}
fn sv_permission(key,value){let policy=sv_get("permissions");let old=cj_get(policy,key);if !old{return sh_fail("Invalid permission setting");}if j_kind(value)!=5 && !(j_kind(value)==2 && h_equal(j_value(value),"ask")){return sh_fail("Invalid permission setting");}j_set(policy,key,value);if !sv_save(){j_set(policy,key,old);let data=j_object();j_set(data,"policy",policy);sv_update(data);return 0;}return 1;}
fn sv_open(id,project){if sv_task(0){return sh_fail("Stop the current reply before changing conversations");}if id && (!sh_valid(id,80) || h_find(id,".")>=0){return sh_fail("Invalid conversation ID");}if project && h_len(project) && !sv_project(project){return 0;}let fields=j_value(sv_tasks());let i=0;while i<h_count(fields){let task=load64(h_at(fields,i)+8);let request=sv_request("pause");sh_n(request,"id",cj_int(task,"id"));sv_call(9,-1,request);st_dispose(task);i=i+1;}j_set(sv,"tasks",j_object());if h_len(sv_s("root")){sv_save();sp_close(sv_s("root"),0);}let creating=!id;if creating{id=sh_id();}let root=h_join(h_join(sv_s("data"),"sessions"),id);let stat=sh_stat(root,0);if stat && (load64(stat+24)&61440)!=16384{return sh_fail("Conversation folders cannot be symbolic links");}h_mkdir(h_join(root,"files"));let saved=sh_read_json(h_join(root,"session.json"),j_object(),8388608);if !saved{return 0;}let nextproject=cj_text(saved,"project_id");if creating{nextproject=sv_s("project_id");if project{nextproject=project;}}if h_len(nextproject) && !sv_project(nextproject){return 0;}sh_s(sv,"root",root);sh_s(sv,"project_id",nextproject);sh_n(sv,"last_activity",sv_activity(saved,h_join(root,"session.json")));let navigation=cj_get(saved,"navigation");if !navigation || j_kind(navigation)!=4{navigation=j_object();}j_set(sv,"navigation",navigation);j_set(sv,"attachments",sh_array(saved,"pending_attachments"));let request=sv_request("permissions");let old=cj_get(saved,"permissions");if old{j_set(request,"saved",old);}let policy=sv_call(8,-1,request);if !policy{return 0;}j_set(sv,"permissions",j_get(policy,"policy"));j_set(sv,"permission_entries",sp_entries(j_get(policy,"entries")));saved=sh_without(saved,"navigation");saved=sh_without(saved,"pending_attachments");saved=sh_without(saved,"permissions");saved=sh_without(saved,"last_activity");saved=sh_without(saved,"project_id");cj_array(saved,"messages");cj_array(saved,"cards");cj_array(saved,"archive");j_set(sv,"state",saved);if !sv_save() || !sv_load_sessions(0){return 0;}sv_emit(sv_request("clear"));if j_count(navigation){let packet=sv_request("restore");j_set(packet,"data",navigation);sv_emit(packet);}if !sv_facts(){return 0;}st_schedule(1);sv_save();return !se;}
