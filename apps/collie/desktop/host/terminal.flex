// Bounded PTY sessions and a VT screen. Raw bytes and escape-parser state survive
// read boundaries; terminal memory is independent of the service's JSON arena.
global ct_slots=0;global ct_scratch=0;global ct_wait=0;
fn ct_escape(text){let out=h_take(h_len(text)+2);store8(out,27);h_copy(out+1,text,h_len(text)+1);return out;}
fn ct_init(){if !ct_slots{ct_slots=alloc(8*8192);ct_scratch=alloc(8192);ct_wait=alloc(8);}return 0;}
fn ct_find(id,root){ct_init();let i=0;while i<8{let t=ct_slots+i*8192;if load64(t) && load64(t+24)==id && h_equal(t+1024,root){return t;}i=i+1;}return 0;}
fn ct_rgb(index){let colors=alloc(128);store64(colors,0x182027);store64(colors+8,0xe06c75);store64(colors+16,0x98c379);store64(colors+24,0xe5c07b);store64(colors+32,0x61afef);store64(colors+40,0xc678dd);store64(colors+48,0x56b6c2);store64(colors+56,0xd5ded9);store64(colors+64,0x708780);store64(colors+72,0xff8b94);store64(colors+80,0xc5e3ae);store64(colors+88,0xffdb99);store64(colors+96,0x91caff);store64(colors+104,0xe1a2ff);store64(colors+112,0x86e0ec);store64(colors+120,0xffffff);let rgb=0;if index<16{rgb=load64(colors+index*8);}else if index<232{let c=index-16;let r=c/36;let g=c/6%6;let b=c%6;if r{r=r*40+55;}if g{g=g*40+55;}if b{b=b*40+55;}rgb=(r<<16)|(g<<8)|b;}else{let v=8+(index-232)*10;rgb=(v<<16)|(v<<8)|v;}syscall(11,colors,128,0,0,0,0);return rgb;}
fn ct_cell(t,x,y){return load64(t+168)+(y*240+x)*16;}
fn ct_clear_line(t,y,start,end){let x=start;while x<end{let c=ct_cell(t,x,y);store64(c,32);store64(c+8,load64(t+88));x=x+1;}return 0;}
fn ct_scroll(t,down){let top=load64(t+232);let bottom=load64(t+240);let cols=load64(t+40);
    if !down{if !load64(t+208) && top==0 && bottom==load64(t+48)-1{let head=load64(t+192);h_copy(load64(t+176)+head*240*16,ct_cell(t,0,0),240*16);store64(t+192,(head+1)%200);if load64(t+184)<200{store64(t+184,load64(t+184)+1);}}let y=top;while y<bottom{h_copy(ct_cell(t,0,y),ct_cell(t,0,y+1),240*16);y=y+1;}ct_clear_line(t,bottom,0,240);}
    else{let y=bottom;while y>top{h_copy(ct_cell(t,0,y),ct_cell(t,0,y-1),240*16);y=y-1;}ct_clear_line(t,top,0,240);}return 0;
}
fn ct_lf(t){if load64(t+64)==load64(t+240){ct_scroll(t,0);}else if load64(t+64)<load64(t+48)-1{store64(t+64,load64(t+64)+1);}store64(t+136,0);return 0;}
fn ct_width(cp){if cp>=0x300 && cp<=0x36f{return 0;}if cp>=0x1100 && (cp<=0x115f || cp==0x2329 || cp==0x232a || (cp>=0x2e80 && cp<=0xa4cf) || (cp>=0xac00 && cp<=0xd7a3) || (cp>=0xf900 && cp<=0xfaff) || (cp>=0xfe10 && cp<=0xfe6f) || (cp>=0xff00 && cp<=0xff60) || (cp>=0x1f300 && cp<=0x1faff) || cp>=0x20000){return 2;}return 1;}
fn ct_put(t,cp){let w=ct_width(cp);if !w{return 0;}let cols=load64(t+40);if load64(t+136) || load64(t+56)+w>cols{store64(t+56,0);ct_lf(t);}let x=load64(t+56);let c=ct_cell(t,x,load64(t+64));store64(c,cp);store64(c+8,load64(t+88));if w==2{store64(c+16,-1);store64(c+24,load64(t+88));}let next=x+w;if next>=cols{store64(t+56,cols-1);store64(t+136,1);}else{store64(t+56,next);}return 0;}
fn ct_param(args,index,fallback){if index>=j_count(args){return fallback;}let n=j_value(j_at(args,index));if n<0{return fallback;}return n;}
fn ct_alt(t,on){if on==load64(t+208){return 0;}let grid=load64(t+168);store64(t+168,load64(t+200));store64(t+200,grid);if on{store64(t+216,load64(t+56));store64(t+224,load64(t+64));store64(t+56,0);store64(t+64,0);let y=0;while y<80{ct_clear_line(t,y,0,240);y=y+1;}}else{store64(t+56,load64(t+216));store64(t+64,load64(t+224));}store64(t+208,on);store64(t+232,0);store64(t+240,load64(t+48)-1);store64(t+136,0);return 0;}
fn ct_csi(t,final){
    let raw=t+384;let i=0;let private=0;if load8(raw)==63{private=1;i=1;}let args=j_array();let n=-1;while i<load64(t+128){let c=load8(raw+i);if c>=48 && c<=57{if n<0{n=0;}n=n*10+c-48;if n>100000{n=100000;}}else if c==59 || c==58{j_push(args,j_int(n));n=-1;}i=i+1;}j_push(args,j_int(n));let a=ct_param(args,0,1);if a==0{a=1;}let x=load64(t+56);let y=load64(t+64);let cols=load64(t+40);let rows=load64(t+48);
    if final==65{y=y-a;}else if final==66 || final==101{y=y+a;}else if final==67 || final==97{x=x+a;}else if final==68{x=x-a;}else if final==69{y=y+a;x=0;}else if final==70{y=y-a;x=0;}else if final==71 || final==96{x=a-1;}else if final==100{y=a-1;}else if final==72 || final==102{y=a-1;x=ct_param(args,1,1)-1;}
    else if final==74{let mode=ct_param(args,0,0);if mode==2 || mode==3{let row=0;while row<rows{ct_clear_line(t,row,0,cols);row=row+1;}if mode==3{store64(t+184,0);store64(t+192,0);}}else if !mode{ct_clear_line(t,y,x,cols);let row=y+1;while row<rows{ct_clear_line(t,row,0,cols);row=row+1;}}else{let row=0;while row<y{ct_clear_line(t,row,0,cols);row=row+1;}ct_clear_line(t,y,0,x+1);}}
    else if final==75{let mode=ct_param(args,0,0);let start=x;let end=cols;if mode==1{start=0;end=x+1;}if mode==2{start=0;}ct_clear_line(t,y,start,end);}
    else if final==109{let at=0;while at<j_count(args){let v=ct_param(args,at,0);if v==0{store64(t+88,0xd5ded9);store64(t+96,0x0c1115);}else if v==39{store64(t+88,0xd5ded9);}else if v==49{store64(t+96,0x0c1115);}else if v>=30 && v<=37{store64(t+88,ct_rgb(v-30));}else if v>=90 && v<=97{store64(t+88,ct_rgb(v-90+8));}else if v>=40 && v<=47{store64(t+96,ct_rgb(v-40));}else if v==7{store64(t+88,0x10151a);}else if v==38 || v==48{let color=0;let mode=ct_param(args,at+1,0);if mode==5{color=ct_rgb(ct_param(args,at+2,7)%256);at=at+2;}else if mode==2{color=((ct_param(args,at+2,0)&255)<<16)|((ct_param(args,at+3,0)&255)<<8)|(ct_param(args,at+4,0)&255);at=at+4;}if v==38{store64(t+88,color);}else{store64(t+96,color);}}at=at+1;}}
    else if (final==104 || final==108) && private{let on=final==104;let at=0;while at<j_count(args){let mode=ct_param(args,at,0);if mode==1049 || mode==47 || mode==1047{ct_alt(t,on);x=load64(t+56);y=load64(t+64);}if mode==2004{store64(t+280,on);}if mode==1{store64(t+288,on);}at=at+1;}}
    else if final==114{let top=a-1;let bottom=ct_param(args,1,rows)-1;if top>=0 && bottom<rows && top<bottom{store64(t+232,top);store64(t+240,bottom);x=0;y=0;}}
    else if final==115{store64(t+72,x);store64(t+80,y);}else if final==117{x=load64(t+72);y=load64(t+80);}
    else if final==80{let col=x;while col<cols{let src=col+a;if src<cols{h_copy(ct_cell(t,col,y),ct_cell(t,src,y),16);}else{ct_clear_line(t,y,col,col+1);}col=col+1;}}
    else if final==64{let col=cols-1;while col>=x{let src=col-a;if src>=x{h_copy(ct_cell(t,col,y),ct_cell(t,src,y),16);}else{ct_clear_line(t,y,col,col+1);}col=col-1;}}
    else if final==88{let end=x+a;if end>cols{end=cols;}ct_clear_line(t,y,x,end);}
    else if final==83 || final==84{let at=0;while at<a && at<rows{ct_scroll(t,final==84);at=at+1;}}
    else if final==110{if a==6{let response=h_cat3(ct_escape("["),h_int(y+1),h_cat3(";",h_int(x+1),"R"));syscall(1,load64(t+8),response,h_len(response),0,0,0);}else if a==5{syscall(1,load64(t+8),ct_escape("[0n"),4,0,0,0);}}
    if x<0{x=0;}if y<0{y=0;}if x>=cols{x=cols-1;}if y>=rows{y=rows-1;}store64(t+56,x);store64(t+64,y);if final!=109{store64(t+136,0);}return 0;
}
fn ct_byte(t,b){
    let mode=load64(t+104);
    if mode==3{if b==7{store64(t+104,0);}else if b==27{store64(t+104,4);}return 0;}if mode==4{if b==92{store64(t+104,0);}else{store64(t+104,3);}return 0;}
    if mode==5{store64(t+104,0);return 0;}
    if mode==1{store64(t+104,0);if b==91{store64(t+104,2);store64(t+128,0);}else if b==93 || b==80 || b==94 || b==95{store64(t+104,3);}else if b==40 || b==41{store64(t+104,5);}else if b==55{store64(t+72,load64(t+56));store64(t+80,load64(t+64));}else if b==56{store64(t+56,load64(t+72));store64(t+64,load64(t+80));}else if b==68{ct_lf(t);}else if b==77{if load64(t+64)==load64(t+232){ct_scroll(t,1);}else if load64(t+64)>0{store64(t+64,load64(t+64)-1);}}else if b==99{let y=0;while y<load64(t+48){ct_clear_line(t,y,0,240);y=y+1;}store64(t+56,0);store64(t+64,0);}return 0;}
    if mode==2{if b>=64 && b<=126{ct_csi(t,b);store64(t+104,0);}else if b==27{store64(t+104,1);}else if load64(t+128)<120{store8(t+384+load64(t+128),b);store64(t+128,load64(t+128)+1);}else{store64(t+104,0);}return 0;}
    if load64(t+248){if b>=128 && b<=191{store64(t+256,(load64(t+256)<<6)|(b&63));store64(t+248,load64(t+248)-1);if !load64(t+248){let cp=load64(t+256);if cp>0x10ffff || (cp>=0xd800 && cp<=0xdfff){cp=0xfffd;}ct_put(t,cp);}return 0;}store64(t+248,0);ct_put(t,0xfffd);}
    if b==27{store64(t+104,1);}else if b==13{store64(t+56,0);store64(t+136,0);}else if b==10 || b==11 || b==12{ct_lf(t);}else if b==8{if load64(t+56)>0{store64(t+56,load64(t+56)-1);}store64(t+136,0);}else if b==9{let x=(load64(t+56)/8+1)*8;if x>=load64(t+40){x=load64(t+40)-1;}store64(t+56,x);}else if b>=32 && b<127{ct_put(t,b);}else if b>=194 && b<=244{let count=1;let cp=b&31;if b>=240{count=3;cp=b&7;}else if b>=224{count=2;cp=b&15;}store64(t+248,count);store64(t+256,cp);}return 0;
}
fn ct_utf8(out,cp){let bytes=h_take(5);let n=1;if cp<128{store8(bytes,cp);}else if cp<2048{n=2;store8(bytes,192|(cp>>6));store8(bytes+1,128|(cp&63));}else if cp<65536{n=3;store8(bytes,224|(cp>>12));store8(bytes+1,128|((cp>>6)&63));store8(bytes+2,128|(cp&63));}else{n=4;store8(bytes,240|(cp>>18));store8(bytes+1,128|((cp>>12)&63));store8(bytes+2,128|((cp>>6)&63));store8(bytes+3,128|(cp&63));}h_append(out,bytes,n);return 0;}
fn ct_hex(color){let digits="0123456789abcdef";let out=h_take(8);store8(out,35);let i=0;while i<6{store8(out+1+i,load8(digits+((color>>(20-i*4))&15)));i=i+1;}store8(out+7,0);return out;}
fn ct_run(runs,text,color){if !h_size(text){return 0;}let r=j_object();sh_s(r,"text",h_data(text));sh_n(r,"style",0);sh_s(r,"color",ct_hex(color));j_push(runs,r);return 0;}
fn ct_view(t){let view=j_object();sh_n(view,"id",load64(t+24));sh_s(view,"cwd",t+1024);sh_b(view,"exited",load64(t+152));let runs=j_array();let all=h_buffer();let part=h_buffer();let color=0xd5ded9;let count=load64(t+184);if load64(t+208){count=0;}let row=0;let last=load64(t+48)-1;
    let trailing=1;while last>load64(t+64) && trailing{let found=0;let x=0;while x<load64(t+40){let cp=load64(ct_cell(t,x,last));if cp>32{found=1;}x=x+1;}if found{trailing=0;}else{last=last-1;}}
    while row<count+last+1{let cells=0;if row<count{let at=(load64(t+192)-count+row+200)%200;cells=load64(t+176)+at*240*16;}else{cells=ct_cell(t,0,row-count);}let end=load64(t+40);while end>0 && load64(cells+(end-1)*16)<=32{end=end-1;}let x=0;while x<end{let cell=cells+x*16;let cp=load64(cell);if cp!=-1{let next=load64(cell+8);if next!=color{ct_run(runs,part,color);part=h_buffer();color=next;}if cp<32{cp=32;}ct_utf8(part,cp);ct_utf8(all,cp);}x=x+1;}if row<count+last{h_text(part,"\n");h_text(all,"\n");}row=row+1;}
    ct_run(runs,part,color);j_set(view,"runs",runs);sh_s(view,"output",h_data(all));sh_n(view,"cols",load64(t+40));sh_n(view,"rows",load64(t+48));sh_b(view,"bracketed",load64(t+280));sh_b(view,"application_cursor",load64(t+288));sh_n(view,"cursor_x",load64(t+56));sh_n(view,"cursor_y",count+load64(t+64));return view;
}
fn ct_emit(t){let data=j_object();let rows=j_array();j_push(rows,ct_view(t));j_set(data,"workspace_terminals",rows);sh_s(data,"workspace_root",t+1024);sv_update(data);store64(t+144,0);store64(t+160,net_now());return 1;}
fn ct_start(id,root){ct_init();let existing=ct_find(id,root);if existing{return ct_emit(existing);}let t=0;let i=0;while i<8 && !t{let slot=ct_slots+i*8192;if !load64(slot){t=slot;}i=i+1;}if !t{return sw_error("Up to eight terminal sessions can be open");}
    let fd=syscall(2,"/dev/ptmx",0x80102,0,0,0,0);if fd<0{return sw_error("Cannot open a PTY");}let number=h_zero(h_take(8),8);let unlock=h_zero(h_take(8),8);if syscall(16,fd,0x40045431,unlock,0,0,0)<0 || syscall(16,fd,0x80045430,number,0,0,0)<0{h_close(fd);return sw_error("Cannot initialize PTY");}let slave=h_cat("/dev/pts/",h_int(load64(number)));let shell=h_getenv("SHELL");if !shell || load8(shell)!=47{shell="/bin/sh";}let args=h_take(24);store64(args,shell);store64(args+8,"-i");store64(args+16,0);let env=h_take(8192);let count=0;i=0;while load64(h_env+i*8) && count<1000{let word=load64(h_env+i*8);if !h_starts(word,"TERM=") && !h_starts(word,"COLORTERM="){store64(env+count*8,word);count=count+1;}i=i+1;}store64(env+count*8,"TERM=xterm-256color");store64(env+(count+1)*8,"COLORTERM=truecolor");store64(env+(count+2)*8,0);let size=h_zero(h_take(8),8);store8(size,24);store8(size+2,80);syscall(16,fd,0x5414,size,0,0,0);let pid=syscall(57,0,0,0,0,0,0);if pid<0{h_close(fd);return sw_error("Cannot start shell");}if !pid{h_restore_sigpipe();syscall(157,1,9,0,0,0,0);syscall(112,0,0,0,0,0,0);let input=syscall(2,slave,2,0,0,0,0);if input<0{syscall(60,126,0,0,0,0,0);}syscall(16,input,0x540e,0,0,0,0);syscall(33,input,0,0,0,0,0);syscall(33,input,1,0,0,0,0);syscall(33,input,2,0,0,0,0);if input>2{h_close(input);}h_close(fd);h_close_inherited();if syscall(80,root,0,0,0,0,0)<0{syscall(60,126,0,0,0,0,0);}syscall(59,shell,args,env,0,0,0);syscall(60,127,0,0,0,0,0);}
    h_zero(t,8192);store64(t,1);store64(t+8,fd);store64(t+16,pid);store64(t+24,id);store64(t+40,80);store64(t+48,24);store64(t+88,0xd5ded9);store64(t+96,0x0c1115);store64(t+168,alloc(240*80*16));store64(t+200,alloc(240*80*16));store64(t+176,alloc(240*200*16));store64(t+240,23);h_copy(t+1024,root,h_len(root)+1);syscall(72,fd,4,2048,0,0,0);store64(t+144,1);return ct_emit(t);
}
fn ct_input(id,root,text){let t=ct_find(id,root);if !t || load64(t+152){return 0;}let n=h_len(text);if n>65536{return 0;}let sent=0;let until=net_now()+250;while sent<n && net_now()<until{let got=syscall(1,load64(t+8),text+sent,n-sent,0,0,0);if got>0{sent=sent+got;}else if got==-11 || got==-4{ct_poll();h_sleep(1);}else{return 0;}}return sent==n;}
fn ct_resize(id,root,cols,rows){let t=ct_find(id,root);if !t{return 0;}if cols<10{cols=10;}if cols>240{cols=240;}if rows<3{rows=3;}if rows>80{rows=80;}if cols==load64(t+40) && rows==load64(t+48){return 1;}store64(t+40,cols);store64(t+48,rows);if load64(t+56)>=cols{store64(t+56,cols-1);}if load64(t+64)>=rows{store64(t+64,rows-1);}store64(t+232,0);store64(t+240,rows-1);let size=h_zero(h_take(8),8);store8(size,rows&255);store8(size+1,rows>>8);store8(size+2,cols&255);store8(size+3,cols>>8);syscall(16,load64(t+8),0x5414,size,0,0,0);store64(t+144,1);return 1;}
fn ct_poll(){if !ct_slots{return 0;}let i=0;while i<8{let t=ct_slots+i*8192;if load64(t){let budget=32768;let n=1;while n>0 && budget>0{n=syscall(0,load64(t+8),ct_scratch,8192,0,0,0);if n>0{let at=0;while at<n{ct_byte(t,load8(ct_scratch+at));at=at+1;}store64(t+144,1);sv_dirty=1;budget=budget-n;}}if !load64(t+152) && syscall(61,load64(t+16),ct_wait,1,0,0,0)>0{store64(t+152,1);store64(t+144,1);}if load64(t+144) && net_now()-load64(t+160)>=50{ct_emit(t);}}i=i+1;}return 0;}
fn ct_close(t){if !t || !load64(t){return 0;}let pid=load64(t+16);h_close(load64(t+8));if !load64(t+152){syscall(62,-pid,1,0,0,0,0);}let until=net_now()+150;let ended=load64(t+152);while !ended && net_now()<until{if syscall(61,pid,ct_wait,1,0,0,0)>0{ended=1;}else{h_sleep(2);}}if !ended{syscall(62,-pid,9,0,0,0,0);syscall(61,pid,ct_wait,0,0,0,0);}syscall(11,load64(t+168),240*80*16,0,0,0,0);syscall(11,load64(t+200),240*80*16,0,0,0,0);syscall(11,load64(t+176),240*200*16,0,0,0,0);store64(t,0);return 1;}
fn ct_close_id(id,root){return ct_close(ct_find(id,root));}
fn ct_shutdown(){if !ct_slots{return 0;}let i=0;while i<8{ct_close(ct_slots+i*8192);i=i+1;}return 0;}
