import "imagegen.flex";
fn sl_url(url){if h_len(url)>16384{return 0;}let prefix=h_starts(url,"https://auth.openai.com/") || h_starts(url,"https://chatgpt.com/") || h_starts(url,"https://auth.openai.com:443/") || h_starts(url,"https://chatgpt.com:443/");if !prefix{return 0;}let i=0;while load8(url+i){if load8(url+i)<33 || load8(url+i)==127{return 0;}i=i+1;}return 1;}
fn sl_make_view(status,message,running){let view=j_object();sh_s(view,"status",status);sh_s(view,"message",message);sh_b(view,"running",running);let old=sv_get("login_view");sh_s(view,"method",cj_text(old,"method"));j_set(sv,"login_view",view);return view;}
fn sl_view(status,message,running){let view=sl_make_view(status,message,running);let data=j_object();j_set(data,"account_login",view);sv_update(data);return view;}
fn sl_remove(path,depth){if depth>16{return 0;}let st=sh_stat(path,0);if !st{return 0;}if (load64(st+24)&61440)==16384{let names=sh_names(path);let i=0;while i<j_count(names){sl_remove(h_join(path,j_value(j_at(names,i))),depth+1);i=i+1;}syscall(84,path,0,0,0,0,0);}else{syscall(87,path,0,0,0,0,0);}return 0;}
fn sl_send(record,message){let proc=load64(record);let text=h_cat(j_dump(message),"\n");let left=h_len(text);let at=0;let end=net_now()+5000;while at<left && net_now()<end{let n=syscall(1,load64(proc+32),text+at,left-at,0,0,0);if n>0{at=at+n;}else if n==-11{sp_wait(load64(proc+32),4,20);}else if n!=-4{return sh_fail("Codex sign-in connection closed");}}if at!=left{return sh_fail("Codex sign-in connection timed out");}return 1;}
fn sl_request(id,method,params){let request=j_object();sh_n(request,"id",id);sh_s(request,"method",method);j_set(request,"params",params);return sl_send(cj_int(sv_get("login"),"process"),request);}
fn sl_close(committed){let login=sv_get("login");if !login{return 0;}let record=cj_int(login,"process");if record{let id=cj_text(login,"login_id");if h_len(id){let params=sh_s(j_object(),"loginId",id);sl_request(3,"account/login/cancel",params);se=0;}sh_process_close(record);}if !committed{let home=cj_text(login,"home");if h_starts(home,h_cat(h_join(sv_s("data"),"account-logins"),"/")){sl_remove(home,0);}}j_set(sv,"login",cj_null());return 0;}
fn sl_cancel(emit){sl_close(0);if emit{sl_view("cancelled","Sign-in cancelled.",0);}return 1;}
fn sl_browser(){let view=sv_get("login_view");let url=cj_text(view,"url");if !c_flag(view,"running") || !sl_url(url){return sh_fail("No valid sign-in page is available");}if h_equal(h_getenv("COLLIE_HEADLESS"),"1"){return 0;}return sv_open_external(url);}
fn sl_start(method){if !h_equal(method,"browser") && !h_equal(method,"device"){return sh_fail("Unknown sign-in method");}if j_count(sv_tasks()){return sh_fail("Stop active replies and workers before signing in");}sl_cancel(0);if h_equal(method,"browser"){let fd=syscall(41,2,0x80001,0,0,0,0);let addr=h_zero(h_take(16),16);store8(addr,2);store8(addr+2,1455>>8);store8(addr+3,1455&255);store8(addr+4,127);store8(addr+7,1);let ok=fd>=0 && syscall(49,fd,addr,16,0,0,0)==0;h_close(fd);if !ok{return sh_fail("Browser callback port is unavailable. Finish the other login or use device code.");}}
    let executable=h_getenv("COLLIE_CODEX");if !executable{executable=h_executable("codex");}if syscall(21,executable,1,0,0,0,0)<0{return sh_fail("Install Codex CLI to sign in, or import an existing login");}let home=h_join(h_join(sv_s("data"),"account-logins"),sh_id());h_mkdir(home);let env=h_env;h_setenv("CODEX_HOME",home);h_setenv("OPENAI_API_KEY",0);h_setenv("CODEX_API_KEY",0);h_setenv("CODEX_ACCESS_TOKEN",0);h_setenv("CODEX_APP_SERVER_LOGIN_ISSUER",0);h_setenv("CODEX_APP_SERVER_LOGIN_OPEN_APP_URL",0);let args=h_vec();h_add(args,executable);h_add(args,"-c");h_add(args,"cli_auth_credentials_store=\"file\"");h_add(args,"-c");h_add(args,"forced_login_method=\"chatgpt\"");h_add(args,"app-server");h_add(args,"--stdio");let record=sh_process(args,0,home,-1,-1);h_env=env;let login=j_object();sh_n(login,"process",record);sh_s(login,"home",home);sh_s(login,"phase","initialize");sh_n(login,"deadline",net_now()+45000);j_set(login,"notifications",j_array());j_set(sv,"login",login);let view=sl_make_view("starting","Starting secure Codex sign-in…",1);sh_s(view,"method",method);let update=j_object();j_set(update,"account_login",view);sv_update(update);let params=j_object();let info=j_object();sh_s(info,"name","collie");sh_s(info,"title","Collie");sh_s(info,"version","0.1.0");j_set(params,"clientInfo",info);j_set(params,"capabilities",j_object());return sl_request(1,"initialize",params);
}
fn sl_complete(message){let login=sv_get("login");if !h_equal(cj_text(message,"loginId"),cj_text(login,"login_id")){return 1;}if !c_flag(message,"success"){return sh_fail("Sign-in was not completed. Try again or choose device code.");}let path=h_join(cj_text(login,"home"),"auth.json");let auth=sh_read_json(path,0,1048576);if !auth{return sh_fail("Codex completed sign-in without saving a valid login");}let request=sv_request("authenticate");j_set(request,"auth",auth);if !sv_call(8,-1,request){return 0;}let previous=sa_active();let saved=sa_add(auth,path,0);if !saved{return 0;}sh_b(sv,"account_metadata",1);sh_s(sv,"auth_file",sa_path(sa_active()));j_set(sv,"settings",sh_without(sv_get("settings"),"auth_file"));if !sv_save(){return 0;}let text="Account added. Choose Use account to change the selected login.";if !h_len(previous){text="Signed in. This account is now selected.";}else if h_equal(previous,cj_text(saved,"id")){text="Login updated for the selected account.";}sl_view("completed",text,0);sl_close(1);sv_update(sv_account_facts());return 1;}
fn sl_message(message){let login=sv_get("login");let phase=cj_text(login,"phase");let result=cj_get(message,"result");let id=cj_int(message,"id");if cj_get(message,"error"){return sh_fail("Codex could not start this sign-in method. Try device code.");}if id==1 && h_equal(phase,"initialize") && result{let notice=sh_s(j_object(),"method","initialized");j_set(notice,"params",j_object());if !sl_send(cj_int(login,"process"),notice){return 0;}let kind="chatgpt";if h_equal(cj_text(sv_get("login_view"),"method"),"device"){kind="chatgptDeviceCode";}sh_s(login,"phase","start");sh_n(login,"deadline",net_now()+60000);return sl_request(2,"account/login/start",sh_s(j_object(),"type",kind));}
    if id==2 && h_equal(phase,"start") && result{let method=cj_text(sv_get("login_view"),"method");let kind="chatgpt";if h_equal(method,"device"){kind="chatgptDeviceCode";}let loginid=cj_text(result,"loginId");if !h_equal(cj_text(result,"type"),kind) || !h_len(loginid) || h_len(loginid)>128{return sh_fail("Codex did not return a managed sign-in attempt");}let url=cj_text(result,"authUrl");let code="";if h_equal(method,"device"){url=cj_text(result,"verificationUrl");code=cj_text(result,"userCode");let i=0;while load8(code+i){let c=load8(code+i);if c<33 || c>126{return sh_fail("Codex returned an invalid device code");}i=i+1;}if !h_len(code) || h_len(code)>64{return sh_fail("Codex returned an invalid device code");}}if !sl_url(url){return sh_fail("Codex returned an unexpected sign-in destination");}sh_s(login,"login_id",loginid);sh_s(login,"phase","waiting");sh_n(login,"deadline",net_now()+960000);let view=sl_make_view("waiting","Complete sign-in in your browser. Your current account stays selected.",1);sh_s(view,"method",method);sh_s(view,"url",url);sh_s(view,"code",code);let ready=j_object();j_set(ready,"account_login",view);sv_update(ready);if !sl_browser(){se=0;sh_s(view,"message","Open the sign-in page below to continue. Your current account stays selected.");}let data=j_object();j_set(data,"account_login",view);sv_update(data);let pending=sh_array(login,"notifications");let i=0;while i<j_count(pending) && j_kind(sv_get("login"))==4{if !sl_complete(j_at(pending,i)){return 0;}i=i+1;}return 1;}
    if h_equal(cj_text(message,"method"),"account/login/completed"){let params=cj_get(message,"params");if h_equal(phase,"waiting"){return sl_complete(params);}let queue=cj_array(login,"notifications");if j_count(queue)>=64{return sh_fail("Too many Codex login notifications");}j_push(queue,params);}
    else if cj_get(message,"method") && cj_get(message,"id"){let reply=j_object();j_set(reply,"id",j_get(message,"id"));let error=j_object();sh_n(error,"code",-32601);sh_s(error,"message","Unsupported login client request");j_set(reply,"error",error);sl_send(cj_int(login,"process"),reply);}return 1;
}
fn sl_poll(){let login=sv_get("login");if !login || j_kind(login)!=4{return 0;}let record=cj_int(login,"process");sh_process_pump(record);let proc=load64(record);let bytes=h_out(proc);let size=h_len(bytes);let start=cj_int(login,"offset");let at=start;while at<size && j_kind(sv_get("login"))==4 && !se{if load8(bytes+at)==10{let message=sj_parse(h_slice(bytes+start,at-start));sh_n(login,"offset",at+1);if !message || j_kind(message)!=4{se="Codex sign-in connection returned an invalid response";}else{sl_message(message);}start=at+1;}at=at+1;}login=sv_get("login");if login && j_kind(login)==4{if load64(proc+8)!=-999 && !se{se="Codex sign-in process exited before completion";}if size-start>1048576{se="Codex sign-in response exceeds limit";}if net_now()>cj_int(login,"deadline"){se="Codex sign-in timed out. Try again or use device code.";}}if se{let message=se;se=0;sl_close(0);sl_view("error",message,0);}return 0;}
