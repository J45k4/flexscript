// User-operated project tools. These effects are never part of the guest API.
import "terminal.flex";
fn sw_key(){let id=sv_s("project_id");if !h_len(id){id=h_cat("personal-",sh_leaf(sv_s("root")));}return id;}
fn sw_legacy_path(){let folder=h_join(sv_s("data"),"workspaces");h_mkdir(folder);return h_join(folder,h_cat(sw_key(),".json"));}
fn sw_path(){if sv_n("multi_chat"){let folder=h_join(sv_s("data"),"workspaces");h_mkdir(folder);return h_join(folder,"desktop.json");}return sw_legacy_path();}
fn sw_load(){let path=sw_path();if sv_n("multi_chat") && !h_exists(path){path=sw_legacy_path();}let ws=sh_read_json(path,j_object(),4194304);if !ws{se=0;ws=j_object();}j_set(sv,"workspace",ws);let data=j_object();j_set(data,"workspace",ws);sh_s(data,"workspace_root",sv_files());sh_s(data,"workspace_side",cj_text(ws,"side"));j_set(data,"workspace_files",j_array());j_set(data,"workspace_changes",j_array());sh_s(data,"workspace_error","");sv_update(data);let refresh=j_object();let expanded=cj_get(ws,"expanded");if expanded{j_set(refresh,"expanded",expanded);}sw_refresh(refresh);return 1;}
fn sw_save(ws,side){if !ws || j_kind(ws)!=4{return 1;}let saved=sh_copy(ws);let panels=j_array();let old=sh_array(ws,"panels");let history_bytes=0;let i=0;while i<j_count(old){let panel=sh_copy(j_at(old,i));panel=sh_without(panel,"runs");panel=sh_without(panel,"output");panel=sh_without(panel,"chat");let names=j_parse("[\"undo\",\"redo\"]");let j=0;while j<2{let name=j_value(j_at(names,j));let stack=sh_array(panel,name);let first=j_count(stack);while first>0{let n=h_len(j_value(j_at(stack,first-1)));if history_bytes+n>1048576{first=0;j_set(panel,name,j_array());}else{history_bytes=history_bytes+n;first=first-1;}}j=j+1;}j_push(panels,panel);i=i+1;}j_set(saved,"panels",panels);sh_s(saved,"side",side);let text=j_dump(saved);if h_len(text)>4194304{return sh_fail("Workspace exceeds 4 MiB; close unused files");}let path=sw_path();let digest=h_sha_bytes(text,h_len(text));if !h_equal(digest,sv_s("workspace_digest")) || !h_equal(path,sv_s("workspace_saved_path")){if !sh_atomic(path,text,h_len(text)){return 0;}sh_s(sv,"workspace_digest",digest);sh_s(sv,"workspace_saved_path",path);}j_set(sv,"workspace",saved);return 1;}
fn sw_packet(data){sh_s(data,"workspace_root",sv_files());return sv_update(data);}
fn sw_error(text){let data=j_object();sh_s(data,"workspace_error",text);return sw_packet(data);}
fn sw_names(fd){let rows=j_array();let buffer=h_take(32768);let n=syscall(217,fd,buffer,32768,0,0,0);while n>0 && j_count(rows)<512{let at=0;while at<n && j_count(rows)<512{let size=load8(buffer+at+16)|(load8(buffer+at+17)<<8);if size<20 || at+size>n{return rows;}let name=buffer+at+19;if !h_equal(name,".") && !h_equal(name,"..") && !h_equal(name,".git") && sh_relative(name){j_push(rows,j_string(h_slice(name,h_len(name))));}at=at+size;}n=syscall(217,fd,buffer,32768,0,0,0);}return rows;}
fn sw_tree(path,depth,expanded,out){
    if depth>12 || j_count(out)>=200{return 0;}let relative="__collie_entry";if h_len(path){relative=h_cat3(path,"/",relative);}let fd=sh_parent(sv_files(),relative,0);if fd<0{se=0;return 0;}let names=sw_names(fd);let sorted=j_array();let i=0;
    while i<j_count(names){let name=j_value(j_at(names,i));let st=h_take(144);if syscall(262,fd,name,st,256,0,0)==0{let kind=load64(st+24)&61440;if kind==16384 || kind==32768{let row=j_object();sh_s(row,"name",name);let nextpath=name;if h_len(path){nextpath=h_cat3(path,"/",name);}sh_s(row,"path",nextpath);sh_n(row,"depth",depth);sh_b(row,"directory",kind==16384);sh_b(row,"expanded",cj_int(expanded,nextpath));let next=j_array();let placed=0;let j=0;while j<j_count(sorted){let other=j_at(sorted,j);let before=cj_int(row,"directory")>cj_int(other,"directory") || (cj_int(row,"directory")==cj_int(other,"directory") && sh_less(name,cj_text(other,"name")));if !placed && before{j_push(next,row);placed=1;}j_push(next,other);j=j+1;}if !placed{j_push(next,row);}sorted=next;}}i=i+1;}h_close(fd);
    i=0;while i<j_count(sorted) && j_count(out)<200{let row=j_at(sorted,i);sh_n(row,"index",j_count(out));j_push(out,row);if cj_int(row,"directory") && cj_int(row,"expanded"){sw_tree(cj_text(row,"path"),depth+1,expanded,out);}i=i+1;}return 1;
}
// Keep NUL-delimited Git records intact, including paths containing spaces.
fn sw_git(args){let record=sh_process(args,"",sv_files(),-1,-1);let proc=load64(record);let start=net_now();while load64(proc+8)==-999 || load64(proc+40)>=0{sh_process_pump(record);sv_poll_input();cn_pump();if sv_cancelled() || net_now()-start>4000{sh_process_close(record);return 0;}h_sleep(2);}let status=load64(proc+8);let size=h_size(load64(proc+16));let result=j_object();sh_n(result,"status",status);sh_n(result,"size",size);sh_s(result,"bytes",h_slice(h_out(proc),size));sh_s(result,"error",h_slice(h_err(proc),h_len(h_err(proc))));sh_process_close(record);return result;}
fn sw_git_args(){return h_args("git","--no-pager","-c","core.fsmonitor=false","-c","core.quotepath=false");}
fn sw_refresh(command){
    let expanded=cj_get(command,"expanded");if !expanded{expanded=cj_get(sv_get("workspace"),"expanded");}let rows=j_array();sw_tree("",0,expanded,rows);let data=j_object();j_set(data,"workspace_files",rows);sh_s(data,"workspace_error","");let args=sw_git_args();h_add(args,"status");h_add(args,"--porcelain=v1");h_add(args,"-z");h_add(args,"--untracked-files=all");let result=sw_git(args);let changes=j_array();
    if !result || cj_int(result,"status"){sh_s(data,"workspace_branch","No Git repository");}
    else{let bytes=cj_text(result,"bytes");let n=cj_int(result,"size");let at=0;while at<n && j_count(changes)<200{let start=at;while at<n && load8(bytes+at){at=at+1;}let size=at-start;at=at+1;if size>=4{let row=j_object();sh_s(row,"status",h_slice(bytes+start,2));let path=h_slice(bytes+start+3,size-3);if sh_relative(path){sh_s(row,"path",path);sh_n(row,"index",j_count(changes));j_push(changes,row);}if load8(bytes+start)==82 || load8(bytes+start)==67 || load8(bytes+start+1)==82 || load8(bytes+start+1)==67{while at<n && load8(bytes+at){at=at+1;}at=at+1;}}}args=sw_git_args();h_add(args,"branch");h_add(args,"--show-current");result=sw_git(args);let branch="Detached HEAD";if result && !cj_int(result,"status") && h_len(h_trim(cj_text(result,"bytes"))){branch=h_trim(cj_text(result,"bytes"));}sh_s(data,"workspace_branch",branch);}
    j_set(data,"workspace_changes",changes);return sw_packet(data);
}
fn sw_read(command){
    let path=cj_text(command,"path");if !sh_relative(path){return sw_error("Choose a file inside this project");}let diff=c_flag(command,"diff");let text=0;let kind="file";let n=0;
    if diff{kind="diff";if h_equal(cj_text(command,"status"),"??"){let bytes=sh_read_project(sv_files(),path,262144);if bytes{n=h_file_size;if sv_utf8(bytes,n){text=h_cat3("New file: ",path,h_cat("\n\n",bytes));}}}else{let args=sw_git_args();h_add(args,"diff");h_add(args,"--no-ext-diff");h_add(args,"--no-textconv");h_add(args,"HEAD");h_add(args,"--");h_add(args,path);let result=sw_git(args);if result && !cj_int(result,"status"){text=cj_text(result,"bytes");}else{args=sw_git_args();h_add(args,"diff");h_add(args,"--no-ext-diff");h_add(args,"--no-textconv");h_add(args,"--cached");h_add(args,"--");h_add(args,path);result=sw_git(args);if result && !cj_int(result,"status"){text=cj_text(result,"bytes");}}}}
    else{text=sh_read_project(sv_files(),path,262144);n=h_file_size;if text && !sv_utf8(text,n){text=0;}}
    if !text{se=0;return sw_error("Cannot open this file as UTF-8 text (limit 256 KiB)");}if h_len(text)>262144{return sw_error("Diff exceeds 256 KiB");}let file=j_object();sh_s(file,"kind",kind);sh_s(file,"project_path",sv_files());sh_s(file,"chat_session",scm_id());sh_s(file,"path",path);let title=sh_leaf(path);if diff{title=h_cat("Diff · ",title);}sh_s(file,"title",title);sh_s(file,"text",text);let data=j_object();j_set(data,"workspace_file",file);sh_s(data,"workspace_error","");return sw_packet(data);
}
fn sw_write(command){
    let path=cj_text(command,"path");let text=cj_text(command,"text");if h_len(text)>262144 || !sv_utf8(text,h_len(text)){return sw_error("File must be UTF-8 text up to 256 KiB");}let old=sh_read_project(sv_files(),path,262144);if !old{se=0;return sw_error("File is unavailable; your edits have been kept");}if !h_equal(old,cj_text(command,"expected")){return sw_error("File changed on disk. Your edits have been kept; compare before saving.");}
    let fd=sh_parent(sv_files(),path,0);if fd<0{se=0;return sw_error("Project folder is unavailable");}let st=h_take(144);if syscall(262,fd,sh_leaf(path),st,256,0,0)<0{h_close(fd);return sw_error("Cannot inspect file mode");}let mode=load64(st+24)&511;let temp=h_cat(".collie-",sh_id());let output=syscall(257,fd,temp,0xa00c1,384,0,0);let ok=output>=0;if ok{ok=h_write(output,text,h_len(text))==h_len(text) && syscall(91,output,mode,0,0,0,0)==0 && syscall(74,output,0,0,0,0,0)==0;h_close(output);}if ok{ok=syscall(264,fd,temp,fd,sh_leaf(path),0,0)==0 && syscall(74,fd,0,0,0,0,0)==0;}syscall(263,fd,temp,0,0,0,0);h_close(fd);if !ok{return sw_error("Could not save file; your edits have been kept");}let saved=j_object();j_set(saved,"id",j_get(command,"id"));sh_s(saved,"text",text);let data=j_object();j_set(data,"workspace_saved",saved);sh_s(data,"workspace_error","");return sw_packet(data);
}
fn sw_command(command){
    let root=cj_text(command,"project_path");if !h_equal(root,sv_files()){return sw_error("The project changed before this operation completed");}let kind=cj_text(command,"kind");
    if h_equal(kind,"workspace_refresh"){return sw_refresh(command);}if h_equal(kind,"workspace_read"){return sw_read(command);}if h_equal(kind,"workspace_save"){return sw_write(command);}
    if h_equal(kind,"workspace_terminal_start"){return ct_start(cj_int(command,"id"),sv_files());}if h_equal(kind,"workspace_terminal_close"){return ct_close_id(cj_int(command,"id"),sv_files());}if h_equal(kind,"workspace_terminal_input"){return ct_input(cj_int(command,"id"),sv_files(),cj_text(command,"text"));}if h_equal(kind,"workspace_terminal_resize"){return ct_resize(cj_int(command,"id"),sv_files(),cj_int(command,"cols"),cj_int(command,"rows"));}return 0;
}
