import "source.flex";
fn main(argc,argv){h_environment(argc,argv);h_assert(h_exists("apps/collie/desktop/main.flex"),"Run from the Flexscript worktree root");let compiler=h_real(b_option(argc,argv,"--compiler","build/collie-desktop/compiler"));let directory=b_option(argc,argv,"--out","build/collie-desktop");h_mkdir(directory);let out=h_real(directory);bf_lower(compiler,out);let exports=bf_exports;let engine=bf_engine(out);bf_exports=exports;bf_flatten(h_args("apps/collie/desktop/main.flex",0,0,0,0,0));let desktop=h_join(out,"desktop-generated.flex");h_save(desktop,h_cat(h_data(bf_globals),h_data(bf_functions)));let broker=bf_broker(out);let temporary=h_join(out,h_cat("broker.new-",h_int(syscall(39,0,0,0,0,0,0))));let args=h_args("cc","-shared","-fPIC","-O2","-Wall","-Wextra");h_add(args,"-Wno-unused-variable");h_add(args,broker);h_add(args,"-o");h_add(args,temporary);h_check(h_run(args),0,0);h_assert(syscall(82,temporary,h_join(out,"broker.so"),0,0,0,0)==0,"Cannot replace broker");bf_compile(compiler,engine,h_join(out,"engine"),1);bf_compile(compiler,"apps/collie/desktop/ui-host.flex",h_join(out,"ui-host"),0);bf_compile(compiler,"apps/collie/desktop/service.flex",h_join(out,"service-native"),1);bf_compile(compiler,desktop,h_join(out,"collie-desktop"),0);bf_resources(out);let link=h_join(out,h_cat("collie.new-",h_int(syscall(39,0,0,0,0,0,0))));syscall(87,link,0,0,0,0,0);h_assert(syscall(88,"collie-desktop",link,0,0,0,0)==0 && syscall(82,link,h_join(out,"collie"),0,0,0,0)==0,"Cannot replace launcher");h_print(1,h_cat("Built ",h_join(out,"collie\n")));return 0;}
