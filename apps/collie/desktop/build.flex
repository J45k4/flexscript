global bf_exports=0;global bf_seen=0;global bf_globals=0;global bf_functions=0;
fn bf_quote(text){let out=h_buffer();h_text(out,"\"");let i=0;while load8(text+i){let c=load8(text+i);if c==10{h_text(out,"\\n");}else if c==13{h_text(out,"\\r");}else if c==9{h_text(out,"\\t");}else{h_assert(c>=32,"Unsupported control byte in embedded source");if c==34 || c==92{h_text(out,"\\");}h_append(out,text+i,1);}i=i+1;}h_text(out,"\"");return h_data(out);}
fn bf_letter(c){return (c>=65 && c<=90)||(c>=97 && c<=122)||c==95;}
fn bf_end(text,at){let c=load8(text+at);let end=at+1;if c==34{while load8(text+end) && load8(text+end)!=34{if load8(text+end)==92 && load8(text+end+1){end=end+1;}end=end+1;}h_assert(load8(text+end)==34,"Unclosed source string");return end+1;}if c==47 && load8(text+end)==47{while load8(text+end) && load8(text+end)!=10{end=end+1;}return end;}if bf_letter(c){while bf_letter(load8(text+end)) || (load8(text+end)>=48 && load8(text+end)<=57){end=end+1;}}return end;}
fn bf_word(text,at,end,word){return end-at==h_len(word) && h_bytes(text+at,word,end-at);}
fn bf_space(text,at){while load8(text+at)==32 || load8(text+at)==9 || load8(text+at)==13 || load8(text+at)==10{at=at+1;}return at;}
fn bf_visit(path){path=h_real(path);if j_get(bf_seen,path){return 0;}j_set(bf_seen,path,j_bool(1));let lowered=j_get(bf_exports,path);let source=0;if lowered{source=j_value(lowered);}else{source=h_read(path);}let stripped=h_buffer();let at=0;let start=0;let depth=0;while load8(source+at){let end=bf_end(source,at);let c=load8(source+at);if depth==0 && (bf_word(source,at,end,"import") || bf_word(source,at,end,"extend")){let imported=bf_word(source,at,end,"import");let quoted=bf_space(source,end);h_assert(load8(source+quoted)==34,"Literal module path required");let stop=bf_end(source,quoted);let target=j_value(j_parse(h_slice(source+quoted,stop-quoted)));if imported{bf_visit(h_join(h_dir(path),target));}let finish=stop;while load8(source+finish) && load8(source+finish)!=59{finish=bf_end(source,finish);}h_assert(load8(source+finish)==59,"Unterminated module directive");h_append(stripped,source+start,at-start);at=finish+1;start=at;}else{if end==at+1{if c==123{depth=depth+1;}if c==125{depth=depth-1;}}at=end;}}h_text(stripped,source+start);source=h_data(stripped);at=0;start=0;depth=0;let function=0;while load8(source+at){let end=bf_end(source,at);let c=load8(source+at);if depth==0 && bf_word(source,at,end,"fn"){function=1;}if end==at+1{if c==123{depth=depth+1;}else if c==125{depth=depth-1;if !depth && function{h_append(bf_functions,source+start,end-start);h_text(bf_functions,"\n");start=end;function=0;}}else if c==59 && !depth{h_append(bf_globals,source+start,end-start);h_text(bf_globals,"\n");start=end;}}at=end;}h_assert(!depth && !function,"Unbalanced source module");return 0;}
fn bf_flatten(entries){bf_seen=j_object();bf_globals=h_buffer();bf_functions=h_buffer();let i=0;while i<h_count(entries){bf_visit(h_at(entries,i));i=i+1;}return 0;}
fn bf_rewrite(source,names){let out=h_buffer();let at=0;while load8(source+at){let end=bf_end(source,at);let replacement=0;if bf_letter(load8(source+at)){replacement=j_get(names,h_slice(source+at,end-at));}if replacement{h_text(out,j_value(replacement));}else{h_append(out,source+at,end-at);}at=end;}return h_data(out);}
fn bf_reset(globals,name){let out=h_buffer();h_text(out,h_cat3("fn ",name,"(){\n"));let at=0;while load8(globals+at){let end=bf_end(globals,at);if bf_word(globals,at,end,"global"){let start=bf_space(globals,end);let name_end=bf_end(globals,start);let equals=bf_space(globals,name_end);h_assert(load8(globals+equals)==61,"Global initializer required");let finish=equals+1;while load8(globals+finish) && load8(globals+finish)!=59{finish=bf_end(globals,finish);}h_assert(load8(globals+finish)==59,"Unclosed global initializer");h_append(out,globals+start,finish-start+1);h_text(out,"\n");at=finish+1;}else{at=end;}}h_text(out,"return 0;}\n");return h_data(out);}
fn bf_range(source,begin,end,replacement){let at=h_find(source,begin);h_assert(at>=0,h_cat("Missing build marker: ",begin));let finish=h_find(source+at,end);h_assert(finish>=0,h_cat("Missing build marker: ",end));return h_cat3(h_slice(source,at),replacement,source+at+finish);}
fn bf_lower(compiler,out){let entry=h_join(out,"ui-entry.flex");let source=h_cat3("import ",j_dump(j_string(h_real("apps/collie/ui/app.flex"))),";\n");source=h_cat(source,h_cat3("extend ",j_dump(j_string(h_real("libs/ui/syntax.flex")))," with \"desktop-source:cu_desktop\";\nfn main(){return 0;}\n"));h_save(entry,source);let result=h_wait(h_spawn(h_args(compiler,entry,"-o",h_join(out,"ui-check"),0,0),"",0));let bytes=h_err(result);let n=h_len(bytes);let at=0;bf_exports=j_object();while at<n{let end=at;while end<n && load8(bytes+end)!=10{end=end+1;}let line=h_slice(bytes+at,end-at);at=end+1;if h_starts(line,"FLEXSCRIPT_UI_MODULE "){let p=21;while load8(line+p)>=48 && load8(line+p)<=57{p=p+1;}let path_size=h_number(h_slice(line+21,p-21));p=bf_space(line,p);let source_size=h_number(line+p);h_assert(path_size>0 && path_size<16384 && source_size>=0 && source_size<1048576 && at+path_size+source_size<n,"Invalid UI export frame");let path=h_slice(bytes+at,path_size);at=at+path_size;let value=h_slice(bytes+at,source_size);at=at+source_size;h_assert(load8(bytes+at)==10,"Invalid UI export terminator");at=at+1;j_set(bf_exports,h_real(path),j_string(value));}else if h_len(line){h_print(2,line);h_print(2,"\n");}}h_assert(h_status(result)==0,"Shared UI lowering failed");h_assert(j_get(bf_exports,h_real("apps/collie/ui/app.flex")),"Shared UI compiler did not export the screen");return 0;}
fn bf_engine(out){let entries=h_vec();let names=j_parse("[\"compiler/main.flex\",\"apps/collie/adapters/linux.flex\",\"apps/collie/providers/codex.flex\",\"apps/collie/core/scheduler.flex\",\"apps/collie/core/checkpoint.flex\",\"apps/collie/core/recall.flex\",\"apps/collie/core/hardware.flex\",\"apps/collie/core/card-handler.flex\",\"apps/collie/providers/stream.flex\",\"apps/collie/providers/images.flex\"]");let i=0;while i<j_count(names){h_add(entries,j_value(j_at(names,i)));i=i+1;}bf_flatten(entries);let mapping=j_parse("{\"alloc\":\"ca_alloc\",\"syscall\":\"ca_host_syscall\",\"main\":\"ca_cli_main\",\"ffi_open\":\"ca_disabled_ffi_open\",\"ffi_symbol\":\"ca_disabled_ffi_symbol\",\"ffi_call\":\"ca_disabled_ffi_call\",\"ffi_call_i32\":\"ca_disabled_ffi_call_i32\",\"ffi_call_u32\":\"ca_disabled_ffi_call_u32\"}");let globals=bf_rewrite(h_data(bf_globals),mapping);let functions=bf_rewrite(h_data(bf_functions),mapping);functions=h_replace(functions,"fn next() {","fn next() {ca_compile_tick();");functions=h_replace(functions,"vm_execute(main_index);","cv_execute(main_index);");bf_flatten(h_args("apps/collie/android/engine.flex",0,0,0,0,0));globals=h_cat(globals,h_data(bf_globals));let extra=h_data(bf_functions);let reset=bf_reset(globals,"ca_reset_globals");let guest=h_buffer();names=j_parse("[\"apps/collie/android/guest-files.flex\",\"apps/collie/guest/workers.flex\",\"apps/collie/guest/memory.flex\",\"apps/collie/guest/hardware.flex\",\"apps/collie/guest/imagegen.flex\",\"apps/collie/guest/haptics.flex\",\"apps/collie/guest/sensor-direct.flex\",\"apps/collie/guest/usb-iso.flex\",\"apps/collie/guest/usb-serial.flex\",\"apps/collie/guest/nfc.flex\",\"apps/collie/guest/uwb.flex\",\"apps/collie/guest/camera.flex\",\"apps/collie/guest/accessibility.flex\",\"apps/collie/guest/ble.flex\",\"apps/collie/guest/hardware-access.flex\"]");i=0;while i<j_count(names){h_text(guest,h_read(j_value(j_at(names,i))));h_text(guest,"\n");i=i+1;}h_text(guest,"\n");let hardware=h_read("apps/collie/desktop/hardware-api.txt");let embedded=h_cat3("fn ca_guest_extra(){return ",bf_quote(h_data(guest)),";}\n");embedded=h_cat(embedded,h_cat3("fn ca_card_guest(){return ",bf_quote(h_read("apps/collie/guest/card-handler.flex")),";}\n"));embedded=h_cat(embedded,h_cat3("fn ca_hardware_index(){return ",bf_quote(hardware),";}\n"));embedded=h_cat(embedded,h_cat3("fn ca_hardware_api(){return ",bf_quote(hardware),";}\n"));
    extra=h_replace(extra,"Android grants","Linux desktop grants");extra=h_replace(extra,"an initially empty app-private filesystem rooted at /","a persistent filesystem rooted at /, mapped to the chosen project folder or this conversation's private files");let at=0;let changed=h_buffer();while load8(extra+at){let end=bf_end(extra,at);if load8(extra+at)==34 && h_starts(extra+at,"\"\\nANDROID HARDWARE:"){h_text(changed,bf_quote(hardware));}else{h_append(changed,extra+at,end-at);}at=end;}extra=h_data(changed);
    let additions="    text=h_cat(text,h_cat3(\"\\nDesktop project: \",cj_text(cw_config,\"project_name\"),\". Host folder: \"));text=h_cat(text,j_dump(j_string(cj_text(cw_config,\"files_directory\"))));text=h_cat(text,\". Guest / maps to this folder; pass guest-relative paths to fs_* and view_* APIs. When giving the user a full host file path, append the relative path to this folder.\\n\");\n";
    additions=h_cat(additions,"    text=h_cat(text,\"\\nIMAGE GENERATION: imagen(prompt,path) generates one image using the configured image provider and saves it into the current project folder. Use a project-relative .png path, for example assets/logo.png. Prompt limit 16 KiB, path limit 1024 bytes, at most four images/program. It requires Model tools and workers (workers) and Write workspace files (files_write) grants. Commit/rollback any transaction first. The VM suspends without replay while generation runs. It returns a db_text containing the saved relative path, or 0 with db_error() on failure. A real preview is shown automatically; no base64 image data enters stdout. Credentials stay in the host. Provider failures/refusals are errors, never fabricated images.\\n\");\n");extra=h_replace(extra,"    j_set(body,\"instructions\",j_string(text));",h_cat(additions,"    j_set(body,\"instructions\",j_string(text));"));
    let stubs="fn ca_disabled_ffi_open(a){return 0;}\nfn ca_disabled_ffi_symbol(a,b){return 0;}\nfn ca_disabled_ffi_call(a,b,c,d,e,f,g){return 0;}\nfn ca_disabled_ffi_call_i32(a,b,c,d,e,f,g){return 0;}\nfn ca_disabled_ffi_call_u32(a,b,c,d,e,f,g){return 0;}\n";let source=h_cat3(globals,functions,h_cat3(stubs,reset,h_cat(embedded,extra)));source=h_cat(source,h_read("apps/collie/desktop/engine-main.flex"));let path=h_join(out,"engine-generated.flex");h_save(path,source);return path;
}
fn bf_broker(out){let source=h_read("apps/collie/android/host.c");source=bf_range(source,"static long raw(","static long length(","");source=bf_range(source,"static long checkpoint[13];","#define MAX_MAPS","");source=bf_range(source,"static long java_bytes(","static long network_get(",h_read("apps/collie/desktop/platform-bridge.c"));source=h_replace(source,"if (!jni_env || !jni_class)\n        return (long)\"{\\\"error\\\":\\\"HTTPS requires the Android host.\\\"}\";","");let at=h_find(source,"static void *address(");h_assert(at>=0,"Missing broker export boundary");source=h_slice(source,at);source=h_replace(source,"B st[128];","B st[128] = {0};");let before="long fd = track(raw(56, -100, (long)base, 0x4000 | 0x8000, 0, 0, 0));";h_assert(h_find(source,before)>=0,"Missing workspace root adapter");source=h_replace(source,before,"long fd = track(cd_workspace_root(base));");let clean=h_buffer();let i=0;let start=0;while load8(source+i){if (i==0 || load8(source+i-1)==10) && h_starts(source+i,"extern long collie_android_"){h_append(clean,source+start,i-start);while load8(source+i) && load8(source+i)!=59{i=i+1;}if load8(source+i){i=i+1;}start=i;}else{i=i+1;}}h_text(clean,source+start);source=h_cat(h_read("apps/collie/desktop/broker-prefix.c"),h_data(clean));let path=h_join(out,"broker-generated.c");h_save(path,source);return path;}
fn bf_compile(compiler,source,target,direct){let temporary=h_cat(target,h_cat(".new-",h_int(syscall(39,0,0,0,0,0,0))));let args=h_args(compiler,0,0,0,0,0);if direct{h_add(args,"--native-pipeline");h_add(args,"direct");}else if h_equal(target+h_len(h_dir(target))+1,"collie-desktop"){h_add(args,"--native-literals");h_add(args,"shared");}h_add(args,source);h_add(args,"-o");h_add(args,temporary);let child=h_run(args);if h_status(child){h_print(2,h_err(child));syscall(87,temporary,0,0,0,0,0);h_die(h_cat("Compilation failed: ",source));}h_assert(syscall(82,temporary,target,0,0,0,0)==0,"Cannot replace executable");return 0;}
fn bf_resources(out){let files=j_parse("[\"desktop/icons/new-chat.svg\",\"desktop/icons/new-project.svg\",\"desktop/icons/settings.svg\",\"android/res/drawable-nodpi/collie_border_collie.png\"]");let i=0;while i<j_count(files){let relative=j_value(j_at(files,i));let path=h_join(h_join(out,"resources/collie"),relative);h_mkdir(h_dir(path));let bytes=h_read(h_join("apps/collie",relative));let n=h_file_size;let temporary=h_cat(path,".new");h_save_bytes(temporary,bytes,n,420);h_assert(syscall(82,temporary,path,0,0,0,0)==0,"Cannot replace application resource");i=i+1;}let c=image_context();h_assert(c,"Cannot initialize native icon renderer");let names=j_parse("[\"new-chat\",\"new-project\",\"settings\"]");i=0;while i<3{let image=ci_icon(c,i);h_assert(image,image_error(c));let png=image_encode_png(c,image);image_free(image);h_assert(png,image_error(c));let path=h_join(h_join(out,"resources/collie/desktop/icons"),h_cat(j_value(j_at(names,i)),".png"));let temporary=h_cat(path,".new");h_save_bytes(temporary,image_blob_data(png),image_blob_size(png),420);image_blob_free(png);h_assert(syscall(82,temporary,path,0,0,0,0)==0,"Cannot replace native icon");i=i+1;}image_context_free(c);return 0;}
fn main(argc,argv){h_environment(argc,argv);h_assert(h_exists("apps/collie/desktop/main.flex"),"Run from the Flexscript worktree root");let compiler=h_real(b_option(argc,argv,"--compiler","build/collie-desktop/compiler"));let directory=b_option(argc,argv,"--out","build/collie-desktop");h_mkdir(directory);let out=h_real(directory);bf_lower(compiler,out);let exports=bf_exports;let engine=bf_engine(out);bf_exports=exports;bf_flatten(h_args("apps/collie/desktop/main.flex",0,0,0,0,0));let desktop=h_join(out,"desktop-generated.flex");h_save(desktop,h_cat(h_data(bf_globals),h_data(bf_functions)));let broker=bf_broker(out);let temporary=h_join(out,h_cat("broker.new-",h_int(syscall(39,0,0,0,0,0,0))));let args=h_args("cc","-shared","-fPIC","-O2","-Wall","-Wextra");h_add(args,"-Wno-unused-variable");h_add(args,broker);h_add(args,"-o");h_add(args,temporary);h_check(h_run(args),0,0);h_assert(syscall(82,temporary,h_join(out,"broker.so"),0,0,0,0)==0,"Cannot replace broker");bf_compile(compiler,engine,h_join(out,"engine"),1);bf_compile(compiler,"apps/collie/desktop/ui-host.flex",h_join(out,"ui-host"),0);bf_compile(compiler,"apps/collie/desktop/service.flex",h_join(out,"service-native"),1);bf_compile(compiler,desktop,h_join(out,"collie-desktop"),0);bf_resources(out);let link=h_join(out,h_cat("collie.new-",h_int(syscall(39,0,0,0,0,0,0))));syscall(87,link,0,0,0,0,0);h_assert(syscall(88,"collie-desktop",link,0,0,0,0)==0 && syscall(82,link,h_join(out,"collie"),0,0,0,0)==0,"Cannot replace launcher");h_print(1,h_cat("Built ",h_join(out,"collie\n")));return 0;}
