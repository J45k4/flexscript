// Collie's Linux host: native Flexscript, with no interpreter runtime.
import "host/commands.flex";
global sv_arena_floor=0;
fn sv_option(argc,argv,key,fallback){let i=1;while i<argc{if h_equal(load64(argv+i*8),key){if i+1>=argc{h_die("Option needs a value");}return load64(argv+(i+1)*8);}i=i+1;}return fallback;}
fn sv_arena_bytes(){let bytes=0;let block=h_blocks;while block{bytes=bytes+load64(block+8);block=load64(block);}return bytes;}
fn sv_compact(){let root=sv;if scm_hub{root=scm_hub;}let text=j_dump(root);let n=h_len(text);let copy=alloc(n+1);h_copy(copy,text,n+1);h_reset(0);if scm_hub{scm_hub=sj_parse(copy);sv=cj_get(cj_get(scm_hub,"contexts"),cj_text(scm_hub,"active"));}else{sv=sj_parse(copy);}syscall(11,copy,n+1,0,0,0,0);h_assert(sv,"Native desktop state compaction failed");sv_arena_floor=sv_arena_bytes();return 0;}
fn sv_shutdown_tasks(){if !sv_n("shutdown_at"){sh_n(sv,"shutdown_at",net_now()+3000);}let fields=j_value(sv_tasks());let i=0;while i<h_count(fields){let task=load64(h_at(fields,i)+8);sh_b(task,"cancelled",1);st_dispose(task);if net_now()<sv_n("shutdown_at"){let request=sv_request("failure");j_set(request,"state",cj_get(task,"state"));sh_s(request,"error","Cancelled.");sh_b(request,"cancelled",1);sh_b(request,"fixture",sv_n("fixture_enabled"));se=0;sg_ignores_cancel=1;let transition=sv_call(8,cj_int(task,"id"),request);sg_ignores_cancel=0;if transition && !cj_int(task,"id"){j_set(sv,"state",j_get(transition,"state"));}}i=i+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);sh_libc=ffi_open("libc.so.6");sv=j_object();let multi=1;while multi<argc{if h_equal(load64(argv+multi*8),"--multi-chat"){sh_b(sv,"multi_chat",1);}multi=multi+1;}sv_input=alloc(8388609);syscall(72,0,4,2048,0,0,0);let here=h_dir(h_real(load64(argv)));let datahome=h_getenv("XDG_DATA_HOME");if !datahome{datahome=h_join(h_getenv("HOME"),".local/share");}let data=sv_option(argc,argv,"--data",h_join(datahome,"collie"));h_mkdir(data);data=sh_real(data);h_assert(data,se);sh_s(sv,"data",data);let lease=syscall(2,h_join(data,"desktop.lock"),0x80042,384,0,0,0);if lease<0 || syscall(73,lease,6,0,0,0,0)<0{h_print(2,"This Collie data folder is already open\n");return 1;}sh_s(sv,"engine",sv_option(argc,argv,"--engine",h_join(here,"engine")));let packaged=h_join(here,"resources/collie/desktop");if !h_isdir(packaged){packaged=h_join(here,"../../apps/collie/desktop");}let app=sv_option(argc,argv,"--app",packaged);app=sh_real(app);h_assert(app,se);sh_s(sv,"app",app);let settings=sh_read_json(h_join(data,"settings.json"),j_object(),8388608);h_assert(settings,se);j_set(sv,"settings",settings);let model=cj_text(settings,"model");if !h_len(model){model="gpt-6.1-sol";}sh_s(sv,"model",model);let fixture=sv_option(argc,argv,"--fixture",0);sh_b(sv,"fixture_enabled",fixture!=0);if fixture{let value=sh_read_json(fixture,j_array(),8388608);h_assert(value,se);j_set(sv,"fixture",value);}let auth=sv_option(argc,argv,"--auth",0);sh_b(sv,"explicit_auth",auth!=0);sh_b(sv,"account_metadata",!fixture || auth!=0);if !auth{auth=cj_text(settings,"auth_file");if !h_len(auth){let codex=h_getenv("CODEX_HOME");if !codex{codex=h_join(h_getenv("HOME"),".codex");}auth=h_join(codex,"auth.json");}}if load8(auth)!=47{auth=h_absolute(auth);}sh_s(sv,"auth_file",auth);if !sa_init(){h_print(2,se);return 1;}let projects=sh_read_json(h_join(data,"projects.json"),j_array(),1048576);if !projects || j_kind(projects)!=3{h_print(2,"Invalid project registry\n");return 1;}let i=0;while i<j_count(projects){let row=j_at(projects,i);if !sh_valid(cj_text(row,"id"),80) || !h_len(cj_text(row,"name")) || load8(cj_text(row,"path"))!=47{h_print(2,"Invalid project registry\n");return 1;}i=i+1;}j_set(sv,"projects",projects);j_set(sv,"tasks",j_object());j_set(sv,"commands",j_array());j_set(sv,"handles",j_array());j_set(sv,"login_view",j_object());j_set(sv,"state",j_object());j_set(sv,"permissions",j_object());j_set(sv,"navigation",j_object());sh_s(sv,"project_id","");let current=cj_text(settings,"current");if !sh_valid(current,80) || !h_exists(h_join(h_join(h_join(data,"sessions"),current),"session.json")){current=0;}if !sv_open(current,0){h_print(2,se);h_print(2,"\n");return 1;}
    if sv_n("multi_chat"){scm_init();}sv_compact();sv_idle_poll=alloc(8);let frame=0;while !sv_eof{sv_poll_input();cn_pump();ct_poll();let queue=sh_array(sv,"commands");if scm_hub{queue=scm_queue();}if j_count(queue){let command=j_at(queue,0);let rest=j_array();i=1;while i<j_count(queue){j_push(rest,j_at(queue,i));i=i+1;}if scm_hub{j_set(scm_hub,"commands",rest);}else{j_set(sv,"commands",rest);}se=0;if scm_hub{scm_dispatch(command);}else{sv_command(command);}if se{sv_notice(se);se=0;}}if scm_hub{scm_step();}else{if c_flag(sv_get("login_view"),"running"){sv_dirty=1;}sl_poll();let tasks=sv_tasks();let fields=j_value(tasks);i=0;while i<h_count(fields) && !sv_eof{let task=load64(h_at(fields,i)+8);if sv_task(cj_int(task,"id"))==task{sv_dirty=1;se=0;st_step(task);}i=i+1;}if !sv_eof && (sv_n("schedule_needed") || (j_count(sv_tasks()) && net_now()>=sv_n("schedule_at"))){se=0;st_schedule(0);if se{sv_notice(se);se=0;}}}frame=frame+1;if frame%32==0 && sv_dirty && sv_arena_bytes()>sv_arena_floor+8388608{sv_compact();sv_dirty=0;}if (scm_hub && !scm_busy() && !j_count(scm_queue())) || (!scm_hub && !j_count(sv_tasks()) && !j_count(sh_array(sv,"commands")) && !c_flag(sv_get("login_view"),"running")){store64(sv_idle_poll,1<<32);syscall(7,sv_idle_poll,1,50,0,0,0);}else{h_sleep(2);}}
    ct_shutdown();if scm_hub{scm_shutdown();}else{sl_cancel(0);sv_shutdown_tasks();}sp_close(0,0);se=0;sv_save();cn_shutdown();si_shutdown();h_close(lease);syscall(11,sv_input,8388609,0,0,0,0);return 0;
}
