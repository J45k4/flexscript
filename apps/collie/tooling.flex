// Repository-root build/test entry points; no model connection is needed.
import "../../scripts/lib/build.flex";

fn collie_embed() {
    let text=h_read("apps/collie/guest/runtime.flex");let b=h_buffer();h_text(b,"// Generated by scripts/embed-collie-guest.flex; do not edit directly.\nfn cg_source() {return \"");let i=0;
    while load8(text+i) {let c=load8(text+i);if c==10 {h_text(b,"\\n");}else if c==13 {h_text(b,"\\r");}else if c==9 {h_text(b,"\\t");}else {if c==34 || c==92 {h_text(b,"\\");}h_append(b,text+i,1);}i=i+1;}
    h_text(b,"\";}\n");h_save("apps/collie/guest/source.flex",h_data(b));return 0;
}
fn collie_build(compiler) {
    collie_embed();
    h_mkdir("build");
    h_compile(compiler,"apps/collie/main.flex","build/collie");
    h_print(1,"Built build/collie\n");return 0;
}
fn collie_test(compiler,with_vm) {
    collie_build(compiler);
    h_compile(compiler,"apps/collie/tests/test.flex","build/test-collie");
    let args=h_args(h_real("build/test-collie"),compiler,h_real("build/collie"),0,0,0);
    if with_vm {h_add(args,"--vm");}
    let child=h_wait(h_spawn(args,"",h_real("apps/collie")));
    h_print(1,h_out(child));h_print(2,h_err(child));return h_status(child);
}
