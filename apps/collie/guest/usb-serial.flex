// USB UART protocols run inside Flexscript. Only USB objects/I/O live in Java.
// State is a typed list; saving it preserves buffered data, never OS ownership.
// Open again after restart/disconnect/revocation. Stop: 0=1, 1=1.5, 2=2 bits;
// parity: 0=none, 1=odd, 2=even, 3=mark, 4=space. No hardware flow control.
fn serial_error(code,text){db_last_error=text;db_last_error_details=db_list();db_add(db_last_error_details,db_text(code));db_add(db_last_error_details,db_text(text));return 0;}
fn serial_clear(){db_last_error="";db_last_error_details=0;return 0;}
fn serial_map(map,key,value){let row=db_list();db_add(row,db_text(key));db_add(row,value);return db_add(map,row);}
fn serial_store32(p,n){let i=0;while i<4{store8(p+i,(n>>(i*8))&255);i=i+1;}return p;}
fn serial_number(map,key){return db_word(device_field(map,key));}
fn serial_replace(state,index,value){store64(db_word(state)+index*8,value);return value;}
fn serial_word(state,index){return db_word(db_at(state,index));}
fn serial_valid(state){if db_count(state)!=20 || db_kind(db_at(state,0))!=2 || !worker_equal(serial_word(state,0),"collie-usb-serial-v1") || serial_word(state,19){return serial_error("stale_handle","Invalid or closed serial state. Open the USB serial port again.");}return 1;}
fn serial_handle(state){return serial_word(state,1);}
fn serial_fail_open(state){let text=db_last_error;let details=db_last_error_details;device_close(serial_handle(state));serial_replace(state,19,db_int(1));db_last_error=text;db_last_error_details=details;return 0;}
fn serial_driver(vendor,product){
    if vendor==0x0403 && (product==0x6001 || product==0x6010 || product==0x6011 || product==0x6014 || product==0x6015){return "ftdi";}
    if vendor==0x10c4 && (product==0xea60 || product==0xea70 || product==0xea71){return "cp210x";}
    if vendor==0x1a86 && (product==0x7523 || product==0x5523 || product==0x7522){return "ch34x";}return "";
}
fn serial_interfaces(id,configuration){let out=db_list();let offset=0;while offset>=0{let page=usb_interfaces(id,configuration,offset,8);if !page{return 0;}let rows=device_field(page,"interfaces");let i=0;while i<db_count(rows){db_add(out,db_at(rows,i));i=i+1;}offset=serial_number(page,"next");}return out;}
fn serial_endpoints(intf){let out=db_list();let input=0;let output=0;let packet=0;let notification=0;let endpoints=device_field(intf,"endpoints");let i=0;while i<db_count(endpoints){let e=db_at(endpoints,i);let address=serial_number(e,"address");let kind=serial_number(e,"type");if kind==2{if address&128{input=address;packet=serial_number(e,"maximum_packet_size");}else{output=address;}}if kind==3 && (address&128){notification=address;}i=i+1;}db_add(out,db_int(input));db_add(out,db_int(output));db_add(out,db_int(packet));db_add(out,db_int(notification));return out;}
fn serial_port(driver,configuration,data_interface,control_interface,alternate){let out=db_list();serial_map(out,"driver",db_text(driver));serial_map(out,"configuration",db_int(configuration));serial_map(out,"data_interface",db_int(data_interface));serial_map(out,"control_interface",db_int(control_interface));serial_map(out,"alternate",db_int(alternate));return out;}
fn serial_ports(id){
    serial_clear();let info=usb_info(id);if !info{return 0;}let vendor=serial_driver(serial_number(info,"vendor_id"),serial_number(info,"product_id"));let out=db_list();let offset=0;
    while offset>=0{let page=usb_configurations(id,offset,8);if !page{return 0;}let configs=device_field(page,"configurations");let c=0;while c<db_count(configs){let config=serial_number(db_at(configs,c),"id");let interfaces=serial_interfaces(id,config);if !interfaces{return 0;}let i=0;while i<db_count(interfaces){let intf=db_at(interfaces,i);let endpoints=serial_endpoints(intf);let number=serial_number(intf,"id");let driver=vendor;let control=number;
        if !db_len(driver) && serial_number(intf,"class")==10{let j=0;let controls=0;let first=-1;let adjacent=-1;while j<db_count(interfaces){let candidate=db_at(interfaces,j);if serial_number(candidate,"class")==2 && serial_number(candidate,"subclass")==2{controls=controls+1;first=serial_number(candidate,"id");if first+1==number{adjacent=first;}}j=j+1;}if adjacent>=0{control=adjacent;driver="cdc";}else if controls==1{control=first;driver="cdc";}}
        if db_len(driver) && db_word(db_at(endpoints,0)) && db_word(db_at(endpoints,1)){db_add(out,serial_port(driver,config,number,control,serial_number(intf,"alternate")));}i=i+1;
    }c=c+1;}offset=serial_number(page,"next");}return out;
}
fn serial_out(state,type,request,value,index,data){let result=usb_control_out(serial_handle(state),type,request,value,index,data,2000);if !result{return 0;}if db_word(result)!=db_bytes(data){return serial_error("short_transfer","Serial control write completed with an unexpected byte count.");}return 1;}
fn serial_empty(state,type,request,value,index){return serial_out(state,type,request,value,index,db_blob("",0));}
fn serial_in(state,type,request,value,index,bytes){let result=usb_control_in(serial_handle(state),type,request,value,index,bytes,2000);if !result{return 0;}if db_bytes(result)!=bytes{return serial_error("short_transfer","Serial control read returned an incomplete response.");}return result;}
// A CDC Union descriptor can bind interfaces which are not numerically adjacent.
fn serial_cdc_control(descriptors,configuration,data_interface,fallback){let p=db_word(descriptors);let n=db_bytes(descriptors);let i=0;let active=-1;let found=-1;while i+2<=n{let bytes=load8(p+i);let kind=load8(p+i+1);if bytes<2 || bytes>n-i{return -2;}if kind==2 && bytes>=9{active=load8(p+i+5);}if active==configuration && kind==0x24 && bytes>=5 && load8(p+i+2)==6{let j=4;while j<bytes{if load8(p+i+j)==data_interface{let master=load8(p+i+3);if found>=0 && found!=master{return -2;}found=master;}j=j+1;}}i=i+bytes;}if i!=n{return -2;}if found>=0{return found;}return fallback;}
fn serial_open(id,port,force){
    serial_clear();let driver=device_field(port,"driver");if db_kind(driver)!=2 || (!worker_equal(db_word(driver),"cdc") && !worker_equal(db_word(driver),"ftdi") && !worker_equal(db_word(driver),"cp210x") && !worker_equal(db_word(driver),"ch34x")){return serial_error("unsupported_driver","Choose cdc, ftdi, cp210x or ch34x using serial_ports or serial_port.");}
    let configuration=serial_number(port,"configuration");let data_interface=serial_number(port,"data_interface");let control=serial_number(port,"control_interface");let alternate=serial_number(port,"alternate");if configuration<1 || configuration>255 || data_interface<0 || data_interface>255 || control<0 || control>255 || alternate<0 || alternate>255 || force<0 || force>1{return serial_error("invalid_argument","Invalid serial port descriptor or force flag.");}
    let rows=serial_interfaces(id,configuration);if !rows{return 0;}let chosen=0;let notification=0;let i=0;while i<db_count(rows){let row=db_at(rows,i);if serial_number(row,"id")==data_interface && serial_number(row,"alternate")==alternate{chosen=row;}i=i+1;}
    if !chosen{return serial_error("invalid_argument","Selected USB serial data interface does not exist.");}let endpoints=serial_endpoints(chosen);let input=db_word(db_at(endpoints,0));let output=db_word(db_at(endpoints,1));let packet=db_word(db_at(endpoints,2));if !input || !output || packet<3 || packet>1024{return serial_error("unsupported_port","Serial port needs bulk IN/OUT endpoints and a valid USB packet size.");}
    let handle=usb_open(id);if !handle{return 0;}let state=db_list();db_add(state,db_text("collie-usb-serial-v1"));db_add(state,handle);db_add(state,driver);db_add(state,db_int(configuration));db_add(state,db_int(data_interface));db_add(state,db_int(control));db_add(state,db_int(alternate));db_add(state,db_int(input));db_add(state,db_int(output));db_add(state,db_int(packet));i=10;while i<20{db_add(state,db_int(0));i=i+1;}serial_replace(state,17,db_blob("",0));
    let descriptors=usb_descriptors(db_word(handle));if !descriptors{return serial_fail_open(state);}if db_bytes(descriptors)<18 || load8(db_word(descriptors))<18 || load8(db_word(descriptors)+1)!=1{serial_error("invalid_response","USB device descriptor is incomplete.");return serial_fail_open(state);}let bcd=load8(db_word(descriptors)+12)|(load8(db_word(descriptors)+13)<<8);serial_replace(state,10,db_int(bcd));
    if worker_equal(db_word(driver),"cdc"){control=serial_cdc_control(descriptors,configuration,data_interface,control);if control<0{serial_error("invalid_response","CDC interface association descriptors are malformed or ambiguous.");return serial_fail_open(state);}serial_replace(state,5,db_int(control));let master=0;i=0;while i<db_count(rows){let row=db_at(rows,i);if serial_number(row,"id")==control && serial_number(row,"alternate")==0{master=row;}i=i+1;}if !master{serial_error("invalid_argument","CDC control interface is missing.");return serial_fail_open(state);}notification=db_word(db_at(serial_endpoints(master),3));serial_replace(state,16,db_int(notification));}
    if worker_equal(db_word(driver),"ftdi") && bcd<0x0400{serial_error("unsupported_device","FTDI AM/SIO devices require an older baud protocol. This driver supports BM, R, X, 2232 and H variants.");return serial_fail_open(state);}
    let current=device_info(db_word(handle));if !current{return serial_fail_open(state);}if serial_number(current,"configuration")!=configuration{if !usb_configure(db_word(handle),configuration){return serial_fail_open(state);}}
    if control!=data_interface && worker_equal(db_word(driver),"cdc"){if !usb_claim(db_word(handle),control,0,force){return serial_fail_open(state);}}
    if !usb_claim(db_word(handle),data_interface,alternate,force){return serial_fail_open(state);}
    if worker_equal(db_word(driver),"ftdi"){if !serial_empty(state,0x40,0,0,data_interface+1) || !serial_empty(state,0x40,2,0,data_interface+1) || !serial_empty(state,0x40,9,16,data_interface+1){return serial_fail_open(state);}}
    if worker_equal(db_word(driver),"cp210x"){if !serial_empty(state,0x41,0,1,data_interface){return serial_fail_open(state);}let flow=alloc(16);store64(flow,0x4000000001);store64(flow+8,0);if !serial_out(state,0x41,0x13,0,data_interface,db_blob(flow,16)){return serial_fail_open(state);}}
    if worker_equal(db_word(driver),"ch34x"){let version=serial_in(state,0xc0,0x5f,0,0,2);if !version{return serial_fail_open(state);}serial_replace(state,11,db_int(load8(db_word(version))));if !serial_empty(state,0x40,0xa1,0,0) || !serial_empty(state,0x40,0x9a,0x2727,0){return serial_fail_open(state);}}
    if !serial_configure(state,9600,8,0,0){return serial_fail_open(state);}if !serial_lines(state,1,1){return serial_fail_open(state);}return state;
}
fn serial_ftdi_divisor(baud){if baud<183 || baud>3000000{return 0;}let eighths=(24000000+baud/2)/baud;if eighths>131071{eighths=131071;}if eighths>8 && eighths<16 && eighths!=12{return 0;}let actual=24000000/eighths;let delta=actual-baud;if delta<0{delta=-delta;}if delta*100>baud*3{return 0;}let fractions=alloc(8);store8(fractions,0);store8(fractions+1,3);store8(fractions+2,2);store8(fractions+3,4);store8(fractions+4,1);store8(fractions+5,5);store8(fractions+6,6);store8(fractions+7,7);let encoded=(eighths/8)|(load8(fractions+eighths%8)<<14);if encoded==1{encoded=0;}else if encoded==0x4001{encoded=1;}return db_int(encoded);}
// Search documented CH34x clock divisors; prefer fact=0 for timing tolerance.
fn serial_ch_divisor(baud){if baud<50 || baud>3000000{return 0;}let best=-1;let error=baud;let ps=3;while ps>=0{let clock=1<<(12-3*ps);let div=(48000000+baud*clock/2)/(baud*clock);if div>=2 && div<=256{let actual=48000000/(clock*div);let delta=actual-baud;if delta<0{delta=-delta;}if delta<error{error=delta;best=((256-div)<<8)|ps;}}ps=ps-1;}if best<0 || error*100>baud*3{return 0;}return db_int(best);}
fn serial_configure(state,baud,bits,parity,stop){
    serial_clear();if !serial_valid(state){return 0;}if baud<50 || baud>3000000 || bits<5 || bits>8 || parity<0 || parity>4 || stop<0 || stop>2 || (stop==1 && bits!=5){return serial_error("invalid_argument","Unsupported baud/framing: use 50..3000000 baud, 5..8 data bits, parity 0..4, stop 0..2 (1.5 stops requires 5 data bits).");}
    let driver=serial_word(state,2);let control=serial_word(state,5);let data=serial_word(state,4);let frame=bits|(parity<<8)|(stop<<11);
    if worker_equal(driver,"cdc"){let bytes=alloc(7);serial_store32(bytes,baud);store8(bytes+4,stop);store8(bytes+5,parity);store8(bytes+6,bits);if !serial_out(state,0x21,0x20,0,control,db_blob(bytes,7)){return 0;}}
    if worker_equal(driver,"cp210x"){let bytes=alloc(4);serial_store32(bytes,baud);if !serial_out(state,0x41,0x1e,0,data,db_blob(bytes,4)) || !serial_empty(state,0x41,3,(bits<<8)|(parity<<4)|stop,data){return 0;}}
    if worker_equal(driver,"ftdi"){let divisor=serial_ftdi_divisor(baud);if !divisor{return serial_error("unsupported_baud","FTDI baud rate cannot be represented within 3 percent.");}let encoded=db_word(divisor);let bcd=serial_word(state,10);let index=encoded>>16;if bcd==0x0500 || bcd==0x0700 || bcd==0x0800 || bcd==0x0900{index=(index<<8)|(data+1);}if !serial_empty(state,0x40,3,encoded&65535,index) || !serial_empty(state,0x40,4,frame,data+1){return 0;}}
    if worker_equal(driver,"ch34x"){let version=serial_word(state,11);if stop==1 || (version<0x30 && (bits!=8 || parity!=0 || stop!=0)){return serial_error("unsupported_framing","This CH34x variant supports only 8N1; CH34x does not support 1.5 stop bits.");}let divisor=serial_ch_divisor(baud);if !divisor{return serial_error("unsupported_baud","CH34x baud cannot be represented within 3 percent.");}let encoded=db_word(divisor);if version>0x27{encoded=encoded|128;}let lcr=0xc0|(bits-5);if stop==2{lcr=lcr|4;}if parity{lcr=lcr|8;if parity==2 || parity==4{lcr=lcr|0x10;}if parity>=3{lcr=lcr|0x20;}}if !serial_empty(state,0x40,0x9a,0x1312,encoded){return 0;}if version>=0x30{if !serial_empty(state,0x40,0x9a,0x2518,lcr){return 0;}}}
    serial_replace(state,12,db_int(baud));serial_replace(state,13,db_int(bits));serial_replace(state,14,db_int(parity));serial_replace(state,15,db_int(stop));return 1;
}
fn serial_lines(state,dtr,rts){serial_clear();if !serial_valid(state){return 0;}if dtr<0 || dtr>1 || rts<0 || rts>1{return serial_error("invalid_argument","DTR and RTS must be 0 or 1.");}let driver=serial_word(state,2);let value=dtr|(rts<<1);if worker_equal(driver,"cdc"){return serial_empty(state,0x21,0x22,value,serial_word(state,5));}if worker_equal(driver,"ftdi"){return serial_empty(state,0x40,1,0x0300|value,serial_word(state,4)+1);}if worker_equal(driver,"cp210x"){return serial_empty(state,0x41,7,0x0300|value,serial_word(state,4));}return serial_empty(state,0x40,0xa4,(~((dtr<<5)|(rts<<6)))&65535,0);}
fn serial_break(state,enabled){serial_clear();if !serial_valid(state){return 0;}if enabled<0 || enabled>1{return serial_error("invalid_argument","Break flag must be 0 or 1.");}let driver=serial_word(state,2);if worker_equal(driver,"cdc"){let value=0;if enabled{value=65535;}return serial_empty(state,0x21,0x23,value,serial_word(state,5));}if worker_equal(driver,"cp210x"){return serial_empty(state,0x41,5,enabled,serial_word(state,4));}if worker_equal(driver,"ftdi"){let frame=serial_word(state,13)|(serial_word(state,14)<<8)|(serial_word(state,15)<<11)|(enabled<<14);return serial_empty(state,0x40,4,frame,serial_word(state,4)+1);}let data=serial_in(state,0xc0,0x95,0x1805,0,2);if !data{return 0;}let low=load8(db_word(data));let high=load8(db_word(data)+1);if enabled{low=low&254;high=high&191;}else{low=low|1;high=high|64;}return serial_empty(state,0x40,0x9a,0x1805,low|(high<<8));}
fn serial_ftdi_payload(state,raw){let n=db_bytes(raw);let packet=serial_word(state,9);let out=alloc(n+1);let at=0;let i=0;while i<n{let end=i+packet;if end>n{end=n;}if end-i<2{return serial_error("invalid_response","Truncated FTDI packet status header.");}serial_replace(state,18,db_int(load8(db_word(raw)+i)|(load8(db_word(raw)+i+1)<<8)));let j=i+2;while j<end{store8(out+at,load8(db_word(raw)+j));at=at+1;j=j+1;}i=end;}return db_blob(out,at);}
fn serial_read(state,limit,timeout_ms){
    serial_clear();if !serial_valid(state){return 0;}if limit<1 || limit>32768 || timeout_ms<1 || timeout_ms>8000{return serial_error("invalid_argument","Serial read needs 1..32768 bytes and a 1..8000 ms timeout.");}
    // Check Android ownership even when delivering previously buffered data.
    if !device_info(serial_handle(state)){return 0;}let pending=db_at(state,17);if !db_bytes(pending){let packet=serial_word(state,9);let bytes=((limit+packet-1)/packet)*packet;if worker_equal(serial_word(state,2),"ftdi"){bytes=((limit+packet-3)/(packet-2))*packet;}if bytes>32768{bytes=(32768/packet)*packet;}pending=usb_transfer_in(serial_handle(state),serial_word(state,7),bytes,timeout_ms);if !pending{return 0;}if worker_equal(serial_word(state,2),"ftdi"){pending=serial_ftdi_payload(state,pending);if !pending{return 0;}}}
    let n=db_bytes(pending);if n>limit{n=limit;}let result=db_blob(db_word(pending),n);serial_replace(state,17,db_blob(db_word(pending)+n,db_bytes(pending)-n));return result;
}
fn serial_write(state,data,timeout_ms){serial_clear();if !serial_valid(state){return 0;}if (db_kind(data)!=2 && db_kind(data)!=3) || db_bytes(data)>32768 || timeout_ms<1 || timeout_ms>8000{return serial_error("invalid_argument","Serial write needs text/blob up to 32768 bytes and a 1..8000 ms timeout.");}return usb_transfer_out(serial_handle(state),serial_word(state,8),data,timeout_ms);}
fn serial_status(state,timeout_ms){
    serial_clear();if !serial_valid(state){return 0;}if timeout_ms<1 || timeout_ms>8000{return serial_error("invalid_argument","Serial status timeout must be 1..8000 ms.");}let driver=serial_word(state,2);let raw=0;let flags=0;let line=0;
    if worker_equal(driver,"cdc"){let endpoint=serial_word(state,16);if !endpoint{return serial_error("unsupported_operation","CDC port has no serial-state notification endpoint.");}raw=usb_transfer_in(serial_handle(state),endpoint,64,timeout_ms);if !raw{return 0;}let p=db_word(raw);if db_bytes(raw)!=10 || load8(p)!=0xa1 || load8(p+1)!=0x20 || (load8(p+4)|(load8(p+5)<<8))!=serial_word(state,5) || load8(p+6)!=2 || load8(p+7){return serial_error("invalid_response","Unexpected CDC serial-state notification.");}flags=load8(p+8)|(load8(p+9)<<8);let out=db_list();serial_map(out,"carrier_detect",db_int(flags&1));serial_map(out,"dsr",db_int((flags>>1)&1));serial_map(out,"ring",db_int((flags>>3)&1));serial_map(out,"line_status",db_int(flags));serial_map(out,"raw",raw);return out;}
    if worker_equal(driver,"ftdi"){raw=serial_in(state,0xc0,5,0,serial_word(state,4)+1,2);if !raw{return 0;}flags=load8(db_word(raw));line=load8(db_word(raw)+1);}
    if worker_equal(driver,"cp210x"){raw=serial_in(state,0xc1,8,0,serial_word(state,4),1);if !raw{return 0;}flags=load8(db_word(raw));}
    if worker_equal(driver,"ch34x"){raw=serial_in(state,0xc0,0x95,0x0706,0,2);if !raw{return 0;}flags=((~load8(db_word(raw)))&15)<<4;}
    let out=db_list();serial_map(out,"cts",db_int((flags>>4)&1));serial_map(out,"dsr",db_int((flags>>5)&1));serial_map(out,"ring",db_int((flags>>6)&1));serial_map(out,"carrier_detect",db_int((flags>>7)&1));serial_map(out,"line_status",db_int(line));serial_map(out,"raw",raw);return out;
}
fn serial_info(state){serial_clear();if !serial_valid(state){return 0;}let device=device_info(serial_handle(state));if !device{return 0;}let out=db_list();serial_map(out,"device",device);serial_map(out,"driver",db_at(state,2));serial_map(out,"baud",db_at(state,12));serial_map(out,"data_bits",db_at(state,13));serial_map(out,"parity",db_at(state,14));serial_map(out,"stop",db_at(state,15));serial_map(out,"buffered_bytes",db_int(db_bytes(db_at(state,17))));serial_map(out,"last_packet_status",db_at(state,18));return out;}
fn serial_close(state){serial_clear();if !serial_valid(state){return 0;}let result=device_close(serial_handle(state));serial_replace(state,19,db_int(1));serial_replace(state,17,db_blob("",0));return result;}
