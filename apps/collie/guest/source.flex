word(db_rpc(r));}\nfn db_get(table,id) {let r=db_request(\"get\");db_add(r,db_text(table));db_add(r,db_int(id));return db_rpc(r);}\nfn db_scan(table,after,limit) {let r=db_request(\"scan\");db_add(r,db_text(table));db_add(r,db_int(after));db_add(r,db_int(limit));return db_rpc(r);}\nfn db_rowid(row) {return db_word(db_at(row,0));}\nfn db_cell(row,column) {return db_at(db_at(row,1),column);}\nfn db_add_column(table,name,kind,nullable,value) {let r=db_request(\"add_column\");db_add(r,db_text(table));db_add(r,db_text(name));db_add(r,db_int(kind));db_add(r,db_int(nullable));db_add(r,value);return db_word(db_rpc(r));}\nfn db_rename_column(table,old,name) {let r=db_request(\"rename_column\");db_add(r,db_text(table));db_add(r,db_text(old));db_add(r,db_text(name));return db_word(db_rpc(r));}\nfn db_drop_column(table,name) {let r=db_request(\"drop_column\");db_add(r,db_text(table));db_add(r,db_text(name));return db_word(db_rpc(r));}\nfn db_history(after,limit) {let r=db_request(\"history\");db_add(r,db_int(after));db_add(r,db_int(limit));return db_rpc(r);}\nfn db_history_read(id,field,offset,limit) {let r=db_request(\"history_read\");db_add(r,db_int(id));db_add(r,db_text(field));db_add(r,db_int(offset));db_add(r,db_int(limit));return db_rpc(r);}\n";}
