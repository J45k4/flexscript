// Portable typed UWB records; constructing values performs no hardware I/O.
fn uwb_peer(uuid,session_id,config_id,local_address,peer_address,channel,preamble,rate,slot,key,sub_session_id,sub_key){let r=db_list();db_add(r,db_text(uuid));db_add(r,db_int(session_id));db_add(r,db_int(config_id));db_add(r,local_address);db_add(r,peer_address);db_add(r,db_int(channel));db_add(r,db_int(preamble));db_add(r,db_int(rate));db_add(r,db_int(slot));db_add(r,key);db_add(r,db_int(sub_session_id));db_add(r,sub_key);return r;}
fn uwb_options(angles,measurements,fusion,notification,near_cm,far_cm,timeout_ms){let r=db_list();db_add(r,db_int(angles));db_add(r,db_int(measurements));db_add(r,db_int(fusion));db_add(r,db_int(notification));db_add(r,db_int(near_cm));db_add(r,db_int(far_cm));db_add(r,db_int(timeout_ms));return r;}
