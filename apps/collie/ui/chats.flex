// Conversation panels retain independent UI state. The active conversation is
// mirrored into the outer state for shared sidebar, settings and dialog views.
import "workspace-model.flex";
fn cm_enabled(){return cu_desktop() && cu_n("multi_chat");}
fn cm_keys(){return j_parse("[\"session_id\",\"pending_session_id\",\"project_id\",\"project_name\",\"project_path\",\"draft\",\"cards\",\"stream\",\"live\",\"busy\",\"model\",\"model_input\",\"model_query\",\"model_return\",\"policy\",\"permission_entries\",\"permission_request\",\"attachments\",\"continuation\",\"status\",\"used\",\"total\",\"estimated\",\"context_unavailable\",\"worker\",\"workers\",\"worker_messages\",\"worker_streams\",\"worker_owner\",\"workers_error\",\"expanded\",\"card_offset\",\"preview\",\"preview_back\",\"notice\",\"notice_return\",\"settings_section\"]");}
fn cm_common_keys(){return j_parse("[\"sessions\",\"projects\",\"sidebar_collapsed\",\"sidebar_width\",\"sidebar_mode\",\"sidebar_closed\",\"query\",\"session_offset\",\"authenticated\",\"accounts\",\"account\",\"account_busy\",\"account_login\"]");}
fn cm_pick(state,keys){let out=j_object();let i=0;while i<j_count(keys){let key=j_value(j_at(keys,i));let value=cj_get(state,key);if value{j_set(out,key,value);}i=i+1;}return out;}
fn cm_local_key(key){let keys=cm_keys();let i=0;while i<j_count(keys){if h_equal(j_value(j_at(keys,i)),key){return 1;}i=i+1;}return 0;}
fn cm_count(){let rows=cws_panels();let count=0;let i=0;while i<j_count(rows){if h_equal(cj_text(j_at(rows,i),"kind"),"chat"){count=count+1;}i=i+1;}return count;}
fn cm_first(){let p=cws_panel(cu_n("chat_active"));if p && h_equal(cj_text(p,"kind"),"chat"){return cj_int(p,"id");}let rows=cws_panels();let i=0;while i<j_count(rows){let p=j_at(rows,i);if h_equal(cj_text(p,"kind"),"chat"){return cj_int(p,"id");}i=i+1;}return 1;}
fn cm_session(id){let rows=cws_panels();let i=0;while i<j_count(rows){let p=j_at(rows,i);if h_equal(cj_text(p,"kind"),"chat") && h_equal(cj_text(p,"session_id"),id) && h_len(id){return p;}i=i+1;}return 0;}
fn cm_prefix(id){if id==1{return "";}return m_cat(cu_k("chat-panel-",id),"::");}
fn cm_key(id,key){return m_cat(cm_prefix(id),key);}
fn cm_body_key(id){if id==1{return "workspace-chat-body";}return cu_k("workspace-chat-body-",id);}
fn cm_for_key(key){if h_starts(key,"chat-panel-"){let at=11;let id=0;while load8(key+at)>=48 && load8(key+at)<=57{id=id*10+load8(key+at)-48;at=at+1;}if load8(key+at)==58 && load8(key+at+1)==58{return cws_panel(id);}}return 0;}
fn cm_snapshot(state){return cm_pick(state,cm_keys());}
fn cm_store_active(){if !cm_enabled(){return 0;}let p=cws_panel(cm_first());if p && h_len(cu_s("session_id")) && h_equal(cj_text(p,"session_id"),cu_s("session_id")){j_set(p,"chat",cm_snapshot(cu_state));}return 0;}
fn cm_state(p){
    let root=cu_state;let local=j_object();let fields=j_value(root);let i=0;while i<h_count(fields){let pair=h_at(fields,i);if !cm_local_key(load64(pair)){j_set(local,load64(pair),load64(pair+8));}i=i+1;}
    let defaults=j_parse("{\"session_id\":\"\",\"pending_session_id\":\"\",\"project_id\":\"\",\"project_name\":\"\",\"project_path\":\"\",\"draft\":\"\",\"cards\":[],\"stream\":\"\",\"live\":{},\"busy\":false,\"policy\":{},\"permission_entries\":[],\"permission_request\":{},\"attachments\":[],\"workers\":[],\"worker_messages\":[],\"worker_streams\":{},\"expanded\":{},\"used\":0,\"total\":0,\"status\":\"\",\"card_offset\":0}");cu_merge(local,defaults);
    let snapshot=cj_get(p,"chat");if snapshot{cu_merge(local,snapshot);}else if cj_int(p,"id")==1 && (!h_len(cj_text(p,"session_id")) || h_equal(cj_text(p,"session_id"),cj_text(root,"session_id"))){cu_merge(local,cm_snapshot(root));}
    if h_len(cj_text(p,"session_id")){j_set(local,"session_id",j_get(p,"session_id"));}if !h_len(cj_text(local,"model")){j_set(local,"model",j_string(cj_text(root,"model")));}j_set(local,"page",j_string(cj_text(root,"page")));if cm_enabled() && (cj_int(p,"id")!=1 || h_len(cj_text(p,"session_id"))) && !cj_int(local,"total"){j_set(local,"pending_session_id",j_string("opening"));}return local;
}
fn cm_activate(id){if !cm_enabled(){return cws_focus(id);}let p=cws_panel(id);if !p || !h_equal(cj_text(p,"kind"),"chat"){return 0;}if cu_n("chat_active")!=id{cm_store_active();}let local=cm_state(p);cu_merge(cu_state,cm_snapshot(local));cu_int("chat_active",id);cws_focus(id);cu_set("page","chat");return 1;}
fn cm_prepare(){if !cm_enabled(){return 0;}let rows=cws_panels();let i=0;while i<j_count(rows){let p=j_at(rows,i);if h_equal(cj_text(p,"kind"),"chat") && !h_len(cj_text(p,"session_id")) && cj_int(p,"id")==1 && h_len(cu_s("session_id")){j_set(p,"session_id",j_string(cu_s("session_id")));j_set(p,"chat",cm_snapshot(cu_state));}i=i+1;}if !cu_n("chat_active"){cu_int("chat_active",cm_first());}i=0;while i<j_count(rows){let p=j_at(rows,i);if !h_equal(cj_text(p,"kind"),"chat") && !h_len(cj_text(p,"project_path")) && h_len(cu_s("project_path")){let path=cu_s("project_path");if h_len(cj_text(p,"cwd")){path=cj_text(p,"cwd");}j_set(p,"project_path",j_string(path));if h_equal(path,cu_s("project_path")){j_set(p,"chat_session",j_string(cu_s("session_id")));}}i=i+1;}return 0;}
fn cm_enter(p,width){let frame=j_object();j_set(frame,"state",cu_state);j_set(frame,"prefix",j_string(ui_key_prefix));cu_state=cm_state(p);cu_int("panel_width",width);ui_key_prefix=cm_prefix(cj_int(p,"id"));return frame;}
fn cm_leave(frame){cu_state=cj_get(frame,"state");ui_key_prefix=cj_text(frame,"prefix");return 0;}
fn cm_title(p){let title=cj_text(p,"title");let sid=cj_text(p,"session_id");let rows=cu_a("sessions");let i=0;while i<j_count(rows){let row=j_at(rows,i);if h_equal(cj_text(row,"id"),sid){title=cj_text(row,"title");}i=i+1;}if !h_len(title) || h_equal(title,"Chat"){title="New conversation";}let local=cj_get(p,"chat");if cj_int(cj_get(local,"permission_request"),"request_id"){title=m_cat("! ",title);}else if cj_int(local,"busy"){title=m_cat("● ",title);}return cu_clip(title,42);}
fn cm_command(command,p){if !p{return command;}let sid=cj_text(p,"session_id");if h_len(sid) && !h_len(cj_text(command,"chat_session")){j_set(command,"chat_session",j_string(sid));j_set(command,"chat_panel",j_get(p,"id"));}let key=cj_text(command,"focus_key");if h_len(key) && (h_equal(key,"composer-draft") || h_starts(key,"card-") || h_equal(key,"chat-scroll")){j_set(command,"focus_key",j_string(cm_key(cj_int(p,"id"),key)));}if h_equal(cj_text(command,"kind"),"focus") && h_equal(cj_text(command,"key"),"composer-draft"){j_set(command,"key",j_string(cm_key(cj_int(p,"id"),"composer-draft")));}return command;}
fn cm_open(id,project){
    let p=cm_session(id);if p{cm_activate(cj_int(p,"id"));let c=cu_command("chat_activate");return cm_command(c,p);}if cm_count()>=8{cu_notice("Up to eight chats can be open. Close an unused chat tab first.");return cu_command("none");}
    cm_store_active();p=cws_add("chat","New conversation");if !p{return cu_command("none");}let empty=j_object();j_set(empty,"draft",j_string(""));j_set(empty,"cards",j_array());j_set(empty,"stream",j_string(""));j_set(empty,"busy",j_bool(0));j_set(p,"chat",empty);j_set(p,"session_id",j_string(id));cm_activate(cj_int(p,"id"));let c=cu_command("chat_open");j_set(c,"id",j_string(id));j_set(c,"chat_panel",j_get(p,"id"));if project{j_set(c,"project_id",j_string(project));}return c;
}
fn cm_event(event){
    if !cm_enabled(){return cu_event(event);}let action=cj_text(event,"action");let key=cj_text(event,"key");
    if h_equal(action,"desktop_open_session") && h_starts(key,"desktop-session-"){return cm_open(key+16,0);}
    if h_equal(action,"select_project"){let project="";if !h_equal(key,"project-personal"){if !h_starts(key,"project-"){return c_error("Invalid project binding.");}project=key+8;}cu_sidebar_reveal(project);cu_set("query","");cu_int("session_offset",0);let sessions=cu_a("sessions");let i=0;while i<j_count(sessions){let entry=j_at(sessions,i);if h_equal(cj_text(entry,"project_id"),project){return cm_open(cj_text(entry,"id"),project);}i=i+1;}return cm_open("",project);}
    if h_equal(action,"choose_project_folder") && cm_count()>=8{cu_notice("Up to eight chats can be open. Close an unused chat tab first.");return cu_command("none");}
    if h_equal(action,"new_session"){return cm_open("",cu_s("project_id"));}
    if h_equal(action,"project_new_chat") && h_starts(key,"sidebar-new-"){return cm_open("",key+12);}
    let p=cm_for_key(key);if !p{let node=ui_find(ui_index,key);while node{if h_equal(load64(node+8),"workspace-chat-body"){p=cws_panel(1);node=0;}else{node=load64(node+64);}}}
    if !p{let c=cu_event(event);cm_store_active();return cm_command(c,cws_panel(cm_first()));}
    cm_activate(cj_int(p,"id"));let root=cu_state;cu_state=cm_state(p);let local=cu_copy(event);let prefix=cm_prefix(cj_int(p,"id"));if h_len(prefix){j_set(local,"key",j_string(key+h_len(prefix)));}let c=cu_event(local);let changed=cu_state;j_set(p,"chat",cm_snapshot(changed));cu_state=root;cu_merge(root,cm_snapshot(changed));cu_merge(root,cm_pick(changed,cm_common_keys()));j_set(root,"page",j_string(cj_text(changed,"page")));return cm_command(c,p);
}
fn cm_packet_begin(request){
    if !cm_enabled(){return 0;}let sid=cj_text(request,"chat_session");if !h_len(sid){return 0;}let data=cj_get(request,"data");if cj_get(data,"workspace_root") && !cj_get(data,"workspace"){return 0;}
    cws_prepare();cm_prepare();let p=cm_session(sid);if !p && cj_int(request,"chat_panel"){p=cws_panel(cj_int(request,"chat_panel"));}if !p{let first=cws_panel(1);if first && !h_len(cj_text(first,"session_id")){p=first;}}if !p{p=cws_add("chat","New conversation");}if !p{return 0;}j_set(p,"session_id",j_string(sid));let frame=j_object();j_set(frame,"root",cu_state);j_set(frame,"panel",p);cu_state=cm_state(p);return frame;
}
fn cm_filter_request(request){
    if !cm_enabled(){return request;}let packet_data=cj_get(request,"data");let folder=cj_text(packet_data,"workspace_root");if h_len(folder) && !h_equal(folder,cu_s("project_path")) && !cj_get(packet_data,"workspace") && !cj_get(packet_data,"workspace_terminals") && !cj_get(packet_data,"workspace_file") && !cj_get(packet_data,"workspace_saved"){let stale=j_object();j_set(stale,"action",j_string("update"));j_set(stale,"data",j_object());return stale;}let sid=cj_text(request,"chat_session");if !h_len(sid) || cm_session(sid) || (cj_int(request,"chat_opened") && (!cj_int(request,"chat_panel") || cws_panel(cj_int(request,"chat_panel")))){return request;}let first=cws_panel(1);if first && !h_len(cj_text(first,"session_id")){return request;}let data=cj_get(request,"data");if cj_get(data,"workspace_root"){return request;}let filtered=j_object();let reset=cj_get(request,"reset");if reset{j_set(filtered,"reset",reset);}j_set(filtered,"chat_session",j_string(""));j_set(filtered,"action",j_string("update"));j_set(filtered,"data",cm_pick(data,cm_common_keys()));return filtered;
}
fn cm_packet_end(frame,request){
    if !frame{cm_prepare();cm_store_active();return 0;}let local=cu_state;let root=cj_get(frame,"root");let p=cj_get(frame,"panel");j_set(p,"chat",cm_snapshot(local));cu_state=root;let data=cj_get(request,"data");cu_merge(root,cm_pick(data,cm_common_keys()));if cj_get(data,"workspace"){j_set(root,"workspace",cj_get(local,"workspace"));let found=cm_session(cj_text(request,"chat_session"));if found{p=found;j_set(p,"chat",cm_snapshot(local));}else{let first=cws_panel(1);if first{p=first;j_set(p,"session_id",j_string(cj_text(request,"chat_session")));j_set(p,"chat",cm_snapshot(local));}}cu_set("workspace_side",cj_text(local,"workspace_side"));cu_int("chat_active",cj_int(p,"id"));cu_merge(root,cm_snapshot(local));}
    if cj_int(request,"chat_opened") && (!cj_int(request,"chat_panel") || cj_int(p,"id")==cm_first()){cm_activate(cj_int(p,"id"));}
    if cj_int(p,"id")==cm_first(){cu_merge(root,cm_snapshot(local));if !cj_int(request,"chat_opened"){j_set(root,"page",j_string(cj_text(local,"page")));}}
    return 0;
}
fn cm_navigation(out){if !cm_enabled(){return out;}cm_store_active();let rows=cws_panels();let chats=j_array();let i=0;while i<j_count(rows){let p=j_at(rows,i);let sid=cj_text(p,"session_id");if h_equal(cj_text(p,"kind"),"chat") && h_len(sid) && cj_int(cj_get(p,"chat"),"total"){let entry=j_object();j_set(entry,"session_id",j_string(sid));let nav=cm_pick(cj_get(p,"chat"),j_parse("[\"draft\",\"worker\",\"expanded\",\"card_offset\",\"model_input\",\"model_query\",\"model_return\",\"settings_section\",\"preview\",\"preview_back\",\"notice\",\"notice_return\"]"));j_set(nav,"page",j_string("chat"));j_set(entry,"navigation",nav);j_push(chats,entry);}i=i+1;}j_set(out,"chat_navigation",chats);j_set(out,"active_session",j_string(cu_s("session_id")));let workspace=cu_copy(cj_get(out,"workspace"));let panels=j_array();i=0;while i<j_count(rows){let p=j_at(rows,i);let clean=j_object();let fields=j_value(p);let n=0;while n<h_count(fields){let pair=h_at(fields,n);if !h_equal(load64(pair),"chat"){j_set(clean,load64(pair),load64(pair+8));}n=n+1;}j_push(panels,clean);i=i+1;}j_set(workspace,"panels",panels);j_set(out,"workspace",workspace);return out;}
