// Original VM assertions for actual delayed callbacks and lifecycle changes.
fn fail(n){let e=db_error();db_io(0,2,e,db_len(e));return n;}
fn same(v,k,s){let x=device_field(v,k);if db_kind(x)!=2{return 0;}return worker_equal(db_word(x),s);}
fn ble_lifecycle_live_open(data){let h=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),data,db_null(),db_null(),db_null(),0,0,5000);if !h{return 1;}state_set("external",h);let i=0;while i<15{let d=device_info(db_word(h));if same(d,"state","ready"){db_io(0,1,db_word(h),db_bytes(h));return 0;}if same(d,"state","error"){return 2;}device_wait(db_word(h),500);i=i+1;}return 3;}
fn ble_lifecycle_live_stop(){let h=db_word(state_get("external"));ble_set_shutdown(h);let i=0;while i<15{let d=device_info(h);if db_word(device_field(d,"lease_released")){if !db_word(device_field(d,"sdk_terminal_callback"))&&!db_word(device_field(d,"radio_terminal")){return 1;}return device_close(h)-1;}device_wait(h,500);i=i+1;}return 2;}
fn ble_lifecycle_live_enabled(){let d=ble_info();if !d{return 1;}if db_word(device_field(d,"enabled")){db_io(0,1,"1",1);}else{db_io(0,1,"0",1);}return 0;}
fn ble_lifecycle_live_radio(expected){let d=bt_info();if !d{return 1;}if db_word(device_field(d,"state"))==expected{db_io(0,1,"ready",5);}return 0;}
fn ble_lifecycle_live_terminal(){let h=db_word(state_get("external"));let i=0;while i<15{let d=device_info(h);if db_word(device_field(d,"lease_released")){if !db_word(device_field(d,"sdk_terminal_callback"))&&!db_word(device_field(d,"radio_terminal")){return 1;}if db_word(device_field(d,"enabled")){return 2;}return 0;}device_wait(h,500);i=i+1;}return 3;}
fn ble_lifecycle_live_off(){if ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,5000){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"bluetooth_disabled"){return 2;}let caps=hardware_capabilities();let i=0;let n=0;while i<db_count(caps){let c=db_at(caps,i);if same(c,"id","bluetooth_le_extended_advertise")||same(c,"id","bluetooth_le_periodic_advertise"){if db_kind(device_field(c,"supported"))!=0||db_word(device_field(c,"support_known"))||db_word(device_field(c,"available")){return 3;}n=n+1;}i=i+1;}return n-2;}
fn ble_lifecycle_live_close(){return device_close(db_word(state_get("external")))-1;}
fn ble_lifecycle_live_stale(){if device_info(db_word(state_get("external"))){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_handle"){return 2;}return 0;}
fn ble_lifecycle_live_blocked(data){ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),data,db_null(),db_null(),db_null(),0,0,5000);return 0;}
