// Exact original legacy BLE VM assertions with binary/UUID parameters.
fn ble_live_capabilities(){let all=hardware_capabilities();let i=0;let found=0;while i<db_count(all){let cap=db_at(all,i);if worker_equal(db_word(device_field(cap,"id")),"bluetooth_le_scan"){if !db_word(device_field(cap,"supported")) || db_word(device_field(cap,"available")) || !db_word(device_field(cap,"runtime_permission_required")){return 1;}found=found+1;}if worker_equal(db_word(device_field(cap,"id")),"bluetooth_le_advertise"){if db_kind(device_field(cap,"supported"))!=0 || db_word(device_field(cap,"support_known")) || db_word(device_field(cap,"available")){return 2;}found=found+1;}i=i+1;}return found-2;}
fn ble_live_info(){let info=ble_info();if !info || !db_word(device_field(info,"enabled")){return 1;}if !db_word(device_field(info,"multiple_advertisement")){return 2;}return 0;}
fn ble_live_invalid(){if ble_scan("bad","",1000,0) || ble_scan("","bad",1000,0) || ble_scan("","",0,0) || ble_advertise("",db_blob("x",1),-1,db_blob("",0),0,0,0,1000){return 1;}let e=device_error();if !worker_equal(db_word(db_at(e,0)),"invalid_argument"){return 2;}return 0;}
fn ble_live_scan(service,address){let scan=ble_scan(service,address,8000,2);if !scan{return 1;}return state_set("scan",scan)-1;}
fn ble_live_found(address,expected,expected_length){let h=db_word(state_get("scan"));let i=0;while i<6{let e=device_wait(h,1000);if worker_equal(db_word(device_field(e,"event")),"found"){let row=device_field(e,"value");let data=device_field(row,"data");if !worker_equal(db_word(device_field(row,"address")),address){return 1;}if db_bytes(data)<expected_length{return 2;}let j=0;while j<expected_length{if load8(db_word(data)+j)!=load8(expected+j){return 3;}j=j+1;}if !db_word(device_field(row,"legacy")) || db_word(device_field(row,"timestamp_ns"))<=0{return 4;}return 0;}if worker_equal(db_word(device_field(e,"event")),"error"){return 5;}i=i+1;}return 6;}
fn ble_live_finished(){let h=db_word(state_get("scan"));let p=ble_scan_page(h,0,16);if db_word(device_field(p,"total"))!=1{return 1;}let i=0;while i<1000{let e=device_wait(h,1000);if worker_equal(db_word(device_field(e,"event")),"finished"){if !worker_equal(db_word(device_field(device_info(h),"state")),"complete"){return 2;}return device_close(h)-1;}i=i+1;}return 3;}
fn ble_live_advertise(service,data,payload_length){let h=ble_advertise(service,db_blob(data,payload_length),-1,db_blob("",0),0,2,2,0);if !h{return 1;}state_set("ad",h);let i=0;while i<5{let e=device_wait(db_word(h),1000);if worker_equal(db_word(device_field(e,"event")),"started"){return 0;}if worker_equal(db_word(device_field(e,"event")),"error"){return 2;}i=i+1;}return 3;}
fn ble_live_close_ad(){return device_close(db_word(state_get("ad")))-1;}
fn ble_live_wrong_handle(){let h=bt_watch();if !h{return 1;}if ble_scan_page(db_word(h),0,16){return 2;}let e=device_error();if !worker_equal(db_word(db_at(e,0)),"wrong_handle"){return 3;}return device_close(db_word(h))-1;}
fn ble_live_oversize(service){let h=ble_advertise(service,db_blob("aaaa",4),65535,db_blob("bbbbbbbbbb",10),1,2,2,0);if !h{return 1;}let i=0;while i<5{let e=device_wait(db_word(h),1000);if worker_equal(db_word(device_field(e,"event")),"error"){if db_word(device_field(e,"status"))!=1{return 2;}if !worker_equal(db_word(device_field(device_info(db_word(h)),"state")),"error"){return 3;}return device_close(db_word(h))-1;}i=i+1;}return 4;}
fn ble_live_deny(bluetooth){let value=0;if bluetooth{value=ble_info();}else{value=ble_scan("","",1000,0);}if value{return 1;}let e=device_error();if !worker_equal(db_word(db_at(e,0)),"permission_denied"){return 2;}return 0;}
