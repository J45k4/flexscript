// Original GATT client assertions against independent server byte oracles.

fn fail(n){let e=db_error();db_io(0,2,e,db_len(e));return n;}
fn equal_blob(value,p,len){if db_kind(value)!=3 || db_bytes(value)!=len{return 0;}let i=0;while i<len{if load8(db_word(value)+i)!=load8(p+i){return 0;}i=i+1;}return 1;}
fn pattern(value){if db_kind(value)!=3 || db_bytes(value)!=512{return 0;}let i=0;while i<512{if load8(db_word(value)+i)!=i%256{return 0;}i=i+1;}return 1;}
fn await_gatt(h,id){let i=0;while i<20{let e=device_wait(h,1000);if db_kind(e)==5{let kind=device_field(e,"event");if worker_equal(db_word(kind),"notification"){state_set("notification",e);}if worker_equal(db_word(kind),"error"){let msg=device_field(e,"message");db_io(0,2,db_word(msg),db_bytes(msg));return e;}let got=device_field(e,"id");if db_kind(got)==1 && db_word(got)==id{return e;}}i=i+1;}return db_null();}
fn okay(e){let status=device_field(e,"status");return db_kind(status)==1 && db_word(status)==0 && !worker_equal(db_word(device_field(e,"event")),"error");}
fn notification(h){let e=state_get("notification");if db_kind(e)==5{return e;}let i=0;while i<10{e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"notification"){return e;}i=i+1;}return db_null();}
fn seek(h,parent,uuid,nth){let offset=0;let found=0;while offset>=0{let page=ble_gatt_items(h,parent,offset,16);if !page{return 0;}let rows=device_field(page,"items");let i=0;while i<db_count(rows){let row=db_at(rows,i);if worker_equal(db_word(device_field(row,"uuid")),uuid){if found==nth{return db_word(device_field(row,"id"));}found=found+1;}i=i+1;}offset=db_word(device_field(page,"next"));}return 0;}

fn gatt_live_connect(fixture_address){let h=ble_connect(fixture_address,15000,3000);if !h{return 1;}state_set("connection",h);let i=0;while i<10{let e=device_wait(db_word(h),1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"connected"){return 0;}i=i+1;}return 2;}
fn gatt_live_alive(){return !worker_equal(db_word(device_field(device_info(db_word(state_get("connection"))),"state")),"connected");}
fn gatt_live_discover(fixture_service,fixture_characteristic,fixture_descriptor){let h=db_word(state_get("connection"));if db_word(device_field(device_info(h),"mtu"))!=23{return 1;}if !ble_gatt_discover(h,0){return 2;}let e=await_gatt(h,0);if !okay(e) || !worker_equal(db_word(device_field(e,"event")),"services"){return 3;}let service=seek(h,"",fixture_service,0);if !service{return 4;}state_set("service",db_text(service));let first=seek(h,service,fixture_characteristic,0);let second=seek(h,service,fixture_characteristic,1);if !first || !second || worker_equal(first,second){return 5;}state_set("first",db_text(first));state_set("second",db_text(second));let desc=seek(h,first,fixture_descriptor,0);let ccc=seek(h,first,"00002902-0000-1000-8000-00805f9b34fb",0);if !desc || !ccc{return 6;}state_set("descriptor",db_text(desc));state_set("cccd",db_text(ccc));return 0;}
fn gatt_live_mtu(){let h=db_word(state_get("connection"));let p=alloc(21);if ble_gatt_write(h,db_word(state_get("first")),db_blob(p,21),1,1){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"size_limit"){return 2;}if !ble_gatt_mtu(h,64,1){return 3;}let e=await_gatt(h,1);if !okay(e) || db_word(device_field(e,"mtu"))!=517 || db_word(device_field(device_info(h),"mtu"))!=517{return 4;}return 0;}
fn gatt_live_read(){let h=db_word(state_get("connection"));if !ble_gatt_read(h,db_word(state_get("first")),2){return 1;}let e=await_gatt(h,2);if !okay(e) || !pattern(device_field(e,"value")){return 2;}if ble_gatt_read(h,db_word(state_get("first")),2){return 3;}if !worker_equal(db_word(db_at(device_error(),0)),"invalid_argument"){return 4;}if !ble_gatt_read(h,db_word(state_get("second")),3){return 5;}e=await_gatt(h,3);if !okay(e) || !equal_blob(device_field(e,"value"),"duplicate",9){return 6;}return 0;}
fn gatt_live_descriptor(){let h=db_word(state_get("connection"));let d=db_word(state_get("descriptor"));if !ble_gatt_read(h,d,4){return 1;}let e=await_gatt(h,4);let b=alloc(6);store8(b,0);store8(b+1,255);store8(b+2,129);store8(b+3,90);if !okay(e) || !equal_blob(device_field(e,"value"),b,4){return 2;}store8(b,255);store8(b+1,0);store8(b+4,5);store8(b+5,0);if !ble_gatt_write(h,d,db_blob(b,6),2,5) || !okay(await_gatt(h,5)){return 3;}if !ble_gatt_read(h,d,6){return 4;}e=await_gatt(h,6);if !okay(e) || !equal_blob(device_field(e,"value"),b,6){return 5;}return 0;}
fn gatt_live_notify(fixture_mode,fixture_cccd_id,fixture_write_id){let h=db_word(state_get("connection"));let ch=db_word(state_get("first"));let d=db_word(state_get("cccd"));let b=alloc(2);store8(b,fixture_mode);store8(b+1,0);if !ble_gatt_local_notify(h,ch,1) || !ble_gatt_write(h,d,db_blob(b,2),2,fixture_cccd_id) || !okay(await_gatt(h,fixture_cccd_id)){return 1;}state_set("notification",db_null());let payload=alloc(512);let i=0;while i<512{store8(payload+i,i%256);i=i+1;}if !ble_gatt_write(h,ch,db_blob(payload,512),2,fixture_write_id) || !okay(await_gatt(h,fixture_write_id)){return 2;}let e=notification(h);if !pattern(device_field(e,"value")) || !worker_equal(db_word(device_field(e,"attribute")),ch){return 3;}return 0;}
fn gatt_live_rssi(){let h=db_word(state_get("connection"));if !ble_gatt_rssi(h,11) || !okay(await_gatt(h,11)){return 1;}if !ble_gatt_phy_read(h,12){return 2;}let e=await_gatt(h,12);if !okay(e) || db_word(device_field(e,"tx_phy"))!=1 || db_word(device_field(e,"rx_phy"))!=1{return 3;}if !ble_gatt_priority(h,1){return 4;}return 0;}
fn gatt_live_noresponse(){let h=db_word(state_get("connection"));state_set("notification",db_null());let b=alloc(512);let i=0;while i<512{store8(b+i,i%256);i=i+1;}if !ble_gatt_write(h,db_word(state_get("first")),db_blob(b,512),1,13) || !okay(await_gatt(h,13)){return 1;}if !pattern(device_field(notification(h),"value")){return 2;}return 0;}
fn gatt_live_isolation(fixture_address,fixture_service,fixture_characteristic){let h=ble_connect(fixture_address,15000,3000);if !h{return 1;}state_set("other",h);let i=0;let connected=0;while i<10 && !connected{let e=device_wait(db_word(h),1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"connected"){connected=1;}i=i+1;}if !connected{return 2;}if !ble_gatt_discover(db_word(h),0) || !okay(await_gatt(db_word(h),0)){return 3;}let service=seek(db_word(h),"",fixture_service,0);let own=seek(db_word(h),service,fixture_characteristic,0);let foreign=db_word(state_get("first"));if !own || worker_equal(own,foreign){return 4;}if ble_gatt_read(db_word(h),foreign,1){return 5;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_attribute"){return 6;}if !ble_gatt_read(db_word(h),own,1) || !pattern(device_field(await_gatt(db_word(h),1),"value")){return 7;}if !device_close(db_word(h)){return 8;}let first=db_word(state_get("connection"));if !ble_gatt_rssi(first,14) || !okay(await_gatt(first,14)){return 9;}return 0;}
fn gatt_live_rediscover(fixture_service,fixture_characteristic,fixture_denied_characteristic){let h=db_word(state_get("connection"));let old=db_word(state_get("first"));if !ble_gatt_discover(h,15) || !okay(await_gatt(h,15)){return 1;}if ble_gatt_read(h,old,16){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_attribute"){return 3;}let service=seek(h,"",fixture_service,0);state_set("service",db_text(service));state_set("first",db_text(seek(h,service,fixture_characteristic,0)));let denied=seek(h,service,fixture_denied_characteristic,0);if !ble_gatt_read(h,denied,16){return 4;}let e=await_gatt(h,16);if db_word(device_field(e,"status"))!=8 || db_kind(device_field(e,"value"))!=0{return 5;}return 0;}
fn gatt_live_slow(fixture_slow_characteristic){let h=db_word(state_get("connection"));let service=db_word(state_get("service"));let slow=seek(h,service,fixture_slow_characteristic,0);if !ble_gatt_read(h,slow,17){return 1;}if ble_gatt_read(h,db_word(state_get("first")),18){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"busy"){return 3;}let e=await_gatt(h,17);if !worker_equal(db_word(device_field(e,"code")),"timeout"){return 4;}let info=device_info(h);if !worker_equal(db_word(device_field(info,"state")),"error") || !worker_equal(db_word(device_field(device_field(info,"last_result"),"code")),"timeout"){return 5;}return 0;}
fn gatt_live_late(){let h=db_word(state_get("connection"));let result=device_field(device_info(h),"last_result");if !worker_equal(db_word(device_field(result,"code")),"timeout"){return 1;}if ble_gatt_read(h,db_word(state_get("first")),18){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"disconnected"){return 3;}return device_close(h)-1;}
