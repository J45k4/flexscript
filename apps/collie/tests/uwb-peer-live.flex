// Original actual public SDK UWB peer, timestamp and dynamic-peer assertions.
fn hex(v){let p=alloc(17);let i=0;while i<16{store8(p+i,load8("0123456789abcdef"+((db_word(v)>>(60-i*4))&15)));i=i+1;}store8(p+16,10);db_io(0,1,p,17);return 0;}
fn uwb_peer_live_open(fixture_local,fixture_remote,fixture_role){let peers=db_list();db_add(peers,uwb_peer("12345678-1234-1234-1234-123456789abc",16909060,2,db_blob(fixture_local,2),db_blob(fixture_remote,2),9,10,1,2,db_blob("00000000",8),-1,db_blob("",0)));let h=uwb_range(fixture_role,peers,uwb_options(1,0,0,1,0,0,15000));if !h{return 1;}state_set("range",h);return 0;}
fn uwb_peer_live_opened(){let h=db_word(state_get("range"));let i=0;let opened=0;while i<12 && !opened{let e=device_wait(h,1000);if db_kind(e)==5{let n=device_field(e,"event");db_io(0,1,db_word(n),db_bytes(n));if worker_equal(db_word(n),"open_failed"){return 100+db_word(device_field(e,"reason"));}if worker_equal(db_word(n),"opened"){opened=1;}}i=i+1;}if !opened{return 1;}return 0;}
fn uwb_peer_live_distance(){let h=db_word(state_get("range"));let i=0;let seen=0;while i<20 && !seen{let e=device_wait(h,1000);if db_kind(e)==5{let n=device_field(e,"event");if worker_equal(db_word(n),"ranging"){if !db_word(device_field(e,"sdk_callback")) || db_word(device_field(e,"technology"))!=0 || !worker_equal(db_word(device_field(e,"peer")),"12345678-1234-1234-1234-123456789abc") || db_word(device_field(e,"timestamp_ms"))<=0{return 1;}let d=device_field(device_field(e,"distance_m"),"value");if db_kind(d)==4{hex(d);seen=1;}}if worker_equal(db_word(n),"error") || worker_equal(db_word(n),"open_failed"){let m=device_field(e,"message");if db_kind(m)==2{db_io(0,2,db_word(m),db_bytes(m));}return 2;}}i=i+1;}if !seen{return 3;}return 0;}
fn uwb_peer_live_drain(){let h=db_word(state_get("range"));let i=0;while i<128{if db_kind(device_wait(h,0))==0{return 0;}i=i+1;}return 1;}
fn uwb_peer_live_stamps(){let h=db_word(state_get("range"));let i=0;while i<32{let e=device_wait(h,0);if db_kind(e)==0{return 0;}if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"ranging"){hex(device_field(e,"timestamp_ms"));}i=i+1;}return 0;}
fn uwb_peer_live_interval_skip(){if db_word(uwb_interval(db_word(state_get("range")),1))!=1{return 1;}return 0;}
fn uwb_peer_live_interval_reset(){if db_word(uwb_interval(db_word(state_get("range")),0))!=1{return 1;}return 0;}
fn uwb_peer_live_add(){let p=uwb_peer("87654321-1234-1234-1234-123456789abc",16909060,2,db_blob("AB",2),db_blob("EF",2),9,10,1,2,db_blob("00000000",8),-1,db_blob("",0));if db_word(uwb_add(db_word(state_get("range")),p))!=1{return 1;}return 0;}
fn uwb_peer_live_added(){let h=db_word(state_get("range"));let seen=0;let i=0;while i<16 && !seen{let e=device_wait(h,1000);if db_kind(e)==5{let n=device_field(e,"event");if worker_equal(db_word(n),"operation_failed"){return 100+db_word(device_field(e,"reason"));}if worker_equal(db_word(n),"started") && worker_equal(db_word(device_field(e,"peer")),"87654321-1234-1234-1234-123456789abc"){seen=1;}}i=i+1;}if !seen{return 1;}return 0;}
fn uwb_peer_live_remove(){let h=db_word(state_get("range"));if db_word(uwb_remove(h,"87654321-1234-1234-1234-123456789abc"))!=1{return 1;}let seen=0;let i=0;while i<16 && !seen{let e=device_wait(h,1000);if db_kind(e)==5{let n=device_field(e,"event");if worker_equal(db_word(n),"stopped") && worker_equal(db_word(device_field(e,"peer")),"87654321-1234-1234-1234-123456789abc"){seen=1;}}i=i+1;}if !seen{return 2;}return 0;}
