// Real Wi-Fi guest programs; only the owned emulator virtual AP is used.
fn wifi_live_status(){let s=wifi_info();if !s{return 1;}return 0;}
fn wifi_live_location_denied(){if wifi_scan(0){return 1;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"permission_denied"){return 2;}return 0;}
fn wifi_live_scan(){let h=wifi_scan(0);if !h{return 1;}let p=wifi_scan_page(db_word(h),0,16);if db_count(device_field(p,"access_points"))<1{return 2;}return device_close(db_word(h))-1;}
fn wifi_live_nearby_denied(){if wifi_request("AndroidWifi","open","","",0,1000){return 1;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"permission_denied"){return 2;}return 0;}
fn wifi_live_request(){let h=wifi_request("AndroidWifi","open","","",0,90000);if !h{db_io(0,2,db_error(),db_len(db_error()));return 1;}state_set("wifi_request",h);progress("Wi-Fi request pending");let i=0;while i<80{let e=device_wait(db_word(h),1000);if db_kind(e)==5{let t=device_field(e,"event");if worker_equal(db_word(t),"available"){return 0;}if worker_equal(db_word(t),"unavailable"){return 2;}}i=i+1;}return 3;}
fn wifi_live_hotspot(){let h=wifi_hotspot();if !h{db_io(0,2,db_error(),db_len(db_error()));return 1;}let seen=0;let i=0;while i<25 && !seen{let e=device_wait(db_word(h),1000);if db_kind(e)==5{let event=device_field(e,"event");if worker_equal(db_word(event),"started"){let c=wifi_hotspot_config(db_word(h));if !c || db_bytes(device_field(c,"ssid"))<1{return 2;}let info=device_info(db_word(h));if db_kind(device_field(device_field(info,"config"),"password"))!=0{return 3;}db_io(0,1,"started",7);seen=1;}if worker_equal(db_word(event),"error"){if db_kind(device_field(e,"android_code"))!=1{return 4;}db_io(0,1,"android_rejected",16);seen=1;}}i=i+1;}device_close(db_word(h));if !seen{return 5;}return 0;}
fn wifi_live_watch(){let h=wifi_watch();if !h{return 1;}progress("Wi-Fi state watcher ready");let i=0;while i<25{let e=device_wait(db_word(h),1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"state"){let s=device_field(e,"value");if !db_word(device_field(s,"enabled")){return device_close(db_word(h))-1;}}i=i+1;}return 2;}
fn wifi_live_crash(ssid){let h=wifi_suggest(ssid,"wpa2","collie-crash-test",0,1,0);if !h{db_io(0,2,db_error(),db_len(db_error()));return 1;}return state_set("crash_wifi",h)-1;}
