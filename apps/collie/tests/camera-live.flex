// Real Camera2 guest programs; host orchestration lives in the native driver.
fn camera_live_fail(n){let e=db_error();db_io(0,2,e,db_len(e));return n;}
fn camera_live_state(){let c=db_word(state_get("camera"));let d=device_info(c);if !d{return camera_live_fail(1);}let s=device_field(d,"state");db_io(0,1,db_word(s),db_bytes(s));return 0;}
fn camera_live_shutdown(){if !camera_shutdown(db_word(state_get("camera"))){return camera_live_fail(1);}return 0;}
fn camera_live_terminal(){let d=device_info(db_word(state_get("camera")));if !d{return camera_live_fail(1);}if db_word(device_field(d,"sdk_terminal"))&&db_word(device_field(d,"lease_released")){db_io(0,1,"ready",5);}return 0;}
fn camera_live_close(){return device_close(db_word(state_get("camera")))-1;}
fn camera_live_deny(){if camera_list(0,16){return camera_live_fail(1);}if !worker_equal(db_word(db_at(device_error(),0)),"permission_denied"){return camera_live_fail(2);}return 0;}
fn camera_live_choose(){let p=camera_list(0,16);if !p{return camera_live_fail(1);}let rows=device_field(p,"cameras");if !db_count(rows){return camera_live_fail(2);}let chosen=db_at(rows,0);let i=0;while i<db_count(rows){let r=db_at(rows,i);if db_word(device_field(r,"lens_facing"))==1{chosen=r;}i=i+1;}state_set("camera_id",device_field(chosen,"id"));return 0;}
fn camera_live_codecs(){if !camera_video_qualities(db_word(state_get("camera_id")),0,16){return camera_live_fail(1);}let c=camera_video_codecs(1,0,16);if !c{return camera_live_fail(2);}let name=db_word(device_field(db_at(device_field(c,"codecs"),0),"name"));if !camera_video_codec_profiles(1,name,0,16)||!camera_video_codec_info(1,name)||!camera_video_codec_support(1,name,176,144,30,128000){return camera_live_fail(3);}return 0;}
fn camera_live_jpeg_configure(){let id=db_word(state_get("camera_id"));let p=camera_output_sizes(id,256,0,16);if !p{return camera_live_fail(1);}let sizes=device_field(p,"sizes");let best=db_at(sizes,0);let area=db_word(device_field(best,"width"))*db_word(device_field(best,"height"));let i=0;while i<db_count(sizes){let s=db_at(sizes,i);let n=db_word(device_field(s,"width"))*db_word(device_field(s,"height"));if n<area{best=s;area=n;}i=i+1;}let w=db_word(device_field(best,"width"));let h=db_word(device_field(best,"height"));state_set("width",db_int(w));state_set("height",db_int(h));let outputs=db_list();db_add(outputs,camera_output(256,w,h));if !camera_configure(db_word(state_get("camera")),outputs,5000){return camera_live_fail(2);}return 0;}
fn camera_live_capture(){let settings=db_list();db_add(settings,camera_setting("android.jpeg.quality","byte",db_int(85)));if !camera_capture(db_word(state_get("camera")),2,settings,0){let e=device_error();if db_kind(e)==5{return camera_live_fail(1);}}return 0;}
fn camera_live_capture_wait(){let c=db_word(state_get("camera"));let i=0;let frame=0;let result=0;while i<20 && (!frame||!result){let e=device_wait(c,1000);if db_kind(e)==5{let name=device_field(e,"event");if worker_equal(db_word(name),"frame"){state_set("frame",device_field(e,"frame"));frame=1;}if worker_equal(db_word(name),"capture_completed"){state_set("result",device_field(e,"result"));result=1;}if worker_equal(db_word(name),"capture_failed")||worker_equal(db_word(name),"error"){return camera_live_fail(1);}}i=i+1;}if !frame||!result{return camera_live_fail(2);}return 0;}
fn camera_live_jpeg_read(){let c=db_word(state_get("camera"));let id=db_word(state_get("frame"));let offset=0;let chars="0123456789abcdef";let done=0;while !done{let r=camera_frame_read(c,id,0,offset,32768);if !r{return camera_live_fail(1);}let v=device_field(r,"value");let out=alloc(db_bytes(v)*2);let i=0;while i<db_bytes(v){let x=load8(db_word(v)+i);store8(out+i*2,load8(chars+x/16));store8(out+i*2+1,load8(chars+x%16));i=i+1;}db_io(0,1,out,db_bytes(v)*2);offset=db_word(device_field(r,"next"));if offset<0{done=1;}}return 0;}
fn camera_live_dimensions(){let b=alloc(32);let w=db_word(state_get("width"));let h=db_word(state_get("height"));let n=w*100000+h;let i=31;while n>0{store8(b+i,48+n%10);i=i-1;n=n/10;}db_io(0,1,b+i+1,31-i);return 0;}
fn camera_live_timestamps(){let c=db_word(state_get("camera"));let r=camera_result_value(c,db_word(state_get("result")),"android.sensor.timestamp",0,1);if !r{return camera_live_fail(1);}let f=camera_frame_info(c,db_word(state_get("frame")));if db_word(device_field(r,"value"))!=db_word(device_field(f,"timestamp_ns")){return camera_live_fail(2);}if !camera_frame_close(c,db_word(state_get("frame"))){return camera_live_fail(3);}if camera_frame_info(c,db_word(state_get("frame"))){return camera_live_fail(4);}return 0;}
fn camera_live_result_path(){let c=db_word(state_get("camera"));let result=db_word(state_get("result"));let page=camera_result_value_path(c,result,"android.sensor.timestamp",db_list(),0,1);let legacy=camera_result_value(c,result,"android.sensor.timestamp",0,1);if !page||!legacy||db_word(device_field(page,"value"))!=db_word(device_field(legacy,"value")){return camera_live_fail(1);}let path=db_list();db_add(path,db_int(0));if camera_result_value_path(c,"result-unknown","android.sensor.timestamp",path,0,1){return camera_live_fail(2);}if !worker_equal(db_word(db_at(device_error(),0)),"stale_result"){return camera_live_fail(3);}return 0;}
fn camera_live_yuv_configure(){let id=db_word(state_get("camera_id"));let p=camera_output_sizes(id,35,0,16);if !p{return camera_live_fail(1);}let sizes=device_field(p,"sizes");let best=db_at(sizes,0);let found=0;let i=0;while i<db_count(sizes){let row=db_at(sizes,i);if db_word(device_field(row,"width"))==320 && db_word(device_field(row,"height"))==240{best=row;found=1;}i=i+1;}if !found{return camera_live_fail(2);}let outputs=db_list();db_add(outputs,camera_output(35,db_word(device_field(best,"width")),db_word(device_field(best,"height"))));if !camera_configure(db_word(state_get("camera")),outputs,5000){return camera_live_fail(3);}return 0;}
fn camera_live_yuv_capture(){let c=db_word(state_get("camera"));if !camera_capture(c,2,db_list(),0){return camera_live_fail(1);}let i=0;while i<150{let e=device_wait(c,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"frame"){state_set("frame",device_field(e,"frame"));return 0;}i=i+1;}return camera_live_fail(2);}
fn camera_live_reopen(){let c=camera_open(db_word(state_get("camera_id")),5000);if !c{return camera_live_fail(1);}state_set("camera",c);return 0;}
fn camera_live_video_open(){let id=db_word(state_get("camera_id"));let p=camera_output_sizes(id,0,0,16);if !p{return camera_live_fail(1);}let sizes=device_field(p,"sizes");let best=db_at(sizes,0);let area=db_word(device_field(best,"width"))*db_word(device_field(best,"height"));let i=0;while i<db_count(sizes){let s=db_at(sizes,i);let n=db_word(device_field(s,"width"))*db_word(device_field(s,"height"));if n<area{best=s;area=n;}i=i+1;}let o=camera_video_options(db_word(device_field(best,"width")),db_word(device_field(best,"height")),15,256000,10000,1048576,1);state_set("video-options",o);let h=camera_video_start(db_word(state_get("camera")),o,db_list());if !h{return camera_live_fail(2);}state_set("video",h);return 0;}
fn camera_live_video_wait(){let h=db_word(state_get("video"));let i=0;while i<20{let e=device_wait(h,1000);if db_kind(e)==5{if worker_equal(db_word(device_field(e,"event")),"recording"){return 0;}if worker_equal(db_word(device_field(e,"event")),"error"){return camera_live_fail(1);}}i=i+1;}return camera_live_fail(2);}
fn camera_live_video_finish(){let h=db_word(state_get("video"));if db_word(camera_video_stop(h))!=1{return camera_live_fail(1);}let i=0;while i<20{let e=device_wait(h,1000);let info=device_info(h);if worker_equal(db_word(device_field(info,"state")),"stopped"){return 0;}if worker_equal(db_word(device_field(info,"state")),"error"){let e=device_field(info,"error");db_io(0,2,db_word(e),db_bytes(e));return camera_live_fail(2);}i=i+1;}return camera_live_fail(3);}
fn camera_live_video_pause(){return db_word(camera_video_pause(db_word(state_get("video"))))-1;}
fn camera_live_video_resume(){return db_word(camera_video_resume(db_word(state_get("video"))))-1;}
fn camera_live_inventory(){if !camera_list(0,16){return camera_live_fail(1);}return 0;}
fn camera_live_open_denied(){let rows=device_field(camera_list(0,16),"cameras");let id=db_word(device_field(db_at(rows,0),"id"));if camera_open(id,5000){return camera_live_fail(1);}if !worker_equal(db_word(db_at(device_error(),0)),"permission_denied"){return camera_live_fail(2);}return 0;}
fn camera_live_open(){let id=db_word(state_get("camera_id"));let h=camera_open(id,5000);if !h{return camera_live_fail(1);}state_set("camera",h);return 0;}
fn camera_live_audio_start(){let h=camera_video_audio_start(db_word(state_get("camera")),state_get("video-options"),db_list());if !h{return camera_live_fail(1);}state_set("video",h);return 0;}
