// Original live provider Task and observer assertions. No RF inference.
fn uwb_provider_live_prepared(){let h=db_word(state_get("range"));let i=0;while i<15 && !db_word(device_field(device_info(h),"prepared")){device_wait(h,1000);i=i+1;}if !db_word(device_field(device_info(h),"prepared")){return 1;}return 0;}
fn uwb_provider_live_watch(){let h=uwb_backend_watch(2);if !h{return 1;}state_set("watch",h);h=db_word(h);let i=0;while i<10 && !db_word(device_field(device_info(h),"subscription_task_complete")){device_wait(h,1000);i=i+1;}if !db_word(device_field(device_info(h),"subscription_task_success")){return 2;}return 0;}
fn uwb_provider_live_availability(enabled){let h=db_word(state_get("watch"));let i=0;let seen=0;while i<12 && !seen{let e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"capabilities"){if db_word(device_field(device_field(e,"uwb"),"available"))==enabled{if !db_word(device_field(e,"sdk_callback")){return 1;}seen=1;}}i=i+1;}if !seen{return 2;}return 0;}
fn uwb_provider_live_close_watch(){return device_close(db_word(state_get("watch")))-1;}
fn uwb_provider_live_fresh(){device_close(db_word(state_get("range")));let h=uwb_prepare(0,10000);if !h{return 1;}state_set("range",h);h=db_word(h);let i=0;while i<15 && !db_word(device_field(device_info(h),"prepared")){device_wait(h,1000);i=i+1;}if !db_word(device_field(device_info(h),"prepared")){return 2;}return 0;}
fn uwb_provider_live_start(){let h=db_word(state_get("range"));let p=db_list();db_add(p,uwb_peer("12345678-1234-1234-1234-123456789abc",16909060,1,device_field(device_info(h),"local_address"),db_blob("CD",2),9,10,1,2,db_blob("00000000",8),-1,db_blob("",0)));let r=uwb_start(h,p,uwb_options(0,0,0,1,0,20000,10000));if !r{return 1;}state_set("request",r);return 0;}
fn uwb_provider_live_ranging(){let h=db_word(state_get("range"));let req=db_word(state_get("request"));let i=0;while i<15 && !worker_equal(db_word(device_field(device_info(h),"state")),"ranging"){device_wait(h,1000);i=i+1;}let r=uwb_request(h,req);if !db_word(device_field(r,"task_complete")) || !db_word(device_field(r,"task_success")) || !db_word(device_field(device_info(h),"sdk_initialized")){let e=device_field(device_field(r,"error"),"message");db_io(0,2,db_word(e),db_bytes(e));return 1;}if !worker_equal(db_word(device_field(device_info(h),"state")),"ranging"){return 2;}return 0;}
fn uwb_provider_live_stop(){let h=db_word(state_get("range"));if db_word(uwb_stop(h))!=1{return 1;}let i=0;while i<15 && !db_word(device_field(device_info(h),"lease_released")){device_wait(h,1000);i=i+1;}if !db_word(device_field(device_info(h),"stop_task_complete")) || !db_word(device_field(device_info(h),"lease_released")){return 2;}return device_close(h)-1;}
