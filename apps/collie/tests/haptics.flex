import "../lib/json.flex";
import "../guest/runtime.flex";
import "../guest/haptics.flex";
fn main(){
    let step=haptic_primitive(7,db_real(0x3fe0000000000000),23);
    h_assert(db_count(step)==3&&db_word(db_at(step,0))==7&&db_kind(db_at(step,1))==4&&db_word(db_at(step,1))==0x3fe0000000000000&&db_word(db_at(step,2))==23,"a primitive keeps its ID, exact typed fractional scale and delay independent");
    let timed=haptic_primitive_offset(1,db_real(0x3fd0000000000000),700);let timing=db_encode(timed);let timing_copy=db_decode(db_wire,timing);
    h_assert(db_count(timing_copy)==4&&db_word(db_at(timing_copy,0))==1&&db_kind(db_at(timing_copy,1))==4&&db_word(db_at(timing_copy,1))==0x3fd0000000000000&&db_word(db_at(timing_copy,2))==700&&db_word(db_at(timing_copy,3))==1,"relative-start timing crosses the typed wire as an exact four-field record without losing scale bits");
    let explicit=haptic_primitive_delay(7,db_int(1),23,0);timing=db_encode(explicit);timing_copy=db_decode(db_wire,timing);
    h_assert(db_count(timing_copy)==4&&db_kind(db_at(timing_copy,1))==1&&db_word(db_at(timing_copy,1))==1&&db_word(db_at(timing_copy,3))==0,"explicit pause records remain distinct from three-field defaults and retain an integer scale");
    let steps=db_list();db_add(steps,step);db_add(steps,haptic_primitive(1,db_int(1),0));let n=db_encode(steps);h_assert(n>0,"haptic records encode through the ordinary typed wire format");let copy=db_decode(db_wire,n);h_assert(db_count(copy)==2&&db_kind(db_at(db_at(copy,0),1))==4&&db_word(db_at(db_at(copy,0),1))==0x3fe0000000000000&&db_kind(db_at(db_at(copy,1),1))==1&&db_word(db_at(db_at(copy,1),1))==1,"composition records preserve integer and real scales without coercion");
    let point=haptic_envelope_point(db_real(0x3fe0000000000000),db_real(0x4062c80000000000),800);n=db_encode(point);copy=db_decode(db_wire,n);h_assert(db_count(copy)==3&&db_kind(db_at(copy,0))==4&&db_word(db_at(copy,0))==0x3fe0000000000000&&db_word(db_at(copy,1))==0x4062c80000000000&&db_word(db_at(copy,2))==800,"envelope points retain fractional strength/frequency bits and integer duration");
    let targets=db_list();db_add(targets,haptic_target(7,haptic_frequency(db_real(0x4062c80000000000),db_add(db_list(),point))));db_add(targets,haptic_target(9,haptic_once(20,255)));n=db_encode(targets);copy=db_decode(db_wire,n);let effect=db_at(db_at(copy,0),1);h_assert(db_count(copy)==2&&db_word(db_at(db_at(copy,0),0))==7&&h_equal(db_word(db_at(effect,0)),"waveform_envelope")&&db_kind(db_at(effect,1))==4&&db_word(db_at(effect,1))==0x4062c80000000000&&db_word(db_at(db_at(db_at(copy,1),1),1))==20,"target records preserve actuator IDs, distinct graphs and exact typed frequency values");
    let records=db_list();db_add(records,haptic_pattern(db_list(),db_list()));db_add(records,haptic_predefined(2));db_add(records,haptic_composition(steps));db_add(records,haptic_basic(db_int(0),db_list()));h_assert(h_equal(db_word(db_at(db_at(records,0),0)),"waveform")&&h_equal(db_word(db_at(db_at(records,1),0)),"predefined")&&h_equal(db_word(db_at(db_at(records,2),0)),"composition")&&h_equal(db_word(db_at(db_at(records,3),0)),"basic_envelope"),"all effect factories produce inert portable records without SDK access");
    let loop=haptic_loop(db_add(db_add(db_list(),db_int(17)),db_int(23)),db_add(db_add(db_list(),db_int(255)),db_int(0)),1);let repeat=haptic_repeating_after(haptic_once(11,64),haptic_repeating(haptic_composition(steps)));n=db_encode(loop);copy=db_decode(db_wire,n);h_assert(db_count(copy)==4&&h_equal(db_word(db_at(copy,0)),"waveform_loop")&&db_word(db_at(copy,3))==1&&db_word(db_at(db_at(copy,1),1))==23&&db_word(db_at(db_at(copy,2),0))==255,"waveform loop index, durations and amplitudes survive the typed wire exactly");n=db_encode(repeat);copy=db_decode(db_wire,n);let inner=db_at(db_at(copy,2),1);h_assert(h_equal(db_word(db_at(copy,0)),"repeating_after")&&h_equal(db_word(db_at(db_at(copy,1),0)),"one_shot")&&h_equal(db_word(db_at(db_at(copy,2),0)),"repeating")&&h_equal(db_word(db_at(inner,0)),"composition")&&db_word(db_at(db_at(db_at(inner,1),0),1))==0x3fe0000000000000,"repeat factories remain inert and preserve nested finite/invalid records for platform validation without mutating their inputs");
    h_print(1,"PASS portable haptic composition/envelope/target/repeat records and exact typed transport; no SDK operation invoked\n");return 0;
}
