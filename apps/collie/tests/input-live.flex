// Original VM assertions for real Android input delivery and kernel hotplug.
fn input_live_hotplug(){let h=input_watch(-1,8,db_list(),0);if !h{return 1;}state_set("hotplug",h);return 0;}
fn input_live_added(expected_name){let h=db_word(state_get("hotplug"));let found=0;let i=0;while i<12 && !found{let e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"device_added"){let id=device_field(e,"device_id");let info=input_info(db_word(id));if info && worker_equal(db_word(device_field(info,"name")),expected_name){state_set("keyboard_id",id);found=1;}}i=i+1;}if !found{return 1;}return 0;}
fn input_live_select(){let id=db_word(state_get("keyboard_id"));let selected=input_watch(id,2,db_list(),0);let all=input_watch(-1,2,db_list(),0);if !selected || !all{return 1;}state_set("selected",selected);state_set("all_keys",all);return 0;}
fn input_live_selected_events(){let h=db_word(state_get("selected"));let i=0;let seen=0;while i<12 && seen<2{let e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"key") && db_word(device_field(e,"device_id"))==db_word(state_get("keyboard_id")) && db_word(device_field(e,"key_code"))==131{seen=seen+1;}i=i+1;}if seen!=2{return 1;}return 0;}
fn input_live_filter(){let all=db_word(state_get("all_keys"));let seen=0;let i=0;while i<12 && seen<2{let e=device_wait(all,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"key") && db_word(device_field(e,"key_code"))==131 && db_word(device_field(e,"device_id"))!=db_word(state_get("keyboard_id")){seen=seen+1;}i=i+1;}if seen!=2{return 1;}if db_kind(device_wait(db_word(state_get("selected")),0))!=0{return 2;}return 0;}
fn input_live_removed(){let h=db_word(state_get("hotplug"));let seen=0;let i=0;while i<12 && !seen{let e=device_wait(h,1000);if db_kind(e)==5 && worker_equal(db_word(device_field(e,"event")),"device_removed") && db_word(device_field(e,"device_id"))==db_word(state_get("keyboard_id")){seen=1;}i=i+1;}if !seen{return 1;}let gone=0;let j=0;while j<10 && !gone{if !device_info(db_word(state_get("selected"))){gone=1;}else{device_wait(h,20);}j=j+1;}if !gone{return 2;}if input_info(db_word(state_get("keyboard_id"))){return 3;}if !device_close(db_word(state_get("all_keys"))) || !device_close(h){return 4;}return 0;}
fn input_live_inventory(){let page=input_devices(0,16);let devices=device_field(page,"devices");if !db_count(devices){return 1;}let id=db_word(device_field(db_at(devices,0),"id"));let d=input_info(id);if db_word(device_field(d,"id"))!=id{return 2;}let ranges=input_ranges(id,0,16);if !ranges{return 3;}let keys=db_list();db_add(keys,db_int(131));if db_count(input_has_keys(id,keys))!=1{return 4;}return 0;}
fn input_live_invalid(){let axes=db_list();db_add(axes,db_int(0));db_add(axes,db_int(0));if input_watch(-1,3,axes,0){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"invalid_argument"){return 2;}if input_devices(-1,16)||input_devices(0,17)||input_info(2147483647){return 3;}return 0;}
fn input_live_watch(){let axes=db_list();db_add(axes,db_int(0));db_add(axes,db_int(1));let h=input_watch(-1,3,axes,0);if !h{return 1;}state_set("input",h);return 0;}
fn input_live_touch_keys(){let h=db_word(state_get("input"));let touch=0;let keys=0;let i=0;while i<128{let e=device_wait(h,0);if db_kind(e)==0{i=128;}else{if worker_equal(db_word(device_field(e,"event")),"touch"){let points=device_field(e,"pointers");if db_count(points)!=1{return 1;}let axes=db_at(db_at(points,0),2);if db_count(axes)!=2 || db_word(db_at(axes,0))!=4643985272004935680{return 2;}touch=touch+1;}if worker_equal(db_word(device_field(e,"event")),"key") && db_word(device_field(e,"key_code"))==131{keys=keys+1;}}i=i+1;}if touch<2 || keys<2{return 3;}return 0;}
fn input_live_close(){let h=db_word(state_get("input"));if !device_close(h){return 1;}if device_info(h){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_handle"){return 3;}return 0;}
fn input_live_capacity(){let all=db_list();let i=0;while i<8{let h=input_watch(-1,8,db_list(),0);if !h{return 1;}db_add(all,h);i=i+1;}if input_watch(-1,8,db_list(),0){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"resource_limit"){return 3;}i=0;while i<8{if !device_close(db_word(db_at(all,i))){return 4;}i=i+1;}let h=input_watch(-1,8,db_list(),0);if !h{return 5;}return device_close(db_word(h))-1;}
fn input_live_motion_watch(){let axes=db_list();db_add(axes,db_int(0));db_add(axes,db_int(1));db_add(axes,db_int(9));db_add(axes,db_int(10));db_add(axes,db_int(2));db_add(axes,db_int(24));db_add(axes,db_int(25));let h=input_watch(-1,7,axes,4);if !h{return 1;}state_set("input",h);return 0;}
fn input_live_motion_events(){let h=db_word(state_get("input"));let stylus=0;let mouse=0;let joystick=0;let gamepad=0;let i=0;while i<128{let e=device_wait(h,0);if db_kind(e)==0{i=128;}else{if db_kind(e)!=5{return 90;}let source=db_word(device_field(e,"source"));let kind=device_field(e,"event");if db_kind(kind)!=2{return 91;}let event=db_word(kind);if worker_equal(event,"key") && db_word(device_field(e,"key_code"))==105 && source&1024{gamepad=gamepad+1;}if worker_equal(event,"touch") || worker_equal(event,"motion"){let axes=db_at(db_at(device_field(e,"pointers"),0),2);if source&16384{stylus=stylus+1;}if source&8192{if db_word(db_at(axes,2))!=4608308318706860032 || db_word(db_at(axes,3))!=-4610560118520545280{return 1;}mouse=mouse+1;}if source&16777216{if db_word(db_at(axes,0))!=4602678819172646912 || db_word(db_at(axes,1))!=-4625196817309499392{return 2;}joystick=joystick+1;}}}i=i+1;}if stylus<2 || !mouse || !joystick || gamepad<2{return 3;}return device_close(h)-1;}
fn input_live_background_watch(){let h=input_watch(-1,15,db_list(),0);if !h{return 1;}state_set("input",h);return 0;}
fn input_live_background_closed(){if device_info(db_word(state_get("input"))){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_handle"){return 2;}let h=input_watch(-1,8,db_list(),0);if !h{return 3;}return device_close(db_word(h))-1;}
