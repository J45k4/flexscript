// Original real Wi-Fi Direct, binary socket and strict DNS-SD VM assertions.
fn emit(v){db_io(0,1,db_word(v),db_bytes(v));}fn number(n){let p=alloc(32);let i=32;while n>=10{i=i-1;store8(p+i,48+n%10);n=n/10;}i=i-1;store8(p+i,48+n);db_io(0,1,p+i,32-i);}
fn p2p_live_host_peer(){let h=state_get("p2p");let page=p2p_peers(db_word(h),0,16);if !page{return 1;}let peers=device_field(page,"peers");if db_count(peers)>1{return 2;}if db_count(peers)==1{let peer=db_at(peers,0);if db_word(device_field(peer,"group_owner")){return 0;}state_set("target",device_field(peer,"id"));emit(device_field(peer,"name"));}return 0;}
fn p2p_live_inventory(){let h=state_get("p2p");let info=device_info(db_word(h));if !info{return 1;}if p2p_open(){return 2;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"busy"){return 3;}let p=p2p_peers(db_word(h),0,16);if !p || db_kind(device_field(p,"peers"))!=5{return 4;}if p2p_group_credentials(db_word(h)){return 5;}return 0;}
fn p2p_live_polls(){let h=state_get("p2p");let i=0;while i<100{let e=device_wait(db_word(h),0);if !e{return 1;}i=i+1;}return 0;}
fn p2p_live_discover(){return db_word(p2p_discover(db_word(state_get("p2p"))))-1;}
fn p2p_live_create(){let h=state_get("p2p");if !p2p_group_create_config(db_word(h),"DIRECT-CF-Collie","collie-peer-test",1){return 1;}return 0;}
fn p2p_live_owner(){let g=p2p_group(db_word(state_get("p2p")));if db_kind(g)==5 && db_word(device_field(g,"interface_up")){let c=p2p_group_credentials(db_word(state_get("p2p")));if !worker_equal(db_word(device_field(c,"password")),"collie-peer-test"){return 1;}if db_kind(device_field(g,"password"))!=0{return 2;}emit(device_field(g,"interface"));}return 0;}
fn p2p_live_remove(){return db_word(p2p_group_remove(db_word(state_get("p2p"))))-1;}
fn p2p_live_group_gone(){let g=p2p_group(db_word(state_get("p2p")));if db_kind(g)==0{db_io(0,1,"gone",4);}return 0;}
fn p2p_live_connect(){let h=state_get("p2p");if !p2p_connect(db_word(h),db_word(state_get("target")),"pbc","",0){return 1;}return 0;}
fn p2p_live_connection(){let c=p2p_connection(db_word(state_get("p2p")));if db_word(device_field(c,"formed")){emit(device_field(c,"owner_address"));}return 0;}
fn p2p_live_attach(){let h=state_get("p2p");let g=p2p_group_attach(db_word(h));if !g{return 1;}if p2p_group_credentials(db_word(h)){return 2;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"not_owned"){return 3;}if p2p_group_remove(db_word(h)){return 4;}return 0;}
fn p2p_live_tcp_listen(){let h=p2p_tcp_listen(db_word(state_get("p2p")),0,4);if !h{return 1;}state_set("listen",h);number(db_word(device_field(device_info(db_word(h)),"port")));return 0;}
fn p2p_live_tcp_connect(fixture_owner_ip,fixture_port){let s=p2p_tcp_connect(db_word(state_get("p2p")),fixture_owner_ip,fixture_port,4000);if !s{return 1;}let p=alloc(32768);let i=0;while i<32768{store8(p+i,i%256);i=i+1;}if db_word(device_write(db_word(s),db_blob(p,32768)))!=32768{return 2;}let at=0;while at<32768{let b=device_read(db_word(s),32768-at,4000);if db_kind(b)!=3 || !db_bytes(b){return 3;}i=0;while i<db_bytes(b){if load8(db_word(b)+i)!=(at+i)%256{return 4;}i=i+1;}at=at+db_bytes(b);}return device_close(db_word(s))-1;}
fn p2p_live_udp_open(){let h=p2p_udp_open(db_word(state_get("p2p")),0);if !h{return 1;}state_set("udp",h);number(db_word(device_field(device_info(db_word(h)),"port")));return 0;}
fn p2p_live_udp_roundtrip(fixture_owner_ip,fixture_port){let h=p2p_udp_open(db_word(state_get("p2p")),0);if !h{return 1;}state_set("udp",h);let p=alloc(32768);let i=0;while i<32768{store8(p+i,i%256);i=i+1;}if db_word(p2p_udp_send(db_word(h),fixture_owner_ip,fixture_port,db_blob(p,32768)))!=32768{return 2;}let r=p2p_udp_receive(db_word(h),32768,8000);let b=device_field(r,"data");if db_bytes(b)!=32768 || db_word(device_field(r,"truncated")){return 3;}i=0;while i<32768{if load8(db_word(b)+i)!=i%256{return 4;}i=i+1;}if p2p_udp_send(db_word(h),"203.0.113.1",1234,db_text("no")){return 5;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"outside_group"){return 6;}return 0;}
fn p2p_live_not_formed(){let c=p2p_connection(db_word(state_get("p2p")));if !db_word(device_field(c,"formed")){db_io(0,1,"gone",4);}return 0;}
fn p2p_live_stale_udp(){if device_info(db_word(state_get("udp"))){return 1;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"stale_handle"){return 2;}return 0;}
fn p2p_live_publish(fixture_instance,fixture_typ){let attrs=db_list();let row=db_list();db_add(row,db_text("vm"));db_add(row,db_text("flexscript"));db_add(attrs,row);let h=p2p_dns_sd_publish(db_word(state_get("p2p")),fixture_instance,fixture_typ,attrs);if !h{return 1;}state_set("dns_ad",h);if p2p_dns_sd_publish(db_word(state_get("p2p")),fixture_instance,fixture_typ,attrs){return 2;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"busy"){return 3;}return 0;}
fn p2p_live_browse(fixture_browse_type,fixture_instance,fixture_typ){let h=p2p_dns_sd_browse(db_word(state_get("p2p")),fixture_browse_type);if !h{return 1;}state_set("dns_query",h);if p2p_dns_sd_browse(db_word(state_get("p2p")),fixture_browse_type){return 2;}let e=device_error();if db_count(e)!=2 || !worker_equal(db_word(db_at(e,0)),"busy"){return 3;}let txt=p2p_dns_sd_txt(db_word(state_get("p2p")),fixture_instance,fixture_typ);if !txt{return 4;}state_set("dns_txt_query",txt);return db_word(p2p_service_discover(db_word(state_get("p2p"))))-1;}
fn p2p_live_dns(fixture_instance,fixture_domain){let h=state_get("p2p");let seen=0;let i=0;while i<80 && seen!=3{let e=device_wait(db_word(h),1000);if db_kind(e)==5{let kind=device_field(e,"event");emit(kind);db_io(0,1," ",1);emit(device_field(e,"instance"));emit(device_field(e,"domain"));emit(device_field(e,"message"));db_io(0,1,"\n",1);if worker_equal(db_word(kind),"dns_service") && worker_equal(db_word(device_field(e,"instance")),fixture_instance){seen=seen|1;}if worker_equal(db_word(kind),"dns_txt") && worker_equal(db_word(device_field(e,"domain")),fixture_domain){let attrs=device_field(e,"attributes");if worker_equal(db_word(device_field(attrs,"vm")),"flexscript"){seen=seen|2;}}}i=i+1;}if seen!=3{return 1;}return 0;}
fn p2p_live_close(){return device_close(db_word(state_get("p2p")))-1;}
fn p2p_live_open(){let h=p2p_open();if !h{return 1;}return state_set("p2p",h)-1;}
fn p2p_live_tcp_server(){let s=p2p_tcp_accept(db_word(state_get("listen")),8000);if !s{return 1;}let at=0;while at<32768{let bytes=device_read(db_word(s),32768-at,4000);if db_kind(bytes)!=3 || !db_bytes(bytes){return 2;}let i=0;while i<db_bytes(bytes){if load8(db_word(bytes)+i)!=(at+i)%256{return 3;}i=i+1;}if db_word(device_write(db_word(s),bytes))!=db_bytes(bytes){return 4;}at=at+db_bytes(bytes);}device_close(db_word(s));return 0;}
fn p2p_live_udp_server(){let h=state_get("udp");let r=p2p_udp_receive(db_word(h),32768,8000);if !r{return 1;}let b=device_field(r,"data");if db_bytes(b)!=32768 || db_word(device_field(r,"truncated")){return 2;}let i=0;while i<32768{if load8(db_word(b)+i)!=i%256{return 3;}i=i+1;}if db_word(p2p_udp_send(db_word(h),db_word(device_field(r,"address")),db_word(device_field(r,"port")),b))!=32768{return 4;}return 0;}
