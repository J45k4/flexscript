// Original extended/periodic advertising SDK and independent packet assertions.

fn fail(n){let e=db_error();db_io(0,2,e,db_len(e));return n;}
fn field_is(value,key,text){let v=device_field(value,key);if db_kind(v)!=2{return 0;}return worker_equal(db_word(v),text);}
fn diagnostic(d){let s=device_field(d,"state");db_io(0,1,db_word(s),db_bytes(s));db_io(0,1," ",1);let e=device_field(d,"error");db_io(0,1,db_word(e),db_bytes(e));let c=alloc(2);store8(c,48+db_word(device_field(d,"status")));store8(c+1,10);db_io(0,1,c,2);return 0;}
fn ready(h){let i=0;while i<15{let d=device_info(h);if field_is(d,"state","ready"){return 1;}if field_is(d,"state","error"){return 0;}device_wait(h,500);i=i+1;}return 0;}
fn await_request(h,r){if !r{return 0;}let i=0;while i<15{let d=ble_set_request(h,db_word(r));if db_word(device_field(d,"sdk_callback")){if db_word(device_field(d,"status"))!=0 || db_word(device_field(d,"deadline_expired")){diagnostic(d);return 0;}return field_is(d,"state","complete");}device_wait(h,500);i=i+1;}diagnostic(ble_set_request(h,db_word(r)));return 0;}
fn shutdown(h){ble_set_shutdown(h);let i=0;while i<15{let d=device_info(h);if db_word(device_field(d,"lease_released")){if !db_word(device_field(d,"sdk_terminal_callback"))||!db_word(device_field(d,"local_cleanup_returned")){return 0;}return device_close(h);}device_wait(h,500);i=i+1;}return 0;}

fn ble_set_live_open(ad,periodic){let h=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ad,db_null(),ble_periodic_options(0,80),periodic,0,0,5000);if !h{return 1;}state_set("ad",h);if !ready(db_word(h)){return 2;}return 0;}
fn ble_set_live_capabilities(){let caps=hardware_capabilities();let n=0;let i=0;while i<db_count(caps){let c=db_at(caps,i);let id=db_word(device_field(c,"id"));if worker_equal(id,"bluetooth_le_extended_advertise")||worker_equal(id,"bluetooth_le_periodic_advertise"){if db_kind(device_field(c,"supported"))!=0||db_word(device_field(c,"support_known"))||db_word(device_field(c,"available")){return 1;}n=n+1;}i=i+1;}return n-2;}
fn ble_set_live_deny(){if ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,1000){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"permission_denied"){return 2;}return 0;}
fn ble_set_live_status(){let h=db_word(state_get("ad"));let d=device_info(h);if !db_word(device_field(d,"sdk_start_callback"))||!db_word(device_field(d,"parameters_confirmed"))||db_word(device_field(d,"start_status"))!=0{return 1;}let c=ble_info();if !db_word(device_field(c,"extended_advertisement"))||!db_word(device_field(c,"periodic_advertisement"))||db_word(device_field(c,"max_advertising_data"))!=512{return 2;}return 0;}
fn ble_set_live_periodic_enable(){let h=db_word(state_get("ad"));if !await_request(h,ble_set_periodic_enable(h,1)){return 1;}return 0;}
fn ble_set_live_update(ad){let h=db_word(state_get("ad"));if !await_request(h,ble_set_data(h,0,ad)){return 1;}return 0;}
fn ble_set_live_periodic_update(periodic){let h=db_word(state_get("ad"));if !await_request(h,ble_set_data(h,2,periodic)){return 1;}return 0;}
fn ble_set_live_periodic_disable(){let h=db_word(state_get("ad"));if !await_request(h,ble_set_periodic_enable(h,0)){return 1;}return 0;}
fn ble_set_live_parameters(){let h=db_word(state_get("ad"));if !await_request(h,ble_set_enable(h,0,0,0)){return 1;}if !await_request(h,ble_set_periodic_parameters(h,ble_periodic_options(0,96))){return 2;}if !await_request(h,ble_set_parameters(h,ble_set_options(0,0,0,0,0,1,1,192,-7,1))){return 3;}return 0;}
fn ble_set_live_oversize(ad){let h=db_word(state_get("ad"));let r=ble_set_data(h,0,ad);if !r{return 1;}let i=0;while i<15{let d=ble_set_request(h,db_word(r));if db_word(device_field(d,"sdk_callback")){if db_word(device_field(d,"status"))!=1||!field_is(d,"state","error"){diagnostic(d);return 2;}return 0;}device_wait(h,500);i=i+1;}return 3;}
fn ble_set_live_large(ad){let h=db_word(state_get("ad"));if !await_request(h,ble_set_data(h,0,ad)){return 1;}if !await_request(h,ble_set_enable(h,1,0,0)){return 2;}return 0;}
fn ble_set_live_shutdown(){let h=db_word(state_get("ad"));if !shutdown(h){return 1;}if device_info(h){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_handle"){return 3;}return 0;}
fn ble_set_live_legacy_rejection(ad){let p=ble_set_options(1,0,0,0,0,1,1,160,-7,1);let h=ble_set_open(p,ad,db_null(),db_null(),db_null(),0,0,1000);if !h{return 1;}let i=0;while i<15{let d=device_info(db_word(h));if db_word(device_field(d,"lease_released")){if !db_word(device_field(d,"sdk_no_registration"))||db_word(device_field(d,"sdk_start_callback")){return 2;}return device_close(db_word(h))-1;}device_wait(db_word(h),500);i=i+1;}return 3;}
fn ble_set_live_invalid(){let p=ble_set_options(0,0,0,0,0,2,1,160,-7,1);if ble_set_open(p,ble_ad_empty(),db_null(),db_null(),db_null(),0,0,1000){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"invalid_argument"){return 2;}let h=bt_watch();if !h{return 3;}if ble_set_shutdown(db_word(h)){return 4;}if !worker_equal(db_word(db_at(device_error(),0)),"wrong_handle"){return 5;}return device_close(db_word(h))-1;}
fn ble_set_live_scan_response(scan){let h=ble_set_open(ble_set_options(0,0,1,0,0,1,1,160,-7,1),ble_ad_empty(),scan,db_null(),db_null(),0,0,5000);if !h||!ready(db_word(h)){return 1;}state_set("scan_ad",h);return 0;}
fn ble_set_live_scan_update(scan){let h=db_word(state_get("scan_ad"));if !await_request(h,ble_set_data(h,1,scan)){return 1;}return 0;}
fn ble_set_live_scan_shutdown(){return shutdown(db_word(state_get("scan_ad")))-1;}
fn ble_set_live_duration(){let h=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,5000);if !h||!ready(db_word(h)){return 1;}state_set("limited",h);if !await_request(db_word(h),ble_set_enable(db_word(h),1,50,0)){return 2;}let i=0;while i<15{let e=device_wait(db_word(h),500);if field_is(e,"event","sdk_event")&&field_is(e,"kind","enable")&&!db_word(device_field(e,"enabled"))&&db_word(device_field(e,"sdk_callback"))&&db_word(device_field(e,"controller_expiry")){if db_word(device_field(device_info(db_word(h)),"enabled"))||db_word(device_field(e,"status"))!=6{diagnostic(e);return 3;}return 0;}i=i+1;}return 4;}
fn ble_set_live_duration_shutdown(){return shutdown(db_word(state_get("limited")))-1;}
fn ble_set_live_event_limit(limited){let value=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),limited,db_null(),db_null(),db_null(),0,3,5000);if !value||!ready(db_word(value)){return 1;}state_set("event_limit",value);let h=db_word(value);let i=0;while i<15{let e=device_wait(h,500);if field_is(e,"event","sdk_event")&&field_is(e,"kind","enable")&&!db_word(device_field(e,"enabled"))&&db_word(device_field(e,"sdk_callback"))&&db_word(device_field(e,"controller_expiry")){let status=db_word(device_field(e,"status"));if status!=2&&status!=6{diagnostic(e);return 2;}let b=alloc(1);store8(b,48+status);db_io(0,1,b,1);return 0;}i=i+1;}return 3;}
fn ble_set_live_event_shutdown(){return shutdown(db_word(state_get("event_limit")))-1;}
fn ble_set_live_quota(){let handles=db_list();let i=0;while i<8{let h=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,5000);if !h||!ready(db_word(h)){return 1;}db_add(handles,h);i=i+1;}state_set("quota",handles);if ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,5000){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"resource_limit"){return 3;}return 0;}
fn ble_set_live_quota_shutdown(){let handles=state_get("quota");let i=0;while i<db_count(handles){if !shutdown(db_word(db_at(handles,i))){return 1;}i=i+1;}let h=ble_set_open(ble_set_options(0,0,0,0,0,1,1,160,-7,1),ble_ad_empty(),db_null(),db_null(),db_null(),0,0,5000);if !h||!ready(db_word(h)){return 2;}return shutdown(db_word(h))-1;}
fn ble_set_live_extended_scan(expected,fixture_service,fixture_address,expected_length){let h=ble_scan(fixture_service,fixture_address,3000,2);if !h{return 1;}let i=0;while i<8{let e=device_wait(db_word(h),500);if field_is(e,"event","found"){let r=device_field(e,"value");let b=device_field(r,"data");if db_word(device_field(r,"legacy"))||db_word(device_field(r,"sid"))!=9||db_word(device_field(r,"periodic_interval"))!=80||db_word(device_field(r,"data_status"))!=0||db_bytes(b)<expected_length{return 2;}let j=0;while j<expected_length{if load8(db_word(b)+j)!=load8(expected+j){return 3;}j=j+1;}return device_close(db_word(h))-1;}i=i+1;}return 4;}
