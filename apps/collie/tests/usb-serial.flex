import "../lib/json.flex";
import "../guest/runtime.flex";
import "../guest/usb-serial.flex";
global fixture_calls=0;
global fixture_interfaces=0;
global fixture_descriptors=0;
global fixture_input=0;
global fixture_cursor=0;
global fixture_version=0x30;
global fixture_open=0;
global fixture_closed=0;
global fixture_failure=0;
global fixture_configuration=1;
global fixture_short=0;
fn worker_equal(a,b){return h_equal(a,b);}
fn device_field(map,key){let i=0;while i<db_count(map){let row=db_at(map,i);if db_kind(db_at(row,0))==2 && h_equal(db_word(db_at(row,0)),key){return db_at(row,1);}i=i+1;}return db_null();}
fn fixture_record(kind,type,request,value,index,data){let row=db_list();db_add(row,db_text(kind));db_add(row,db_int(type));db_add(row,db_int(request));db_add(row,db_int(value));db_add(row,db_int(index));db_add(row,data);db_add(fixture_calls,row);if fixture_failure==db_count(fixture_calls){return serial_error("mock_error","Device rejected the injected request.");}serial_clear();return row;}
fn usb_control_out(handle,type,request,value,index,data,timeout){if !fixture_record("out",type,request,value,index,data){return 0;}h_assert(timeout==2000,"bounded setup timeout");return db_int(db_bytes(data));}
fn usb_control_in(handle,type,request,value,index,bytes,timeout){if !fixture_record("in",type,request,value,index,db_int(bytes)){return 0;}let out=alloc(bytes);let i=0;while i<bytes{store8(out+i,0);i=i+1;}if request==0x5f{store8(out,fixture_version);}if request==8{store8(out,0xb0);}if request==5{store8(out,0xb0);store8(out+1,0x60);}if request==0x95 && value==0x0706{store8(out,0x0a);}if request==0x95 && value==0x1805{store8(out,1);store8(out+1,0xc3);}if fixture_short{return db_blob(out,bytes-1);}return db_blob(out,bytes);}
fn usb_transfer_in(handle,endpoint,limit,timeout){if !fixture_record("read",endpoint,limit,timeout,0,db_null()){return 0;}let n=db_bytes(fixture_input)-fixture_cursor;if n>limit{n=limit;}let value=db_blob(db_word(fixture_input)+fixture_cursor,n);fixture_cursor=fixture_cursor+n;return value;}
fn usb_transfer_out(handle,endpoint,data,timeout){if !fixture_record("write",endpoint,timeout,0,0,data){return 0;}return db_int(db_bytes(data));}
fn usb_open(id){if !fixture_record("open",0,0,0,0,db_text(id)){return 0;}fixture_open=1;return db_text("device-fixture");}
fn usb_descriptors(handle){return fixture_descriptors;}
fn usb_info(id){let map=db_list();serial_map(map,"vendor_id",db_int(0x10c4));serial_map(map,"product_id",db_int(0xea60));return map;}
fn usb_configurations(id,offset,limit){let page=db_list();let configs=db_list();let config=db_list();serial_map(config,"id",db_int(1));db_add(configs,config);serial_map(page,"configurations",configs);serial_map(page,"next",db_int(-1));return page;}
fn usb_interfaces(id,config,offset,limit){let page=db_list();serial_map(page,"interfaces",fixture_interfaces);serial_map(page,"next",db_int(-1));return page;}
fn usb_configure(handle,configuration){fixture_configuration=configuration;return db_int(1);}
fn usb_claim(handle,id,alternate,force){if !fixture_record("claim",id,alternate,force,0,db_null()){return 0;}return db_int(1);}
fn device_info(handle){if !fixture_open{return serial_error("stale_handle","Disconnected fixture.");}let value=db_list();serial_map(value,"configuration",db_int(fixture_configuration));return value;}
fn device_close(handle){fixture_open=0;fixture_closed=fixture_closed+1;serial_clear();return 1;}
fn fixture_endpoint(address,type,packet){let value=db_list();serial_map(value,"address",db_int(address));serial_map(value,"type",db_int(type));serial_map(value,"maximum_packet_size",db_int(packet));return value;}
fn fixture_interface(number,kind,subclass,bulk){let value=db_list();serial_map(value,"id",db_int(number));serial_map(value,"alternate",db_int(0));serial_map(value,"class",db_int(kind));serial_map(value,"subclass",db_int(subclass));let endpoints=db_list();if bulk{db_add(endpoints,fixture_endpoint(0x81,2,64));db_add(endpoints,fixture_endpoint(2,2,64));}else{db_add(endpoints,fixture_endpoint(0x83,3,16));}serial_map(value,"endpoints",endpoints);return value;}
fn fixture_start(bcd,number){fixture_calls=db_list();fixture_interfaces=db_list();fixture_open=0;fixture_closed=0;fixture_failure=0;fixture_configuration=1;fixture_cursor=0;fixture_short=0;fixture_input=db_blob("",0);let p=alloc(18);let i=0;while i<18{store8(p+i,0);i=i+1;}store8(p,18);store8(p+1,1);store8(p+12,bcd&255);store8(p+13,bcd>>8);fixture_descriptors=db_blob(p,18);db_add(fixture_interfaces,fixture_interface(number,255,0,1));return 0;}
fn fixture_find(type,request,value,index){let i=0;while i<db_count(fixture_calls){let row=db_at(fixture_calls,i);if h_equal(db_word(db_at(row,0)),"out") && db_word(db_at(row,1))==type && db_word(db_at(row,2))==request && db_word(db_at(row,3))==value && db_word(db_at(row,4))==index{return row;}i=i+1;}return 0;}
fn fixture_bytes(value,a,b,c,d){h_assert(db_bytes(value)>=4 && load8(db_word(value))==a && load8(db_word(value)+1)==b && load8(db_word(value)+2)==c && load8(db_word(value)+3)==d,"little endian control payload");return 0;}
fn main(argc,argv){
    h_environment(argc,argv);
    fixture_start(0x0600,0);let state=serial_open("fixture",serial_port("ftdi",1,0,0,0),0);h_assert(state,"FT232R open");h_assert(fixture_find(0x40,0,0,1) && fixture_find(0x40,2,0,1) && fixture_find(0x40,9,16,1),"FTDI reset, no handshake, latency");h_assert(fixture_find(0x40,3,0x4138,0),"FT232R 9600 divisor is 0x4138 at index zero");h_assert(serial_configure(state,115200,7,2,2) && fixture_find(0x40,3,26,0) && fixture_find(0x40,4,0x1207,1),"FTDI 115200 7E2");h_assert(serial_lines(state,0,1) && fixture_find(0x40,1,0x0302,1),"FTDI modem masks");h_assert(serial_break(state,1) && fixture_find(0x40,4,0x5207,1),"FTDI break retains framing");
    let raw=alloc(266);let at=0;let n=0;while n<256{store8(raw+at,0xb0);store8(raw+at+1,0x60);at=at+2;let count=0;while count<62 && n<256{store8(raw+at,n);at=at+1;n=n+1;count=count+1;}}fixture_input=db_blob(raw,at);let seen=0;while seen<256{let bytes=serial_read(state,3,200);h_assert(bytes && db_bytes(bytes)>0 && db_bytes(bytes)<=3,"FTDI small read");let i=0;while i<db_bytes(bytes){h_assert(load8(db_word(bytes)+i)==seen,"FTDI removes each packet header without dropping buffered bytes");seen=seen+1;i=i+1;}}h_assert(serial_word(state,18)==0x60b0 && !db_bytes(db_at(state,17)),"FTDI last status and empty buffer");
    let status=serial_status(state,100);h_assert(serial_number(status,"cts")==1 && serial_number(status,"dsr")==1 && serial_number(status,"carrier_detect")==1,"FTDI modem status");h_assert(!serial_ftdi_divisor(2500000) && db_word(serial_ftdi_divisor(183))==0x1ffff,"FTDI reserved divisor rejection and minimum baud clamping");h_assert(serial_close(state) && !serial_read(state,1,100),"closed serial resource rejected");
    fixture_start(0x0700,3);state=serial_open("fixture",serial_port("ftdi",1,3,3,0),1);h_assert(state && serial_configure(state,2000000,8,0,0) && fixture_find(0x40,3,1,4),"FT2232H baud requests carry the selected port");
    fixture_start(0x0100,2);state=serial_open("fixture",serial_port("cp210x",1,2,2,0),0);h_assert(state && fixture_find(0x41,0,1,2),"CP210x enables selected interface");let flow=fixture_find(0x41,0x13,0,2);h_assert(flow,"CP210x sets explicit non-handshaking flow state");fixture_bytes(db_at(flow,5),1,0,0,0);h_assert(load8(db_word(db_at(flow,5))+4)==0x40,"CP210x RTS active flow state");h_assert(serial_configure(state,921600,8,0,0),"CP210x baud");let baud=fixture_find(0x41,0x1e,0,2);h_assert(baud,"CP210x baud request");let last=0;let i=0;while i<db_count(fixture_calls){let r=db_at(fixture_calls,i);if db_word(db_at(r,2))==0x1e{last=r;}i=i+1;}fixture_bytes(db_at(last,5),0,0x10,0x0e,0);h_assert(fixture_find(0x41,3,0x0800,2) && serial_lines(state,1,0) && fixture_find(0x41,7,0x0301,2),"CP210x frame and modem control");
    fixture_input=db_blob("0123456789",10);fixture_cursor=0;h_assert(db_bytes(serial_read(state,1,100))==1 && db_bytes(db_at(state,17))==9,"non-FTDI reads buffer complete USB packets too");
    fixture_start(0x0100,0);state=serial_open("fixture",serial_port("ch34x",1,0,0,0),0);h_assert(state && fixture_find(0x40,0xa1,0,0) && fixture_find(0x40,0x9a,0x2727,0),"CH34x initialisation and flow reset");h_assert(serial_configure(state,115200,8,0,0) && fixture_find(0x40,0x9a,0x1312,0xcc83) && fixture_find(0x40,0x9a,0x2518,0xc3),"CH340 115200 8N1 register requests");h_assert(serial_lines(state,1,1) && fixture_find(0x40,0xa4,0xff9f,0),"CH34x active-low modem lines");status=serial_status(state,100);h_assert(serial_number(status,"cts")==1 && serial_number(status,"ring")==1 && serial_number(status,"dsr")==0,"CH34x active-low status");let before=db_count(fixture_calls);h_assert(!serial_configure(state,9600,8,0,1) && db_count(fixture_calls)==before,"invalid framing has no USB side effect");
    fixture_start(0x0100,2);fixture_interfaces=db_list();db_add(fixture_interfaces,fixture_interface(0,2,2,0));db_add(fixture_interfaces,fixture_interface(4,2,2,0));db_add(fixture_interfaces,fixture_interface(2,10,0,1));let desc=alloc(32);db_copy(desc,db_word(fixture_descriptors),18);store8(desc+18,9);store8(desc+19,2);store8(desc+20,0);store8(desc+21,0);store8(desc+22,2);store8(desc+23,1);store8(desc+24,0);store8(desc+25,0x80);store8(desc+26,50);store8(desc+27,5);store8(desc+28,0x24);store8(desc+29,6);store8(desc+30,0);store8(desc+31,2);fixture_descriptors=db_blob(desc,32);state=serial_open("fixture",serial_port("cdc",1,2,99,0),0);h_assert(state && serial_word(state,5)==0 && serial_word(state,16)==0x83,"CDC Union chooses the actual master in a multi-control configuration");h_assert(serial_configure(state,115200,8,0,0),"CDC configure");last=0;i=0;while i<db_count(fixture_calls){let r=db_at(fixture_calls,i);if db_word(db_at(r,2))==0x20{last=r;}i=i+1;}fixture_bytes(db_at(last,5),0,0xc2,1,0);h_assert(db_bytes(db_at(last,5))==7 && load8(db_word(db_at(last,5))+6)==8,"CDC seven-byte line coding");h_assert(serial_break(state,1) && fixture_find(0x21,0x23,65535,0),"CDC break targets the master interface");
    fixture_start(0x0600,0);fixture_failure=4;state=serial_open("fixture",serial_port("ftdi",1,0,0,0),0);h_assert(!state && fixture_closed==1 && h_equal(db_error(),"Device rejected the injected request.") && h_equal(db_word(db_at(db_last_error_details,0)),"mock_error"),"failed setup closes USB and preserves original structured error");
    fixture_start(0x0600,0);state=serial_open("fixture",serial_port("ftdi",1,0,0,0),0);raw=alloc(64);store8(raw,0);store8(raw+1,0);i=2;while i<64{store8(raw+i,i);i=i+1;}fixture_input=db_blob(raw,64);h_assert(db_bytes(serial_read(state,1,100))==1,"buffered read seed");fixture_open=0;before=fixture_cursor;h_assert(!serial_read(state,1,100) && fixture_cursor==before && h_equal(db_error(),"Disconnected fixture."),"buffered serial data cannot bypass revoked Android ownership");
    fixture_start(0x0100,0);fixture_short=1;h_assert(!serial_open("fixture",serial_port("ch34x",1,0,0,0),0) && fixture_closed==1 && h_equal(db_word(db_at(db_last_error_details,0)),"short_transfer"),"short control response closes failed setup");
    fixture_start(0x0600,0);state=serial_open("fixture",serial_port("ftdi",1,0,0,0),0);fixture_input=db_blob("x",1);h_assert(!serial_read(state,1,100) && h_equal(db_word(db_at(db_last_error_details,0)),"invalid_response"),"truncated FTDI packet header is an error");
    h_print(1,"PASS USB serial protocols: CDC union/line coding, FTDI variants and packet framing, CP210x, CH34x, errors and ownership\n");return 0;
}
