// Executed by Collie's actual VM; SDK/service oracles live outside the guest.
fn sc_handle(){return db_word(state_get("sensor-primary"));}
fn sc_sample(){let n=0;while n<40{let e=device_wait(sc_handle(),500);if !e{return 1;}if worker_equal(db_word(device_field(e,"event")),"sample"){let v=device_field(e,"values");if db_count(v)<3||db_kind(db_at(v,0))!=4||db_word(device_field(e,"timestamp_ns"))<=0{return 2;}let expected=state_get("sensor-expected");if db_count(expected)!=3{return 4;}if db_word(db_at(v,0))==db_word(db_at(expected,0))&&db_word(db_at(v,1))==db_word(db_at(expected,1))&&db_word(db_at(v,2))==db_word(db_at(expected,2)){return 0;}}n=n+1;}return 3;}
fn sc_flush(){let request=sensor_flush(sc_handle(),8000);if db_kind(request)!=1||db_word(request)<1{return 1;}state_set("sensor-flush",request);return 0;}
fn sc_waiting(){db_io(0,1,"pending",7);return 0;}
fn sc_complete(){let request=db_word(state_get("sensor-flush"));let n=0;while n<16{let e=device_wait(sc_handle(),0);if !e{return 1;}if db_kind(e)==0{return sc_waiting();}if worker_equal(db_word(device_field(e,"event")),"overflow"){e=device_field(e,"next");if db_kind(e)==0{return sc_waiting();}}if worker_equal(db_word(device_field(e,"event")),"flush_complete"){if db_word(device_field(e,"request"))!=request{return 2;}db_io(0,1,"done",4);return 0;}n=n+1;}return sc_waiting();}
fn sc_pending(){let h=sc_handle();if !sensor_flush(h,2000){return 1;}if sensor_flush(h,2000){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"busy"){return 3;}if sensor_configure(h,20000,0){return 4;}if !worker_equal(db_word(db_at(device_error(),0)),"busy"){return 5;}return 0;}
