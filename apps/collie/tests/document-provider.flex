// Executed by the actual Collie VM; the Android fixture supplies SDK oracles.
fn dp_find(tree,parent,name){let p=document_children(tree,parent,0,16);if !p{return "";}let rows=device_field(p,"documents");let i=0;while i<db_count(rows){let row=db_at(rows,i);if worker_equal(db_word(device_field(row,"name")),name){return db_word(device_field(row,"id"));}i=i+1;}return "";}
fn dp_tree(){return db_word(state_get("provider-tree"));}
fn dp_open(){let tree=document_tree_open(db_word(state_get("provider-grant")));if !tree{return 1;}state_set("provider-tree",tree);let t=db_word(tree);if !load8(dp_find(t,"root","source"))||!load8(dp_find(t,"root","target"))||!load8(dp_find(t,"root","virtual-note")){return 2;}return 0;}
fn dp_write(){let t=dp_tree();let source=dp_find(t,"root","source");let d=document_create(t,source,"payload.bin","application/octet-stream");if !d{return 1;}let id=db_word(device_field(d,"id"));let h=document_file_open(t,id,"rwt");if !h{return 2;}let b=alloc(32768);let i=0;while i<32768{store8(b+i,i%256);i=i+1;}if db_word(device_write(db_word(h),db_blob(b,32768)))!=32768||db_word(device_write(db_word(h),db_blob(b,23)))!=23{return 3;}state_set("provider-write-handle",h);state_set("provider-old-node",db_text(id));return 0;}
fn dp_copy(){let t=dp_tree();let source=dp_find(t,"root","source");let target=dp_find(t,"root","target");let original=dp_find(t,source,"payload.bin");let copy=document_copy(t,original,target);if !copy{return 1;}if document_info(t,original){return 2;}if !worker_equal(db_word(db_at(device_error(),0)),"stale_document"){return 3;}if device_info(db_word(state_get("provider-write-handle"))){return 4;}source=dp_find(t,"root","source");target=dp_find(t,"root","target");if !load8(dp_find(t,source,"payload.bin"))||!load8(dp_find(t,target,"payload.bin")){return 5;}return 0;}
fn dp_move(){let t=dp_tree();let source=dp_find(t,"root","source");let target=dp_find(t,"root","target");let copy=dp_find(t,target,"payload.bin");let moved=document_move(t,copy,target,source);if !moved{return 1;}if document_info(t,copy){return 2;}target=dp_find(t,"root","target");if load8(dp_find(t,target,"payload.bin")){return 3;}let page=document_children(t,dp_find(t,"root","source"),0,16);let rows=device_field(page,"documents");let count=0;let i=0;while i<db_count(rows){if worker_equal(db_word(device_field(db_at(rows,i),"name")),"payload.bin"){count=count+1;}i=i+1;}if count!=2{return 4;}return 0;}
fn dp_remove(){let t=dp_tree();let source=dp_find(t,"root","source");let target=dp_find(t,"root","target");let shared=dp_find(t,target,"shared.txt");if !worker_equal(shared,dp_find(t,source,"shared.txt")){return 1;}if db_word(document_remove(t,shared,target))!=1{return 2;}if document_info(t,shared){return 3;}target=dp_find(t,"root","target");source=dp_find(t,"root","source");if load8(dp_find(t,target,"shared.txt"))||!load8(dp_find(t,source,"shared.txt")){return 4;}return 0;}
fn dp_types(){let t=dp_tree();let v=dp_find(t,"root","virtual-note");let types=document_types(t,v,"text/*");if db_count(types)!=1||!worker_equal(db_word(db_at(types,0)),"text/plain"){return 1;}types=document_types(t,v,"application/*");if db_count(types)!=1||!worker_equal(db_word(db_at(types,0)),"application/octet-stream"){return 2;}if db_count(document_types(t,v,"image/*")){return 3;}if document_file_open(t,v,"r"){return 4;}if !worker_equal(db_word(db_at(device_error(),0)),"not_found"){return 5;}if document_typed_open(t,v,"text/*"){return 6;}if !worker_equal(db_word(db_at(device_error(),0)),"invalid_argument"){return 7;}if document_typed_open(t,v,"image/png"){return 8;}return 0;}
fn dp_text(){let t=dp_tree();let v=dp_find(t,"root","virtual-note");let h=document_typed_open(t,v,"text/plain");if !h{return 1;}let b=device_read(db_word(h),32768,1000);let expected="Hello Collie\nUSB & NFC\n";if db_bytes(b)!=db_len(expected){return 2;}let i=0;while i<db_bytes(b){if load8(db_word(b)+i)!=load8(expected+i){return 3;}i=i+1;}if db_kind(device_read(db_word(h),1,1000))!=0{return 4;}return device_close(db_word(h))-1;}
fn dp_binary(){let t=dp_tree();let v=dp_find(t,"root","virtual-note");let h=document_typed_open(t,v,"application/octet-stream");if !h{return 1;}let i=0;while i<32791{let b=device_read(db_word(h),32768,1000);if db_kind(b)!=3||db_bytes(b)<1||i+db_bytes(b)>32791{return 2;}let j=0;while j<db_bytes(b){if load8(db_word(b)+j)!=(37+(i+j)*17)%256{return 3;}j=j+1;}i=i+db_bytes(b);}if db_kind(device_read(db_word(h),1,1000))!=0{return 4;}return device_close(db_word(h))-1;}
fn dp_pipe(){let t=dp_tree();let h=document_typed_open(t,dp_find(t,"root","pipe-note"),"application/octet-stream");if !h{return 1;}state_set("provider-pipe",h);return 0;}
fn dp_timeout(){let h=db_word(state_get("provider-pipe"));if device_read(h,32,80){return 1;}if !worker_equal(db_word(db_at(device_error(),0)),"timeout"){return 2;}if db_word(device_field(device_info(h),"bytes_transferred"))!=0{return 3;}return 0;}
fn dp_pipe_read(){let h=db_word(state_get("provider-pipe"));let b=device_read(h,32768,1000);if db_bytes(b)!=3||load8(db_word(b))!=37||load8(db_word(b)+1)!=0||load8(db_word(b)+2)!=255{return 1;}if db_kind(device_read(h,1,1000))!=0{return 2;}return device_close(h)-1;}
