// Original32KiB RFCOMM VM and independent peer assertions.
fn rfcomm_peer_live_connect(address,uuid,secure){let d=bt_device(address);if !d{return 1;}if db_word(device_field(device_info(db_word(d)),"bond_state"))!=10{return 3;}state_set("peer",d);let s=bt_rfcomm_connect(db_word(d),uuid,secure,60000);if !s{return 2;}return state_set("socket",s)-1;}
fn rfcomm_peer_live_connected(){let h=db_word(state_get("socket"));let i=0;while i<25{let e=device_wait(h,1000);if db_kind(e)==5{let kind=device_field(e,"event");if worker_equal(db_word(kind),"connected"){return 0;}if worker_equal(db_word(kind),"error"){let text=device_field(e,"message");db_io(0,2,db_word(text),db_bytes(text));return 1;}}i=i+1;}return 2;}
fn rfcomm_peer_live_echo(){let h=db_word(state_get("socket"));let p=alloc(32768);let i=0;while i<32768{store8(p+i,i%256);i=i+1;}if db_word(device_write(h,db_blob(p,32768)))!=32768{return 1;}let at=0;while at<32768{let b=device_read(h,32768-at,8000);if !b || db_kind(b)!=3 || !db_bytes(b){return 2;}i=0;while i<db_bytes(b){if load8(db_word(b)+i)!=(at+i)%256{return 3;}i=i+1;}at=at+db_bytes(b);}return 0;}
fn rfcomm_peer_live_timeout(){let h=db_word(state_get("socket"));if device_read(h,1,200){return 1;}let e=device_error();if !worker_equal(db_word(db_at(e,0)),"timeout"){return 2;}if device_info(h){return 3;}return device_close(db_word(state_get("peer")))-1;}
fn rfcomm_peer_live_unbonded(address){let d=bt_device(address);if !d{return 1;}if db_word(device_field(device_info(db_word(d)),"bond_state"))!=10{return 2;}return device_close(db_word(d))-1;}
