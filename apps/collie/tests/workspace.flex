import "../core/cli.flex";
import "../../../scripts/lib/harness.flex";

fn ct_workspace_codec() {
    t_assert(h_equal(cg_source(),h_read("guest/runtime.flex")),"embedded guest SDK matches its source");
    let v=db_list();db_add(v,db_int(-9223372036854775807-1));db_add(v,db_text("hello"));db_add(v,db_blob("a\0b",3));db_add(v,db_real(0x3ff8000000000000));db_add(v,db_null());let n=db_encode(v);let parsed=db_decode(db_wire,n);
    t_assert(db_count(parsed)==5 && db_word(db_at(parsed,0))==(-9223372036854775807-1) && db_bytes(db_at(parsed,2))==3 && load8(db_word(db_at(parsed,2))+1)==0,"wire preserves signed integers, binary data and value kinds");
    t_assert(!db_decode(db_wire,7),"truncated database values rejected");
    let raw=h_take(32);store64(raw,5);store64(raw+8,-1);t_assert(!db_decode(raw,16),"negative database list lengths rejected");store64(raw,2);store64(raw+8,2);store8(raw+16,65);store8(raw+17,0);t_assert(!db_decode(raw,18),"NUL in text rejected before host names are used");
    let req=db_list();db_add(req,db_text("unknown"));cw_db=0;let size=db_encode(req);size=cw_reply(db_wire,size);let reply=db_decode(db_wire,size);t_assert(db_kind(db_at(reply,0))==2,"unknown database operations return an error without executing");
    req=db_request("create");db_add(req,db_int(0));db_add(req,db_list());let config=j_object();j_set(config,"workspace_file",j_string(h_join(t_work,"wire.flexdb")));cw_config=config;size=db_encode(req);size=cw_reply(db_wire,size);reply=db_decode(db_wire,size);t_assert(db_kind(db_at(reply,0))==2,"untrusted schema arguments cannot become host pointers");cw_close();
    let archive=j_array();collie_message(archive,"user","old task");let message=j_object();j_set(message,"role",j_string("assistant"));j_set(message,"content",j_string("old answer"));j_set(message,"source",j_string("fn main(){return 0;}"));j_push(archive,message);cw_archive_save(config,archive);let restored=cw_archive_load(config);t_assert(j_count(restored)==2 && h_equal(j_s(j_at(restored,0),"content"),"old task"),"independent workspace archive persists conversation and code");
}
fn ct_workspace_program(config,source,expected) {
    let history=j_array();collie_message(history,"user","an earlier user request");let item=j_object();j_set(item,"role",j_string("assistant"));j_set(item,"content",j_string("an earlier assistant reply"));j_set(item,"source",j_string("prior source"));j_push(history,item);
    let result=cp_execute_history(config,source,history);let ok=j_n(result,"exit_code")==0 && h_equal(j_s(result,"stdout"),expected);if !ok {h_print(2,h_cat(j_dump(result),"\n"));}t_assert(ok,"real VM database program and output");return result;
}
fn ct_workspace_vm(compiler) {
    let config=j_object();j_set(config,"compiler",j_string(compiler));j_set(config,"workspace_file",j_string(h_join(t_work,"agent.flexdb")));
    ct_workspace_program(config,"global own_state=0;fn main(){if db_count(db_tables())!=0{return 1;}if !db_begin(){return 2;}let s=db_schema();db_column(s,\"label\",2,0);db_column(s,\"n\",1,0);db_column(s,\"data\",3,0);db_column(s,\"real\",4,0);db_column(s,\"optional\",1,1);if !db_create(\"agent_chosen_table\",s){return 3;}let v=db_values();db_add(v,db_text(\"remembered\"));db_add(v,db_int(-9223372036854775807-1));db_add(v,db_blob(\"a\\0b\",3));db_add(v,db_real(0x3ff8000000000000));db_add(v,db_null());if db_insert(\"agent_chosen_table\",v)!=1 || !db_commit(){return 4;}return 0;}","");
    ct_workspace_program(config,"fn main(){let names=db_tables();if db_count(names)!=1 || db_count(db_columns(\"agent_chosen_table\"))!=5{return 1;}let row=db_get(\"agent_chosen_table\",1);if db_word(db_cell(row,1))!=(-9223372036854775807-1) || db_bytes(db_cell(row,2))!=3 || load8(db_word(db_cell(row,2))+1)!=0 || db_word(db_cell(row,3))!=0x3ff8000000000000 || db_kind(db_cell(row,4))!=0{return 2;}let s=db_word(db_cell(row,0));syscall(1,1,s,db_len(s),0,0,0);return 0;}","remembered");
    ct_workspace_program(config,"fn main(){if !db_begin(){return 1;}if !db_add_column(\"agent_chosen_table\",\"learned\",1,0,db_int(42)) || !db_rename_column(\"agent_chosen_table\",\"label\",\"title\") || !db_drop_column(\"agent_chosen_table\",\"optional\") || !db_commit(){return 2;}let row=db_get(\"agent_chosen_table\",1);if db_rowid(row)!=1 || db_word(db_cell(row,4))!=42{return 3;}return 0;}","");
    ct_workspace_program(config,"fn main(){let cols=db_columns(\"agent_chosen_table\");if db_count(cols)!=5 || db_len(db_word(db_at(db_at(cols,0),0)))!=5{return 1;}let rows=db_scan(\"agent_chosen_table\",0,1);if db_count(rows)!=1 || db_rowid(db_at(rows,0))!=1 || db_count(db_scan(\"agent_chosen_table\",1,1))!=0{return 2;}if !db_begin() || !db_delete(\"agent_chosen_table\",1) || !db_rollback(){return 3;}if db_kind(db_get(\"agent_chosen_table\",1))==0{return 4;}return 0;}","");
    ct_workspace_program(config,"fn main(){if !db_begin() || !db_delete(\"agent_chosen_table\",1){return 1;}return 0;}","");
    ct_workspace_program(config,"fn main(){if db_kind(db_get(\"agent_chosen_table\",1))==0{return 1;}if !db_begin() || !db_drop_column(\"agent_chosen_table\",\"learned\") || !db_rollback(){return 2;}return 0;}","");
    let failed=cp_execute(config,"fn main(){db_begin();db_delete(\"agent_chosen_table\",1);return load64(-1);}");t_assert(h_has(j_s(failed,"stderr"),"out of bounds"),"database program traps remain contained");
    ct_workspace_program(config,"fn main(){if db_kind(db_get(\"agent_chosen_table\",1))==0 || db_count(db_columns(\"agent_chosen_table\"))!=5{return 1;}if db_update(\"agent_chosen_table\",1,db_values()) || db_len(db_error())==0{return 2;}return 0;}","");
    ct_workspace_program(config,"fn main(){let rows=db_history(0,1);if db_count(rows)!=1 || db_rowid(db_at(rows,0))!=1{return 1;}let s=db_word(db_cell(db_at(rows,0),1));syscall(1,1,s,db_len(s),0,0,0);let chunk=db_history_read(2,\"source\",0,100);if db_kind(chunk)!=3 || db_bytes(chunk)!=12{return 2;}if db_count(db_tables())!=1{return 3;}return 0;}","an earlier user request");
    failed=cp_execute(config,"fn main(){return syscall(2,\"/home/teppo/.codex/auth.json\",0,0,0,0,0);}");t_assert(h_has(j_s(failed,"stderr"),"host capability denied"),"database grant does not grant host files");
    failed=cp_execute(config,"fn main(){return ffi_open(\"libc.so.6\");}");t_assert(h_has(j_s(failed,"stderr"),"host capability denied"),"database grant does not grant FFI");
    failed=cp_execute(config,"fn main(){let p=alloc(16);db_copy(p,\"COLLIEDB\",8);store64(p+8,-1);syscall(1,2,p,16,0,0,0);return 0;}");t_assert(h_has(j_s(failed,"stderr"),"Invalid database request frame"),"malformed database frames fail closed");
    let other=j_object();j_set(other,"compiler",j_string(compiler));j_set(other,"workspace_file",j_string(h_join(t_work,"other-agent.flexdb")));ct_workspace_program(other,"fn main(){if db_count(db_tables())!=0{return 1;}return 0;}","");
    let header=h_read(j_s(config,"workspace_file"));t_assert(h_bytes(header,"FLEXDB",6),"agent storage is the real FlexDB format");
    let st=h_take(144);h_assert(syscall(4,j_s(config,"workspace_file"),st,0,0,0,0)==0,"workspace stat");t_assert((load64(st+24)&511)==384,"workspace file permissions are 0600");
    ct_workspace_program(config,"fn main(){let p=alloc(5000);let i=0;while i<5000{store8(p+i,i%251);i=i+1;}if !db_begin(){return 1;}let s=db_schema();db_column(s,\"bytes\",3,0);if !db_create(\"wire_chunks\",s){return 2;}let v=db_values();db_add(v,db_blob(p,5000));if !db_insert(\"wire_chunks\",v) || !db_commit(){return 3;}let value=db_cell(db_get(\"wire_chunks\",1),0);if db_bytes(value)!=5000 || load8(db_word(value)+4999)!=4999%251{return 4;}return 0;}","");
    let native=open_flexdb(j_s(config,"workspace_file"));h_assert(native && flexdb_begin(native),"prepare bounded page fixture");let schema=flexdb_schema(native);flexdb_column(native,schema,"payload",3,0);let table=flexdb_create(native,"large_pages",schema);let data=alloc(32000);store8(data,123);let values=flexdb_values(native);flexdb_add(native,values,flexdb_blob(native,data,32000));let i=0;while i<3 {h_assert(flexdb_insert(table,values),"seed large page");i=i+1;}h_assert(flexdb_commit(native) && close_flexdb(native),"commit large page fixture");
    ct_workspace_program(config,"fn main(){if db_scan(\"large_pages\",0,3) || db_len(db_error())==0{return 1;}let rows=db_scan(\"large_pages\",0,1);if db_count(rows)!=1{return 2;}let value=db_cell(db_at(rows,0),0);if db_bytes(value)!=32000 || load8(db_word(value))!=123{return 3;}return 0;}","");
}
