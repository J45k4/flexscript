plugin shader.bindings_vertex v1 {}
shader vertex {
    input vertex: vec3f location(0)
    output position: vec4f builtin(position)
    output world: vec3f location(0)
    output clip: vec4f location(1)
    uniform camera: mat4f binding(8)
    fn main() -> void {
        world = vertex
        clip = camera * vec4f(vertex, 1.0)
        position = clip
    }
}
