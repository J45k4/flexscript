import "monolith/multipart.flex";
fn main(argc,argv) {if argc!=2 {return 2;}let bytes=alloc(2097152);let n=0;while n<2097152 {let k=syscall(0,0,bytes+n,2097152-n,0,0,0);if k<0 {return 3;}if !k {let state=mono_mp_open(load64(argv+8),bytes,n,64);if !state {m_print(1,"ERROR\n");return 0;}let status=mono_mp_next(state);while status==1 {let data=mono_mp_data(state);let size=mono_mp_size(state);let hash=0;let i=0;while i<size {hash=(hash*31+load8(data+i))%1000000007;i=i+1;}m_print(1,m_cat(m_cat(m_cat(mono_mp_name(state),":"),m_int(size)),m_cat(":",m_cat(m_int(hash),"\n"))));status=mono_mp_next(state);}if status<0 {m_print(1,"ERROR\n");}else {m_print(1,"DONE\n");}return 0;}n=n+k;}return 4;}
