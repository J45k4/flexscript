import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global wc=0;global wcase=0;global wcode=0;global wsize=0;global wm=0;
fn check(ok,message){wc=wc+1;if !ok{h_print(2,h_cat3("Window case ",h_int(wcase),h_cat3(" check ",h_int(wc),h_cat3(": ",message,"\n"))));syscall(60,1,0,0,0,0,0);}return 0;}
fn item(name){let count=em_u32(wm+8);let i=0;while i<count{let p=wm+16+i*40;if h_equal(p+8,name){return p;}i=i+1;}check(0,name);return 0;}
fn pc_of(name){return 0x1000+em_u32(item(name));}
fn at(c,name){store64(c+128,pc_of(name));return 0;}
fn step(c,name){at(c,name);let result=xt_step(c);if result<0{h_print(2,h_cat3("Opcode ",h_int(load64(c+216)),h_cat3(" fault ",h_int(load64(c+160)),"\n")));}check(result==0,"GNU opcode executes");return 0;}
fn fresh(){let c=xt_create();let p=xt_map(c,0x1000,4096,5);check(p>0 && xt_map(c,0x2000,4096,3)>0,"code and SRAM maps");em_copy(p,wcode,wsize);xt_wsr(c,231,0x1000);return c;}
fn bit(wb){return 1<<(wb&15);}
fn finger(i){return 0x12340000+i*0x10203;}
fn fill(c){xt_wsr(c,230,0);let block=0;while block<4{xt_wsr(c,72,block*4);let r=0;while r<16{xt_setreg(c,r,finger(block*16+r));r=r+1;}block=block+1;}xt_wsr(c,72,0);return 0;}
fn mapping(){wcase=1;let c=fresh();fill(c);let wb=0;while wb<16{xt_wsr(c,72,wb);let r=0;while r<16{check(xt_reg(c,r)==finger((wb*4+r)&63),"all64 physical ARs across16 overlapping windows");r=r+1;}wb=wb+1;}xt_wsr(c,72,0xffffffff);check(xt_sr(c,72)==15,"WINDOWBASE width");xt_wsr(c,73,0xdeadbeef);check(xt_sr(c,73)==0xbeef,"WINDOWSTART width");let deltas="rotwneg8,rotwneg1,rotw0,rotw1,rotw4,rotw7";let names=alloc(48);store64(names,"rotwneg8");store64(names+8,"rotwneg1");store64(names+16,"rotw0");store64(names+24,"rotw1");store64(names+32,"rotw4");store64(names+40,"rotw7");let values=alloc(48);store64(values,-8);store64(values+8,-1);store64(values+16,0);store64(values+24,1);store64(values+32,4);store64(values+40,7);wb=0;while wb<16{let i=0;while i<6{xt_wsr(c,72,wb);xt_wsr(c,73,0x9639);step(c,load64(names+i*8));let expected=(wb+load64(values+i*8))&15;check(xt_sr(c,72)==expected && xt_sr(c,73)==0x9639,"signed ROTW wraps and preserves active starts");let r=0;while r<16{check(xt_reg(c,r)==finger((expected*4+r)&63),"ROTW changes only the view");r=r+1;}i=i+1;}wb=wb+1;}xt_close(c);return 0;}
fn calls(){let names=alloc(64);store64(names,"call0");store64(names+8,"call4");store64(names+16,"call8");store64(names+24,"call12");store64(names+32,"callx0");store64(names+40,"callx4");store64(names+48,"callx8");store64(names+56,"callx12");let wb=0;while wb<16{let op=0;while op<8{wcase=100+wb*8+op;let c=fresh();fill(c);let inc=op&3;xt_wsr(c,72,wb);xt_wsr(c,73,bit(wb));xt_setreg(c,1,0x2080);xt_setreg(c,8,0x1400);let ps=0x40000|(3<<16)|7;xt_wsr(c,230,ps);let name=load64(names+op*8);let pc=pc_of(name);step(c,name);let tagged=pc+3;if inc{tagged=(inc<<30)|((pc+3)&0x3fffffff);}check(load64(c+128)==0x1400 && xt_reg(c,inc*4)==tagged,"CALL target and tagged return, including source/destination overlap");check(xt_sr(c,72)==wb,"CALL defers rotation until ENTRY");let expected=ps;if inc{expected=(ps&~0x30000)|(inc<<16);}check(xt_sr(c,230)==expected,"CALLINC only changes for windowed calls");if inc{xt_setreg(c,inc*4+2,0x71532519);check(xt_step(c)==0,"callee GNU ENTRY");check(xt_sr(c,72)==((wb+inc)&15) && xt_sr(c,73)==(bit(wb)|bit(wb+inc)),"ENTRY activates callee window");check(xt_reg(c,1)==0x2060 && xt_reg(c,2)==0x71532519,"ENTRY takes caller SP and register arguments");xt_setreg(c,2,0xa1b2c3d4);check(xt_step(c)==0,"callee GNU RETW.N");check(load64(c+128)==pc+3 && xt_sr(c,72)==wb && xt_sr(c,73)==bit(wb),"RETW restores caller and clears callee start");check(xt_reg(c,1)==0x2080 && xt_reg(c,inc*4+2)==0xa1b2c3d4,"windowed result and caller stack survive");}xt_close(c);op=op+1;}wb=wb+1;}return 0;}
fn entries(){let names=alloc(32);store64(names,"entry0");store64(names+8,"entry1");store64(names+16,"entry2");store64(names+24,"entry3");let sizes=alloc(32);store64(sizes,0);store64(sizes+8,32);store64(sizes+16,4096);store64(sizes+24,32760);let wb=0;while wb<16{let inc=0;while inc<4{let r=0;while r<4{wcase=300+wb*16+inc*4+r;let c=fresh();fill(c);xt_wsr(c,72,wb);xt_wsr(c,73,bit(wb));let original=xt_reg(c,r);xt_wsr(c,230,0x40000|(inc<<16));step(c,load64(names+r*8));check(xt_sr(c,72)==((wb+inc)&15) && xt_reg(c,r)==((original-load64(sizes+r*8))&0xffffffff),"ENTRY register selector,full immediate and modular WB");check(xt_sr(c,73)==(bit(wb)|bit(wb+inc)),"ENTRY WINDOWSTART preservation");xt_close(c);r=r+1;}inc=inc+1;}wb=wb+1;}return 0;}
fn returns(){let wb=0;while wb<16{let inc=1;while inc<=3{let narrow=0;while narrow<2{wcase=600+wb*6+(inc-1)*2+narrow;let c=fresh();fill(c);xt_wsr(c,72,wb);xt_wsr(c,73,bit(wb)|bit(wb-inc)|bit(wb+7));xt_setreg(c,0,(inc<<30)|0x01234567);xt_wsr(c,230,0x40000|(((inc+1)&3)<<16));let name="retw";if narrow{name="retwn";}step(c,name);check(load64(c+128)==0x01234567 && xt_sr(c,72)==((wb-inc)&15),"RETW uses a0 tag rather than PS CALLINC");check(xt_sr(c,73)==(bit(wb-inc)|bit(wb+7)),"RETW clears only departing window");xt_close(c);narrow=narrow+1;}inc=inc+1;}wb=wb+1;}return 0;}
fn spill_fill(){let names=alloc(24);store64(names,"mov7");store64(names+8,"mov11");store64(names+16,"mov15");let wb=0;while wb<16{let group=1;while group<=3{let first=1;while first<=group{let kind=1;while kind<=3{wcase=800+wb*54+group*12+first*3+kind;let c=fresh();fill(c);let ws=bit(wb)|bit(wb+first)|bit(wb+first+kind);xt_wsr(c,72,wb);xt_wsr(c,73,ws);xt_wsr(c,230,0x40000);let name=load64(names+(group-1)*8);let pc=pc_of(name);let retired=load64(c+176);step(c,name);check(load64(c+128)==0x1000+(kind-1)*128,"overflow4/8/12 vector from next active frame");check(xt_sr(c,72)==((wb+first)&15) && ((xt_sr(c,230)>>8)&15)==wb && (xt_sr(c,230)&16),"overflow WB/OWB/EXCM state");check(xt_sr(c,177)==pc && xt_sr(c,73)==ws && load64(c+176)==retired,"overflow retries without retiring or changing active starts");step(c,"rfwo");ws=ws&~bit(wb+first);check(load64(c+128)==pc && xt_sr(c,72)==wb && !(xt_sr(c,230)&16) && xt_sr(c,73)==ws,"RFWO frees spilled window and retries original PC");let attempts=0;while attempts<4{let before=load64(c+176);check(xt_step(c)==0,"retry overflow instruction");if load64(c+176)>before{attempts=4;}else{step(c,"rfwo");attempts=attempts+1;}}check(load64(c+128)==pc+3,"all overlapping live windows spill before register access");xt_close(c);kind=kind+1;}first=first+1;}group=group+1;}wb=wb+1;}
 wb=0;while wb<16{let inc=1;while inc<=3{wcase=1800+wb*3+inc;let c=fresh();fill(c);xt_wsr(c,72,wb);xt_wsr(c,73,bit(wb));xt_setreg(c,0,(inc<<30)|0x13572468);xt_wsr(c,230,0x40000);let pc=pc_of("retw");let before=load64(c+176);step(c,"retw");check(load64(c+128)==0x1000+(inc-1)*128+64 && xt_sr(c,72)==((wb-inc)&15),"underflow vector and missing caller window");check(xt_sr(c,177)==pc && ((xt_sr(c,230)>>8)&15)==wb && (xt_sr(c,230)&16) && load64(c+176)==before,"underflow saves retry context");step(c,"rfwu");check(load64(c+128)==pc && xt_sr(c,72)==wb && xt_sr(c,73)==(bit(wb)|bit(wb-inc)) && !(xt_sr(c,230)&16),"RFWU activates refilled window before retry");check(xt_step(c)==0 && load64(c+128)==0x13572468 && xt_sr(c,72)==((wb-inc)&15),"RETW succeeds after refill");xt_close(c);inc=inc+1;}wb=wb+1;}return 0;}
fn exceptions(){let scenario=0;while scenario<7{wcase=2000+scenario;let c=fresh();fill(c);xt_wsr(c,72,5);xt_wsr(c,73,bit(5));xt_wsr(c,230,0x40000);xt_setreg(c,0,(2<<30)|0x1234);let name="retw";let cause=0;let expected=0x1300;let pc=0;if scenario==0{xt_setreg(c,0,0x1234);}if scenario==1{xt_wsr(c,73,bit(5)|bit(4));}if scenario==2{xt_wsr(c,230,0);}if scenario==3{name="entry1";xt_wsr(c,230,0);}if scenario==4{name="entry1";xt_wsr(c,230,16|0x40000);expected=0x13c0;}if scenario==5{name="movsp";cause=5;}if scenario==6{name="illn";xt_wsr(c,230,32);expected=0x1340;}pc=pc_of(name);let before=load64(c+176);step(c,name);check(xt_sr(c,232)==cause && (xt_sr(c,230)&16) && load64(c+128)==expected,"illegal-window/alloca/user/double exception vectors");let epc=177;if scenario==4{epc=192;}check(xt_sr(c,epc)==pc && load64(c+176)==before,"architectural exception preserves faulting PC and retirement");xt_close(c);scenario=scenario+1;}return 0;}
fn special(){wcase=2100;let c=fresh();fill(c);xt_wsr(c,72,4);xt_setreg(c,5,0xfedcba98);step(c,"xsrwb");check(xt_sr(c,72)==8 && xt_reg(c,5)==finger(37),"XSR WINDOWBASE switches view after old destination write");xt_wsr(c,72,4);check(xt_reg(c,5)==4,"XSR writes old WINDOWBASE to old physical register");xt_setreg(c,5,0x1abcde);step(c,"wsrws");check(xt_sr(c,73)==0xbcde,"WSR WINDOWSTART masks high bits");xt_setreg(c,5,0x9639);step(c,"xsrws");check(xt_sr(c,73)==0x9639 && xt_reg(c,5)==0xbcde,"XSR WINDOWSTART exchanges values");step(c,"rsrwb");check(xt_reg(c,5)==4,"RSR WINDOWBASE");step(c,"rsrws");check(xt_reg(c,5)==0x9639,"RSR WINDOWSTART");xt_wsr(c,73,bit(4)|bit(3));xt_wsr(c,230,0x40000);xt_setreg(c,5,0x20f0);step(c,"movsp");check(xt_reg(c,1)==0x20f0,"MOVSP with live caller");xt_wsr(c,230,16);xt_setreg(c,5,0x2040);xt_write(c,0x2030,4,0x91a2b3c4);step(c,"l32e");check(xt_reg(c,3)==0x91a2b3c4,"L32E negative window-save offset");xt_setreg(c,9,0x2080);xt_setreg(c,2,0x76543210);step(c,"s32e");check(xt_read(c,0x2040,4)==0x76543210,"S32E negative window-save offset");xt_close(c);return 0;}
fn compact(){let c=fresh();let names=alloc(48);store64(names,"movinneg32");store64(names+8,"movinneg1");store64(names+16,"movin0");store64(names+24,"movin31");store64(names+32,"movin63");store64(names+40,"movin95");let values=alloc(48);store64(values,-32);store64(values+8,-1);store64(values+16,0);store64(values+24,31);store64(values+32,63);store64(values+40,95);let wb=0;while wb<16{wcase=2200+wb;xt_wsr(c,72,wb);let i=0;while i<6{step(c,load64(names+i*8));check(xt_reg(c,8)==(load64(values+i*8)&0xffffffff),"MOVI.N asymmetric immediate range");i=i+1;}xt_setreg(c,3,0xffffffff);xt_setreg(c,4,2);step(c,"addn");check(xt_reg(c,2)==1,"ADD.N unsigned word wrap");step(c,"addinneg1");check(xt_reg(c,2)==0xfffffffe,"ADDI.N zero encoding means minus1");step(c,"addin1");check(xt_reg(c,2)==0,"ADDI.N plus1 wraps");step(c,"addin15");check(xt_reg(c,2)==14,"ADDI.N largest immediate");xt_setreg(c,5,0x2000);xt_write(c,0x203c,4,0xdeadbeef);step(c,"l32in");check(xt_reg(c,4)==0xdeadbeef,"L32I.N largest offset");xt_setreg(c,7,0x2000);xt_setreg(c,6,0x12785634);step(c,"s32in");check(xt_read(c,0x2004,4)==0x12785634,"S32I.N offset");step(c,"movn");check(xt_reg(c,11)==0xffffffff,"MOV.N operands");let choice=0;while choice<2{xt_setreg(c,6,choice);step(c,"beqzn");let target=pc_of("beqzn")+2;if !choice{target=pc_of("beqzn")+32;}check(load64(c+128)==target,"BEQZ.N PC+4 unsigned displacement");xt_setreg(c,7,choice);step(c,"bnezn");target=pc_of("bnezn")+2;if choice{target=pc_of("bnezn")+64;}check(load64(c+128)==target,"BNEZ.N predicate/displacement");choice=choice+1;}step(c,"l32r");check(xt_reg(c,8)==xt_read(c,0x1000,4),"GNU relocated L32R literal");xt_setreg(c,0,0xc1357246);step(c,"retn");check(load64(c+128)==0xc1357246,"RET.N absolute return");step(c,"nopn");check(load64(c+128)==pc_of("nopn")+2,"NOP.N retirement width");wb=wb+1;}
 // A compact instruction at the final two executable bytes must not fetch3.
 let code=xt_load_region(c,0x1ffe,2);let host=load64(code+16)+0xffe;let source=wcode+em_u32(item("nopn"));store8(host,load8(source));store8(host+1,load8(source+1));store64(c+128,0x1ffe);check(xt_step(c)==0 && load64(c+128)==0x2000,"compact fetch at executable region boundary");xt_close(c);return 0;}
// GNU bytes supply the decoder inputs; arithmetic expectations use multiplication.
fn scaled(){let names=alloc(144);store64(names+0,"addx2g1");store64(names+8,"addx2g2");store64(names+16,"addx2g3");store64(names+24,"addx4g1");store64(names+32,"addx4g2");store64(names+40,"addx4g3");store64(names+48,"addx8g1");store64(names+56,"addx8g2");store64(names+64,"addx8g3");store64(names+72,"subx2g1");store64(names+80,"subx2g2");store64(names+88,"subx2g3");store64(names+96,"subx4g1");store64(names+104,"subx4g2");store64(names+112,"subx4g3");store64(names+120,"subx8g1");store64(names+128,"subx8g2");store64(names+136,"subx8g3");let values=alloc(64);store64(values,0);store64(values+8,1);store64(values+16,2);store64(values+24,0x7fffffff);store64(values+32,0x80000000);store64(values+40,0xfffffffe);store64(values+48,0xffffffff);store64(values+56,0x12345678);let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let op=0;while op<18{let group=op%3+1;let dest=3;let src=7;let rhs=2;if group==2{dest=7;src=11;rhs=3;}if group==3{dest=15;src=7;rhs=11;}let factor=2;if op/3%3==1{factor=4;}if op/3%3==2{factor=8;}let i=0;while i<8{let j=0;while j<8{wcase=2300+wb*18+op;xt_wsr(c,230,0);let left=load64(values+i*8);let right=load64(values+j*8);xt_setreg(c,src,left);xt_setreg(c,rhs,right);step(c,load64(names+op*8));let expected=left*factor+right;if op>=9{expected=left*factor-right;}check(xt_reg(c,dest)==(expected&0xffffffff),"scaled ADDX/SUBX operand order,wrap and window mapping");j=j+1;}i=i+1;}
 // All three operand groups must be checked before a register is modified.
 xt_wsr(c,73,bit(wb)|bit(wb+group));xt_wsr(c,230,0x40000);let old=xt_reg(c,dest);let retired=load64(c+176);let pc=pc_of(load64(names+op*8));step(c,load64(names+op*8));check(xt_sr(c,72)==((wb+group)&15) && xt_sr(c,177)==pc && load64(c+176)==retired,"scaled arithmetic spills for destination and both source groups");step(c,"rfwo");check(xt_reg(c,dest)==old,"window fault does not partially execute scaled arithmetic");xt_wsr(c,230,0);op=op+1;}xt_close(c);wb=wb+1;}return 0;}
fn loops(){let names=alloc(24);store64(names,"loop");store64(names+8,"loopnez");store64(names+16,"loopgtz");let values=alloc(40);store64(values,0);store64(values+8,1);store64(values+16,7);store64(values+24,0x80000000);store64(values+32,0xffffffff);let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let op=0;while op<3{let i=0;while i<5{wcase=2700+wb*15+op*5+i;let count=load64(values+i*8);let name=load64(names+op*8);let pc=pc_of(name);xt_setreg(c,8,count);step(c,name);let next=pc+3;if (op==1 && !count) || (op==2 && (count==0 || count>=0x80000000)){next=pc+32;}check(load64(c+128)==next && xt_sr(c,0)==pc+3 && xt_sr(c,1)==pc+32 && xt_sr(c,2)==((count-1)&0xffffffff),"LOOP/NEZ/GTZ setup,zero/signed predicates and count underflow");i=i+1;}op=op+1;}
 let pc=pc_of("nopn");xt_wsr(c,0,0x1400);xt_wsr(c,1,pc+2);xt_wsr(c,2,2);step(c,"nopn");check(load64(c+128)==0x1400 && xt_sr(c,2)==1,"density instruction reaches loop end");step(c,"nopn");check(load64(c+128)==0x1400 && xt_sr(c,2)==0,"last repetition consumes final LCOUNT");step(c,"nopn");check(load64(c+128)==pc+2 && xt_sr(c,2)==0,"zero count exits without underflow");xt_wsr(c,2,4);xt_wsr(c,230,16);step(c,"nopn");check(load64(c+128)==pc+2 && xt_sr(c,2)==4,"exception handler disables hardware-loop boundary");xt_wsr(c,230,0);
 // Taken transfers suppress loopback; untaken branches count sequentially.
 pc=pc_of("beqzn");xt_wsr(c,1,pc+2);xt_wsr(c,2,4);xt_setreg(c,6,0);step(c,"beqzn");check(load64(c+128)==pc+32 && xt_sr(c,2)==4,"taken branch bypasses loop boundary");xt_setreg(c,6,1);step(c,"beqzn");check(load64(c+128)==0x1400 && xt_sr(c,2)==3,"untaken branch executes loop boundary");pc=pc_of("retn");xt_wsr(c,1,pc+2);xt_wsr(c,2,4);xt_setreg(c,0,pc+2);step(c,"retn");check(load64(c+128)==pc+2 && xt_sr(c,2)==4,"taken return to sequential address still suppresses looping");
 // A memory access loops once at retirement, including an MMIO read resumed
 // in a later slice. Merely issuing the read must not consume LCOUNT.
 pc=pc_of("l32in");xt_wsr(c,1,pc+2);xt_wsr(c,2,4);xt_setreg(c,5,0x2000);xt_write(c,0x203c,4,0xdeadbeef);step(c,"l32in");check(load64(c+128)==0x1400 && xt_sr(c,2)==3 && xt_reg(c,4)==0xdeadbeef,"mapped memory loops on retirement");let run=alloc(4096);em_zero(run,4096);store64(c+224,run);xt_setreg(c,5,0x3ff40000);at(c,"l32in");let retired=load64(c+176);check(xt_step(c)==6 && load64(c+176)==retired && xt_sr(c,2)==3,"pending MMIO read does not loop before completion");em_put32(run+40,0x89abcdef);check(xt_run_slice(c,run,retired+20,retired+1)==10,"deferred read resumes for exactly one retirement");check(load64(c+128)==0x1400 && xt_sr(c,2)==2 && xt_reg(c,4)==0x89abcdef,"MMIO completion loops once and commits its value");syscall(11,run,4096,0,0,0,0);xt_close(c);wb=wb+1;}return 0;}
fn interrupt_loop(){wcase=3000;let c=fresh();let pc=pc_of("nopn");xt_wsr(c,231,pc-0x300);xt_wsr(c,0,0x1400);xt_wsr(c,1,pc+2);xt_wsr(c,2,4);xt_wsr(c,228,2);xt_interrupt(c,2);store64(c+128,0x1400);check(xt_step(c)==0,"IRQ enters first handler instruction");check((xt_sr(c,230)&16) && xt_sr(c,177)==0x1400 && load64(c+248)==1,"IRQ establishes exception state");check(load64(c+128)==pc+2 && xt_sr(c,2)==4,"first IRQ instruction cannot consume interrupted hardware loop");xt_close(c);return 0;}
fn rom_branches(){let opnames=alloc(48);store64(opnames,"beqi");store64(opnames+8,"bnei");store64(opnames+16,"blti");store64(opnames+24,"bgei");store64(opnames+32,"bltui");store64(opnames+40,"bgeui");let constants=alloc(128);store64(constants+0,-1);store64(constants+8,1);store64(constants+16,2);store64(constants+24,3);store64(constants+32,4);store64(constants+40,5);store64(constants+48,6);store64(constants+56,7);store64(constants+64,8);store64(constants+72,10);store64(constants+80,12);store64(constants+88,16);store64(constants+96,32);store64(constants+104,64);store64(constants+112,128);store64(constants+120,256);let vals=alloc(64);store64(vals,0);store64(vals+8,1);store64(vals+16,0x7fffffff);store64(vals+24,0x80000000);store64(vals+32,0xffffffff);store64(vals+40,0x12345678);store64(vals+48,0x8000);store64(vals+56,0x10000);let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let op=0;while op<6{let k=0;while k<16{let constant=load64(constants+k*8)&0xffffffff;if op>=4 && k<2{constant=32768*(k+1);}let name=h_cat(load64(opnames+op*8),h_int(k));let i=0;while i<11{wcase=3100+wb*96+op*16+k;let value=0;if i<8{value=load64(vals+i*8);}else{value=(constant+i-9)&0xffffffff;}xt_setreg(c,8,value);step(c,name);let take=value==constant;if op==1{take=value!=constant;}if op==2{take=(value^0x80000000)<(constant^0x80000000);}if op==3{take=(value^0x80000000)>=(constant^0x80000000);}if op==4{take=value<constant;}if op==5{take=value>=constant;}let target=pc_of(name)+3;if take{target=pc_of(name)+32;}check(load64(c+128)==target,"GNU immediate branch constants,signed/unsigned predicates and word boundaries");i=i+1;}
 xt_wsr(c,73,bit(wb)|bit(wb+3));xt_wsr(c,230,0x40000);step(c,name);check(xt_sr(c,72)==wb && !(xt_sr(c,230)&16),"immediate constant is not a window operand");xt_wsr(c,73,bit(wb)|bit(wb+2));let retired=load64(c+176);step(c,name);check(xt_sr(c,72)==((wb+2)&15) && load64(c+176)==retired,"immediate branch source triggers window spill");step(c,"rfwo");xt_wsr(c,230,0);k=k+1;}op=op+1;}
 let names=alloc(48);store64(names,"bnone");store64(names+8,"bany");store64(names+16,"ball");store64(names+24,"bnall");store64(names+32,"bbc");store64(names+40,"bbs");let i=0;while i<8{let j=0;while j<8{let value=load64(vals+i*8);let mask=load64(vals+j*8);let any=0;let missing=0;let bitindex=0;while bitindex<32{let want=(mask>>bitindex)&1;let have=(value>>bitindex)&1;if want && have{any=1;}if want && !have{missing=1;}bitindex=bitindex+1;}op=0;while op<6{wcase=5000+wb*6+op;xt_setreg(c,8,value);xt_setreg(c,11,mask);let name=load64(names+op*8);step(c,name);let take=!any;if op==1{take=any;}if op==2{take=!missing;}if op==3{take=missing;}if op==4{take= !((value>>(mask%32))&1);}if op==5{take=(value>>(mask%32))&1;}let target=pc_of(name)+3;if take{target=pc_of(name)+32;}check(load64(c+128)==target,"GNU mask/bit-register branches include empty masks and low5-bit indexes");op=op+1;}j=j+1;}i=i+1;}
 let bitindex=0;while bitindex<32{i=0;while i<8{let value=load64(vals+i*8);xt_setreg(c,3,value);op=0;while op<2{wcase=5200+wb*64+bitindex*2+op;let stem="bbci";if op{stem="bbsi";}let name=h_cat(stem,h_int(bitindex));xt_wsr(c,73,bit(wb)|bit(wb+1));xt_wsr(c,230,0x40000);step(c,name);let take= !((value>>bitindex)&1);if op{take=!take;}let target=pc_of(name)+3;if take{target=pc_of(name)+32;}check(load64(c+128)==target && xt_sr(c,72)==wb && !(xt_sr(c,230)&16),"all32 immediate bit indexes are not register operands");xt_wsr(c,230,0);op=op+1;}i=i+1;}bitindex=bitindex+1;}
 let znames=alloc(32);store64(znames,"beqz");store64(znames+8,"bnez");store64(znames+16,"bltz");store64(znames+24,"bgez");i=0;while i<8{op=0;while op<4{wcase=6300+wb*4+op;let value=load64(vals+i*8);xt_setreg(c,8,value);let name=load64(znames+op*8);step(c,name);let take=value==0;if op==1{take=value!=0;}if op==2{take=value>=0x80000000;}if op==3{take=value<0x80000000;}let target=pc_of(name)+3;if take{target=pc_of(name)+128;}check(load64(c+128)==target,"24-bit zero/signed-zero branch predicate and12-bit displacement");op=op+1;}i=i+1;}
 let loopnames=alloc(32);store64(loopnames,"beqi1");store64(loopnames+8,"beqz");store64(loopnames+16,"bany");store64(loopnames+24,"bbsi17");op=0;while op<4{let name=load64(loopnames+op*8);let pc=pc_of(name);let take=0;while take<2{wcase=6500+wb*8+op*2+take;xt_wsr(c,0,0x1400);xt_wsr(c,1,pc+3);xt_wsr(c,2,4);xt_setreg(c,8,take);xt_setreg(c,11,1);xt_setreg(c,3,take*131072);if op==1{xt_setreg(c,8,!take);}step(c,name);let target=0x1400;let count=3;if take{target=pc+32;if op==1{target=pc+128;}count=4;}check(load64(c+128)==target && xt_sr(c,2)==count,"new branch families loop only on sequential completion");take=take+1;}op=op+1;}xt_wsr(c,2,0);
 xt_setreg(c,8,1);step(c,"beqineg");check(load64(c+128)==pc_of("beqineg")-124,"8-bit displacement lower bound");step(c,"beqipos");check(load64(c+128)==pc_of("beqipos")+131,"8-bit displacement upper bound");xt_setreg(c,8,0);step(c,"beqzneg");check(load64(c+128)==pc_of("beqzneg")-2044,"12-bit displacement lower bound");step(c,"beqzpos");check(load64(c+128)==pc_of("beqzpos")+2051,"12-bit displacement upper bound");xt_close(c);wb=wb+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==3,"GNU raw instruction and metadata arguments");wcode=h_read(load64(argv+8));wsize=h_file_size;wm=h_read(load64(argv+16));check(load64(wm)==0x575354574f500001 && em_u32(wm+12)==1 && h_file_size==16+em_u32(wm+8)*40 && wsize<4096,"independent GNU metadata shape");mapping();calls();entries();returns();spill_fill();exceptions();special();compact();scaled();loops();interrupt_loop();rom_branches();h_print(1,h_cat3("Xtensa windows: ",h_int(wc)," checks passed\n"));return 0;}
