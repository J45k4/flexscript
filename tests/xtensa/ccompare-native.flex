// Stop the actual guest at a GNU checkpoint after all raw records are in RAM.
// This avoids UART busy-wait execution in this native-only timing observer.
import "../../emulator/esp32/board.flex";
import "../../emulator/esp32/rom.flex";
import "../../scripts/lib/esp32-elf.flex";
fn main(argc,argv){h_environment(argc,argv);if argc!=5 && argc!=6 && argc!=7{return 99;}let words=16;if argc==7{words=h_number(load64(argv+48));h_assert(words==16,"raw comparator record words");}let image=h_read(load64(argv+8));let elf=ee_open(image,h_file_size);let profile=ee_profile(elf);h_assert(!ee_u32(profile+4),"original ESP32 only");let ready=h_number(load64(argv+24));let c=xt_create();h_assert(xt_map(c,ee_u32(profile+8),131072,5)>0,"IRAM mapping");h_assert(xt_map(c,ee_u32(profile+12),196608,3)>0,"DRAM mapping");let rom=load64(argv+16);h_assert(h_equal(h_sha(rom),"9115bbcd03da9f54d3baca5ad94d588a43da54ed332347137ba3dc9010df258b"),"ECO3 ROM hash");let bytes=h_read(rom);h_assert(er_rom_v3_map(c,bytes,h_file_size)==0,"ROM mapping");xt_wsr(c,235,0xcdcd);h_assert(er_rom_v3_data(c)>=0,"ROM data initialization");let s=se_create(c,0);h_assert(xt_load_elf(c,image,load64(elf+8))==0,"linked image");h_assert(se_clock_profile(s,1)==0,"download40 clock");if argc>=6{h_assert(xt_cycle_profile(c,h_number(load64(argv+40)))==0,"explicit timing profile");}let run=alloc(4096);em_zero(run,4096);while load64(c+128)!=ready && load64(c+176)<15000000{let reason=se_run_slice(s,run,15000000,load64(c+176)+1);if reason<0{let u=se_uart(s,0);h_save_bytes(h_cat(load64(argv+32),".failure.uart"),s+16384,load64(u+8),420);h_write(2,s+16384,load64(u+8));h_print(2,h_cat3("Native comparator observer error ",h_int(load64(c+160)),h_cat3(" PC ",h_int(load64(c+168)),"\n")));return 1;}if reason==5 || reason==11{return 2;}if load64(c+216)==0xffff06{let u=se_uart(s,0);h_save_bytes(h_cat(load64(argv+32),".failure.uart"),s+16384,load64(u+8),420);h_write(2,s+16384,load64(u+8));h_print(2,"Guest reached a self-loop before the GNU RAM checkpoint\n");return 3;}}h_assert(load64(c+128)==ready,"did not reach GNU RAM checkpoint");h_assert(xt_reg(c,3)==24,"wrong captured row count");let data=xt_pointer(c,xt_reg(c,2),1,1);let tail=xt_pointer(c,xt_reg(c,2)+24*words*4-1,1,1);h_assert(data>0 && tail==data+24*words*4-1,"contiguous raw record mapping");h_save_bytes(load64(argv+32),data,24*words*4,420);let u=se_uart(s,0);h_save_bytes(h_cat(load64(argv+32),".header.uart"),s+16384,load64(u+8),420);h_print(1,h_cat3("GNU RAM checkpoint: rows=24 instructions=",h_int(load64(c+176)),h_cat3(" ticks=",h_int(load64(s+16)),"\n")));se_close(s);xt_close(c);return 0;}
