import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global ref=0;
global checks=0;
global context=0;
fn r(i){return load64(ref+32+i*8);}
fn ck(ok,text){if !ok{h_print(2,h_cat3("I2C case ",h_int(context),h_cat3(" check ",h_int(checks),h_cat3(": ",text,"\n"))));syscall(60,1,0,0,0,0,0);}checks=checks+1;return 0;}
fn wr(s,a,v){let result=se_bus(s,a,4,1,v);if result<0{h_print(2,h_cat3("MMIO ",h_int(a),h_cat3(" error ",h_int(result),"\n")));}ck(result>=0,"defined register write");return 0;}
fn rd(s,a){let result=se_bus(s,a,4,0,0);ck(result>=0,"defined register read");return result;}
fn tick(s,n){ck(se_advance(s,n)==0,"advance wire time");return 0;}
fn drive(s,pin,value){ck(se_gpio_drive(s,pin,value)==0,"independent open-drain wire drive");return 0;}
fn rx(s,base){xt_wsr(load64(s),230,15);rd(s,r(68));return rd(s,base+r(13));}
fn setup(cpu,f,slave){let s=se_create(cpu,0);let bus=load64(f);let base=r(bus);wr(s,r(4),4|r(6+bus));wr(s,r(5),r(6+bus));wr(s,r(5),0);wr(s,r(46),r(49));wr(s,r(47),r(49));wr(s,r(48),r(49));wr(s,r(51)+21*4,4);wr(s,r(51)+22*4,4);wr(s,r(45)+21*4,r(55+bus*2));wr(s,r(45)+22*4,r(54+bus*2));wr(s,r(44)+r(55+bus*2)*4,128|21);wr(s,r(44)+r(54+bus*2)*4,128|22);ck(se_gpio_wire(s,21,19)==0,"external SDA peer wire");
 wr(s,base+r(58),load64(f+48));wr(s,base+r(59),load64(f+56));wr(s,base+r(60),load64(f+64));wr(s,base+r(61),load64(f+72));wr(s,base+r(62),load64(f+80));wr(s,base+r(63),load64(f+88));wr(s,base+r(65),load64(f+96));wr(s,base+r(64),load64(f+104));wr(s,base+r(10),load64(f+32)*20);wr(s,base+r(66),0);wr(s,base+r(67),0);wr(s,base+r(12),r(23)|r(24));wr(s,base+r(12),0);wr(s,base+r(16),0);wr(s,base+r(15),8191);wr(s,base+r(11),load64(f+8));let ctrl=load64(f+40);if slave{ctrl=ctrl&~r(20);}wr(s,base+r(8),ctrl);wr(s,r(43)+r(41+bus)*4,1);return s;}
fn commands(s,f){let base=r(load64(f));let i=0;while i<16{wr(s,base+r(18)+i*4,em_u32(f+128+i*4));i=i+1;}return 0;}
fn master_external(cpu,f){let s=setup(cpu,f,0);let bus=load64(f);let base=r(bus);commands(s,f);let wire=f+256;let bytes=load64(f+120);let i=0;while i<bytes{if !load8(wire+i*3){wr(s,r(2+bus),load8(wire+i*3+1));}i=i+1;}
 let index=0;let bit=0;let pending=0;let sampled=0;let oldclock=se_gpio_level(s,22);let olddata=se_gpio_level(s,21);let starts=0;let stops=0;let edges=0;let steps=0;let rise=0;let fall=0;let half=load64(f+32);wr(s,base+r(8),load64(f+40)|r(72));
 while !(rd(s,base+r(14))&(r(35)|r(32)|r(33)|r(34))) && steps<4096{let wait=se_deadline(s);ck(wait>=0,"pending wire deadline");tick(s,wait);let clock=se_gpio_level(s,22);let data=se_gpio_level(s,21);let now=load64(s+16);
  if oldclock && clock && data!=olddata{pending=0;if !data{starts=starts+1;bit=0;}else{stops=stops+1;}}
  if !oldclock && clock{pending=1;sampled=data;rise=now;if fall{ck(now-fall==half,"C-derived SCL low period");}}
  if oldclock && !clock{fall=now;if pending{ck(index<bytes,"no extra data clocks");let value=load8(wire+index*3+1);let wanted=load8(wire+index*3+2);if bit<8{wanted=(value>>(7-bit))&1;}ck(sampled==wanted,"external peer decodes logical data/ACK bits");ck(now-rise==half,"C-derived SCL high period");edges=edges+2;bit=bit+1;pending=0;
    if bit==8{let level= -1;if !load8(wire+index*3){level=0;}drive(s,19,level);}else if bit==9{index=index+1;bit=0;let level= -1;if index<bytes && load8(wire+index*3){if !(load8(wire+index*3+1)&128){level=0;}}drive(s,19,level);}else if load8(wire+index*3){let level= -1;if !((value>>(7-bit))&1){level=0;}drive(s,19,level);}
   }}oldclock=se_gpio_level(s,22);olddata=se_gpio_level(s,21);steps=steps+1;
 }
 ck(steps<4096 && index==bytes && edges==bytes*18,"complete external wire transaction");ck(starts==1+(load64(f+16)!=0 && load64(f+24)!=0) && stops==1,"START/repeated START/STOP count");ck(!(rd(s,base+r(14))&(r(32)|r(33)|r(34))),"no wire errors");ck(rd(s,base+r(14))&r(35),"STOP completion");ck(!(rd(s,base+r(9))&r(29)),"bus idle after STOP");ck(((rd(s,base+r(9))>>r(26))&r(25))==load64(f+24),"master RX count");ck(((rd(s,base+r(9))>>r(28))&r(27))==0,"all TX bytes consumed");i=0;while i<16{let done=rd(s,base+r(18)+i*4)&r(19);ck(!!done==(i<=load64(f+112)),"only executed commands marked DONE");i=i+1;}i=0;while i<load64(f+24){ck(rx(s,base)==load8(f+224+i),"independent incoming bytes reach master FIFO");i=i+1;}
 ck(!(xt_sr(cpu,226)&2),"completion masked before enable");wr(s,base+r(16),r(35));ck(xt_sr(cpu,226)&2,"I2C source routes CPU interrupt");wr(s,base+r(15),r(35));ck(!(xt_sr(cpu,226)&2),"W1TC deasserts masked IRQ");se_close(s);return 0;}
fn scl(s,high){let value=0;if high{value= -1;}drive(s,22,value);tick(s,200);ck(se_gpio_level(s,22)==high,"external master controls SCL");return 0;}
fn sda(s,high){let value=0;if high{value= -1;}return drive(s,19,value);}
fn start(s){sda(s,1);scl(s,1);sda(s,0);tick(s,200);scl(s,0);return 0;}
fn stop(s){sda(s,0);scl(s,1);sda(s,1);tick(s,200);return 0;}
fn send(s,byte,nack){let i=0;while i<8{sda(s,(byte>>(7-i))&1);scl(s,1);scl(s,0);i=i+1;}sda(s,1);scl(s,1);ck(se_gpio_level(s,21)==nack,"external master samples slave ACK");scl(s,0);return 0;}
fn receive(s,byte,nack){sda(s,1);let actual=0;let i=0;while i<8{scl(s,1);actual=(actual<<1)|se_gpio_level(s,21);scl(s,0);i=i+1;}ck(actual==byte,"external master receives slave TX bytes");sda(s,nack);scl(s,1);scl(s,0);sda(s,1);return 0;}
fn slave_external(cpu,f){let s=setup(cpu,f,1);let bus=load64(f);let base=r(bus);let tx=load64(f+16);let rn=load64(f+24);let i=0;while i<rn{wr(s,r(2+bus),load8(f+224+i));i=i+1;}start(s);send(s,(load64(f+8)<<1)|(!tx && rn),0);i=0;while i<tx{send(s,load8(f+192+i),0);i=i+1;}if tx && rn{start(s);send(s,(load64(f+8)<<1)|1,0);}i=0;while i<rn{receive(s,load8(f+224+i),i==rn-1);i=i+1;}stop(s);ck(((rd(s,base+r(9))>>r(26))&r(25))==tx,"slave excludes address bytes from RX FIFO");ck(((rd(s,base+r(9))>>r(28))&r(27))==0,"slave consumes only transmitted TX bytes");ck(rd(s,base+r(14))&r(35),"slave STOP completion");i=0;while i<tx{ck(rx(s,base)==load8(f+192+i),"external master data reaches slave RX FIFO");i=i+1;}se_close(s);return 0;}
fn open_commands(s,bus,read){let base=r(bus);let i=0;while i<16{wr(s,base+r(18)+i*4,r(77));i=i+1;}wr(s,base+r(18),r(79));wr(s,base+r(18)+4,r(82));let at=2;if read{wr(s,base+r(18)+8,r(83));at=3;}wr(s,base+r(18)+at*4,r(78));wr(s,r(2+bus),0xa5);return 0;}
fn finish(s,bus){let steps=0;while !(rd(s,r(bus)+r(14))&(r(35)|r(33)|r(34))) && steps<256{let wait=se_deadline(s);ck(wait>=0,"open bus deadline");tick(s,wait);steps=steps+1;}ck(steps<256 && (rd(s,r(bus)+r(14))&r(35)),"open-bus transfer completes");return 0;}
fn boundaries(cpu,f){let bus=load64(f);let base=r(bus);let s=setup(cpu,f,0);let i=0;while i<32{wr(s,r(2+bus),i);i=i+1;}ck(((rd(s,base+r(9))>>r(28))&r(27))==32,"TX FIFO capacity32");ck(se_bus(s,r(2+bus),4,1,33)== -28,"TX overflow bounded");ck(se_bus(s,base+r(13),4,1,0)== -95,"DPORT TX path unsupported");wr(s,base+r(12),r(23)|r(24));wr(s,base+r(12),0);open_commands(s,bus,1);wr(s,base+r(8),load64(f+40)|r(72));finish(s,bus);wr(s,base+r(12),r(23));wr(s,base+r(12),0);ck(!((rd(s,base+r(9))>>r(26))&r(25)),"RX FIFO reset discards queued bytes");open_commands(s,bus,1);wr(s,base+r(15),8191);wr(s,base+r(8),load64(f+40)|r(72));finish(s,bus);xt_wsr(cpu,230,15);ck(se_bus(s,base+r(13),4,0,0)== -95,"RX requires immediately preceding APB synchronization");rd(s,r(68));rd(s,base+r(9));ck(se_bus(s,base+r(13),4,0,0)== -95,"intervening MMIO invalidates APB synchronization");xt_wsr(cpu,230,0);rd(s,r(68));ck(se_bus(s,base+r(13),4,0,0)== -95,"RX requires masked interrupts");ck(rx(s,base)==255,"open bus reads pulled-up data");ck(se_bus(s,r(2+bus),4,0,0)== -95,"APB RX path explicitly unsupported");ck(se_bus(s,base+r(11),4,1,r(75))== -95,"10-bit mode explicitly unsupported");ck(se_bus(s,base+r(12),4,1,r(73))== -95,"non-FIFO mode explicitly unsupported");ck(se_bus(s,base+r(12),4,1,r(74))== -95,"address-memory mode explicitly unsupported");ck(se_bus(s,base+r(8),4,1,load64(f+40)|r(76))== -95,"low-level sampling explicitly unsupported");se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(10),20);let began=load64(s+16);wr(s,base+r(8),load64(f+40)|r(72));tick(s,1);ck(!(rd(s,base+r(14))&r(33)),"no immediate timeout");ck(se_deadline(s)==19,"timeout precedes next START wire event");tick(s,18);ck(!(rd(s,base+r(14))&r(33)),"timeout not early");tick(s,1);ck((rd(s,base+r(14))&r(33)) && load64(s+16)-began==20,"timeout delivered at exact deadline");ck(!(rd(s,base+r(8))&r(72)),"timeout aborts TRANS_START");se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(10),1000);drive(s,22,0);wr(s,base+r(8),load64(f+40)|r(72));tick(s,1);wr(s,r(4),4);tick(s,10000);wr(s,r(4),4|r(6+bus));ck(!(rd(s,base+r(14))&r(33)),"clock gate freezes timeout");tick(s,998);ck(!(rd(s,base+r(14))&r(33)),"remaining stretched-clock timeout preserved");tick(s,1);ck(rd(s,base+r(14))&r(33),"stretched clock times out after ungating");drive(s,22,-1);se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,1);wr(s,base+r(10),1000);drive(s,22,0);wr(s,base+r(8),load64(f+40)|r(72));tick(s,400);ck(!(rd(s,base+r(14))&r(39)),"no START while SCL held low");drive(s,22,-1);finish(s,bus);ck(rx(s,base)==255,"clock-stretch release resumes real wire reads");se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(8),load64(f+40)|r(72));let step=0;while se_gpio_level(s,22) && step<16{tick(s,se_deadline(s));step=step+1;}ck(step<16,"START reached first low phase");drive(s,19,0);step=0;while !(rd(s,base+r(14))&r(34)) && step<16{tick(s,se_deadline(s));step=step+1;}ck(step<16 && (rd(s,base+r(9))&r(30)),"arbitration loss samples actual external SDA");ck(!(rd(s,base+r(14))&r(32)),"arbitration loss is distinct from ACK error");drive(s,19,-1);se_close(s);
 s=setup(cpu,f,1);start(s);send(s,load64(f+8)<<1,0);i=0;while i<33{send(s,(i*37)&255,i==32);i=i+1;}stop(s);ck(rd(s,base+r(14))&r(40),"slave RX overflow IRQ");ck(((rd(s,base+r(9))>>r(26))&r(25))==32,"overflow preserves bounded RX FIFO");i=0;while i<32{ck(rx(s,base)==((i*37)&255),"RX overflow preserves old bytes");i=i+1;}se_close(s);return 0;}
fn sample_delay(cpu,f){let bus=load64(f);let base=r(bus);let variant=0;while variant<2{let s=setup(cpu,f,0);open_commands(s,bus,1);if !variant{wr(s,base+r(61),0);}wr(s,base+r(8),load64(f+40)|r(72));let rises=0;let before=se_gpio_level(s,22);let injected=0;let released=0;let steps=0;while !(rd(s,base+r(14))&(r(35)|r(33))) && steps<256{tick(s,se_deadline(s));let clock=se_gpio_level(s,22);if !before && clock{rises=rises+1;if rises==10{drive(s,19,0);injected=1;}}if before && !clock && injected && !released{drive(s,19,-1);released=1;}before=clock;steps=steps+1;}ck(steps<256 && injected && released,"independent high-phase input transient");let want=255;if variant{want=127;}ck(rx(s,base)==want,"configured master sample delay selects input at sampling time");se_close(s);variant=variant+1;}return 0;}
fn extra_boundaries(cpu,f){let bus=load64(f);let base=r(bus);let rejected=setup(cpu,f,1);start(rejected);send(rejected,((load64(f+8)+1)<<1),1);stop(rejected);ck(!((rd(rejected,base+r(9))>>r(26))&r(25)),"wrong slave address stores no data");se_close(rejected);let s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(18)+4,r(85));wr(s,base+r(8),load64(f+40)|r(72));let steps=0;while !(rd(s,base+r(14))&r(32)) && steps<128{tick(s,se_deadline(s));steps=steps+1;}ck(steps<128 && (rd(s,base+r(9))&1),"external NACK matches ACK error status");ck(!(rd(s,base+r(18)+4)&r(19)),"failed WRITE command is not DONE");se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(18)+4,r(86));wr(s,base+r(8),load64(f+40)|r(72));finish(s,bus);ck(!(rd(s,base+r(14))&r(32)),"ACK_EXP one accepts external NACK");se_close(s);
 s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(18)+8,r(77));wr(s,base+r(8),load64(f+40)|r(72));steps=0;while !(rd(s,base+r(14))&r(36)) && steps<128{tick(s,se_deadline(s));steps=steps+1;}ck(steps<128 && se_gpio_level(s,22)==0 && (rd(s,base+r(9))&r(29)),"END reserves bus with SCL low");ck(!(rd(s,base+r(14))&r(35)),"END differs from STOP");wr(s,base+r(15),8191);wr(s,base+r(18),r(82));wr(s,base+r(18)+4,r(78));wr(s,r(2+bus),0xa5);wr(s,base+r(8),load64(f+40)|r(72));ck(se_gpio_level(s,22)==0,"segment restart does not release reserved SCL");finish(s,bus);ck(!(rd(s,base+r(9))&r(29)),"continuation STOP releases bus");se_close(s);
 s=setup(cpu,f,1);start(s);send(s,(load64(f+8)<<1)|1,0);drive(s,22,-1);tick(s,200);ck(se_gpio_level(s,22)==0,"empty slave TX FIFO stretches SCL");wr(s,r(2+bus),0x96);ck(se_gpio_level(s,22)==1 && se_gpio_level(s,21)==1,"refill publishes first bit before releasing SCL");scl(s,0);let value=1;let bit=1;while bit<8{scl(s,1);value=(value<<1)|se_gpio_level(s,21);scl(s,0);bit=bit+1;}ck(value==0x96,"stretched transfer resumes the queued byte");sda(s,1);scl(s,1);scl(s,0);stop(s);ck(rd(s,base+r(14))&r(35),"STOP after stretched slave transfer");se_close(s);return 0;}
fn reset_active(cpu,f){let bus=load64(f);let base=r(bus);let s=setup(cpu,f,0);open_commands(s,bus,0);wr(s,base+r(16),r(39));wr(s,base+r(8),load64(f+40)|r(72));tick(s,load64(f+88)+1);ck((rd(s,base+r(14))&r(39)) && (xt_sr(cpu,226)&2),"START source pending before reset");wr(s,r(5),r(6+bus));wr(s,r(5),0);ck(rd(s,base+r(8))==r(22),"module reset aborts active command");ck(!((rd(s,base+r(9))>>r(28))&r(27)) && !((rd(s,base+r(9))>>r(26))&r(25)),"module reset clears both FIFOs");ck(rd(s,base+r(12))==r(69),"C-derived FIFO reset configuration");ck(!(xt_sr(cpu,226)&2) && rd(s,base+r(16))==0 && !(rd(s,base+r(14))&r(39)),"module reset clears IRQ ownership and source");ck(se_gpio_level(s,21)==1 && se_gpio_level(s,22)==1,"module reset releases both open-drain lines");se_close(s);return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"reference argument");ref=h_read(load64(argv+8));ck(load64(ref)==0x4932434d4f440001 && load64(ref+8)==87 && load64(ref+16)==50 && load64(ref+24)==448 && h_file_size==32+87*8+50*448,"independent C reference shape");let cpu=xt_create();let f=ref+32+87*8;let i=0;while i<50{context=i;master_external(cpu,f);context=100+i;slave_external(cpu,f);f=f+448;i=i+1;}context=300;boundaries(cpu,ref+32+87*8+2*448);context=301;boundaries(cpu,ref+32+87*8+27*448);context=400;sample_delay(cpu,ref+32+87*8+2*448);context=401;extra_boundaries(cpu,ref+32+87*8+2*448);context=402;extra_boundaries(cpu,ref+32+87*8+27*448);context=403;reset_active(cpu,ref+32+87*8+2*448);context=404;reset_active(cpu,ref+32+87*8+27*448);xt_close(cpu);h_print(1,h_cat3("I2C model: ",h_int(checks)," checks passed\n"));return 0;}
