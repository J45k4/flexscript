// GNU-assembled SRC instructions; expected values computed one bit at a time.
import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global sf_checks=0;global sf_case=0;global sf_code=0;
fn check(ok,message){sf_checks=sf_checks+1;if !ok{h_print(2,h_cat3("SRC case ",h_int(sf_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn fresh(){let c=xt_create();let p=xt_map(c,0x1000,16384,5);check(p>0,"GNU code mapping");em_copy(p,sf_code,12288);xt_wsr(c,231,0x800000);return c;}
fn pattern(i){if i==0{return 0;}if i==1{return 0xffffffff;}if i==2{return 0x80000001;}if i==3{return 0x12345678;}return 0xa5a55a5a;}
fn reference(left,right,shift){let value=0;let bit=0;while bit<32{let source=bit+shift;let on=0;if source<32{on=(right>>source)&1;}else if source<64{on=(left>>(source-32))&1;}if on{value=value+(1<<bit);}bit=bit+1;}return value;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU code argument");sf_code=h_read(load64(argv+8));check(h_file_size==12288,"4096 independent GNU SRC encodings");let c=fresh();let index=0;while index<4096{let d=index/256;let b=(index/16)&15;let a=index&15;let shift=0;while shift<64{let v=0;while v<5{sf_case=index*320+shift*5+v;xt_wsr(c,230,0);xt_wsr(c,3,shift);xt_setreg(c,d,0xdeadbeef);xt_setreg(c,b,pattern(v));xt_setreg(c,a,pattern((v+2)%5));let expected=reference(xt_reg(c,b),xt_reg(c,a),shift);let before=load64(c+176);store64(c+128,0x1000+index*3);check(xt_step(c)==0,"SRC executes");check(xt_reg(c,d)==expected && xt_sr(c,3)==shift,"all SAR values and every register alias match independent bit reference");check(load64(c+176)==before+1 && load64(c+128)==0x1000+index*3+3,"SRC retires exactly once");v=v+1;}shift=shift+1;}index=index+1;}
 xt_close(c);let wb=0;while wb<16{c=fresh();xt_wsr(c,72,wb);index=0;while index<4096{let d=index/256;let b=(index/16)&15;let a=index&15;xt_wsr(c,72,wb);xt_wsr(c,73,(1<<wb)|(1<<((wb+1)&15)));xt_wsr(c,230,0x40000);xt_wsr(c,3,17);xt_setreg(c,b,0x12345678);xt_setreg(c,a,0x87654321);let old=load64(c+176);store64(c+128,0x1000+index*3);check(xt_step(c)==0,"SRC windows execute");let spills=d>=4 || b>=4 || a>=4;if spills{check(xt_sr(c,72)==((wb+1)&15) && load64(c+176)==old && xt_sr(c,177)==0x1000+index*3,"all three SRC operands trigger window overflow before evaluation");}else{check(xt_sr(c,72)==wb && load64(c+176)==old+1,"low operands do not spuriously overflow");}index=index+1;}xt_close(c);wb=wb+1;}
 c=fresh();let shift=0;while shift<64{let exc=0;while exc<2{sf_case=2000000+shift*2+exc;xt_wsr(c,230,exc*16);xt_wsr(c,3,shift);xt_setreg(c,0,0xa5a55a5a);xt_wsr(c,0,0x9000);xt_wsr(c,1,0x1003);xt_wsr(c,2,3);store64(c+128,0x1000);check(xt_step(c)==0 && xt_reg(c,0)==reference(0xa5a55a5a,0xa5a55a5a,shift),"same-source rotate includes bit31");check(load64(c+128)==(exc*0x1003+(!exc)*0x9000) && xt_sr(c,2)==2+exc,"loop retirement respects EXCM");exc=exc+1;}shift=shift+1;}xt_close(c);h_print(1,h_cat3("SRC: ",h_int(sf_checks)," checks passed\n"));return 0;}
