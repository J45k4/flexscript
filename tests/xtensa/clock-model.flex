import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global cr=0;global checks=0;global context=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Clock context ",h_int(context),h_cat3(" check ",h_int(checks),h_cat3(": ",message,"\n"))));syscall(60,1,0,0,0,0,0);}return 0;}
fn ref(i){return load64(cr+16+i*8);}
fn rd(s,address){let n=se_bus(s,address,4,0,0);if n<0{h_print(2,h_cat3("Read address ",h_int(address),h_cat3(" result ",h_int(n),"\n")));}ck(n>=0,"mapped clock/peripheral read");return n;}
fn wr(s,address,value){let result=se_bus(s,address,4,1,value&0xffffffff);if result<0{h_print(2,h_cat3("Write address ",h_int(address),h_cat3(" value ",h_int(value),h_cat3(" result ",h_int(result),"\n"))));}ck(result>=0,"mapped clock/peripheral write");return 0;}
fn tick(s,n){ck(se_advance(s,n)==0,"bounded device advance");return 0;}
fn tx(s,index,value,writing){let at=ref(31)+ref(15)*4;let word=ref(14)|(index<<8)|(value<<16);if writing{word=word|ref(43);}let before=load64(s+16);let p=se_clock(s);let delay=load64(p+48);wr(s,at,word);ck(rd(s,at)&ref(44),"analog request latches BUSY");ck(rd(s,ref(30)+ref(15)*4)==rd(s,at),"DPORT/APB analog aliases observe the same controller");ck(se_bus(s,at,4,1,word)== -16,"busy controller rejects overlapping request");tick(s,delay-1);ck(rd(s,at)&ref(44),"analog result is unavailable before deadline");tick(s,1);ck(!(rd(s,at)&ref(44)) && load64(p+112)==before+delay,"analog completion at configured scheduling deadline");return (rd(s,at)>>16)&255;}
fn configure(s,mode){let p=se_clock(s);store64(p+48,17);let previous_dcur=tx(s,ref(27),0,0);tx(s,ref(32),ref(16),1);tx(s,ref(33),ref(17),1);tx(s,ref(34),ref(18),1);tx(s,ref(35),ref(19),1);tx(s,ref(36),ref(20),1);let modeval=ref(21);let dsmp=ref(22);let div=ref(40);if mode==480{modeval=ref(23);dsmp=ref(24);div=ref(41);}tx(s,ref(28),modeval,1);tx(s,ref(29),dsmp,1);tx(s,ref(25),0,1);tx(s,ref(26),div,1);let expected=0;if previous_dcur==ref(42){expected=mode;}ck(se_clock_pll(s)==expected,"PLL availability follows current tuple,not programming order");tx(s,ref(27),ref(42),1);ck(se_clock_pll(s)==mode,"independent SDK PLL tuple enables nominal clock");ck(tx(s,ref(28),0,0)==modeval,"internal analog register readback");return 0;}
fn profiles(){context=1;let c=xt_create();let s=se_create(c,0);ck(s>0,"board allocation");ck(rd(s,ref(1))==0x08003210 && se_cpu_hz(s)==80000000 && se_apb_hz(s)==80000000 && se_clock_audio(s),"existing PLL profile preserved");ck(se_clock_profile(s,1)==0,"explicit pristine download-clock profile");ck(rd(s,ref(1))==0x3210 && rd(s,ref(0))==0x1c492000 && se_cpu_hz(s)==40000000 && se_apb_hz(s)==40000000 && !se_clock_audio(s),"captured downloader clock selection and absent PLL");let old=rd(s,ref(1));ck(se_bus(s,ref(1),4,1,old|(1<<ref(8)))== -95 && rd(s,ref(1))==old,"cannot select unconfigured PLL");ck(se_bus(s,ref(1),4,1,old|(2<<ref(8)))== -95 && rd(s,ref(1))==old,"unsupported RC clock is explicit and atomic");ck(se_bus(s,ref(1),4,1,old|(3<<ref(8)))== -95 && rd(s,ref(1))==old,"unsupported APLL CPU source is explicit and atomic");ck(se_bus(s,ref(6),4,1,3)== -95 && rd(s,ref(6))==0,"invalid CPU period selection is atomic");ck(se_bus(s,ref(31)+ref(15)*4,4,1,0x65|ref(43))== -95,"unsupported analog block rejected");ck(se_bus(s,ref(31)+ref(15)*4,4,1,ref(14)|(13<<8))== -95,"unsupported analog register rejected");wr(s,ref(0),rd(s,ref(0))|ref(13));ck(se_bus(s,ref(31)+ref(15)*4,4,1,ref(14))== -5,"powered-down analog controller rejects requests");wr(s,ref(0),rd(s,ref(0))&~ref(13));configure(s,320);wr(s,ref(1),old|(1<<ref(8)));ck(se_cpu_hz(s)==80000000 && se_apb_hz(s)==80000000 && se_clock_audio(s),"configured320MHz PLL supplies80MHz CPU/APB and160MHz audio");wr(s,ref(6),1);ck(se_cpu_hz(s)==160000000 && se_apb_hz(s)==80000000,"CPU-only160MHz keeps APB80MHz");let options=rd(s,ref(0));ck(se_bus(s,ref(0),4,1,options|ref(13))== -95 && rd(s,ref(0))==options,"cannot power down the selected PLL");ck(se_clock_profile(s,1)== -22,"runtime clock profile cannot reset live time");
 // Interleaving must complete an analog event at its own deadline even if
 // the caller advances past it in one large step.
 wr(s,ref(1),old);let p=se_clock(s);let at=ref(31)+ref(15)*4;let start=load64(s+16);wr(s,at,ref(14)|(ref(28)<<8));tick(s,100);ck(load64(p+112)==start+17 && !(rd(s,at)&ref(44)),"large advances preserve analog deadline");
 se_close(s);xt_close(c);context=2;c=xt_create();s=se_create(c,9);ck(se_clock_profile(s,1)== -22 && se_cpu_hz(s)==80000000 && se_apb_hz(s)==80000000,"S3 profile remains separate");se_close(s);xt_close(c);return 0;}
fn vectors(){let c=xt_create();let s=se_create(c,0);wr(s,ref(1),0x3210);let head=cr+16+45*8;ck(load64(head)==1027,"independent C vector count");let i=0;while i<1027{context=100+i;let p=head+8+i*40;let mode=load64(p);let divisor=load64(p+8);let period=load64(p+16);if !mode{wr(s,ref(5),divisor-1);}else{wr(s,ref(1),0x3210);if mode==480{configure(s,480);}wr(s,ref(6),period);wr(s,ref(1),0x08003210);}ck(se_cpu_hz(s)==load64(p+24) && se_apb_hz(s)==load64(p+32),"all1024 XTAL dividers and3 SDK PLL CPU frequencies");i=i+1;}se_close(s);xt_close(c);return 0;}
fn retire(c,s,n){store64(c+176,load64(c+176)+n);ck(se_sync(s)==0,"retirement converts CPU cycles to reference time");return 0;}
fn cycles(){let mode=0;while mode<4{context=1200+mode;let c=xt_create();let s=se_create(c,0);let qpc=6;if mode==0{wr(s,ref(1),0x3210);qpc=12;}if mode==2{wr(s,ref(6),1);qpc=3;}if mode==3{wr(s,ref(1),0x3210);configure(s,480);wr(s,ref(6),2);wr(s,ref(1),0x08003210);qpc=2;}let start=load64(s+16);let n=1;while n<=101{retire(c,s,1);ck(load64(s+16)==start+n*qpc/6 && load64(se_clock(s)+24)==(n*qpc)%6,"fractional CPU periods preserve phase across slices");let wait=1;while wait<=13{let expected=(wait*6-load64(se_clock(s)+24)+qpc-1)/qpc;if expected<1{expected=1;}ck(se_clock_instruction_limit(s,wait)==expected,"device deadline converts to bounded instruction slice");wait=wait+1;}n=n+1;}let before=load64(s+16);let phase=load64(se_clock(s)+24);let cc=xt_sr(c,234);ck(se_clock_idle(s,0)==0 && load64(s+16)==before && load64(se_clock(s)+24)==phase && xt_sr(c,234)==cc,"zero idle does not lose fractional CPU phase");let units=6-phase;ck(se_clock_idle(s,1)==0 && xt_sr(c,234)==((cc+units/qpc)&0xffffffff) && load64(se_clock(s)+32)==units%qpc && !load64(se_clock(s)+24),"WAITI counts only cycles remaining to device event");let rem=units%qpc;before=load64(s+16);retire(c,s,1);ck(load64(s+16)==before+(qpc-rem)/6 && load64(se_clock(s)+24)==(qpc-rem)%6 && !load64(se_clock(s)+32),"resume consumes partial idle CPU cycle once");let cc2=xt_sr(c,234);let units2=13*6-load64(se_clock(s)+24);ck(se_clock_idle(s,13)==0 && xt_sr(c,234)==((cc2+units2/qpc)&0xffffffff),"WAITI converts a longer interval using current CPU frequency");se_close(s);xt_close(c);mode=mode+1;}return 0;}
fn pin(s,pin,signal,open){wr(s,0x3ff49000+se_gpio_mux_offset(s,pin),(2<<12)|512|256);wr(s,0x3ff44088+pin*4,open*4);wr(s,0x3ff44530+pin*4,signal);return 0;}
fn timer_value(s){wr(s,0x3ff5f00c,1);return rd(s,0x3ff5f004)|(rd(s,0x3ff5f008)<<32);}
fn devices(){let mode=0;while mode<5{context=1300+mode;let c=xt_create();let s=se_create(c,0);let factor=1;if mode>=1 && mode<=3{let divisor=1<<(mode-1);wr(s,ref(1),0x3210);wr(s,ref(5),divisor-1);factor=divisor*2;}if mode==4{wr(s,ref(6),1);}wr(s,se_clock_address(s),rd(s,se_clock_address(s))|(1<<13)|(1<<5)|(1<<6)|(1<<9)|(1<<7));
 // Timer alarms/counter phase use APB, independently of CPU-only changes.
 wr(s,0x3ff5f000,0x40004000);wr(s,0x3ff5f018,0);wr(s,0x3ff5f01c,0);wr(s,0x3ff5f020,1);wr(s,0x3ff5f000,0xc0004000);tick(s,22*factor-1);ck(timer_value(s)==10,"timer APB period before boundary");tick(s,1);ck(timer_value(s)==11,"timer APB boundary");let clk=rd(s,ref(1));let other=0x3210;if (clk&ref(7))==0{other=0x08003210;}ck(se_bus(s,ref(1),4,1,other)== -16 && rd(s,ref(1))==clk,"active APB timer blocks unsupported source transition");if mode==0 || mode==4{let period=rd(s,ref(6));wr(s,ref(6),1-period);ck(se_apb_hz(s)==80000000 && timer_value(s)==11,"CPU-only transition keeps active APB timer state");tick(s,3);ck(timer_value(s)==12,"active APB timer continues across CPU-only switch");wr(s,ref(6),period);}wr(s,0x3ff5f000,0x40004000);
 // UART1 output scheduling uses the selected APB while REF_TICK remains1MHz.
 wr(s,0x3ff50020,0x0800001c);wr(s,0x3ff50014,8);wr(s,0x3ff50040,0);let u=se_uart(s,1);let count=load64(u+8);wr(s,0x3ff50000,0x5a);tick(s,80*factor-1);ck(load64(u+8)==count,"UART APB frame before final stop bit");tick(s,1);ck(load64(u+8)==count+1,"UART APB frame completes at boundary");wr(s,0x3ff50020,0x1c);count=load64(u+8);wr(s,0x3ff50000,0xa5);tick(s,6399);ck(load64(u+8)==count,"UART reference clock is independent of APB");tick(s,1);ck(load64(u+8)==count+1,"UART fixed1MHz reference deadline");
 // Observe actual routed SPI clock transitions at the pad, not private periods.
 pin(s,21,8,0);wr(s,0x3ff64018,(3<<12)|(1<<6)|3);wr(s,0x3ff6401c,(1<<27)|1);wr(s,0x3ff64028,7);wr(s,0x3ff64000,1<<18);ck(se_gpio_level(s,21)==0,"SPI starts at idle clock");tick(s,2*factor-1);ck(se_gpio_level(s,21)==0,"SPI APB leading edge not early");tick(s,1);ck(se_gpio_level(s,21)==1,"SPI APB leading edge");tick(s,2*factor);ck(se_gpio_level(s,21)==0,"SPI APB trailing edge");tick(s,100*factor);
 // RMT APB timing and REF selection are different source domains.
 pin(s,21,87,0);wr(s,0x3ff560f0,1);wr(s,0x3ff56020,0x81000002);wr(s,0x3ff56800,(5|0x8000)|(5<<16));wr(s,0x3ff56804,0);wr(s,0x3ff56024,1<<17);wr(s,0x3ff56024,(1<<17)|1);ck(se_gpio_level(s,21)==1,"RMT first pulse is driven");tick(s,10*factor-1);ck(se_gpio_level(s,21)==1,"RMT APB pulse not shortened");tick(s,1);ck(se_gpio_level(s,21)==0,"RMT APB pulse boundary");tick(s,10*factor);wr(s,0x3ff56024,8);wr(s,0x3ff56024,1);ck(se_gpio_level(s,21)==1,"RMT reference pulse starts");tick(s,799);ck(se_gpio_level(s,21)==1,"RMT REF_TICK does not scale with APB");tick(s,1);ck(se_gpio_level(s,21)==0,"RMT fixed1MHz reference pulse");tick(s,800);
 // An open bus READ+STOP is timed by programmed APB low/high/start/stop fields.
 pin(s,21,29,1);pin(s,19,30,1);wr(s,0x3ff44130+29*4,128|21);wr(s,0x3ff44130+30*4,128|19);let b=0x3ff53000;wr(s,b+4,0x113);wr(s,b,3);wr(s,b+12,1000);wr(s,b+48,1);wr(s,b+52,1);wr(s,b+56,3);wr(s,b+64,2);wr(s,b+68,2);wr(s,b+72,2);wr(s,b+76,2);wr(s,b+80,0);wr(s,b+84,0);wr(s,b+88,0);wr(s,b+92,(2<<11)|1);wr(s,b+96,3<<11);wr(s,b+100,4<<11);wr(s,b+4,0x133);tick(s,0);tick(s,138*factor-1);ck(load64(se_i2c(s,0))!=0,"I2C APB transfer cannot complete early");tick(s,1);ck(!load64(se_i2c(s,0)),"I2C APB STOP deadline");xt_wsr(c,230,15);rd(s,0x3ff40078);ck(rd(s,b+28)==255,"I2C APB open-bus byte via protected DPORT read");wr(s,b+12,20);wr(s,b+68,100);wr(s,b+88,0);wr(s,b+92,4<<11);wr(s,b+4,0x133);tick(s,0);tick(s,20*factor-1);ck(!(rd(s,b+32)&256),"I2C APB timeout not early");tick(s,1);ck((rd(s,b+32)&256) && !load64(se_i2c(s,0)),"I2C timeout precedes later wire phase at scaled deadline");
 ck(se_gpio_drive(s,19,0)==0,"external RMT RX input low");wr(s,0x3ff44130+84*4,128|19);wr(s,0x3ff56028,(1<<24)|(100<<8)|1);let rxcfg=(1<<17)|(3<<8)|128|32;wr(s,0x3ff5602c,rxcfg|2);ck(se_gpio_drive(s,19,1)==0,"external short filter pulse");tick(s,3*factor-1);ck(((rd(s,0x3ff56064)>>24)&7)==4,"RMT filter threshold counts APB clocks");ck(se_gpio_drive(s,19,0)==0,"short pulse ends before filter threshold");tick(s,3*factor);ck(((rd(s,0x3ff56064)>>24)&7)==4,"short APB-filtered pulse is rejected");ck(se_gpio_drive(s,19,1)==0,"full filter pulse starts");tick(s,3*factor);ck(((rd(s,0x3ff56064)>>24)&7)==3,"full APB-filtered edge is accepted");ck(se_gpio_drive(s,19,0)==0,"full filter pulse ends");tick(s,3*factor);ck((rd(s,0x3ff56900)&65535)==0x8003,"RMT RX duration stays in APB ticks across clock rates");wr(s,0x3ff5602c,rxcfg);ck(se_gpio_drive(s,19,-1)==0,"external RMT input released");
 se_close(s);xt_close(c);mode=mode+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"C clock reference argument");cr=h_read(load64(argv+8));ck(h_file_size==41464 && load64(cr)==0x455350434c4b0001 && load64(cr+8)==45,"independent C clock reference shape");profiles();vectors();cycles();devices();h_print(1,h_cat3("Clock model: ",h_int(checks)," checks passed\n"));return 0;}
