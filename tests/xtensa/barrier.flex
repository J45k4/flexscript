import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Barrier case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn setup(){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,771);store64(c+128,0x2000);xt_setreg(c,2,0x13579bdf);return c;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"GNU input");gnu=h_read(load64(argv+8));ck(h_file_size==771,"GNU fixture shape");let r=alloc(4096);em_zero(r,4096);let c=setup();context=1;ck(xt_run_slice(c,r,100,1)==10 && load64(c+176)==1 && load64(c+128)==0x2003 && !load64(c+320),"default MEMW executes normally with no event");ck(xt_barrier_watch(c,1)==0,"arm one MEMW watch");ck(xt_run_slice(c,r,100,2)==10 && load64(c+176)==2 && load64(c+128)==0x2006 && load64(c+304),"NOP doesnot consume theMEMW watch");ck(xt_run_slice(c,r,100,10)==12 && load64(r+8)==12 && load64(c+176)==2 && load64(c+128)==0x2006 && xt_reg(c,2)==0x13579bdf && load64(c+312)==0x2006 && load64(c+320) && !load64(c+304),"armed GNU MEMW exits before any architectural retirement");let i=0;while i<3{ck(xt_run_slice(c,r,100,10)==12 && load64(c+176)==2 && load64(c+128)==0x2006 && load64(c+312)==0x2006,"pending MEMW cannot execute orconsume fuel beforeack");i=i+1;}ck(xt_run_slice(c,r,100,2)==12 && load64(r+8)==12 && load64(c+176)==2,"zero-retirement polling still reports the unacknowledged MEMW event");ck(xt_barrier_watch(c,0)== -16 && xt_barrier_watch(c,1)== -16,"pending event cannot be silentlydisabled orrearmed");ck(xt_barrier_ack(c)==0 && !load64(c+320) && !load64(c+312) && load64(c+176)==2 && load64(c+128)==0x2006,"ack releasesonly thedeviceevent");ck(xt_barrier_ack(c)== -22,"duplicate acknowledgement rejected");ck(xt_run_slice(c,r,100,3)==10 && load64(c+176)==3 && load64(c+128)==0x2009 && !load64(c+320),"same MEMW retires exactlyonce afterack");ck(xt_barrier_watch(c,1)==0 && xt_run_slice(c,r,100,5)==10 && xt_reg(c,2)==42 && load64(c+304),"RSYNC andordinary instructions remain unaffected");ck(xt_barrier_watch(c,0)==0 && !load64(c+304),"unused watch can bedisarmed");xt_close(c);context=2;c=setup();xt_wsr(c,0,0x2006);xt_wsr(c,1,0x2003);xt_wsr(c,2,1);ck(xt_barrier_watch(c,1)==0 && xt_step(c)==12 && !load64(c+176) && xt_sr(c,2)==1 && load64(c+128)==0x2000,"paused MEMW cannot advance a hardwareloop");ck(xt_barrier_ack(c)==0 && xt_run_slice(c,r,100,1)==10 && load64(c+176)==1 && load64(c+128)==0x2006 && !xt_sr(c,2),"loop retirement occurs only whenMEMW actuallyexecutes");xt_close(c);context=3;c=setup();xt_wsr(c,231,0x2000);xt_wsr(c,228,128);ck(xt_barrier_watch(c,1)==0 && xt_step(c)==12,"IRQfixture pauses atMEMW");xt_wsr(c,226,128);ck(xt_step(c)==12 && !load64(c+176) && !load64(c+248),"pending deviceevent stayspaused untilhost decides toresume");ck(xt_barrier_ack(c)==0 && xt_run_slice(c,r,100,1)==10 && xt_sr(c,177)==0x2000 && load64(c+128)==0x2000 && load64(c+248)==1,"IRQ arrivingduring devicewait entersbeforeMEMW andRFE returns toit");xt_wsr(c,227,128);ck(xt_run_slice(c,r,100,2)==10 && load64(c+128)==0x2003 && load64(c+176)==2,"MEMW executesonce afterinterruptreturn");xt_close(c);context=4;ck(xt_barrier_watch(0,1)== -22 && xt_barrier_ack(0)== -22,"null contexts rejected");c=setup();ck(xt_barrier_watch(c,-1)== -22 && xt_barrier_watch(c,2)== -22 && xt_barrier_ack(c)== -22 && !load64(c+304),"invalid arm/ack preserves state");store64(c+160,-95);ck(xt_barrier_watch(c,1)== -22 && xt_barrier_ack(c)== -22 && xt_run_slice(c,r,100,1)== -1,"faulted CPU cannotarm orresume events");xt_close(c);syscall(11,r,4096,0,0,0,0);h_print(1,h_cat3("Barrier: ",h_int(checks)," checks passed\n"));return 0;}
