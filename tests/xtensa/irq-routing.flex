import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global metadata=0;global gnu=0;global flash=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("IRQ routing case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn ref(index){return em_u32(metadata+index*4);}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"independent register write");return 0;}
fn clean(c){let i=0;while i<3{xt_wsr(c,240+i,0x70000000);i=i+1;}return 0;}
fn fresh(){let c=xt_create();let code=xt_map(c,0x1000,4096,5);em_copy(code,gnu,835);xt_wsr(c,231,0x1000);xt_setreg(c,1,0x5000);xt_setreg(c,4,0x13579bdf);store64(c+128,0x1000);let s=se_create(c,0);ck(xt_cycle_profile(c,0)==0,"functional timing fixture");clean(c);return s;}
fn close(s){let c=load64(s);se_close(s);xt_close(c);return 0;}
fn table(){context=1;ck(ref(0)==32 && ref(1)==26 && ref(2)==3,"independent original core metadata");ck(xt_irq_external_level()==ref(3) && xt_irq_external_edge()==ref(4) && xt_irq_external()==(ref(3)|ref(4)),"level andedge input masks match configured CPU types");let i=1;while i<=7{let expected=ref(8+i);if i>=6{expected=0;}ck(xt_irq_mask(i)==expected,"maskable priority masks match core metadata;NMI/debug separate");i=i+1;}let found=0;i=0;while i<26{let line=ref(80+i);let type=ref(48+line);ck(line<32 && (type==1 || type==2 || type==5),"external input map is not an internal timer/software/profiling line");if type!=5{found=found+1;}i=i+1;}ck(found==25,"all25 maskable external inputs represented");return 0;}
fn inputs(){let line=0;while line<32{context=100+line;let s=fresh();let c=load64(s);let type=ref(48+line);let bit=1<<line;let expected=0;if type==1 || type==2{expected=bit;}wr(s,0x3ff440d4,1<<15);wr(s,0x3ff0015c,line);ck(se_source_mask(s,22)==expected && se_source(s,22,1)==(expected!=0) && !se_source(s,22,0),"matrix selects this configured external CPU input only");ck(!se_source_mask(s,-1) && !se_source_mask(s,69),"original matrix source bounds");wr(s,0x3ff44048,1<<19);ck((xt_sr(c,226)&xt_irq_external())==expected,"GPIO raw source reaches the selected external bit");let ps=0;while ps<32{xt_wsr(c,230,ps);xt_wsr(c,228,0);ck(!xt_irq_level(c),"disabled CPU source cannot deliver");xt_wsr(c,228,bit);let floor=ps&15;if (ps&16) && floor<3{floor=3;}let level=0;if expected && ref(16+line)>floor{level=ref(16+line);}ck(xt_irq_level(c)==level,"priority andEXCM mask the selected route independently");ps=ps+1;}xt_wsr(c,230,15);xt_wsr(c,227,bit);let after=0;if type==1{after=bit;}ck((xt_sr(c,226)&xt_irq_external())==after,"INTCLEAR clears an edge latch but cannot clear a live level input");ck(se_sync(s)==0 && (xt_sr(c,226)&xt_irq_external())==after,"a held edge input cannot relatch after acknowledgement");if expected{ck(xt_timer_config(c,0)==-16,"active input prevents discarding configured interrupt state");}wr(s,0x3ff4404c,1<<19);ck(!(xt_sr(c,226)&xt_irq_external()),"acknowledged source deassertion clears remaining live levels");wr(s,0x3ff44048,1<<19);ck((xt_sr(c,226)&xt_irq_external())==expected,"a second source assertion creates a fresh edge or level");wr(s,0x3ff4404c,1<<19);if type==2{ck((xt_sr(c,226)&bit)!=0,"edge pending survives input deassertion until CPU acknowledgement");}xt_wsr(c,227,bit);ck(!(xt_sr(c,226)&xt_irq_external()) && !load64(c+496),"CPU edge latch andwire state are independent");ck(xt_timer_config(c,0)==0 && xt_timer_config(c,1)==0,"quiescent original profile can be changed safely");close(s);line=line+1;}return 0;}
fn fanin(){context=200;let s=fresh();let c=load64(s);wr(s,0x3ff440d4,1<<15);wr(s,0x3ff0015c,19);wr(s,0x3ff0018c,20);wr(s,0x3ff4000c,2);wr(s,0x3ff44048,1<<19);ck((xt_sr(c,226)&xt_irq_external())==((1<<19)|(1<<20)),"independent GPIO andUART sources OR different CPU inputs");wr(s,0x3ff0015c,20);ck((xt_sr(c,226)&xt_irq_external())==(1<<20),"held source remapping removes the old level andshares the new input");wr(s,0x3ff4404c,1<<19);ck((xt_sr(c,226)&xt_irq_external())==(1<<20),"clearing one fan-in source preserves another on the same CPU input");wr(s,0x3ff4000c,0);ck(!(xt_sr(c,226)&xt_irq_external()),"last fan-in source deasserts the CPU input");xt_interrupt(c,0xffffffff);ck((xt_sr(c,226)&~0x18040)==xt_irq_external(),"external injection cannot impersonate timer,software,NMI orprofiling inputs");xt_wsr(c,227,0xffffffff);ck(xt_sr(c,226)==xt_irq_external_level(),"all edge latches clear while live external levels remain");xt_interrupt(c,0);ck(!xt_sr(c,226),"input deassertion clears live levels");close(s);let generic=xt_create();xt_interrupt(generic,0xffffffff);ck(xt_sr(generic,226)==2,"target-less CPU preserves its explicit legacy external1 contract");xt_close(generic);return 0;}
fn preempt(run){let line=0;while line<32{let type=ref(48+line);if type==1 || type==2{context=300+line;let level=ref(16+line);let bit=1<<line;let s=fresh();let c=load64(s);ck(xt_run_slice(c,run,100,1)==6 && load64(c+192)==5 && !load64(c+176),"GNU pending device load remains uncommitted");wr(s,0x3ff440d4,1<<15);wr(s,0x3ff0015c,line);wr(s,0x3ff44048,1<<19);xt_wsr(c,228,bit);xt_wsr(c,230,level);ck(xt_mmio_preempt(c)==-11 && load64(c+192)==5,"equal INTLEVEL blocks precommit delivery at every priority");xt_wsr(c,230,0);ck(xt_mmio_preempt(c)==0 && !load64(c+192) && !load64(c+176) && xt_reg(c,4)==0x13579bdf && load64(c+128)==0x1000,"eligible configured input preempts without committing the pending load");ck(xt_step(c)==0 && xt_sr(c,176+level)==0x1000 && load64(c+128)==0x1000 && load64(c+248)==1 && load64(c+176)==1,"GNU RFE/RFI returns to the uncommitted load with the correct EPC bank");if level>1{ck(xt_sr(c,192+level)==0 && !xt_sr(c,230),"RFI restores the correct EPS bank for all high priorities");}close(s);}line=line+1;}return 0;}
fn cache_routes(run){let line=0;while line<32{let type=ref(48+line);if type==1 || type==2{context=400+line;let bit=1<<line;let s=fresh();let c=load64(s);ck(se_cache_attach(s,flash,4194304)==0,"bounded synthetic NOR cache fixture");wr(s,0x3ff43050,1);wr(s,0x3ff10000,256);wr(s,0x3ff10134,1);wr(s,0x3ff00044,0x8ee);wr(s,0x3ff00040,0x28);xt_setreg(c,1,0x3f401234);ck(xt_run_slice(c,run,100,1)==6 && load64(c+192)==5,"GNU pending cached load");ck(se_bus(s,0x3f401234,4,0,0)>=0 && se_cache_mmu_error(se_cache(s),0),"MMU lookup publishes its own error before CPU commit");wr(s,0x3ff00214,line);wr(s,0x3ff005a0,1<<21);xt_wsr(c,228,128);xt_wsr(c,226,128);ck(se_cache_preempt(s,0x3f401234)==0 && load64(c+192)==5,"foreign eligible software IRQ cannot replace the routed cache source");xt_wsr(c,227,128);xt_wsr(c,228,bit);xt_wsr(c,230,ref(16+line));ck(se_cache_preempt(s,0x3f401234)==0 && load64(c+192)==5,"routed cache input obeys its own priority mask");xt_wsr(c,230,0);ck(se_cache_preempt(s,0x3f401234)==0 && !load64(c+192) && !load64(c+176) && xt_reg(c,4)==0x13579bdf,"routed cache source preempts through every maskable input without committing data");close(s);}line=line+1;}return 0;}
fn s3(){context=500;let c=xt_create();let s=se_create(c,9);let line=0;while line<32{wr(s,0x600c2040,line);let expected=0;if line==1{expected=2;}ck(se_source_mask(s,16)==expected,"S3 does not inherit an unverified LX6 external-input table");line=line+1;}se_close(s);xt_close(c);return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==3,"metadata andGNU fixture inputs");metadata=h_read(load64(argv+8));ck(h_file_size==424,"independent C metadata size");gnu=h_read(load64(argv+16));ck(h_file_size==835,"independent GNU instruction layout");flash=alloc(4194304);em_zero(flash,4194304);let run=alloc(4096);em_zero(run,4096);table();inputs();fanin();preempt(run);cache_routes(run);s3();syscall(11,flash,4194304,0,0,0,0);syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("IRQ routing: ",h_int(checks)," checks passed\n"));return 0;}
