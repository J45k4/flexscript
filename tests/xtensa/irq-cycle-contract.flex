import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("IRQ cycle case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn setup(offset){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,777);store64(c+128,0x2000+offset);xt_setreg(c,2,128);xt_setreg(c,3,0);xt_setreg(c,4,0x13579bdf);xt_setreg(c,5,0x2468ace0);xt_wsr(c,231,0x2000);xt_wsr(c,228,128);return c;}
fn advance(c,n){let cc=xt_sr(c,234);let result=xt_cycle_clock(c,load64(c+336)+n);if result{return result;}xt_wsr(c,234,cc+n);return 0;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"clock/timer fixture register");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"PLL fixture transaction");return 0;}
fn board_clocks(run){let mode=0;while mode<4{let phase=0;while phase<6{context=1000+mode*10+phase;let c=setup(0);let s=se_create(c,0);let qpc=6;if mode==0{wr(s,0x3ff48070,0x3210);qpc=12;}if mode==2{wr(s,0x3ff0003c,1);qpc=3;}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);qpc=2;}
 store64(c+176,phase);ck(se_sync(s)==0,"publish initial fractional phase");wr(s,se_clock_address(s),se_bus(s,se_clock_address(s),4,0,0)|(1<<13));wr(s,0x3ff5f000,0x40004000);wr(s,0x3ff5f018,0);wr(s,0x3ff5f01c,0);wr(s,0x3ff5f020,1);wr(s,0x3ff5f000,0xc0004000);let before=load64(s+16);let fractional=load64(se_clock(s)+24);xt_wsr(c,234,0xfffffffd);
 ck(se_run_slice(s,run,1000,phase+6)==10 && load64(c+176)==phase+6 && load64(c+248)==1,"source,entry,handler,RFE and resumed read retire exactly six instructions");ck(xt_reg(c,3)==1 && xt_reg(c,5)==6 && xt_reg(c,4)==13 && xt_sr(c,234)==14,"marker and wrapped stamps match measured IRQ timeline");ck(load64(se_clock(s)+152)==11 && se_cpu_cycles(s)==phase+17 && !load64(c+368),"seven entry plus four return idle cycles advance monotonic CPU time");let ticks=(fractional+17*qpc)/6;ck(load64(s+16)==before+ticks && load64(se_clock(s)+24)==(fractional+17*qpc)%6,"all elapsed IRQ cycles preserve fractional reference phase");wr(s,0x3ff5f00c,1);ck(se_bus(s,0x3ff5f004,4,0,0)==ticks/se_apb_factor(s)/2,"peripheral timer progresses through entry and return");se_close(s);xt_close(c);phase=phase+1;}mode=mode+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"GNU input");gnu=h_read(load64(argv+8));ck(h_file_size==777,"GNU fixture length");let run=alloc(4096);em_zero(run,4096);
 context=1;let c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10,"guest INTSET commits once");ck(xt_sr(c,226)==128 && !xt_cycle_eligible(c,128) && xt_cycle_profile(c,0)==-16,"raw source visible while delivery is deferred and profile stays owned");xt_wsr(c,234,0xfffffff8);ck(xt_cycle_now(c)==1 && !xt_cycle_eligible(c,128),"writable CCOUNT cannot accelerate source phase");ck(xt_run_slice(c,run,100,2)==10 && xt_reg(c,3)==1 && !load64(c+248),"one following increment commits before eligibility");ck(xt_step(c)==13 && xt_cycle_wait(c)==7 && load64(c+176)==2 && load64(c+128)==0x2300 && xt_sr(c,177)==0x2006 && (xt_sr(c,230)&16) && load64(c+248)==1,"entry saves exact EPC and context before seven-cycle vector readiness");ck(xt_reg(c,5)==0x2468ace0 && xt_cycle_ack(c)==-11,"handler has not fetched during entry");xt_wsr(c,234,0xfffffff0);ck(xt_cycle_wait(c)==7 && advance(c,6)==0 && xt_cycle_wait(c)==1 && xt_step(c)==13,"counter rewrite and partial entry cannot release vector early");ck(advance(c,1)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,3)==10 && xt_reg(c,5)==0xfffffff7,"first handler read sees elapsed entry time");ck(xt_run_slice(c,run,100,5)==10 && !xt_sr(c,226) && !load64(c+400) && !(xt_sr(c,230)&16) && load64(c+128)==0x2006,"handler clears source and RFE restores context exactly once");ck(xt_step(c)==13 && xt_cycle_wait(c)==4 && xt_reg(c,4)==0x13579bdf,"RFE target waits for aligned frontend completion");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,6)==10 && xt_reg(c,4)==0xfffffffe && xt_cycle_now(c)==17 && load64(c+248)==1,"resume counter includes entry and return without duplicate retirement");xt_close(c);
 context=2;c=setup(0x20);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,4)==10 && !xt_sr(c,226) && !load64(c+400) && !load64(c+248) && xt_reg(c,3)==1 && xt_reg(c,4)==3,"following INTCLEAR cancels source before delivery");xt_close(c);
 context=3;c=setup(0x40);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,2)==10 && xt_sr(c,226)==128,"duplicate INTSET fixture");ck(xt_step(c)==13 && xt_sr(c,177)==0x2046 && !xt_reg(c,3) && xt_cycle_wait(c)==7,"reasserted pending INTSET cannot postpone eligibility");xt_close(c);
 context=4;c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10,"host cancellation fixture");xt_wsr(c,227,128);xt_wsr(c,226,128);ck(xt_step(c)==13 && xt_sr(c,177)==0x2003 && !xt_reg(c,3),"host clear removes stale source phase before new injection");xt_close(c);
 context=5;c=setup(0);ck(xt_run_slice(c,run,100,2)==10 && !xt_reg(c,3) && xt_reg(c,5)==1 && load64(c+248)==1 && !load64(c+336),"standalone functional profile retains immediate delivery");xt_close(c);
 context=6;c=setup(0);let other=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_cycle_profile(other,1)==0 && xt_run_slice(c,run,100,1)==10,"independent CPU fixture");xt_wsr(other,226,128);ck(xt_step(other)==13 && xt_cycle_wait(other)==7 && !load64(c+248) && !load64(c+368),"source and vector phases remain per CPU");xt_close(other);xt_close(c);
 board_clocks(run);syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("IRQ cycle: ",h_int(checks)," checks passed\n"));return 0;}
