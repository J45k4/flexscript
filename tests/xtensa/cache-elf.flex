import "../../emulator/esp32/board.flex";
import "../../scripts/lib/esp32-elf.flex";
import "board-cache-elf.flex";
fn main(argc,argv){h_environment(argc,argv);h_assert(argc==3,"ELF and full NOR files required");let bytes=h_read(load64(argv+8));let size=h_file_size;let elf=ee_open(bytes,size);let nor=h_read(load64(argv+16));let nor_size=h_file_size;let view=board_cache_ram(elf,nor,nor_size);let c=xt_create();h_assert(xt_map(c,0x40080000,131072,5)>0 && xt_map(c,0x3ffb0000,196608,3)>0,"SRAM maps");let s=se_create(c,0);h_assert(se_cache_attach(s,nor,nor_size)==0,"NOR attach");h_assert(xt_load_elf(c,view,size)==0,"strict RAM loader rejected derived view");h_assert(load64(c+128)==ee_u32(bytes+24),"original ELF entry preserved");let i=0;while i<load64(elf+56){let ph=bytes+load64(elf+48)+i*32;if ee_u32(ph)==1 && ee_u32(ph+20) && (ee_u32(ph+8)==0x40080000 || ee_u32(ph+8)==0x3ffb0000){let n=ee_u32(ph+16);let at=ee_u32(ph+8);let j=0;while j<n{h_assert(xt_read(c,at+j,1)==load8(bytes+ee_u32(ph+4)+j),"all RAM payload bytes unchanged");j=j+1;}}i=i+1;}h_assert(xt_read(c,0x400d0000,1)==0 && load64(c+160)== -5,"loader did not bypass cached fetch gate");se_close(s);xt_close(c);h_print(1,"PASS: XIP ELF/NOR validated; RAM loaded; cached pages remain gated\n");return 0;}
