import "../../emulator/esp32/rom.flex";
import "../../scripts/lib/host.flex";
global er_checks=0;
fn check(ok,message){er_checks=er_checks+1;if !ok{h_print(2,h_cat3("ROM check ",h_int(er_checks),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn equal(a,b,n){let i=0;while i<n{if load8(a+i)!=load8(b+i){return 0;}i=i+1;}return 1;}
fn main(argc,argv){h_environment(argc,argv);check(argc==3 || argc==4,"requires supplied ROM and snapshot prefix, optional QEMU prefix");let rom=h_read(load64(argv+8));let size=h_file_size;check(er_rom_v3_valid(rom,size),"original supplied ROM layout");let c=xt_create();check(er_rom_v3_map(c,rom,size-1)== -22 && !load64(c+144),"truncated ROM rejected before mapping");let word=em_u32(rom+0x424);em_put32(rom+0x424,0);check(er_rom_v3_map(c,rom,size)== -22 && !load64(c+144),"incompatible startup rejected before mapping");em_put32(rom+0x424,word);check(xt_map(c,0x3ffae000,4096,3)>0,"collision fixture");check(er_rom_v3_map(c,rom,size)== -22 && load64(c+144)==1,"overlap rejected before adding ROM maps");xt_close(c);
 c=xt_create();check(er_rom_v3_data(c)== -22,"unmapped startup rejected");check(er_rom_v3_map(c,rom,size)==0 && load64(c+144)==4,"bounded ROM and reserved RAM maps");let code=xt_pointer(c,0x40000000,1,1);let data=xt_pointer(c,0x3ff90000,1,1);check(equal(code,rom,size),"every IROM byte matches supplied image");let i=size;while i<0x70000{check(load8(code+i)==0,"ROM tail matches QEMU zero padding");i=i+1;}i=0;while i<0x10000{check(load8(data+i)==load8(code+0x60000+i),"immutable DROM mirrors final IROM64KiB");i=i+1;}
 xt_wsr(c,235,0xabab);check(er_rom_v3_data(c)== -22,"application-core initialization profile is unsupported");xt_wsr(c,235,0xcdcd);xt_setreg(c,1,0x12345678);xt_wsr(c,230,96);xt_wsr(c,3,17);store64(c+128,0x11223344);let fi=0;while fi<16{xt_wfr(c,fi,0x7f800000+fi);fi=fi+1;}fi=230;while fi<234{xt_wur(c,fi,0x12340000+fi);fi=fi+1;}let saved=alloc(4096);em_copy(saved,c,4096);let steps=er_rom_v3_data(c);check(steps==2155,"actual ROM startup fragment retired2155 instructions");check(equal(c,saved,4096),"pre-entry profile preserves pristine CPU context");check(xt_read(c,0x3ffae0c0,4)==0x3ffae0c4 && xt_read(c,0x3ffae0c4+156,4)==0x40004168,"real ROM initializer produced PHY pointer and chip write function");let low=xt_pointer(c,0x3ffae000,1,1);let high=xt_pointer(c,0x3ffe0000,1,1);h_save_bytes(h_cat(load64(argv+16),".low.bin"),low,8192,420);h_save_bytes(h_cat(load64(argv+16),".high.bin"),high,0x1400,420);check(equal(code,rom,size),"startup cannot modify immutable ROM");if argc==4{let expected=h_read(h_cat(load64(argv+24),"/low.bin"));check(h_file_size==8192 && equal(low,expected,8192),"all reserved low RAM matches independently booted QEMU");expected=h_read(h_cat(load64(argv+24),"/high.bin"));check(h_file_size==0x1400 && equal(high,expected,0x1400),"all startup high RAM matches independently booted QEMU");}store64(c+176,1);check(er_rom_v3_data(c)== -22,"startup profile requires pristine retirement state");xt_close(c);
 c=xt_create();check(er_rom_v3_map(c,rom,size)==0,"read-only fixture");check(xt_write(c,0x400041a4,4,0)== -1 && load64(c+160)== -13,"IROM writes fault with permission error");xt_close(c);c=xt_create();check(er_rom_v3_map(c,rom,size)==0,"DROM read-only fixture");check(xt_write(c,0x3ff90000,4,0)== -1 && load64(c+160)== -13,"DROM writes fault with permission error");xt_close(c);h_print(1,h_cat3("ROM profile: ",h_int(er_checks)," checks passed\n"));return 0;}
