import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Timer IRQ case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c){let i=0;while i<3{xt_wsr(c,240+i,0x70000000);i=i+1;}return 0;}
fn setup(pc){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,838);store64(c+128,pc);xt_wsr(c,231,0x2000);xt_setreg(c,2,0x70000000);xt_setreg(c,3,0);return c;}
fn elapsed(c,n){ck(xt_ccount_advance(c,n)==0 && xt_cycle_clock(c,load64(c+336)+n)==0,"publish exact elapsed CPU cycles");return 0;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"clock fixture register");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"PLL transaction");return 0;}
fn priorities(){let c=xt_create();xt_timer_config(c,1);clear(c);xt_wsr(c,234,100);let pending=0;while pending<8{let enable=0;while enable<8{let ps=0;while ps<32{context=1000+pending*256+enable*32+ps;clear(c);let mask=0;let i=0;while i<3{let bit=xt_timer_mask(i);if enable&(1<<i){mask=mask|bit;}if pending&(1<<i){xt_wsr(c,240+i,100);}i=i+1;}xt_wsr(c,234,100);xt_wsr(c,228,mask);xt_wsr(c,230,ps);let current=ps&15;if (ps&16) && current<3{current=3;}let expected=0;i=0;while i<3{let level=1;if i==1{level=3;}if i==2{level=5;}if (pending&enable&(1<<i)) && level>current{expected=level;}i=i+1;}ck(xt_irq_level(c)==expected,"highest enabled comparator exceeds INTLEVEL and EXCMLEVEL3");ps=ps+1;}enable=enable+1;}pending=pending+1;}xt_close(c);return 0;}
fn deadlines(){context=2;let c=xt_create();xt_timer_config(c,1);clear(c);xt_wsr(c,240,32);xt_wsr(c,241,64);xt_wsr(c,242,96);xt_wsr(c,228,0x18040);xt_wsr(c,230,0);ck(xt_timer_next(c)==33,"nearest eligible comparator in CPU cycles");xt_wsr(c,230,1);ck(xt_timer_next(c)==65,"level1 cannot wake masked CPU");xt_wsr(c,230,3);ck(xt_timer_next(c)==97,"level3 cannot wake equal-priority CPU");xt_wsr(c,230,5);ck(xt_timer_next(c)==-1,"all comparator priorities masked");xt_wsr(c,230,16);ck(xt_timer_next(c)==97,"high5 can wake EXCM while medium3 cannot");xt_wsr(c,228,32768);ck(xt_timer_next(c)==-1,"INTENABLE excludes unrelated comparator wakeups");xt_wsr(c,230,0);ck(xt_ccount_advance(c,65)==0 && xt_timer_next(c)==0 && xt_irq_level(c)==3,"published eligible comparator wakes immediately");xt_close(c);return 0;}
fn nested(){context=3;let c=setup(0x2010);xt_wsr(c,234,9);xt_timer_config(c,1);clear(c);xt_wsr(c,241,20);xt_wsr(c,242,30);xt_wsr(c,228,0x18000);xt_wsr(c,230,0x20020);xt_ccount_advance(c,12);ck(xt_step(c)==0 && load64(c+128)==0x21c3 && xt_sr(c,179)==0x2010 && xt_sr(c,195)==0x20020 && xt_reg(c,5)==0x20033,"medium entry saves EPC3/EPS3 and sets EXCM/INTLEVEL3");xt_ccount_advance(c,31-xt_sr(c,234));ck(xt_step(c)==0 && load64(c+128)==0x2243 && xt_sr(c,181)==0x21c3 && xt_sr(c,197)==0x20033 && xt_reg(c,8)==0x20035,"high5 preempts medium3 despite EXCM and saves its own bank");let n=0;while load64(c+128)!=0x21c3 && n<10{ck(xt_step(c)==0,"nested high handler executes GNU instructions");n=n+1;}ck(load64(c+128)==0x21c3 && xt_sr(c,230)==0x20033 && xt_reg(c,9)==0x20033 && xt_reg(c,11)==0x21c3,"RFI5 restores exact interrupted medium context");n=0;while load64(c+128)!=0x2010 && n<10{ck(xt_step(c)==0,"medium handler completes after nested return");n=n+1;}ck(load64(c+128)==0x2010 && xt_sr(c,230)==0x20020 && xt_reg(c,6)==0x20020 && xt_reg(c,7)==0x2010 && load64(c+248)==2 && !xt_reg(c,3),"RFI3 restores complete original PS/PC without executing main marker");xt_close(c);return 0;}
fn overlap(){context=4;let c=setup(0x2090);xt_wsr(c,234,9);xt_timer_config(c,1);clear(c);xt_wsr(c,241,10);xt_wsr(c,234,10);xt_wsr(c,228,32768);xt_wsr(c,230,21);xt_wsr(c,197,0);xt_wsr(c,181,0x9000);ck(xt_cycle_profile(c,1)==0 && xt_step(c)==0 && load64(c+128)==0x9000 && !xt_sr(c,230),"RFI5 commits restored target/context before frontend completion");ck(xt_step(c)==13 && xt_cycle_wait(c)==7 && xt_sr(c,179)==0x9000 && xt_sr(c,195)==0 && load64(c+128)==0x21c0 && load64(c+248)==1 && load64(c+176)==1 && !load64(c+160),"pending medium entry overlaps RFI frontend and precedes unmapped return-target fetch");elapsed(c,7);ck(xt_cycle_ack(c)==0 && xt_step(c)==0 && xt_reg(c,5)==19,"handler fetch follows exact seven-cycle entry with no extra retirement");xt_close(c);return 0;}
fn clocks(run){let mode=0;while mode<4{let phase=0;while phase<6{let timer=0;while timer<3{context=5000+mode*100+phase*3+timer;let c=setup(0x2000);let s=se_create(c,0);let qpc=6;if mode==0{wr(s,0x3ff48070,0x3210);qpc=12;}if mode==2{wr(s,0x3ff0003c,1);qpc=3;}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);qpc=2;}clear(c);store64(c+176,phase);ck(se_sync(s)==0,"initial fractional clock phase");xt_wsr(c,234,0xffffffc0);xt_wsr(c,240+timer,16);xt_wsr(c,228,xt_timer_mask(timer));xt_wsr(c,230,15);let before=load64(s+16);let fraction=load64(se_clock(s)+24);
 ck(se_run_slice(s,run,1000,phase+1)==10 && load64(s+208) && load64(c+128)==0x2003 && !xt_irq_level(c) && !load64(c+248),"WAITI atomically lowers masking and stops before main marker");ck(se_run_slice(s,run,1000,phase+2)==10 && load64(c+248)==1 && load64(c+176)==phase+2 && !xt_reg(c,3),"CPU comparator alone wakes WAITI and enters exactly one handler");ck(load64(se_clock(s)+152)==88 && xt_sr(c,234)==26 && se_cpu_cycles(s)==phase+90,"measured publication,wake and entry phases advance CCOUNT without fake retirement");let vector=0x2300;if timer==1{vector=0x21c0;}if timer==2{vector=0x2240;}ck(load64(c+128)==vector+3,"timer selects correct level vector");ck(load64(s+16)==before+(fraction+90*qpc)/6 && load64(se_clock(s)+24)==(fraction+90*qpc)%6,"WAITI CPU cycles preserve fractional peripheral-clock conversion");se_close(s);xt_close(c);timer=timer+1;}phase=phase+1;}mode=mode+1;}return 0;}
fn pending(run){let chip=0;while chip<2{let profile=0;while profile<2{let source=0;let count=4;if chip{count=1;}while source<count{context=6000+chip*100+profile*10+source;let c=setup(0x2000);let s=se_create(c,chip*9);ck(xt_cycle_profile(c,profile)==0,"pending fixture timing profile");clear(c);xt_wsr(c,234,100);let mask=128;let timer=source;if !chip && source<3{mask=xt_timer_mask(timer);xt_wsr(c,240+timer,100);xt_wsr(c,234,100);}else{xt_wsr(c,226,128);}xt_wsr(c,228,mask);xt_wsr(c,230,15);ck(se_run_slice(s,run,100,1)==10 && load64(s+208)==1 && load64(c+128)==0x2003,"already-pending source stays masked until WAITI issue");let phase=0;if profile && !chip{phase=1;}ck(load64(c+488)==phase,"WAITI records pre-retirement eligibility only for measured original profile");ck(se_run_slice(s,run,100,2)==10 && load64(c+248)==1 && load64(c+176)==2 && !xt_reg(c,3),"pending WAITI enters one handler before the main marker");let idle=0;if profile{idle=7;if !chip{idle=10;}}ck(load64(se_clock(s)+152)==idle && se_cpu_cycles(s)==idle+2 && xt_sr(c,234)==102+idle,"pending WAITI phase advances real clocks without fake retirement");ck(!load64(c+488) && !load64(s+208),"pending WAITI phase is consumed exactly once");se_close(s);xt_close(c);source=source+1;}profile=profile+1;}chip=chip+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"GNU input");gnu=h_read(load64(argv+8));ck(h_file_size==838,"GNU fixture length");let run=alloc(4096);em_zero(run,4096);priorities();deadlines();nested();overlap();clocks(run);pending(run);syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("Timer IRQ: ",h_int(checks)," checks passed\n"));return 0;}
