import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global ri_checks=0;global ri_case=0;global ri_code=0;
fn check(ok,message){ri_checks=ri_checks+1;if !ok{h_print(2,h_cat3("ROM integer case ",h_int(ri_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn fresh(){let c=xt_create();let p=xt_map(c,0x1000,16384,5);check(p>0,"GNU instruction map");em_copy(p,ri_code,6984);xt_wsr(c,231,0x800000);return c;}
fn value(i){if i==0{return 0;}if i==1{return 1;}if i==2{return 2;}if i==3{return 31;}if i==4{return 0x7fffffff;}if i==5{return 0x80000000;}if i==6{return 0xffffffff;}if i==7{return 0xfffffffe;}if i==8{return 0x12345678;}return 0x10000;}
fn step(c,index){store64(c+128,0x1000+index*3);check(xt_step(c)==0,"GNU instruction executes");return 0;}
fn sexts(){let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let k=0;while k<16{let g=0;while g<16{let i=0;while i<14{ri_case=wb*4096+k*256+g*16+i;let v=value(i%10);if i>=10{v=(1<<(k+7))+i-12;}xt_wsr(c,230,0);xt_setreg(c,(g+5)%16,v);let low=v% (1<<(k+8));if low>=(1<<(k+7)){low=low-(1<<(k+8));}step(c,k*16+g);check(xt_reg(c,g)==(low&0xffffffff),"all16 SEXT widths and word/sign boundaries");i=i+1;}g=g+1;}k=k+1;}xt_close(c);wb=wb+1;}return 0;}
fn operations(){let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let op=0;while op<8{let g=0;while g<16{let b=0;while b<16{let a=(b+7)%16;let x=0;while x<10{let y=0;while y<10{ri_case=100000+wb*2048+op*256+g*16+b;let left=value(x);let right=value(y);xt_wsr(c,230,0);xt_setreg(c,g,0x975321ef);xt_setreg(c,b,left);xt_setreg(c,a,right);let old=xt_reg(c,g);let before=load64(c+176);let index=256+op*256+g*16+b;step(c,index);if op>=4 && !right{check(load64(c+176)==before && xt_reg(c,g)==old && xt_sr(c,232)==6 && xt_sr(c,177)==0x1000+index*3 && load64(c+128)==0x800300,"division byzero is cause6,precise and unretired");}else{let expected=old;if op<4{let take=right==0;if op==1{take=right!=0;}if op==2{take=right>=0x80000000;}if op==3{take=right<0x80000000;}if take{expected=left;}}else{let l=left;let r=right;if op&1{if l>=0x80000000{l=0x100000000-l;}if r>=0x80000000{r=0x100000000-r;}}expected=l/r;if op>=6{expected=l%r;}if op&1{let negative=left>=0x80000000;if op<6{negative=negative!=(right>=0x80000000);}if negative{expected= -expected;}}expected=expected&0xffffffff;}
 check(xt_reg(c,g)==expected && load64(c+176)==before+1 && load64(c+128)==0x1000+index*3+3,"conditional moves and unsigned/signed quotient/remainder include register aliases and INT_MIN/-1");}y=y+1;}x=x+1;}b=b+1;}g=g+1;}op=op+1;}xt_close(c);wb=wb+1;}return 0;}
fn windows(){let wb=0;while wb<16{let c=fresh();let index=0;while index<2328{ri_case=200000+wb*2328+index;xt_wsr(c,72,wb);xt_wsr(c,73,(1<<wb)|(1<<((wb+1)&15)));xt_wsr(c,230,0x40000);let group=0;if index<256{let g=index%16;let b=(g+5)%16;group=g/4;if b/4>group{group=b/4;}}else if index<2304{let pair=(index-256)%256;let g=pair/16;let b=pair%16;let a=(b+7)%16;group=g/4;if b/4>group{group=b/4;}if a/4>group{group=a/4;}xt_setreg(c,b,1);xt_setreg(c,a,0);}else{xt_setreg(c,1,0x80000001);xt_setreg(c,2,1);}
 let before=load64(c+176);let exceptions=load64(c+272);step(c,index);if group{check(xt_sr(c,72)==((wb+1)&15) && load64(c+176)==before && load64(c+272)==exceptions,"all integer operands spill before predicate/divzero evaluation");}else{check(xt_sr(c,72)==wb && !(xt_sr(c,230)&16) && load64(c+176)==before+1,"SEXT immediate is not a window operand; low-GPR operations need no spill");}index=index+1;}xt_close(c);wb=wb+1;}return 0;}
fn exceptions_and_loops(){let c=fresh();let ps=0;while ps<4{let op=0;while op<4{ri_case=300000+ps*4+op;xt_wsr(c,230,ps*16);xt_setreg(c,0,0x12345678);xt_setreg(c,1,0x80000000);xt_setreg(c,2,0);let index=2324+op;let before=load64(c+176);step(c,index);let vector=0x800300;if ps==2{vector=0x800340;}if ps&1{vector=0x8003c0;}let epc=177;if ps&1{epc=192;}check(load64(c+128)==vector && xt_sr(c,epc)==0x1000+index*3 && xt_sr(c,232)==6 && xt_reg(c,0)==0x12345678 && load64(c+176)==before,"all division/remainder zero exceptions,kernel/user/double vectors");op=op+1;}ps=ps+1;}
 let index=2304;while index<2328{xt_wsr(c,230,0);xt_setreg(c,1,0x80000001);xt_setreg(c,2,7);xt_wsr(c,0,0x9000);xt_wsr(c,1,0x1000+index*3+3);xt_wsr(c,2,7);step(c,index);check(load64(c+128)==0x9000 && xt_sr(c,2)==6,"all new families finish hardware-loop iteration");xt_wsr(c,230,16);step(c,index);check(load64(c+128)==0x1000+index*3+3 && xt_sr(c,2)==6,"EXCM suppresses loop repetition");index=index+1;}xt_close(c);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU integer instruction file");ri_code=h_read(load64(argv+8));check(h_file_size==6984,"2328 fixed GNU24-bit instructions");sexts();operations();windows();exceptions_and_loops();h_print(1,h_cat3("ROM integer instructions: ",h_int(ri_checks)," checks passed\n"));return 0;}
