import "../../emulator/esp32/board.flex";
import "../../emulator/esp32/rom.flex";
import "../../scripts/lib/esp32-elf.flex";
import "board-cache-elf.flex";
// Stream completed UART0 bytes between slices. The device trace stays bounded.
fn board_flush(s,fd){let u=se_uart(s,0);let n=load64(u+8);if n{h_write(fd,s+16384,n);store64(u+8,0);}return 0;}
fn board_execute(s,c,ram,run,fuel,fd){let result=6;while load64(c+176)<fuel{let reason=se_run_slice(s,run,fuel,load64(c+176)+1000);board_flush(s,fd);let state=em_u32(ram+4);if state==0x444f4e45{result=load64(ram+8)!=0;if result{h_print(2,h_cat3("Guest return ",h_int(load64(ram+8)),"\n"));}return result;}if state==0x54524150{result=4;return result;}if reason<0{h_print(2,h_cat3("CPU error ",h_int(load64(c+160)),h_cat3(" PC ",h_int(load64(c+168)),"\n")));h_print(2,h_cat3("Opcode ",h_int(load64(c+216)),"\n"));h_print(2,h_cat3("Board error ",h_int(load64(s+32)),h_cat3(" address ",h_int(load64(s+40)),"\n")));result=1;return result;}if reason==11{h_print(2,"Cached read blocked before retirement\n");return 11;}if reason==5{h_print(2,"WAITI without a deliverable modeled interrupt\n");result=5;return result;}}return result;}
fn board_pin(text){let pin=0;let i=0;while load8(text+i){let digit=load8(text+i)-48;if digit<0 || digit>9 || i>=2{return -22;}pin=pin*10+digit;i=i+1;}if !i || pin>48{return -22;}return pin;}
fn main(argc,argv){h_environment(argc,argv);if argc<3{return 99;}let fuel=100000000;let has_fuel=0;let rom=0;let nor=0;let rom_steps=0;let download=0;let wire_a= -1;let wire_b= -1;let index=3;while index<argc{if h_equal(load64(argv+index*8),"--download-clock"){if download{return 99;}download=1;index=index+1;}else if h_equal(load64(argv+index*8),"--flash-nor"){if nor || index+1>=argc{return 99;}nor=load64(argv+(index+1)*8);index=index+2;}else if h_equal(load64(argv+index*8),"--rom"){if rom || index+1>=argc{return 99;}rom=load64(argv+(index+1)*8);index=index+2;}else if h_equal(load64(argv+index*8),"--fuel"){if has_fuel || index+1>=argc{return 99;}fuel=h_number(load64(argv+(index+1)*8));if fuel<1 || fuel>2000000000{return 99;}has_fuel=1;index=index+2;}else{if wire_a>=0 || index+1>=argc{return 99;}wire_a=board_pin(load64(argv+index*8));wire_b=board_pin(load64(argv+(index+1)*8));if wire_a<0 || wire_b<0{return 96;}index=index+2;}}let bytes=h_read(load64(argv+8));let elf=ee_open(bytes,h_file_size);let profile=ee_profile(elf);let c=xt_create();let code=xt_map(c,ee_u32(profile+8),131072,5);let ram_size=196608;let stack=ee_u32(profile+20)-ee_u32(profile+12);if stack>ram_size && !(rom && ee_u32(profile+4)==0){ram_size=stack;}if ram_size>327680 || ram_size%4096{return 98;}let ram=xt_map(c,ee_u32(profile+12),ram_size,3);if code<=0 || ram<=0{return 98;}if rom{h_assert(ee_u32(profile+4)==0,"ROM profile currently supports original ESP32 only");h_assert(h_equal(h_sha(rom),"9115bbcd03da9f54d3baca5ad94d588a43da54ed332347137ba3dc9010df258b"),"original ECO3 ROM image hash mismatch");let data=h_read(rom);h_assert(er_rom_v3_map(c,data,h_file_size)==0,"cannot map original ROM/reserved RAM");xt_wsr(c,235,0xcdcd);rom_steps=er_rom_v3_data(c);if rom_steps<0{h_print(2,h_cat3("ROM data init error ",h_int(rom_steps),h_cat3(" PC ",h_int(load64(c+128)),h_cat3(" opcode ",h_int(load64(c+216)),"\n"))));return 95;}h_print(1,h_cat3("ROM data init: instructions=",h_int(rom_steps),"\n"));}let s=se_create(c,ee_u32(profile+4));let view=bytes;if nor{h_assert(rom,"NOR-backed profile requires supplied ROM");let flash=h_read(nor);let flash_size=h_file_size;h_assert(se_cache_attach(s,flash,flash_size)==0,"cannot attach bounded explicit NOR image");if ee_section(elf,".flex.xip"){view=board_cache_ram(elf,flash,flash_size);}}if xt_load_elf(c,view,load64(elf+8)){return 97;}if download{h_assert(rom && se_clock_profile(s,1)==0,"download clock profile requires original supplied ROM and a pristine board");}if wire_a>=0{if se_gpio_wire(s,wire_a,wire_b){se_close(s);xt_close(c);return 96;}}let run=alloc(4096);em_zero(run,4096);let fd=syscall(2,load64(argv+16),577,420,0,0,0);h_assert(fd>=0,"cannot open UART capture");let result=board_execute(s,c,ram,run,fuel,fd);if !result{let id=0;while id<3{let drained=se_uart_drain(s,id);if drained{h_print(2,h_cat3("UART drain error ",h_int(drained),"\n"));result=1;}id=id+1;}}
 board_flush(s,fd);h_close(fd);if !result{h_print(1,h_cat3("PASS board firmware: instructions=",h_int(load64(c+176)),h_cat3(" ticks=",h_int(load64(s+16)),"\n")));}if !result && (load64(c+256) || load64(c+264)){h_print(1,h_cat3("Windows: overflow=",h_int(load64(c+256)),h_cat3(" underflow=",h_int(load64(c+264)),"\n")));}se_close(s);xt_close(c);return result;}
