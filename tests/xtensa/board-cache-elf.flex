// Host harness policy for the existing original XIP linker profile. Validate
// the ELF/NOR pair before returning a RAM-only loader view. Cached payloads
// remain in NOR and can be fetched only through real guest MMU/cache setup.
// Only program-header metadata is changed in the private loader view; guest
// instructions,constants and the supplied ELF/image are never modified.
fn board_cache_equal(a,b,n){let i=0;while i<n{if load8(a+i)!=load8(b+i){return 0;}i=i+1;}return 1;}
fn board_cache_ram(elf,nor,nor_size){let bytes=load64(elf);let size=load64(elf+8);h_assert(nor && nor_size>=65536 && nor_size<=16777216 && !(nor_size&(nor_size-1)),"invalid NOR geometry");let profile=ee_profile(elf);h_assert(ee_u32(profile+4)==0,"XIP profile requires original ESP32");let meta=ee_section(elf,".flex.xip");let code=ee_section(elf,".irom");let data=ee_section(elf,".drom");h_assert(meta && ee_u32(meta+20)==16 && code && ee_u32(code+12)==0x400d0000 && ee_u32(code+20)>0,"missing original XIP sections");let layout=ee_payload(elf,meta);let cf=ee_u32(layout);let cn=ee_u32(layout+4);let df=ee_u32(layout+8);let dn=ee_u32(layout+12);let ds=0;if data{ds=ee_u32(data+20);h_assert(!ds || ee_u32(data+12)==0x3f400000,"invalid DROM base");}h_assert(cf==0x30000 && cn==(ee_u32(code+20)+65535)/65536 && cn>0 && cn<=51 && df==cf+cn*65536 && dn==(ds+65535)/65536 && dn<=64 && df+dn*65536<=nor_size,"invalid XIP physical page layout");
 // Every allocated cached section must be represented by the emitted region.
 let i=0;while i<load64(elf+24){let sh=bytes+load64(elf+16)+i*40;let at=ee_u32(sh+12);let n=ee_u32(sh+20);if (ee_u32(sh+8)&2) && n{let region=0;let cached=0;if at>=0x400d0000 && at<0x40400000{region=code;cached=1;}if at>=0x3f400000 && at<0x3f800000{region=data;cached=1;}if cached{h_assert(region,"cached allocated section has no emitted region");h_assert(ee_u32(sh+4)!=8 && at>=ee_u32(region+12) && ee_range(ee_u32(region+20),at-ee_u32(region+12),n),"cached allocated section is outside emitted payload");}}i=i+1;}
 let view=h_take(size);h_copy(view,bytes,size);let codes=0;let datas=0;i=0;while i<load64(elf+56){let ph=bytes+load64(elf+48)+i*32;if ee_u32(ph)==1 && !ee_u32(ph+20){let align=ee_u32(ph+28);h_assert(!ee_u32(ph+16) && !(ee_u32(ph+24)&~7) && (!align || !(align&(align-1))) && ee_range(size,ee_u32(ph+4),0),"invalid empty load segment");ee_w32(view+load64(elf+48)+i*32,0);}if ee_u32(ph)==1 && ee_u32(ph+20){let at=ee_u32(ph+8);if at==0x400d0000 || at==0x3f400000{let region=code;let physical=cf;let flags=5;if at==0x3f400000{region=data;physical=df;flags=4;datas=datas+1;}else{codes=codes+1;}let n=ee_u32(ph+16);let align=ee_u32(ph+28);h_assert((!align || !(align&(align-1))) && (align<=1 || (at%align)==(ee_u32(ph+4)%align)),"invalid cached segment alignment");h_assert(region && n==ee_u32(ph+20) && n==ee_u32(region+20) && ee_u32(ph+24)==flags && ee_u32(ph+12)==at && ee_range(size,ee_u32(ph+4),n) && ee_range(nor_size,physical,n) && board_cache_equal(bytes+ee_u32(ph+4),nor+physical,n),"cached ELF segment and NOR payload differ");ee_w32(view+load64(elf+48)+i*32,0);}}i=i+1;}
 h_assert(codes==1 && datas==(ds>0),"duplicate or missing cached program segments");let ram_image=ee_rom_image(elf);let ram_size=h_file_size;h_assert(ram_size<=cf-4096 && ee_range(nor_size,4096,ram_size) && board_cache_equal(ram_image,nor+4096,ram_size),"NOR ROM-loadable SRAM image differs from ELF");return view;
}
