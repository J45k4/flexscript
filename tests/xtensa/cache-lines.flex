// GNU CPU transactions and silicon-confirmed PRO cache data sequences.
import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global cl_checks=0;global cl_case=0;global cl_gnu=0;global cl_flash=0;
fn check(ok,message){cl_checks=cl_checks+1;if !ok{h_print(2,h_cat3("Cache line case ",h_int(cl_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn pattern(page,offset){return ((page*53+offset*7+(offset>>8)*19)^0xd3)&255;}
fn expected(page,offset,width){let v=0;let i=0;while i<width{v=v|(pattern(page,offset+i)<<(i*8));i=i+1;}return v;}
fn wr(s,address,value){check(se_bus(s,address,4,1,value)>=0,"modeled cache register write");return 0;}
fn rd(s,address){let value=se_bus(s,address,4,0,0);check(value>=0,"modeled cache register read");return value;}
fn setup(){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,cl_gnu,9);let s=se_create(c,0);check(se_cache_attach(s,cl_flash,4194304)==0,"independent synthetic NOR fixture");wr(s,0x3ff43050,1);wr(s,0x3ff10000,1);wr(s,0x3ff10134,1);wr(s,0x3ff00044,0x8ee);wr(s,0x3ff00040,0x28);return s;}
fn close(s){let c=load64(s);se_close(s);xt_close(c);return 0;}
fn flush(s){wr(s,0x3ff00040,0x38);return 0;}
fn data(s,address,width){let value=se_bus(s,address,width,0,0);check(value>=0,"cache data transaction isexplicit");return value;}
fn sequences(){let bus=0;while bus<2{let mode=0;while mode<8{cl_case=bus*100+mode;let s=setup();let c=load64(s);let p=se_cache(s);let address=0x3f401234;let entry=0x3ff10000;if bus{address=0x400d1234;entry=0x3ff10134;}wr(s,entry,256);wr(s,entry+4,1);flush(s);if mode==6{check(data(s,address+65536,4)==expected(1,0x1234,4),"prime the valid auxiliary line");}check(data(s,address,4)==expected(0,0x1234,4) && (rd(s,0x3ff003f0)&1)==1,"first invalid MMU lookup returnsselectedpage andsetsstatus");let at=address;let offset=0x1234;if mode==1{at=at+4;offset=offset+4;}if mode==2 || mode==6 || mode==7{at=at+32;offset=offset+32;}if mode==3 || mode==4 || mode==5{flush(s);}if mode==4{wr(s,0x3ff00044,0x28ee);}if mode==5{wr(s,0x3ff00044,0x28ee);wr(s,0x3ff00044,0x8ee);}if mode==6{check(data(s,address+65536,4)==expected(1,0x1234,4) && (rd(s,0x3ff003f0)&1)==1,"valid cachehit leaves invalid MMU result asserted");}if mode==7{check(data(s,address+65536+128,4)==expected(1,0x12b4,4) && !(rd(s,0x3ff003f0)&1),"fresh valid MMU lookup clears error");}
 let blocked=mode==2 || mode==3 || mode==5 || mode==6;wr(s,0x3ff00214,1);wr(s,0x3ff005a0,1<<21);check(se_cache_irq(s)==(mode!=4 && mode!=7) && ((xt_sr(c,226)&2)!=0)==(mode!=4 && mode!=7),"level-sensitive PRO MMU enable routes source68 through CPU matrix");store64(c+128,0x2000);xt_setreg(c,1,at);xt_setreg(c,4,0xaabbccdd);let run=alloc(4096);em_zero(run,4096);let result=se_run_slice(s,run,1000,1);if blocked{check(result==11 && !load64(c+160) && !load64(s+32) && load64(c+176)==0 && load64(c+128)==0x2000 && xt_reg(c,4)==0xaabbccdd && load64(c+192)==5 && load64(p+1632)==1,"blocked device load preserves PC,register,transaction andretirement");let ticks=load64(s+16);let i=0;while i<4{check(se_run_slice(s,run,1000,1)==11 && load64(c+176)==0 && load64(c+128)==0x2000 && xt_reg(c,4)==0xaabbccdd && load64(s+16)==ticks,"pollingblockedload neverretiresfabricateddata oradvancesCPUtime");i=i+1;}wr(s,0x3ff005a0,0);check(!se_cache_irq(s) && !(xt_sr(c,226)&2) && (rd(s,0x3ff003f0)&1)==1,"masking IRQ doesnotclear MMU error orcomplete blockedload");wr(s,0x3ff00044,0x28ee);check(se_run_slice(s,run,1000,1)==10 && load64(c+176)==1 && load64(c+128)==0x2003 && xt_reg(c,4)==expected(0,offset,4) && !load64(c+192) && !load64(p+1632),"host releasesheldclear andpendingload completesexactlyonce");check(se_run_slice(s,run,1000,1)==10 && load64(c+176)==1,"no duplicate completion afterblockedload resumes");}else{check(result==10 && load64(c+176)==1 && load64(c+128)==0x2003 && xt_reg(c,4)==expected(0,offset,4) && !load64(c+192),"cachehit/heldclear/freshvalidlookup allowsone CPU completion");check((rd(s,0x3ff003f0)&1)==(mode!=4),"second successful lookup retains level-sensitive status");}syscall(11,run,4096,0,0,0,0);close(s);mode=mode+1;}bus=bus+1;}return 0;}
fn widths(){let bus=0;while bus<2{cl_case=1000+bus;let s=setup();let c=load64(s);let p=se_cache(s);let address=0x3f401220;if bus{address=0x400d1220;}let width=1;while width<=4{let offset=0;while offset<32{check(data(s,address+offset,width)==expected(1,0x1220+offset,width),"alignedbyte/halfword/word returnsindependent NOR bytes");offset=offset+width;}width=width*2;}let fills=load64(p+1664);let original=data(s,address,4);store8(load64(p)+65536+0x1220,0);check(data(s,address,4)==original && load64(p+1664)==fills,"hits usecachedline bytes ratherthan live NOR alias");wr(s,0x3ff00040,0x20);check(data(s,address,4)==0xbad00bad,"globally disabled DATA returnsmeasured illegalfill");check(rd(s,0x3ff003fc)==(1<<(10+bus*4)),"only theaccessed bus disabledflag latches");wr(s,0x3ff005a0,1<<(15+bus*4));wr(s,0x3ff00214,1);check(!se_cache_irq(s) && !(xt_sr(c,226)&2),"disabled flag precedes propagated enable-edge IRQ");check(se_clock_idle_cycles(s,2)==0,"host-injected enable-edge IRQ propagation advances CPU cycles");check(se_cache_irq(s) && (xt_sr(c,226)&2),"disabled-data IRQ uses measured source68 enable bit");wr(s,0x3ff00040,0x28);check(data(s,address,4)==original && rd(s,0x3ff003fc)==(1<<(10+bus*4)),"global re-enable retains warmline andlatchedflag");wr(s,0x3ff005a0,0);check(!se_cache_irq(s) && !(xt_sr(c,226)&2),"EN0 masks disabled-data status");let mask=16;if bus{mask=1;}wr(s,0x3ff00044,0x8ee|mask);width=1;while width<=4{let offset=0;while offset<4{let fill=0;let i=0;while i<width{fill=fill|(((0xbad00bad>>(((offset+i)&3)*8))&255)<<(i*8));i=i+1;}check(data(s,address+offset,width)==fill,"maskedbus illegalfill followslittle-endian accesswidth");offset=offset+width;}width=width*2;}check(data(s,address,4)==0xbad00bad && !load64(c+160),"busmask yields datafill withoutgenericCPU fault");check(se_bus(s,address,4,1,0)== -13 && se_bus(s,address+1,4,0,0)== -22,"read-only cachedbus rejectsstore andmisaligned access");wr(s,0x3ff00044,0x8ee);let last=0x3f7ffffc;let lastentry=0x3ff100fc;if bus{last=0x403ffffc;lastentry=0x3ff101fc;}wr(s,lastentry,63);flush(s);check(data(s,last,4)==expected(63,65532,4),"lastvirtual/physical line staysinside bothboundedwindows");wr(s,lastentry,64);flush(s);check(se_bus(s,last,4,0,0)== -14 && !load64(c+160),"outofNOR translation returns anexplicitdeviceerror without a hostread");let other=xt_create();let peer=se_create(other,0);check(se_cache_attach(peer,cl_flash,4194304)==0 && !se_cache_irq(peer) && !load64(se_cache(peer)+1664),"second board has independent cache/error state");close(peer);close(s);bus=bus+1;}return 0;}
fn preempt_guards(){cl_case=3000;let s=setup();let c=load64(s);let p=se_cache(s);let address=0x3f401234;wr(s,0x3ff10000,256);flush(s);let run=alloc(4096);em_zero(run,4096);store64(c+128,0x2000);xt_setreg(c,1,address);xt_setreg(c,4,0x13579bdf);check(xt_run_slice(c,run,1000,1)==6 && load64(c+192)==5 && !load64(c+176),"GNU pending cacheload for devicepreemption guards");check(data(s,address,4)==expected(0,0x1234,4) && se_cache_mmu_error(p,0),"device lookup completed butCPU destination remainsuncommitted");let guard=0;while guard<8{cl_case=3000+guard;xt_wsr(c,227,128);xt_wsr(c,228,2);xt_wsr(c,230,0);wr(s,0x3ff00214,1);wr(s,0x3ff005a0,1<<21);let at=address;if guard==0{wr(s,0x3ff005a0,0);xt_interrupt(c,2);}if guard==1{xt_wsr(c,228,0);}if guard==2{xt_wsr(c,228,128);xt_wsr(c,226,128);}if guard==3{xt_wsr(c,230,16);}if guard==4{xt_wsr(c,230,1);}if guard==5{wr(s,0x3ff00214,6);xt_interrupt(c,2);}if guard==6{at=0x5000;}if guard==7{wr(s,0x3ff005a0,1<<15);xt_interrupt(c,2);}check(se_cache_preempt(s,at)==0 && load64(c+192)==5 && !load64(c+176) && load64(c+128)==0x2000 && xt_reg(c,4)==0x13579bdf,"only thecorrect cacheenable/CPUlevel/source/address maypreempt;foreign IRQs donot");guard=guard+1;}xt_wsr(c,227,128);xt_wsr(c,228,2);xt_wsr(c,230,0);wr(s,0x3ff00214,1);wr(s,0x3ff005a0,1<<21);let fills=load64(p+1664);check(se_cache_preempt(s,address)==0 && !load64(c+192) && !load64(c+176) && load64(c+128)==0x2000 && xt_reg(c,4)==0x13579bdf && se_cache_mmu_error(p,0) && load64(p+1664)==fills,"deliverablePRO MMU IRQ preemptsCPUcommit withoutundoing devicefill/status");close(s);s=setup();c=load64(s);store64(c+128,0x2000);xt_setreg(c,1,address);check(xt_run_slice(c,run,1000,1)==6,"valid MMU pendingload fixture");data(s,address,4);wr(s,0x3ff00214,1);wr(s,0x3ff005a0,1<<21);xt_wsr(c,228,2);xt_interrupt(c,2);check(se_cache_preempt(s,address)==0 && load64(c+192)==5 && !load64(c+176),"foreignIRQ cannotturn validMMU lookup into a cacheexception");close(s);syscall(11,run,4096,0,0,0,0);return 0;}
fn fetches(){let edge=0;while edge<2{cl_case=2000+edge;let first=31;let address=0x400d001f;if edge{first=65535;address=0x400dffff;}let j=0;while j<3{let page=1;let off=first+j;if off>=65536{page=2;off=off-65536;}store8(cl_flash+page*65536+off,load8(cl_gnu+3+j));store8(cl_flash+3*65536+off,load8(cl_gnu+6+j));j=j+1;}let s=setup();let c=load64(s);let p=se_cache(s);wr(s,0x3ff10138,2);flush(s);let run=alloc(4096);em_zero(run,4096);store64(c+128,address);xt_setreg(c,2,0xaabbccdd);let before=load64(p+1664);check(xt_step(c)==10 && !load64(c+176) && load64(c+128)==address && load64(load64(p+1648)+16)==address,"cold prefix requests one pre-retirement fetchfill");check(se_cache_preflight(s)==0 && !load64(c+288),"device services andacknowledges coldprefix");check(xt_step(c)==10 && !load64(c+176) && load64(c+128)==address && load64(load64(p+1648)+16)==address+1,"afterprefixfill onlythecoldtail requests preflight");check(se_cache_preflight(s)==0 && !load64(c+288),"device services andacknowledges coldtail");check(se_run_slice(s,run,1000,1)==10 && load64(c+176)==1 && load64(c+128)==address+3 && xt_reg(c,2)==0xffffffef && load64(p+1664)==before+2 && !load64(c+288) && !load64(c+296),"GNU instruction spanningcachelines/pages executes onlyafterboth32-byte fills");wr(s,0x3ff10134,3);if edge{wr(s,0x3ff10138,3);}store64(c+128,address);before=load64(p+1664);check(se_run_slice(s,run,1000,2)==10 && xt_reg(c,2)==0xffffffef && load64(p+1664)==before,"warmcachedfetch keepsbytes despite MMU rewrite");let fragment=0;while fragment<2{let congruent=((address+fragment)>>5)&511;data(s,0x3f400000+congruent*32,4);data(s,0x3f404000+congruent*32,4);fragment=fragment+1;}store64(c+128,address);check(se_run_slice(s,run,1000,3)==10 && xt_reg(c,2)==42 && load64(p+1664)==before+6,"conflictingDROMlines evict bothIROMfragments andforcefreshfetches");before=load64(p+1664);flush(s);store64(c+128,address);check(se_run_slice(s,run,1000,4)==10 && xt_reg(c,2)==42 && load64(p+1664)==before+2,"flush invalidates bothinstructionfragments andusesnew translation");wr(s,0x3ff10134,256);flush(s);store64(c+128,address);check(se_run_slice(s,run,1000,5)== -1 && load64(c+176)==4 && load64(c+128)==address,"unmeasured invalid instructionfetch neverdecodes guessedbytes");syscall(11,run,4096,0,0,0,0);close(s);edge=edge+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU instruction input");cl_gnu=h_read(load64(argv+8));check(h_file_size==9,"independent GNU load/two MOVI forms");cl_flash=alloc(4194304);let page=0;while page<64{let at=0;while at<65536{store8(cl_flash+page*65536+at,pattern(page,at));at=at+1;}page=page+1;}sequences();widths();preempt_guards();fetches();syscall(11,cl_flash,4194304,0,0,0,0);h_print(1,h_cat3("Cache lines: ",h_int(cl_checks)," checks passed\n"));return 0;}
