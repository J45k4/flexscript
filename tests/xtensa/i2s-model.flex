import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global ir=0;global iw=0;global ichecks=0;global ictx=0;global iram=0;
fn iv(n){return load64(ir+32+n*8);}
fn ix(n){return load64(iw+32+n*8);}
fn ck(ok,message){ichecks=ichecks+1;if !ok{h_print(2,h_cat3("I2S context ",h_int(ictx),h_cat3(" check ",h_int(ichecks),h_cat3(": ",message,"\n"))));syscall(60,1,0,0,0,0,0);}return 0;}
fn wr(s,address,value){let result=se_bus(s,address,4,1,value);if result<0{h_print(2,h_cat3("write address ",h_int(address),h_cat3(" result ",h_int(result),"\n")));}ck(result>=0,"MMIO write");return result;}
fn rd(s,address){let result=se_bus(s,address,4,0,0);ck(result>=0,"MMIO read");return result;}
fn tick(s,n){ck(se_advance(s,n)==0,"advance");return 0;}
fn put(address,value){em_put32(iram+address-0x3ffb0000,value);return 0;}
fn get(address){return em_u32(iram+address-0x3ffb0000);}
fn descriptor(address,buffer,size,used,next,eof,owner){put(address,size|(used<<12)|(eof*ix(26))|(owner*ix(25)));put(address+4,buffer);put(address+8,next);return 0;}
fn config(cpu,f){let s=se_create(cpu,0);let bus=load64(f);wr(s,iv(2),rd(s,iv(2))|iv(4+bus));wr(s,iv(3),iv(4+bus));wr(s,iv(3),0);let base=iv(bus);wr(s,base+iv(6),load64(f+48));wr(s,base+iv(10),load64(f+32));wr(s,base+iv(15),load64(f+64));wr(s,base+iv(16),load64(f+56));wr(s,base+iv(18),load64(f+24));wr(s,base+iv(19),load64(f+40));
 wr(s,ix(3),ix(7));wr(s,ix(4),ix(7));wr(s,ix(5),ix(7));wr(s,ix(6),ix(7));wr(s,ix(8),(1<<21)|(1<<22)|(1<<4));wr(s,iv(51)+21*4,iv(38+bus*2)|1024);wr(s,iv(51)+22*4,iv(42+bus*4)|1024);wr(s,iv(51)+4*4,iv(43+bus*4)|1024);wr(s,iv(50)+iv(39+bus*2)*4,25|128);wr(s,ix(2)+ix(bus)*4,1);return s;}
fn waveforms(cpu){let c=0;while c<18{ictx=100+c;let f=iw+32+32*8+c*512;let bus=load64(f);let base=iv(bus);let bits=load64(f+8);let bytes=load64(f+72);let points=load64(f+80);let num=load64(f+88);let den=load64(f+96);let s=config(cpu,f);let i=0;while i<bytes{store8(iram+8192+i,load8(f+128+i));i=i+1;}
 descriptor(0x3ffb1000,0x3ffb2000,bytes,bytes,0,1,1);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(8),iv(30));wr(s,base+iv(6),load64(f+48)|iv(26));let origin=load64(s+16);let point=0;
 while point<points{let expected=load8(f+152+point);let target=((point*2+1)*num+den-1)/den;let now=load64(s+16)-origin;if target>now{tick(s,target-now-1);ck(!se_gpio_level(s,22),"BCK low until rational deadline");ck(se_gpio_level(s,21)==(expected&1) && se_gpio_level(s,4)==((expected>>1)&1),"PCM DATA and WS stable before sampling edge");tick(s,1);}ck(se_gpio_level(s,22)==1,"BCK rising");ck(se_gpio_level(s,4)==((expected>>1)&1),"C Philips WS lead");ck(se_gpio_level(s,21)==(expected&1),"C serialized PCM data");if point+1<points{ck(!(rd(s,base+iv(7))&iv(30)),"no EOF before final serialized bit");}if point+1<points{let falling=((point*2+2)*num+den-1)/den;tick(s,falling-(load64(s+16)-origin));ck(!se_gpio_level(s,22),"BCK falling");}point=point+1;}
 ck((rd(s,base+iv(7))&iv(30)) && (xt_sr(cpu,226)&2),"EOF native IRQ after last PCM bit");ck(!(get(0x3ffb1000)&ix(25)),"descriptor owner returned");ck(!(rd(s,base+iv(21))&iv(34)),"wire completion waits trailing BCK edge");tick(s,(points*2*num+den-1)/den-(load64(s+16)-origin));ck(rd(s,base+iv(21))&iv(34),"TX idle after final falling edge");ck(rd(s,base+0x38)==0x3ffb1000,"EOF descriptor address");wr(s,base+iv(9),iv(30));ck(!(xt_sr(cpu,226)&2),"EOF W1TC deasserts CPU IRQ");se_close(s);c=c+1;}return 0;}
fn level(s,pin,value){let address=ix(11);if value{address=ix(10);}wr(s,address,1<<pin);return 0;}
fn receive(cpu){let c=0;while c<18{let f=iw+32+32*8+c*512;let bus=load64(f);let base=iv(bus);let bits=load64(f+8);let frame=bits/4;let size=frame*2;let external=0;while external<2{ictx=200+c*2+external;let s=config(cpu,f);ck(se_gpio_wire(s,21,25)==0,"real virtual jumper");let i=0;while i<32{store8(iram+12288+i,0x55);i=i+1;}descriptor(0x3ffb1100,0x3ffb3000,size,0,0,0,1);put(0x3ffb110c,0x6a5a4a3a);wr(s,base+iv(11),size/4);wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));wr(s,base+iv(8),iv(31));
 if external{wr(s,base+iv(6),load64(f+48)&~iv(35));wr(s,iv(51)+21*4,256|1024);wr(s,iv(51)+22*4,256|1024);wr(s,iv(51)+4*4,256|1024);wr(s,iv(50)+iv(44+bus*4)*4,22|128);wr(s,iv(50)+iv(45+bus*4)*4,4|128);level(s,22,0);level(s,4,0);level(s,21,0);wr(s,base+iv(6),(load64(f+48)&~iv(35))|iv(27));let point=0;while point<load64(f+80){let expected=load8(f+152+point);level(s,4,(expected>>1)&1);level(s,21,expected&1);tick(s,3);level(s,22,1);tick(s,3);level(s,22,0);point=point+1;}}
 else{let count=load64(f+72);i=0;while i<count{store8(iram+8192+i,load8(f+128+i));i=i+1;}descriptor(0x3ffb1000,0x3ffb2000,count,count,0,1,1);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(27));wr(s,base+iv(6),load64(f+48)|iv(27)|iv(26));let duration=(load64(f+80)*2*load64(f+88)+load64(f+96)-1)/load64(f+96);tick(s,duration+10);}
 ck((rd(s,base+iv(7))&iv(31)) && (xt_sr(cpu,226)&2),"RX EOF through real GPIO bits and native IRQ");ck((get(0x3ffb1100)&ix(25))==0 && (get(0x3ffb1100)&ix(26))!=0 && ((get(0x3ffb1100)>>12)&4095)==size,"RX owner,EOF and actual byte count");ck(rd(s,base+0x3c)==0x3ffb1100 && get(0x3ffb110c)==0x6a5a4a3a,"RX descriptor address and untouched padding");i=0;while i<size{ck(load8(iram+12288+i)==load8(f+128+frame+i),"C payload after first WS synchronization frame");i=i+1;}while i<32{ck(load8(iram+12288+i)==0x55,"RX buffer guard preserved");i=i+1;}wr(s,base+iv(9),iv(31));ck(!(xt_sr(cpu,226)&2),"RX W1TC IRQ deassertion");se_close(s);external=external+1;}c=c+1;}return 0;}
fn master_rx(cpu){let c=0;while c<18{ictx=300+c;let f=iw+32+32*8+c*512;let bus=load64(f);let base=iv(bus);let size=load64(f+8)/2;let s=config(cpu,f);ck(se_gpio_wire(s,21,25)==0,"RX-master data wire");wr(s,iv(51)+21*4,256|1024);wr(s,iv(51)+22*4,iv(44+bus*4)|1024);wr(s,iv(51)+4*4,iv(45+bus*4)|1024);descriptor(0x3ffb1100,0x3ffb3000,size,0,0,0,1);wr(s,base+iv(11),size/4);wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));let conf=load64(f+48)&~(iv(35)|iv(37));wr(s,base+iv(6),conf|iv(27));let origin=load64(s+16);let point=0;let num=load64(f+88);let den=load64(f+96);while point<load64(f+80){let value=load8(f+152+point);level(s,21,value&1);let target=((point*2+1)*num+den-1)/den;tick(s,target-(load64(s+16)-origin));ck(se_gpio_level(s,22)==1 && se_gpio_level(s,4)==((value>>1)&1),"RX-master rational BCK/WS clocks");let falling=((point*2+2)*num+den-1)/den;tick(s,falling-(load64(s+16)-origin));point=point+1;}ck(rd(s,base+iv(7))&iv(31),"RX-master EOF");let i=0;let frame=load64(f+8)/4;while i<size{ck(load8(iram+12288+i)==load8(f+128+frame+i),"RX-master C payload");i=i+1;}wr(s,base+iv(6),conf);se_close(s);c=c+1;}return 0;}
fn chains(cpu){let width=0;while width<2{ictx=400+width;let f=iw+32+32*8+(3+width*3)*512;let bits=load64(f+8);ck(bits==16+width*16,"selected C chain vector");let s=config(cpu,f);let bus=load64(f);let base=iv(bus);ck(se_gpio_wire(s,21,25)==0,"chain wire");let bytes=load64(f+72);let frame=bits/4;let i=0;while i<bytes{store8(iram+8192+i,load8(f+128+i));i=i+1;}i=0;while i<bytes/4{let next=0;if i+1<bytes/4{next=0x3ffb1010+i*16;}descriptor(0x3ffb1000+i*16,0x3ffb2000+i*4,4,4,next,1,1);i=i+1;}let size=bytes-frame;i=0;while i<size/4{let next=0;if i+1<size/4{next=0x3ffb1110+i*16;}descriptor(0x3ffb1100+i*16,0x3ffb3000+i*4,4,0,next,0,1);i=i+1;}wr(s,base+iv(11),size/4);wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(27)|iv(26));tick(s,1000000);
 i=0;while i<bytes/4{ck(!(get(0x3ffb1000+i*16)&ix(25)),"TX linked descriptors reclaimed");i=i+1;}i=0;while i<size/4{let value=get(0x3ffb1100+i*16);ck(!(value&ix(25)) && ((value>>12)&4095)==4,"RX linked descriptor counts");ck(!!(value&ix(26))==(i+1==size/4),"EOF marks only final RX descriptor");i=i+1;}i=0;while i<size{ck(load8(iram+12288+i)==load8(f+128+frame+i),"chain PCM preserves exact sample bytes");i=i+1;}ck(!(rd(s,base+iv(7))&(iv(32)|iv(33)|ix(12))) && (rd(s,base+iv(7))&iv(31)),"valid descriptor chains have no errors");se_close(s);width=width+1;}
 // RX packet EOF may finish a descriptor before its capacity is exhausted.
 ictx=420;let f=iw+32+32*8+3*512;let s=config(cpu,f);ck(se_gpio_wire(s,21,25)==0,"short RX packet wire");let base=iv(0);let i=0;while i<12{store8(iram+8192+i,load8(f+128+i));i=i+1;}while i<32{store8(iram+8192+i,0);i=i+1;}i=0;while i<24{store8(iram+12288+i,0x55);i=i+1;}descriptor(0x3ffb1000,0x3ffb2000,12,12,0,1,1);descriptor(0x3ffb1100,0x3ffb3000,8,0,0x3ffb1110,0,1);descriptor(0x3ffb1110,0x3ffb3008,8,0,0,0,1);wr(s,base+iv(11),1);wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(27)|iv(26));tick(s,1000000);ck(((get(0x3ffb1100)>>12)&4095)==4 && ((get(0x3ffb1110)>>12)&4095)==4,"packet EOF advances partial-capacity descriptors");i=0;while i<4{ck(load8(iram+12288+i)==load8(f+132+i) && load8(iram+12296+i)==load8(f+136+i),"partial RX descriptors receive successive frames");ck(load8(iram+12292+i)==0x55 && load8(iram+12300+i)==0x55,"unused RX capacity stays untouched");i=i+1;}se_close(s);return 0;}
// Two independently scheduled controllers: TX0 data, TX1 clock, RX0 slave.
// One bulk advance must preserve their shared timeline rather than run one
// whole transmitter before the other. No RMT activity supplies interleaving.
fn cross_controller(cpu){let width=0;while width<2{ictx=450+width;let f=iw+32+32*8+(3+width*3)*512;let s=config(cpu,f);let base=iv(0);let other=iv(1);wr(s,iv(2),rd(s,iv(2))|iv(5));let i=0;while i<6{let reg=iv(6);let value=load64(f+48);if i==1{reg=iv(10);value=load64(f+32);}if i==2{reg=iv(15);value=load64(f+64);}if i==3{reg=iv(16);value=load64(f+56);}if i==4{reg=iv(18);value=load64(f+24);}if i==5{reg=iv(19);value=load64(f+40);}wr(s,other+reg,value);i=i+1;}wr(s,iv(51)+22*4,iv(46)|1024);wr(s,iv(51)+4*4,iv(47)|1024);wr(s,iv(50)+iv(44)*4,22|128);wr(s,iv(50)+iv(45)*4,4|128);ck(se_gpio_wire(s,21,25)==0,"cross-controller data wire");let bytes=load64(f+72);let frame=load64(f+8)/4;let size=bytes-frame;i=0;while i<bytes{store8(iram+8192+i,load8(f+128+i));store8(iram+16384+i,0);i=i+1;}i=0;while i<size{store8(iram+12288+i,0x55);i=i+1;}descriptor(0x3ffb1000,0x3ffb2000,bytes,bytes,0,1,1);descriptor(0x3ffb1200,0x3ffb4000,bytes,bytes,0,1,1);descriptor(0x3ffb1100,0x3ffb3000,size,0,0,0,1);wr(s,base+iv(11),size/4);wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,other+iv(13),(0x3ffb1200&0xfffff)|iv(28));let conf=load64(f+48)&~iv(35);wr(s,base+iv(6),conf|iv(27));wr(s,base+iv(6),conf|iv(27)|iv(26));wr(s,other+iv(6),load64(f+48)|iv(26));tick(s,1000000);ck(rd(s,base+iv(7))&iv(31),"cross-controller RX completes");i=0;while i<size{ck(load8(iram+12288+i)==load8(f+128+frame+i),"one bulk advance preserves independent device order");i=i+1;}se_close(s);width=width+1;}return 0;}
fn external_setup(s,f){let bus=load64(f);let base=iv(bus);wr(s,iv(51)+21*4,256|1024);wr(s,iv(51)+22*4,256|1024);wr(s,iv(51)+4*4,256|1024);wr(s,iv(50)+iv(44+bus*4)*4,22|128);wr(s,iv(50)+iv(45+bus*4)*4,4|128);ck(se_gpio_wire(s,21,25)==0,"external DMA-error data wire");level(s,22,0);level(s,4,0);level(s,21,0);wr(s,base+iv(6),(load64(f+48)&~iv(35))|iv(27));return 0;}
fn external_send(s,f){let point=0;while point<load64(f+80){let value=load8(f+152+point);level(s,4,(value>>1)&1);level(s,21,value&1);level(s,22,1);tick(s,3);level(s,22,0);tick(s,3);point=point+1;}return 0;}
fn faults(cpu){let bus=0;while bus<2{let f=iw+32+32*8+(bus*9+3)*512;let base=iv(bus);let direction=0;while direction<2{let fault=0;while fault<8{ictx=500+bus*32+direction*8+fault;let s=config(cpu,f);let desc=0x3ffb1000;let data=0x3ffb2000;let size=4;let used=0;if direction{used=4;}let owner=1;let next=0;if !fault{owner=0;}if fault==1{desc=0x3ffe0000;}if fault==2{data=data+1;}if fault==3{data=0x3ffe0000;}if fault==4{size=0;used=0;}if fault==5{desc=desc+2;}if fault==6{next=0x3ffe0000;}let storage=desc;if fault==1 || fault==5{storage=0x3ffb1000;}descriptor(storage,data,size,used,next,1,owner);put(0x3ffb2000,0x91234567);let region=xt_load_region(cpu,0x3ffb1000,12);if fault==7{store64(region+24,1);}let error=iv(33-direction);wr(s,base+iv(8),error);wr(s,base+iv(11),2);wr(s,base+iv(14-direction),(desc&0xfffff)|iv(28));
 if direction{wr(s,base+iv(6),load64(f+48)|iv(26));tick(s,1000000);}else{external_setup(s,f);external_send(s,f);}ck((rd(s,base+iv(7))&error) && (xt_sr(cpu,226)&2),"invalid DMA becomes descriptor-error IRQ");ck(!load64(cpu+160) && !load64(s+32),"DMA address/owner errors do not fault CPU");if fault==7{store64(region+24,3);}wr(s,base+iv(9),error);ck(!(xt_sr(cpu,226)&2),"DMA error W1TC deasserts IRQ");se_close(s);fault=fault+1;}direction=direction+1;}bus=bus+1;}return 0;}
fn flags(cpu){let f=iw+32+32*8+3*512;let base=iv(0);let auto=0;while auto<2{ictx=600+auto;let s=config(cpu,f);let count=load64(f+72);let i=0;while i<count{store8(iram+8192+i,load8(f+128+i));i=i+1;}descriptor(0x3ffb1000,0x3ffb2000,count,count,0,1,1);let control=load64(f+64);if !auto{control=control&~ix(18);}wr(s,base+iv(15),control);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(26));tick(s,1000000);ck(!!(get(0x3ffb1000)&ix(25))==!auto,"TX automatic ownership writeback control");ck(rd(s,base+iv(7))&iv(30),"ownership-independent EOF completion");ck(!(xt_sr(cpu,226)&2),"completion masked until enabled");wr(s,base+iv(8),iv(30));ck(xt_sr(cpu,226)&2,"enable pre-existing EOF IRQ");wr(s,base+iv(9),iv(30));ck(!(xt_sr(cpu,226)&2),"clear enabled EOF IRQ");se_close(s);auto=auto+1;}
 ictx=610;let s=config(cpu,f);descriptor(0x3ffb1000,0x3ffb2000,12,12,0,1,0);wr(s,base+iv(15),load64(f+64)&~ix(19));wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(26));tick(s,1000000);ck((rd(s,base+iv(7))&iv(30)) && !(rd(s,base+iv(7))&iv(32)),"disabled ownership check accepts CPU-owned descriptor");se_close(s);
 ictx=611;s=config(cpu,f);descriptor(0x3ffb1000,0x3ffb2000,12,12,0,1,1);wr(s,base+iv(15),load64(f+64)&~ix(20));wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(26));let first=load64(f+88)/load64(f+96);tick(s,first);ck((rd(s,base+iv(7))&iv(30))==0,"early EOF waits for last DMA word");let early=((2*64+2)*load64(f+88)+load64(f+96)-1)/load64(f+96);tick(s,early-first);ck((rd(s,base+iv(7))&iv(30)) && !(rd(s,base+iv(21))&iv(34)),"DMA-mode EOF precedes wire idle");tick(s,1000000);ck(rd(s,base+iv(7))&iv(30),"FIFO-mode EOF still completes");se_close(s);return 0;}
fn clocks_reset(cpu){let kind=0;while kind<2{ictx=700+kind;let f=iw+32+32*8+4*512;let base=iv(0);let s=config(cpu,f);let bytes=load64(f+72);let i=0;while i<bytes{store8(iram+8192+i,load8(f+128+i));i=i+1;}descriptor(0x3ffb1000,0x3ffb2000,bytes,bytes,0,1,1);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(6),load64(f+48)|iv(26));let half=(load64(f+88)+load64(f+96)-1)/load64(f+96);let elapsed=half/2;tick(s,elapsed);let clock=iv(2);let mask=iv(4);if kind{clock=base+iv(18);mask=1<<20;}let original=rd(s,clock);wr(s,clock,original&~mask);tick(s,1000000);ck(!se_gpio_level(s,22),"gated clock preserves pending rational edge");if kind{ck(!(rd(s,base+iv(7))&iv(30)),"core-gated engine cannot finish");}else{ck(se_bus(s,base+iv(7),4,0,0)== -5,"DPORT-gated register bus is unavailable");}wr(s,clock,original);tick(s,half-elapsed-1);ck(!se_gpio_level(s,22),"ungate cannot produce an early edge");tick(s,1);ck(se_gpio_level(s,22)==1,"ungate resumes exact partial half-period");tick(s,1000000);ck(rd(s,base+iv(7))&iv(30),"ungated PCM completes");se_close(s);kind=kind+1;}
 ictx=710;let f=iw+32+32*8+3*512;let base=iv(0);let s=config(cpu,f);descriptor(0x3ffb1000,0x3ffb2000,12,12,0,1,1);descriptor(0x3ffb1100,0x3ffb3000,8,0,0,0,1);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));wr(s,base+iv(14),(0x3ffb1100&0xfffff)|iv(28));wr(s,base+iv(15),load64(f+64)|iv(24));wr(s,base+iv(15),load64(f+64));ck((rd(s,base+iv(13))&ix(23)) && !(rd(s,base+iv(14))&ix(24)),"out-DMA reset leaves in-DMA armed");ck((get(0x3ffb1000)&ix(25)) && (get(0x3ffb1100)&ix(25)),"hardware reset does not forge ownership writeback");wr(s,base+iv(15),load64(f+64)|iv(25));wr(s,base+iv(15),load64(f+64));ck(rd(s,base+iv(14))&ix(24),"in-DMA reset uses distinct reset bit");wr(s,iv(3),iv(4));wr(s,iv(3),0);ck(rd(s,base+iv(6))==0 && rd(s,base+iv(8))==0 && rd(s,base+iv(16))==0x88,"DPORT resets core, IRQ enable and PCM bypass defaults");ck(rd(s,base+iv(10))==0x1820 && rd(s,base+iv(18))==4,"DPORT restores FIFO/divider defaults");ck(rd(s,base+iv(7))==0x2a,"reset clears latched DMA IRQs");se_close(s);return 0;}
fn unsupported(cpu){ictx=800;let f=iw+32+32*8+3*512;let s=config(cpu,f);let base=iv(0);ck(se_bus(s,base,4,0,0)== -95 && se_bus(s,base+4,4,1,1)== -95,"unsupported CPU FIFO ports fail explicitly");ck(se_bus(s,base+iv(8),4,1,2)== -95,"unsupported FIFO interrupt modes fail explicitly");ck(se_bus(s,base+iv(7),4,1,0)== -13 && se_bus(s,base+iv(21),4,1,0)== -13,"IRQ/state registers read-only");ck(se_bus(s,base+iv(6),2,0,0)== -22,"I2S registers require32-bit alignment/width");ck(se_bus(s,base+0xc0,4,0,0)== -95,"undefined I2S registers rejected");ck(rd(s,0x6000f000+iv(16))==rd(s,base+iv(16)),"original APB register alias");wr(s,0x6000f000+iv(9),0xffffffff);ck((rd(s,ix(29))&ix(30))==ix(31),"explicit80MHz PLL board profile");wr(s,ix(29),0);ck((rd(s,ix(29))&ix(30))==0 && !se_clock_audio(s),"idle I2S accepts modeled XTAL transition and loses PLL source");ck(se_bus(s,ix(29),4,1,2<<27)== -95,"unsupported RC system clock rejected");se_close(s);
 let mode=0;while mode<8{ictx=810+mode;s=config(cpu,f);descriptor(0x3ffb1000,0x3ffb2000,12,12,0,1,1);wr(s,base+iv(13),(0x3ffb1000&0xfffff)|iv(28));let conf=load64(f+48);if mode==0{conf=conf|iv(36);}if mode==1{conf=conf|(1<<8);}if mode==2{conf=conf|(1<<14);}if mode==3{wr(s,base+iv(16),load64(f+56)&~8);}if mode==4{wr(s,base+iv(17),1);}if mode==5{wr(s,base+iv(20),1);}if mode==6{wr(s,base+0x1c,1);}if mode==7{wr(s,base+iv(18),load64(f+24)|(1<<21));}ck(se_bus(s,base+iv(6),4,1,conf|iv(26))== -95,"unsupported audio/clock mode fails explicitly");se_close(s);mode=mode+1;}
 s=se_create(cpu,9);ck(se_bus(s,0x6000f008,4,0,0)== -95,"S3 I2S is not silently mapped as original chip");se_close(s);return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==3,"C register/wave and target-descriptor reference arguments");ir=h_read(load64(argv+8));ck(h_file_size==19168 && load64(ir)==0x493253444d410001,"independent reference shape");iw=ir+9664;ck(load64(iw)==0x4932535749524501 && load64(iw+8)==32 && load64(iw+16)==18 && load64(iw+24)==512,"wire vector header");let abi=h_read(load64(argv+16));ck(h_file_size==352 && em_u32(abi)==12 && em_u32(abi+4)==4 && em_u32(abi+8)==8,"real Xtensa descriptor ABI");let cpu=xt_create();iram=xt_map(cpu,0x3ffb0000,196608,3);ck(iram>0,"mapped guest SRAM");waveforms(cpu);receive(cpu);master_rx(cpu);chains(cpu);cross_controller(cpu);faults(cpu);flags(cpu);clocks_reset(cpu);unsupported(cpu);xt_close(cpu);h_print(1,h_cat3("I2S model: ",h_int(ichecks)," checks passed\n"));return 0;}
