// Functional DPORT MMU/cache contract only. Illegal-access IRQ details,
// other page sizes/buses and SPI/NOR command execution remain separate gates.
import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global ca_ref=0;global ca_checks=0;global ca_case=0;
fn check(ok,message){ca_checks=ca_checks+1;if !ok{h_print(2,h_cat3("Cache case ",h_int(ca_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn v(i){return load64(ca_ref+i*8);}
fn wr(s,a,x){check(se_bus(s,a,4,1,x)>=0,"cache register write");return 0;}
fn rd(s,a){let n=se_bus(s,a,4,0,0);check(n>=0,"cache register read");return n;}
fn clear(c){store64(c+160,0);store64(c+168,0);return 0;}
fn byte(page,at){return ((page*53+at*7)^0xd3)&255;}
fn check_page(c,virtual,page){let i=0;while i<65536{check(xt_read(c,virtual+i,1)==byte(page,i) && !load64(c+160),"cached page bytes equal independent physical pattern");i=i+257;}check(xt_read(c,virtual+65535,1)==byte(page,65535),"last page byte");return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"SDK metadata argument");ca_ref=h_read(load64(argv+8));check(h_file_size==136 && v(0)==0x43414348454d0001,"independent cache C metadata");let flash=alloc(4194304);let page=0;while page<64{let i=0;while i<65536{store8(flash+page*65536+i,byte(page,i));i=i+1;}page=page+1;}let cpu=xt_create();let s=se_create(cpu,0);check(se_cache_attach(s,flash,4194304)==0 && load64(cpu+144)==2,"explicit immutable NOR attachment creates two gated views");let p=se_cache(s);wr(s,0x3ff43050,1);check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"cache starts disabled");clear(cpu);
 let bank=0;while bank<2{let i=0;while i<128{ca_case=bank*128+i;let value=(i*131+bank*17)^0xa5a5;wr(s,v(5+bank)+i*4,value);check(rd(s,v(5+bank)+i*4)==(value&511),"SDK MMU entry mask and independent banks");i=i+1;}bank=bank+1;}
 check(rd(s,v(5))==(0xa5a5&511) && rd(s,v(6))==((0xa5a5^17)&511),"PRO and APP MMU storage remains independent");wr(s,v(5),1);wr(s,v(5)+4,2);wr(s,v(5)+64*4+13*4,2);wr(s,v(5)+64*4+14*4,3);wr(s,v(2),rd(s,v(2))&~(v(12)|v(13)));check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"unmasking a bus cannot bypass global cache disable");clear(cpu);wr(s,v(1),v(9));check_page(cpu,0x3f400000,1);check_page(cpu,0x3f410000,2);check_page(cpu,0x400d0000,2);check_page(cpu,0x400e0000,3);wr(s,v(2),rd(s,v(2))|v(13));check(xt_read(cpu,0x400d0000,1)==0 && load64(cpu+160)== -5,"IROM bus gate independent of DROM");clear(cpu);check(xt_read(cpu,0x3f400000,1)==byte(1,0),"IROM gate preserves DROM visibility");wr(s,v(2),rd(s,v(2))&~v(13));check_page(cpu,0x400d0000,2);
 // MMU writes are not cache invalidation. Flush latches the new translation.
 wr(s,v(5),3);check_page(cpu,0x3f400000,1);wr(s,v(1),rd(s,v(1))|v(10));check((rd(s,v(1))&v(11)) && !(rd(s,v(1))&v(10)),"flush request self-clears and signals done");check_page(cpu,0x3f400000,3);
 let original=byte(3,0);store8(load64(p)+3*65536,0xfe);check(xt_read(cpu,0x3f400000,1)==original,"cached bytes remain stable until flush");wr(s,v(1),rd(s,v(1))|v(10));check(xt_read(cpu,0x3f400000,1)==0xfe,"flush observes NOR updates");
 // Enabling DROM independently must not refresh an already-enabled IROM.
 wr(s,v(2),rd(s,v(2))|v(12));check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"DROM bus gate");clear(cpu);wr(s,v(5),4);store8(load64(p)+2*65536,0xcd);wr(s,v(2),rd(s,v(2))&~v(12));check_page(cpu,0x3f400000,4);check(xt_read(cpu,0x400d0000,1)==byte(2,0),"enabling DROM preserves IROM cached contents");wr(s,v(1),rd(s,v(1))|v(10));check(xt_read(cpu,0x400d0000,1)==0xcd,"explicit flush updates both buses");
 // Invalidate a data entry. This prototype reports an explicit CPU fault;
 // it does not claim silicon's illegal-read fill values/IRQ behavior.
 wr(s,v(5)+4,63);wr(s,v(1),rd(s,v(1))|v(10));check_page(cpu,0x3f410000,63);wr(s,v(5),v(7));wr(s,v(1),rd(s,v(1))|v(10));check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -14,"invalid MMU entry exposes no host memory");clear(cpu);wr(s,v(5),64);wr(s,v(1),rd(s,v(1))|v(10));check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -14,"out-of-NOR physical page is bounded");clear(cpu);
 let cfg=rd(s,v(2));check(se_bus(s,v(2),4,1,cfg|512)== -95 && rd(s,v(2))==cfg,"unsupported page mode is rejected atomically");check(se_bus(s,v(2),4,1,cfg|v(16))== -95 && rd(s,v(2))==cfg,"unsupported MMU powerdown is rejected atomically");check(rd(s,0x3ff003f0)==v(14) && rd(s,0x3ff00418)==v(14),"functional idle state on both cores");let pro_ctrl=rd(s,v(1));let pro_cfg=rd(s,v(2));wr(s,v(3),v(9));wr(s,v(4),0x8ee);check(rd(s,v(1))==pro_ctrl && rd(s,v(2))==pro_cfg,"APP controls have separate storage");check(rd(s,v(3))==v(9) && rd(s,v(4))==0x8ee,"APP register readback");
 se_close(s);check(load64(cpu+144)==0,"closing board detaches both page views before freeing backing memory");clear(cpu);check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -14,"closed cache has no dangling CPU translation");xt_close(cpu);
 cpu=xt_create();s=se_create(cpu,0);let before=load64(cpu+144);check(se_cache_attach(s,flash,65535)== -22 && se_cache_attach(s,flash,3*65536)== -22 && se_cache_attach(s,0,4194304)== -22 && load64(cpu+144)==before,"invalid NOR sizes/pointers leave mappings untouched");check(xt_map(cpu,0x400d0000,4096,5)>0,"collision map fixture");check(se_cache_attach(s,flash,4194304)== -22 && !se_cache(s) && load64(cpu+144)==1,"attach rejects existing-region collision");se_close(s);xt_close(cpu);cpu=xt_create();s=se_create(cpu,9);check(se_cache_attach(s,flash,4194304)== -22 && !load64(cpu+144),"S3 cache profile is explicitly unsupported");se_close(s);xt_close(cpu);syscall(11,flash,4194304,0,0,0,0);h_print(1,h_cat3("Cache model: ",h_int(ca_checks)," checks passed\n"));return 0;}
