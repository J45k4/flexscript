// CPU data routing uses GNU bytes andthe ordinary deferred MMIO protocol.
import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global pr_code=0;global pr_checks=0;global pr_case=0;
fn check(ok,message){pr_checks=pr_checks+1;if !ok{h_print(2,h_cat3("Routed page case ",h_int(pr_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c){store64(c+160,0);store64(c+168,0);return 0;}
fn response(run,value){store64(run+40,value);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU instruction input required");pr_code=h_read(load64(argv+8));check(h_file_size==25 && em_u32(pr_code)==0xfedcba98,"GNU fixture shape/literal");let c=xt_create();let backing=alloc(8192);em_copy(backing,pr_code,25);let pages=alloc(16);store64(pages,backing);store64(pages+8,backing+4096);let gate=alloc(8);store64(gate,1);let d=xt_map_pages(c,0x10000000,8192,5,pages,gate,12);let normal=xt_map(c,0x2000,4096,5);em_copy(normal,pr_code+7,3);let run=alloc(4096);check(d>0 && normal>0,"paged code/data andordinary code fixtures");check(xt_pages_route_reads(c,0x10000000,-1)== -22 && xt_pages_route_reads(c,0x10000000,2)== -22 && xt_pages_route_reads(c,0x2000,1)== -22 && xt_pages_route_reads(c,0xdead0000,1)== -22 && !load64(d+64),"invalid routing policies leave the existing map unchanged");check(xt_pages_route_reads(c,0x10000000,1)==0 && load64(d+64)==1,"explicit per-region CPU data route");check(xt_read(c,0x10000000,4)==0xfedcba98 && !load64(c+160),"host inspection retains the original translated bytes");let other=xt_create();check(xt_map_pages(other,0x10000000,8192,5,pages,gate,12)>0 && xt_map(other,0x2000,4096,5)>0,"second CPU has independent routing policy");let other_code=xt_pointer(other,0x2000,3,1);em_copy(other_code,pr_code+7,3);store64(other+128,0x2000);xt_setreg(other,1,0x10000000);let other_run=alloc(4096);check(xt_run_slice(other,other_run,1000,1)==10 && xt_reg(other,4)==0xfedcba98 && !load64(other+192),"routing one CPU never redirects anotherCPU memory");xt_close(other);syscall(11,other_run,4096,0,0,0,0);xt_setreg(c,1,0x10000000);let i=0;while i<5{pr_case=i;store64(c+128,0x10000004+i*3);let retired=load64(c+176);let before=xt_reg(c,4+i);check(xt_run_slice(c,run,1000,retired+1)==6 && !load64(c+160) && load64(c+176)==retired && load64(c+128)==0x10000004+i*3,"GNU data operation exits before retirement andkeeps its faulting PC");let address=0x10000000;let width=4;let reg=8;let value=0x87654321;let expected=value;if i==1{reg=4;value=0x89abcdef;expected=value;}if i==2{address=address+1;width=1;reg=5;value=0xe5;expected=value;}if i>=3{address=address+2;width=2;reg=6;value=0xfedc;expected=value;if i==4{reg=7;expected=0xfffffedc;}}check(load64(run+32)==address && em_u32(run+48)==width && !load8(run+52) && load64(c+192)==reg+1,"L32R/byte/halfword/sign/word use ordinary MMIO addresses andwidths");check(xt_pages_route_reads(c,0x10000000,0)== -16 && load64(d+64)==1,"pending device reply cannot be bypassed through routing reconfiguration");response(run,value);check(xt_run_slice(c,run,1000,retired+1)==10 && load64(c+176)==retired+1 && xt_reg(c,reg)==expected && !load64(c+192),"deferred reply has correct width/sign andcompletes exactly once");i=i+1;}
 pr_case=10;store64(c+128,0x10000016);let retired=load64(c+176);check(xt_run_slice(c,run,1000,retired+1)==10 && xt_reg(c,2)==0xffffffef && load64(c+176)==retired+1,"routed paged region still fetches real GNU instructions");store64(c+128,0x10000013);retired=load64(c+176);check(xt_run_slice(c,run,1000,retired+1)== -1 && load64(c+160)== -13 && load64(c+176)==retired && !load64(c+192),"read-only store fails before device routing");clear(c);
 let state=0;while state<2{pr_case=20+state;store64(gate,1-state);store64(pages,backing);if !state{store64(pages,0);}store64(c+128,0x2000);xt_setreg(c,1,0x10000000);retired=load64(c+176);check(xt_run_slice(c,run,1000,retired+1)==6 && !load64(c+160) && load64(c+176)==retired,"CPU device route precedes disabled-gate/missing-page translation");response(run,0x12345678+state);check(xt_run_slice(c,run,1000,retired+1)==10 && xt_reg(c,4)==0x12345678+state,"device controls a gated/unmapped data reply rather thanexposing a host pointer");check(xt_read(c,0x10000000,1)==0 && load64(c+160)==(-14+state*9),"host inspection retains strict missing-page andgate faults");clear(c);state=state+1;}
 store64(gate,1);store64(pages,backing);pr_case=30;check(!xt_pointer_mode(c,0x10001fff,2,1,1) && load64(c+160)== -14 && load64(c+168)==0x10001fff,"region bounds precede routed device access");clear(c);xt_setreg(c,1,0x10000001);store64(c+128,0x2000);retired=load64(c+176);check(xt_run_slice(c,run,1000,retired+1)== -1 && load64(c+160)== -14 && load64(c+176)==retired && !load64(c+192),"CPU alignment checks precede routing");clear(c);check(xt_pages_route_reads(c,0x10000000,0)==0 && !load64(d+64),"route may be removed after device completion");store64(c+128,0x2000);xt_setreg(c,1,0x10000000);check(xt_run_slice(c,run,1000,retired+1)==10 && xt_reg(c,4)==0xfedcba98 && !load64(c+192),"removing route restores direct CPU translation");
 let event=alloc(64);let attrs=alloc(16);store64(attrs,1);check(xt_pages_observe(c,0x10000000,attrs,event,-1,0)==0,"independent observer may coexist with routing policy");xt_read(c,0x10000000,1);check(xt_pages_route_reads(c,0x10000000,1)== -16,"pending observation must be acknowledged before routing changes");xt_pages_ack(c,0x10000000);check(xt_pages_route_reads(c,0x10000000,1)==0 && xt_pages_unobserve(c,0x10000000)==0 && load64(d+64)==1,"removing anobserver preserves the region-owned data route");check(xt_unmap_pages(c,0x10000000)==0 && xt_pages_route_reads(c,0x10000000,1)== -22,"unmapping removes the routing policy withits region");clear(c);check(xt_read(c,0x10000000,1)==0 && load64(c+160)== -14 && load8(backing)==0x98,"detached host view remains strict andcaller backing stays live");xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,gate,8,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,attrs,16,0,0,0,0);syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("Routed CPU pages: ",h_int(pr_checks)," checks passed\n"));return 0;}
