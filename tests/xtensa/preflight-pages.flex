// GNU instruction fetch is suspended beforedecode whiledevice units arecold.
import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global pf_code=0;global pf_checks=0;global pf_case=0;
fn check(ok,message){pf_checks=pf_checks+1;if !ok{h_print(2,h_cat3("Preflight page case ",h_int(pf_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c){store64(c+160,0);store64(c+168,0);return 0;}
fn pattern(at){return ((at*17+(at>>12)*43)^0xa3)&255;}
fn units(){let c=xt_create();let backing=alloc(8192);let pages=alloc(16);store64(pages,backing+4096);store64(pages+8,backing);let attrs=alloc(8192);let event=alloc(64);let i=0;while i<8192{store8(backing+i,pattern(i));i=i+1;}check(xt_map_pages(c,0x10000000,8192,1,pages,0,12)>0,"large translation pages withsmaller notification units");let shift=3;while shift<=12{let count=8192>>shift;i=0;while i<count{store64(attrs+i*8,1<<(i&7));i=i+1;}check(xt_pages_observe_units(c,0x10000000,shift,attrs,event,-1,-1,0)==0,"all8..4096-byte metadata granularities");let boundary=1;while boundary<count && boundary<=3{let offset= -7;while offset<=7{let n=1;while n<=8{pf_case=shift*10000+boundary*1000+(offset+7)*8+n;let address=boundary*(1<<shift)+offset;let expected=0;let j=0;while j<n{let at=address+j;let frame=1-(at>>12);let physical=frame*4096+(at&4095);expected=expected|(pattern(physical)<<(j*8));j=j+1;}xt_pages_ack(c,0x10000000);let seq=load64(event+32);let first=address>>shift;let last=(address+n-1)>>shift;check(xt_read(c,0x10000000+address,n)==expected && !load64(c+160),"fine-grained observation keeps independently mapped byte values");check(load64(event+8)==(1<<(last&7)) && load64(event+48)==((1<<(first&7))|(1<<(last&7))),"bounded summary spans notification units independently oftranslation pages");check(load64(event+32)==seq+1+(first!=last) && load64(event+16)==0x10000000+(first==last)*address+(first!=last)*(last<<shift),"unit boundaries report precise lastaddress andevent count");n=n+1;}offset=offset+1;}boundary=boundary+1;}xt_pages_ack(c,0x10000000);shift=shift+1;}xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,attrs,8192,0,0,0,0);syscall(11,event,64,0,0,0,0);return 0;}
fn instruction(){pf_case=500000;let c=xt_create();let backing=alloc(8192);let pages=alloc(16);store64(pages,backing+4096);store64(pages+8,backing);let attrs=alloc(4096);let event=alloc(64);let gate=alloc(8);store64(gate,1);let d=xt_map_pages(c,0x10000000,8192,5,pages,gate,12);let run=alloc(4096);check(d>0 && xt_pages_observe_units(c,0x10000000,5,attrs,event,-1,1,7)==0,"32-byte fetch-only preflight units");store64(attrs,1);store64(attrs+8,1);em_copy(backing+4096+31,pf_code+22,3);xt_setreg(c,2,0x1234);store64(c+128,0x1000001f);store64(c+216,0x556677);xt_read(c,0x10000020,1);check(!load64(event) && !load64(c+288) && !load64(c+296),"host DATA inspection doesnottriggerfetch-only metadata");check(xt_step(c)==10 && !load64(c+176) && load64(c+128)==0x1000001f && xt_reg(c,2)==0x1234 && load64(c+216)==0x556677,"firstcoldprefix yields beforedecode orretirement");check(load64(event)==2 && load64(event+16)==0x1000001f && load64(event+32)==1 && !load64(c+296),"prefix preflight exposes its own missingunit andconsumes transient request");check(xt_run_slice(c,run,1000,1)==10 && !load64(c+176) && load64(event+32)==1,"unacknowledged prefix event cannot execute orduplicate");store64(attrs,0);xt_pages_ack(c,0x10000000);check(xt_step(c)==10 && !load64(c+176) && xt_reg(c,2)==0x1234 && load64(c+216)==0x556677,"coldtail inanotherunit also yields beforedecode");check(load64(event+16)==0x10000020 && load64(event+32)==2,"instruction tail preflight usesunit boundary ratherthantranslation-page index");store64(attrs+8,0);xt_pages_ack(c,0x10000000);check(xt_step(c)==0 && load64(c+176)==1 && load64(c+128)==0x10000022 && xt_reg(c,2)==0xffffffef && !load64(event) && !load64(c+288),"GNU instruction executes once afterboth unitsarefilled");store64(c+128,0x1000001f);check(xt_step(c)==0 && load64(c+176)==2 && load64(event+32)==2 && !load64(c+288),"warmzero metadata producesnoadditional event");
 check(xt_pages_observe_units(c,0x10000000,2,attrs,event,-1,1,7)== -22 && xt_pages_observe_units(c,0x10000000,13,attrs,event,-1,1,7)== -22 && xt_pages_observe_units(c,0x10000000,5,attrs,event,-1,1,8)== -22 && load64(d+72)==5 && load64(d+80)==7,"invalid granules/options leave livepolicy unchanged");check(xt_pages_observe_units(c,0x10000000,5,attrs,attrs+1024,-1,1,7)== -22,"event record cannot alias far metadata cells");check(xt_map_pages(c,0x30000000,8192,5,pages,gate,12)>0 && xt_pages_observe_units(c,0x30000000,12,0,attrs+1024,-1,0,0)== -22,"other regions retain fullfine-grained metadata ownership");let fresh=alloc(4096);check(xt_pages_observe_units(c,0x30000000,5,fresh,fresh+1024,-1,1,7)== -22,"new metadata cannot overlap its own event beforeattachment");syscall(11,fresh,4096,0,0,0,0);
 store64(attrs+127*8,1);store64(attrs+128*8,1);store8(backing+8191,load8(pf_code+22));store8(backing,load8(pf_code+23));store8(backing+1,load8(pf_code+24));check(xt_pages_observe_units(c,0x10000000,5,attrs,event,-1,1,7)==0,"cross-translation-page preflight fixture");store64(c+128,0x10000fff);let retired=load64(c+176);check(xt_step(c)==10 && load64(c+176)==retired && load64(event+16)==0x10000fff,"firstfragment preflight acrossunrelated backingpages");store64(attrs+127*8,0);xt_pages_ack(c,0x10000000);check(xt_step(c)==10 && load64(c+176)==retired && load64(event+16)==0x10001000,"secondfragment preflight validates another backingpage");store64(attrs+128*8,0);xt_pages_ack(c,0x10000000);check(xt_step(c)==0 && load64(c+176)==retired+1 && load64(c+128)==0x10001002,"split instruction decodes onlyafterboth fragment fills");
 store64(attrs,1);check(xt_pointer(c,0x1000001f,1,5)>0 && load64(c+296) && load64(c+288),"explicit execute-view query canrequestdevice preflight");store64(attrs,0);xt_pages_ack(c,0x10000000);check(!load64(c+288) && !load64(c+296),"acknowledgement clears atransient preflight requested outside astep");store64(c+128,0x1000001f);retired=load64(c+176);check(xt_step(c)==0 && load64(c+176)==retired+1,"no stale preflight yield afterexplicit query acknowledgement");
 em_copy(backing+4096+0x300,pf_code+22,3);store64(attrs+24*8,1);store64(c+128,0x1000001f);xt_wsr(c,231,0x10000000);xt_wsr(c,228,2);xt_wsr(c,230,0);xt_interrupt(c,2);retired=load64(c+176);check(xt_step(c)==10 && load64(c+176)==retired && load64(c+248)==1 && xt_sr(c,177)==0x1000001f && load64(c+128)==0x10000300,"IRQ vector canawait its ownfetchfill withone architectural entry");store64(attrs+24*8,0);xt_pages_ack(c,0x10000000);check(xt_step(c)==0 && load64(c+176)==retired+1 && load64(c+248)==1 && load64(c+128)==0x10000303,"resuming vectorfill doesnotre-enter interrupt orlose originalEPC");xt_interrupt(c,0);xt_wsr(c,228,0);xt_wsr(c,230,0);store64(gate,0);store64(c+128,0x1000001f);retired=load64(c+176);check(xt_step(c)== -1 && load64(c+160)== -5 && load64(c+176)==retired && !load64(event),"disabled fetch remains anexplicitfault ratherthandatafill orretired bytes");xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,attrs,4096,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,gate,8,0,0,0,0);syscall(11,run,4096,0,0,0,0);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU reference required");pf_code=h_read(load64(argv+8));check(h_file_size==25,"GNU code shape");units();instruction();h_print(1,h_cat3("Preflight CPU pages: ",h_int(pf_checks)," checks passed\n"));return 0;}
