import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global checks=0;global active=0;global code=0;global shadow=0;
fn check(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("USER/FPU case ",h_int(active),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn fresh(){let c=xt_create();let p=xt_map(c,0x1000,4096,5);check(c && p,"CPU and executable region allocation");em_copy(p,code,3456);xt_wsr(c,231,0x1000);return c;}
fn step(c,index){store64(c+128,0x1000+index*3);check(xt_step(c)==0,"GNU instruction execution");return 0;}
fn value(i){if !i{return 0;}if i==1{return 0xffffffff;}if i<34{return 1<<(i-2);}if i==34{return 0x80000000;}if i==35{return 0x7f800000;}if i==36{return 0xff800000;}if i==37{return 0x7fc12345;}if i==38{return 0x7f812345;}if i==39{return 0x3f800000;}if i==40{return 0x12345678;}return 0xabcdef01;}
fn float_bits(){let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);xt_wsr(c,224,1);let r=0;while r<16{xt_setreg(c,r,0x98760000+r);xt_wfr(c,r,0x76540000+r);store64(shadow+r*8,0x76540000+r);r=r+1;}let g=0;while g<16{let f=0;while f<16{let i=0;while i<42{active=wb*10752+g*672+f*42+i;let v=value(i);xt_setreg(c,g,v);let retired=load64(c+176);step(c,128+(g*16+f)*2+1);check(load64(c+176)==retired+1 && load64(c+128)==0x1000+(128+(g*16+f)*2+1)*3+3,"WFR retires once");store64(shadow+f*8,v);r=0;while r<16{check(xt_fpr(c,r)==load64(shadow+r*8),"all FPR bit patterns and untouched registers");r=r+1;}xt_setreg(c,g,0x11223344);step(c,128+(g*16+f)*2);check(xt_reg(c,g)==v,"RFR zero-extends raw bits without NaN conversion");i=i+1;}f=f+1;}g=g+1;}xt_close(c);wb=wb+1;}return 0;}
fn users(){let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);xt_wsr(c,224,1);let u=0;while u<4{let g=0;while g<16{let i=0;while i<42{active=200000+wb*2688+u*672+g*42+i;let v=value(i);let index=u*32+g*2;xt_setreg(c,g,v);step(c,index+1);check(xt_user(c,230+u)==v,"silicon USER raw bits,including reserved FCR/FSR bits");xt_setreg(c,g,0x55667788);step(c,index);check(xt_reg(c,g)==v,"RUR destination uses its own encoding field");check(xt_sr(c,230)==0 && xt_sr(c,231)==0x1000 && xt_sr(c,232)==0 && xt_sr(c,233)==0,"USER namespace must not alias SR namespace");i=i+1;}g=g+1;}u=u+1;}xt_close(c);wb=wb+1;}return 0;}
fn gpr(index){if index<128{return (index%32)/2;}return ((index-128)/2)/16;}
fn is_cp(index){return index>=64;}
fn windows(){let wb=0;while wb<16{let c=fresh();let index=0;while index<640{active=300000+wb*640+index;xt_wsr(c,72,wb);xt_wsr(c,73,(1<<wb)|(1<<((wb+1)&15)));xt_wsr(c,230,0x40000);xt_wsr(c,224,1);let retired=load64(c+176);step(c,index);if gpr(index)<4{check(!(xt_sr(c,230)&16) && xt_sr(c,72)==wb && load64(c+176)==retired+1,"USER/FPR index is not an integer window operand");}else{check((xt_sr(c,230)&16) && xt_sr(c,72)==((wb+1)&15) && load64(c+176)==retired,"integer GPR operand checks window before access");check(xt_sr(c,177)==0x1000+index*3,"window saves exact GNU faulting PC");}index=index+1;}xt_close(c);wb=wb+1;}return 0;}
fn disabled(){let c=fresh();let other=fresh();let scenario=0;while scenario<4{let index=0;while index<640{active=400000+scenario*640+index;xt_wsr(c,72,0);xt_wsr(c,230,scenario*16);xt_wsr(c,224,2);let u=0;while u<4{xt_wur(c,230+u,0x12340000+u);u=u+1;}let r=0;while r<16{xt_wfr(c,r,0x98760000+r);xt_setreg(c,r,0x76540000+r);r=r+1;}let before=xt_reg(c,gpr(index));let retired=load64(c+176);step(c,index);if is_cp(index){let vector=0x1300;if scenario==2{vector=0x1340;}if scenario&1{vector=0x13c0;}check(xt_sr(c,232)==32 && load64(c+128)==vector && (xt_sr(c,230)&16),"disabled CP0 kernel,user,double exception vectors");let epc=177;if scenario&1{epc=192;}check(xt_sr(c,epc)==0x1000+index*3 && load64(c+176)==retired && xt_reg(c,gpr(index))==before,"disabled instruction preserves GPR and retirement");u=0;while u<4{check(xt_user(c,230+u)==0x12340000+u,"exception preserves all USER bits");u=u+1;}r=0;while r<16{check(xt_fpr(c,r)==0x98760000+r,"disabled instruction preserves all FPR bits");r=r+1;}}else{check(load64(c+176)==retired+1,"EXPSTATE/THREADPTR need no FPU coprocessor");}index=index+1;}scenario=scenario+1;}
 let index=64;while index<640{if gpr(index)>=4{xt_wsr(c,72,0);xt_wsr(c,73,3);xt_wsr(c,230,0x40000);xt_wsr(c,224,0);let exceptions=load64(c+272);step(c,index);check(xt_sr(c,72)==1 && load64(c+272)==exceptions,"window exception precedes disabled coprocessor");}index=index+1;}
 let r=0;while r<16{check(xt_fpr(other,r)==0,"FPR state belongs to each CPU");r=r+1;}r=230;while r<234{check(xt_user(other,r)==0,"USER state belongs to each CPU");r=r+1;}xt_close(other);xt_close(c);return 0;}
fn loops(){let c=fresh();xt_wsr(c,224,1);let i=0;while i<640{active=500000+i;xt_wsr(c,230,0);xt_wsr(c,0,0x1800);xt_wsr(c,1,0x1000+i*3+3);xt_wsr(c,2,7);step(c,i);check(load64(c+128)==0x1800 && xt_sr(c,2)==6,"state instruction retires through hardware loop boundary");xt_wsr(c,230,16);step(c,i);check(load64(c+128)==0x1000+i*3+3 && xt_sr(c,2)==6,"state transfer in EXCM does not consume interrupted loop");i=i+1;}xt_close(c);return 0;}
fn addmi(){let wb=0;while wb<16{let c=fresh();xt_wsr(c,72,wb);let k=0;while k<256{let i=0;while i<42{active=600000+wb*10752+k*42+i;let v=value(i);xt_setreg(c,2,v);step(c,640+k);let imm=k;if imm>=128{imm=imm-256;}check(xt_reg(c,5)==((v+imm*256)&0xffffffff),"ADDMI all signed immediates and word boundaries");i=i+1;}k=k+1;}let a=0;while a<16{let b=0;while b<16{let index=896+a*16+b;let i=0;while i<42{xt_wsr(c,230,0);let v=value(i);xt_setreg(c,b,v);step(c,index);check(xt_reg(c,a)==((v+256)&0xffffffff),"ADDMI all source/destination pairs and aliasing");i=i+1;}xt_wsr(c,73,(1<<wb)|(1<<((wb+1)&15)));xt_wsr(c,230,0x40000);let retired=load64(c+176);step(c,index);let group=a/4;if b/4>group{group=b/4;}if group{check(load64(c+176)==retired && xt_sr(c,72)==((wb+1)&15),"ADDMI source and destination window check");}else{check(load64(c+176)==retired+1 && xt_sr(c,72)==wb,"ADDMI immediate is not a window operand");}xt_wsr(c,72,wb);xt_wsr(c,230,0);xt_wsr(c,0,0x1800);xt_wsr(c,1,0x1000+index*3+3);xt_wsr(c,2,7);step(c,index);check(load64(c+128)==0x1800 && xt_sr(c,2)==6,"ADDMI retires through hardware loop");xt_wsr(c,2,0);b=b+1;}a=a+1;}xt_close(c);wb=wb+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU raw instruction file required");code=h_read(load64(argv+8));check(h_file_size==3456,"640 GNU state transfers and512 ADDMI forms");shadow=alloc(128);float_bits();users();windows();disabled();loops();addmi();h_print(1,h_cat3("Xtensa USER/FPU state: ",h_int(checks)," checks passed\n"));return 0;}
