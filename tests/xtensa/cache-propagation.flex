// Functional CPU-cycle scheduling,independent of programmable CCOUNT. The GNU
// fixture and32 physical transcripts are separate from the device implementation.
import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;global flash=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Cache propagation case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"public device register write");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"complete independent PLL fixture setup");return 0;}
fn setup(mode){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,1795);ck(xt_map(c,0x4000,4096,3)>0,"handler record mapping");let s=se_create(c,0);if mode==0{wr(s,0x3ff48070,0x3210);}if mode==2{wr(s,0x3ff0003c,1);}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);}ck(se_cpu_hz(s)==(40+(mode!=0)*40+(mode==2)*80+(mode==3)*160)*1000000,"40/80/160/240MHz fixture selections");ck(se_cache_attach(s,flash,65536)==0,"private bounded NOR");wr(s,0x3ff00214,1);xt_wsr(c,228,2);xt_wsr(c,231,0x2000);xt_setreg(c,2,0x3f400000);xt_setreg(c,3,0x4000);xt_setreg(c,8,0x13579bdf);xt_setreg(c,9,1);xt_setreg(c,10,0xfffffff0);return s;}
fn close(s){let c=load64(s);se_close(s);xt_close(c);return 0;}
fn run(s,r,limit){ck(se_run_slice(s,r,1000000,limit)==10 && !load64(s+32) && !load64(load64(s)+160),"GNU execution reaches exact retirement boundary");return 0;}
fn programs(){let mode=0;while mode<4{let phase=0;while phase<6{let kind=0;while kind<3{context=mode*100+phase*10+kind;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+176,phase);ck(se_sync(s)==0,"initial fractional retirement phase");store64(c+128,0x2000+kind*64);xt_wsr(c,234,0xfffffffe);wr(s,0x3ff005a0,1<<15);run(s,r,phase+1);ck(xt_reg(c,8)==0xbad00bad && xt_reg(c,9)==1 && !(xt_sr(c,226)&2) && se_cache_cycles(s)==2,"illegal load commits before asynchronous DROM IRQ");let cycles=se_cpu_cycles(s);xt_wsr(c,234,0x12345678);ck(se_cpu_cycles(s)==cycles && se_cache_cycles(s)==2,"guest CCOUNT write cannot change the IRQ deadline");run(s,r,phase+2);if kind==1{ck(load64(s+208) && !(xt_sr(c,226)&2) && se_cache_cycles(s)==1,"WAITI retires before the remaining propagation cycle");let before=load64(s+16);let qpc=12;if mode==1{qpc=6;}if mode==2{qpc=3;}if mode==3{qpc=2;}let fractional=load64(se_clock(s)+24);run(s,r,phase+3);ck(xt_sr(c,177)==0x2046 && xt_reg(c,9)==1 && load64(c+248)==1,"idle CPU cycle wakes WAITI before its following instruction");ck(load64(se_clock(s)+152)==8 && se_cpu_cycles(s)==phase+11,"one propagation cycle plus seven entry cycles are counted independently of retirement");ck(load64(s+16)==before+(fractional+9*qpc)/6 && load64(se_clock(s)+24)==(fractional+9*qpc)%6,"fractional idle and handler cycles preserve reference-clock phase");}else{ck(!(xt_sr(c,226)&2) && se_cache_cycles(s)==1,"first following instruction does not deliver DROM IRQ");run(s,r,phase+3);let marker=3;if kind==2{marker=2;}ck((xt_sr(c,226)&2) && xt_reg(c,9)==marker && se_cache_cycles(s)== -1,"second following instruction completes before IRQ arrives");run(s,r,phase+4);ck(xt_sr(c,177)==0x2009+kind*64 && load64(c+248)==1 && xt_reg(c,9)==marker,"IRQ enters at measured postload boundary with original register snapshot");}syscall(11,r,4096,0,0,0,0);close(s);kind=kind+1;}phase=phase+1;}mode=mode+1;}return 0;}
fn bursts(){let mode=0;while mode<4{let phase=0;while phase<6{context=500+mode*10+phase;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+176,phase);ck(se_sync(s)==0,"burst initial clock phase");store64(c+128,0x2000);wr(s,0x3ff005a0,1<<15);run(s,r,phase+4);ck(xt_sr(c,177)==0x2009 && xt_reg(c,9)==3 && load64(c+248)==1,"a multi-instruction caller slice cannot overshoot the CPU-cycle IRQ boundary");syscall(11,r,4096,0,0,0,0);close(s);phase=phase+1;}mode=mode+1;}return 0;}
fn transitions(){let mode=0;while mode<4{context=1000+mode;let s=setup(mode);let c=load64(s);ck(se_bus(s,0x3f400000,4,0,0)==0xbad00bad && !se_cache_irq(s) && se_cache_cycles(s)== -1,"masked source records flag without starting propagation");wr(s,0x3ff005a0,1<<15);ck(!se_cache_irq(s) && se_cache_cycles(s)==2,"enabling a latched DROM flag starts functional propagation");let cycles=se_cpu_cycles(s);xt_wsr(c,234,0xffffffff);ck(se_clock_idle_cycles(s,1)==0 && !se_cache_irq(s) && se_cpu_cycles(s)==cycles+1,"one idle CPU cycle remains before propagated IRQ");wr(s,0x3ff005a0,1<<15);ck(se_bus(s,0x3f400000,4,0,0)==0xbad00bad && se_cache_cycles(s)==1,"same enable/repeated reads do not postpone an in-flight IRQ");wr(s,0x3ff005a0,0);ck(se_cache_cycles(s)== -1 && !se_cache_irq(s),"EN0 cancels propagation without clearing the disabled flag");ck(se_clock_idle_cycles(s,3)==0 && !se_cache_irq(s),"a canceled deadline cannot deliver a stale IRQ");wr(s,0x3ff005a0,1<<15);xt_wsr(c,228,0);ck(se_clock_idle_cycles(s,2)==0 && se_cache_irq(s) && !se_awake(s),"CPU INTENABLE masks delivery rather than peripheral propagation");xt_wsr(c,228,2);ck(se_awake(s),"unmasking an already propagated source needs no further cycles");xt_wsr(c,230,16);ck(!se_awake(s) && se_cache_irq(s),"EXCM masks CPU entry while preserving the peripheral source");xt_wsr(c,230,0);wr(s,0x3ff005a0,0);wr(s,0x3ff005a0,(1<<15)|(1<<19));ck(se_cache_cycles(s)==2 && !se_cache_irq(s),"fresh DROM propagation after EN0");ck(se_bus(s,0x400d0000,4,0,0)==0xbad00bad && se_cache_irq(s),"IROM disabled source remains immediate while DROM propagates");close(s);mode=mode+1;}return 0;}
fn enable_edges(){let mode=0;while mode<4{let phase=0;while phase<6{let bus=0;while bus<2{context=3000+mode*100+phase*10+bus;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+176,phase);ck(se_sync(s)==0,"enable-edge initial clock phase");store64(c+128,0x20c0);let address=0x3f400000;let enable=1<<15;if bus{address=0x400d0000;enable=1<<19;}xt_setreg(c,2,address);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,enable);run(s,r,phase+10);ck(xt_reg(c,8)==0xbad00bad && xt_reg(c,9)==1 && !(xt_sr(c,226)&2),"settled disabled DATA flag permits6 following instructions afterENA store on both buses");run(s,r,phase+15);ck(xt_reg(c,9)==6 && !(xt_sr(c,226)&2) && se_cache_cycles(s)==1,"five following increments complete before the enable-edge IRQ");let time=se_cpu_cycles(s);xt_wsr(c,234,0xfffffffc);ck(se_cpu_cycles(s)==time && se_cache_cycles(s)==1,"CCOUNT rewrite cannot shift enable-edge propagation");run(s,r,phase+16);ck(xt_reg(c,9)==7 && (xt_sr(c,226)&2),"sixth increment completes before enable-edge IRQ arrival");run(s,r,phase+17);ck(xt_sr(c,177)==0x20f0 && xt_reg(c,9)==7 && load64(c+248)==1,"rawGNU enable-edge handler enters at the silicon-measured boundary");syscall(11,r,4096,0,0,0,0);close(s);bus=bus+1;}phase=phase+1;}mode=mode+1;}return 0;}
fn fenced_edges(){let mode=0;while mode<4{let phase=0;while phase<6{let bus=0;while bus<2{context=4000+mode*100+phase*10+bus;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+176,phase);ck(se_sync(s)==0,"fenced-edge initial phase");store64(c+128,0x2100);let address=0x3f400000;let enable=1<<15;if bus{address=0x400d0000;enable=1<<19;}xt_setreg(c,2,address);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,enable);run(s,r,phase+10);ck(xt_reg(c,8)==0xbad00bad && xt_reg(c,9)==1 && !(xt_sr(c,226)&2),"ENA store leaveslatched-fault IRQ in-flight");run(s,r,phase+12);ck(xt_reg(c,9)==2 && (xt_sr(c,226)&2),"MEMW andone ADD reach the measuredenable-edge IRQ boundary");ck(load64(se_clock(s)+152)==4 && se_cpu_cycles(s)==phase+16,"four waitcycles replace thefour missing retired ADDs inpaired35-cycle observations");ck(!load64(c+304) && !load64(c+320),"drained MEMW leavesno staleCPU deviceevent");run(s,r,phase+13);ck(xt_sr(c,177)==0x2124 && load64(c+248)==1,"fenced enable-edge rawhandler entrymatches siliconEPC");syscall(11,r,4096,0,0,0,0);close(s);bus=bus+1;}phase=phase+1;}mode=mode+1;}return 0;}
fn write_order(){let mode=0;while mode<4{context=5000+mode;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+128,0x2180);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,1<<15);run(s,r,1);ck(se_bus(s,0x3ff005a0,4,0,0)==0 && load64(c+304),"CPU write isqueued before thedevice-visible enablechanges");run(s,r,2);ck(xt_reg(c,12)==(1<<15) && load64(se_clock(s)+152)==4 && !load64(c+304),"same-register readwaits forqueuedwrite andreturns updatedvalue");run(s,r,4);ck(xt_reg(c,9)==2 && se_cpu_cycles(s)==8,"later MEMW doesnotwait twice foralreadydrainedwrite");close(s);s=setup(mode);c=load64(s);em_zero(r,4096);store64(c+128,0x21c0);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,1<<15);xt_setreg(c,13,0);run(s,r,2);ck(se_bus(s,0x3ff005a0,4,0,0)==(1<<15) && load64(se_clock(s)+152)==3,"second queuedwrite cannotoverwrite firstbeforeits completion");run(s,r,3);ck(se_bus(s,0x3ff005a0,4,0,0)==0 && load64(se_clock(s)+152)==7 && !load64(c+304) && !load64(c+320),"backpressure andMEMW drain twoordered writesexactlyonce");close(s);s=setup(mode);c=load64(s);em_zero(r,4096);store64(c+128,0x2100);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,1<<15);run(s,r,10);ck(xt_step(c)==12 && load64(c+320),"owned MEMW pause forcancel/close");ck(se_cache_close(s)==0 && !load64(c+320) && !load64(c+304) && load64(c+176)==10,"closingcache cancelsowned post/CPU event withoutretirement");ck(xt_run_slice(c,r,1000,12)==10 && xt_reg(c,9)==2,"MEMW resumes afterexplicit deviceclose");close(s);syscall(11,r,4096,0,0,0,0);mode=mode+1;}return 0;}
fn interrupt_wait(){let mode=0;while mode<4{context=6000+mode;let s=setup(mode);let c=load64(s);let r=alloc(4096);em_zero(r,4096);store64(c+128,0x2100);xt_setreg(c,10,0x3ff005a0);xt_setreg(c,11,1<<15);xt_wsr(c,231,0x2400);xt_wsr(c,228,0x82);run(s,r,10);ck(xt_step(c)==12 && se_clock_idle_cycles(s,1)==0,"CPU ispaused onecycle into thewritewait");xt_wsr(c,226,128);run(s,r,11);ck(load64(c+248)==1 && xt_sr(c,177)==0x211e && load64(c+128)==0x211e && !load64(c+304) && load64(se_clock(s)+152)==8 && se_cache_posted_cycles(s)<=0 && (xt_sr(c,226)&2),"seven entry cycles drain posted write before RFE while preserving MEMW EPC");xt_wsr(c,227,128);xt_wsr(c,228,0);run(s,r,13);ck(xt_reg(c,9)==2 && (xt_sr(c,226)&2) && load64(se_clock(s)+152)==12 && !load64(c+320) && load64(c+248)==1,"masked external source permits MEMW retry after exact RFE wait with no duplicate transport wait");xt_wsr(c,228,0x82);run(s,r,14);ck(load64(c+248)==2 && xt_sr(c,177)==0x2124 && load64(se_clock(s)+152)==19,"re-enabling completed external source delivers after measured entry without losing pending status");syscall(11,r,4096,0,0,0,0);close(s);mode=mode+1;}return 0;}
fn partial_idle(){context=2000;let s=setup(0);let c=load64(s);wr(s,0x3ff005a0,1<<15);se_bus(s,0x3f400000,4,0,0);let before=load64(s+16);let cc=xt_sr(c,234);ck(se_clock_idle(s,1)==0 && !se_cpu_cycles(s) && se_cache_cycles(s)==2 && !se_cache_irq(s),"half of a40MHz cycle does not retire a CPU propagation cycle");ck(se_clock_idle_cycles(s,2)==0 && se_cpu_cycles(s)==2 && se_cache_irq(s) && xt_sr(c,234)==((cc+2)&0xffffffff),"exact-cycle idle consumes the partial CPU-cycle debt once");ck(load64(s+16)==before+4 && !load64(se_clock(s)+24) && !load64(se_clock(s)+32),"partial wall-clock idle plus remaining cycles preserves total elapsed time");ck(se_clock_idle_cycles(s,-1)== -22 && se_clock_idle_cycles(s,0x7fffffffffffffff)== -22,"invalid cycle intervals are rejected");close(s);return 0;}
fn profile_guards(){context=2100;let s=setup(2);let c=load64(s);store64(c+176,1);ck(se_sync(s)==0 && !load64(s+16),"160MHz retirement can advance phase without a whole reference tick");ck(se_clock_profile(s,1)== -22 && se_cpu_cycles(s)==1 && se_cpu_hz(s)==160000000,"clock profile cannot erase fractional retired CPU progress");close(s);s=setup(2);ck(se_clock_idle_cycles(s,1)==0 && !load64(s+16),"fractional idle fixture");ck(se_clock_profile(s,1)== -22 && se_cpu_cycles(s)==1 && se_cpu_hz(s)==160000000,"clock profile cannot erase fractional idle cycles");close(s);return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"GNU instruction input");gnu=h_read(load64(argv+8));ck(h_file_size==1795,"independent GNU fixture size");flash=alloc(65536);programs();bursts();transitions();enable_edges();fenced_edges();write_order();interrupt_wait();partial_idle();profile_guards();syscall(11,flash,65536,0,0,0,0);h_print(1,h_cat3("Cache propagation: ",h_int(checks)," checks passed\n"));return 0;}
