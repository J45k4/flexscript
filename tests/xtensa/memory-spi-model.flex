// SDK-addressed single-wire NOR/controller contract. No platform driver imports.
import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global mf_ref=0;global mf_checks=0;global mf_case=0;
fn check(ok,message){mf_checks=mf_checks+1;if !ok{h_print(2,h_cat3("Memory SPI case ",h_int(mf_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn v(i){return load64(mf_ref+i*8);}
fn address(id,k){return v(1+id)+v(k);}
fn wr(s,id,k,value){let r=se_bus(s,address(id,k),4,1,value);check(r>=0,"SDK controller write");return r;}
fn rd(s,id,k){let r=se_bus(s,address(id,k),4,0,0);check(r>=0,"SDK controller read");return r;}
fn status(s,id){wr(s,id,3,v(26));let delay=se_flash_deadline(s);check(delay>0,"status transaction has a deadline");check(se_advance(s,delay)==0,"status completes");return rd(s,id,7)&65535;}
fn ready(s,id){let deadline=se_flash_deadline(s);if deadline>0{check(se_advance(s,deadline)==0,"advance to command completion");}check(rd(s,id,3)==0 && rd(s,id,19)==0,"CMD and EXT2 clear at deadline");return 0;}
fn command(s,id,op,at,tx,rx){let user=v(31);if at>=0{user=user|v(32);}if tx{user=user|v(34);}if rx{user=user|v(33);}wr(s,id,10,user);wr(s,id,11,23<<26);wr(s,id,12,(7<<28)|op);wr(s,id,4,at<<8);wr(s,id,13,tx*8-1);wr(s,id,14,rx*8-1);return se_bus(s,address(id,3),4,1,v(21));}
fn byte(i){return (i*37+(i/251)*19+0xa6)&255;}
fn rxbyte(s,id,i){let word=se_bus(s,address(id,18)+(i/4)*4,4,0,0);check(word>=0,"FIFO read");return (word>>((i&3)*8))&255;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"SDK C metadata argument");mf_ref=h_read(load64(argv+8));check(h_file_size==360 && v(0)==0x4d53504900000001,"45 independent SDK fields");let nor=alloc(4194304);let i=0;while i<4194304{store8(nor+i,byte(i));i=i+1;}let cpu=xt_create();let s=se_create(cpu,0);check(se_bus(s,v(1),4,0,0)== -19,"no implicit flash attachment");check(se_cache_attach(s,nor,4194304)==0,"immutable source copy");let p=se_cache(s);
 let id=0;while id<2{mf_case=id;check(rd(s,id,3)==0 && rd(s,id,19)==0,"controllers start idle");check(rd(s,id,15)==6 && rd(s,id,9)==0x80003043,"SDK reset CS/divider");wr(s,id,5,v(37));wr(s,id,9,v(36));wr(s,id,3,v(25));check(rd(s,id,3)==v(25) && rd(s,id,19)!=0,"RDID remains busy before deadline");check(se_flash_deadline(s)==32 && se_deadline(s)==32,"RDID wire cycles and board wake deadline");check(se_bus(s,0x3ff48070,4,1,0x3210)== -16 && se_apb_factor(s)==1,"live APB transition cannot invalidate an active flash deadline");check(se_advance(s,31)==0 && rd(s,id,3)==v(25),"last pre-deadline cycle remains busy");check(se_bus(s,address(1-id,3),4,1,v(25))== -16,"both controllers arbitrate the same NOR");check(se_bus(s,address(id,4),4,1,77)== -16,"configuration is stable while busy");check(se_advance(s,1)==0 && rd(s,id,3)==0 && rd(s,id,19)==0,"completion at exact last cycle");check((rd(s,id,18)&0xffffff)==0x162085,"explicit virtual Puya identity");check((rd(s,id,16)&16)!=0,"completion latches TRANS_DONE");
 let n=1;while n<=64{mf_case=100+id*64+n;let at=4194304-n;check(command(s,id,3,at,0,n)==0,"USR read accepts every FIFO length at last NOR byte");check(rd(s,id,3)==v(21) && se_flash_deadline(s)==32+n*8,"USR read phase deadline");ready(s,id);i=0;while i<n{check(rxbyte(s,id,i)==byte(at+i),"addressed NOR data and byte order");i=i+1;}n=n+1;}
 wr(s,id,4,65533|(8<<24));wr(s,id,14,0);wr(s,id,3,v(22));ready(s,id);i=0;while i<8{check(rxbyte(s,id,i)==byte(65533+i),"hardware READ uses low24 address and crosses a cache-page boundary");i=i+1;}
 wr(s,id,10,v(31)|v(32)|v(33)|v(35));wr(s,id,11,(23<<26)|7);wr(s,id,12,(7<<28)|0x0b);wr(s,id,4,65533<<8);wr(s,id,14,63);wr(s,id,3,v(21));check(se_flash_deadline(s)==104,"FAST_READ adds exactly8 dummy clocks");ready(s,id);i=0;while i<8{check(rxbyte(s,id,i)==byte(65533+i),"FAST_READ data matches ordinary NOR reads");i=i+1;}wr(s,id,4,0);check(se_bus(s,address(id,3),4,1,v(22))== -95,"unmodeled zero-byte hardware READ is rejected explicitly");
 check(command(s,id,3,4194300,0,8)== -22 && rd(s,id,3)==0,"out-of-NOR read rejects before submission");check(command(s,id,0x7e,-1,0,0)== -95,"unknown NOR command rejects explicitly");check(command(s,id,3,0,0,65)== -95,"FIFO overflow rejects before data mutation");wr(s,id,3,v(23));ready(s,id);check((status(s,id)&2)!=0,"WREN is visible through hardware status");check(command(s,id,2,0,1,0)== -30 && load8(load64(p))==byte(0),"default NOR image is write-protected");wr(s,id,3,v(24));ready(s,id);check((status(s,id)&2)==0,"WRDI clears WEL");
 wr(s,id,9,(2<<18)|(4<<12));wr(s,id,3,v(25));check(se_flash_deadline(s)==32*3*5,"predivider and N scale all command phases");ready(s,id);wr(s,id,9,v(36));wr(s,id,20,0xffffffff);check(rd(s,id,20)==3,"EXT3 hold mask");check(se_bus(s,address(id,19),4,1,0)== -13 && se_bus(s,v(1+id)+0x58,4,1,1)== -95,"read-only FSM and unsupported PSRAM commands");id=id+1;}
 mf_case=300;check(se_flash_write_window(s,1048576,8192)==0,"explicit bounded write interval");let at=1048576+17;check(command(s,1,2,at,8,0)== -13,"page program requires WEL");wr(s,1,3,v(23));ready(s,1);wr(s,1,18,0x10325476);check(se_bus(s,address(1,18)+4,4,1,0)>=0,"second program FIFO word");check(command(s,1,2,at,8,0)==0,"program submits after WREN");check(se_flash_write_window(s,0,0)== -16,"cannot revoke write interval during a command");let delay=se_flash_deadline(s);check(se_advance(s,delay-1)==0 && load8(load64(p)+at)==byte(at),"program mutates no NOR data before controller completion");ready(s,1);check(load8(load64(p)+at)==(byte(at)&0x76) && load8(load64(p)+at+1)==(byte(at+1)&0x54),"program latches FIFO bytes and only clears bits");check((status(s,1)&3)==1,"NOR WIP survives controller idle; WEL is consumed");check(command(s,0,3,at,0,8)== -16,"non-status command waits for NOR ready");let delay2=se_flash_deadline(s);check(delay2>0 && se_advance(s,delay2)==0 && (status(s,1)&3)==0,"NOR completion deadline clears WIP");check(load8(nor+at)==byte(at),"caller-owned NOR source remains immutable");wr(s,1,3,v(23));ready(s,1);check(command(s,1,2,1048830,8,0)== -22,"page crossing rejects atomically");check(command(s,1,0x20,1048577,0,0)== -22,"sector erase requires alignment");check(command(s,1,0x20,0,0,0)== -30,"erase cannot escape writable interval");check(command(s,1,0x20,1048576,0,0)==0,"aligned sector erase submits");ready(s,1);i=0;while i<4096{check(load8(load64(p)+1048576+i)==255,"exact sector erased");i=i+1;}check(load8(load64(p)+1048575)==byte(1048575) && load8(load64(p)+1052672)==byte(1052672),"erase preserves neighboring bytes");check(se_advance(s,se_flash_deadline(s))==0 && se_flash_write_window(s,0,0)==0,"write window can close after NOR ready");
 mf_case=350;check(command(s,0,1,-1,1,0)== -30,"nonvolatile status writes are unsupported");check(command(s,0,0x50,-1,0,0)==0,"volatile status enable");ready(s,0);wr(s,0,18,0x021c);check(command(s,0,1,-1,2,0)==0,"two-byte volatile status write");ready(s,0);check(status(s,1)==0x021c,"shared volatile status preserves BP and QE bits");check(command(s,1,0x50,-1,0,0)==0,"second volatile enable");ready(s,1);wr(s,1,18,0);check(command(s,1,1,-1,1,0)==0,"one-byte volatile status write");ready(s,1);check(status(s,0)==0x0200,"one-byte write preserves SR2");check(command(s,1,0x50,-1,0,0)==0,"status restoration enable");ready(s,1);check(command(s,1,1,-1,2,0)==0,"restore volatile status");ready(s,1);check(status(s,0)==0,"status restored");
 mf_case=400;wr(s,0,3,v(30));ready(s,0);check(command(s,1,0x9f,-1,0,3)== -112,"deep sleep is shared across controllers");wr(s,1,3,v(29));ready(s,1);check(command(s,0,0x9f,-1,0,3)==0,"release power-down wakes shared NOR");ready(s,0);
 // Cache needs both the DPORT enable and SPI0 request enable.
 check(se_bus(s,0x3ff10000,4,1,0)>=0 && se_bus(s,0x3ff00044,4,1,0)>=0 && se_bus(s,0x3ff00040,4,1,8)>=0,"cache translation setup");check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"SPI0 request gate cannot be bypassed by DPORT");store64(cpu+160,0);wr(s,0,17,1);check(xt_read(cpu,0x3f400000,1)==byte(0) && !load64(cpu+160),"request enable publishes bounded MMU view");wr(s,0,17,0);check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"clearing request gate immediately hides cache");store64(cpu+160,0);check(se_bus(s,v(38),4,1,v(39))== -95 && se_bus(s,v(38),4,0,0)==0,"unswapped-only pad profile rejects unsupported routing");
 mf_case=425;wr(s,0,10,v(31)|v(32)|v(33));wr(s,0,11,23<<26);wr(s,0,12,(7<<28)|0x7e);check(se_bus(s,address(0,17),4,1,5)== -95 && rd(s,0,17)==0,"unsupported custom cache command rolls SPI request register back atomically");check(xt_read(cpu,0x3f400000,1)==0 && load64(cpu+160)== -5,"rejected profile publishes no cache view");store64(cpu+160,0);wr(s,0,12,(7<<28)|3);wr(s,0,17,5);check(xt_read(cpu,0x3f400000,1)==byte(0) && !load64(cpu+160),"supported custom READ publishes the actual ROM mapping");wr(s,0,17,0);check(se_bus(s,0x3ff00040,4,1,0)>=0,"disable DPORT for staged unsupported custom profile");wr(s,0,12,(7<<28)|0x7e);wr(s,0,17,5);check(se_bus(s,0x3ff00040,4,1,8)== -95 && se_bus(s,0x3ff00040,4,0,0)==0,"DPORT enable also rejects and rolls back unsupported cache profile");wr(s,0,17,0);
 mf_case=450;check(se_bus(s,v(1),1,0,0)== -22 && se_bus(s,v(2),2,1,0)== -22,"controller accesses require32-bit width");let traces=load64(p+448);let when=load64(s+16);check(command(s,1,3,0x12345,0,17)==0,"record command trace");let event=p+38912+(traces&63)*32;check(load64(event)==when && load64(event+8)==(3|256) && load64(event+16)==0x12345 && load64(event+24)==(17<<16),"trace preserves independently configured wire command,address,length and time");ready(s,1);
 mf_case=500;let ef=alloc(28);i=0;while i<7{check(se_bus(s,v(40)+i*4,4,0,0)==0,"unprovisioned virtual eFuse default");em_put32(ef+i*4,0x81234567^(i*0x123456));i=i+1;}check(se_cache_efuse_profile(s,ef,28)==0,"explicit eFuse snapshot attaches before guest execution");store8(ef,0);i=0;while i<7{check(se_bus(s,v(40)+i*4,4,0,0)==((0x81234567^(i*0x123456))&0xffffffff),"eFuse snapshot is copied exactly");check(se_bus(s,v(40)+i*4,4,1,0)== -13,"eFuse readback cannot program bits");i=i+1;}check(se_bus(s,v(41)+4,4,0,0)== -95 && se_bus(s,0x3ff5a104,4,1,1)== -95,"unmodeled eFuse banks and programming commands reject");store64(cpu+176,1);check(se_cache_efuse_profile(s,ef,28)== -22,"eFuse profile cannot change mid-firmware");store64(cpu+176,0);check(se_cache_efuse_profile(s,ef,27)== -22 && se_cache_efuse_profile(s,0,28)== -22,"snapshot bounds");check(load64(p+448)>128 && load64(p+448)==load64(p+456),"bounded command trace wraps without dropping command completion");se_close(s);xt_close(cpu);syscall(11,nor,4194304,0,0,0,0);h_print(1,h_cat3("Memory SPI: ",h_int(mf_checks)," checks passed\n"));return 0;}
