import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global gp=0;
global nchecks=0;
fn g(index){return load64(gp+32+index*8);}
fn d(pin,field){return load64(gp+32+load64(gp+8)*8+(pin*14+field)*8);}
fn expect(ok,text){if !ok{h_print(2,h_cat3("GPIO check ",h_int(nchecks),h_cat3(": ",text,"\n")));syscall(60,1,0,0,0,0,0);}nchecks=nchecks+1;return 0;}
fn rd(s,address){let v=se_bus(s,address,4,0,0);expect(v>=0,"read defined register");return v;}
fn wr(s,address,value){expect(se_bus(s,address,4,1,value)>=0,"write defined register");return 0;}
fn input(s,pin){let address=g(46);if pin>=32{address=g(47);}return (rd(s,address)>>(pin&31))&1;}
fn change(s,pin,index){let address=g(index);if pin>=32{address=g(index+6);}wr(s,address,1<<(pin&31));return 0;}
fn configure(s,pin){wr(s,d(pin,0),(g(5)<<g(7))|g(8));if d(pin,3){wr(s,d(pin,3),0);}wr(s,g(28)+pin*4,256|g(52));return 0;}
fn fresh(cpu){let s=se_create(cpu,g(0));expect(s>0,"board allocation");return s;}
fn all_pads(cpu){let pin=0;while pin<g(1){let s=fresh(cpu);let field=0;while field<14{expect(se_gpio_desc(s,pin,field)==d(pin,field),"independent full pad descriptor");field=field+1;}if !(d(pin,1)&1){expect(se_gpio_drive(s,pin,1)== -22,"unbonded pad rejection");}else{
 configure(s,pin);expect(se_gpio_drive(s,pin,1)==0 && input(s,pin)==1,"digital input across every pad");wr(s,d(pin,0),g(5)<<g(7));expect(input(s,pin)==0,"input-disable across every pad");wr(s,d(pin,0),(g(5)<<g(7))|g(8));expect(se_gpio_drive(s,pin,-1)==0,"release external input");
 if d(pin,7) || !d(pin,3){let address=d(pin,0);let up=g(57);let down=g(58);if !g(0) && d(pin,3){address=d(pin,3);up=d(pin,7);down=d(pin,8);}let before=rd(s,address);wr(s,address,(before&~(up|down))|up);expect(input(s,pin)==1,"digital pull-up across supported pads");wr(s,address,(before&~(up|down))|down);expect(input(s,pin)==0,"digital pull-down across supported pads");wr(s,address,before);}
 if d(pin,1)&2{change(s,pin,36);change(s,pin,38);expect(input(s,pin)==0,"software output low");change(s,pin,35);expect(input(s,pin)==1,"software output high");wr(s,g(28)+pin*4,17);expect(se_gpio_peripheral(s,17,0,1)==0 && input(s,pin)==0,"peripheral output routed through matrix");expect(se_gpio_peripheral(s,17,1,1)==0 && input(s,pin)==1,"peripheral output transition");wr(s,g(28)+pin*4,17|g(51));expect(input(s,pin)==0,"peripheral output inversion");change(s,pin,39);wr(s,g(28)+pin*4,17|g(52));expect(se_gpio_drive(s,pin,0)==0,"GPIO override disables peripheral OE");expect(input(s,pin)==0,"override input low");expect(se_gpio_drive(s,pin,-1)==0,"release override external level");wr(s,g(28)+pin*4,17|g(52)|g(53));expect(input(s,pin)==1,"OE inversion");wr(s,g(28)+pin*4,256|g(52));change(s,pin,39);
 if d(pin,11){change(s,pin,36);change(s,pin,38);wr(s,g(21),d(pin,11));change(s,pin,35);expect(input(s,pin)==0,"digital hold preserves driven level");wr(s,d(pin,0),0);expect(input(s,pin)==0,"hold preserves pad function and input-enable");wr(s,g(21),0);expect(se_gpio_level(s,pin)==0,"released non-GPIO function is not software driven");wr(s,d(pin,0),(g(5)<<g(7))|g(8));expect(input(s,pin)==1,"release restores live configuration");change(s,pin,39);}
 }
 // The input matrix constant-zero selector differs from GPIO48 on S3.
 wr(s,g(27)+3*4,g(22)|g(55));expect(se_gpio_signal(s,3)==1,"matrix constant one");wr(s,g(27)+3*4,g(23)|g(55));expect(se_gpio_signal(s,3)==0,"chip matrix constant zero");wr(s,g(27)+3*4,g(23)|g(55)|g(54));expect(se_gpio_signal(s,3)==1,"matrix constant inversion");expect(se_gpio_drive(s,pin,1)==0,"matrix external input");wr(s,g(27)+3*4,pin|g(55));expect(se_gpio_signal(s,3)==1,"all-pad matrix pin routing");expect(se_gpio_drive(s,pin,-1)==0,"release matrix external input");
 if d(pin,2){let channel=d(pin,2)-1;let bit=1<<(channel+g(16));let value=d(pin,4)|d(pin,6);wr(s,d(pin,3),value);expect(se_gpio_drive(s,pin,1)==0,"RTC external input");expect(input(s,pin)==0 && (rd(s,g(15))&bit),"RTC owns pad and digital input disconnects");expect(se_gpio_drive(s,pin,0)==0 && !(rd(s,g(15))&bit),"RTC low input");expect(se_gpio_drive(s,pin,-1)==0,"release RTC input");wr(s,d(pin,3),value|(1<<d(pin,5)));expect(!(rd(s,g(15))&bit),"non-GPIO RTC function disconnects RTC GPIO");wr(s,d(pin,3),value);
 if d(pin,7){wr(s,d(pin,3),value|d(pin,7));expect(rd(s,g(15))&bit,"RTC pull-up");wr(s,d(pin,3),value|d(pin,8));expect(!(rd(s,g(15))&bit),"RTC pull-down");wr(s,d(pin,3),value);}
 wr(s,g(10),bit);wr(s,g(13),bit);if d(pin,1)&2{expect(se_gpio_level(s,pin)==1 && (rd(s,g(15))&bit),"RTC output enable and high");wr(s,g(11),bit);expect(se_gpio_level(s,pin)==0,"RTC output clear");
 if d(pin,7){wr(s,d(pin,3),value|d(pin,7));wr(s,g(18)+channel*4,g(19));wr(s,g(10),bit);expect(rd(s,g(15))&bit,"RTC open-drain released pull-up");expect(se_gpio_drive(s,pin,0)==0 && !(rd(s,g(15))&bit),"RTC open-drain external low");expect(se_gpio_drive(s,pin,-1)==0,"release RTC open-drain input");wr(s,g(18)+channel*4,0);wr(s,d(pin,3),value);}
 // Prepare a distinct digital state for release of an RTC pad hold.
 change(s,pin,35);change(s,pin,38);wr(s,g(11),bit);if d(pin,9){wr(s,d(pin,3),value|d(pin,9));}else{wr(s,g(20),d(pin,10));}wr(s,g(10),bit);expect(se_gpio_level(s,pin)==0,"RTC hold freezes output before OUT changes");wr(s,d(pin,3),d(pin,9));expect(input(s,pin)==0 && !(rd(s,g(15))&bit),"hold retains RTC ownership and IE");if d(pin,9){wr(s,d(pin,3),0);}else{wr(s,g(20),0);}expect(se_gpio_level(s,pin)==1 && input(s,pin)==1,"RTC hold release restores digital state");change(s,pin,39);wr(s,d(pin,3),value);wr(s,g(11),bit);wr(s,g(20),d(pin,10));wr(s,g(10),bit);expect(se_gpio_level(s,pin)==0,"forced RTC hold preserves level");wr(s,g(20),0);expect(se_gpio_level(s,pin)==1,"forced RTC hold releases live output");wr(s,g(14),bit);wr(s,d(pin,3),0);
 }else{expect(se_gpio_level(s,pin)==0,"input-only RTC cannot drive");expect(se_gpio_drive(s,pin,1)==0,"input-only RTC external high");wr(s,d(pin,3),value|d(pin,9));wr(s,d(pin,3),d(pin,9));expect(rd(s,g(15))&bit,"input-only hold retains input-enable and mux");expect(se_gpio_drive(s,pin,0)==0 && !(rd(s,g(15))&bit),"held input still samples changing external level");wr(s,d(pin,3),0);expect(se_gpio_drive(s,pin,1)==0 && input(s,pin)==1 && !(rd(s,g(15))&bit),"input-only hold release restores digital mux");expect(se_gpio_drive(s,pin,-1)==0,"release held-input stimulus");}
 }
 }se_close(s);pin=pin+1;}}
fn irq_and_atomic(cpu){let s=fresh(cpu);configure(s,4);configure(s,19);configure(s,21);wr(s,g(63)+g(62)*4,1);wr(s,g(31),1<<4);expect((rd(s,g(29))&(1<<4)) && !(xt_sr(cpu,226)&2),"raw GPIO status is masked from CPU");expect(!(rd(s,g(24))&(1<<4)),"CPU view filters pin enable");wr(s,g(26)+4*4,g(33));expect((rd(s,g(24))&(1<<4)) && (xt_sr(cpu,226)&2),"CPU view enables pre-existing raw status");wr(s,g(32),1<<4);expect(!(xt_sr(cpu,226)&2),"masked CPU deasserts after W1TC");
 wr(s,g(26)+4*4,g(33)|(1<<g(56)));change(s,4,36);change(s,4,38);change(s,21,36);change(s,21,38);expect(se_gpio_drive(s,19,0)==0 && se_gpio_wire(s,21,19)==0,"contention precondition");let pending=rd(s,g(29));let inputs=rd(s,g(46));expect(se_bus(s,g(35),4,1,(1<<4)|(1<<21))== -5,"conflicting later pin rejected");expect(rd(s,g(29))==pending && rd(s,g(46))==inputs,"failed resolution commits no earlier edges or inputs");wr(s,g(36),(1<<4)|(1<<21));expect(se_gpio_drive(s,19,-1)==0 && se_gpio_unwire(s,19)==0,"wire contention cleanup");se_close(s);}
fn register_width(cpu){let s=fresh(cpu);wr(s,g(40),0xffffffff);expect(rd(s,g(40))==g(64),"documented high GPIO output register width");wr(s,g(43),0xffffffff);expect(rd(s,g(43))==g(65),"documented high GPIO enable register width");wr(s,g(48),0xffffffff);expect(rd(s,g(30))==g(66),"documented high raw status register width");wr(s,g(49),0xffffffff);expect(rd(s,g(30))==0,"high status clear aliases");let last=g(67)-1;wr(s,g(26)+last*4,g(33));expect(rd(s,g(26)+last*4)==g(33),"internal high GPIO register slot");wr(s,g(48),1<<(last-32));expect(rd(s,g(25))&(1<<(last-32)),"software raw status in defined internal slot");wr(s,g(28)+(g(68)-1)*4,256);expect(rd(s,g(28)+(g(68)-1)*4)==256,"internal output matrix slot");se_close(s);}
fn main(argc,argv){h_environment(argc,argv);expect(argc==2,"reference argument");gp=h_read(load64(argv+8));expect(load64(gp)==0x4750494f50414401 && load64(gp+8)==69 && load64(gp+24)==14 && h_file_size==32+(69+load64(gp+16)*14)*8,"C GPIO reference shape");let cpu=xt_create();expect(cpu>0,"CPU allocation");register_width(cpu);all_pads(cpu);irq_and_atomic(cpu);xt_close(cpu);h_print(1,h_cat3("GPIO model: ",h_int(nchecks)," checks passed\n"));return 0;}
