import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global reference=0;
global checks=0;
fn ref(index){return load64(reference+16+index*8);}
fn ck(ok,text){if !ok{h_print(2,h_cat3("Board check ",h_int(checks),h_cat3(": ",text,"\n")));syscall(60,1,0,0,0,0,0);}checks=checks+1;return 0;}
fn read(s,address){let result=se_bus(s,address,4,0,0);ck(result>=0,"read register");return result;}
fn write(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"write register");return 0;}
fn tick(s,delta){ck(se_advance(s,delta)==0,"advance virtual clock");return 0;}
fn uart_count(s,base){return (read(s,base+ref(5))&ref(101))>>ref(13);}
fn uart_fsm(s,base){return (read(s,base+ref(86))&ref(88))>>ref(87);}
fn uart_setup(s,id,format,divider){let base=ref(1+id);write(s,ref(61),read(s,ref(61))|ref(63+id));if ref(0){write(s,base+ref(97),ref(98)|(1<<20));}else{format=format|ref(96);}write(s,base+ref(6),format);write(s,base+ref(11),divider);write(s,base+ref(90),0);write(s,base+ref(7),0);write(s,base+ref(8),0);write(s,base+ref(10),0xffffffff);return format;}
fn test_uart(s){let id=0;let input=alloc(129);let i=0;while i<129{store8(input+i,(i*73+19)&255);i=i+1;}
 while id<3{let base=ref(1+id);let cfg=uart_setup(s,id,0x1c,80);let u=se_uart(s,id);let period=800;let history=load64(u+8);
  ck(uart_fsm(s,base)==0 && (read(s,base+ref(5))&ref(100)),"TX idle and high line");
  write(s,base,0x55);tick(s,1);ck(uart_count(s,base)==0,"FIFO excludes active shift-register byte");ck(uart_fsm(s,base)!=0 && !(read(s,base+ref(5))&ref(100)),"start bit and active FSM");tick(s,79);ck(read(s,base+ref(5))&ref(100),"data bit zero at baud boundary");if !ref(0){ck(uart_fsm(s,base)==2,"documented classic DATA0 FSM code");}tick(s,80);ck(!(read(s,base+ref(5))&ref(100)),"data bit one at baud boundary");tick(s,560);ck((read(s,base+ref(5))&ref(100)) && uart_fsm(s,base)!=0 && load64(u+8)==history,"stop bit precedes completion");tick(s,79);ck(!(read(s,base+ref(9))&ref(89)),"TX_DONE remains clear during stop bit");tick(s,1);ck(load64(u+8)==history+1 && load8(s+16384+id*65536+history)==0x55 && uart_fsm(s,base)==0,"last stop bit completes byte");ck(read(s,base+ref(9))&ref(89),"TX_DONE latched after completion");write(s,base+ref(10),ref(89));ck(!(read(s,base+ref(9))&ref(89)),"TX_DONE write-one-clear");
  ck(se_uart_feed(s,id,input,128)==128,"RX exact capacity");ck(se_uart_feed(s,id,input,1)== -28,"RX full atomic rejection");ck((read(s,base+ref(5))&ref(12))==128,"RX FIFO count");i=0;while i<128{ck(read(s,base+ref(4))==load8(input+i),"RX ordering");i=i+1;}ck((read(s,base+ref(5))&ref(12))==0,"RX drained");ck(se_uart_feed(s,id,input,129)== -22,"RX invalid size");ck(se_uart_feed(s,id,input,7)==7,"RX wrap refill");i=0;while i<7{ck(read(s,base)==load8(input+i),"RX wrap ordering");i=i+1;}
  history=load64(u+8);i=0;while i<129{write(s,base,load8(input+i));i=i+1;}ck(se_bus(s,base,4,1,99)== -28,"TX full rejection beyond FIFO plus shifter");ck(uart_count(s,base)==128,"128-byte FIFO plus separate active byte");write(s,base+ref(7),127<<ref(84));ck(!(read(s,base+ref(9))&2),"TX threshold before drain");tick(s,period-1);ck(load64(u+8)==history,"TX frame remains pending");tick(s,1);ck(load64(u+8)==history+1 && load8(s+16384+id*65536+history)==19,"first TX frame");ck((read(s,base+ref(9))&2) && uart_count(s,base)==127,"chip-specific TX threshold at shifter refill");write(s,base+ref(7),0);
  let clock=read(s,ref(61));write(s,ref(61),clock&~ref(63+id));tick(s,period*100);ck(load64(u+8)==history+1,"TX gated");write(s,ref(61),clock);tick(s,0);ck(load64(u+8)==history+1,"gated TX phase preserved on re-enable");tick(s,period*127);ck(load64(u+8)==history+128 && uart_count(s,base)==0 && uart_fsm(s,base)!=0,"FIFO empties before final stop bit");
  write(s,ref(68)+ref(72+id)*4,1);write(s,base+ref(8),2);ck(xt_sr(load64(s),226)&2,"UART TX empty IRQ before transmit done");write(s,base+ref(8),ref(89));ck(!(xt_sr(load64(s),226)&2),"TX_DONE IRQ waits for shifter");tick(s,period-1);ck(!(read(s,base+ref(9))&ref(89)),"final frame not prematurely complete");tick(s,1);ck(load64(u+8)==history+129 && uart_fsm(s,base)==0 && (xt_sr(load64(s),226)&2),"TX_DONE after last stop bit");write(s,base+ref(10),ref(89));ck(!(xt_sr(load64(s),226)&2),"TX_DONE IRQ deassertion");i=0;while i<129{ck(load8(s+16384+id*65536+history+i)==load8(input+i),"TX trace order");i=i+1;}
  write(s,base+ref(8),1);ck(se_uart_feed(s,id,input,1)==1,"RX feed IRQ");ck(xt_sr(load64(s),226)&2,"UART RX IRQ");read(s,base);ck(!(xt_sr(load64(s),226)&2),"RX level deassertion");write(s,base+ref(8),0);
  history=load64(u+8);write(s,base,42);write(s,base,43);write(s,base+ref(6),cfg|ref(15));ck(uart_count(s,base)==0,"TX FIFO reset clears queued bytes");ck(uart_fsm(s,base)!=0,"FIFO reset is separate from core transmitter");tick(s,period);ck(load64(u+8)==history+1 && load8(s+16384+id*65536+history)==42,"active byte survives FIFO reset");write(s,base,44);tick(s,period);ck(load64(u+8)==history+1,"held TX FIFO reset discards writes");write(s,base+ref(6),cfg);write(s,base,45);write(s,ref(62),ref(63+id));write(s,ref(62),0);tick(s,period*2);ck(load64(u+8)==history+1 && uart_fsm(s,base)==0 && !(read(s,base+ref(9))&ref(89)),"peripheral reset cancels active frame and preserves past trace");cfg=uart_setup(s,id,0x1c,80);
  write(s,base+ref(6),cfg|ref(93));history=load64(u+8);write(s,base,0xa5);tick(s,799);ck(!(read(s,base+ref(5))&ref(12)),"loopback waits for full frame");tick(s,1);ck((read(s,base+ref(5))&ref(12))==1 && read(s,base)==0xa5,"loopback receives transmitted byte");
  // Consecutive fractional frames carry sub-tick phase, rather than rounding
  // every byte independently. Three 10-bit frames at80+7/16 total2413.125.
  cfg=uart_setup(s,id,0x1c,80|(7<<20));history=load64(u+8);write(s,base,11);write(s,base,22);write(s,base,33);tick(s,2413);ck(load64(u+8)==history+2 && uart_fsm(s,base)!=0,"fractional divider carries frame phase");tick(s,1);ck(load64(u+8)==history+3 && uart_fsm(s,base)==0,"fractional final endpoint");
  // Post-transfer idle is distinct from FIFO-empty and TX_DONE.
  cfg=uart_setup(s,id,0x1c,80);write(s,base+ref(90),3<<ref(91));write(s,base,61);tick(s,800);ck(uart_count(s,base)==0 && uart_fsm(s,base)!=0 && !(read(s,base+ref(9))&ref(89)),"TX idle interval delays TX_DONE");tick(s,239);ck(!(read(s,base+ref(9))&ref(89)),"TX idle interval deadline");tick(s,1);ck(uart_fsm(s,base)==0 && (read(s,base+ref(9))&ref(89)),"TX idle interval completes");
  // Fraction, source and prescaler fields come from independent C metadata.
  cfg=uart_setup(s,id,0x1c,0xffffffff);ck(read(s,base+ref(11))==(ref(94)|ref(95)),"chip-specific divider writable mask");write(s,base+ref(11),80);let factor=80;if ref(0){write(s,base+ref(97),ref(98)|(3<<20)|(2<<ref(99)));factor=6;}else{write(s,base+ref(6),cfg&~ref(96));}history=load64(u+8);write(s,base,71);tick(s,800*factor-1);ck(load64(u+8)==history,"selected source clock interval");tick(s,1);ck(load64(u+8)==history+1,"selected source clock deadline");if ref(0){ck(se_bus(s,base+ref(97),4,1,ref(98)|(2<<20))== -95,"unsupported RC source explicit");ck(se_bus(s,base+ref(97),4,1,ref(98)|(1<<20)|1)== -95,"unsupported fractional source divider explicit");}
  cfg=uart_setup(s,id,0x1c,80);write(s,ref(68)+ref(72+id)*4,6);id=id+1;
 }
}
fn test_uart_quirks(s){let u1=ref(2);let u2=ref(3);let cfg1=uart_setup(s,1,0x1c,80);let cfg2=uart_setup(s,2,0x1c,80);let trace=load64(se_uart(s,2)+8);write(s,u2,81);write(s,u2,82);write(s,u1,91);write(s,u1,92);write(s,u1+ref(6),cfg1|ref(15));let remaining=1;if !ref(0){remaining=0;}ck(uart_count(s,u2)==remaining,"chip-specific UART1 reset coupling");tick(s,1600);let emitted=2;if !ref(0){emitted=1;}ck(load64(se_uart(s,2)+8)==trace+emitted,"coupled reset discards only queued UART2 data");write(s,u1+ref(6),cfg1);let byte=alloc(1);store8(byte,51);ck(se_uart_feed(s,2,byte,1)==1,"reset RX precondition");let result=se_bus(s,u2+ref(6),4,1,cfg2|ref(14));if ref(0){ck(result>=0 && !(read(s,u2+ref(5))&ref(12)),"S3 RX FIFO reset");ck(se_uart_feed(s,2,byte,1)==0,"held RX FIFO reset discards ingress");write(s,u2+ref(6),cfg2);}else{ck(result== -95 && (read(s,u2+ref(5))&ref(12))==1,"original RX reset erratum is explicitly unsupported");read(s,u2);}
 if ref(0){let clock=read(s,u2+ref(97));trace=load64(se_uart(s,2)+8);write(s,u2,101);tick(s,399);write(s,u2+ref(97),clock&~(1<<24));tick(s,5000);ck(load64(se_uart(s,2)+8)==trace,"TX source clock gate holds shifter");ck(se_uart_feed(s,2,byte,1)==1,"RX source clock remains independent");read(s,u2);write(s,u2+ref(97),clock);tick(s,400);ck(load64(se_uart(s,2)+8)==trace,"source clock preserves partial frame");tick(s,1);ck(load64(se_uart(s,2)+8)==trace+1,"source clock resumes final bit");write(s,u2+ref(97),clock&~(1<<25));ck(se_uart_feed(s,2,byte,1)== -5,"RX source clock gate");write(s,u2+ref(97),clock);write(s,u2,102);write(s,u2+ref(97),clock|(1<<26));write(s,u2+ref(97),clock);tick(s,1600);ck(load64(se_uart(s,2)+8)==trace+1 && uart_fsm(s,u2)==0,"TX core reset aborts current frame");}
}
fn timer_value(s,base){write(s,base+ref(45),1<<31);return read(s,base+ref(43))|(read(s,base+ref(44))<<32);}
fn timer_load(s,base,value){write(s,base+ref(48),value);write(s,base+ref(49),value>>32);write(s,base+ref(50),1);return 0;}
fn test_timers(s){let id=0;while id<4{let group=id/2;let base=ref(40+group)+(id&1)*ref(42);let groupbase=ref(40+group);let clock=read(s,ref(61))|ref(66+group);write(s,ref(61),clock);let mode=0;while mode<2{let factor=1;let extra=0;if ref(0){if mode{extra=ref(70);factor=2;}}else{extra=ref(70);}let divider=2+mode*78;let period=divider*factor;let cfg=(divider<<13)|ref(56)|ref(57)|extra;write(s,base,cfg&~ref(57));timer_load(s,base,100);write(s,base,cfg);tick(s,period*8-1);ck(timer_value(s,base)==107,"counter divider phase");tick(s,1);ck(read(s,base+ref(43))==107,"counter latch stability");ck(timer_value(s,base)==108,"counter next tick");write(s,ref(61),clock&~ref(66+group));tick(s,period*100);write(s,ref(61),clock);ck(timer_value(s,base)==108,"timer clock gated");
 write(s,base+ref(46),117);write(s,base+ref(47),0);write(s,base,cfg|ref(55));write(s,groupbase+ref(51),0);tick(s,period*9);ck(read(s,groupbase+ref(52))&(1<<(id&1)),"alarm raw while masked");ck(!(read(s,base)&ref(55)),"alarm self clear");write(s,ref(68)+ref(75+id)*4,1);write(s,groupbase+ref(51),1<<(id&1));ck(xt_sr(load64(s),226)&2,"routed timer IRQ");write(s,groupbase+ref(54),1<<(id&1));ck(!(xt_sr(load64(s),226)&2),"timer ack deassertion");
 write(s,base,cfg&~ref(57));timer_load(s,base,50);write(s,base+ref(46),33);write(s,base,(cfg&~ref(56))|ref(55)|ref(58));tick(s,period*21);ck(timer_value(s,base)==46,"down counter autoreload and remainder");write(s,groupbase+ref(54),1<<(id&1));write(s,base,cfg&~ref(57));let start=((0x12345678&ref(60))<<32)|0xfffffffe;timer_load(s,base,start);write(s,base,cfg);tick(s,period*3);ck(timer_value(s,base)==start+3,"counter retains nonzero high word and carry");write(s,base,cfg&~ref(57));let mask=(ref(60)<<32)|0xffffffff;timer_load(s,base,mask-1);write(s,base,cfg);tick(s,period*3);ck(timer_value(s,base)==1,"chip counter width wrap");write(s,base,cfg&~ref(57));write(s,ref(68)+ref(75+id)*4,6);mode=mode+1;}
 write(s,ref(62),ref(66+group));write(s,ref(62),0);ck(!(read(s,base)&ref(57)) && read(s,groupbase+ref(51))==0 && read(s,groupbase+ref(52))==0,"timer group reset");id=id+1;}}
fn test_gpio(s){let gpio=ref(16);let digital=0x2000;if ref(0){digital=0x1000;}ck(se_gpio_drive(s,4,1)==0,"external input drive");ck(!(read(s,ref(29))&(1<<4)),"input disabled at reset");write(s,ref(79),512|digital);ck(read(s,ref(29))&(1<<4),"input enable admits pad signal");write(s,ref(79),0);ck(!(read(s,ref(29))&(1<<4)),"input disable masks pad signal");ck(se_gpio_drive(s,4,-1)==0,"external input release");write(s,ref(79),512|digital);write(s,ref(80),512|digital);write(s,ref(81),512|digital);write(s,ref(82),512|digital);write(s,ref(37)+21*4,1280);write(s,ref(18),1<<21);write(s,ref(24),1<<21);ck(read(s,ref(17))&(1<<21),"GPIO OUT W1TS latch");ck(read(s,ref(29))&(1<<21),"GPIO driven input");ck(se_gpio_wire(s,21,19)==0,"GPIO wire");ck(read(s,ref(29))&(1<<19),"wired high");write(s,ref(36)+3*4,19|128);ck(se_gpio_signal(s,3)==1,"input matrix pin selection");write(s,ref(36)+3*4,19|128|64);ck(se_gpio_signal(s,3)==0,"input matrix inversion");write(s,ref(37)+21*4,1280|512);ck(!(read(s,ref(29))&(1<<19)),"output matrix inversion");write(s,ref(37)+21*4,1280);write(s,ref(19),1<<21);ck(!(read(s,ref(29))&(1<<19)),"wired low");write(s,ref(21),2);write(s,ref(27),2);ck(read(s,ref(30))&2,"high GPIO bank");write(s,ref(28),2);ck(!(read(s,ref(26))&2),"high GPIO enable clear");
 write(s,ref(68)+ref(71)*4,1);write(s,ref(35)+19*4,ref(69)|(1<<7));write(s,ref(18),1<<21);ck(read(s,ref(31))&(1<<19),"GPIO rising edge latch");ck(xt_sr(load64(s),226)&2,"GPIO routed IRQ");write(s,ref(33),1<<19);ck(!(xt_sr(load64(s),226)&2),"GPIO edge ack");write(s,ref(35)+19*4,ref(69)|(5<<7));write(s,ref(33),1<<19);ck(read(s,ref(31))&(1<<19),"GPIO level reassertion");write(s,ref(19),1<<21);write(s,ref(33),1<<19);ck(!(xt_sr(load64(s),226)&2),"GPIO level cleared");write(s,ref(35)+21*4,4);write(s,ref(18),1<<21);ck(se_gpio_drive(s,19,0)==0 && !(read(s,ref(29))&(1<<21)),"open drain released reads external low");ck(se_gpio_drive(s,19,-1)==0,"release external drive");write(s,ref(35)+19*4,0);write(s,ref(35)+21*4,0);write(s,ref(25),1<<21);write(s,ref(68)+ref(71)*4,6);
 ck(se_bus(s,0x12345000,4,0,0)== -95,"unknown MMIO read rejected");ck(se_bus(s,gpio+3,4,0,0)== -22,"unaligned MMIO rejected");ck(se_bus(s,ref(29),4,1,1)== -13,"GPIO input read only");ck(se_bus(s,ref(37),4,1,511)== -95,"reserved output signal rejected");}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"reference argument");reference=h_read(load64(argv+8));ck(h_file_size==832 && load64(reference)==0x455350534f430001 && load64(reference+8)==102,"C reference shape");let cpu=xt_create();let s=se_create(cpu,ref(0));ck(s>0,"board allocation");ck(se_clock_address(s)==ref(61) && se_timer_base(s)==ref(40) && se_gpio_base(s)==ref(16) && se_matrix_base(s)==ref(68),"independent chip addresses");test_uart(s);test_uart_quirks(s);test_timers(s);test_gpio(s);se_close(s);xt_close(cpu);h_print(1,h_cat3("ESP board model: ",h_int(checks)," checks passed\n"));return 0;}
