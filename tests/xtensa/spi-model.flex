import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global ref=0;
global checks=0;
fn r(i){return load64(ref+32+i*8);}
fn ck(ok,text){if !ok{h_print(2,h_cat3("SPI check ",h_int(checks),h_cat3(": ",text,"\n")));syscall(60,1,0,0,0,0,0);}checks=checks+1;return 0;}
fn wr(s,address,value){let result=se_bus(s,address,4,1,value);if result<0{h_print(2,h_cat3("write address ",h_int(address),h_cat3(" error ",h_int(result),"\n")));}ck(result>=0,"defined write");return 0;}
fn rd(s,address){let value=se_bus(s,address,4,0,0);ck(value>=0,"defined read");return value;}
fn advance(s,n){ck(se_advance(s,n)==0,"advance modeled time");return 0;}
fn apply(s,base){if r(15){wr(s,base,r(15));ck(rd(s,base)&r(15),"UPDATE is asynchronous");advance(s,1);ck(rd(s,base)==0,"UPDATE self clears");}return 0;}
fn setup(s,bus){let base=r(bus-1);let group=(bus-2)*4;wr(s,r(3),rd(s,r(3))|r(bus+3));if r(0){wr(s,base+232,7);}wr(s,base+r(11),0);wr(s,r(43),r(47));wr(s,r(44),r(47));wr(s,r(45),r(47));wr(s,r(46),r(47));wr(s,r(41)+18*4,r(22+group));wr(s,r(41)+21*4,r(23+group));wr(s,r(41)+4*4,r(25+group));wr(s,r(42)+r(24+group)*4,128|19);wr(s,r(48),(1<<18)|(1<<21)|(1<<4));wr(s,r(50)+r(20+bus-2)*4,1);return base;}
fn cases(cpu){let nc=load64(ref+16);let f=ref+32+load64(ref+8)*8;let at=0;while at<nc{let s=se_create(cpu,r(0));let bus=load64(f);let base=setup(s,bus);let mode=load64(f+8);let txlsb=load64(f+16);let rxlsb=load64(f+24);let bits=load64(f+32);let txhi=load64(f+40);let rxhi=load64(f+48);let tx=f+128;let input=tx+64;let expected=input+64;let edges=expected+64;
 let user=r(36)|r(34)|r(35);if ((mode&1)^((mode>>1)&1)){user=user|r(32);}if txhi{user=user|r(37);}if rxhi{user=user|r(38);}wr(s,base+8,(txlsb*r(30))|(rxlsb*r(31)));wr(s,base+r(7),user);wr(s,base+r(9),(r(51)&~1)|(((mode>>1)&1)*r(33)));wr(s,base+r(8),load64(f+56));if r(0){wr(s,base+232,load64(f+64));}wr(s,base+r(12),bits-1);wr(s,base+r(13),bits-1);let i=0;while i<16{wr(s,base+r(10)+i*4,em_u32(tx+i*4));i=i+1;}apply(s,base);if !r(0){wr(s,base+r(11),0);}else{wr(s,base+r(19),r(16));wr(s,base+r(17),0);}
 wr(s,base,r(14));ck(rd(s,base)&r(14),"USR remains set during transfer");let early=!r(0) && (mode&1);ck(se_gpio_level(s,18)==((mode>>1)^early),"initial clock phase");ck(se_gpio_level(s,4)==0,"hardware CS asserts");let elapsed=0;i=0;while i<bits*2{let e=load8(edges+i);let bit=i/2;let shift=7-(bit&7);if rxlsb{shift=bit&7;}let sample=(e>>2)&1;let level=(load8(input+bit/8)>>shift)&1;if !sample{level=!level;}ck(se_gpio_drive(s,19,level)==0,"independent MISO stimulus");let wait=load64(f+80);if mode>>1{wait=load64(f+72);}if i&1{wait=load64(f+72);if mode>>1{wait=load64(f+80);}}if !i && early{wait=0;}advance(s,wait);elapsed=elapsed+wait;ck(se_gpio_level(s,18)==(e&1),"independent SCK edge");if sample{ck(se_gpio_level(s,21)==((e>>1)&1),"MOSI reaches real GPIO matrix pad");}let actual=load8(se_spi(s,bus)+4096+i);ck(actual==e,"independent MOSI/sample edge trace");i=i+1;}
 if early{let tail=load64(f+80);if mode>>1{tail=load64(f+72);}ck(rd(s,base)&r(14),"CPHA1 stays busy for final idle half-cycle");ck(se_gpio_level(s,4)==0,"CS covers final idle half-cycle");advance(s,tail-1);ck(rd(s,base)&r(14),"CPHA1 completion waits for entire idle half-cycle");advance(s,1);elapsed=elapsed+tail;}
 let completion=load64(f+96)*(load64(f+72)+load64(f+80));if completion{ck(rd(s,base)&r(14),"original engine remains busy after CS release");ck(se_gpio_level(s,4)==1,"CS release precedes original completion");advance(s,completion-1);ck(rd(s,base)&r(14),"completion delay is not shortened");ck(!(rd(s,base+r(18))&r(16)),"no early raw completion");advance(s,1);elapsed=elapsed+completion;}
 ck(rd(s,base)==0,"USR clears after complete clock periods and engine delay");ck(se_gpio_level(s,4)==1,"hardware CS releases");ck(rd(s,base+r(18))&r(16),"raw completion latches");ck(!(xt_sr(cpu,226)&2),"completion masked");if r(0){wr(s,base+r(17),r(16));}else{wr(s,base+r(11),528);}ck(xt_sr(cpu,226)&2,"routed completion interrupt");if r(0){wr(s,base+r(19),r(16));ck(rd(s,base+64)==0,"W1TC masked status");}else{wr(s,base+r(11),512);}ck(!(xt_sr(cpu,226)&2),"completion acknowledgement deasserts");
 let rxoffset=0;if rxhi{rxoffset=32;}i=0;while i<64{let value=(rd(s,base+r(10)+(i/4)*4)>>((i&3)*8))&255;let want=load8(tx+i);if i>=rxoffset && i<rxoffset+(bits+7)/8{want=load8(expected+i-rxoffset);}ck(value==want,"independent receive bytes and untouched FIFO bytes");i=i+1;}ck(elapsed==(bits+load64(f+96))*(load64(f+72)+load64(f+80)),"divider-derived total duration including measured completion delay");se_close(s);f=f+1344;at=at+1;}}
fn boundaries(cpu){let bus=2;while bus<=3{let s=se_create(cpu,r(0));let base=r(bus-1);ck(se_bus(s,base,4,0,0)== -5,"disabled bus clock");base=setup(s,bus);wr(s,base+8,0);wr(s,base+r(9),r(51));wr(s,base+r(7),r(36)|r(34)|r(35));wr(s,base+r(8),(3<<12)|(1<<6)|3);wr(s,base+r(12),7);wr(s,base+r(13),7);apply(s,base);ck(se_gpio_drive(s,19,1)==0,"constant independent RX");wr(s,base,r(14));advance(s,1);ck(rd(s,base)&r(14),"no premature completion");let deadline=se_deadline(s);ck(deadline>0,"SPI contributes WAITI deadline");wr(s,r(3),rd(s,r(3))&~r(bus+3));advance(s,1000);wr(s,r(3),rd(s,r(3))|r(bus+3));advance(s,30);ck(rd(s,base)&r(14),"clock gate preserves partial transfer");advance(s,1);if !r(0){ck(rd(s,base)&r(14),"original still busy after final clock");wr(s,r(3),rd(s,r(3))&~r(bus+3));advance(s,1000);wr(s,r(3),rd(s,r(3))|r(bus+3));advance(s,23);ck(rd(s,base)&r(14),"clock gate preserves remaining completion delay");advance(s,1);}ck(rd(s,base)==0,"clock gate resumes exact deadline");wr(s,r(4),r(bus+3));wr(s,r(4),0);ck(rd(s,base)==0,"module reset aborts transaction");ck(!(xt_sr(cpu,226)&2),"reset clears IRQ");
 // Reconfigure after module reset; reject unimplemented modes rather than echo.
 if r(0){wr(s,base+232,7);}wr(s,base+8,0);wr(s,base+r(9),r(51));wr(s,base+r(7),r(36)|r(34)|(1<<17));wr(s,base+r(8),(3<<12)|(1<<6)|3);apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"SIO explicitly unsupported");wr(s,base+r(7),r(36)|r(34));wr(s,base+r(12),512);apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"FIFO oversized transfer rejected");if !r(0){wr(s,base+r(12),(1<<18)|7);ck(se_bus(s,base,4,1,r(14))== -95,"original24-bit length cannot wrap into FIFO");}wr(s,base+r(12),7);wr(s,base+r(7),r(36)|r(34)|r(37));wr(s,base+r(12),256);apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"high-part FIFO bound");ck(se_bus(s,base+r(11),4,1,r(53))== -95,"slave explicitly unsupported");
 // Master source clock bypass has half-CPU-tick edges, with no data loopback shortcut.
 wr(s,base+r(7),r(36)|r(34));wr(s,base+r(12),7);wr(s,base+r(8),r(40));let cs_pol=64;if r(0){cs_pol=128;}wr(s,base+r(9),(r(51)&~1)|(1<<30)|cs_pol);wr(s,base+r(10),0x12345696);apply(s,base);wr(s,base,r(14));ck(se_gpio_level(s,4)==1,"active-high CS asserts");advance(s,1);ck(load64(se_spi(s,bus)+16)==2,"source-clock bypass retains half-tick edges");advance(s,6);ck(rd(s,base)&r(14),"TX-only remains busy before eighth clock");advance(s,1);if !r(0){advance(s,6);}ck(rd(s,base)==0 && rd(s,base+r(10))==0x12345696,"TX-only leaves FIFO unchanged");ck(se_gpio_level(s,4)==1,"CS_KEEP_ACTIVE retains asserted CS");
 wr(s,base+r(7),r(36)|r(35));wr(s,base+r(13),7);wr(s,base+r(9),(r(51)&~1)|cs_pol);apply(s,base);if r(0){wr(s,base+r(13),31);}wr(s,base,r(14));advance(s,3);if r(0){wr(s,base+232,5);advance(s,1000);wr(s,base+232,7);}advance(s,4);ck(rd(s,base)&r(14),"RX-only waits for final clock");advance(s,1);if !r(0){advance(s,6);}ck(rd(s,base)==0 && rd(s,base+r(10))==0x123456ff,"RX-only samples external MISO and preserves other bits");ck(se_gpio_level(s,4)==0,"active-high CS deasserts");
 wr(s,base,r(14));advance(s,1);wr(s,r(4),r(bus+3));wr(s,r(4),0);ck(rd(s,base)==0 && rd(s,base+r(10))==0,"reset aborts busy transaction and clears FIFO");se_close(s);bus=bus+1;}}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"reference argument");ref=h_read(load64(argv+8));ck(load64(ref)==0x5350495245460001 && load64(ref+8)==54 && load64(ref+16)==416 && h_file_size==32+54*8+416*1344,"independent C reference shape");let cpu=xt_create();cases(cpu);boundaries(cpu);xt_close(cpu);h_print(1,h_cat3("SPI model: ",h_int(checks)," checks passed\n"));return 0;}
