// Independent GNU CPU transactions: precommit IRQ is explicitly device-owned.
import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global pm_checks=0;global pm_case=0;global pm_gnu=0;
fn check(ok,message){pm_checks=pm_checks+1;if !ok{h_print(2,h_cat3("Preempt MMIO case ",h_int(pm_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn fresh(){let c=xt_create();let code=xt_map(c,0x1000,4096,5);em_copy(code,pm_gnu,12);em_copy(code+0x300,pm_gnu+6,3);xt_wsr(c,231,0x1000);xt_setreg(c,1,0x5000);xt_setreg(c,4,0x13579bdf);store64(c+128,0x1000);return c;}
fn issue(c,run){let before=load64(c+176);check(xt_run_slice(c,run,1000,before+1)==6 && load64(c+192)==5 && load64(c+176)==before && load64(c+128)==0x1000 && xt_reg(c,4)==0x13579bdf,"GNU load has anuncommitted device transaction");store64(run+40,0xaabbccdd);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU input required");pm_gnu=h_read(load64(argv+8));check(h_file_size==12,"GNU load/progress/RFE/store bytes");check(xt_mmio_preempt(0)== -22,"null CPU preemption isrejected");let run=alloc(4096);em_zero(run,4096);let c=fresh();check(xt_mmio_preempt(c)== -22,"no pending read cannotbe preempted");issue(c,run);let guard=0;while guard<6{pm_case=guard;xt_interrupt(c,2);xt_wsr(c,228,2);xt_wsr(c,230,0);let expected= -11;if guard==0{xt_interrupt(c,0);}if guard==1{xt_wsr(c,228,0);}if guard==2{xt_wsr(c,230,1);}if guard==3{xt_wsr(c,230,15);}if guard==4{xt_wsr(c,230,16);}if guard==5{store64(c+160,-14);expected= -22;}check(xt_mmio_preempt(c)==expected && load64(c+192)==5 && !load64(c+176) && load64(c+128)==0x1000 && xt_reg(c,4)==0x13579bdf,"no IRQ,disabledINTENABLE,INTLEVEL,EXCM andfault guards preservependingread");store64(c+160,0);guard=guard+1;}
 pm_case=10;xt_interrupt(c,2);xt_wsr(c,228,2);xt_wsr(c,230,0);let other=fresh();let peer=alloc(4096);issue(other,peer);xt_wsr(c,0,0x1000);xt_wsr(c,1,0x1003);xt_wsr(c,2,1);check(xt_mmio_preempt(c)==0 && !load64(c+192) && !load64(c+176) && load64(c+128)==0x1000 && xt_reg(c,4)==0x13579bdf && xt_sr(c,2)==1 && !load64(c+248),"explicit preemption discardsreply withoutcommitting PC,register,loop orIRQentry");check(load64(other+192)==5 && !load64(other+176) && xt_reg(other,4)==0x13579bdf,"preemptingone CPU preservesanother pendingread");check(xt_mmio_preempt(c)== -22,"already-preempted load cannotbe canceled twice");check(xt_step(c)==0 && load64(c+248)==1 && xt_sr(c,177)==0x1000 && load64(c+128)==0x1000 && load64(c+176)==1 && xt_reg(c,4)==0x13579bdf && xt_sr(c,2)==1,"actual IRQ entry/RFE preserves faultingPC anduncommitted destination");xt_interrupt(c,0);issue(c,run);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==2 && xt_reg(c,4)==0xaabbccdd && load64(c+128)==0x1000 && !xt_sr(c,2) && !load64(c+192),"retry commits one result andadvances hardwareloop onlyonce");xt_wsr(c,0,0);xt_wsr(c,1,0);xt_setreg(c,4,0x13579bdf);issue(c,run);check(xt_run_slice(c,run,1000,3)==10 && load64(c+176)==3 && load64(c+128)==0x1003 && xt_reg(c,4)==0xaabbccdd,"later loopiteration is anindependent transaction");check(xt_run_slice(c,run,1000,4)==10 && xt_reg(c,2)==42 && load64(c+176)==4 && load64(c+128)==0x1006,"next GNU instruction executesafter successful retriedload");xt_close(c);
 pm_case=20;xt_interrupt(other,2);xt_wsr(other,228,2);xt_wsr(other,230,0);check(xt_run_slice(other,peer,1000,1)==10 && load64(other+176)==1 && xt_reg(other,4)==0xaabbccdd && load64(other+128)==0x1003 && !load64(other+248),"default deferredMMIO stillcommits beforeIRQ whennotoptedin");check(xt_step(other)==0 && load64(other+248)==1 && xt_sr(other,177)==0x1003 && xt_reg(other,4)==0xaabbccdd,"default IRQ sees alreadycommitted destination andnextPC");xt_close(other);
 pm_case=30;c=fresh();store64(c+128,0x1009);check(xt_run_slice(c,run,1000,1)==6 && load64(c+176)==1 && load64(c+128)==0x100c && !load64(c+192),"GNU store exits afterarchitecturalcommit");xt_interrupt(c,2);xt_wsr(c,228,2);check(xt_mmio_preempt(c)== -22 && load64(c+176)==1 && load64(c+128)==0x100c,"readpreemption neverrewinds anissued store");xt_close(c);syscall(11,run,4096,0,0,0,0);syscall(11,peer,4096,0,0,0,0);h_print(1,h_cat3("Preempt CPU MMIO: ",h_int(pm_checks)," checks passed\n"));return 0;}
