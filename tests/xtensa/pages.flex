import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global pc_checks=0;global pc_case=0;global pc_code=0;
fn check(ok,message){pc_checks=pc_checks+1;if !ok{h_print(2,h_cat3("Page case ",h_int(pc_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c){store64(c+160,0);store64(c+168,0);return 0;}
fn pattern(page,offset){return ((offset*13+page*47)^0xa5)&255;}
fn valid(){let pages=alloc(128);let gate=alloc(8);let c=xt_create();em_zero(pages,128);store64(gate,1);let before=load64(c+144);let i=0;while i<12{pc_case=i;let address=0x10000000;let size=65536;let flags=5;let p=pages;let g=gate;let shift=16;if i==0{address=address+1;}if i==1{size=size-1;}if i==2{size=0;}if i==3{size=67108865;}if i==4{flags=3;}if i==5{p=0;}if i==6{p= -8;}if i==7{p=p+1;}if i==8{g=g+1;}if i==9{g= -8;}if i==10{shift=11;}if i==11{shift=21;}check(xt_map_pages(c,address,size,flags,p,g,shift)== -22 && load64(c+144)==before,"invalid mapping rejected atomically");i=i+1;}
 check(xt_map(c,0x10000000,4096,3)>0,"ordinary RAM mapping");before=load64(c+144);check(xt_map_pages(c,0x10000000,65536,5,pages,gate,16)== -22 && load64(c+144)==before,"paged map cannot overlap ordinary memory");xt_close(c);c=xt_create();check(xt_map_pages(c,0x10000000,65536,5,pages,gate,16)>0,"valid readonly executable page region");before=load64(c+144);check(xt_map(c,0x10000010,8,3)== -22 && xt_map_pages(c,0x10000000,65536,1,pages,gate,16)== -22 && load64(c+144)==before,"ordinary and paged map overlap checks are symmetric");xt_close(c);syscall(11,pages,128,0,0,0,0);syscall(11,gate,8,0,0,0,0);return 0;}
fn translate(){let shift=12;while shift<=20{let bytes=1<<shift;let backing=alloc(bytes*4);let pages=alloc(32);let gate=alloc(8);store64(gate,1);store64(pages,backing+bytes*2);store64(pages+8,backing);store64(pages+16,backing+bytes);store64(pages+24,0);let j=0;while j<4{let i=0;while i<bytes{store8(backing+j*bytes+i,pattern(j,i));i=i+1;}j=j+1;}let c=xt_create();check(xt_map_pages(c,0x10000000,bytes*4,5,pages,gate,shift)>0,"all supported page sizes");let page=0;while page<3{let offset=0;while offset<bytes{let count=1;while count<=8{pc_case=shift*100000+page*10000+offset;let expected=0;let k=0;let fault=0;while k<count{let which=(page*bytes+offset+k)/bytes;let at=(offset+k)&(bytes-1);if which>=3{fault=1;}else{let actual=0;if which==0{actual=2;}if which==2{actual=1;}expected=expected|(pattern(actual,at)<<(k*8));}k=k+1;}clear(c);let got=xt_read(c,0x10000000+page*bytes+offset,count);if fault{check(load64(c+160)== -14 && load64(c+168)==0x10000000+bytes*3,"unmapped tail reports first inaccessible byte");}else{check(!load64(c+160) && got==expected,"page permutation and noncontiguous cross-page reads");}count=count+1;}if offset<bytes-32{offset=offset+251;if offset>=bytes-32{offset=bytes-32;}}else{offset=offset+1;}}page=page+1;}
 clear(c);check(xt_read(c,0x10000000+bytes*3+31,4)==0 && load64(c+160)== -14 && load64(c+168)==0x10000000+bytes*3+31,"wholly unmapped page cannot alias the first physical page");clear(c);store64(gate,0);check(xt_read(c,0x10000001,1)==0 && load64(c+160)== -5 && load64(c+168)==0x10000001,"disabled gate faults before exposing a host pointer");clear(c);store64(gate,1);check(xt_write(c,0x10000000,4,0x12345678)== -1 && load64(c+160)== -13,"paged mappings never permit stores");clear(c);store64(pages,backing);check(xt_read(c,0x10000000,1)==pattern(0,0),"device can publish a new translation");let other=xt_create();let other_pages=alloc(32);store64(other_pages,backing+bytes);store64(other_pages+8,0);store64(other_pages+16,0);store64(other_pages+24,0);check(xt_map_pages(other,0x10000000,bytes*4,1,other_pages,0,shift)>0,"second CPU owns a different page table");check(xt_read(other,0x10000000,1)==pattern(1,0) && xt_read(c,0x10000000,1)==pattern(0,0),"per-machine translations remain isolated");clear(other);check(!xt_pointer(other,0x10000000,1,5) && load64(other+160)== -13,"data page cannot be fetched as code");xt_close(c);xt_close(other);check(load8(backing)==pattern(0,0),"closing CPU mappings does not unmap caller-owned pages");syscall(11,other_pages,32,0,0,0,0);syscall(11,backing,bytes*4,0,0,0,0);syscall(11,pages,32,0,0,0,0);syscall(11,gate,8,0,0,0,0);shift=shift+1;}return 0;}
fn fetches(){let backing=alloc(196608);let pages=alloc(16);let gate=alloc(8);store64(pages,backing+65536);store64(pages+8,backing);store64(gate,1);let c=xt_create();check(xt_map_pages(c,0x400d0000,131072,5,pages,gate,16)>0,"instruction translation region");let n=1;while n<=3{let pc=0x400e0000-n;let i=0;while i<3{let offset=65536-n+i;let p=backing+65536+offset;if offset>=65536{p=backing+offset-65536;}store8(p,load8(pc_code+i));i=i+1;}clear(c);store64(c+128,pc);xt_setreg(c,2,0x12345678);let before=load64(c+176);check(xt_step(c)==0 && xt_reg(c,2)==0xffffffef && load64(c+176)==before+1 && load64(c+128)==pc+3,"GNU24-bit instruction fetch spans unrelated backing pages");n=n+1;}
 store8(backing+131071,load8(pc_code+3));store8(backing,load8(pc_code+4));store64(c+128,0x400dffff);let before=load64(c+176);check(xt_step(c)==0 && load64(c+176)==before+1 && load64(c+128)==0x400e0001,"GNU density instruction fetch crosses page boundary");store64(gate,0);store64(c+128,0x400dffff);before=load64(c+176);check(xt_step(c)== -1 && load64(c+160)== -5 && load64(c+176)==before,"gate-disabled code cannot retire");clear(c);store64(gate,1);store64(pages+8,0);store64(c+128,0x400dffff);check(xt_step(c)== -1 && load64(c+160)== -14 && load64(c+168)==0x400e0000 && load64(c+176)==before,"unmapped second instruction fragment is precise and unretired");xt_close(c);syscall(11,pages,16,0,0,0,0);syscall(11,gate,8,0,0,0,0);syscall(11,backing,196608,0,0,0,0);return 0;}
fn unmaps(){let c=xt_create();let page=alloc(65536);let pages=alloc(8);let gate=alloc(8);store64(pages,page);store64(gate,1);let ram=xt_map(c,0x1000,4096,3);check(ram>0 && xt_map_pages(c,0x10000000,65536,1,pages,gate,16)>0 && xt_map(c,0x2000,4096,3)>0,"surrounding normal regions");store8(page,0x6a);check(xt_unmap_pages(c,0x1000)== -22 && xt_unmap_pages(c,0xdead0000)== -22 && load64(c+144)==3,"device detach cannot remove RAM or absent regions");check(xt_unmap_pages(c,0x10000000)==0 && load64(c+144)==2 && xt_read(c,0x1000,1)==0 && xt_read(c,0x2000,1)==0 && !load64(c+160),"removal compacts region records without losing ordinary memory");clear(c);check(xt_read(c,0x10000000,1)==0 && load64(c+160)== -14 && load8(page)==0x6a,"detached view faults and retains caller-owned frames");clear(c);check(xt_map_pages(c,0x10000000,65536,1,pages,gate,16)>0 && xt_read(c,0x10000000,1)==0x6a,"device can reattach the same virtual address");xt_close(c);syscall(11,page,65536,0,0,0,0);syscall(11,pages,8,0,0,0,0);syscall(11,gate,8,0,0,0,0);return 0;}
fn elf_guard(){let c=xt_create();let backing=alloc(65536);let pages=alloc(8);store64(pages,backing);check(xt_map_pages(c,0x400d0000,65536,5,pages,0,16)>0,"ELF paged destination fixture");let p=alloc(160);em_zero(p,160);em_put32(p,0x464c457f);store8(p+4,1);store8(p+5,1);store8(p+6,1);store8(p+16,2);store8(p+18,94);em_put32(p+20,1);em_put32(p+24,0x400d0000);em_put32(p+28,52);store8(p+40,52);store8(p+42,32);store8(p+44,1);let h=p+52;em_put32(h,1);em_put32(h+4,128);em_put32(h+8,0x400d0000);em_put32(h+16,3);em_put32(h+20,8);em_put32(h+24,5);em_put32(h+28,1);store8(backing,0x5a);check(xt_load_elf(c,p,160)== -22 && load8(backing)==0x5a,"normal ELF loader cannot bypass paged-device ownership");xt_close(c);syscall(11,backing,65536,0,0,0,0);syscall(11,pages,8,0,0,0,0);syscall(11,p,160,0,0,0,0);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"GNU instruction bytes required");pc_code=h_read(load64(argv+8));check(h_file_size==11,"GNU mixed24/16-bit fixture shape");valid();translate();fetches();unmaps();elf_guard();h_print(1,h_cat3("CPU pages: ",h_int(pc_checks)," checks passed\n"));return 0;}
