import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global rr=0;global rc=0;global context=0;
fn r(i){return load64(rr+32+i*8);}
fn ck(ok,text){rc=rc+1;if !ok{h_print(2,h_cat3("RMT case ",h_int(context),h_cat3(" check ",h_int(rc),h_cat3(": ",text,"\n"))));syscall(60,1,0,0,0,0,0);}return 0;}
fn wr(s,a,v){let result=se_bus(s,a,4,1,v);if result<0{h_print(2,h_cat3("MMIO ",h_int(a),h_cat3(" result ",h_int(result),"\n")));}ck(result>=0,"defined write");return 0;}
fn rd(s,a){let v=se_bus(s,a,4,0,0);ck(v>=0,"defined read");return v;}
fn tick(s,n){ck(se_advance(s,n)==0,"advance devices");return 0;}
fn conf(ch){return r(0)+r(6)+ch*r(7);}
fn init(cpu){let s=se_create(cpu,0);wr(s,r(2),rd(s,r(2))|r(4));wr(s,r(0)+r(13),r(32));wr(s,conf(0),r(18));wr(s,r(41),r(46));wr(s,r(42),r(46));wr(s,r(44),r(46));wr(s,r(45),(1<<21));ck(se_gpio_wire(s,21,19)==0,"actual virtual wire");wr(s,r(39)+19*4,256);wr(s,r(39)+21*4,256);return s;}
fn cfg(s,ch,blocks,divider,idle,filter,tx){let c=conf(ch);let v=divider|(idle<<8)|r(63+blocks);if !ch{v=v|r(18);}wr(s,c,v);let u=r(20)|r(21);if tx{u=r(20)|r(28);}if filter{u=u|r(30)|(filter<<r(63));}wr(s,c+4,u);wr(s,r(40)+(r(36)+ch)*4,128|19);if tx{wr(s,r(39)+21*4,r(37)+ch);}return u;}
fn drive(s,level){let a=r(49);if level{a=r(48);}wr(s,a,1<<21);return 0;}
fn capture(cpu){let ch=0;while ch<8{let blocks=1;while blocks<=8-ch{context=ch*16+blocks;let s=init(cpu);let u=cfg(s,ch,blocks,80,2000,0,0);let memory=r(1)+ch*256;let count=blocks*64-3;let cap=blocks*64;let i=0;while i<cap{wr(s,memory+i*4,0xf0a5963c);i=i+1;}wr(s,conf(ch)+4,u|r(24));wr(s,conf(ch)+4,u);wr(s,conf(ch)+4,u|r(22));ck((rd(s,r(0)+r(8)+ch*4)&r(55))==ch*64,"initial absolute write pointer");ck((rd(s,r(0)+r(8)+ch*4)&r(58))==(4<<r(59)),"RX waiting state");
 i=0;while i<count{drive(s,1);tick(s,80*(10+(i&7)));drive(s,0);tick(s,80*(20+((i>>3)&7)));i=i+1;}tick(s,160000);ck(rd(s,r(0)+r(9))&(1<<(ch*3+1)),"RX-end interrupt");ck(!(rd(s,r(0)+r(9))&(1<<(ch*3+2))),"no memory overflow");ck((rd(s,r(0)+r(8)+ch*4)&r(55))==ch*64+count,"complete word count");i=0;while i<count{let expected=0x8000|10+(i&7);if i<count-1{expected=expected|((20+((i>>3)&7))<<16);}ck(rd(s,memory+i*4)==expected,"independent pulse lengths and final idle omission");i=i+1;}ck(rd(s,memory+count*4)==0xf0a5963c,"memory outside complete capture untouched");
 wr(s,r(0)+r(11),1<<(ch*3+1));ck(!(xt_sr(cpu,226)&2),"unrouted RMT IRQ");wr(s,r(47)+r(38)*4,1);ck(xt_sr(cpu,226)&2,"RMT source routes native IRQ");wr(s,r(0)+r(12),1<<(ch*3+1));ck(!(xt_sr(cpu,226)&2),"RX W1TC deasserts IRQ");se_close(s);blocks=blocks+1;}ch=ch+1;}}
fn transmit(cpu){let ch=0;while ch<8{let step=0;while step<3{context=200+ch*4+step;let s=init(cpu);let divider=8;if step==1{divider=80;}if step==2{divider=0;}let factor=divider;if !factor{factor=256;}let u=cfg(s,ch,1,divider,2000,0,1);let memory=r(1)+ch*256;wr(s,memory,7|0x8000|(11<<16));wr(s,memory+4,13|(17<<16)|0x80000000);wr(s,memory+8,0);wr(s,conf(ch)+4,u|r(25));wr(s,conf(ch)+4,u);wr(s,r(47)+r(38)*4,1);wr(s,conf(ch)+4,u|r(23));ck(se_gpio_level(s,19)==1,"first TX symbol routed through GPIO");ck((rd(s,r(0)+r(8)+ch*4)&r(58))==(1<<r(59)),"TX sending state");tick(s,7*factor-1);ck(se_gpio_level(s,19)==1 && !(rd(s,r(0)+r(9))&(1<<(ch*3))),"no early edge/completion");tick(s,1);ck(se_gpio_level(s,19)==0,"first falling edge");tick(s,11*factor);ck(se_gpio_level(s,19)==0,"next half has same level");ck((rd(s,r(0)+r(8)+ch*4)&r(56))==((ch*64+1)<<r(57)),"C-positioned TX read pointer");tick(s,13*factor);ck(se_gpio_level(s,19)==1,"next rising edge");tick(s,17*factor);ck(se_gpio_level(s,19)==0 && (rd(s,r(0)+r(9))&(1<<(ch*3))),"EOF restores idle and completes");ck(rd(s,r(0)+r(10))==0 && !(xt_sr(cpu,226)&2),"completion IRQ masked");wr(s,r(0)+r(11),1<<(ch*3));ck(rd(s,r(0)+r(10))==(1<<(ch*3)) && (xt_sr(cpu,226)&2),"masked IRQ status and CPU delivery");wr(s,r(0)+r(12),1<<(ch*3));ck(!rd(s,r(0)+r(9)),"TX W1TC");se_close(s);step=step+1;}ch=ch+1;}}
fn boundaries(cpu){let off=se_create(cpu,0);ck(se_bus(off,r(0)+r(9),4,0,0)== -5,"disabled RMT bus faults");se_close(off);let s=init(cpu);context=400;let u=cfg(s,7,1,80,100,0,0);wr(s,conf(7)+4,u|r(24));wr(s,conf(7)+4,u|r(22));let i=0;while i<130{drive(s,!(i&1));tick(s,80);i=i+1;}ck(rd(s,r(0)+r(9))&(1<<23),"RX overflow error");ck(rd(s,r(0)+r(8)+28)&r(53),"RX memory full status");wr(s,r(0)+r(12),0xffffffff);wr(s,conf(7)+4,r(20));wr(s,conf(7)+4,r(20)|r(22));ck((rd(s,r(0)+r(9))&(1<<23)) && (rd(s,r(0)+r(8)+28)&r(52)),"RX wrong-owner hardware error");
 wr(s,r(3),r(5));wr(s,r(3),0);ck(!rd(s,r(0)+r(9)) && !rd(s,r(0)+r(11)),"reset clears active/interrupt state");ck(rd(s,conf(0))==r(16) && rd(s,conf(7)+4)==r(17),"C-packed register reset values");ck(se_bus(s,r(0)+r(9),4,1,0)== -13,"raw IRQ read-only");ck(se_bus(s,r(1),2,0,0)== -22,"memory requires aligned32-bit access");se_close(s);
 s=init(cpu);u=cfg(s,0,1,8,100,0,1);wr(s,r(1),100|0x8000|(100<<16));wr(s,r(1)+4,0);wr(s,conf(0)+4,u|r(23));tick(s,400);wr(s,r(2),rd(s,r(2))&~r(4));tick(s,1000000);wr(s,r(2),rd(s,r(2))|r(4));tick(s,399);ck(se_gpio_level(s,19)==1,"gate preserves exact partial duration");tick(s,1);ck(se_gpio_level(s,19)==0,"ungate resumes TX edge");tick(s,800);ck(rd(s,r(0)+r(9))&1,"ungated TX completes");se_close(s);
 s=init(cpu);u=cfg(s,0,1,1,100,0,1);wr(s,r(1),2|0x8000|(3<<16));wr(s,r(1)+4,0);wr(s,conf(0)+4,(u&~r(20))|r(23));tick(s,159);ck(se_gpio_level(s,19)==1,"REF_TICK source clock");tick(s,1);ck(se_gpio_level(s,19)==0,"REF_TICK edge");tick(s,240);ck(rd(s,r(0)+r(9))&1,"REF_TICK completes");se_close(s);
 s=init(cpu);u=cfg(s,0,1,1,200,10,0);wr(s,conf(0)+4,u|r(24));wr(s,conf(0)+4,u|r(22));drive(s,1);tick(s,5);drive(s,0);tick(s,20);ck((rd(s,r(0)+r(8))&r(55))==0,"filter rejects short pulse");drive(s,1);tick(s,40);drive(s,0);tick(s,300);ck(rd(s,r(1))==(0x8000|40),"filter preserves full pulse duration");ck(rd(s,r(0)+r(9))&2,"filtered RX completes");se_close(s);return 0;}
fn interleave(cpu){context=500;let s=init(cpu);let rx=cfg(s,1,1,80,2000,0,0);let tx=cfg(s,0,1,80,2000,0,1);wr(s,r(1),7|0x8000|(11<<16));wr(s,r(1)+4,13|(17<<16)|0x80000000);wr(s,r(1)+8,0);wr(s,conf(1)+4,rx|r(24));wr(s,conf(1)+4,rx|r(22));wr(s,conf(0)+4,tx|r(23));tick(s,1000000);ck(rd(s,r(0)+r(9))&1,"interleaved TX completion");ck(rd(s,r(0)+r(9))&(1<<4),"interleaved RX completion");ck(rd(s,r(1)+256)==(0x8000|7|(24<<16)),"large advance retains every edge and merges equal levels");ck(rd(s,r(1)+260)==(0x8000|17),"large advance retains terminal pulse");se_close(s);return 0;}
fn unsupported(cpu){context=600;let s=init(cpu);let u=cfg(s,0,1,80,100,0,1);wr(s,r(1),10|32768|(10<<16));wr(s,r(1)+4,0);let c=rd(s,conf(0));wr(s,conf(0),c|r(34));ck(se_bus(s,conf(0)+4,4,1,u|r(23))== -95,"carrier explicitly unsupported");wr(s,conf(0),c);ck(se_bus(s,conf(0)+4,4,1,u|r(35)|r(23))== -95,"TX looping explicitly unsupported");wr(s,r(0)+r(13),r(32)|r(33));ck(se_bus(s,conf(0)+4,4,1,u|r(23))== -95,"TX wrap explicitly unsupported");wr(s,r(0)+r(13),0);ck(se_bus(s,r(1),4,0,0)== -95,"FIFO-mode memory access explicitly unsupported");ck(se_bus(s,r(0),4,0,0)== -95,"legacy FIFO access explicitly unsupported");se_close(s);return 0;}
fn eof_idle(cpu){let fixed=0;while fixed<2{let ending=0;while ending<2{context=700+fixed*2+ending;let s=init(cpu);let u=cfg(s,0,1,80,100,0,1);if !fixed{u=u&~r(28);}let opposite=1-ending;wr(s,r(1),4|(opposite<<15)|((ending<<15)<<16));wr(s,conf(0)+4,u|r(23));ck(se_gpio_level(s,19)==opposite,"EOF test begins with opposite level");tick(s,320);let want=ending;if fixed{want=0;}ck(se_gpio_level(s,19)==want,"EOF level or fixed idle override");ck(rd(s,r(0)+r(9))&1,"EOF completes TX");se_close(s);ending=ending+1;}fixed=fixed+1;}return 0;}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"reference argument");rr=h_read(load64(argv+8));ck(load64(rr)==0x524d544d4f440001 && load64(rr+8)==72 && h_file_size==32+72*8,"C reference shape");let cpu=xt_create();capture(cpu);transmit(cpu);boundaries(cpu);interleave(cpu);unsupported(cpu);eof_idle(cpu);xt_close(cpu);h_print(1,h_cat3("RMT model: ",h_int(rc)," checks passed\n"));return 0;}
