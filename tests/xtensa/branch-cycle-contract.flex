import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Branch cycle case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn setup(offset){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,771);store64(c+128,0x2000+offset);xt_setreg(c,7,0x13579bdf);return c;}
fn advance(c,n){let cc=xt_sr(c,234);let result=xt_cycle_clock(c,load64(c+336)+n);if result{return result;}xt_wsr(c,234,cc+n);return 0;}
fn finish(c,run,limit){let tries=0;while load64(c+176)<limit{let reason=xt_run_slice(c,run,1000,limit);if reason==13{let wait=xt_cycle_wait(c);ck(wait>0 && advance(c,wait)==0 && xt_cycle_ack(c)==0,"release exact pending frontend interval");}else{ck(reason==10,"CPU completes requested retirement boundary");}tries=tries+1;ck(tries<32,"branch fixture makes bounded progress");}return 0;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"board clock/timer fixture register");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"complete PLL fixture transaction");return 0;}
fn clocks(run){let mode=0;while mode<4{let phase=0;while phase<6{let aligned=0;while aligned<2{context=1000+mode*100+phase*10+aligned;let offset=0;if aligned{offset=0xb0;}let c=setup(offset);let s=se_create(c,0);let qpc=6;if mode==0{wr(s,0x3ff48070,0x3210);qpc=12;}if mode==2{wr(s,0x3ff0003c,1);qpc=3;}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);qpc=2;}
 store64(c+176,phase);ck(se_sync(s)==0,"initial fractional CPU phase");wr(s,se_clock_address(s),se_bus(s,se_clock_address(s),4,0,0)|(1<<13));wr(s,0x3ff5f000,0x40004000);wr(s,0x3ff5f018,0);wr(s,0x3ff5f01c,0);wr(s,0x3ff5f020,1);wr(s,0x3ff5f000,0xc0004000);let before=load64(s+16);let fractional=load64(se_clock(s)+24);xt_wsr(c,234,0xfffffffd);let cost=5-aligned;
 ck(se_run_slice(s,run,1000,phase+1)==10 && load64(c+176)==phase+1 && !load64(se_clock(s)+152),"branch commits once before its frontend delay");ck(xt_reg(c,7)==0x13579bdf && load64(c+128)==0x2003+aligned*0xb1,"destination is committed but not executed");
 ck(se_run_slice(s,run,1000,phase+2)==10 && load64(c+176)==phase+2 && xt_reg(c,7)==2-aligned && xt_sr(c,234)==3-aligned,"board charges measured target alignment and CCOUNT wrap without extra retirement");ck(load64(se_clock(s)+152)==cost-1 && se_cpu_cycles(s)==phase+cost+1 && !load64(c+368),"board consumes exact frontend event once");let ticks=(fractional+(cost+1)*qpc)/6;ck(load64(s+16)==before+ticks && load64(se_clock(s)+24)==(fractional+(cost+1)*qpc)%6,"branch waits preserve sub-reference-tick CPU phase");wr(s,0x3ff5f00c,1);ck(se_bus(s,0x3ff5f004,4,0,0)==ticks/se_apb_factor(s)/2,"APB timer advances across branch delay");se_close(s);xt_close(c);aligned=aligned+1;}phase=phase+1;}mode=mode+1;}return 0;}
fn main(argc,argv){
 h_environment(argc,argv);ck(argc==2,"GNU input");gnu=h_read(load64(argv+8));ck(h_file_size==771,"GNU fixture size");let run=alloc(4096);em_zero(run,4096);
 context=1;let c=setup(0);ck(xt_run_slice(c,run,1000,2)==10 && xt_reg(c,7)==1 && !load64(c+384),"standalone functional profile retains single-cycle transfers");xt_close(c);
 context=2;c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,1000,1)==10 && load64(c+176)==1 && load64(c+128)==0x2003,"taken J to next instruction still commits a real transfer");ck(xt_cycle_profile(c,0)==-16 && !load64(c+368),"unmaterialized frontend readiness cannot be disabled");xt_wsr(c,0,0x2009);xt_wsr(c,1,0x2006);xt_wsr(c,2,1);ck(xt_step(c)==13 && xt_cycle_wait(c)==4 && load64(c+376)==0x2003 && load64(c+128)==0x2003 && xt_reg(c,7)==0x13579bdf && load64(c+176)==1 && xt_sr(c,2)==1,"target waits before fetch/register/loop execution");ck(xt_run_slice(c,run,1000,1)==13 && load64(run+8)==13 && xt_cycle_ack(c)==-11,"pending frontend event persists through zero-budget polls and early ack");xt_wsr(c,234,0xfffffff0);ck(xt_cycle_wait(c)==4,"CCOUNT rewrite cannot move branch readiness");ck(advance(c,3)==0 && xt_cycle_wait(c)==1 && xt_cycle_ack(c)==-11,"partial branch wait retains its remainder");ck(advance(c,1)==0 && xt_step(c)==13 && xt_cycle_ack(c)==0,"completed frontend interval still requires acknowledgement");ck(xt_run_slice(c,run,1000,2)==10 && xt_reg(c,7)==0xfffffff4 && load64(c+128)==0x2009 && load64(c+176)==2 && !xt_sr(c,2),"target executes once and loop commits after acknowledgement");xt_close(c);
 context=3;c=setup(0x10);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,1000,1)==10 && load64(c+128)==0x2016,"taken conditional branch commits skipped-NOP target");ck(xt_step(c)==13 && xt_cycle_wait(c)==4,"taken conditional charges target alignment");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,1000,2)==10 && xt_reg(c,7)==5,"taken conditional interval matches silicon rule");xt_close(c);
 context=4;c=setup(0x20);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,1000,3)==10 && load64(c+176)==3 && xt_reg(c,7)==2 && !load64(c+384) && !load64(c+336),"untaken conditional has no frontend penalty");xt_close(c);
 context=5;let kind=0;while kind<4{c=setup(0x30+kind*16);xt_setreg(c,3,0x2100+(kind>=2)*16);ck(xt_cycle_profile(c,1)==0,"call/return timing profile");finish(c,run,4);ck(load64(c+176)==4 && xt_reg(c,8)==1 && xt_reg(c,7)==10 && load64(c+336)==7,"CALL0/CALLX0 with RET/RET.N charge both redirects and execute leaf once");ck(xt_reg(c,0)==0x2033+kind*16,"private call0 return link remains architectural");xt_close(c);kind=kind+1;}
 context=6;c=setup(0x80);ck(xt_cycle_profile(c,1)==0,"PS/branch overlap profile");finish(c,run,3);ck(xt_reg(c,7)==5 && load64(c+336)==3 && load64(c+176)==3,"PS and frontend readiness overlap instead of adding scalar penalties");xt_close(c);
 context=7;c=setup(0x90);xt_setreg(c,3,0x9000);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,1000,1)==10 && load64(c+128)==0x9000,"indirect JX commits target before fetch");ck(xt_step(c)==13 && !load64(c+160) && xt_cycle_wait(c)==3,"unmapped destination cannot fetch early during branch delay");ck(advance(c,3)==0 && xt_cycle_ack(c)==0 && xt_step(c)==-1 && load64(c+168)==0x9000 && load64(c+176)==1,"destination fault occurs after frontend wait with precise PC and retirement");xt_close(c);
 context=8;c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,1000,1)==10 ,"IRQ fixture commits branch before pending IRQ");xt_wsr(c,231,0x2000);xt_wsr(c,228,128);xt_wsr(c,226,128);ck(xt_step(c)==13 && !load64(c+248),"pending branch event blocks premature IRQ arbitration");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,1000,2)==13 && xt_cycle_wait(c)==7 && xt_sr(c,177)==0x2003 && load64(c+128)==0x2300 && load64(c+248)==1,"IRQ during branch wait saves committed target before entry readiness");ck(advance(c,7)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,1000,2)==10 && load64(c+128)==0x2003,"RFE returns after seven-cycle vector phase");xt_wsr(c,227,128);ck(xt_run_slice(c,run,1000,3)==13 && xt_cycle_wait(c)==4,"IRQ return waits on target frontend");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,1000,3)==10 && xt_reg(c,7)==17 && load64(c+176)==3,"target retries exactly once after measured interrupt entry and return");xt_close(c);
 clocks(run);syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("Branch cycles: ",h_int(checks)," checks passed\n"));return 0;
}
