import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global ref=0;
global checks=0;
global phase_case=0;
fn r(i){return load64(ref+32+i*8);}
fn ck(ok,text){if !ok{h_print(2,h_cat3("SPI phase case ",h_int(phase_case),h_cat3(" check ",h_int(checks),h_cat3(": ",text,"\n"))));syscall(60,1,0,0,0,0,0);}checks=checks+1;return 0;}
fn wr(s,address,value){let result=se_bus(s,address,4,1,value);if result<0{h_print(2,h_cat3("write ",h_int(address),h_cat3(" error ",h_int(result),"\n")));}ck(result>=0,"defined write");return 0;}
fn rd(s,address){let value=se_bus(s,address,4,0,0);ck(value>=0,"defined read");return value;}
fn advance(s,n){ck(se_advance(s,n)==0,"advance modeled time");return 0;}
fn apply(s,base){if r(15){wr(s,base,r(15));ck(rd(s,base)&r(15),"UPDATE remains pending");advance(s,1);ck(rd(s,base)==0,"UPDATE applied");}return 0;}
fn setup(s,bus){let base=r(bus-1);let group=(bus-2)*4;wr(s,r(3),rd(s,r(3))|r(bus+3));if r(0){wr(s,base+232,7);}wr(s,base+r(11),0);wr(s,r(43),r(47));wr(s,r(44),r(47));wr(s,r(45),r(47));wr(s,r(46),r(47));wr(s,r(41)+18*4,r(22+group));wr(s,r(41)+21*4,r(23+group));wr(s,r(41)+4*4,r(25+group));wr(s,r(42)+r(24+group)*4,128|19);wr(s,r(48),(1<<18)|(1<<21)|(1<<4));wr(s,r(50)+r(20+bus-2)*4,1);return base;}
fn reset_words(cpu){let bus=2;while bus<=3{let s=se_create(cpu,r(0));let base=r(bus-1);wr(s,r(3),rd(s,r(3))|r(bus+3));let pass=0;while pass<2{ck(rd(s,base+8)==r(73),"C-derived CTRL reset");ck(rd(s,base+r(7))==r(74),"C-derived USER reset");ck(rd(s,base+r(63))==r(75),"C-derived USER1 reset");ck(rd(s,base+r(64))==r(76),"C-derived USER2 reset");ck(rd(s,base+r(8))==r(77),"C-derived CLOCK reset");ck(rd(s,base+r(9))==r(78),"C-derived CS reset");ck(rd(s,base+r(11))==r(79),"C-derived SLAVE reset");if r(0){ck(rd(s,base+r(81))==0,"C-derived clock gate reset");}else{ck(rd(s,base+20)==r(80),"C-derived CTRL2 reset");}wr(s,base+r(7),0);wr(s,base+8,0);wr(s,base+r(63),0);wr(s,base+r(64),0);wr(s,base+r(8),0);wr(s,base+r(9),0);wr(s,base+r(11),0);wr(s,r(4),r(bus+3));wr(s,r(4),0);pass=pass+1;}se_close(s);bus=bus+1;}}
fn cases(cpu){let f=ref+32+load64(ref+8)*8;let at=0;while at<load64(ref+16){phase_case=at;let s=se_create(cpu,r(0));let bus=load64(f);let base=setup(s,bus);let mode=load64(f+8);let txbits=load64(f+32);let rxbits=load64(f+40);let cycles=load64(f+184);let setupcycles=load64(f+192);let high=load64(f+208);let low=load64(f+216);let period=high+low;let tx=f+256;let rx=tx+64;let edge=rx+64;
 wr(s,base+8,load64(f+160));wr(s,base+r(7),load64(f+120));wr(s,base+r(63),load64(f+128));wr(s,base+r(64),load64(f+136));wr(s,base+r(65),load64(f+104));if !r(0){wr(s,base+r(66),load64(f+112));wr(s,base+20,load64(f+168));}wr(s,base+r(9),load64(f+152));wr(s,base+r(8),load64(f+144));if r(0){wr(s,base+r(81),load64(f+176));}
 let length=txbits;if !length{length=rxbits;}if !length{length=1;}wr(s,base+r(12),length-1);if !r(0){let rlength=rxbits;if !rlength{rlength=1;}wr(s,base+r(13),rlength-1);}let i=0;while i<16{wr(s,base+r(10)+i*4,em_u32(tx+i*4));i=i+1;}apply(s,base);wr(s,base+r(11),0);if r(0){wr(s,base+r(19),r(16));wr(s,base+r(17),0);}
 let start=load64(s+16);wr(s,base,r(14));ck(rd(s,base)&r(14),"USR pending before phases");ck(se_gpio_level(s,4)==0,"CS asserted across whole transaction");let early=!r(0) && (mode&1);if setupcycles{advance(s,setupcycles*period-1);ck(load64(se_spi(s,bus)+104)==0 && se_gpio_level(s,18)==(mode>>1),"no clock edges before setup boundary");advance(s,1);}ck(load64(se_spi(s,bus)+104)==early,"first CPHA1 edge is at original setup boundary");
 i=0;while i<cycles*2{let expected=load8(edge+i);ck(se_gpio_drive(s,19,(expected>>4)&1)==0,"independent MISO edge stimulus");let wait=low;if mode>>1{wait=high;}if i&1{wait=high;if mode>>1{wait=low;}}if !i && early{wait=0;}advance(s,wait);ck(se_gpio_level(s,18)==(expected&1),"SCK including clockless dummy");let mask=5;if expected&8{mask=7;}ck((load8(se_spi(s,bus)+4096+i)&mask)==(expected&mask),"logical command/address/data serialization and capture mask");if (expected&8) && ((i&1)==(mode&1)){ck(se_gpio_level(s,21)==((expected>>1)&1),"transmitted bit reaches actual MOSI pad");}if i<cycles*2-1{ck(rd(s,base)&r(14),"no completion before final phase");ck(se_gpio_level(s,4)==0,"CS remains active through every phase");}i=i+1;}
 let completioncycles=load64(f+240);let cscycles=load64(f+248);let tail=0;if early{tail=low;if mode>>1{tail=high;}}let cswait=cscycles*period+tail;let endwait=completioncycles*period+tail;let paused=0;if !r(0) && cswait && endwait>cswait{wr(s,r(3),rd(s,r(3))&~r(bus+3));advance(s,1000);wr(s,r(3),rd(s,r(3))|r(bus+3));paused=1000;}
 if cswait{ck(rd(s,base)&r(14),"USR includes CS delay and final idle half-cycle");ck(se_gpio_level(s,4)==0,"CS stays active until its own deadline");advance(s,cswait-1);ck(se_gpio_level(s,4)==0,"CS does not release early");advance(s,1);}ck(se_gpio_level(s,4)==1,"CS releases at independent deadline");
 if endwait>cswait{ck(rd(s,base)&r(14),"engine remains busy after CS release");ck(!(rd(s,base+r(18))&r(16)),"completion IRQ waits beyond CS release");advance(s,endwait-cswait-1);ck(rd(s,base)&r(14),"completion waits for entire engine delay");advance(s,1);}ck(rd(s,base)==0,"completion clears USR");ck(load64(s+16)-start==(setupcycles+cycles+completioncycles)*period+paused,"independent full transaction duration");ck(rd(s,base+r(18))&r(16),"completion raw only after final phase");ck(!(xt_sr(cpu,226)&2),"completion remains masked");if r(0){wr(s,base+r(17),r(16));}else{wr(s,base+r(11),528);}ck(xt_sr(cpu,226)&2,"completion routes native interrupt");if r(0){wr(s,base+r(19),r(16));}else{wr(s,base+r(11),512);}ck(!(xt_sr(cpu,226)&2),"completion acknowledges");
 let offset=0;if load64(f+88){offset=32;}i=0;while i<64{let value=(rd(s,base+r(10)+(i/4)*4)>>((i&3)*8))&255;let wanted=load8(tx+i);if i>=offset && i<offset+(rxbits+7)/8{wanted=load8(rx+i-offset);}ck(value==wanted,"receive phase only and untouched FIFO bytes");i=i+1;}se_close(s);f=f+4480;at=at+1;}}
fn unsupported(cpu){let bus=2;while bus<=3{let s=se_create(cpu,r(0));let base=setup(s,bus);wr(s,base+8,0);if !r(0){wr(s,base+20,0);}wr(s,base+r(63),0);wr(s,base+r(64),0);wr(s,base+r(9),r(51));wr(s,base+r(8),r(40));wr(s,base+r(7),r(36)|r(34)|r(35)|r(56));apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"full-duplex dummy mode explicitly unsupported");wr(s,base+r(7),r(34)|r(35)|r(56));apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"simultaneous write/read plus dummy explicitly unsupported");wr(s,base+r(7),r(36)|r(54)|r(34)|r(67));apply(s,base);ck(se_bus(s,base,4,1,r(14))== -95,"full-duplex prefix with CS setup unsupported");se_close(s);bus=bus+1;}}
fn main(argc,argv){h_environment(argc,argv);ck(argc==2,"reference argument");ref=h_read(load64(argv+8));ck(load64(ref)==0x5350495048410001 && load64(ref+8)==82 && load64(ref+16)==512 && h_file_size==2294448,"independent C phase shape");let cpu=xt_create();reset_words(cpu);cases(cpu);unsupported(cpu);xt_close(cpu);h_print(1,h_cat3("SPI phase model: ",h_int(checks)," checks passed\n"));return 0;}
