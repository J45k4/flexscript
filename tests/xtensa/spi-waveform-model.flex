import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global swm_ref=0;
fn swm_r(i){return load64(swm_ref+32+i*8);}
fn swm_require(ok,text){if !ok{h_print(2,h_cat3("SPI waveform model: ",text,"\n"));syscall(60,1,0,0,0,0,0);}return 0;}
fn swm_wr(s,a,v){let n=se_bus(s,a,4,1,v);if n<0{h_print(2,h_cat3("MMIO ",h_int(a),h_cat3(" error ",h_int(n),"\n")));}return swm_require(n>=0,"defined write");}
fn swm_write(p,n){let done=0;while done<n{let result=syscall(1,1,p+done,n-done,0,0,0);swm_require(result>0,"write trace");done=done+result;}return 0;}
fn swm_levels(s){return se_gpio_level(s,18)|(se_gpio_level(s,25)<<1)|(se_gpio_level(s,4)<<2);}
fn swm_record(s,p,start){store64(p,load64(s+16)-start);store64(p+8,se_gpio_level(s,18));store64(p+16,se_gpio_level(s,25));store64(p+24,se_gpio_level(s,4));return 0;}
fn main(argc,argv){h_environment(argc,argv);swm_require(argc==2,"reference argument");swm_ref=h_read(load64(argv+8));swm_require(load64(swm_ref)==0x53574d4f444c0001 && load64(swm_ref+8)==55 && load64(swm_ref+24)==30 && h_file_size==32+55*8+load64(swm_ref+16)*30*8,"C packet shape");let output=alloc(32768);let header=alloc(16);store64(header,0x53574556454e5401);store64(header+8,load64(swm_ref+16));swm_write(header,16);let cpu=xt_create();let f=swm_ref+32+55*8;let frame=0;while frame<load64(swm_ref+16){let s=se_create(cpu,0);let bus=load64(f+8);let base=swm_r(bus-1);swm_wr(s,swm_r(3),4|swm_r(bus+3));swm_wr(s,swm_r(43),swm_r(47));swm_wr(s,swm_r(44),swm_r(47));swm_wr(s,swm_r(46),swm_r(47));swm_wr(s,swm_r(54),swm_r(47));let group=(bus-2)*4;swm_wr(s,swm_r(41)+18*4,swm_r(22+group));swm_wr(s,swm_r(41)+21*4,swm_r(23+group));swm_wr(s,swm_r(41)+4*4,swm_r(25+group));swm_wr(s,swm_r(48),(1<<18)|(1<<21)|(1<<4));swm_require(se_gpio_wire(s,21,25)==0,"virtual physical wire");
 swm_wr(s,base+12,load64(f+27*8));swm_wr(s,base+240,load64(f+28*8));swm_wr(s,base+244,load64(f+29*8));swm_wr(s,base+8,load64(f+17*8));swm_wr(s,base+20,load64(f+18*8));swm_wr(s,base+24,load64(f+19*8));swm_wr(s,base+28,load64(f+20*8));swm_wr(s,base+32,load64(f+21*8));swm_wr(s,base+36,load64(f+22*8));swm_wr(s,base+52,load64(f+23*8));swm_wr(s,base+4,load64(f+15*8));swm_wr(s,base+48,load64(f+16*8));swm_wr(s,base+40,load64(f+26*8));swm_wr(s,base+44,0);let i=0;while i<16{let value=0;if i<2{value=load64(f+(24+i)*8);}swm_wr(s,base+128+i*4,value);i=i+1;}swm_wr(s,base+56,0);let start=load64(s+16);swm_wr(s,base,swm_r(14));let count=1;swm_record(s,output,start);let before=swm_levels(s);let steps=0;
 while load64(se_spi(s,bus)){let wait=se_deadline(s);swm_require(wait>=0 && steps<4096,"bounded pending deadline");swm_require(se_advance(s,wait)==0,"advance devices");let now=swm_levels(s);if now!=before{swm_require(count<1024,"trace capacity");swm_record(s,output+count*32,start);count=count+1;before=now;}steps=steps+1;}
 store64(header,load64(f));store64(header+8,count);swm_write(header,16);swm_write(output,count*32);se_close(s);f=f+30*8;frame=frame+1;}xt_close(cpu);return 0;}
