// Independent generic memory/event contract. No ESP32 device/driver imports.
import "../../emulator/xtensa/cpu.flex";
import "../../scripts/lib/host.flex";
global po_checks=0;global po_case=0;global po_ref=0;
fn check(ok,message){po_checks=po_checks+1;if !ok{h_print(2,h_cat3("Observed page case ",h_int(po_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c){store64(c+160,0);store64(c+168,0);return 0;}
fn pattern(frame,offset){return ((frame*43+offset*17)^0xa3)&255;}
fn frame(index){if index==0{return 2;}if index==2{return 1;}if index==3{return 3;}return 0;}
fn word(index){return 0x101<<index;}
fn validation(){let c=xt_create();let pages=alloc(128);let attrs=alloc(128);let events=alloc(128);let gate=alloc(8);let backing=alloc(16384);store64(gate,1);store64(pages,backing);let d=xt_map_pages(c,0x10000000,8192,5,pages,gate,12);check(d>0,"validation mapping");let i=0;while i<8{po_case=i;let a=0x10000000;let tags=attrs;let e=events;let fill= -1;if i==0{a=a+4096;}if i==1{tags= -8;}if i==2{tags=tags+1;}if i==3{e=0;}if i==4{e=e+1;}if i==5{fill= -2;}if i==6{fill=0x100000000;}if i==7{a=0;}check(xt_pages_observe(c,a,tags,e,fill,0)== -22 && !load64(d+24) && !load64(events+56),"invalid observer rejected atomically");i=i+1;}
 check(xt_pages_observe(c,0x10000000,attrs,events,-1,0)==0 && load64(events+56)==c,"caller-owned event record acquires one CPU owner");let other=xt_create();let other_table=alloc(16);store64(other_table,backing);check(xt_map_pages(other,0x10000000,8192,1,other_table,0,12)>0,"other CPU mapping");check(xt_pages_observe(other,0x10000000,0,events,0,0)== -16,"event ownership cannot cross machines");check(xt_pages_observe(c,0x10000000,attrs,events+8,0,0)<0,"overlapping event record rejected");check(xt_pages_observe(c,0x10000000,attrs,attrs,0,0)<0 && xt_pages_observe(c,0x10000000,attrs,pages,0,0)<0 && xt_pages_observe(c,0x10000000,attrs,d,0,0)<0 && xt_pages_observe(c,0x10000000,attrs,c,0,0)<0,"event metadata/table/descriptor/context aliases rejected");check(xt_pages_observe(c,0x10000000,attrs,backing,0,0)<0,"guest-visible event storage rejected");let normal=xt_map(c,0x20000000,4096,3);check(normal>0 && xt_pages_observe(c,0x10000000,attrs,normal,0,0)<0,"ordinary guest RAM cannot hold the device event record");check(xt_pages_ack(c,0xdead0000)== -22 && xt_pages_unobserve(c,0xdead0000)== -22,"missing observer address rejects ack/detach");xt_close(c);check(!load64(events+56),"CPU close releases caller event ownership");check(xt_pages_observe(other,0x10000000,0,events,0,0)==0,"surviving CPU can acquire released event record");xt_close(other);check(!load64(events+56),"second CPU close releases event owner");syscall(11,pages,128,0,0,0,0);syscall(11,attrs,128,0,0,0,0);syscall(11,events,128,0,0,0,0);syscall(11,gate,8,0,0,0,0);syscall(11,backing,16384,0,0,0,0);syscall(11,other_table,16,0,0,0,0);return 0;}
fn boundaries(){let shift=12;while shift<=20{let size=1<<shift;let c=xt_create();let backing=alloc(size*4);let pages=alloc(32);let attrs=alloc(32);let event=alloc(64);let gate=alloc(8);store64(gate,1);let page=0;while page<4{store64(pages+page*8,backing+frame(page)*size);store64(attrs+page*8,word(page));let at=0;while at<16{store8(backing+page*size+at,pattern(page,at));store8(backing+(page+1)*size-16+at,pattern(page,size-16+at));at=at+1;}page=page+1;}check(xt_map_pages(c,0x10000000,size*4,5,pages,gate,shift)>0 && xt_pages_observe(c,0x10000000,attrs,event,-1,0)==0,"all page sizes accept observed read-only mappings");check(xt_read(c,0x10000000,1)==pattern(2,0) && load64(event)==2 && load64(event+8)==word(0) && load64(event+32)==1 && load64(c+288),"first translated metadata change emits a device event");check(xt_pages_observe(c,0x10000000,attrs,event,0,0)== -16 && load64(event+32)==1,"pending event cannot be lost through observer reconfiguration");check(xt_pages_ack(c,0x10000000)==0 && !load64(event) && !load64(event+48) && !load64(c+288),"ack clears only pending summary andreschedule signal");check(xt_read(c,0x10000001,1)==pattern(2,1) && load64(event+32)==1 && !load64(c+288),"stable metadata keeps the normal fast path");store64(attrs,0x7101);xt_read(c,0x10000002,1);check(load64(event+8)==0x7101 && load64(event+32)==2 && load64(c+288),"caller-published metadata change notifies device");xt_pages_ack(c,0x10000000);store64(attrs,word(0));check(xt_pages_observe(c,0x10000000,attrs,event,-1,-1)==0,"repeat metadata mask can request every translated access");let boundary=1;while boundary<4{let offset= -7;while offset<=7{let n=1;while n<=8{po_case=shift*10000+boundary*1000+(offset+7)*8+n;let relative=boundary*size+offset;let expected=0;let j=0;while j<n{let index=(relative+j)/size;let at=(relative+j)%size;expected=expected|(pattern(frame(index),at)<<(j*8));j=j+1;}xt_pages_ack(c,0x10000000);let sequence=load64(event+32);let first=relative/size;let last=(relative+n-1)/size;let got=xt_read(c,0x10000000+relative,n);check(got==expected && !load64(c+160),"noncontiguous observed read matches independent frame pattern");check(load64(event)==2 && load64(event+8)==word(last) && load64(event+48)==(word(first)|word(last)),"bounded summary retains first/tail metadata andlast value");check(load64(event+32)==sequence+1+(first!=last) && load64(c+288),"each touched page is notified before device reschedule");n=n+1;}offset=offset+1;}boundary=boundary+1;}
 xt_pages_ack(c,0x10000000);let sequence=load64(event+32);store64(pages+24,0);check(xt_read(c,0x10000000+size*3-2,4)==0 && load64(c+160)== -14 && load64(c+168)==0x10000000+size*3,"unmapped tail remains a precise error rather than data fill");check(!load64(event) && load64(event+32)==sequence && !load64(c+288),"failed read exposes no partial page event");clear(c);store64(pages+24,backing+size*3);store64(gate,0);check(xt_read(c,0x10000000,1)==0 && load64(c+160)== -5 && !load64(event),"strict disabled observer still faults");clear(c);check(xt_pages_observe(c,0x10000000,attrs,event,0xbad00bad,0)==0,"data fill explicitly configured");sequence=load64(event+32);check(!xt_pointer(c,0x10000000,1,5) && load64(c+160)== -5 && load64(event+32)==sequence,"disabled code fetch never consumes data fill");clear(c);let before=load8(backing+size*2);check(xt_write(c,0x10000000,4,0x12345678)== -1 && load64(c+160)== -13 && load8(backing+size*2)==before && !load64(event),"read-only permissions precede observation/fill");clear(c);check(xt_pages_unobserve(c,0x10000000)==0 && !load64(event+56),"observer detaches without freeing caller metadata");check(xt_read(c,0x10000000,1)==0 && load64(c+160)== -5,"detached region restores default strict gates");xt_close(c);syscall(11,backing,size*4,0,0,0,0);syscall(11,pages,32,0,0,0,0);syscall(11,attrs,32,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,gate,8,0,0,0,0);shift=shift+1;}return 0;}
fn fills(){let c=xt_create();let backing=alloc(8192);let pages=alloc(16);let event=alloc(64);let gate=alloc(8);store64(pages,backing);store64(pages+8,backing+4096);store64(gate,0);check(xt_map_pages(c,0x10000000,8192,1,pages,gate,12)>0,"fill data region");let fill=0;while fill<4{check(xt_pages_observe(c,0x10000000,0,event,load64(po_ref+16+fill*8),0)==0,"fill word profile");let offset=0;while offset<8{let n=1;while n<=8{po_case=500000+fill*1000+offset*8+n;xt_pages_ack(c,0x10000000);let expected=load64(po_ref+64+(fill*64+offset*8+n-1)*8);check(xt_read(c,0x10000000+offset,n)==expected && !load64(c+160),"all read widths/alignments equal independently serialized fill bytes");check(load64(event+24)==1 && load64(event+8)==0 && load64(event+32)==1,"identical disabled reads use one bounded change event");n=n+1;}offset=offset+1;}fill=fill+1;}
 xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,gate,8,0,0,0,0);return 0;}
fn scheduling(){po_case=600000;let c=xt_create();let code=xt_map(c,0x1000,4096,5);let vectors=xt_map(c,0x2000,4096,5);em_copy(code,po_ref+48,12);em_copy(vectors+0x300,po_ref+54,3);let backing=alloc(8192);em_put32(backing,0x11223344);let pages=alloc(16);store64(pages,backing);store64(pages+8,backing+4096);let attrs=alloc(16);store64(attrs,0x100);store64(attrs+8,0x200);let event=alloc(64);let gate=alloc(8);store64(gate,1);let run=alloc(4096);check(xt_map_pages(c,0x10000000,8192,1,pages,gate,12)>0 && xt_pages_observe(c,0x10000000,attrs,event,0xbad00bad,0)==0,"scheduler data observer");store64(c+128,0x1000);xt_setreg(c,1,0x10000000);xt_setreg(c,2,7);xt_setreg(c,5,0);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==1 && load64(c+128)==0x1003 && xt_reg(c,4)==0x11223344 && xt_reg(c,5)==0,"GNU load retires once andyields before following ADDI");check(load64(event)==2 && load64(event+8)==0x100 && load64(c+288),"yield exposes completed device metadata");check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==1 && load64(c+128)==0x1003 && xt_reg(c,5)==0,"unacknowledged event blocks the next guest instruction at slice entry");xt_pages_ack(c,0x10000000);xt_wsr(c,228,2);xt_wsr(c,230,0);xt_wsr(c,231,0x2000);xt_interrupt(c,2);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==2 && xt_reg(c,2)==0xffffffef && xt_reg(c,5)==0 && xt_sr(c,177)==0x1003 && load64(c+248)==1,"device IRQ after acknowledgement enters GNU handler before next guest instruction");xt_interrupt(c,0);xt_wsr(c,228,0);xt_wsr(c,230,0);store64(c+128,0x1003);check(xt_run_slice(c,run,1000,3)==10 && load64(c+176)==3 && xt_reg(c,5)==1,"interrupted following instruction remains executable once");
 em_copy(code+3,po_ref+48,3);check(xt_pages_observe(c,0x10000000,attrs,event,-1,0)==0,"stable metadata scheduler fixture");store64(c+128,0x1000);store64(c+176,0);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==1,"first stable-page load yields");xt_pages_ack(c,0x10000000);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==2 && !load64(c+288) && load64(event+32)==1,"same metadata continues through slice without another device event");check(xt_pages_observe(c,0x10000000,attrs,event,-1,0x100)==0,"repeat metadata scheduler fixture");store64(c+128,0x1000);store64(c+176,0);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==1,"repeat first load yields");xt_pages_ack(c,0x10000000);check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==2 && load64(c+288) && load64(event+32)==2,"selected repeat metadata yields even without a value change");xt_pages_ack(c,0x10000000);
 let event2=alloc(64);let attrs2=alloc(16);store64(attrs2,0x400);check(xt_map_pages(c,0x30000000,8192,1,pages,gate,12)>0 && xt_pages_observe(c,0x30000000,attrs2,event2,-1,0)==0,"two independently observed regions");xt_read(c,0x10001000,4);xt_read(c,0x30000000,4);check(load64(event) && load64(event2) && load64(c+288),"both regions can own pending changes");xt_pages_ack(c,0x10000000);check(!load64(event) && load64(event2) && load64(c+288),"acknowledging one region preserves another's scheduler request");check(xt_unmap_pages(c,0x30000000)==0 && !load64(event2+56) && !load64(c+288),"unmapping removes only its pending observation andowner");xt_read(c,0x10000000,4);check(load64(c+288) && xt_pages_unobserve(c,0x10000000)==0 && !load64(event+56) && !load64(c+288),"explicit observer detach clears its pending state");xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,attrs,16,0,0,0,0);syscall(11,attrs2,16,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,event2,64,0,0,0,0);syscall(11,gate,8,0,0,0,0);syscall(11,run,4096,0,0,0,0);return 0;}
fn fetches(){po_case=700000;let c=xt_create();let backing=alloc(8192);let pages=alloc(16);store64(pages,backing+4096);store64(pages+8,backing);let attrs=alloc(16);store64(attrs,0x10);store64(attrs+8,0x20);let event=alloc(64);let gate=alloc(8);store64(gate,1);check(xt_map_pages(c,0x400d0000,8192,5,pages,gate,12)>0 && xt_pages_observe(c,0x400d0000,attrs,event,-1,0)==0,"observed GNU fetch fixture");store8(backing+8191,load8(po_ref+54));store8(backing,load8(po_ref+55));store8(backing+1,load8(po_ref+56));store64(c+128,0x400d0fff);check(xt_step(c)==0 && xt_reg(c,2)==0xffffffef && load64(c+128)==0x400d1002 && load64(c+176)==1,"GNU instruction fetch crosses independently backed observed pages");check(load64(event)==2 && load64(event+8)==0x20 && load64(event+48)==0x30 && load64(event+32)==2,"fetch-prefix query coalesces while both actual instruction fragments are observed");xt_pages_ack(c,0x400d0000);store64(gate,0);check(xt_pages_observe(c,0x400d0000,attrs,event,0,0)==0,"fetch cannot opt into data fill");store64(c+128,0x400d0fff);check(xt_step(c)== -1 && load64(c+160)== -5 && load64(c+176)==1 && !load64(event),"disabled observed fetch faults before retirement ornotification");xt_close(c);syscall(11,backing,8192,0,0,0,0);syscall(11,pages,16,0,0,0,0);syscall(11,attrs,16,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,gate,8,0,0,0,0);return 0;}
fn deferred(){po_case=800000;let c=xt_create();let code=xt_map(c,0x1000,4096,5);em_copy(code,po_ref+48,12);let backing=alloc(4096);let pages=alloc(8);store64(pages,backing);let attrs=alloc(8);store64(attrs,0x100);let event=alloc(64);let run=alloc(4096);check(xt_map_pages(c,0x10000000,4096,1,pages,0,12)>0 && xt_pages_observe(c,0x10000000,attrs,event,-1,0)==0,"deferred MMIO fixture");store64(c+128,0x1000);xt_setreg(c,1,0x90000000);check(xt_run_slice(c,run,1000,1)==6 && load64(c+192)==5 && !load64(c+176),"GNU MMIO load defers retirement anddestination");xt_read(c,0x10000000,4);store64(run+40,0x89abcdef);check(xt_run_slice(c,run,1000,1)==10 && load64(c+192)==5 && !load64(c+176) && load64(c+128)==0x1000,"pending device observation yields before deferred MMIO retirement");xt_pages_ack(c,0x10000000);check(xt_run_slice(c,run,1000,1)==10 && !load64(c+192) && load64(c+176)==1 && load64(c+128)==0x1003 && xt_reg(c,4)==0x89abcdef,"acknowledging event completes deferred MMIO exactly once");check(xt_run_slice(c,run,1000,2)==10 && load64(c+176)==2 && xt_reg(c,5)==1 && xt_reg(c,4)==0x89abcdef,"next slice preserves completed result andexecutes next instruction once");xt_close(c);syscall(11,backing,4096,0,0,0,0);syscall(11,pages,8,0,0,0,0);syscall(11,attrs,8,0,0,0,0);syscall(11,event,64,0,0,0,0);syscall(11,run,4096,0,0,0,0);return 0;}
fn main(argc,argv){h_environment(argc,argv);check(argc==2,"independent GNU/fill reference input required");po_ref=h_read(load64(argv+8));check(h_file_size==2112 && load64(po_ref)==0x4f42535041474531 && load64(po_ref+8)==12,"reference shape");validation();boundaries();fills();scheduling();fetches();deferred();h_print(1,h_cat3("Observed CPU pages: ",h_int(po_checks)," checks passed\n"));return 0;}
