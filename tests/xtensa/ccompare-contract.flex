import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Comparator case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn clear(c,value){let i=0;while i<3{xt_wsr(c,240+i,value);i=i+1;}return 0;}
fn pending(c){return xt_sr(c,226)&0x18040;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"clock fixture register");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"PLL transaction");return 0;}
fn source_phase(){context=8;let c=xt_create();xt_wsr(c,234,9);xt_timer_config(c,1);clear(c,0x70000000);xt_wsr(c,240,20);xt_wsr(c,228,64);ck(xt_ccount_advance(c,11)==0 && !pending(c) && xt_timer_next(c)==1 && !xt_irq_level(c),"natural equality is visible one cycle later through delivery APIs");xt_wsr(c,234,0x40000000);ck(!pending(c) && xt_timer_next(c)==1,"guest counter jump cannot move an in-flight source deadline");ck(xt_ccount_advance(c,1)==0 && pending(c)==64 && xt_sr(c,234)==0x40000001,"source publishes using elapsed time despite counter rewrite");xt_wsr(c,240,0x70000000);ck(!pending(c) && xt_timer_next(c)==0x30000000,"acknowledgement schedules only the newly programmed target");
 xt_wsr(c,234,9);xt_wsr(c,240,20);ck(xt_ccount_advance(c,11)==0 && !pending(c) && xt_timer_next(c)==1,"queued acknowledgement fixture reaches equality");xt_wsr(c,240,40);ck(!pending(c) && xt_timer_next(c)==21,"CCOMPARE rewrite cancels the old in-flight request");ck(xt_ccount_advance(c,1)==0 && !pending(c),"cancelled source cannot publish later");ck(xt_ccount_advance(c,19)==0 && !pending(c) && xt_timer_next(c)==1,"replacement target owns its own publication cycle");ck(xt_ccount_advance(c,1)==0 && pending(c)==64,"replacement source publishes exactly once");
 clear(c,0x70000000);xt_wsr(c,234,9);xt_wsr(c,240,20);ck(xt_ccount_advance(c,11)==0 && !pending(c),"in-flight INTCLEAR fixture");xt_wsr(c,227,64);ck(!pending(c) && xt_timer_next(c)==1,"INTCLEAR cannot cancel a queued hardware source");ck(xt_ccount_advance(c,1)==0 && pending(c)==64,"queued source survives software interrupt clear");xt_close(c);return 0;}
fn main(){source_phase();context=1;let c=xt_create();ck(xt_timer_config(0,1)==-22 && xt_timer_config(c,2)==-22 && !pending(c),"invalid configuration preserves standalone state");xt_wsr(c,240,3);ck(xt_ccount_advance(c,5)==0 && !pending(c),"unconfigured CPU does not inherit original timer option");xt_close(c);
 context=2;c=xt_create();ck(xt_timer_config(c,1)==0 && pending(c)==0x18040,"chosen initial zero counter/comparators latch causal equality");ck(xt_timer_config(c,0)==-16 && pending(c)==0x18040,"configuration cannot discard live pending state");xt_wsr(c,227,0xffffffff);ck(pending(c)==0x18040,"INTCLEAR cannot acknowledge hardware comparators");xt_wsr(c,240,100);ck(pending(c)==0x18000,"CCOMPARE0 clears only timer0");xt_wsr(c,241,100);ck(pending(c)==0x10000,"CCOMPARE1 clears only timer1");xt_wsr(c,242,100);ck(!pending(c) && xt_timer_config(c,0)==0,"all three independent acknowledgements allow disabling");xt_close(c);
 context=3;c=xt_create();xt_wsr(c,234,1);ck(xt_timer_config(c,1)==0 && !pending(c),"configuration compares actual counter rather than injecting flags");clear(c,100);ck(xt_ccount_advance(c,98)==0 && !pending(c) && xt_sr(c,234)==99,"no early comparator latch");ck(xt_ccount_advance(c,1)==0 && !pending(c) && xt_sr(c,234)==100 && xt_timer_config(c,0)==-16,"natural equality remains in flight for one source cycle");ck(xt_ccount_advance(c,1)==0 && pending(c)==0x18040 && xt_sr(c,234)==101,"natural source publishes on the next CPU cycle");xt_wsr(c,240,100);ck(pending(c)==0x18000,"rewriting a past/equal compare acknowledges without immediate reassertion");ck(xt_ccount_advance(c,1)==0 && pending(c)==0x18000,"equal acknowledgement remains clear after counter moves away");xt_wsr(c,226,64);ck(pending(c)==0x18000,"software INTSET cannot assert a hardware comparator bit");xt_close(c);
 context=4;c=xt_create();ck(xt_timer_config(c,1)==0,"counter-write fixture");clear(c,0x1080);xt_wsr(c,234,0x1000);xt_wsr(c,234,0x1100);xt_wsr(c,228,0x18040);ck(!pending(c) && xt_timer_next(c)==0xffffff81,"guest counter skip cannot synthesize a queued source or deadline");xt_wsr(c,234,0x1080);ck(pending(c)==0x18040,"guest equality write samples all matching comparators");clear(c,16);xt_wsr(c,234,0xfffffff0);ck(xt_ccount_advance(c,31)==0 && !pending(c) && xt_sr(c,234)==15,"wrap remains clear until selected target");ck(xt_ccount_advance(c,1)==0 && !pending(c) && xt_sr(c,234)==16,"wrapped equality also waits one publication cycle");ck(xt_ccount_advance(c,1)==0 && pending(c)==0x18040,"wrapped source publishes exactly once");xt_wsr(c,234,16);clear(c,16);ck(xt_ccount_advance(c,0xffffffff)==0 && !pending(c),"cleared equal comparator waits a full wrap");ck(xt_ccount_advance(c,1)==0 && !pending(c),"full32-bit elapsed wrap detects an in-flight equality");ck(xt_ccount_advance(c,1)==0 && pending(c)==0x18040,"full-wrap equality publishes one cycle later");xt_close(c);
 context=5;c=xt_create();let other=xt_create();xt_timer_config(c,1);xt_timer_config(other,1);clear(c,20);clear(other,20);ck(xt_ccount_advance(c,21)==0 && pending(c)==0x18040 && !pending(other) && xt_sr(other,234)==0,"independent CPU counters and pending state");xt_close(other);xt_close(c);
 context=6;c=xt_create();xt_timer_config(c,1);clear(c,3);store64(c+176,2);ck(!pending(c) && xt_sr(c,234)==2,"retired cycles before comparator stay clear");store64(c+176,3);ck(!pending(c) && xt_sr(c,234)==3,"retirement equality first queues the source");store64(c+176,4);ck(pending(c)==0x18040 && xt_sr(c,234)==4,"retirement and publication synchronize exactly once");xt_wsr(c,240,10);ck(xt_sr(c,240)==10 && pending(c)==0x18000,"CSR read cannot re-latch acknowledged earlier equality");xt_close(c);
 context=7;c=xt_create();xt_timer_config(c,1);clear(c,100);ck(xt_ccount_advance(0,1)==-22 && xt_ccount_advance(c,-1)==-22 && xt_ccount_advance(c,0x100000000000001)==-22 && xt_sr(c,234)==0 && !pending(c),"invalid elapsed input preserves state");store64(c+160,-95);ck(xt_ccount_advance(c,1)==-22 && xt_timer_config(c,0)==-22,"faulted CPU rejects counter/configuration mutation");xt_close(c);
 let mode=0;while mode<4{let phase=0;while phase<6{context=1000+mode*10+phase;c=xt_create();let s=se_create(c,0);let qpc=6;if mode==0{wr(s,0x3ff48070,0x3210);qpc=12;}if mode==2{wr(s,0x3ff0003c,1);qpc=3;}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);qpc=2;}clear(c,0x70000000);store64(c+176,phase);ck(se_sync(s)==0,"initial fractional clock phase");xt_wsr(c,234,0xfffffff0);xt_wsr(c,240,0xfffffff2);xt_wsr(c,241,0xfffffff4);xt_wsr(c,242,2);let before=load64(s+16);let fraction=load64(se_clock(s)+24);
 ck(se_clock_idle_cycles(s,5)==0 && pending(c)==0x8040 && xt_sr(c,234)==0xfffffff5,"board elapsed idle latches skipped targets rather than acting as a guest rewrite");ck(load64(se_clock(s)+152)==5 && load64(c+176)==phase,"idle comparator progress never retires instructions");ck(se_clock_idle_cycles(s,13)==0 && pending(c)==0x8040 && xt_sr(c,234)==2,"all board clocks preserve in-flight wrapped equality");ck(se_clock_idle_cycles(s,1)==0 && pending(c)==0x18040 && xt_sr(c,234)==3,"idle wrapped match publishes after one additional CPU cycle");ck(load64(s+16)==before+(fraction+19*qpc)/6 && load64(se_clock(s)+24)==(fraction+19*qpc)%6,"CPU comparator elapsed cycles preserve reference phase");xt_wsr(c,227,0xffffffff);ck(pending(c)==0x18040,"board INTCLEAR preserves hardware timer source");se_close(s);xt_close(c);phase=phase+1;}mode=mode+1;}
 h_print(1,h_cat3("Comparator: ",h_int(checks)," checks passed\n"));return 0;}
