import "../../emulator/esp32/board.flex";
import "../../scripts/lib/host.flex";
global checks=0;global context=0;global gnu=0;
fn ck(ok,message){checks=checks+1;if !ok{h_print(2,h_cat3("Cycle case ",h_int(context),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn setup(offset){let c=xt_create();let code=xt_map(c,0x2000,4096,5);em_copy(code,gnu,1027);store64(c+128,0x2000+offset);xt_setreg(c,6,0);xt_setreg(c,7,0x13579bdf);return c;}
// Emulate the board's two responsibilities: elapsed CCOUNT and monotonic clock.
fn advance(c,n){let cc=xt_sr(c,234);let result=xt_cycle_clock(c,load64(c+336)+n);if result{return result;}xt_wsr(c,234,cc+n);return 0;}
fn wr(s,address,value){ck(se_bus(s,address,4,1,value)>=0,"board clock/timer fixture register");return 0;}
fn analog(s,index,value){wr(s,0x6000e010,0x1000066|(index<<8)|(value<<16));ck(se_advance(s,1)==0,"complete PLL fixture transaction");return 0;}
fn board_clocks(run){let mode=0;while mode<4{let phase=0;while phase<6{context=1200+mode*10+phase;let c=setup(0);let s=se_create(c,0);let qpc=6;if mode==0{wr(s,0x3ff48070,0x3210);qpc=12;}if mode==2{wr(s,0x3ff0003c,1);qpc=3;}if mode==3{wr(s,0x3ff48070,0x3210);analog(s,3,28);analog(s,9,0x74);analog(s,11,0xc3);wr(s,0x3ff0003c,2);wr(s,0x3ff48070,0x08003210);qpc=2;}
 store64(c+176,phase);ck(se_sync(s)==0,"initial CPU fractional phase");wr(s,se_clock_address(s),se_bus(s,se_clock_address(s),4,0,0)|(1<<13));wr(s,0x3ff5f000,0x40004000);wr(s,0x3ff5f018,0);wr(s,0x3ff5f01c,0);wr(s,0x3ff5f020,1);wr(s,0x3ff5f000,0xc0004000);let before=load64(s+16);let fractional=load64(se_clock(s)+24);xt_wsr(c,234,0xfffffffd);
 ck(se_run_slice(s,run,1000,phase+2)==10 && load64(c+176)==phase+2 && !load64(se_clock(s)+152),"ordinary follower overlaps PS write without added idle cycles");ck(load64(s+16)==before+(fractional+2*qpc)/6 && load64(se_clock(s)+24)==(fractional+2*qpc)%6,"pre-stall retirement keeps fractional clock phase");
 ck(se_run_slice(s,run,1000,phase+3)==10 && load64(c+176)==phase+3 && xt_reg(c,7)==2 && xt_sr(c,234)==3,"board accounts counter wrap and elapsed stall without extra retirement");ck(load64(se_clock(s)+152)==3 && se_cpu_cycles(s)==phase+6 && !load64(c+368),"board consumes exactly the residual timing event");let ticks=(fractional+6*qpc)/6;ck(load64(s+16)==before+ticks && load64(se_clock(s)+24)==(fractional+6*qpc)%6,"retired and stalled cycles share exact reference-clock conversion");wr(s,0x3ff5f00c,1);ck(se_bus(s,0x3ff5f004,4,0,0)==ticks/se_apb_factor(s)/2,"hardware timer advances during CPU readiness stall");se_close(s);xt_close(c);phase=phase+1;}mode=mode+1;}return 0;}
fn main(argc,argv){
 h_environment(argc,argv);ck(argc==2,"GNU input");gnu=h_read(load64(argv+8));ck(h_file_size==1027,"GNU fixture length");let run=alloc(4096);em_zero(run,4096);
 context=1;let c=setup(0);ck(!load64(c+328),"standalone CPU keeps functional profile");ck(xt_run_slice(c,run,100,3)==10 && xt_reg(c,7)==2 && load64(c+176)==3,"functional profile retains single-cycle behavior");xt_close(c);
 context=2;c=setup(0);ck(xt_cycle_profile(c,1)==0,"enable measured LX6 profile");ck(xt_run_slice(c,run,100,1)==10 && load64(c+176)==1 && load64(c+128)==0x2003,"WSR.PS retires once without an immediate stall");ck(xt_run_slice(c,run,100,2)==10 && load64(c+176)==2 && load64(c+128)==0x2006,"NOP overlaps pending PS readiness");xt_wsr(c,0,0x200c);xt_wsr(c,1,0x2009);xt_wsr(c,2,1);
 ck(xt_run_slice(c,run,100,3)==13 && load64(run+8)==13 && load64(c+128)==0x2006 && load64(c+176)==2 && xt_reg(c,7)==0x13579bdf && xt_sr(c,2)==1,"PS-dependent counter read stalls before PC/register/loop retirement");ck(load64(c+376)==0x2006 && xt_cycle_wait(c)==3,"event records stalled PC and remaining CPU cycles");
 ck(xt_step(c)==13 && load64(c+176)==2 && load64(c+128)==0x2006,"step cannot consume a pending event");ck(xt_run_slice(c,run,100,2)==13 && load64(run+8)==13 && load64(c+176)==2,"zero-budget polling still reports pending event");ck(xt_cycle_ack(c)==-11 && xt_cycle_wait(c)==3,"early acknowledgement cannot erase the wait");ck(xt_cycle_profile(c,0)==-16 && xt_cycle_profile(c,1)==-16,"pending timing event cannot be overwritten by profile changes");
 ck(advance(c,2)==0 && xt_cycle_wait(c)==1 && xt_cycle_ack(c)==-11,"partial elapsed time preserves the remaining stall");ck(xt_cycle_clock(c,1)==-22 && xt_cycle_wait(c)==1,"monotonic clock cannot rewind");ck(advance(c,1)==0 && xt_cycle_wait(c)==0 && xt_step(c)==13,"elapsed deadline still needs explicit acknowledgement");ck(xt_cycle_ack(c)==0 && !load64(c+368) && !load64(c+376) && load64(c+128)==0x2006 && load64(c+176)==2 && xt_sr(c,2)==1,"acknowledgement changes only event ownership");ck(xt_cycle_ack(c)==-22 && xt_cycle_wait(c)==-22,"duplicate acknowledgement and absent wait reject");
 ck(xt_run_slice(c,run,100,3)==10 && xt_reg(c,7)==5 && load64(c+176)==3 && load64(c+128)==0x200c && !xt_sr(c,2),"stalled instruction reads elapsed CCOUNT and commits loop exactly once");xt_close(c);
 context=3;c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10,"counter-rewrite fixture starts");store64(c+128,0x2006);ck(xt_step(c)==13 && xt_cycle_wait(c)==4,"counter read observes PS dependency");xt_wsr(c,234,0xfffffff8);ck(xt_cycle_wait(c)==4 && xt_cycle_now(c)==1,"guest CCOUNT rewrite cannot move readiness deadline");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,2)==10 && xt_reg(c,7)==0xfffffffc,"counter value remains independently writable across stall");xt_close(c);
 context=4;c=setup(15);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10,"SAR write retires without waiting");ck(xt_run_slice(c,run,100,2)==13 && xt_cycle_wait(c)==3 && load64(c+128)==0x2012,"RSYNC waits on SAR fence completion");ck(advance(c,3)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,2)==10 && load64(c+176)==2 && xt_sr(c,234)==5,"SAR/RSYNC pair finishes at measured five-cycle boundary");xt_close(c);
 context=5;c=setup(21);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10 && xt_reg(c,9)==0,"first RSIL issues immediately");ck(xt_run_slice(c,run,100,2)==13 && xt_cycle_wait(c)==2 && load64(c+128)==0x2018,"second RSIL respects issue spacing");ck(advance(c,2)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,2)==10 && load64(c+176)==2 && xt_sr(c,234)==4,"consecutive RSIL issue spacing preserves retirement count");xt_close(c);
 context=6;c=setup(0x80);ck(xt_cycle_profile(c,1)==0,"PS/RSYNC/NOP profile");ck(xt_run_slice(c,run,100,3)==10 && load64(c+176)==3 && load64(c+128)==0x2089,"RSYNC and NOP overlap PS completion");ck(xt_run_slice(c,run,100,4)==13 && xt_cycle_wait(c)==2,"counter read accounts only residual PS readiness");ck(advance(c,2)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,4)==10 && xt_reg(c,7)==5,"PS/RSYNC/NOP preserves measured overlap");xt_close(c);
 context=7;c=setup(0);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10,"IRQ fixture starts");store64(c+128,0x2006);ck(xt_step(c)==13,"IRQ fixture enters timing wait");xt_wsr(c,231,0x2000);xt_wsr(c,228,128);xt_wsr(c,226,128);ck(xt_step(c)==13 && !load64(c+248),"pending timing event remains owned until board acknowledges");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,2)==13 && xt_cycle_wait(c)==7 && xt_sr(c,177)==0x2006 && load64(c+128)==0x2300 && load64(c+248)==1 && load64(c+176)==1,"pending IRQ changes context before measured vector readiness");ck(advance(c,7)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,2)==10 && load64(c+128)==0x2006,"RFE executes after exact entry phase");xt_wsr(c,227,128);ck(xt_run_slice(c,run,100,3)==13 && xt_cycle_wait(c)==4,"RFE target observes measured frontend delay");ck(advance(c,4)==0 && xt_cycle_ack(c)==0 && xt_run_slice(c,run,100,3)==10 && xt_reg(c,7)==17 && load64(c+176)==3,"instruction retries after measured entry and return without duplicate retirement");xt_close(c);
 context=8;c=setup(0x60);ck(xt_cycle_profile(c,1)==0 && xt_barrier_watch(c,1)==0 && xt_run_slice(c,run,100,1)==12,"MEMW device event stays distinct");ck(xt_cycle_profile(c,0)==-16 && xt_cycle_ack(c)==-22,"cycle APIs cannot consume a pending MEMW");ck(xt_barrier_ack(c)==0 && xt_run_slice(c,run,100,1)==10,"MEMW still retires normally after its own acknowledgement");xt_close(c);
 context=9;c=setup(0x400);xt_setreg(c,3,0x9000);ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==6 && load64(c+192),"deferred MMIO read remains distinct");ck(xt_cycle_profile(c,0)==-16 && xt_cycle_ack(c)==-22,"cycle APIs cannot consume deferred MMIO");store64(run+40,0xabcdef12);ck(xt_run_slice(c,run,100,1)==10 && xt_reg(c,2)==0xabcdef12 && load64(c+176)==1,"MMIO completion still commits exactly once");xt_close(c);
 context=10;ck(xt_cycle_profile(0,1)==-22 && xt_cycle_clock(0,0)==-22 && xt_cycle_wait(0)==-22 && xt_cycle_ack(0)==-22,"null contexts reject");c=setup(0);ck(xt_cycle_profile(c,-1)==-22 && xt_cycle_profile(c,2)==-22 && xt_cycle_clock(c,-1)==-22 && !load64(c+328),"invalid profile/clock preserves state");ck(xt_cycle_profile(c,1)==0 && xt_run_slice(c,run,100,1)==10 && xt_cycle_profile(c,0)==-16,"profile cannot discard active readiness");store64(c+128,0x2006);ck(xt_step(c)==13,"fault fixture enters cycle event");store64(c+160,-95);ck(xt_cycle_ack(c)==-22 && xt_cycle_clock(c,5)==-22 && xt_cycle_profile(c,0)==-22 && xt_step(c)==-1,"fault takes precedence over pending cycle event");xt_close(c);
 context=11;c=setup(0);let s=se_create(c,0);ck(s>0 && load64(c+328)==1,"original ESP32 board enables measured LX6 readiness");se_close(s);xt_close(c);c=setup(0);s=se_create(c,9);ck(s>0 && !load64(c+328),"S3 does not inherit unmeasured LX6 timing");se_close(s);xt_close(c);
 board_clocks(run);
 syscall(11,run,4096,0,0,0,0);h_print(1,h_cat3("Cycle: ",h_int(checks)," checks passed\n"));return 0;
}
