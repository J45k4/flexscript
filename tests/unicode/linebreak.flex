import "../../libs/unicode.flex";
import "../../scripts/lib/json.flex";
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"linebreak requests.json properties.bin");let requests=j_parse(h_read(load64(argv+8)));let i=0;while i<j_count(requests){let mark=h_mark();let hex=j_value(j_at(requests,i));let n=h_len(hex)/2;let text=h_unhex(hex);let map=unicode_linebreaks(text,n);h_assert(map,unicode_error);let result=j_array();let byte=0;while byte<=n{let mask=unicode_line_break(map,byte);if mask{j_push(result,j_int(byte));}byte=byte+1;}h_assert(j_count(result)==load64(map+16) && unicode_line_break(map,-1)<0 && unicode_line_break(map,n+1)<0,"Line-break count/access bounds");h_print(1,h_cat(j_dump(result),"\n"));unicode_linebreaks_free(map);h_reset(mark);i=i+1;}
    let map=unicode_linebreaks("a\r\nb\nc",6);h_assert(map && !unicode_line_break(map,2) && unicode_line_break(map,3)==2 && unicode_line_break(map,5)==2 && unicode_line_break(map,6)==2,"Mandatory CR/LF breaks");unicode_linebreaks_free(map);map=unicode_linebreaks("a b",3);h_assert(map && !unicode_line_break(map,1) && unicode_line_break(map,2)==1,"Space opportunity kind");unicode_linebreaks_free(map);let raw=h_unhex("c0af");h_assert(!unicode_linebreaks(raw,2) && !unicode_linebreaks("a",-1) && !unicode_linebreaks("a",1048577),"Invalid line-break input accepted");
    let values=alloc(1114112*2);i=0;while i<1114112{let value=unicode_line_property(i);store8(values+i*2,value&255);store8(values+i*2+1,value>>8);i=i+1;}h_save_bytes(load64(argv+16),values,1114112*2,420);syscall(11,values,1114112*2,0,0,0,0);return 0;
}
