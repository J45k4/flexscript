// Complete official conformance data is serialized by test-unicode-bidi.py.
import "../../libs/unicode.flex";
import "../../scripts/lib/host.flex";
import "../../lib/bytes.flex";
fn bt_utf8(p,cp){if cp<128{store8(p,cp);return 1;}if cp<2048{store8(p,192|(cp>>6));store8(p+1,128|(cp&63));return 2;}if cp<65536{store8(p,224|(cp>>12));store8(p+1,128|((cp>>6)&63));store8(p+2,128|(cp&63));return 3;}store8(p,240|(cp>>18));store8(p+1,128|((cp>>12)&63));store8(p+2,128|((cp>>6)&63));store8(p+3,128|(cp&63));return 4;}
fn bt_bad(index,kind,position,want,got){h_print(2,h_cat3("Bidi case ",h_int(index),h_cat3(" ",kind,h_cat3(" at ",h_int(position),h_cat3(": expected ",h_int(want),h_cat3(", got ",h_int(got),"\n"))))));syscall(60,1,0,0,0,0,0);return 0;}
fn bt_edges(levels,order){
    let text="אב  ג";let map=unicode_bidi(text,h_len(text),0);h_assert(map && load64(map)==5 && unicode_bidi_level(map,3)==1,"Wrapped bidi paragraph levels");h_assert(unicode_bidi_line(map,0,4,levels,order,4)==4 && load8(levels)==1 && load8(levels+1)==1 && !load8(levels+2) && !load8(levels+3),"L1 did not reset wrapped trailing whitespace");h_assert(load64(order)==1 && !load64(order+8) && load64(order+16)==2 && load64(order+24)==3,"Wrapped L2 order");h_assert(unicode_bidi_level(map,3)==1,"Line layout mutated paragraph levels");h_assert(unicode_bidi_line(map,0,5,levels,order,5)==5 && load8(levels+3)==1 && load64(order)==4 && !load64(order+32),"Paragraph could not be reused for a different wrap");
    store8(levels,123);store64(order,123);h_assert(unicode_bidi_line(map,0,5,levels,order,4)<0 && load8(levels)==123 && load64(order)==123,"Short bidi line buffers were modified");h_assert(unicode_bidi_index(map,1)==1 && unicode_bidi_offset(map,2)==4 && unicode_bidi_index(map,h_len(text))==5 && unicode_bidi_index(map,-1)<0 && unicode_bidi_offset(map,6)<0 && unicode_bidi_level(map,5)<0,"Bidi UTF-8/scalar lookup bounds");unicode_bidi_free(map);
    text="א\nabc\nב";map=unicode_bidi(text,h_len(text),2);h_assert(map && load64(map+24)==1 && load8(ub_record(map,2)+20)==0 && load8(ub_record(map,6)+20)==1,"P1 paragraph bases leaked across separators");h_assert(unicode_bidi_line(map,0,2,levels,order,2)==2 && unicode_bidi_line(map,2,6,levels,order,4)==4 && unicode_bidi_line(map,0,7,levels,order,7)<0,"Cross-paragraph line was accepted");unicode_bidi_free(map);
    text="א⁦⁩  ";map=unicode_bidi(text,h_len(text),0);h_assert(map && unicode_bidi_line(map,0,5,levels,order,5)==5 && !load8(levels+1) && !load8(levels+2) && !load8(levels+3) && !load8(levels+4),"L1 did not reset trailing isolates");unicode_bidi_free(map);
    map=unicode_bidi("",0,3);h_assert(map && !load64(map) && load64(map+24)==1 && !unicode_bidi_line(map,0,0,0,0,0),"Empty auto-RTL paragraph");unicode_bidi_free(map);map=unicode_bidi("123",3,3);h_assert(map && load64(map+24)==1 && unicode_bidi_level(map,0)==2,"Auto-RTL neutral fallback");unicode_bidi_free(map);
    let raw=alloc(8);store8(raw,97);store8(raw+1,0);store8(raw+2,98);map=unicode_bidi(raw,3,2);h_assert(map && load64(map)==3 && unicode_bidi_offset(map,2)==2 && unicode_bidi_level(map,1)<0,"Embedded NUL was not length-delimited");unicode_bidi_free(map);store8(raw,0xc0);store8(raw+1,0xaf);h_assert(!unicode_bidi(raw,2,2),"Overlong bidi UTF-8 accepted");store8(raw,0xed);store8(raw+1,0xa0);store8(raw+2,0x80);h_assert(!unicode_bidi(raw,3,2),"Surrogate bidi UTF-8 accepted");h_assert(!unicode_bidi("a",1,4) && !unicode_bidi("a",-1,0) && !unicode_bidi("a",1048577,0),"Invalid bidi input bounds accepted");syscall(11,raw,8,0,0,0,0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"bidi cases.bin properties.bin");let data=h_read(load64(argv+8));let length=h_file_size;let at=0;let index=0;let text=alloc(65537);let levels=alloc(16384);let order=alloc(131072);
    while at<length{let n=bytes_load32(data+at);let mode=load8(data+at+4);let expected_base=load8(data+at+5);at=at+8;h_assert(n<=16384 && at+n*5+4<=length,"Bidi corpus bounds");let cps=data+at;at=at+n*4;let expected_levels=data+at;at=at+n;let reordered=bytes_load32(data+at);at=at+4;h_assert(reordered<=n && at+reordered*4<=length,"Bidi order bounds");let expected_order=data+at;at=at+reordered*4;
        let bytes=0;let i=0;while i<n{bytes=bytes+bt_utf8(text+bytes,bytes_load32(cps+i*4));i=i+1;}store8(text+bytes,0);let map=unicode_bidi(text,bytes,mode);h_assert(map,unicode_error);if expected_base!=255 && load64(map+24)!=expected_base{bt_bad(index,"base",0,expected_base,load64(map+24));}let count=unicode_bidi_line(map,0,n,levels,order,16384);h_assert(count>=0,unicode_error);
        i=0;while i<n{let want=load8(expected_levels+i);let got=load8(levels+i);if want!=got{bt_bad(index,"level",i,want,got);}i=i+1;}if count!=reordered{bt_bad(index,"order length",0,reordered,count);}i=0;while i<count{let want=bytes_load32(expected_order+i*4);let got=load64(order+i*8);if want!=got{bt_bad(index,"order",i,want,got);}i=i+1;}unicode_bidi_free(map);index=index+1;
    }
    bt_edges(levels,order);let props=alloc(1114112*9);let i=0;while i<1114112{store8(props+i*9,unicode_bidi_class(i));bytes_store32(props+i*9+1,unicode_bidi_bracket(i));bytes_store32(props+i*9+5,unicode_bidi_mirror(i));i=i+1;}h_save_bytes(load64(argv+16),props,1114112*9,420);syscall(11,props,1114112*9,0,0,0,0);h_print(1,h_cat3("PASS ",h_int(index)," Unicode bidi conformance cases plus paragraph/line/UTF-8/bounds edges\n"));return 0;
}
