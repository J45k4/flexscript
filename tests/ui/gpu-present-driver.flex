// Actual GL draw/present timestamp intervals, against independent C queries.
// Compile/run only after any live performance measurement has finished.
import "gpu-present.flex";
import "../../scripts/lib/json.flex";
fn gppd_paint(window){gui_canvas_unclip(window);gui_canvas_size(window,0,0);gui_clear(window,0x142330);gui_canvas_rgba(window,20,20,150,90,0xffc5e3ae);gui_canvas_clip(window,30,30,100,60);gui_canvas_rgba(window,10,10,180,120,0x806030c0);gui_canvas_unclip(window);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"oracle.so report.json");let w=gui_open("GPU draw/present fixture",320,240,GUI_HIGH_DPI);h_assert(w && gui_canvas_open(w,0),gui_error);let lib=ffi_open(load64(argv+8));let read=ffi_symbol(lib,"oracle_timer_read");let exists=ffi_symbol(lib,"oracle_timer_exists");h_assert(lib && read && exists,"Missing independent GPU query oracle");let event=gui_event();let warm=0;
    while warm<3{gppd_paint(w);h_assert(gui_present(w),gui_error);let until=gui_ticks()+40;while gui_ticks()<until{while gui_poll(event){}gui_wait(1);}warm=warm+1;}
    let width=gui_pixel_width(w);let height=gui_pixel_height(w);let bytes=width*height*4;let before=alloc(bytes);let after=alloc(bytes);let out=alloc(48);let independent=alloc(16);let ids=alloc(12*8);gppd_paint(w);h_assert(gui_read_pixels(w,before,width*4,bytes),gui_error);let t=gpp_open(w,3);h_assert(t && load64(load64(t)+96)==64 && load64(load64(t+8)+96)==64,gui_error);
    h_assert(!gpp_open(w,0) && !gpp_open(w,10001),"Invalid timer capacity was accepted");h_assert(!gpp_begin(t,-1) && !gpp_begin(t,3) && !gpp_before_present(t,0) && !gpp_after_present(t,0) && !gpp_poll(t,0,out),"Invalid or unissued GPU presentation state was accepted");let i=0;
    while i<3{h_assert(gpp_begin(t,i) && !gpp_begin(t,i) && !gpp_after_present(t,i),"GPU presentation phase order/reuse differs");gppd_paint(w);h_assert(gpp_before_present(t,i) && !gpp_before_present(t,i) && !gpp_poll(t,i,out),"GPU presentation boundary order differs");h_assert(gui_present(w) && gpp_after_present(t,i) && !gpp_after_present(t,i),gui_error);let a=load64(t);let b=load64(t+8);store64(ids+i*32,bytes_load32(a+256+i*8));store64(ids+i*32+8,bytes_load32(a+260+i*8));store64(ids+i*32+16,bytes_load32(b+256+i*8));store64(ids+i*32+24,bytes_load32(b+260+i*8));i=i+1;}
    let rows=j_array();i=0;while i<3{let ready=0;let until=gui_ticks()+5000;while !ready && gui_ticks()<until{ready=gpp_poll(t,i,out);h_assert(ready>=0,gui_error);if !ready{while gui_poll(event){}gui_wait(1);}}h_assert(ready==1 && !gpp_poll(t,i,out),"GPU presentation result was missing or delivered twice");let pair=0;while pair<2{h_assert(ffi_call(read,load64(ids+i*32+pair*16),load64(ids+i*32+pair*16+8),independent,0,0,0) && load64(independent)==load64(out+pair*24) && load64(independent+8)==load64(out+pair*24+8),"GPU draw/presentation timestamp differs from independent C ABI");pair=pair+1;}h_assert(load64(out)>0xffffffff && load64(out+8)>=load64(out) && load64(out+24)>=load64(out+8) && load64(out+32)>=load64(out+24) && load64(out+16)==load64(out+8)-load64(out) && load64(out+40)==load64(out+32)-load64(out+24),"GPU presentation timestamp precision/order differs");let row=j_object();j_set(row,"start_ns",j_int(load64(out)));j_set(row,"end_ns",j_int(load64(out+32)));j_set(row,"elapsed_ns",j_int(load64(out+32)-load64(out)));j_set(row,"draw_end_ns",j_int(load64(out+8)));j_set(row,"present_start_ns",j_int(load64(out+24)));j_set(row,"draw_elapsed_ns",j_int(load64(out+16)));j_set(row,"present_elapsed_ns",j_int(load64(out+40)));j_push(rows,row);i=i+1;}
    h_assert(load64(load64(t)+112)==6 && load64(load64(t+8)+112)==6 && !gpp_begin(t,0),"GPU presentation result reads or ownership differ");gppd_paint(w);h_assert(gui_read_pixels(w,after,width*4,bytes) && bytes_common_prefix(before,after,bytes)==bytes,"GPU presentation instrumentation changed pixels");i=0;while i<12{h_assert(ffi_call(exists,load64(ids+i*8),0,0,0,0,0),"Owned query disappeared");i=i+1;}h_assert(gpp_close(t),"Live GPU presentation context was lost");i=0;while i<12{h_assert(!ffi_call(exists,load64(ids+i*8),0,0,0,0,0),"GPU presentation query survived cleanup");i=i+1;}
    t=gpp_open(w,1);h_assert(t && gpp_begin(t,0),gui_error);gppd_paint(w);h_assert(gpp_before_present(t,0),gui_error);gui_close(w);h_assert(!gpp_valid(t) && !gpp_after_present(t,0) && !gpp_close(t),"Lost context accepted final marker or retained driver ownership");let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"timer_bits",j_int(64));j_set(report,"rows",rows);j_set(report,"independent_oracle",j_bool(1));j_set(report,"identical_pixels",j_bool(1));j_set(report,"owned_cleanup",j_bool(1));j_set(report,"includes_present_call",j_bool(1));j_set(report,"explicit_final_flush",j_bool(1));h_save(load64(argv+16),j_dump(report));gui_quit();ffi_close(lib);syscall(11,event,128,0,0,0,0);syscall(11,before,bytes,0,0,0,0);syscall(11,after,bytes,0,0,0,0);syscall(11,out,48,0,0,0,0);syscall(11,independent,16,0,0,0,0);syscall(11,ids,96,0,0,0,0);h_print(1,"PASS GPU draw/present intervals, exact independent timestamps, availability, pixels and context/query cleanup\n");return 0;
}
