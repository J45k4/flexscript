    while !load64(cursor+96) && gui_ticks()<until{while gui_poll(event){}gui_wait(20);h_assert(!load64(c+112),wl_error);}
    h_assert(load64(cursor+96) && load64(cursor+40),"Cursor never entered");let seat=load64(w+24);let pointer=load64(w+32);let clipboard=load64(w+224);let device=load64(clipboard+16);h_assert(seat && pointer && device,"Seat/pointer/data-device missing");
