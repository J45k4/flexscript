    h_assert(presses==2 && cancelled==2,"Active drags were not released on pointer leave and capability loss");let metadata=load64(c+200);let callbacks=0;while metadata{if load64(metadata+8)==55{callbacks=callbacks+1;h_assert(!load64(metadata),"Seat removal retained a live cursor callback");}metadata=load64(metadata+24);}h_assert(callbacks==1,"Cursor animation grew callback metadata instead of reusing it");
    let report=j_object();j_set(report,"frames",j_int(frames));j_set(report,"callbacks",j_int(load64(cursor+200)));j_set(report,"callback_records",j_int(callbacks));j_set(report,"cursor_commits",j_int(load64(cursor+208)));j_set(report,"wait_loops",j_int(loops));j_set(report,"scale",j_int(load64(cursor+56)));j_set(report,"seat_lifecycle",j_bool(1));j_set(report,"application_presents",j_int(gui_metrics_value(7)-presents));h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native cursor loaded SDL");gui_close(window);gui_quit();syscall(11,event,128,0,0,0,0);h_print(1,h_cat(j_dump(report),"\n"));return 0;
