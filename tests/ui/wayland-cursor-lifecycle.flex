    h_assert(gui_cursor(window,GUI_CURSOR_DEFAULT),gui_error);h_assert(load64(cursor+144)==2 && load64(cursor+184)==230000000,"Generated animated theme was not selected");let serial=load64(cursor+40);let frames=1;let keyboard_lost=0;let keyboard_restored=0;let left=0;let reentered=0;let pointer_lost=0;let pointer_restored=0;let old_callbacks=0;let old_commits=0;let presents=gui_metrics_value(7);let loops=0;
    let presses=0;let cancelled=0;until=gui_ticks()+8000;while load64(w+24) && gui_ticks()<until{
        while gui_poll(event){if gui_event_kind(event)==GUI_MOUSE_DOWN && gui_event_button(event)==1{presses=presses+1;}if gui_event_kind(event)==GUI_MOUSE_UP && gui_event_button(event)==1 && gui_event_x(event)==-1{h_assert(!load64(event+80),"Cancelled drag retained a clipboard-authorizing serial");cancelled=cancelled+1;}}h_assert(!load64(c+112),wl_error);
        if load64(cursor+152){frames=frames|(1<<load64(cursor+176));}
        if !load64(w+40) && !keyboard_lost{keyboard_lost=1;h_assert(load64(w+24)==seat && load64(w+32)==pointer && load64(clipboard+16)==device,"Keyboard capability loss discarded seat/pointer/clipboard");h_assert(!load64(w+64) && !load64(w+96) && !load64(w+112) && !xk_mods(load64(w+16)) && !gui_focused(window),"Keyboard capability loss retained focus/repeat/modifiers");}
        if keyboard_lost && load64(w+40) && load64(w+64) && gui_focused(window) && load64(load64(w+16)+24){keyboard_restored=1;h_assert(load64(w+24)==seat,"Keyboard restore changed the seat");}
        if keyboard_restored && !load64(cursor+96) && !left{left=1;old_callbacks=load64(cursor+200);old_commits=load64(cursor+208);h_assert(!load64(cursor+192) && !load64(cursor+184) && wn_timeout(cursor,5000)==5000,"Pointer leave retained animation callback/timer");h_assert(!load64(w+264) && !load64(gui__record(window)+120),"Pointer leave retained a pressed mouse button");}
