// Actual compiled Collie views; deterministic, backend-neutral input/updates.
// Work/present-return timings are distinct from compositor presentation feedback.
import "../../libs/ui/desktop.flex";
import "gpu-timing.flex";
import "gpu-present.flex";
import "egl-config.flex";
import "../../apps/collie/ui/app.flex";
extend "../../libs/ui/syntax.flex" with "desktop-source:cu_desktop";
global bp_state=0;global bp_clock=0;global bp_event=0;global bp_scene=0;global bp_ready=0;
global bp_feedback=0;global bp_feedback_rows=0;global bp_feedback_out=0;global bp_feedback_count=0;global bp_feedback_limit=0;global bp_feedback_clock=0;
global bp_interval=0;
fn bp_feedback_collect(){if !bp_feedback{return 0;}while gui_presentation_poll(ud_window,bp_feedback_out){let tag=load64(bp_feedback_out);let status=load64(bp_feedback_out+8);h_assert(tag>=1 && tag<=bp_feedback_limit && (status==1 || status==2),"Unexpected measured presentation result");let slot=bp_feedback_rows+(tag-1)*128;h_assert(!load64(slot+8) && load64(bp_feedback_out+16)==bp_feedback_clock,"Duplicate result or changed presentation clock");bytes_copy(slot,bp_feedback_out,128);bp_feedback_count=bp_feedback_count+1;}return 0;}
fn bp_frame_ready(){if !bp_feedback{return 0;}let until=gui_ticks()+5000;while !gui_frame_ready(ud_window) && gui_ticks()<until{bp_drain();bp_feedback_collect();if !gui_frame_ready(ud_window){gui_wait(1000);}}h_assert(gui_frame_ready(ud_window),"Compositor did not permit the next measured frame");bp_feedback_collect();return 0;}
fn bp_arrival(target){let now=gui_monotonic_ns();while now<target{bp_drain();bp_feedback_collect();let left=target-gui_monotonic_ns();if left>0{gui_wait((left+999999)/1000000);}now=gui_monotonic_ns();}return 0;}
fn bp_drain(){let resize=0;while gui_poll(bp_event){if gui_event_kind(bp_event)==GUI_RESIZE{resize=1;}ui_desktop_event(bp_event);}if resize && bp_ready{let data=j_object();j_set(data,"viewport_width",j_int(gui_width(ud_window)));j_set(data,"viewport_height",j_int(gui_height(ud_window)));bp_update(data);}return 0;}
fn bp_gpu(){if gui__native{return gr_gl(load64(gui__record(ud_window)+8),46,0x1f01,0,0,0,0,0);}if !gui__call("SDL_GL_GetCurrentContext",0,0,0,0,0,0){return "";}let get=gui__call("SDL_GL_GetProcAddress","glGetString",0,0,0,0,0);if !get{return "";}let name=ffi_call(get,0x1f01,0,0,0,0,0);if !name{return "";}return name;}
fn bp_cpu(){syscall(228,3,bp_clock,0,0,0,0);return load64(bp_clock)*1000000000+load64(bp_clock+8);}
fn bp_process_cpu(){syscall(228,2,bp_clock,0,0,0,0);return load64(bp_clock)*1000000000+load64(bp_clock+8);}
fn bp_update(data){
    let request=j_object();j_set(request,"action",j_string("update"));j_set(request,"state",j_parse(bp_state));j_set(request,"data",data);
    j_set(request,"reset",j_bool(!bp_ready));let out=cu_ui_host(request);bp_ready=1;h_assert(!cj_get(out,"error"),cj_text(out,"error"));ui_desktop_apply(out);
    let saved=j_dump(j_need(out,"state"));h_assert(h_len(saved)<8388608,"Benchmark state limit");h_copy(bp_state,saved,h_len(saved)+1);return 0;
}
fn bp_input(kind,x,y,delta,button){
    gui__zero(bp_event,128);store64(bp_event,kind);store64(bp_event+8,ud_window);store64(bp_event+24,x);store64(bp_event+32,y);store64(bp_event+48,delta);store64(bp_event+56,button);
    h_assert(gui_event_enqueue(bp_event),gui_error);h_assert(gui_poll(bp_event),"Queued input missing");ui_desktop_event(bp_event);return 0;
}
fn bp_typing(index){
    // Repeat a bounded Unicode edit cycle rather than accumulating an ever
    // longer draft. Each sample commits text or deletes one whole grapheme.
    let node=ud_need("composer-draft");h_assert(ud_focus==node,"Typing lost composer focus");let phase=index%4;let expected="";let next="ä中👋";
    if phase==1{expected="ä中👋";next="ä中";}else if phase==2{expected="ä中";next="ä";}else if phase==3{expected="ä";next="";}
    h_assert(h_equal(ui_desktop_value("composer-draft"),expected),"Typing cycle started from a stale draft");gui__zero(bp_event,128);store64(bp_event+8,ud_window);
    if !phase{store64(bp_event,GUI_TEXT);h_assert(gui_event_text_set(bp_event,"ä中👋"),gui_error);}else{store64(bp_event,GUI_KEY_DOWN);store64(bp_event+16,42);}
    h_assert(gui_event_enqueue(bp_event) && gui_poll(bp_event),"Typing replay event missing");let change=ui_desktop_event(bp_event);h_assert(change && h_equal(ui_desktop_value("composer-draft"),next),"Typing did not apply the expected Unicode edit");
    // Include the compiled view's model echo, as in the application draft flow.
    let data=j_object();j_set(data,"draft",j_string(next));bp_update(data);h_assert(ud_focus==node && h_equal(ui_desktop_value("composer-draft"),next) && load64(node+144)==h_len(next) && load64(node+152)==h_len(next),"Model echo changed the typed draft, focus or caret");return 0;
}
fn bp_work(index){
    let scroll=ud_need("chat-scroll");let x=load64(scroll+64)+200;let y=load64(scroll+72)+100;
    if h_equal(bp_scene,"scroll"){
        let direction=-1;if (index/24)%2{direction=1;}let before=load64(scroll+136);
        bp_input(GUI_MOUSE_MOVE,x,y,0,0);bp_input(GUI_WHEEL,x,y,direction,0);
        h_assert(load64(scroll+136)!=before,"Scroll sample did not move content");
    }else if h_equal(bp_scene,"selection"){
        let node=ud_need("card-1-body");let px=load64(node+64)+10+(index%12)*29;let py=load64(node+72)+10;let before=load64(node+144);
        bp_input(GUI_MOUSE_MOVE,px,py,0,0);h_assert(ud_focus==node && load64(node+144)!=before,"Selection sample did not move the rendered caret");
    }else if h_equal(bp_scene,"stream"){
        let text=h_buffer();h_text(text,"## Streaming update\n\nA deterministic **native UI** response with `code` and 中文.\n\n");
        let i=0;while i<1+index%30{h_text(text,"More text arrives without changing the model or network fixture. ");i=i+1;}
        let data=j_object();j_set(data,"stream",j_string(h_data(text)));j_set(data,"busy",j_bool(1));bp_update(data);
    }else if h_equal(bp_scene,"navigation"){
        let data=j_object();let page="chat";if index%2{page="settings";}j_set(data,"page",j_string(page));j_set(data,"settings_section",j_string("account"));bp_update(data);
    }else if h_equal(bp_scene,"typing"){bp_typing(index);}
    else{h_die("Unknown benchmark scene");}return 0;
}
fn bp_capture(path){let w=gui_pixel_width(ud_window);let h=gui_pixel_height(ud_window);let n=w*h*4;let p=alloc(n);h_assert(gui_read_pixels(ud_window,p,w*4,n),gui_error);h_save_bytes(path,p,n,420);syscall(11,p,n,0,0,0,0);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"Usage: backend-performance config.json");let config=j_parse(h_read(load64(argv+8)));bp_scene=cj_text(config,"scene");let count=cj_int(config,"samples");h_assert(count>=20 && count<=10000,"Samples must be 20..10000");
    bp_clock=alloc(16);bp_state=alloc(8388609);h_copy(bp_state,"{}",3);bp_event=gui_event();let flags=GUI_RESIZABLE|GUI_HIGH_DPI;if c_flag(config,"hidden"){flags=flags|GUI_HIDDEN;}
    bp_feedback=c_flag(config,"presentation_feedback") || c_flag(config,"native_feedback");bp_interval=cj_int(config,"replay_interval_ns");h_assert(bp_interval==0 || (bp_feedback && bp_interval>=1000000 && bp_interval<=1000000000),"Scheduled replay needs feedback and a 1..1000 ms interval");bp_feedback_limit=count;if bp_feedback{h_assert(!c_flag(config,"hidden"),"Presentation feedback requires a visible window");bp_feedback_rows=alloc(count*128);bytes_fill(bp_feedback_rows,0,count*128);bp_feedback_out=alloc(128);}
    let start=gui_monotonic_ns();h_assert(ui_desktop_open("Collie backend performance",1280,860,flags),gui_error);
    let until=gui_ticks()+80;while gui_ticks()<until{while gui_poll(bp_event){}gui_delay(1);}
    if bp_feedback{h_assert(gui_presentation_enable(ud_window,1),"Presentation feedback is unavailable on the selected backend");let clock=alloc(16);h_assert(gui_presentation_clock(ud_window,clock),"Cannot query compositor presentation clock");bp_feedback_clock=load64(clock);h_assert(!bp_interval || bp_feedback_clock==1,"Scheduled replay requires the advertised monotonic clock, without inferred conversion");syscall(11,clock,16,0,0,0,0);}
    let data=j_parse("{\"platform\":\"linux\",\"page\":\"chat\",\"model\":\"gpt-6.1-sol\",\"authenticated\":true,\"total\":258000,\"used\":4000,\"sidebar_mode\":\"projects\",\"project_name\":\"Benchmark project\",\"project_path\":\"/fixture\"}");
    j_set(data,"viewport_width",j_int(gui_width(ud_window)));j_set(data,"viewport_height",j_int(gui_height(ud_window)));
    let cards=j_array();let i=0;while i<16{let card=j_object();let kind="assistant";if i%2==0{kind="user";}j_set(card,"kind",j_string(kind));let text="Explain the migration and keep the desktop responsive.";
        if i%2{text="## A project note with selectable text for pointer dragging\nSelect **formatted text**, [a guide](https://example.com), `source_code` and 中文 without changing its layout. This paragraph wraps across the message.\n\n| Item | State |\n| --- | --- |\n| Renderer | Ready |\n| Input | Checked |\n\n- Preserve text quality\n- Reuse textures and avoid redundant work\n\n";}
        j_set(card,"text",j_string(text));j_push(cards,card);if i==1{let image=j_parse("{\"kind\":\"image\",\"observation\":{\"type\":\"image\",\"path\":\"/fixture/inline-preview.png\",\"image_id\":\"benchmark-image\"}}");j_push(cards,image);}i=i+1;}j_set(data,"cards",cards);
    let resources=h_join(h_dir(h_real(load64(argv))),"resources/collie");
    ui_desktop_image("resource:mipmap/ic_launcher",h_join(resources,"android/res/drawable-nodpi/collie_border_collie.png"));
    ui_desktop_image("preview:benchmark-image",h_join(resources,"android/res/drawable-nodpi/collie_border_collie.png"));
    let icons=j_parse("[\"new-chat\",\"new-project\",\"settings\"]");i=0;while i<3{let name=j_value(j_at(icons,i));ui_desktop_image(h_cat("resource:collie/",name),h_join(h_join(resources,"desktop/icons"),h_cat(name,".png")));i=i+1;}
    bp_update(data);ui_desktop_draw();ui_desktop_present();let first_frame=gui_monotonic_ns()-start;
    let image=ud_need("card-2-generated-image");h_assert(load64(image+8)==10 && load64(image+160) && load64(image+208)>0 && load64(image+216)>0,"Inline benchmark preview did not decode/upload");
    let scroll=ud_need("chat-scroll");store64(scroll+136,0);store64(scroll+184,0);store64(scroll+200,1);ui_desktop_draw();
    if h_equal(bp_scene,"selection"){let node=ud_need("card-1-body");bp_input(GUI_MOUSE_DOWN,load64(node+64)+5,load64(node+72)+5,0,1);}
    if h_equal(bp_scene,"typing"){h_assert(ui_desktop_focus("composer-draft"),"Cannot focus typing fixture");let node=ud_need("composer-draft");h_assert(!h_len(ui_desktop_value("composer-draft")),"Typing fixture must start empty");store64(node+144,0);store64(node+152,0);}
    let base=h_mark();i=0;while i<48{bp_frame_ready();bp_drain();bp_work(i);ui_desktop_draw();ui_desktop_present();m_reset(0);h_reset(base);i=i+1;}
    let gpu_timer=0;let gpu_present_timer=0;let gpu_present_rows=0;let gpu_rows=0;let gate_waits=0;h_assert(!c_flag(config,"gpu_present_timing") || c_flag(config,"gpu_timing"),"Present timing requires diagnostic GPU timing");if c_flag(config,"gpu_timing"){if c_flag(config,"gpu_present_timing"){gpu_present_timer=gpp_open(ud_window,count);h_assert(gpu_present_timer,gui_error);gpu_timer=load64(gpu_present_timer);gpu_present_rows=alloc(count*48);}else{gpu_timer=gt_open(ud_window,count);}h_assert(gpu_timer,gui_error);gpu_rows=alloc(count*24);gate_waits=alloc(count*8);}
    let cpu=alloc(count*8);let draw_cpu=alloc(count*8);let present_cpu=alloc(count*8);let cleanup_cpu=alloc(count*8);let wall=alloc(count*8);let present=alloc(count*8);let arrivals=alloc(count*8);let dispatches=alloc(count*8);gui_metrics_reset(1);i=0;
    let interval_process_start=bp_process_cpu();let interval_thread_start=bp_cpu();let interval_wall_start=gui_monotonic_ns();
    let schedule_start=interval_wall_start+bp_interval;
    while i<count{
        let arrival=0;if bp_interval{arrival=schedule_start+i*bp_interval;bp_arrival(arrival);}let gate_start=0;if gpu_timer{gate_start=gui_monotonic_ns();}bp_frame_ready();bp_drain();let dispatch=gui_monotonic_ns();if gpu_timer{store64(gate_waits+i*8,dispatch-gate_start);}store64(arrivals+i*8,arrival);store64(dispatches+i*8,dispatch);if bp_feedback{let armed=0;if bp_interval{armed=gui_presentation_track_at(ud_window,i+1,arrival);}else{armed=gui_presentation_track(ud_window,i+1);}h_assert(armed,"Cannot arm measured presentation");}let cpu_start=bp_cpu();let work_start=gui_monotonic_ns();if gpu_present_timer{h_assert(gpp_begin(gpu_present_timer,i),gui_error);}else if gpu_timer{h_assert(gt_begin(gpu_timer,i),gui_error);}
        bp_work(i);ui_desktop_draw();if gpu_present_timer{h_assert(gpp_before_present(gpu_present_timer,i),gui_error);}else if gpu_timer{h_assert(gt_end(gpu_timer,i),gui_error);}let work_end=gui_monotonic_ns();let draw_end=bp_cpu();h_assert(ui_desktop_present(),gui_error);let shown=gui_monotonic_ns();if gpu_present_timer{h_assert(gpp_after_present(gpu_present_timer,i),gui_error);}let submitted_cpu=bp_cpu();m_reset(0);h_reset(base);let cpu_end=bp_cpu();
        store64(cpu+i*8,cpu_end-cpu_start);store64(draw_cpu+i*8,draw_end-cpu_start);store64(present_cpu+i*8,submitted_cpu-draw_end);store64(cleanup_cpu+i*8,cpu_end-submitted_cpu);store64(wall+i*8,work_end-work_start);store64(present+i*8,shown-work_end);i=i+1;
    }
    if bp_feedback{let deadline=gui_ticks()+5000;while bp_feedback_count<count && gui_ticks()<deadline{bp_drain();bp_feedback_collect();if bp_feedback_count<count{gui_wait(1000);}}h_assert(bp_feedback_count==count,"Measured presentation outcomes are incomplete");let stats=alloc(48);h_assert(gui_presentation_stats(ud_window,stats) && !load64(stats) && !load64(stats+8) && !load64(stats+16),"Measured presentation feedback overflowed or leaked");syscall(11,stats,48,0,0,0,0);}
    let interval_wall=gui_monotonic_ns()-interval_wall_start;let interval_thread=bp_cpu()-interval_thread_start;let interval_process=bp_process_cpu()-interval_process_start;
    if gpu_timer{let deadline=gui_ticks()+5000;i=0;while i<count && gui_ticks()<deadline{let ready=0;if gpu_present_timer{ready=gpp_poll(gpu_present_timer,i,gpu_present_rows+i*48);if ready==1{bytes_copy(gpu_rows+i*24,gpu_present_rows+i*48,24);}}else{ready=gt_poll(gpu_timer,i,gpu_rows+i*24);}h_assert(ready>=0,gui_error);if ready{i=i+1;}else{bp_drain();bp_feedback_collect();gui_wait(1);}}h_assert(i==count && load64(gpu_timer+112)==count*2,"GPU timestamp results are incomplete");if gpu_present_timer{h_assert(load64(load64(gpu_present_timer+8)+112)==count*2,"GPU present timestamp results are incomplete");}}
    let metrics=j_array();i=0;while i<16{j_push(metrics,j_int(gui_metrics_value(i)));i=i+1;}gui_metrics_reset(0);
    // Capture after the measured interval and before the next present.
    ui_desktop_draw();let capture=cj_get(config,"capture");if capture{bp_capture(j_value(capture));}
    let report=j_object();j_set(report,"scene",j_string(bp_scene));j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"video_driver",j_string(gui_video_driver()));
    let info=gui_renderer_info(ud_window);h_assert(info,gui_error);j_set(report,"renderer",j_string(load64(info)));j_set(report,"renderer_flags",j_int(gui__u32(info+8)));
    j_set(report,"process_cpu_interval_ns",j_int(interval_process));j_set(report,"thread_cpu_interval_ns",j_int(interval_thread));j_set(report,"wall_interval_ns",j_int(interval_wall));j_set(report,"layout_measure_reuse",j_bool(ud_measure_reuse));j_set(report,"direct_model_copy",j_bool(ud_direct_copy));
    j_set(report,"gpu_timing_enabled",j_bool(gpu_timer!=0));j_set(report,"gpu_present_timing_enabled",j_bool(gpu_present_timer!=0));if gpu_timer{let intervals=j_array();let raw=j_array();let gates=j_array();i=0;while i<count{let slot=gpu_rows+i*24;let row=j_object();j_set(row,"start_ns",j_int(load64(slot)));j_set(row,"end_ns",j_int(load64(slot+8)));j_push(raw,row);j_push(intervals,j_int(load64(slot+16)));j_push(gates,j_int(load64(gate_waits+i*8)));i=i+1;}j_set(report,"gpu_timeline_elapsed_ns",intervals);j_set(report,"gpu_timestamps",raw);j_set(report,"frame_gate_wait_ns",gates);j_set(report,"gpu_timer_bits",j_int(load64(gpu_timer+96)));let reads=load64(gpu_timer+112);let polls=load64(gpu_timer+120);if gpu_present_timer{reads=reads+load64(load64(gpu_present_timer+8)+112);polls=polls+load64(load64(gpu_present_timer+8)+120);}j_set(report,"gpu_query_result_reads",j_int(reads));j_set(report,"gpu_not_ready_polls",j_int(polls));j_set(report,"gpu_timing_boundary",j_string("GL_TIMESTAMP GPU timeline around update/draw with deferred renderer queues drained; includes CPU feeding/idle gaps, excludes swap and compositor; absolute GPU clock is not the presentation clock"));j_set(report,"gpu_timing_instrumented",j_bool(1));}
    if gpu_present_timer{let raw=j_array();let intervals=j_array();let client=j_array();let gaps=j_array();i=0;while i<count{let slot=gpu_present_rows+i*48;let row=j_object();j_set(row,"start_ns",j_int(load64(slot+24)));j_set(row,"end_ns",j_int(load64(slot+32)));j_push(raw,row);j_push(intervals,j_int(load64(slot+40)));j_push(client,j_int(load64(slot+32)-load64(slot)));j_push(gaps,j_int(load64(slot+24)-load64(slot+8)));i=i+1;}j_set(report,"gpu_present_timestamps",raw);j_set(report,"gpu_present_timeline_elapsed_ns",intervals);j_set(report,"gpu_client_timeline_elapsed_ns",client);j_set(report,"gpu_boundary_gap_ns",gaps);j_set(report,"gpu_present_final_flush",j_bool(1));j_set(report,"gpu_timing_boundary",j_string("GL_TIMESTAMP pairs around update/draw and successful present API; explicit glFlush submits the final marker; includes CPU feeding/idle gaps, excludes compositor/scanout and exclusive GPU occupancy; GPU clock is not the presentation clock; diagnostic only"));}
    j_set(report,"gpu_renderer",j_string(bp_gpu()));j_set(report,"egl_config",eglc_snapshot(ud_window));j_set(report,"inline_preview",j_bool(1));let fixture_state=j_parse(bp_state);h_assert(cj_int(fixture_state,"viewport_width")==gui_width(ud_window) && cj_int(fixture_state,"viewport_height")==gui_height(ud_window),"Compiled view viewport differs from the actual window");
    j_set(report,"width",j_int(gui_width(ud_window)));j_set(report,"height",j_int(gui_height(ud_window)));j_set(report,"pixel_width",j_int(gui_pixel_width(ud_window)));j_set(report,"pixel_height",j_int(gui_pixel_height(ud_window)));j_set(report,"first_frame_ns",j_int(first_frame));j_set(report,"presentation_feedback",j_bool(bp_feedback));
    if bp_feedback{let records=j_array();let latency=j_array();let presented=0;let discarded=0;i=0;while i<count{let slot=bp_feedback_rows+i*128;let row=j_object();j_set(row,"tag",j_int(load64(slot)));j_set(row,"status",j_int(load64(slot+8)));j_set(row,"origin_ns",j_int(load64(slot+24)));j_set(row,"submit_ns",j_int(load64(slot+32)));j_set(row,"presented_ns",j_int(load64(slot+40)));j_set(row,"refresh_ns",j_int(load64(slot+48)));j_set(row,"sequence",j_int(load64(slot+56)));j_set(row,"flags",j_int(load64(slot+64)));j_set(row,"output",j_int(load64(slot+72)));j_set(row,"received_ns",j_int(load64(slot+80)));j_push(records,row);if load64(slot+8)==1{h_assert(load64(slot+40)>=load64(slot+32) && load64(slot+32)>=load64(slot+24),"Measured clock interval is inconsistent");j_push(latency,j_int(load64(slot+40)-load64(slot+24)));presented=presented+1;}else{j_push(latency,j_parse("null"));discarded=discarded+1;}i=i+1;}j_set(report,"presentation_records",records);j_set(report,"input_update_to_presentation_ns",latency);j_set(report,"presentation_clock_id",j_int(bp_feedback_clock));j_set(report,"presented_updates",j_int(presented));j_set(report,"discarded_updates",j_int(discarded));j_set(report,"presentation_boundary",j_string("normalized replay/update dispatch to compositor wp_presentation timestamp in its advertised clock; no physical input/scanout proof"));}
    j_set(report,"replay_interval_ns",j_int(bp_interval));if bp_interval{let origins=j_array();let waits=j_array();let dispatched=j_array();i=0;while i<count{let arrival=load64(arrivals+i*8);let dispatch=load64(dispatches+i*8);let slot=bp_feedback_rows+i*128;h_assert(load64(slot+24)==arrival && dispatch>=arrival && load64(slot+40)>=dispatch,"Scheduled arrival/dispatch/presentation clock order differs");j_push(origins,j_int(arrival));j_push(waits,j_int(dispatch-arrival));j_push(dispatched,j_int(load64(slot+40)-dispatch));i=i+1;}j_set(report,"scheduled_arrival_ns",origins);j_set(report,"arrival_to_dispatch_ns",waits);j_set(report,"dispatch_to_presentation_ns",dispatched);j_set(report,"presentation_boundary",j_string("fixed scheduled replay arrival in CLOCK_MONOTONIC to compositor wp_presentation; includes dispatch waiting; no physical input/scanout proof"));}
    if h_equal(bp_scene,"selection"){let node=ud_need("card-1-body");let low=ud_min(load64(node+144),load64(node+152));let high=ud_max(load64(node+144),load64(node+152));let selected=h_slice(ud_content(node)+low,high-low);h_assert(high>low && h_find(selected,"#")<0,"Selection did not contain rendered Markdown text");j_set(report,"selection_text",j_string(selected));j_set(report,"selection_caret",j_int(load64(node+144)));j_set(report,"selection_anchor",j_int(load64(node+152)));}
    if h_equal(bp_scene,"typing"){j_set(report,"typing_verified_updates",j_int(count));j_set(report,"typing_cycle",j_string("ä中👋 -> ä中 -> ä -> empty"));j_set(report,"typing_final_draft",j_string(ui_desktop_value("composer-draft")));j_set(report,"typing_caret",j_int(load64(ud_need("composer-draft")+144)));}
    let d=j_array();let pc=j_array();let cl=j_array();i=0;while i<count{j_push(d,j_int(load64(draw_cpu+i*8)));j_push(pc,j_int(load64(present_cpu+i*8)));j_push(cl,j_int(load64(cleanup_cpu+i*8)));i=i+1;}j_set(report,"cpu_before_present_ns",d);j_set(report,"cpu_present_ns",pc);j_set(report,"cpu_cleanup_ns",cl);j_set(report,"cpu_work_boundary",j_string("thread active CPU: update/input, layout/text/upload/drawing, present submission and arena cleanup; excludes blocked wall time"));
    let c=j_array();let w=j_array();let p=j_array();i=0;while i<count{j_push(c,j_int(load64(cpu+i*8)));j_push(w,j_int(load64(wall+i*8)));j_push(p,j_int(load64(present+i*8)));i=i+1;}j_set(report,"cpu_work_ns",c);j_set(report,"wall_work_ns",w);j_set(report,"present_return_ns",p);
    let maps=h_read("/proc/self/maps");let sdl_loaded=h_find(maps,"libSDL2")>=0;j_set(report,"sdl_loaded",j_bool(sdl_loaded));if h_equal(gui_backend_name(),"wayland"){h_assert(!sdl_loaded,"Native backend loaded SDL or SDL_ttf");}
    if gui__native{let record=gui__record(ud_window);let input=load64(load64(record)+192);j_set(report,"native_seat",j_bool(load64(input+24)!=0));j_set(report,"native_keyboard_keymap",j_bool(load64(load64(input+16)+16)!=0));j_set(report,"native_keyboard_focus",j_bool(load64(input+64)!=0));}
    j_set(report,"counters",metrics);h_save(cj_text(config,"output"),j_dump(report));
    if gpu_present_timer{h_assert(gpp_close(gpu_present_timer),"GPU draw/present context changed before cleanup");syscall(11,gpu_present_rows,count*48,0,0,0,0);}else if gpu_timer{h_assert(gt_close(gpu_timer),"GPU timer context changed before cleanup");}if gpu_timer{syscall(11,gpu_rows,count*24,0,0,0,0);syscall(11,gate_waits,count*8,0,0,0,0);}if bp_feedback{syscall(11,bp_feedback_rows,count*128,0,0,0,0);syscall(11,bp_feedback_out,128,0,0,0,0);}gui_metrics_reset(0);ui_desktop_close();gui_quit();return 0;
}
