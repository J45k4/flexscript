// Test-only checkpoint handshake with an independent private-compositor observer.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
global ww_event=0;global ww_file=0;global ww_ack=0;global ww_out=0;global ww_closes=0;
global ww_layer=0;global ww_font=0;
fn ww_resources(window){ww_font=gui_font_open("sans",18,0);h_assert(ww_font,gui_error);ww_layer=gui_texture_layer(window,16,16);h_assert(ww_layer && gui_texture_target(window,ww_layer) && gui_clear(window,0x9060d0) && gui_texture_target(window,0),gui_error);return 0;}
fn ww_release(){gui_texture_close(ww_layer);gui_font_close(ww_font);ww_layer=0;ww_font=0;return 0;}
fn ww_fds(){let fd=syscall(2,"/proc/self/fd",0x90000,0,0,0,0);h_assert(fd>=0,"Cannot inspect window FD lifetime");let raw=alloc(8192);let count=0;let n=syscall(217,fd,raw,8192,0,0,0);while n>0{let at=0;while at<n{let size=load8(raw+at+16)|(load8(raw+at+17)<<8);h_assert(size>=20 && at+size<=n,"Invalid FD directory record");count=count+1;at=at+size;}n=syscall(217,fd,raw,8192,0,0,0);}syscall(3,fd,0,0,0,0,0);syscall(11,raw,8192,0,0,0,0);return count;}
fn ww_drain(){while gui_poll(ww_event){if gui_event_kind(ww_event)==GUI_CLOSE{ww_closes=ww_closes+1;}}return 0;}
fn ww_checkpoint(step,window){
    let c=load64(gui__record(window));let p=load64(c+456);let row=j_object();j_set(row,"step",j_int(step));j_set(row,"width",j_int(gui_width(window)));j_set(row,"height",j_int(gui_height(window)));j_set(row,"pixel_width",j_int(gui_pixel_width(window)));j_set(row,"pixel_height",j_int(gui_pixel_height(window)));j_set(row,"state",j_int(load64(p+48)));j_set(row,"xdg_version",j_int(wl_call(c,"wl_proxy_get_version",load64(c+40),0,0,0,0,0)));j_set(row,"shown",j_bool(load64(p)));j_set(row,"configured",j_bool(load64(c+104)));j_set(row,"presents",j_int(load64(p+152)));j_set(row,"closes",j_int(ww_closes));j_set(row,"title",j_string(load64(p+64)));h_save(ww_file,j_dump(row));let ack=h_cat3(ww_ack,".",h_int(step));let probe=h_cat(ack,".probe");let probed=0;let probe_seen=0;let probe_tiled=0;let probe_width=0;let probe_height=0;let drawn=load64(p+24);let until=gui_ticks()+10000;while !h_exists(ack) && gui_ticks()<until{ww_drain();if wt_ready(c) && drawn!=load64(p+24) && (step<19 || step>=25){ww_paint(window,-1);drawn=load64(p+24);}if !probe_seen && h_exists(probe){probe_seen=1;let text=h_read(probe);if h_starts(text,"{"){let expected=j_parse(text);probe_tiled=1;probe_width=j_n(expected,"width");probe_height=j_n(expected,"height");}}if !probed && probe_seen && (!probe_tiled || ((load64(p+48)&480) && load64(c+72)==probe_width && load64(c+80)==probe_height)){ww_paint(window,-1);let live=j_object();j_set(live,"width",j_int(gui_width(window)));j_set(live,"height",j_int(gui_height(window)));j_set(live,"pixel_width",j_int(gui_pixel_width(window)));j_set(live,"pixel_height",j_int(gui_pixel_height(window)));j_set(live,"state",j_int(load64(p+48)));h_save(h_cat(probe,".json"),j_dump(live));probed=1;}gui_wait(10);}h_assert(h_exists(ack),h_cat("Compositor checkpoint timed out: ",h_int(step)));return 0;
}
fn ww_ready(window,mask,value){let c=load64(gui__record(window));let p=load64(c+456);let until=gui_ticks()+3000;while (!wt_ready(c) || (load64(p+48)&mask)!=value) && gui_ticks()<until{ww_drain();gui_wait(10);}h_assert(wt_ready(c) && (load64(p+48)&mask)==value,"Window configure/state transition timed out");return 0;}
fn ww_paint(window,step){
    h_assert(gui_clear(window,0x13191f),gui_error);h_assert(gui_fill(window,0,0,32,32,0xe05040),gui_error);h_assert(gui_fill(window,gui_width(window)-32,gui_height(window)-32,32,32,0x40d070),gui_error);h_assert(gui_texture_draw(window,ww_layer,50,50,16,16) && gui_text_draw(window,ww_font,"Cache survives remap",0xe0e8ef,80,50),gui_error);let width=gui_pixel_width(window);let height=gui_pixel_height(window);let bytes=width*height*4;let raw=alloc(bytes);h_assert(gui_read_pixels(window,raw,width*4,bytes),gui_error);let first=raw+(2*width+2)*4;let last=raw+((height-3)*width+width-3)*4;let factor=gui_scale(window);let tile=raw+(((52*factor/1000)*width+52*factor/1000)*4);h_assert(load8(first)==224 && load8(first+1)==80 && load8(last)==64 && load8(last+1)==208 && load8(tile)==144 && load8(tile+1)==96 && load8(tile+2)==208,"Resized/remapped framebuffer or retained texture pixels differ");if step==1 || step==8{h_save_bytes(h_cat3(ww_out,h_int(step),".rgba"),raw,bytes,420);}syscall(11,raw,bytes,0,0,0,0);h_assert(gui_present(window),gui_error);let g=load64(gui__record(window)+8);h_assert(!gr_gl(g,48,0,0,0,0,0,0),"Window lifecycle generated a GL error");return 0;
}
fn ww_opacity(window,step,mode){
    let g=load64(gui__record(window)+8);gui_canvas_unclip(window);let expected=255;
    if mode==0{h_assert(gr_clear(g,0),gr_error);expected=0;}
    else if mode==1{h_assert(gr_clear(g,0),gr_error);gui_canvas_clip(window,0,0,20,20);h_assert(gr_clear(g,0xff13191f),gr_error);expected=0;}
    else if mode==2{gui_clear(window,0x13191f);gui_canvas_rgba(window,0,0,100,60,0x806030c0);}
    else if mode==3{gui_clear(window,0x13191f);gui_canvas_clip(window,0,0,20,20);h_assert(gr_clear(g,0),gr_error);}
    else if mode==4{gui_clear(window,0x13191f);let layer=gui_texture_layer(window,16,16);h_assert(layer && gui_texture_target(window,layer) && gr_clear(g,0) && gui_texture_target(window,0),gui_error);gui_texture_draw(window,layer,0,0,16,16);gui_texture_close(layer);}
    else{gui_canvas_rgba(window,0,0,20,20,0xffc5e3ae);}
    let width=gui_pixel_width(window);let height=gui_pixel_height(window);let bytes=width*height*4;let pixels=alloc(bytes);h_assert(gui_read_pixels(window,pixels,width*4,bytes),gui_error);if mode<5{h_assert(load8(pixels+((height-2)*width+width-2)*4+3)==expected,"Opaque hint probe lost the outside pixel alpha");if mode==1{h_assert(load8(pixels+((2*width+2)*4)+3)==255,"Partial opaque clear did not draw");}if mode==3{h_assert(!load8(pixels+((2*width+2)*4)+3),"Transparent clip did not preserve alpha");}}
    h_save_bytes(h_cat3(ww_out,"opacity-",h_cat(h_int(mode),".rgba")),pixels,bytes,420);syscall(11,pixels,bytes,0,0,0,0);h_assert(gui_present(window),gui_error);h_assert(!gr_gl(g,48,0,0,0,0,0,0),"Opaque hint transition generated a GL error");ww_checkpoint(step,window);return 0;
}
fn ww_size_only(report){
    let window=gui_open("Size constraint fixture",640,420,GUI_HIDDEN);h_assert(window && gui_canvas_open(window,0),gui_error);ww_resources(window);ww_paint(window,0);ww_checkpoint(0,window);h_assert(gui_show(window,1),gui_error);ww_ready(window,0,0);ww_paint(window,1);ww_checkpoint(1,window);h_assert(gui_resize(window,800,500),gui_error);ww_paint(window,2);ww_checkpoint(2,window);h_assert(gui_fullscreen(window,1),gui_error);ww_ready(window,4,4);ww_paint(window,3);ww_checkpoint(3,window);h_assert(gui_fullscreen(window,0),gui_error);ww_ready(window,4,0);ww_paint(window,4);ww_checkpoint(4,window);h_assert(gui_show(window,0) && gui_show(window,1),gui_error);ww_ready(window,0,0);ww_paint(window,5);ww_checkpoint(5,window);h_assert(!ww_closes,"Size fixture closed unexpectedly");ww_release();gui_close(window);window=gui_open("Tiled resize fixture",640,420,GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0),gui_error);ww_resources(window);ww_paint(window,6);ww_checkpoint(6,window);let c=load64(gui__record(window));h_assert(wt_constrained(load64(load64(c+456)+48)),"Compositor tiled edges were not negotiated");let width=gui_width(window);let height=gui_height(window);h_assert(gui_resize(window,400,260) && gui_width(window)==width && gui_height(window)==height,"Client resize overrode tiled compositor bounds");ww_paint(window,7);ww_checkpoint(7,window);ww_ready(window,480,0);h_assert(gui_width(window)==400 && gui_height(window)==260,"Preferred tiled restore size was lost");ww_paint(window,8);ww_checkpoint(8,window);ww_release();gui_close(window);gui_quit();h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native size fixture loaded SDL");h_save(report,"{\"fixed_size\":true,\"hidden_readback\":true,\"gl_error\":0}");syscall(11,ww_event,128,0,0,0,0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==5 || (argc==6 && h_equal(load64(argv+40),"--size-only")),"checkpoint ack-prefix capture-prefix report [--size-only]");ww_file=load64(argv+8);ww_ack=load64(argv+16);ww_out=load64(argv+24);ww_event=gui_event();h_assert(gui_backend_select("wayland"),gui_error);if argc==6{return ww_size_only(load64(argv+32));}let window=gui_open("Lifecycle initial",640,420,GUI_HIDDEN|GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0),gui_error);let c=load64(gui__record(window));let life=load64(c+456);let renderer=load64(gui__record(window)+8);gui_metrics_reset(1);let title=alloc(32);bytes_copy(title,"Lifecycle 中文",17);h_assert(gui_title(window,title),gui_error);bytes_fill(title,88,16);syscall(11,title,32,0,0,0,0);ww_resources(window);ww_paint(window,0);h_assert(!load64(life+152) && !gui_metrics_value(7),"Hidden window attached/presented a buffer");ww_checkpoint(0,window);
    h_assert(gui_show(window,1),gui_error);ww_ready(window,0,0);ww_paint(window,1);ww_checkpoint(1,window);
    h_assert(gui_resize(window,800,500),gui_error);h_assert(gui_width(window)==800 && gui_height(window)==500,"Client-requested normal size did not take effect");h_assert(!gui_resize(window,16384,16384) && !load64(c+112),"Oversized resize killed the connection or was accepted");ww_paint(window,2);ww_checkpoint(2,window);
    h_assert(gui_fullscreen(window,1),gui_error);ww_ready(window,4,4);ww_paint(window,3);ww_checkpoint(3,window);
    let fullw=gui_width(window);let fullh=gui_height(window);h_assert(gui_resize(window,700,460),gui_error);h_assert(gui_width(window)==fullw && gui_height(window)==fullh,"Resize overrode compositor fullscreen bounds");h_assert(gui_fullscreen(window,0),gui_error);ww_ready(window,4,0);h_assert(gui_width(window)==700 && gui_height(window)==460,"Resize while fullscreen lost preferred restore size");ww_paint(window,4);ww_checkpoint(4,window);
    h_assert(gui_maximize(window,1),gui_error);ww_ready(window,2,2);ww_paint(window,5);ww_checkpoint(5,window);h_assert(gui_maximize(window,0),gui_error);ww_ready(window,2,0);ww_paint(window,6);ww_checkpoint(6,window);
    let presents=load64(life+152);h_assert(gui_show(window,0) && gui_present(window),gui_error);ww_drain();h_assert(!gui_focused(window) && !gui_mouse_buttons(window) && load64(life+152)==presents,"Hide retained focus/input or presented content");ww_checkpoint(7,window);
    h_assert(gui_title(window,"Hidden title 中文") && gui_resize(window,720,480) && gui_fullscreen(window,1),gui_error);h_assert(gui_show(window,1),gui_error);h_assert(!load64(c+104) && gui_present(window) && load64(life+152)==presents,"Remap attached a buffer before fresh configure");ww_ready(window,4,4);h_assert(load64(gui__record(window)+8)==renderer,"Remap replaced the renderer/cache owner");ww_paint(window,8);ww_checkpoint(8,window);
    h_assert(gui_restore(window),gui_error);ww_ready(window,6,0);ww_paint(window,9);ww_checkpoint(9,window);h_assert(gui_minimize(window),gui_error);ww_checkpoint(10,window);h_assert(gui_restore(window),gui_error);ww_ready(window,6,0);ww_paint(window,11);ww_checkpoint(11,window);
    let i=0;while i<20{h_assert(gui_show(window,0) && gui_show(window,1),gui_error);i=i+1;}ww_ready(window,0,0);ww_paint(window,12);ww_checkpoint(12,window);h_assert(!ww_closes,"Window unexpectedly closed during lifecycle checks");
    ww_checkpoint(13,window);let until=gui_ticks()+3000;while !ww_closes && gui_ticks()<until{ww_drain();gui_wait(10);}ww_drain();h_assert(ww_closes==1,"Compositor close was missing or repeated");ww_release();gui_close(window);h_assert(!gui_width(window),"Closed handle remained usable");
    let descriptors=j_array();i=0;while i<12{let previous=window;window=gui_open("Repeated hidden window",320+i*8,240,GUI_HIDDEN|GUI_RESIZABLE);h_assert(window && window!=previous && gui_canvas_open(window,0),gui_error);h_assert(!gui_width(previous),"Reopened generation accepted a stale handle");h_assert(gui_clear(window,0x13191f) && gui_present(window) && gui_resize(window,400,260),gui_error);gui_close(window);gui_delay(10);j_push(descriptors,j_int(ww_fds()));i=i+1;}i=4;while i<12{h_assert(j_value(j_at(descriptors,i))==j_value(j_at(descriptors,4)),"Repeated native window creation leaked descriptors");i=i+1;}
    window=gui_open("Fixed window",640,420,0);h_assert(window && gui_canvas_open(window,0),gui_error);ww_resources(window);ww_paint(window,14);ww_checkpoint(14,window);h_assert(gui_resize(window,800,500),gui_error);ww_paint(window,15);ww_checkpoint(15,window);h_assert(gui_fullscreen(window,1),gui_error);ww_ready(window,4,4);ww_paint(window,16);ww_checkpoint(16,window);h_assert(gui_fullscreen(window,0),gui_error);ww_ready(window,4,0);ww_paint(window,17);ww_checkpoint(17,window);h_assert(gui_show(window,0) && gui_show(window,1),gui_error);ww_ready(window,0,0);ww_paint(window,18);ww_checkpoint(18,window);i=0;while i<6{ww_opacity(window,19+i,i);i=i+1;}ww_release();gui_close(window);
    window=gui_open("Disconnect fixture",640,420,GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0),gui_error);ww_resources(window);ww_paint(window,25);ww_checkpoint(25,window);until=gui_ticks()+5000;while ww_closes<2 && gui_ticks()<until{ww_drain();gui_wait(10);}ww_drain();h_assert(ww_closes==2 && !gui_focused(window) && !gui_mouse_buttons(window),"Disconnect did not emit one close and release input");h_assert(!gui_present(window),"Disconnected window reported successful presentation");h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native lifecycle loaded SDL");ww_release();gui_close(window);gui_quit();let result=j_object();j_set(result,"backend",j_string("wayland"));j_set(result,"closes",j_int(ww_closes));j_set(result,"rapid_remaps",j_int(20));j_set(result,"reopen_fd_counts",descriptors);j_set(result,"gl_error",j_int(0));h_save(load64(argv+32),j_dump(result));syscall(11,ww_event,128,0,0,0,0);h_print(1,h_cat(j_dump(result),"\n"));return 0;
}
