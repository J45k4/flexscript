// Odd weighted-row remainders must not rerasterize unchanged text every draw.
import "../../libs/ui/desktop.flex";
fn main(argc,argv){
    h_environment(argc,argv);h_assert(ui_desktop_open("Weighted layout checks",240,100,GUI_HIDDEN),gui_error);ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"row\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"row\",\"kind\":\"row\",\"props\":{\"width\":219,\"height\":60,\"gap\":4},\"children\":[{\"key\":\"a\",\"kind\":\"text\",\"text\":\"A\",\"props\":{\"weight\":1,\"padding_x\":4,\"color\":\"#eeeeee\"},\"children\":[]},{\"key\":\"b\",\"kind\":\"text\",\"text\":\"B\",\"props\":{\"weight\":2,\"padding_x\":4,\"color\":\"#eeeeee\"},\"children\":[]},{\"key\":\"c\",\"kind\":\"text\",\"text\":\"C\",\"props\":{\"weight\":3,\"padding_x\":4,\"color\":\"#eeeeee\"},\"children\":[]}]}}]}"));ui_desktop_draw();let a=ud_need("a");let b=ud_need("b");let c=ud_need("c");h_assert(load64(a+80)==35 && load64(b+80)==70 && load64(c+80)==106 && load64(c+64)+load64(c+80)==219,"Weighted row lost or duplicated remainder pixels");h_assert(load64(a+168)==27 && load64(b+168)==62 && load64(c+168)==98,"Text was measured at a different assigned width");
    let pitch=gui_pixel_width(ud_window)*4;let bytes=pitch*gui_pixel_height(ud_window);let first=alloc(bytes);let last=alloc(bytes);h_assert(gui_read_pixels(ud_window,first,pitch,bytes),gui_error);gui_metrics_reset(1);let i=0;while i<8{ui_desktop_draw();i=i+1;}h_assert(!gui_metrics_value(2) && !gui_metrics_value(3) && !gui_metrics_value(5) && !gui_metrics_value(6),"Unchanged weighted row rebuilt textures or measured/rasterized text");h_assert(gui_read_pixels(ud_window,last,pitch,bytes) && bytes_common_prefix(first,last,bytes)==bytes,"Warm weighted row pixels changed");
    ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"attribute\",\"key\":\"row\",\"name\":\"width\",\"value\":218}]}"));gui_metrics_reset(1);ui_desktop_draw();h_assert(load64(c+80)==105 && load64(c+168)==97 && load64(c+64)+load64(c+80)==218 && gui_metrics_value(2)>0,"Width change did not remeasure the affected text");gui_metrics_reset(1);ui_desktop_draw();h_assert(!gui_metrics_value(2) && !gui_metrics_value(3) && !gui_metrics_value(5) && !gui_metrics_value(6),"New weighted widths did not become stable");gui_metrics_reset(0);ui_desktop_close();gui_quit();syscall(11,first,bytes,0,0,0,0);syscall(11,last,bytes,0,0,0,0);h_print(1,"PASS weighted odd/even row widths, stable warm pixels, zero redundant textures/measurements/rasterization and width invalidation\n");return 0;
}
