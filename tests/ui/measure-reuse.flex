// Differential geometry/pixels against the original full measurement traversal.
import "../../libs/ui/desktop.flex";
global mr_checks=0;global mr_saved=0;global mr_pixels=0;global mr_bytes=0;global mr_reused=0;
fn mr_node(key,kind,props,text){let n=j_object();j_set(n,"key",j_string(key));j_set(n,"kind",j_string(kind));j_set(n,"props",j_parse(props));j_set(n,"text",j_string(text));j_set(n,"children",j_array());return n;}
fn mr_child(parent,child){j_push(j_get(parent,"children"),child);return child;}
fn mr_apply(op){let p=j_object();j_set(p,"version",j_int(1));let ops=j_array();j_push(ops,op);j_set(p,"ops",ops);ui_desktop_apply(p);return 0;}
fn mr_property(key,name,value){let op=j_object();j_set(op,"op",j_string("attribute"));j_set(op,"key",j_string(key));j_set(op,"name",j_string(name));j_set(op,"value",value);return mr_apply(op);}
fn mr_text(key,value){let op=j_object();j_set(op,"op",j_string("text"));j_set(op,"key",j_string(key));j_set(op,"value",j_string(value));return mr_apply(op);}
fn mr_compare(label){
    let width=gui_pixel_width(ud_window);let height=gui_pixel_height(ud_window);let bytes=width*height*4;if bytes!=mr_bytes{if mr_pixels{syscall(11,mr_pixels,mr_bytes,0,0,0,0);}mr_pixels=alloc(bytes);mr_bytes=bytes;}let reference=alloc(bytes);h_assert(mr_pixels>0 && reference>0,"Cannot allocate measurement pixel comparison");
    ud_measure_reuse=1;gui_metrics_reset(1);ui_desktop_draw();let reused=gui_metrics_value(15);let i=0;while i<2048{let n=ud_nodes+i*256;let out=mr_saved+i*128;bytes_fill(out,0,128);if load64(n){store64(out,load64(n+192));bytes_copy(out+8,n+64,80);bytes_copy(out+88,n+208,16);}i=i+1;}h_assert(gui_read_pixels(ud_window,mr_pixels,width*4,bytes),gui_error);
    // Disabling reuse follows the unchanged measurement/layout algorithm;
    // no cache-key or expected-geometry logic is shared with the comparator.
    ud_measure_reuse=0;gui_metrics_reset(1);ui_desktop_draw();let full=gui_metrics_value(15);h_assert(full>=reused,"Memoization performed more measurements than full traversal");if full>reused{mr_reused=mr_reused+1;}
    let message=h_cat("Measured geometry differs from full traversal: ",label);i=0;while i<2048{let n=ud_nodes+i*256;let out=mr_saved+i*128;if load64(n){h_assert(load64(out)==load64(n+192) && bytes_common_prefix(out+8,n+64,80)==80 && bytes_common_prefix(out+88,n+208,16)==16,message);}i=i+1;}
    h_assert(gui_read_pixels(ud_window,reference,width*4,bytes) && bytes_common_prefix(mr_pixels,reference,bytes)==bytes,h_cat("Measured pixels differ from full traversal: ",label));syscall(11,reference,bytes,0,0,0,0);mr_checks=mr_checks+1;ud_measure_reuse=1;gui_metrics_reset(0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==1 || argc==2,"[report.json]");mr_saved=alloc(2048*128);h_assert(ui_desktop_open("Measurement reuse",320,240,GUI_HIDDEN|GUI_RESIZABLE),gui_error);
    let root=mr_node("root","column","{\"width\":-1,\"height\":-1,\"padding\":3,\"gap\":2}","");mr_child(root,mr_node("heading","text","{\"size\":14,\"color\":\"#eeeeee\"}","A retained layout"));let scroll=mr_child(root,mr_node("scroll","scroll","{\"height\":125,\"width\":-1,\"padding\":2}",""));let body=mr_child(scroll,mr_node("body","column","{\"width\":-1,\"gap\":2}",""));let i=0;
    while i<8{let row=mr_child(body,mr_node(h_cat("row-",h_int(i)),"row",h_cat3("{\"width\":-1,\"gap\":",h_int(1+i%3),"}"),""));let nested=mr_child(row,mr_node(h_cat("nested-",h_int(i)),"column","{\"weight\":2,\"gap\":1,\"padding_x\":2}",""));mr_child(nested,mr_node(h_cat("a-",h_int(i)),"text","{\"size\":12,\"padding_x\":2,\"color\":\"#eeeeee\"}","Wrapped words abc 中文 é אבג"));mr_child(nested,mr_node(h_cat("b-",h_int(i)),"text","{\"size\":11,\"font\":\"monospace\",\"color\":\"#c5e3ae\"}","a long word without spaces: abcdefghijklmnopqrstuvwxyz"));mr_child(row,mr_node(h_cat("c-",h_int(i)),"text","{\"weight\":3,\"size\":13,\"color\":\"#eeeeee\"}","The other weighted column keeps exact remainder pixels."));i=i+1;}
    let intrinsic=mr_child(body,mr_node("intrinsic","column","{\"width\":-2,\"padding\":2}",""));mr_child(intrinsic,mr_node("intrinsic-text","text","{\"size\":13,\"color\":\"#eeeeee\"}","Intrinsic wrapping can trigger a second measurement width."));
    mr_child(body,mr_node("image","image","{\"source\":\"preview:reuse\"}",""));mr_child(root,mr_node("draft","input","{\"value\":\"short\",\"min_lines\":1,\"max_lines\":3,\"size\":13,\"color\":\"#eeeeee\"}",""));let op=j_object();j_set(op,"op",j_string("insert"));j_set(op,"key",j_string("root"));j_set(op,"parent",j_string("mount"));j_set(op,"after",j_string(""));j_set(op,"node",root);mr_apply(op);
    mr_compare("cold nested rows and unresolved image");mr_compare("warm nested rows");i=0;while i<6{gui_resize(ud_window,319+i,240+i);mr_compare("odd/even window widths");i=i+1;}
    mr_property("nested-2","padding_x",j_int(7));mr_compare("padding patch");mr_property("a-3","size",j_int(18));mr_compare("font patch");mr_text("a-1","A replacement longer than before with CJK 中文 and several wrapped lines.");mr_compare("content patch");mr_property("c-4","hidden",j_bool(1));mr_compare("hidden child");mr_property("c-4","hidden",j_bool(0));mr_compare("shown child");
    ui_desktop_focus("draft");ud_replace(ud_need("draft"),"\nnew multiline draft 中文");mr_compare("local edit");store64(ud_need("scroll")+136,70);mr_compare("scroll geometry");mr_property("scroll","follow",j_bool(1));mr_text("b-7","Extended content\nwith more\nlines at the bottom");mr_compare("follow after content patch");
    ui_desktop_image("preview:reuse","apps/collie/android/res/drawable-nodpi/collie_border_collie.png");mr_compare("resolved image binding");h_assert(load64(ud_need("image")+160),"Resolved fixture image did not load");let c=image_context();let image=image_create(c,32,16,1);h_assert(image,image_error(c));bytes_fill(image_pixels(image),255,32*16*4);let png=image_encode_png(c,image);h_assert(png,image_error(c));let image_path=h_cat3("build/measure-reuse-",h_int(syscall(39,0,0,0,0,0,0)),".png");h_save_bytes(image_path,image_blob_data(png),image_blob_size(png),420);image_blob_free(png);image_free(image);image_context_free(c);ui_desktop_image("preview:reuse",image_path);mr_compare("changed image dimensions");h_assert(load64(ud_need("image")+208)==32 && load64(ud_need("image")+216)==16,"Rebound image dimensions stayed stale");
    // Invalidate resources without a descriptor patch, as on renderer reset.
    let event=gui_event();store64(event,GUI_RENDER_RESET);store64(event+8,ud_window);ui_desktop_event(event);mr_compare("renderer reset");syscall(11,event,128,0,0,0,0);ud_measure_pass=9223372036854775807;mr_compare("pass rollover");h_assert(mr_reused==mr_checks,"A fixture draw did not eliminate repeated measurement work");let backend=gui_backend_name();let error=0;if gui__native{error=gr_gl(load64(gui__record(ud_window)+8),48,0,0,0,0,0,0);h_assert(!error && h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native measurement fixture loaded SDL or caused a GL error");}
    // Deliberately remeasure a descendant between two identical parent calls.
    // The second parent call must repair that descendant, not reuse stale work.
    ud_measure_pass=ud_measure_pass+1;let parent=ud_need("intrinsic");let child=ud_need("intrinsic-text");ud_measure(parent,200);ud_measure(child,40);ud_measure(parent,200);let measured=alloc(32);bytes_copy(measured,parent+96,16);bytes_copy(measured+16,child+96,16);ud_measure_reuse=0;ud_measure(parent,200);h_assert(bytes_common_prefix(measured,parent+96,16)==16 && bytes_common_prefix(measured+16,child+96,16)==16,"Descendant reflow left a stale parent measurement");syscall(11,measured,32,0,0,0,0);ud_measure_reuse=1;
    ui_desktop_close();h_assert(!ud_measures && !ud_measure_pass,"Measurement cache survived UI close");h_assert(ui_desktop_open("Reopened measurement cache",160,100,GUI_HIDDEN),gui_error);ui_desktop_close();h_assert(!ud_measures,"Reopened measurement cache was not released");gui_quit();syscall(87,image_path,0,0,0,0,0);let report=j_object();j_set(report,"backend",j_string(backend));j_set(report,"checks",j_int(mr_checks));j_set(report,"reused_draws",j_int(mr_reused));j_set(report,"ancestor_reflow",j_bool(1));j_set(report,"byte_identical",j_bool(1));j_set(report,"geometry_identical",j_bool(1));j_set(report,"gl_error",j_int(error));j_set(report,"cache_bytes",j_int(32768));if argc==2{h_save(load64(argv+8),j_dump(report));}h_print(1,h_cat(j_dump(report),"\n"));syscall(11,mr_saved,2048*128,0,0,0,0);syscall(11,mr_pixels,mr_bytes,0,0,0,0);return 0;
}
