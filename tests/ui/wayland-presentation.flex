// Real compositor feedback and frame pacing. Headless results are not scanout
// or physical input latency. The independent driver checks raw protocol events.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn pf_swap_failure(path){
    h_assert(gui_backend_select("wayland"),gui_error);let window=gui_open("Presentation failure fixture",640,420,GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0) && gui_presentation_enable(window,1),"Cannot open presentation failure fixture");let c=load64(gui__record(window));let g=load64(gui__record(window)+8);let display=load64(g+16);let out=alloc(128);let stats=alloc(48);h_assert(gui_presentation_track(window,9) && gui_clear(window,0x26332b),"Cannot arm presentation failure fixture");gui_metrics_reset(1);
    // Invalid parameter to the actual driver, without changing its current
    // context or destroying any display/surface. Restore before normal cleanup.
    store64(g+16,0);let result=gui_present(window);let error=gr_egli(g,"eglGetError",0,0,0,0,0,0);store64(g+16,display);h_assert(!result && error==0x3008 && gui_error && load8(gui_error),"Driver swap failure was not reported");h_assert(gui_frame_ready(window) && !load64(c+168) && !gui_metrics_value(7),"Failed swap left a blocking frame or counted a presentation");h_assert(gui_presentation_poll(window,out) && load64(out)==9 && load64(out+8)==3 && gui_presentation_stats(window,stats) && !load64(stats) && !load64(stats+8) && !load64(stats+16) && load64(stats+24)==1,"Failed swap leaked its pending measurement");let row=j_object();j_set(row,"egl_error",j_int(error));j_set(row,"frame_ready_after_failure",j_bool(1));j_set(row,"pending",j_int(load64(stats)));j_set(row,"cancelled",j_int(load64(stats+24)));j_set(row,"presents",j_int(gui_metrics_value(7)));h_save(path,j_dump(row));gui_close(window);gui_quit();syscall(11,out,128,0,0,0,0);syscall(11,stats,48,0,0,0,0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);if argc==3 && h_equal(load64(argv+8),"--swap-failure"){return pf_swap_failure(load64(argv+16));}h_assert(argc==2,"Provide report.json");h_assert(gui_backend_select("wayland"),gui_error);let window=gui_open("Presentation feedback fixture",640,420,GUI_HIDDEN|GUI_RESIZABLE|GUI_HIGH_DPI);h_assert(window && gui_canvas_open(window,0),gui_error);let event=gui_event();let clock=alloc(16);let out=alloc(128);let stats=alloc(48);h_assert(!gui_frame_ready(window) && !gui_presentation_track(window,999),"Hidden surface was ready for a submitted frame");let until=gui_ticks()+3000;while !gui_presentation_enable(window,1) && gui_ticks()<until{while gui_poll(event){}gui_wait(20);}h_assert(gui_presentation_clock(window,clock),"Private compositor did not provide a usable presentation clock");let clock_id=load64(clock);h_assert(gui_show(window,1),gui_error);
    let rows=j_array();let seen=alloc(32);bytes_fill(seen,0,32);let submitted=0;let received=0;let presented=0;let discarded=0;let count=24;let c=load64(gui__record(window));until=gui_ticks()+8000;
    while (received<count || submitted<count || !gui_frame_ready(window)) && gui_ticks()<until{
        while gui_poll(event){h_assert(gui_event_kind(event)!=GUI_CLOSE,"Presentation fixture closed unexpectedly");}
        while gui_presentation_poll(window,out){let tag=load64(out);let status=load64(out+8);h_assert(tag>=1 && tag<=count && !load8(seen+tag) && (status==1 || status==2),"Unexpected/duplicate presentation outcome");store8(seen+tag,1);received=received+1;h_assert(load64(out+16)==clock_id && load64(out+24)>0 && load64(out+32)>=load64(out+24),"Feedback changed clock or submission order");let row=j_object();j_set(row,"tag",j_int(tag));j_set(row,"status",j_int(status));j_set(row,"clock_id",j_int(load64(out+16)));j_set(row,"origin_ns",j_int(load64(out+24)));j_set(row,"submit_ns",j_int(load64(out+32)));j_set(row,"presented_ns",j_int(load64(out+40)));j_set(row,"refresh_ns",j_int(load64(out+48)));j_set(row,"sequence",j_int(load64(out+56)));j_set(row,"flags",j_int(load64(out+64)));j_set(row,"output",j_int(load64(out+72)));j_set(row,"received_ns",j_int(load64(out+80)));j_push(rows,row);if status==1{h_assert(load64(out+40)>=load64(out+32) && load64(out+80)>=load64(out+40),"Presented/receipt timestamp is outside the declared clock interval");presented=presented+1;}else{discarded=discarded+1;}}
        if submitted<count && gui_frame_ready(window){h_assert(gui_presentation_track(window,submitted+1),"Cannot arm next presentation tag");h_assert(!gui_presentation_track(window,999),"Armed measurement was overwritten");let color=0x20352b;if submitted%2{color=0x354f43;}gui_clear(window,color);gui_fill(window,30+(submitted*7)%160,35,180,100,0xb4d59c);h_assert(gui_present(window),gui_error);submitted=submitted+1;}
        if received<count || submitted<count || !gui_frame_ready(window){gui_wait(1000);}
    }
    h_assert(submitted==count && received==count && presented>=count/2 && load64(c+208)==count,"Compositor presentation/frame completion was incomplete");h_assert(gui_presentation_stats(window,stats) && !load64(stats) && !load64(stats+8) && !load64(stats+16) && load64(stats+32)==presented && load64(stats+40)==discarded,"Feedback accounting differs");h_assert(gui_presentation_track(window,1000) && gui_show(window,0),"Cannot hide an armed window");h_assert(!gui_frame_ready(window) && gui_presentation_poll(window,out) && load64(out)==1000 && load64(out+8)==3,"Unmapping did not cancel the armed measurement");h_assert(gui_show(window,1),gui_error);until=gui_ticks()+3000;while !gui_frame_ready(window) && gui_ticks()<until{while gui_poll(event){}gui_wait(20);}h_assert(gui_frame_ready(window) && gui_presentation_track(window,1001) && gui_clear(window,0x513b35) && gui_present(window),"Cannot submit a pending cancellation fixture");h_assert(gui_show(window,0) && !load64(c+168) && gui_presentation_poll(window,out) && load64(out)==1001 && load64(out+8)==3,"Unmapping did not cancel pending feedback/frame callback");h_assert(gui_presentation_enable(window,0) && !gui_presentation_track(window,1002),"Disabled telemetry accepted an arm");h_assert(gui_presentation_stats(window,stats) && !load64(stats) && !load64(stats+8) && !load64(stats+16) && load64(stats+24)==2,"Cancel/disable leaked a pending result");let maps=h_read("/proc/self/maps");h_assert(h_find(maps,"libSDL2")<0,"Native presentation loaded SDL");let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"clock_id",j_int(clock_id));j_set(report,"submitted",j_int(submitted));j_set(report,"presented",j_int(presented));j_set(report,"discarded",j_int(discarded));j_set(report,"frame_callbacks",j_int(load64(c+208)));j_set(report,"cancelled_armed",j_int(1));j_set(report,"cancelled_pending",j_int(1));j_set(report,"rows",rows);j_set(report,"gl_error",j_int(gr_gl(load64(gui__record(window)+8),48,0,0,0,0,0,0)));j_set(report,"sdl_loaded",j_bool(0));h_assert(!j_value(j_get(report,"gl_error")),"Presentation fixture has a GL error");h_save(load64(argv+8),j_dump(report));gui_close(window);gui_quit();syscall(11,event,128,0,0,0,0);syscall(11,clock,16,0,0,0,0);syscall(11,out,128,0,0,0,0);syscall(11,stats,48,0,0,0,0);syscall(11,seen,32,0,0,0,0);h_print(1,"PASS native compositor presentation records, clock domain, frame pacing, cancellation and bounded ownership\n");return 0;
}
