// Private compositor + independent pipe/input producer. Never reads owned GUI FDs.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
global wf_event=0;global wf_stage=0;global wf_sources=0;global wf_key=0;global wf_wakes=0;
fn wf_mark(name){h_save(wf_stage,name);return 0;}
fn wf_wait(count,interest,key){let until=gui_ticks()+5000;let found=0;while !found && gui_ticks()<until{let left=until-gui_ticks();if left<0{left=0;}gui_wait_sources(left,wf_sources,count);wf_wakes=wf_wakes+1;let i=0;while i<count{if load64(wf_sources+i*24+16)&interest{found=1;}i=i+1;}while gui_poll(wf_event){if gui_event_kind(wf_event)==GUI_KEY_DOWN && gui_event_code(wf_event)==GUI_KEY_ESCAPE{wf_key=1;}h_assert(gui_event_kind(wf_event)!=GUI_CLOSE,"Native wait fixture unexpectedly closed");}if key && wf_key{found=1;}}h_assert(found,"Native source/input wait timed out");return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==5,"read-fd write-fd stage-file report");let input=h_number(load64(argv+8));let output=h_number(load64(argv+16));wf_stage=load64(argv+24);h_assert(gui_backend_select("wayland"),gui_error);let window=gui_open("Wait source fixture",640,420,GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0),gui_error);gui_clear(window,0x13191f);gui_present(window);gui_text_input(0);wf_event=gui_event();let until=gui_ticks()+3000;while !gui_focused(window) && gui_ticks()<until{while gui_poll(wf_event){}gui_wait(20);}h_assert(gui_focused(window),"Private compositor did not focus the wait fixture");
    wf_sources=alloc(48);bytes_fill(wf_sources,0,48);store64(wf_sources,input);store64(wf_sources+8,GUI_WAIT_READ);store64(wf_sources+24,output);store64(wf_sources+32,GUI_WAIT_WRITE);let scratch=alloc(8192);wf_mark("read");let before=gui_monotonic_ns();wf_wait(1,GUI_WAIT_READ,0);let read_time=gui_monotonic_ns();h_assert(load64(wf_sources+16)&GUI_WAIT_READ && syscall(0,input,scratch,1,0,0,0)==1 && load8(scratch)==82,"Source wait lost or consumed input");
    bytes_fill(scratch,65,8192);let n=1;while n>0{n=syscall(1,output,scratch,8192,0,0,0);}h_assert(n==-11,"Write fixture did not reach backpressure");wf_mark("write");wf_wait(2,GUI_WAIT_WRITE,0);h_assert(load64(wf_sources+40)&GUI_WAIT_WRITE,"Write readiness did not recover");
    wf_mark("gui");wf_wait(1,0,1);h_assert(wf_key && !load64(wf_sources+16),"GUI input was lost or confused with FD readiness");wf_mark("hup");wf_wait(1,GUI_WAIT_HUP,0);h_assert(syscall(0,input,scratch,1,0,0,0)==0,"Hangup did not leave caller-owned EOF");syscall(3,input,0,0,0,0,0);h_assert(gui_wait_sources(5000,wf_sources,1) && (load64(wf_sources+16)&GUI_WAIT_INVALID),"Closed source did not report invalid");
    let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"read_wait_ns",j_int(read_time-before));j_set(report,"read_observed_ns",j_int(read_time));j_set(report,"wait_calls",j_int(wf_wakes));j_set(report,"gui_key",j_bool(wf_key));j_set(report,"write_backpressure",j_bool(1));j_set(report,"hangup",j_bool(1));j_set(report,"invalid",j_bool(1));h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native source wait loaded SDL");h_save(load64(argv+32),j_dump(report));gui_close(window);gui_quit();syscall(3,output,0,0,0,0,0);syscall(11,wf_sources,48,0,0,0,0);syscall(11,scratch,8192,0,0,0,0);syscall(11,wf_event,128,0,0,0,0);return 0;
}
