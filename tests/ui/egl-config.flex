// Test-only EGL metadata, sampled outside measured UI intervals. No context,
// surface, buffer or rendering state is created/changed by this inspection.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn eglc_config_fields(){return j_parse("[[12328,\"config_id\"],[12324,\"red_bits\"],[12323,\"green_bits\"],[12322,\"blue_bits\"],[12321,\"alpha_bits\"],[12325,\"depth_bits\"],[12326,\"stencil_bits\"],[12320,\"buffer_bits\"],[12338,\"sample_buffers\"],[12337,\"samples\"],[12339,\"surface_type\"],[12352,\"renderable_type\"],[12334,\"native_visual_id\"],[12347,\"minimum_swap_interval\"],[12348,\"maximum_swap_interval\"],[12327,\"config_caveat\"]]");}
fn eglc_surface_fields(){return j_parse("[[12375,\"surface_width\"],[12374,\"surface_height\"],[12422,\"render_buffer\"],[12435,\"swap_behavior\"],[12328,\"surface_config_id\"]]");}
fn eglc_gl_string(window,key){if gui__native{return gr_gl(load64(gui__record(window)+8),46,key,0,0,0,0,0);}let get=gui__call("SDL_GL_GetProcAddress","glGetString",0,0,0,0,0);if !get{return "";}let value=ffi_call(get,key,0,0,0,0,0);if !value{return "";}return value;}
fn eglc_text(value){if !value{return "";}return h_slice(value,h_len(value));}
fn eglc_snapshot(window){
    let lib=ffi_open("libEGL.so.1");h_assert(lib,"EGL metadata runtime unavailable");let scratch=alloc(64);h_assert(scratch>0,"Cannot allocate EGL metadata scratch");bytes_fill(scratch,0,64);let prior=ffi_call(ffi_symbol(lib,"eglGetError"),0,0,0,0,0,0);let display=ffi_call(ffi_symbol(lib,"eglGetCurrentDisplay"),0,0,0,0,0,0);let context=ffi_call(ffi_symbol(lib,"eglGetCurrentContext"),0,0,0,0,0,0);let surface=ffi_call(ffi_symbol(lib,"eglGetCurrentSurface"),0x3059,0,0,0,0,0);h_assert(display && context && surface,"EGL metadata requires a current draw context/surface");
    h_assert(ffi_call_i32(ffi_symbol(lib,"eglQueryContext"),display,context,0x3028,scratch,0,0),"Cannot query EGL context config ID");bytes_store32(scratch+8,0x3028);bytes_store32(scratch+12,bytes_load32(scratch));bytes_store32(scratch+16,0x3038);h_assert(ffi_call_i32(ffi_symbol(lib,"eglChooseConfig"),display,scratch+8,scratch+32,1,scratch+40,0) && bytes_load32(scratch+40)==1 && load64(scratch+32),"Cannot find the current EGL config by ID");let config=load64(scratch+32);let row=j_object();let fields=eglc_config_fields();let i=0;
    while i<j_count(fields){let pair=j_at(fields,i);h_assert(ffi_call_i32(ffi_symbol(lib,"eglGetConfigAttrib"),display,config,j_value(j_at(pair,0)),scratch,0,0),"Cannot query EGL config attribute");j_set(row,j_value(j_at(pair,1)),j_int(bytes_load32(scratch)));i=i+1;}
    fields=eglc_surface_fields();i=0;while i<j_count(fields){let pair=j_at(fields,i);h_assert(ffi_call_i32(ffi_symbol(lib,"eglQuerySurface"),display,surface,j_value(j_at(pair,0)),scratch,0,0),"Cannot query EGL draw surface attribute");j_set(row,j_value(j_at(pair,1)),j_int(bytes_load32(scratch)));i=i+1;}
    h_assert(ffi_call_i32(ffi_symbol(lib,"eglQueryContext"),display,context,0x3097,scratch,0,0),"Cannot query EGL client API");j_set(row,"client_api",j_int(bytes_load32(scratch)));j_set(row,"prior_egl_error",j_int(prior));j_set(row,"egl_vendor",j_string(eglc_text(ffi_call(ffi_symbol(lib,"eglQueryString"),display,0x3053,0,0,0,0))));j_set(row,"egl_version",j_string(eglc_text(ffi_call(ffi_symbol(lib,"eglQueryString"),display,0x3054,0,0,0,0))));j_set(row,"gl_vendor",j_string(eglc_text(eglc_gl_string(window,0x1f00))));j_set(row,"gl_renderer",j_string(eglc_text(eglc_gl_string(window,0x1f01))));j_set(row,"gl_version",j_string(eglc_text(eglc_gl_string(window,0x1f02))));j_set(row,"glsl_version",j_string(eglc_text(eglc_gl_string(window,0x8b8c))));
    if gui__native{let g=load64(gui__record(window)+8);h_assert(load64(g+32)==context,"EGL metadata is not inspecting the window's owned context");}
    h_assert(ffi_call(ffi_symbol(lib,"eglGetCurrentDisplay"),0,0,0,0,0,0)==display && ffi_call(ffi_symbol(lib,"eglGetCurrentContext"),0,0,0,0,0,0)==context && ffi_call(ffi_symbol(lib,"eglGetCurrentSurface"),0x3059,0,0,0,0,0)==surface,"EGL metadata changed current ownership");let error=ffi_call(ffi_symbol(lib,"eglGetError"),0,0,0,0,0,0);j_set(row,"egl_error_after",j_int(error));h_assert(error==0x3000,"EGL metadata inspection caused an error");syscall(11,scratch,64,0,0,0,0);ffi_close(lib);return row;
}
