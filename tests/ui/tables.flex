import "../../libs/ui/desktop.flex";
import "../../libs/ui/markdown-tables.flex";
global table_fixture=0;global table_event=0;global table_id=0;
fn table_inject(kind,a,b,c,d){h_assert(ffi_call_i32(ffi_symbol(table_fixture,"gui_fixture_event"),kind,table_id,a,b,c,d)>0,"Table input event");h_assert(gui_poll(table_event),"Table input poll");return ui_desktop_event(table_event);}
fn table_packet(markdown){let packet=j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"page\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"page\",\"kind\":\"column\",\"props\":{\"height\":-1,\"padding\":20},\"children\":[{\"key\":\"body\",\"kind\":\"text\",\"text\":\"\",\"props\":{\"selectable\":1,\"size\":16,\"line_height\":5,\"color\":\"#edf2ed\"},\"children\":[]}]}}]}");let desc=j_at(j_get(j_get(j_at(j_get(packet,"ops"),0),"node"),"children"),0);j_set(desc,"text",j_string(markdown));j_set(j_get(desc,"props"),"runs",j_string(rt_markdown_tables(markdown)));return packet;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"Table tests require SDL fixture library");table_fixture=ffi_open(load64(argv+8));h_assert(table_fixture,"Table fixture");h_assert(ui_desktop_open("Headless Markdown tables",800,600,GUI_HIDDEN),gui_error);table_event=gui_event();table_id=load64(gui__record(ud_window)+32);gui__poll_fn=ffi_symbol(table_fixture,"gui_fixture_poll");
    let markdown="A **formatted** introduction.\n\n| No. | President | Years in office |\n| ---: | :--- | :---: |\n| 1 | George Washington | 1789–1797 |\n| 2 | John Adams | 1797–1801 |\n| 3 | A deliberately long name that wraps inside its column without overlapping any other cell | 1801–1809 |\n| 4 | [Game file](tetris.html) and `a\\|b` | 中文 |\n| 5 |\n\nAfter the table.";
    ui_desktop_apply(table_packet(markdown));ui_desktop_draw();let node=ud_need("body");let layout=ud_text_layout(node,760,ud_content(node));let cells=j_get(layout,"cells");h_assert(cells && j_count(cells)==18,"header and five body rows form a three-column table");h_assert(load64(node+176),"table background texture exists separately from glyph coverage");
    let i=0;while i<18{let cell=j_at(cells,i);let first=j_at(cells,i%3);h_assert(j_n(cell,"x")==j_n(first,"x") && j_n(cell,"w")==j_n(first,"w"),"table columns align across all rows");if i%3{h_assert(j_n(cell,"y")==j_n(j_at(cells,i-1),"y") && j_n(cell,"h")==j_n(j_at(cells,i-1),"h"),"wrapped cells share their row height");}i=i+1;}
    h_assert(j_n(j_at(cells,9),"h")>j_n(j_at(cells,3),"h"),"long cells wrap and enlarge the full row");h_assert(h_find(ud_content(node),"No.\tPresident\tYears in office\n")>=0,"copy text uses tab-separated cells");h_assert(h_find(ud_content(node),"a|b")>=0,"escaped pipes remain inside inline code cells");
    ui_desktop_focus("body");let origin=ud_text_origin(node);let ox=load64(origin);let oy=load64(origin+8);let short_cell=j_at(cells,9);let sx=ox+j_n(short_cell,"x")+j_n(short_cell,"w")/2;let sy=oy+j_n(short_cell,"y")+j_n(short_cell,"h")-5;let offset=ud_caret_at(node,sx,sy);
    h_assert(offset>=j_n(short_cell,"start") && offset<=j_n(short_cell,"end"),"blank space below a short cell stays in that cell when its neighbor wraps");
    table_inject(1025,1,ox+12,oy+j_n(j_at(cells,0),"y")+12,0);table_inject(1024,ox+700,oy+j_n(j_at(cells,14),"y")+12,20,20);h_assert(!table_inject(1026,1,ox+700,oy+j_n(j_at(cells,14),"y")+12,0),"drag selection across table cells does not activate links");
    table_inject(768,4,0,0x40,0);table_inject(768,6,0,0x40,0);let copied=gui_clipboard_read();h_assert(h_equal(copied,ud_content(node)),"native table selection copies visible cells and surrounding paragraphs");gui_clipboard_release(copied);
    layout=ud_edit_layout(node);let pieces=j_get(layout,"pieces");let link=0;i=0;while i<j_count(pieces){let p=j_at(pieces,i);if h_equal(ud_string(p,"href"),"tetris.html"){link=p;}i=i+1;}h_assert(link,"table link is retained");origin=ud_text_origin(node);sx=load64(origin)+j_n(link,"x")+3;sy=load64(origin+8)+j_n(link,"y")+j_n(layout,"line")/2;table_inject(1025,1,sx,sy,0);let clicked=table_inject(1026,1,sx,sy,0);h_assert(clicked && h_equal(j_s(clicked,"type"),"link") && h_equal(j_s(clicked,"value"),"tetris.html"),"native link inside a table opens its bound destination");
    let pixels=alloc(800*600*4);h_assert(gui_read_pixels(ud_window,pixels,800*4,800*600*4),gui_error);h_save_bytes("build/ui-tables.rgba",pixels,800*600*4,420);
    gui_resize(ud_window,480,600);ui_desktop_draw();layout=ud_text_layout(node,440,ud_content(node));cells=j_get(layout,"cells");h_assert(j_n(j_at(cells,2),"x")+j_n(j_at(cells,2),"w")==440,"narrow table columns fit available width");
    let long_table=h_buffer();h_text(long_table,"| No. | Name | Term |\n| ---: | :--- | :---: |\n");i=1;while i<=47{h_text(long_table,h_cat3("| ",h_int(i),h_cat3(" | Person ",h_int(i)," | A term |\n")));i=i+1;}
    let patch=j_parse("{\"version\":1,\"ops\":[{\"op\":\"attribute\",\"key\":\"body\",\"name\":\"runs\",\"value\":\"\"}]}");j_set(j_at(j_get(patch,"ops"),0),"value",j_string(rt_markdown_tables(h_data(long_table))));let identity=load64(node+192);ui_desktop_apply(patch);ui_desktop_draw();layout=ud_text_layout(node,440,ud_content(node));cells=j_get(layout,"cells");h_assert(j_count(cells)==144 && j_n(j_at(cells,143),"row")==47,"all 47 rows are laid out without truncating the message");h_assert(load64(node+192)==identity,"streamed tables preserve text widget identity");
    ud_set_scale(2000);ud_text_texture(node,440);layout=ud_text_layout(node,440,ud_content(node));cells=j_get(layout,"cells");h_assert(j_n(j_at(cells,2),"x")+j_n(j_at(cells,2),"w")==880,"HiDPI table geometry uses device pixels");ud_set_scale(1000);ui_desktop_draw();
    j_set(j_at(j_get(patch,"ops"),0),"value",j_string(rt_markdown_tables("| Partial | header |")));ui_desktop_apply(patch);ui_desktop_draw();h_assert(!load64(node+176),"incomplete streamed table falls back to text and releases its background");
    let excessive=h_buffer();i=0;while i<80{h_text(excessive,"cell|");i=i+1;}h_assert(j_count(rt_table_cells(h_data(excessive)))==17,"excessive columns stop parsing before allocating an unbounded cell array");
    ui_desktop_close();gui_quit();h_print(1,"PASS table geometry, wrapping, alignment, escaped pipes, native selection/copy/link activation and resize\n");return 0;
}
