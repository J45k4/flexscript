// Real IME integration. Drive Pinyin externally on an isolated compositor.
import "../../libs/ui/desktop.flex";
fn im_capture(path){let width=gui_pixel_width(ud_window);let height=gui_pixel_height(ud_window);let bytes=width*height*4;let pixels=alloc(bytes);h_assert(gui_read_pixels(ud_window,pixels,width*4,bytes),gui_error);h_save_bytes(path,pixels,bytes,420);syscall(11,pixels,bytes,0,0,0,0);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"Provide artifact prefix");let prefix=load64(argv+8);h_assert(gui_backend_select("wayland"),gui_error);h_assert(ui_desktop_open("Native Chinese IME fixture",800,600,GUI_RESIZABLE),gui_error);
    ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"page\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"page\",\"kind\":\"column\",\"props\":{\"padding\":40,\"gap\":20},\"children\":[{\"key\":\"label\",\"kind\":\"text\",\"text\":\"Native Chinese input — Pinyin composition\",\"props\":{\"size\":24,\"color\":\"#edf2ed\"},\"children\":[]},{\"key\":\"field\",\"kind\":\"input\",\"text\":\"Type with the input method…\",\"props\":{\"value\":\"\",\"width\":500,\"height\":100,\"size\":24,\"color\":\"#edf2ed\",\"background\":\"#26332b\",\"padding\":16,\"ime\":\"send\"},\"children\":[]}]}}]}"));ui_desktop_focus("field");ui_desktop_draw();ui_desktop_present();h_save(h_cat(prefix,"ready"),"ready");
    let e=gui_event();let rows=j_array();let preedit=0;let until=gui_ticks()+30000;let finished=0;
    while gui_ticks()<until && !finished{
        while gui_poll(e){let kind=gui_event_kind(e);let p=0;if kind==GUI_IME{p=gui_ime_data(gui_event_code(e));let row=j_object();j_set(row,"commit",j_string(h_slice(load64(p+96),load64(p+64))));j_set(row,"preedit",j_string(h_slice(load64(p+104),load64(p+72))));j_set(row,"serial",j_int(load64(p+16)));j_set(row,"matching",j_int(load64(p+24)));j_push(rows,row);}
            ui_desktop_event(e);if ud_ime_node{h_assert(h_equal(ui_desktop_value("field"),""),"Preedit was stored as committed text");preedit=1;}
            if kind==GUI_CLOSE{h_die(wl_error);}
            if ud_dirty{ui_desktop_draw();if ud_ime_node{im_capture(h_cat(prefix,"preedit.rgba"));}ui_desktop_present();}
            if h_equal(ui_desktop_value("field"),"你好"){finished=1;}
        }if !finished{gui_wait(20);}
    }
    let c=load64(gui__record(ud_window));let p=load64(load64(c+192)+256);let report=j_object();j_set(report,"value",j_string(h_slice(ui_desktop_value("field"),h_len(ui_desktop_value("field")))));j_set(report,"saw_preedit",j_bool(preedit));j_set(report,"transactions",rows);j_set(report,"width",j_int(gui_pixel_width(ud_window)));j_set(report,"height",j_int(gui_pixel_height(ud_window)));j_set(report,"scale",j_int(gui_scale(ud_window)));j_set(report,"logical_width",j_int(gui_width(ud_window)));j_set(report,"logical_height",j_int(gui_height(ud_window)));j_set(report,"caret_x",j_int(load64(p+136)));j_set(report,"caret_y",j_int(load64(p+144)));j_set(report,"caret_height",j_int(load64(p+160)));j_set(report,"manager",j_bool(load64(p)!=0));let maps=h_read("/proc/self/maps");j_set(report,"sdl_loaded",j_bool(h_find(maps,"libSDL2")>=0));j_set(report,"gl_error",j_int(gr_gl(load64(gui__record(ud_window)+8),48,0,0,0,0,0,0)));im_capture(h_cat(prefix,"commit.rgba"));let output=j_dump(report);h_save(h_cat(prefix,"report.json"),output);h_assert(finished && preedit,"Real Chinese IME composition/commit was incomplete");h_assert(h_find(maps,"libSDL2")<0,"Native IME loaded SDL");ui_desktop_close();gui_quit();syscall(11,e,128,0,0,0,0);h_print(1,h_cat(output,"\n"));return 0;
}
