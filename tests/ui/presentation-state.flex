// Pure protocol state/decode/ownership checks; no compositor or GPU evidence.
import "../../libs/gui/backends/wayland/client.flex";
import "../../scripts/lib/json.flex";
fn ps_check(value,text){h_assert(value,text);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);ps_check(wpd_timestamp(0,0,0)==0 && wpd_timestamp(1,1,123)==4294967297000000123,"Presentation seconds lost their high word");ps_check(wpd_timestamp(2,633437444,854775807)==0x7fffffffffffffff,"Maximum signed nanosecond timestamp differs");ps_check(wpd_timestamp(2,633437444,854775808)== -1 && wpd_timestamp(3,0,0)== -1 && wpd_timestamp(0,0,1000000000)== -1 && wpd_timestamp(0,0,-1)== -1,"Invalid/overflowing timestamp was accepted");
    let c=alloc(512);bytes_fill(c,0,512);let life=alloc(256);bytes_fill(life,0,256);store64(c+456,life);store64(life,1);store64(c+104,1);let p=wpd_context();store64(c+464,p);ps_check(!wpd_enable(c,1) && !load64(p+128),"Missing protocol allocated telemetry");store64(p,1);store64(p+16,1);store64(p+24,1);ps_check(wpd_enable(c,1) && load64(p+128) && wpd_clock(p)>0,"Monotonic presentation clock/storage failed");ps_check(!wpd_arm(c,0),"Zero tag was accepted");let i=0;
    while i<64{ps_check(wpd_arm(c,i+1),"Pending telemetry slot missing");let slot=load64(p+40);ps_check(load64(slot+8)==i+1 && load64(slot+120)==1 && !wpd_arm(c,999),"Armed tag was silently replaced");store64(p+40,0);i=i+1;}ps_check(load64(p+56)==64 && !wpd_arm(c,65),"Pending limit was exceeded");wpd_cancel(c);ps_check(!load64(p+56) && load64(p+88)==64 && load64(p+72)==64,"Cancellation lost ownership or records");let out=alloc(128);i=0;while i<64{ps_check(wpd_poll(c,out) && load64(out)==i+1 && load64(out+8)==3 && load64(out+16)==1 && load64(out+24)>0,"Cancellation result/tag/clock differs");i=i+1;}ps_check(!wpd_poll(c,out),"Queue did not drain");
    ps_check(!wpd_arm_time(c,66,-2) && !wpd_arm_time(c,66,0x7fffffffffffffff) && !load64(p+40) && !load64(p+56),"Invalid arrival timestamp allocated a pending tag");let origin=wpd_clock(p)-1000000;ps_check(wpd_arm_time(c,66,origin) && load64(load64(p+40)+16)==origin,"Explicit arrival timestamp was replaced with dispatch time");wpd_cancel(c);ps_check(wpd_poll(c,out) && load64(out)==66 && load64(out+24)==origin,"Explicit arrival timestamp did not survive cancellation");
    i=0;while i<257{ps_check(wpd_arm(c,1000+i),"Completed slot was not reusable");let slot=load64(p+40);store64(p+40,0);store64(slot+24,123);store64(slot+40,55);wpd_emit(p,slot,1,456,16666667,0x123456789abcdef,7);i=i+1;}ps_check(load64(p+72)-load64(p+64)==256 && load64(p+80)==1 && !load64(p+56),"Completed queue grew or leaked on overflow");i=0;while i<256{ps_check(wpd_poll(c,out) && load64(out)==1000+i && load64(out+8)==1 && load64(out+32)==123 && load64(out+40)==456 && load64(out+48)==16666667 && load64(out+56)==0x123456789abcdef && load64(out+64)==7 && load64(out+72)==55 && load64(out+80)>0,"Wrapped presentation record was corrupted");let at=88;while at<128{ps_check(!load8(out+at),"Presentation reserved bytes were not zeroed");at=at+1;}i=i+1;}ps_check(!wpd_poll(c,out) && !wpd_poll(c,0),"Empty/null output poll differs");
    store64(life,0);ps_check(!wpd_arm(c,2000),"Hidden window armed presentation");store64(life,1);store64(c+112,1);ps_check(!wpd_arm(c,2000),"Disconnected window armed presentation");store64(c+112,0);store64(p+16,1234567);ps_check(wpd_clock(p)== -1 && !wpd_arm(c,2000),"Unavailable presentation clock was accepted");store64(p+16,1);ps_check(wpd_arm(c,2000) && wpd_enable(c,0) && !load64(p+32) && !load64(p+40) && !load64(p+56) && wpd_poll(c,out) && load64(out+8)==3,"Disabling did not cancel an armed tag");wpd_close(c);ps_check(!load64(c+464),"Presentation context survived close");syscall(11,life,256,0,0,0,0);syscall(11,c,512,0,0,0,0);syscall(11,out,128,0,0,0,0);h_print(1,"PASS presentation clock decode, high-word/overflow bounds, 64 pending/256 completed limits, tags, cancellation, queue wrap/loss and owned cleanup\n");return 0;
}
