import "egl-config.flex";
fn eglcd_paint(window){gui_canvas_unclip(window);gui_canvas_size(window,0,0);gui_clear(window,0x142330);gui_canvas_rgba(window,20,20,150,90,0xffc5e3ae);gui_canvas_rgba(window,35,35,100,60,0x806030c0);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"oracle.so report.json");let window=gui_open("EGL config fixture",640,420,GUI_RESIZABLE|GUI_HIGH_DPI);h_assert(window && gui_canvas_open(window,0),gui_error);let event=gui_event();let warm=0;while warm<3{eglcd_paint(window);h_assert(gui_present(window),gui_error);let until=gui_ticks()+40;while gui_ticks()<until{while gui_poll(event){}gui_wait(1);}warm=warm+1;}eglcd_paint(window);let width=gui_pixel_width(window);let height=gui_pixel_height(window);let bytes=width*height*4;let before=alloc(bytes);let after=alloc(bytes);h_assert(gui_read_pixels(window,before,width*4,bytes),gui_error);let row=eglc_snapshot(window);let oracle_lib=ffi_open(load64(argv+8));let oracle=ffi_symbol(oracle_lib,"oracle_egl_config");h_assert(oracle_lib && oracle,"Missing independent EGL oracle");let expected=alloc(22*8);h_assert(ffi_call_i32(oracle,expected,0,0,0,0,0),"Independent EGL config enumeration failed");let fields=eglc_config_fields();let i=0;let n=0;while i<j_count(fields){let key=j_value(j_at(j_at(fields,i),1));h_assert(j_n(row,key)==load64(expected+n*8),h_cat("EGL config oracle mismatch: ",key));i=i+1;n=n+1;}fields=eglc_surface_fields();i=0;while i<j_count(fields){let key=j_value(j_at(j_at(fields,i),1));h_assert(j_n(row,key)==load64(expected+n*8),h_cat("EGL surface oracle mismatch: ",key));i=i+1;n=n+1;}h_assert(n==21 && j_n(row,"client_api")==load64(expected+21*8),"EGL context API oracle mismatch");h_assert(gui_read_pixels(window,after,width*4,bytes) && bytes_common_prefix(before,after,bytes)==bytes,"EGL metadata inspection changed rendered pixels");eglcd_paint(window);h_assert(gui_read_pixels(window,after,width*4,bytes) && bytes_common_prefix(before,after,bytes)==bytes,"EGL metadata inspection changed retained GL state");if gui__native{h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native EGL oracle loaded SDL");}j_set(row,"backend",j_string(gui_backend_name()));j_set(row,"independent_oracle",j_bool(1));j_set(row,"identical_pixels",j_bool(1));j_set(row,"gui_pixel_width",j_int(width));j_set(row,"gui_pixel_height",j_int(height));h_save(load64(argv+16),j_dump(row));h_print(1,h_cat(j_dump(row),"\n"));ffi_close(oracle_lib);gui_close(window);gui_quit();syscall(11,event,128,0,0,0,0);syscall(11,before,bytes,0,0,0,0);syscall(11,after,bytes,0,0,0,0);syscall(11,expected,22*8,0,0,0,0);return 0;
}
