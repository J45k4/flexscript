// GPU pixel/state proof for retained bindings and redundant scissor batching.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn rs_boundary(g,reference){if reference{h_assert(gr_flush(g),gr_error);}return 0;}
fn rs_scene(g,target,reference){
    h_assert(gr_target(g,target) && gr_clear(g,0xff102030) && gr_size(g,96,64),gr_error);rs_boundary(g,reference);
    gr_clip(g,4,3,44,30);gr_fill(g,-2,-2,50,40,0xffc5e3ae);rs_boundary(g,reference);
    let before=load64(g+240);let queued=load64(g+208);gr_clip(g,4,3,44,30);gr_size(g,96,64);if !reference{h_assert(queued && load64(g+208)==queued && load64(g+240)==before,"Unchanged scissor/viewport split the pending batch");}
    gr_fill(g,10,8,10,10,0x806030c0);rs_boundary(g,reference);
    gr_clip(g,16,7,28,25);gr_fill(g,12,0,50,50,0x804090e0);rs_boundary(g,reference);
    gr_unclip(g);gr_fill(g,0,55,96,9,0xffe05040);rs_boundary(g,reference);gr_unclip(g);gr_size(g,96,64);gr_fill(g,1,1,2,2,0xffffd060);rs_boundary(g,reference);
    let pixels=alloc(16);bytes_store32(pixels,0xff0000ff);bytes_store32(pixels+4,0xff00ff00);bytes_store32(pixels+8,0xffff0000);bytes_store32(pixels+12,0xffffffff);let image=gr_texture(g,2,2,pixels,0,1);h_assert(image,gr_error);gr_texture_draw(g,image,48,8,32,32);rs_boundary(g,reference);
    bytes_store32(pixels,0xff00ffff);bytes_store32(pixels+4,0xffff00ff);bytes_store32(pixels+8,0xffffff00);h_assert(gr_texture_patch(g,image,0,0,2,2,pixels),gr_error);gr_texture_draw(g,image,82,8,12,32);rs_boundary(g,reference);
    let previous=load64(g+104);let pending=load64(g+208);h_assert(!gr_target(g,image) && load64(g+104)==previous && load64(g+208)==pending,"Rejected target changed framebuffer ownership or flushed its draws");
    let small=gr_texture(g,24,16,0,1,2);h_assert(small && gr_target(g,small) && gr_clear(g,0),gr_error);gr_fill(g,0,0,24,5,0xff7090e0);rs_boundary(g,reference);gr_fill(g,0,11,24,5,0xff60c080);rs_boundary(g,reference);
    h_assert(gr_target(g,target) && gr_size(g,96,64),gr_error);gr_texture_draw(g,small,52,42,24,12);rs_boundary(g,reference);gr_texture_free(small);gr_texture_free(image);gr_fill(g,92,60,4,4,0xffc5e3ae);rs_boundary(g,reference);syscall(11,pixels,16,0,0,0,0);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"oracle.so report.json");h_assert(gui_backend_select("wayland"),gui_error);let window=gui_open("Renderer state fixture",320,240,GUI_HIDDEN|GUI_HIGH_DPI);h_assert(window && gui_canvas_open(window,0),gui_error);let g=load64(gui__record(window)+8);let target=gr_texture(g,192,128,0,1,2);h_assert(target,gr_error);let bytes=192*128*4;let cached=alloc(bytes);let reference=alloc(bytes);let first=load64(g+240);rs_scene(g,target,0);h_assert(gr_read(g,cached,192*4,bytes),gr_error);let cached_draws=load64(g+240)-first;first=load64(g+240);rs_scene(g,target,1);h_assert(gr_read(g,reference,192*4,bytes),gr_error);let reference_draws=load64(g+240)-first;h_assert(bytes_common_prefix(cached,reference,bytes)==bytes && cached_draws<reference_draws,"Cached renderer pixels differ from fully flushed reference, or batching did not improve");
    let point=cached+(3*192+3)*4;h_assert(load8(point)==255 && load8(point+1)==208 && load8(point+2)==96,"Custom viewport or unclipped drawing position differs");let lib=ffi_open(load64(argv+8));let check=ffi_symbol(lib,"oracle_renderer_state");h_assert(lib && check,"Missing independent GL state oracle");let expected=alloc(24);bytes_store32(expected,load64(g+80));bytes_store32(expected+4,load64(g+88));bytes_store32(expected+8,load64(g+96));bytes_store32(expected+12,load64(target+40));bytes_store32(expected+16,96);bytes_store32(expected+20,64);h_assert(ffi_call(check,expected,0,0,0,0,0),"Actual program/VAO/VBO/texture unit/FBO/viewport differs from owned state");let row=j_object();j_set(row,"cached_draws",j_int(cached_draws));j_set(row,"reference_draws",j_int(reference_draws));j_set(row,"byte_identical",j_bool(1));j_set(row,"independent_driver_state",j_bool(1));j_set(row,"gl_error",j_int(gr_gl(g,48,0,0,0,0,0,0)));h_save(load64(argv+16),j_dump(row));gr_texture_free(target);gui_close(window);gui_quit();ffi_close(lib);syscall(11,cached,bytes,0,0,0,0);syscall(11,reference,bytes,0,0,0,0);syscall(11,expected,24,0,0,0,0);h_print(1,"PASS renderer bindings, viewport/scissor batching, target/upload/delete ordering and byte-identical pixels\n");return 0;
}
