// Real SDL canvas + private Wayland telemetry. C is an independent test oracle.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
global sf_event=0;global sf_stage=0;
fn sf_input(name){h_save(sf_stage,name);let got=0;let until=gui_ticks()+4000;while !got && gui_ticks()<until{while gui_poll(sf_event){h_assert(gui_event_kind(sf_event)!=GUI_CLOSE,"SDL observer window closed");if gui_event_kind(sf_event)==GUI_KEY_DOWN && gui_event_code(sf_event)==GUI_KEY_ESCAPE{got=1;}}if !got{gui_wait(500);}}h_assert(got,"Compositor keyboard input did not reach SDL");return 0;}
fn sf_ready(window){let until=gui_ticks()+4000;while !gui_frame_ready(window) && gui_ticks()<until{while gui_poll(sf_event){}if !gui_frame_ready(window){gui_wait(500);}}h_assert(gui_frame_ready(window),"SDL observer frame did not complete");return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==4,"oracle.so stage-file report.json");sf_stage=load64(argv+16);h_assert(gui_backend_select("sdl2"),gui_error);let window=gui_open("SDL presentation observer",640,420,GUI_RESIZABLE|GUI_HIGH_DPI);h_assert(window && gui_canvas_open(window,0),gui_error);h_assert(wl_equal(gui_video_driver(),"wayland"),"SDL test requires its Wayland backend");let renderer=gui_renderer_info(window);h_assert(renderer && (bytes_load32(renderer+8)&2),"SDL observer requires accelerated rendering");let renderer_name=h_slice(load64(renderer),h_len(load64(renderer)));gui_clear(window,0x24382d);gui_present(window);
    let oracle=ffi_open(load64(argv+8));h_assert(oracle,"Cannot load SDL/Wayland oracle");let fields=ffi_symbol(oracle,"observer_fields");let push=ffi_symbol(oracle,"observer_push");let native=alloc(24);let out=alloc(128);let clock=alloc(16);let stats=alloc(48);sf_event=gui_event();h_assert(gui_presentation_enable(window,1),"Cannot enable SDL Wayland feedback");let record=gui__record(window);let c=load64(record+696);let p=load64(c+464);h_assert(c && ffi_call(fields,load64(record),native,0,0,0,0) && load64(native)==load64(c+8) && load64(native+8)==load64(c+48),"Borrowed display/surface differs from the independent C oracle");let display_fd=load64(native+16);let registry_id=wl_call(c,"wl_proxy_get_id",load64(c+16),0,0,0,0,0);let manager_id=wl_call(c,"wl_proxy_get_id",load64(p),0,0,0,0,0);let surface_id=wl_call(c,"wl_proxy_get_id",load64(c+48),0,0,0,0,0);h_assert(gui_presentation_clock(window,clock),"SDL observer clock is unavailable");let clock_id=load64(clock);
    let other=gui_open("Uninstrumented auxiliary SDL window",80,80,GUI_HIDDEN);h_assert(other && !gui_presentation_enable(other,1) && load64(record+696)==c,"Second window took over the SDL observer");gui_close(other);sf_input("input-before");
    let rows=j_array();let submitted=0;let received=0;let presented=0;let seen=alloc(32);bytes_fill(seen,0,32);let until=gui_ticks()+8000;
    while (received<24 || submitted<24 || !gui_frame_ready(window)) && gui_ticks()<until{
        while gui_poll(sf_event){}
        while gui_presentation_poll(window,out){let tag=load64(out);let status=load64(out+8);h_assert(tag>=1 && tag<=24 && !load8(seen+tag) && (status==1 || status==2),"SDL presentation tag/outcome differs");store8(seen+tag,1);received=received+1;h_assert(load64(out+16)==clock_id && load64(out+32)>=load64(out+24),"SDL submission clock interval differs");let row=j_object();j_set(row,"tag",j_int(tag));j_set(row,"status",j_int(status));j_set(row,"origin_ns",j_int(load64(out+24)));j_set(row,"submit_ns",j_int(load64(out+32)));j_set(row,"presented_ns",j_int(load64(out+40)));j_set(row,"refresh_ns",j_int(load64(out+48)));j_set(row,"sequence",j_int(load64(out+56)));j_set(row,"flags",j_int(load64(out+64)));j_set(row,"output",j_int(load64(out+72)));j_set(row,"received_ns",j_int(load64(out+80)));j_push(rows,row);if status==1{h_assert(load64(out+40)>=load64(out+32) && load64(out+80)>=load64(out+40),"SDL presented/receipt clock interval differs");presented=presented+1;}}
        if submitted<24 && gui_frame_ready(window){h_assert(gui_presentation_track(window,submitted+1),"Cannot arm SDL feedback");let color=0x24382d;if submitted%2{color=0x385244;}gui_clear(window,color);gui_fill(window,30+(submitted*7)%160,35,180,100,0xb4d59c);h_assert(gui_present(window),gui_error);submitted=submitted+1;}
        if received<24 || submitted<24 || !gui_frame_ready(window){gui_wait(500);}
    }
    h_assert(submitted==24 && received==24 && presented>=12 && load64(c+208)==24,"SDL compositor feedback/frame completion is incomplete");h_assert(gui_presentation_stats(window,stats) && !load64(stats) && !load64(stats+8) && !load64(stats+16),"SDL telemetry accounting leaked or overflowed");h_assert(gui_presentation_track(window,1000) && gui_show(window,0) && gui_presentation_poll(window,out) && load64(out)==1000 && load64(out+8)==3 && !gui_frame_ready(window),"SDL hide did not cancel an armed observation");h_assert(gui_show(window,1),gui_error);sf_ready(window);h_assert(gui_presentation_enable(window,0) && gui_frame_ready(window) && !gui_presentation_track(window,1001),"Disabled SDL telemetry kept gating or accepted a tag");gui_close(window);h_assert(gd_context==c && !load64(c+496) && !load64(load64(c+464)+128),"Window close did not release telemetry storage/ownership");
    let i=0;while i<6{window=gui_open("SDL observer reopen",160,120,GUI_HIDDEN);h_assert(window && gui_presentation_enable(window,1) && gd_context==c && wl_call(c,"wl_proxy_get_id",load64(c+16),0,0,0,0,0)==registry_id && wl_call(c,"wl_proxy_get_id",load64(load64(c+464)),0,0,0,0,0)==manager_id,"Reopening allocated another registry or lost manager ownership");gui_close(window);i=i+1;}
    window=gui_open("SDL after observer teardown",640,420,GUI_RESIZABLE);h_assert(window && gui_canvas_open(window,0) && gui_presentation_enable(window,1),gui_error);record=gui__record(window);h_assert(ffi_call(fields,load64(record),native,0,0,0,0) && load64(native+16)==display_fd,"SDL display changed during observer reuse");gd_stop();h_assert(!gd_context && !load64(record+696) && syscall(72,display_fd,1,0,0,0,0)>=0,"Observer teardown closed SDL's borrowed connection");gui_clear(window,0x304d40);h_assert(gui_present(window),gui_error);sf_input("input-after");while gui_poll(sf_event){}h_assert(ffi_call(push,load64(record),0,0,0,0,0)>0 && gui_wait(500),"Queued SDL event did not wake after observer teardown");let found=0;while gui_poll(sf_event){if gui_event_kind(sf_event)==GUI_KEY_DOWN && gui_event_code(sf_event)==63{found=1;}}h_assert(found,"SDL event queue was consumed or damaged by the observer");
    let report=j_object();j_set(report,"backend",j_string("sdl2"));j_set(report,"renderer",j_string(renderer_name));j_set(report,"clock_id",j_int(clock_id));j_set(report,"manager_proxy_id",j_int(manager_id));j_set(report,"surface_proxy_id",j_int(surface_id));j_set(report,"registry_proxy_id",j_int(registry_id));j_set(report,"submitted",j_int(submitted));j_set(report,"presented",j_int(presented));j_set(report,"frame_callbacks",j_int(24));j_set(report,"rows",rows);j_set(report,"reopens",j_int(6));j_set(report,"borrowed_connection_survived",j_bool(1));j_set(report,"real_keyboard_before_after",j_bool(1));j_set(report,"sdl_queue_survived",j_bool(1));h_save(load64(argv+24),j_dump(report));gui_close(window);gui_quit();h_assert(!gd_context && !wp_protocol_memory,"Observer resources survived GUI quit");ffi_close(oracle);syscall(11,native,24,0,0,0,0);syscall(11,out,128,0,0,0,0);syscall(11,clock,16,0,0,0,0);syscall(11,stats,48,0,0,0,0);syscall(11,seen,32,0,0,0,0);syscall(11,sf_event,128,0,0,0,0);h_print(1,"PASS SDL presentation, private queue ownership, compositor input, registry reuse and borrowed connection lifetime\n");return 0;
}
