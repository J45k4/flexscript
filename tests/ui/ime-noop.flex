// No-op IME acknowledgements must preserve async paste and retained editor work.
import "../../libs/ui/desktop.flex";
fn in_emit(e,before,commit,preedit,cancel){h_assert(gui__ime_emit(ud_window,gui__ime_epoch,0,1,before,0,commit,preedit,0,0,cancel),gui_error);h_assert(gui_poll(e) && gui_event_kind(e)==GUI_IME,"Expected owned IME transaction");return ui_desktop_event(e);}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(ui_desktop_open("No-op IME editor",320,180,GUI_HIDDEN),gui_error);let e=gui_event();while gui_poll(e){ui_desktop_event(e);}ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"a\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"a\",\"kind\":\"input\",\"props\":{\"value\":\"base\",\"width\":300,\"height\":100,\"size\":16},\"children\":[]}}]}"));ui_desktop_focus("a");ui_desktop_draw();let a=ud_need("a");
    h_assert(gui_clipboard_copy("中"),gui_error);h_assert(gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"","",0,0,0),gui_error);gui__zero(e,128);store64(e,GUI_KEY_DOWN);store64(e+8,ud_window);store64(e+16,25);store64(e+72,64);ui_desktop_event(e);let pending=ud_paste_token;h_assert(pending,"Paste request was not queued");h_assert(gui_poll(e) && gui_event_kind(e)==GUI_IME,"Empty acknowledgement did not precede clipboard completion");ui_desktop_event(e);h_assert(ud_paste_token==pending,"Empty IME acknowledgement cancelled an unrelated pending paste");h_assert(!ud_dirty,"Empty IME acknowledgement dirtied the editor");let changed=0;while gui_poll(e){let result=ui_desktop_event(e);if result{changed=changed+1;}}h_assert(changed==1 && h_equal(ui_desktop_value("a"),"base中"),"Pending Unicode paste was lost after an empty acknowledgement");
    ui_desktop_draw();let texture=load64(a+160);let layout=ud_edit_data;let local=j_get(load64(a+16),"local_value");ud_caret_epoch=gui_ticks()-750;let epoch=ud_caret_epoch;h_assert(!in_emit(e,0,"","",0),"Empty acknowledgement emitted a change");h_assert(!ud_dirty && load64(a+160)==texture && ud_edit_data==layout && j_get(load64(a+16),"local_value")==local && ud_caret_epoch==epoch,"Empty acknowledgement invalidated text/layout, allocated a draft or reset caret blink");
    in_emit(e,0,"","nihao",0);h_assert(ud_ime_node==a && ud_dirty,"Nonempty preedit was suppressed");ui_desktop_draw();in_emit(e,0,"","",0);h_assert(!ud_ime_node && ud_dirty && h_equal(ui_desktop_value("a"),"base中"),"Empty transaction did not clear existing preedit");ui_desktop_draw();h_assert(in_emit(e,0,"好","",0) && h_equal(ui_desktop_value("a"),"base中好"),"Real Chinese commit was suppressed");h_assert(in_emit(e,3,"","",0) && h_equal(ui_desktop_value("a"),"base中"),"Delete-only transaction was suppressed");in_emit(e,0,"","again",0);in_emit(e,0,"","",1);h_assert(!ud_ime_node && !ud_ime_text,"Explicit cancellation retained preedit");
    ui_desktop_close();gui_quit();syscall(11,e,128,0,0,0,0);h_print(1,"PASS no-op IME: async Unicode paste, retained draft/texture/layout/blink, real preedit/clear/commit/delete/cancel\n");return 0;
}
