// Native editor geometry and keys with real fonts, without opening a window.
import "../../libs/ui/desktop.flex";
fn we_set(node,text,width){ud_edit_release();j_set(load64(node+16),"local_value",j_string(text));store64(node+80,width);store64(node+144,h_len(text));store64(node+152,h_len(text));store64(node+248,0);return 0;}
fn we_close_fonts(){ud_edit_release();let i=0;while i<ud_font_count{gui_font_close(load64(ud_fonts+i*40+24));i=i+1;}syscall(11,ud_fonts,128*40,0,0,0,0);gui_quit();return 0;}
fn main(){
    h_assert(gui_backend_select("wayland"),gui_error);ud_sans="Noto Sans";ud_mono="monospace";ud_scale=1000;ud_fonts=h_zero(alloc(128*40),128*40);let node=h_zero(h_take(256),256);store64(node+8,8);let desc=j_parse("{\"key\":\"field\",\"kind\":\"input\",\"props\":{\"size\":24,\"single_line\":0},\"local_value\":\"\"}");store64(node+16,desc);ud_focus=node;let font=ud_font(node,0,24);
    we_set(node,"co­operate next",gui_text_width_direction(font,"co-",4)+1);let layout=ud_edit_layout(node);let shy=0;let i=0;while i<ud_edit_count{let record=ud_edit_records+i*96;if ud_number(load64(record),"render_map",0)==2{shy=record;}i=i+1;}h_assert(shy && load64(shy+40)==4 && h_equal(j_s(load64(shy),"text"),"co-"),"CPU SHY display/source mapping");ud_edit_prepare(shy);h_assert(ud_edit_prefix(shy,4)>ud_edit_prefix(shy,2),"CPU SHY glyph has no caret advance");store64(node+144,4);store64(node+152,4);store64(node+248,(5<<1)|1);layout=ud_edit_layout(node);h_assert(!j_n(layout,"caret_y") && j_n(layout,"caret_x")==ud_edit_prefix(shy,4),"CPU SHY upstream affinity");h_assert(h_equal(h_slice(ud_content(node),4),"co­"),"CPU SHY copy changed source");store64(node+152,2);ud_key(42,0);h_assert(h_equal(ud_content(node),"cooperate next"),"CPU SHY deletion");
    we_set(node,"word    next",gui_text_width_direction(font,"word",4)+1);layout=ud_edit_layout(node);let hidden=0;i=0;while i<ud_edit_count{let record=ud_edit_records+i*96;if ud_number(load64(record),"render_map",0)==3{hidden=record;}i=i+1;}h_assert(hidden && load64(hidden+32)==4 && load64(hidden+40)==8,"CPU hanging-space source range");i=0;while i<=4{h_assert(!ud_edit_prefix(hidden,i),"CPU hanging-space caret advance");i=i+1;}h_assert(h_equal(ud_content(node),"word    next"),"CPU hanging spaces changed source");
    we_set(node,"אבגדהוזחט יכלמנסעפצ קרשתאבגדה",88);layout=ud_edit_layout(node);let rows=j_get(layout,"lines");h_assert(j_count(rows)>1,"CPU RTL wrap fixture");let byte=j_n(j_at(rows,1),"start");store64(node+144,byte);store64(node+152,byte);store64(node+248,0);ud_key(79,0);layout=ud_edit_layout(node);h_assert(load64(node+144)==byte && !j_n(layout,"caret_y") && (load64(node+248)&1),"CPU RTL right key crossed to wrong line");ud_key(80,0);layout=ud_edit_layout(node);h_assert(load64(node+144)==byte && j_n(layout,"caret_y")>0 && !(load64(node+248)&1),"CPU RTL left key lost downstream affinity");
    we_set(node,"abc\nשלום\nxyz",300);store64(node+144,4);store64(node+152,4);ud_key(79,0);layout=ud_edit_layout(node);h_assert(load64(node+144)==3 && !j_n(layout,"caret_y"),"CPU RTL key did not enter preceding LTR paragraph at its logical end");
    we_set(node,"á 🇫🇮 👨‍👩‍👧‍👦 क्ष",1);layout=ud_edit_layout(node);let lines=j_get(layout,"lines");i=0;while i<j_count(lines){let row=j_at(lines,i);h_assert(ud_edit_is_boundary(j_n(row,"start")) && ud_edit_is_boundary(j_n(row,"end")),"CPU emergency wrap split a grapheme");i=i+1;}
    // Geometry is owned: warmed source/display maps need no further shaping.
    i=0;while i<ud_edit_count{ud_edit_prepare(ud_edit_records+i*96);i=i+1;}let misses=load64(gn_shapes+32);let builds=ud_edit_builds;i=0;while i<1000{let record=ud_edit_records+(i%ud_edit_count)*96;ud_edit_prefix(record,load64(record+40)-load64(record+32));i=i+1;}h_assert(load64(gn_shapes+32)==misses && ud_edit_builds==builds,"CPU warm wrapped editor reshaped or rebuilt");
    j_set(j_get(desc,"props"),"max_lines",j_int(2));we_set(node,"one two three four five six seven eight nine ten",45);layout=ud_edit_layout(node);h_assert(j_n(layout,"h")>j_n(layout,"line")*2,"CPU multiline input discarded scrollable geometry at its visible line cap");ud_edit_release();store64(node+8,7);j_set(desc,"text",j_string("one two three four five six seven eight nine ten"));layout=ud_edit_layout(node);h_assert(j_n(layout,"h")==j_n(layout,"line")*2 && j_count(j_get(layout,"lines"))==2 && h_equal(ud_content(node),"one two three four five six seven eight nine ten"),"CPU line cap changed source or emitted extra visible lines");
    we_close_fonts();h_assert(!ud_edit_graphemes && !ud_edit_blocks,"CPU wrapped geometry leaked after close");h_print(1,"PASS native CPU wrapped editor: soft hyphens, source-preserving spaces/copy/delete, RTL line/paragraph keys, graphemes, warm cache, line cap and cleanup\n");return 0;
}
