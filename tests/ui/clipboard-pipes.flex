// Kernel pipe/lifetime tests without a compositor. The SDL dummy window supplies
// only the generic event owner; transfer code is the native Wayland transport.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn cp_fd_count(){
    let fd=syscall(2,"/proc/self/fd",0x90000,0,0,0,0);h_assert(fd>=0,"Cannot inspect descriptor lifetime");let data=alloc(8192);let count=0;let n=syscall(217,fd,data,8192,0,0,0);while n>0{let at=0;while at<n{let size=load8(data+at+16)|(load8(data+at+17)<<8);h_assert(size>=20 && at+size<=n,"Invalid directory record");count=count+1;at=at+size;}n=syscall(217,fd,data,8192,0,0,0);}syscall(3,fd,0,0,0,0,0);syscall(11,data,8192,0,0,0,0);return count;
}
fn pipe_receive(p,window,event,payload,n,success){
    let fds=alloc(8);h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");let readfd=bytes_load32(fds);let writefd=bytes_load32(fds+4);syscall(11,fds,8,0,0,0,0);
    gui_clipboard_cancel(gui__clipboard_id);gui__clipboard_window=window;let token=gui__clipboard_id;store64(p+64,readfd);store64(p+72,alloc(1048577));store64(p+80,0);store64(p+88,token);store64(p+96,gui_monotonic_ns()+5000000000);
    let at=0;while at<n && load64(p+64)>=0{let count=n-at;if count>4096{count=4096;}let sent=wc_write(p,writefd,payload+at,count);h_assert(sent>0,"Fixture producer stalled");at=at+sent;wc_io(0,p);}syscall(3,writefd,0,0,0,0,0);wc_io(0,p);
    let found=0;while gui_poll(event){if gui_event_kind(event)==GUI_CLIPBOARD && gui_event_code(event)==token{h_assert(gui_event_x(event)==success,"Clipboard completion status differs");found=1;}}
    h_assert(found,"Clipboard completion event missing");let raw=gui_clipboard_take(token);if success{h_assert(raw && gui__clipboard_length(raw)==n && bytes_common_prefix(raw,payload,n)==n,"Clipboard pipe bytes differ");}else{h_assert(!raw,"Invalid clipboard data escaped validation");}gui_clipboard_release(raw);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);let window=gui_open("Clipboard pipe checks",64,64,GUI_HIDDEN);h_assert(window,gui_error);let event=gui_event();let p=wc_context();h_assert(p,"Cannot allocate clipboard transport");let data=alloc(1048578);bytes_fill(data,97,1048578);
    pipe_receive(p,window,event,"Häät 中文 👋",h_len("Häät 中文 👋"),1);pipe_receive(p,window,event,data,1048576,1);pipe_receive(p,window,event,data,1048577,0);store8(data,192);store8(data+1,175);pipe_receive(p,window,event,data,2,0);store8(data,97);store8(data+1,97);pipe_receive(p,window,event,"a\0b",3,0);
    let descriptors=cp_fd_count();let i=0;while i<100{pipe_receive(p,window,event,data,8193,1);i=i+1;}h_assert(cp_fd_count()==descriptors,"Repeated clipboard transfers leaked descriptors");
    let fds=alloc(8);h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");let readfd=bytes_load32(fds);let writefd=bytes_load32(fds+4);syscall(3,readfd,0,0,0,0,0);let mask=alloc(16);syscall(14,0,0,mask,8,0,0);h_assert(wc_write(p,writefd,"x",1)==-32,"Closed clipboard consumer did not return EPIPE");syscall(14,0,0,mask+8,8,0,0);h_assert(load64(mask)==load64(mask+8),"Clipboard write changed the signal mask");syscall(3,writefd,0,0,0,0,0);
    h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");readfd=bytes_load32(fds);writefd=bytes_load32(fds+4);store64(p+64,readfd);store64(p+72,alloc(1048577));wc_cancel(p);h_assert(syscall(72,readfd,1,0,0,0,0)==-9,"Cancelled read descriptor leaked");syscall(3,writefd,0,0,0,0,0);
    h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");readfd=bytes_load32(fds);writefd=bytes_load32(fds+4);gui_clipboard_cancel(gui__clipboard_id);gui__clipboard_window=window;let token=gui__clipboard_id;store64(p+64,readfd);store64(p+72,alloc(1048577));store64(p+88,token);store64(p+96,0);wc_io(0,p);let timed=0;while gui_poll(event){if gui_event_kind(event)==GUI_CLIPBOARD && gui_event_code(event)==token{h_assert(!gui_event_x(event),"Stalled clipboard read did not fail");timed=1;}}h_assert(timed && syscall(72,readfd,1,0,0,0,0)==-9,"Stalled clipboard read did not close");syscall(3,writefd,0,0,0,0,0);
    h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");readfd=bytes_load32(fds);writefd=bytes_load32(fds+4);let source=alloc(48);bytes_fill(source,0,48);store64(source+8,alloc(101));store64(source+16,100);store64(source+24,1);store64(p+56,source);store64(p+128,writefd+1);store64(p+136,source);store64(p+144,0);store64(p+152,0);wc_io(0,p);h_assert(!load64(p+56) && !load64(p+128) && syscall(72,writefd,1,0,0,0,0)==-9,"Expired clipboard writer retained its descriptor or source");syscall(3,readfd,0,0,0,0,0);
    i=0;while i<100{
        h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");readfd=bytes_load32(fds);writefd=bytes_load32(fds+4);gui_clipboard_cancel(gui__clipboard_id);gui__clipboard_window=window;token=gui__clipboard_id;store64(p+64,readfd);store64(p+72,alloc(1048577));store64(p+88,token);store64(p+96,gui_monotonic_ns()+5000000000);
        source=alloc(48);bytes_fill(source,0,48);store64(source+8,alloc(101));store64(source+16,100);store64(source+24,1);store64(p+48,source);store64(p+56,source);store64(p+128,writefd+1);store64(p+136,source);store64(p+144,0);store64(p+152,gui_monotonic_ns()+5000000000);store64(p+720,123);
        let offer=alloc(32);bytes_fill(offer,0,32);store64(p+40,offer);store64(p+32,offer);store64(p+672,offer);wc_detach(0,p);h_assert(!load64(p+48) && !load64(p+56) && !load64(p+128) && !load64(p+32) && !load64(p+40) && !load64(p+672) && !load64(p+720),"Seat detachment retained a transfer/source/offer");h_assert(syscall(72,readfd,1,0,0,0,0)==-9 && syscall(72,writefd,1,0,0,0,0)==-9,"Seat detachment leaked a pipe descriptor");let cancelled=0;while gui_poll(event){if gui_event_kind(event)==GUI_CLIPBOARD && gui_event_code(event)==token{h_assert(!gui_event_x(event),"Seat-detached read succeeded");cancelled=1;}}h_assert(cancelled,"Seat-detached read did not complete with failure");i=i+1;
    }h_assert(cp_fd_count()==descriptors,"Repeated seat detachment leaked descriptors");
    wc_close(0,p);syscall(11,data,1048578,0,0,0,0);syscall(11,fds,8,0,0,0,0);syscall(11,mask,16,0,0,0,0);syscall(11,event,128,0,0,0,0);gui_close(window);gui_quit();h_print(1,"PASS clipboard pipes: Unicode, 1 MiB boundary, overflow/invalid/NUL rejection, repeated reads, cancellation, 100 active seat detachments and SIGPIPE mask preservation\n");return 0;
}
