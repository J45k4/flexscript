// Actual GL timer-query ABI, ownership and pixels. Must run on a private display.
import "gpu-timing.flex";
import "../../scripts/lib/json.flex";
fn gtd_paint(window){gui_canvas_unclip(window);gui_canvas_size(window,0,0);gui_clear(window,0x142330);gui_canvas_rgba(window,20,20,150,90,0xffc5e3ae);gui_canvas_clip(window,30,30,100,60);gui_canvas_rgba(window,10,10,180,120,0x806030c0);gui_canvas_unclip(window);return 0;}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==3,"oracle.so report.json");let w=gui_open("GPU query ownership fixture",320,240,GUI_HIGH_DPI);h_assert(w && gui_canvas_open(w,0),gui_error);let lib=ffi_open(load64(argv+8));let read=ffi_symbol(lib,"oracle_timer_read");let exists=ffi_symbol(lib,"oracle_timer_exists");h_assert(lib && read && exists,"Missing GPU query oracle");
    // First mapping may deliver a fractional output preference. Warm actual
    // presents and dispatch it before comparing two stable framebuffer images.
    let e=gui_event();let warm=0;while warm<3{gtd_paint(w);h_assert(gui_present(w),gui_error);let settle=gui_ticks()+40;while gui_ticks()<settle{while gui_poll(e){}gui_wait(1);}warm=warm+1;}gtd_paint(w);let width=gui_pixel_width(w);let height=gui_pixel_height(w);let bytes=width*height*4;let before=alloc(bytes);let after=alloc(bytes);h_assert(gui_read_pixels(w,before,width*4,bytes),gui_error);let t=gt_open(w,3);h_assert(t && load64(t+96)==64,gui_error);let out=alloc(24);let independent=alloc(16);h_assert(!gt_begin(t,-1) && !gt_begin(t,3) && !gt_end(t,0) && !gt_poll(t,0,out) && !load64(t+112),"Unissued query was read or invalid index accepted");
    let i=0;while i<3{h_assert(gt_begin(t,i) && !gt_begin(t,i),"GPU start was replaced");gtd_paint(w);h_assert(gt_end(t,i) && !gt_end(t,i) && gui_present(w),gui_error);i=i+1;}let rows=j_array();i=0;while i<3{let ready=0;let until=gui_ticks()+5000;while !ready && gui_ticks()<until{ready=gt_poll(t,i,out);h_assert(ready>=0,gui_error);if !ready{while gui_poll(e){}gui_wait(1);}}h_assert(ready==1,"GPU timestamp result did not become available");let start=bytes_load32(t+256+i*8);let end=bytes_load32(t+260+i*8);h_assert(ffi_call(read,start,end,independent,0,0,0) && load64(independent)==load64(out) && load64(independent+8)==load64(out+8),"64-bit GPU timestamps differ from independent C ABI");h_assert(load64(out)>0xffffffff && load64(out+8)>=load64(out) && load64(out+16)==load64(out+8)-load64(out) && !gt_poll(t,i,out),"GPU timestamp precision/order or one-shot result differs");let row=j_object();j_set(row,"start_ns",j_int(load64(out)));j_set(row,"end_ns",j_int(load64(out+8)));j_set(row,"elapsed_ns",j_int(load64(out+16)));j_push(rows,row);i=i+1;}
    h_assert(load64(t+112)==6 && !gt_begin(t,0),"GPU result ownership or reuse differs");gtd_paint(w);h_assert(gui_read_pixels(w,after,width*4,bytes),gui_error);let equal=bytes_common_prefix(before,after,bytes)==bytes;if !equal{let diagnostic=j_object();j_set(diagnostic,"before_width",j_int(width));j_set(diagnostic,"before_height",j_int(height));j_set(diagnostic,"after_width",j_int(gui_pixel_width(w)));j_set(diagnostic,"after_height",j_int(gui_pixel_height(w)));if gui__native{let g=load64(gui__record(w)+8);j_set(diagnostic,"canvas_width",j_int(load64(g+112)));j_set(diagnostic,"canvas_height",j_int(load64(g+120)));j_set(diagnostic,"target_width",j_int(load64(g+144)));j_set(diagnostic,"target_height",j_int(load64(g+152)));}h_save(h_cat(load64(argv+16),".pixels.json"),j_dump(diagnostic));h_save_bytes(h_cat(load64(argv+16),".before.rgba"),before,bytes,420);h_save_bytes(h_cat(load64(argv+16),".after.rgba"),after,bytes,420);}h_assert(equal,"Timer queries changed rendered pixels");let first=bytes_load32(t+256);h_assert(ffi_call(exists,first,0,0,0,0,0),"Owned GPU query disappeared");h_assert(gt_close(t) && !ffi_call(exists,first,0,0,0,0,0),"GPU query survived owned cleanup");
    t=gt_open(w,1);h_assert(t,gui_error);gui_close(w);h_assert(!gt_valid(t) && !gt_close(t),"Closed window retained a valid query context");let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"timer_bits",j_int(64));j_set(report,"rows",rows);j_set(report,"independent_oracle",j_bool(1));j_set(report,"identical_pixels",j_bool(1));j_set(report,"owned_cleanup",j_bool(1));h_save(load64(argv+16),j_dump(report));gui_quit();ffi_close(lib);syscall(11,before,bytes,0,0,0,0);syscall(11,after,bytes,0,0,0,0);syscall(11,out,24,0,0,0,0);syscall(11,independent,16,0,0,0,0);syscall(11,e,128,0,0,0,0);h_print(1,"PASS GPU timestamp high words, independent ABI, availability, pixels, bounds and context/query cleanup\n");return 0;
}
