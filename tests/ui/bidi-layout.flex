// CPU-only retained layout with real native fonts. Never opens a window.
import "../../libs/ui/desktop.flex";
import "../../libs/ui/markdown-tables.flex";
fn bl_tables(){
    let checkpoint=h_mark();let markdown="| RTL | LTR |\n| --- | --- |\n| שלום 123 | abc [אבג](local.txt) |\n";let node=h_zero(h_take(256),256);let desc=j_parse("{\"key\":\"table\",\"kind\":\"text\",\"props\":{\"size\":20},\"text\":\"\"}");store64(node+16,desc);store64(node+8,7);j_set(j_get(desc,"props"),"runs",j_string(rt_markdown_tables(markdown)));let text=ud_content(node);h_assert(h_equal(text,"RTL\tLTR\nשלום 123\tabc אבג\n"),"Bidi table changed logical copy order");
    let width=400;while width>=200{let layout=ud_text_layout_pixels(node,width,text);let cells=j_get(layout,"cells");let pieces=j_get(layout,"pieces");h_assert(cells && j_count(cells)==4,"Bidi table cell layout");let left=j_at(cells,2);let right=j_at(cells,3);let rtl=0;let ltr=0;let links=0;let i=0;while i<j_count(pieces){let p=j_at(pieces,i);let start=j_n(p,"start");if start>=j_n(left,"start") && start<j_n(left,"end"){h_assert(j_n(p,"bidi_base")==1,"Adjacent LTR table cell affected RTL base");rtl=rtl+1;}if start>=j_n(right,"start") && start<j_n(right,"end"){h_assert(j_n(p,"bidi_base")==0,"Adjacent RTL table cell affected LTR base");ltr=ltr+1;}if h_len(ud_string(p,"href")){h_assert(h_equal(ud_string(p,"href"),"local.txt") && ud_run_direction(p)==5,"Bidi table lost link metadata/direction");links=links+1;}h_assert(j_n(p,"x")>=j_n(p,"clip_x") && j_n(p,"x")+j_n(p,"w")<=j_n(p,"clip_x")+j_n(p,"clip_w"),"Bidi table text crossed a cell clip");i=i+1;}h_assert(rtl && ltr && links,"Bidi table omitted mixed text/link runs");store64(node+80,width);let editing=ud_edit_layout(node);h_assert(j_n(editing,"bidi"),"Table dropped visual editing capability");store64(node+144,j_n(left,"start"));store64(node+152,load64(node+144));store64(node+248,0);h_assert(ud_edit_visual(node,-1)==j_n(left,"start")+2,"Visual table movement left the RTL cell at its logical start");ud_edit_release();width=width-200;}
    h_reset(checkpoint);return 0;
}
fn bl_case(text,width,styled){
    let checkpoint=h_mark();let node=h_zero(h_take(256),256);let desc=j_parse("{\"key\":\"text\",\"kind\":\"text\",\"props\":{\"size\":20},\"text\":\"\"}");store64(node+16,desc);store64(node+8,7);j_set(desc,"text",j_string(text));
    if styled{let runs=j_array();let graphemes=unicode_graphemes(text,h_len(text));h_assert(graphemes,unicode_error);let first=0;let i=1;while i<load64(graphemes){let end=load64(graphemes+32+i*8);if i%3==0 || i==load64(graphemes)-1{let run=j_object();j_set(run,"text",j_string(h_slice(text+first,end-first)));j_set(run,"style",j_int((i/3)%2));j_push(runs,run);first=end;}i=i+1;}unicode_graphemes_free(graphemes);j_set(j_get(desc,"props"),"runs",j_string(j_dump(runs)));}
    let layout=ud_text_layout_pixels(node,width,text);h_assert(h_equal(ud_content(node),text),"Native wrapping changed logical copy text");let pieces=j_get(layout,"pieces");let report=j_object();let records=j_array();let display=j_array();let i=0;while i<j_count(pieces){let p=j_at(pieces,i);let row=j_array();j_push(row,j_get(p,"start"));j_push(row,j_get(p,"end"));j_push(row,j_int(ud_number(p,"bidi_level",0)));j_push(row,j_int(ud_number(p,"bidi_visual",i)));j_push(row,j_get(p,"x"));j_push(row,j_get(p,"w"));j_push(row,j_get(p,"line_y"));j_push(row,j_int(ud_run_direction(p)));h_assert(j_n(p,"w")==ud_run_width(p,j_s(p,"text")),"Bidi drawing width differs from layout width");j_push(records,row);let drawn=j_object();j_set(drawn,"text",j_get(p,"text"));j_set(drawn,"mapping",j_int(ud_number(p,"render_map",0)));j_set(drawn,"font",j_get(p,"font"));j_set(drawn,"style",j_get(p,"style"));j_push(display,drawn);i=i+1;}j_set(report,"display",display);let lines=j_get(layout,"lines");if lines{j_set(report,"lines",lines);}j_set(report,"pieces",records);j_set(report,"width",j_get(layout,"w"));j_set(report,"height",j_get(layout,"h"));j_set(report,"line",j_get(layout,"line"));h_print(1,h_cat(j_dump(report),"\n"));h_reset(checkpoint);return 0;
}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==2,"bidi-layout requests.json");h_assert(gui_backend_select("wayland"),gui_error);ud_sans="Noto Sans";ud_mono="monospace";ud_fonts=h_zero(alloc(128*40),128*40);ud_scale=1000;let cases=j_parse(h_read(load64(argv+8)));let i=0;while i<j_count(cases){let request=j_at(cases,i);bl_case(j_s(request,"text"),j_n(request,"width"),j_n(request,"styled"));i=i+1;}bl_tables();i=0;while i<ud_font_count{gui_font_close(load64(ud_fonts+i*40+24));i=i+1;}syscall(11,ud_fonts,128*40,0,0,0,0);gui_quit();return 0;
}
