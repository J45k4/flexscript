// Kernel readiness + deadline decisions. CPU CI; no native display/GPU proof.
import "../../libs/ui/desktop.flex";
import "../../apps/collie/desktop/wait.flex";
fn main(argc,argv){
    h_environment(argc,argv);let window=gui_open("Wait source checks",64,64,GUI_HIDDEN);h_assert(window,gui_error);let e=gui_event();while gui_poll(e){}let fds=alloc(8);h_assert(syscall(293,fds,0x80800,0,0,0,0)==0,"pipe2 failed");let input=bytes_load32(fds);let output=bytes_load32(fds+4);let sources=alloc(16*24);bytes_fill(sources,0,16*24);store64(sources,input);store64(sources+8,GUI_WAIT_READ);h_assert(!gui_wait_sources(0,sources,1) && !load64(sources+16),"Empty pipe reported readable");h_assert(syscall(1,output,"x",1,0,0,0)==1,"Cannot write pipe");h_assert(gui_wait_sources(5000,sources,1) && load64(sources+16)==GUI_WAIT_READ,"Readable source was missed");let scratch=alloc(8192);h_assert(syscall(0,input,scratch,1,0,0,0)==1 && load8(scratch)==120,"Wait consumed caller-owned input");
    store64(sources,output);store64(sources+8,GUI_WAIT_WRITE);h_assert(gui_wait_sources(0,sources,1) && load64(sources+16)==GUI_WAIT_WRITE,"Writable source was missed");bytes_fill(scratch,65,8192);let n=1;while n>0{n=syscall(1,output,scratch,8192,0,0,0);}h_assert(n==-11 && !gui_wait_sources(0,sources,1),"Full pipe remained writable");h_assert(syscall(0,input,scratch,8192,0,0,0)>0 && gui_wait_sources(0,sources,1) && load64(sources+16)==GUI_WAIT_WRITE,"Backpressure recovery was missed");syscall(3,output,0,0,0,0,0);n=1;while n>0{n=syscall(0,input,scratch,8192,0,0,0);}store64(sources,input);store64(sources+8,GUI_WAIT_READ);h_assert(gui_wait_sources(5000,sources,1) && (load64(sources+16)&GUI_WAIT_HUP),"EOF did not wake with hangup");syscall(3,input,0,0,0,0,0);h_assert(gui_wait_sources(0,sources,1) && (load64(sources+16)&GUI_WAIT_INVALID),"Closed descriptor did not report invalid");
    h_assert(!gui_wait_sources(-1,sources,1) && !gui_wait_sources(0,sources,17) && !gui_wait_sources(0,0,1),"Invalid wait bounds accepted");store64(sources+8,0);h_assert(!gui_wait_sources(0,sources,1),"Empty interests accepted");store64(sources+8,4);h_assert(!gui_wait_sources(0,sources,1),"Invalid interests accepted");
    h_assert(gui_frame_ready(window) && !gui_frame_ready(0) && !gui_presentation_enable(window,1) && !gui_presentation_track(window,1) && !gui_presentation_poll(window,sources) && !gui_presentation_clock(window,sources) && !gui_presentation_stats(window,sources),"SDL pacing/unsupported-feedback capability differs");
    let p=gui__wait_context_open();let c=alloc(512);let platform=alloc(80);bytes_fill(c,0,512);let i=0;while i<10{store64(platform+i*8,0xffffffff|(1<<32));i=i+1;}i=0;while i<16{store64(sources+i*24,input);store64(sources+i*24+8,1);i=i+1;}store64(p,sources);store64(p+8,16);store64(p+16,1);bytes_fill(p+272,165,240);store64(c+136,platform);store64(c+144,10);h_assert(gui__wait_join(c) && load64(c+144)==26,"Maximum platform/application join failed");h_assert(syscall(7,p+64,26,0,0,0,0)==16 && gui__wait_results(p,sources,16,10),"Joined source readiness differs");i=0;while i<16{h_assert(load64(sources+i*24+16)==GUI_WAIT_INVALID,"Joined result index is wrong");i=i+1;}i=272;while i<512{h_assert(load8(p+i)==165,"Joined poll set exceeded its allocation");i=i+1;}store64(p+16,0);store64(p,0);store64(p+8,0);
    let node=alloc(256);bytes_fill(node,0,256);store64(node+8,8);let props=j_object();let desc=j_object();j_set(desc,"props",props);store64(node+16,desc);ud_focus=node;ud_dirty=0;ud_caret_epoch=1000;ud_blink=0;h_assert(ud_wait_ms_at(5000,1000)==500 && ud_wait_ms_at(5000,1499)==1 && ud_wait_ms_at(5000,1500)==0,"Caret first deadline differs");ud_blink=1;h_assert(ud_wait_ms_at(5000,1500)==500 && ud_wait_ms_at(30,1501)==30,"Caret deadline drifted or exceeded caller limit");ud_dirty=1;h_assert(ud_wait_ms_at(5000,1501)==0,"Dirty UI did not request immediate work");ud_dirty=0;ud_ime_suspended=1;h_assert(ud_wait_ms_at(2147483647,9999)==2147483647,"Unfocused UI retained a blink timer");ud_ime_suspended=0;ud_ime_node=node;ud_ime_begin=-1;h_assert(ud_wait_ms_at(5000,9999)==5000,"Hidden preedit caret retained a timer");ud_ime_node=0;j_set(desc,"hidden",j_int(1));h_assert(ud_wait_ms_at(5000,9999)==5000,"Hidden editor retained a timer");j_set(desc,"hidden",j_int(0));j_set(props,"enabled",j_string("false"));h_assert(ud_wait_ms_at(5000,9999)==5000,"Disabled editor retained a timer");ud_focus=0;
    h_assert(cd_wait_limit(1100,500,1000,200,1,0,1500,7)==100 && cd_wait_limit(1300,500,1000,200,1,0,0,7)==0,"Replay deadline differs");h_assert(cd_wait_limit(1100,2147483647,-1,200,1,0,0,7)==2147483647 && cd_wait_limit(1100,2147483647,-1,0,0,0,0,-1)==1000,"Idle or child fallback deadline differs");h_assert(cd_wait_limit(1100,500,-1,0,0,1000,200,7)==100,"Run duration deadline differs");let child=alloc(96);bytes_fill(child,0,96);store64(child+32,12);store64(child+40,10);store64(child+48,11);h_assert(cd_wait_set(child,0,1,-1,sources)==2 && load64(sources)==10 && load64(sources+24)==11,"Idle source set differs");h_assert(cd_wait_set(child,1,0,13,sources)==3 && load64(sources+24)==12 && load64(sources+32)==GUI_WAIT_WRITE && load64(sources+48)==13,"Pending writes/child exit source set differs");
    syscall(11,child,96,0,0,0,0);syscall(11,node,256,0,0,0,0);syscall(11,c,512,0,0,0,0);syscall(11,platform,80,0,0,0,0);syscall(11,scratch,8192,0,0,0,0);syscall(11,fds,8,0,0,0,0);syscall(11,sources,16*24,0,0,0,0);syscall(11,e,128,0,0,0,0);gui_close(window);gui_quit();h_assert(!gui__wait_context,"Wait state survived GUI shutdown");h_print(1,"PASS source read/write/backpressure/EOF/invalid flags, bounded 26-FD join, caret/IME/visibility deadlines and Collie replay/child/source decisions\n");return 0;
}
