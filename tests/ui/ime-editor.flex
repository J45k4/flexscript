// Editor transactions and owned lifetime; runs without a compositor in CPU CI.
import "../../libs/ui/desktop.flex";
fn ie_drain(e){let changes=0;while gui_poll(e){if ui_desktop_event(e){changes=changes+1;}}return changes;}
fn ie_emit(e,before,after,commit,preedit,begin,end){h_assert(gui__ime_emit(ud_window,gui__ime_epoch,0,1,before,after,commit,preedit,begin,end,0),gui_error);return ie_drain(e);}
fn main(argc,argv){
    h_environment(argc,argv);h_assert(ui_desktop_open("IME editor checks",640,480,GUI_HIDDEN),gui_error);
    ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"page\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"page\",\"kind\":\"column\",\"props\":{},\"children\":[{\"key\":\"a\",\"kind\":\"input\",\"props\":{\"value\":\"ab中文cd\",\"ime\":\"send\",\"height\":100,\"size\":20},\"children\":[]},{\"key\":\"b\",\"kind\":\"input\",\"props\":{\"value\":\"other\"},\"children\":[]}]}}]}"));
    let e=gui_event();ie_drain(e);ui_desktop_focus("a");let a=ud_need("a");store64(a+144,2);store64(a+152,8);
    h_assert(ie_emit(e,0,0,"","nihao",2,5)==1,"Preedit selection deletion did not emit change");h_assert(h_equal(ui_desktop_value("a"),"abcd") && h_equal(ud_display_content(a),"abnihaocd") && load64(a+144)==2,"Preedit leaked into the draft or lost suffix");
    ui_desktop_draw();h_assert(ud_edit_length==9 && ud_display_caret(a)==4,"Preedit was not used by visible editor layout");
    gui__zero(e,128);store64(e,GUI_KEY_DOWN);store64(e+8,ud_window);store64(e+16,40);h_assert(!ui_desktop_event(e) && ud_ime_node==a,"Enter submitted while IME was composing");
    h_assert(ie_emit(e,0,0,"你好","",0,0)==1 && h_equal(ui_desktop_value("a"),"ab你好cd") && !ud_ime_node && load64(a+144)==8,"Chinese commit lost its insertion point");
    ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"a\",\"parent\":\"page\",\"after\":\"\",\"node\":{\"key\":\"a\",\"kind\":\"input\",\"props\":{\"value\":\"ab你好cd\",\"ime\":\"send\",\"height\":100,\"size\":20},\"children\":[]}}]}"));h_assert(load64(a+144)==8 && load64(a+152)==8,"Model echo moved the IME commit caret to the end");
    h_assert(ie_emit(e,3,2,"!","",0,0)==1 && h_equal(ui_desktop_value("a"),"ab你!") && load64(a+144)==6,"Surrounding delete/commit order is incorrect");
    store64(a+144,5);store64(a+152,5);ie_emit(e,1,0,"BAD","",0,0);h_assert(h_equal(ui_desktop_value("a"),"ab你!") && load64(a+144)==5,"Deletion split a UTF-8 code point");
    h_assert(gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"OLD","",0,0,0),gui_error);ui_desktop_apply(j_parse("{\"version\":1,\"ops\":[{\"op\":\"attribute\",\"key\":\"a\",\"name\":\"value\",\"value\":\"reset\"}]}"));ie_drain(e);h_assert(h_equal(ui_desktop_value("a"),"reset"),"External value replacement accepted an old IME commit");
    // A queued result from editor a must not reach b or a new session of a.
    let epoch=gui__ime_epoch;h_assert(gui__ime_emit(ud_window,epoch,0,1,0,0,"STALE","",0,0,0),gui_error);ui_desktop_focus("b");ui_desktop_focus("a");ie_drain(e);h_assert(h_find(ui_desktop_value("a"),"STALE")<0 && h_equal(ui_desktop_value("b"),"other"),"Delayed commit crossed editor sessions");
    let b=h_buffer();let i=0;while i<100{h_text(b,"中文");i=i+1;}let long=h_data(b);h_assert(h_len(long)==600,"Long preedit fixture");ie_emit(e,0,0,"",long,-1,-1);h_assert(ud_ime_bytes==600 && ud_ime_begin== -1,"Long preedit was truncated");ui_desktop_draw();
    h_assert(!gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"","中",1,1,0),"IME accepted a continuation-byte cursor");
    if argc>1{let lib=ffi_open(load64(argv+8));h_assert(lib,"Cannot load independent SDL IME producer");let original_poll=gui__poll_fn;gui__poll_fn=ffi_symbol(lib,"gui_fixture_poll");let push=ffi_symbol(lib,"ime_fixture_preedit");h_assert(push,"Missing SDL IME producer");let id=load64(gui__record(ud_window)+32);h_assert(ffi_call(push,id,"ä你好",1,2,0,0),"Cannot push SDL text editing");ie_drain(e);h_assert(ud_ime_bytes==8 && ud_ime_begin==2 && ud_ime_end==8,"SDL editing character indices were not converted to UTF-8 bytes");h_assert(ffi_call(push,id,long,100,0,1,0),"Cannot push SDL extended text editing");ie_drain(e);h_assert(ud_ime_bytes==600 && ud_ime_begin==300 && ud_ime_end==300,"SDL extended preedit was truncated or freed too early");gui__poll_fn=original_poll;ffi_close(lib);}
    gui__zero(e,128);store64(e,GUI_KEY_DOWN);store64(e+8,ud_window);store64(e+16,GUI_KEY_ESCAPE);ui_desktop_event(e);h_assert(!ud_ime_text && !ud_ime_node,"Escape retained composition");
    gui__zero(e,128);store64(e,GUI_FOCUS);store64(e+8,ud_window);store64(e+16,0);ui_desktop_event(e);ui_desktop_draw();ud_caret_epoch=gui_ticks()-1500;h_assert(ud_ime_suspended && !ui_desktop_needs_draw(),"Unfocused caret kept scheduling redraws");store64(e+16,1);ui_desktop_event(e);h_assert(!ud_ime_suspended && ui_desktop_needs_draw() && !ud_caret_phase(),"Focus return did not immediately restore caret visibility");ui_desktop_draw();
    // UTF-8-safe <=4000-byte surrounding window and unsupported large selection.
    let p=wm_context();let text=h_buffer();i=0;while i<3000{h_text(text,"界");i=i+1;}let value=h_data(text);h_assert(wm_surrounding(0,p,value,4500,4506,1),gui_error);h_assert(load64(p+104) && load64(p+112)<=4000 && wc_valid(p+256,load64(p+112)) && load64(p+128)-load64(p+120)==6,"Surrounding window split UTF-8 or selection");wm_surrounding(0,p,value,0,9000,1);h_assert(!load64(p+104) && load64(p+96),"Oversized selection retained stale surrounding support");
    h_assert(!wm_surrounding(0,p,value,1,1,1),"Surrounding accepted a continuation-byte cursor");wm_close(0,p);
    // A same-session serial mismatch applies edits but holds outgoing state.
    // Replies preceding the current enable must be discarded, including wrap.
    ie_drain(e);p=wm_context();let w=alloc(1024);bytes_fill(w,0,1024);store64(w+8,ud_window);store64(p+32,1);store64(p+40,1);store64(p+48,1);store64(p+56,10);store64(p+64,gui__ime_epoch);store64(p+72,12);store8(p+4352,88);store64(p+176,1);wm_done(0,p,w,11);h_assert(load64(p+240) && gui_poll(e),"Mismatched done was dropped");let data=gui_ime_data(gui_event_code(e));h_assert(data && !load64(data+24) && h_equal(load64(data+96),"X"),"Mismatched done lost edits");gui_poll(e);wm_done(0,p,w,9);h_assert(!gui_poll(e),"Old-session done reached the editor");wm_done(0,p,w,12);h_assert(!load64(p+240) && gui_poll(e),"Matching done did not release pending state");gui_poll(e);store64(p+56,0xfffffffe);store64(p+72,1);wm_done(0,p,w,0);h_assert(gui_poll(e),"Serial wrap rejected a current-session transaction");gui_poll(e);wm_done(0,p,w,0xfffffffd);h_assert(!gui_poll(e),"Serial wrap accepted an old session");wm_close(0,p);syscall(11,w,1024,0,0,0,0);
    // A compositor may grant text-input focus before any keyboard exists.
    ie_drain(e);p=wm_context();w=alloc(1024);bytes_fill(w,0,1024);store64(w+8,ud_window);store64(w+16,xk_open(0));store64(w+256,p);let client=alloc(512);bytes_fill(client,0,512);store64(client+48,42);let meta=alloc(32);bytes_fill(meta,0,32);store64(meta+8,61);let args=alloc(8);store64(args,42);
    wm_dispatch(client,w,meta,0,0,args);h_assert(gui_poll(e) && gui_event_kind(e)==GUI_FOCUS && gui_event_code(e)==1 && load64(w+64),"Text-input-only seat did not gain focus");ui_desktop_event(e);h_assert(!ud_ime_suspended,"Text-input focus did not resume the editor");wm_dispatch(client,w,meta,0,1,args);h_assert(gui_poll(e) && gui_event_kind(e)==GUI_FOCUS && !gui_event_code(e) && !load64(w+64),"Text-input-only seat did not lose focus");ui_desktop_event(e);h_assert(ud_ime_suspended,"Text-input leave retained editor focus");store64(w+40,1);wm_dispatch(client,w,meta,0,0,args);h_assert(!gui_poll(e),"Text-input enter overrode an existing keyboard's focus");xk_free(load64(w+16));wm_close(0,p);syscall(11,w,1024,0,0,0,0);syscall(11,client,512,0,0,0,0);syscall(11,meta,32,0,0,0,0);syscall(11,args,8,0,0,0,0);
    // Bounded payload ownership and automatic release when the next poll starts.
    gui__ime_clear();gui__event_read=gui__event_write;let token=gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"","x",0,0,0);h_assert(gui_poll(e) && gui_ime_data(token),"IME payload missing on consumption");gui_poll(e);h_assert(!gui_ime_data(token),"Borrowed IME payload survived the next poll");
    i=0;while i<128{h_assert(gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"","x",0,0,0),gui_error);i=i+1;}h_assert(!gui__ime_emit(ud_window,gui__ime_epoch,0,1,0,0,"","x",0,0,0),"IME queue grew past its bound");
    ui_desktop_close();gui_quit();h_assert(!gui__ime_slots && !ud_ime_text,"IME close leaked retained state");syscall(11,e,128,0,0,0,0);h_print(1,"PASS IME editor: preedit/commit, Chinese, selection, deletion, session races, layout, UTF-8, bounded queue and cleanup\n");return 0;
}
