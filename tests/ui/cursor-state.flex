// Pure animation arithmetic and focus state: no display, renderer or cursor FFI.
import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn main(argc,argv){
    h_environment(argc,argv);let p=wn_context();let cursor=alloc(24);let images=alloc(32);let headers=alloc(96);bytes_fill(cursor,0,24);bytes_fill(headers,0,96);bytes_store32(cursor,3);store64(cursor+8,images);let i=0;
    while i<4{store64(images+i*8,headers+i*24);bytes_store32(headers+i*24,32);bytes_store32(headers+i*24+4,32);bytes_store32(headers+i*24+8,i);bytes_store32(headers+i*24+12,i+1);i=i+1;}
    bytes_store32(headers+16,45);bytes_store32(headers+40,70);bytes_store32(headers+64,115);h_assert(wn_select(p,cursor,1000000000),gui_error);h_assert(load64(p+184)==230000000,"Cursor period differs");
    let rows=j_array();i=0;while i<2000{let elapsed=(i*7919)%460000; if i<8{elapsed=0;if i==1{elapsed=44;}else if i==2{elapsed=45;}else if i==3{elapsed=114;}else if i==4{elapsed=115;}else if i==5{elapsed=229;}else if i==6{elapsed=230;}else if i==7{elapsed=4294967296+115;}}
        let now=1000000000+elapsed*1000000;let row=j_array();j_push(row,j_int(elapsed));j_push(row,j_int(wn_frame(p,now)));j_push(row,j_int(load64(p+168)));j_push(rows,row);i=i+1;}
    bytes_store32(headers+40,0);h_assert(wn_select(p,cursor,100) && wn_frame(p,45000100)==2 && load64(p+168)==160000100,"Zero-delay frame was not skipped");
    bytes_store32(headers+16,0);bytes_store32(headers+64,0);h_assert(wn_select(p,cursor,100) && wn_frame(p,999999)==0 && !load64(p+168) && !load64(p+184),"All-zero delays should remain static");bytes_store32(cursor,1);bytes_store32(headers+16,500);h_assert(wn_select(p,cursor,0) && !load64(p+184),"Single image should not animate");
    bytes_store32(cursor,0);h_assert(!wn_select(p,cursor,0),"Empty cursor accepted");bytes_store32(cursor,1025);h_assert(!wn_select(p,cursor,0),"Unbounded cursor accepted");bytes_store32(cursor,1);bytes_store32(headers,0);h_assert(!wn_select(p,cursor,0),"Empty image accepted");bytes_store32(headers,32);bytes_store32(headers+8,32);h_assert(!wn_select(p,cursor,0),"Out-of-range hotspot accepted");bytes_store32(headers+8,0);
    store64(p+96,1);store64(p+104,1);store64(p+184,230000000);store64(p+168,gui_monotonic_ns()-10000000);h_assert(wn_timeout(p,5000)==0,"Expired cursor timer did not wake");store64(p+168,gui_monotonic_ns()+100000000);let timeout=wn_timeout(p,5000);h_assert(timeout>=0 && timeout<=100,"Cursor timer did not clamp wait");store64(p+192,1);h_assert(wn_timeout(p,5000)==5000,"Pending callback caused timed polling");store64(p+192,0);store64(p+96,0);h_assert(wn_timeout(p,5000)==5000,"Pointer leave left an animation timer");wn_stop(0,p);h_assert(!load64(p+152) && !load64(p+168) && !load64(p+184) && !load64(p+192),"Animation cleanup retained resources");
    let w=alloc(1024);bytes_fill(w,0,1024);let k=xk_open("C.UTF-8");h_assert(k,"XKB initialization failed");store64(w+16,k);store64(w+24,123);store64(w+32,456);store64(w+64,1);store64(w+96,31);store64(w+112,999);wi_blur(w);h_assert(load64(w+24)==123 && load64(w+32)==456 && !load64(w+64) && !load64(w+96) && !load64(w+112) && !xk_mods(k),"Focus loss retained repeat/modifiers or cleared seat/pointer");xk_free(k);syscall(11,w,1024,0,0,0,0);
    wn_close(0,p);syscall(11,cursor,24,0,0,0,0);syscall(11,images,32,0,0,0,0);syscall(11,headers,96,0,0,0,0);h_print(1,h_cat(j_dump(rows),"\n"));return 0;
}
