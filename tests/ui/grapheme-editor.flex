    let hit=ud_caret_at(node,load64(origin),load64(origin+8)+j_n(layout,"line")/2);store64(node+144,hit);store64(node+152,hit);let previous=-1;let steps=0;let moving=1;while moving{layout=ud_edit_layout(node);let x=j_n(layout,"caret_x");h_assert(x>previous && ud_edit_is_boundary(load64(node+144)),"Visual right movement stalled or split a grapheme");previous=x;let before=load64(node+144);let affinity=load64(node+248);ge_key(event,79);steps=steps+1;moving=before!=load64(node+144) || affinity!=load64(node+248);h_assert(steps<64,"Visual arrow cycle");}h_assert(steps>=12,"Visual arrows skipped visible mixed-direction text");
    previous=0x7fffffffffffffff;moving=1;while moving{layout=ud_edit_layout(node);let x=j_n(layout,"caret_x");h_assert(x<previous,"Visual left movement stalled");previous=x;let before=load64(node+144);let affinity=load64(node+248);ge_key(event,80);moving=before!=load64(node+144) || affinity!=load64(node+248);}h_assert(h_equal(ud_content(node),"abc אבג 123 (דהו)"),"Visual editing mutated logical text");
