    let result=j_dump(report);ui_desktop_close();h_assert(!ud_edit_graphemes && !ud_edit_blocks,"Unicode editor retained geometry after close");gui_quit();syscall(11,e,128,0,0,0,0);h_print(1,h_cat(result,"\n"));return 0;
