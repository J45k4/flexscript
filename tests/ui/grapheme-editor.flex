    let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"scale",j_int(gui_scale(ud_window)));j_set(report,"grapheme_count",j_int(load64(ud_edit_graphemes)-1));j_set(report,"warm_layout_builds",j_int(ud_edit_builds-build));j_set(report,"warm_prefix_measurements",j_int(ud_edit_measurements-measures));j_set(report,"width",j_int(gui_pixel_width(ud_window)));j_set(report,"height",j_int(gui_pixel_height(ud_window)));
