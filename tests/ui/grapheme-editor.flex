    ge_set("XáY");store64(field+144,1);store64(field+152,2);ge_key(e,76);h_assert(h_equal(ui_desktop_value("field"),"XY"),"Selection deletion cut a grapheme at a codepoint boundary");
    ge_set("XáY");store64(field+144,1);store64(field+152,2);gui__zero(e,128);store64(e,GUI_TEXT);store64(e+8,ud_window);gui_event_text_set(e,"x");ui_desktop_event(e);h_assert(h_equal(ui_desktop_value("field"),"XxY"),"Typing replaced only part of a selected grapheme");
