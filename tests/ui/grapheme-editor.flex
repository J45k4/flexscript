    let text="AV\tffi á 🇫🇮 👨‍👩‍👧‍👦 שלום";ge_set(text);ui_desktop_draw();let layout=ud_edit_layout(field);h_assert(load64(ud_edit_graphemes)<h_len(text),"Editor did not retain grapheme boundaries");let build=ud_edit_builds;i=0;while i<ud_edit_count{ud_edit_prepare(ud_edit_records+i*96);i=i+1;}let measures=ud_edit_measurements;let seen=h_zero(h_take(h_len(text)+1),h_len(text)+1);let shapes=0;if native{shapes=load64(gn_shapes+32);}
