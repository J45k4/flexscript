// Compare retained UI ownership, values, geometry and pixels for both copy paths.
import "../../libs/ui/desktop.flex";
global mc_out=0;global mc_mode=0;global mc_step=0;global mc_event=0;global mc_reference=0;global mc_candidate=0;
fn mc_contains(blocks,p){while blocks{if p>=blocks && p<blocks+load64(blocks+8){return 1;}blocks=load64(blocks);}return 0;}
fn mc_owned(value){h_assert(mc_contains(ud_pool,value),"UI retained a JSON node outside its pool");let kind=j_kind(value);let data=j_value(value);if kind==2 || kind==6{h_assert(mc_contains(ud_pool,data),"UI retained caller text");}if kind==3 || kind==4{h_assert(mc_contains(ud_pool,data-8),"UI retained caller collection");let i=0;while i<h_count(data){let item=h_at(data,i);if kind==4{h_assert(mc_contains(ud_pool,item) && mc_contains(ud_pool,load64(item)),"UI retained caller field/key");item=load64(item+8);}mc_owned(item);i=i+1;}}return 0;}
fn mc_validate(){let i=0;while i<2048{let n=ud_nodes+i*256;if load64(n){h_assert(mc_contains(ud_pool,load64(n)),"UI retained caller widget key");mc_owned(load64(n+16));}i=i+1;}if ud_images{mc_owned(ud_images);}return 0;}
fn mc_apply(packet){
    let saved=h_blocks;let used=h_used;let capacity=h_capacity;h_blocks=0;h_used=0;h_capacity=0;let owned=j_parse(j_dump(packet));ui_desktop_apply(owned);mc_validate();h_reset(0);h_blocks=saved;h_used=used;h_capacity=capacity;return 0;
}
fn mc_op(op){let packet=j_object();j_set(packet,"version",j_int(1));let ops=j_array();j_push(ops,op);j_set(packet,"ops",ops);return mc_apply(packet);}
fn mc_property(key,name,value){let op=j_object();j_set(op,"op",j_string("attribute"));j_set(op,"key",j_string(key));j_set(op,"name",j_string(name));j_set(op,"value",value);return mc_op(op);}
fn mc_text(key,text){let op=j_object();j_set(op,"op",j_string("text"));j_set(op,"key",j_string(key));j_set(op,"value",j_string(text));return mc_op(op);}
fn mc_snapshot(label){
    // Hide caret animation so rendering comparisons do not depend on wall time.
    ud_ime_suspended=1;ui_desktop_draw();mc_validate();let row=j_object();j_set(row,"label",j_string(label));let nodes=j_array();let i=0;
    while i<2048{let n=ud_nodes+i*256;if load64(n){let item=j_object();j_set(item,"key",j_string(load64(n)));j_set(item,"descriptor",load64(n+16));let fields=j_array();let offset=64;while offset<=152{j_push(fields,j_int(load64(n+offset)));offset=offset+8;}j_push(fields,j_int(load64(n+208)));j_push(fields,j_int(load64(n+216)));j_set(item,"fields",fields);let parent="mount";if load64(n+24)!=ud_mount{parent=load64(load64(n+24));}j_set(item,"parent",j_string(parent));let next="";if load64(n+48){next=load64(load64(n+48));}j_set(item,"next",j_string(next));j_push(nodes,item);}i=i+1;}
    j_set(row,"nodes",nodes);let focus="";if ud_focus{focus=load64(ud_focus);}j_set(row,"focus",j_string(focus));j_set(row,"images",ud_images);let canonical=j_dump(row);let width=gui_pixel_width(ud_window);let height=gui_pixel_height(ud_window);let bytes=width*height*4;let pixels=alloc(bytes);h_assert(gui_read_pixels(ud_window,pixels,width*4,bytes),gui_error);let prefix=h_cat3(mc_out,h_int(mc_step),"-");
    if !mc_mode{h_save(h_cat(prefix,"state.json"),canonical);h_save_bytes(h_cat(prefix,"rgba"),pixels,bytes,420);}else{h_assert(h_equal(h_read(h_cat(prefix,"state.json")),canonical),h_cat("Owned UI copy changed retained state/geometry: ",label));let old=h_read(h_cat(prefix,"rgba"));h_assert(h_file_size==bytes && bytes_common_prefix(old,pixels,bytes)==bytes,h_cat("Owned UI copy changed pixels: ",label));}
    syscall(11,pixels,bytes,0,0,0,0);mc_step=mc_step+1;return 0;
}
fn mc_initial(){
    let packet=j_parse("{\"version\":1,\"ops\":[{\"op\":\"insert\",\"key\":\"page\",\"parent\":\"mount\",\"after\":\"\",\"node\":{\"key\":\"page\",\"kind\":\"column\",\"props\":{\"padding\":4,\"gap\":3,\"width\":-1,\"height\":-1},\"children\":[{\"key\":\"heading\",\"kind\":\"text\",\"text\":\"Ownership: ä中👋\",\"props\":{\"color\":\"#eeeeee\",\"size\":14,\"metadata\":{\"empty\":[],\"values\":[null,false,true,42,\"quote \\\" and newline\\n\"]}},\"children\":[]},{\"key\":\"scroll\",\"kind\":\"scroll\",\"props\":{\"height\":105,\"width\":-1},\"children\":[{\"key\":\"body\",\"kind\":\"column\",\"props\":{\"gap\":2,\"width\":-1},\"children\":[]}]},{\"key\":\"draft\",\"kind\":\"input\",\"props\":{\"value\":\"base\",\"size\":13,\"color\":\"#eeeeee\",\"max_lines\":3},\"children\":[]},{\"key\":\"image\",\"kind\":\"image\",\"props\":{\"source\":\"preview:copy\",\"height\":24,\"width\":24},\"children\":[]}]}}]}");let page=j_need(j_at(j_need(packet,"ops"),0),"node");let body=j_at(j_need(j_at(j_need(page,"children"),1),"children"),0);let children=j_need(body,"children");let i=0;while i<12{let node=j_object();j_set(node,"key",j_string(h_cat("line-",h_int(i))));j_set(node,"kind",j_string("text"));j_set(node,"text",j_string("Wrapped text with `code`, 中文, é, quotes and more words."));j_set(node,"props",j_parse("{\"size\":12,\"color\":\"#eeeeee\"}"));j_set(node,"children",j_array());j_push(children,node);i=i+1;}return mc_apply(packet);
}
fn mc_run(mode){
    mc_mode=mode;mc_step=0;ud_direct_copy=mode;h_assert(ui_desktop_open("Owned model copies",320,280,GUI_HIDDEN|GUI_RESIZABLE),gui_error);ui_desktop_image("preview:copy","apps/collie/android/res/drawable-nodpi/collie_border_collie.png");mc_initial();mc_snapshot("initial caller arena released");let identity=ui_desktop_identity("draft");ui_desktop_focus("draft");gui__zero(mc_event,128);store64(mc_event,GUI_TEXT);store64(mc_event+8,ud_window);gui_event_text_set(mc_event," ä中👋");let result=ui_desktop_event(mc_event);h_assert(result && h_equal(j_s(result,"value"),"base ä中👋"),"Local editor event changed");let event_json=j_dump(result);mc_snapshot("local Unicode edit");mc_property("draft","value",j_string("base ä中👋"));h_assert(ui_desktop_identity("draft")==identity && ud_focus==ud_need("draft"),"Model echo lost editor identity/focus");mc_snapshot("model echo");mc_property("heading","color",j_string("#c5e3ae"));mc_snapshot("style patch");mc_text("line-2","Replacement text\nwith several lines\nand CJK 中文.");mc_snapshot("text patch");mc_property("line-3","hidden",j_bool(1));mc_snapshot("hidden child");mc_property("line-3","hidden",j_bool(0));mc_snapshot("shown child");
    let op=j_parse("{\"op\":\"move\",\"key\":\"line-3\",\"parent\":\"body\",\"after\":\"line-0\"}");mc_op(op);mc_snapshot("keyed move");store64(ud_need("scroll")+136,70);mc_property("heading","padding",j_int(3));mc_snapshot("scroll survives compaction");gui_resize(ud_window,341,291);mc_snapshot("window resize");mc_property("draft","value",j_string("Controlled\nmultiline draft"));mc_snapshot("controlled draft");mc_property("image","source",j_string("preview:rebound"));ui_desktop_image("preview:rebound","apps/collie/android/res/drawable-nodpi/collie_border_collie.png");mc_snapshot("image bindings");
    let expected=0;let peak=0;let i=0;while i<200{mc_text("line-1",h_cat("Stress compaction ",h_int(i%10)));let bytes=0;let block=ud_pool;while block{bytes=bytes+load64(block+8);block=load64(block);}if i==10{expected=bytes;}if i>=10{h_assert(bytes==expected,"Repeated model compaction grew its retained arena");}if bytes>peak{peak=bytes;}i=i+1;}mc_snapshot("200 model compactions");
    mc_op(j_parse("{\"op\":\"remove\",\"key\":\"draft\"}"));h_assert(!ud_focus && !ui_desktop_identity("draft"),"Removed input retained focus/identity");mc_snapshot("focused input removal");mc_op(j_parse("{\"op\":\"insert\",\"key\":\"draft\",\"parent\":\"page\",\"after\":\"scroll\",\"node\":{\"key\":\"draft\",\"kind\":\"input\",\"props\":{\"value\":\"replacement\"},\"children\":[]}}"));h_assert(ui_desktop_identity("draft")!=identity,"Reinserted input reused old identity");mc_snapshot("input replacement");h_assert(h_equal(j_dump(result),event_json),"Later model mutation freed the returned editor event");if mode{mc_candidate=peak;}else{mc_reference=peak;}
    if gui__native{h_assert(!gr_gl(load64(gui__record(ud_window)+8),48,0,0,0,0,0,0) && h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native model fixture loaded SDL or caused a GL error");}ui_desktop_close();h_assert(!ud_pool,"Model arena survived close");return 0;
}
fn main(argc,argv){h_environment(argc,argv);h_assert(argc==3,"capture-prefix report.json");mc_out=load64(argv+8);mc_event=gui_event();mc_run(0);let checks=mc_step;mc_run(1);h_assert(mc_step==checks && mc_candidate<=mc_reference,"Direct copying increased retained model capacity");let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"checks",j_int(checks));j_set(report,"byte_identical",j_bool(1));j_set(report,"state_identical",j_bool(1));j_set(report,"source_arena_released",j_bool(1));j_set(report,"compaction_updates",j_int(400));j_set(report,"reference_peak_arena_bytes",j_int(mc_reference));j_set(report,"candidate_peak_arena_bytes",j_int(mc_candidate));h_save(load64(argv+16),j_dump(report));h_print(1,h_cat(j_dump(report),"\n"));gui_quit();syscall(11,mc_event,128,0,0,0,0);return 0;}
