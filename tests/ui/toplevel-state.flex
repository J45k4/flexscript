// Configure transaction / restore sizing without a compositor or GPU.
import "../../libs/gui/backends/wayland/client.flex";
import "../../scripts/lib/json.flex";
fn main(argc,argv){
    h_environment(argc,argv);let c=alloc(512);bytes_fill(c,0,512);let title=alloc(32);bytes_copy(title,"Original title",15);h_assert(wt_context(c,title,640,420,3),"Toplevel context failed");store8(title,88);let p=load64(c+456);h_assert(wl_equal(load64(p+64),"Original title") && !load64(p),"Hidden/title ownership differs");h_assert(wt_title(c,"New title") && wl_equal(load64(p+64),"New title"),"Title replacement failed");let too_long=alloc(4098);bytes_fill(too_long,65,4097);store8(too_long+4097,0);h_assert(!wt_title(c,too_long) && wl_equal(load64(p+64),"New title"),"Oversized title changed saved state");
    let array=alloc(24);let states=alloc(32);bytes_fill(array,0,24);store64(array+16,states);bytes_store32(states,4);store64(array,4);h_assert(wt_pending(c,800,500,array),wl_error);h_assert(!load64(c+104) && !load64(p+48),"Pending configure became current before configure serial");h_assert(wt_configured(c) && load64(c+72)==800 && load64(c+80)==500 && load64(p+48)==16 && load64(p+32)==800,"Normal configure size/activation differs");
    bytes_store32(states,2);h_assert(wt_pending(c,1600,1000,array) && wt_configured(c),wl_error);h_assert(load64(p+48)==4 && load64(p+32)==800 && load64(p+40)==500,"Fullscreen replaced normal size");h_assert(wt_pending(c,0,0,array) && wt_configured(c) && load64(c+72)==1600 && load64(c+80)==1000,"State-only configure shrank fullscreen to its floating size");store64(p+32,700);store64(p+40,460);store64(p+144,1);store64(array,0);h_assert(wt_pending(c,800,500,array) && wt_configured(c) && load64(c+72)==700 && load64(c+80)==460 && !load64(p+144),"Explicit restore size was lost");h_assert(wt_pending(c,0,0,array) && wt_configured(c) && load64(c+72)==700 && load64(c+80)==460,"Zero-size configure lost natural dimensions");
    let i=0;while i<5{let state=1;if i>0{state=i+4;}bytes_store32(states,state);store64(array,4);h_assert(wt_pending(c,1600,1000,array) && wt_configured(c) && wt_constrained(load64(p+48)) && load64(p+32)==700,"Constrained configure overwrote natural size");h_assert(wt_pending(c,0,0,array) && wt_configured(c) && load64(c+72)==1600 && load64(c+80)==1000,"State-only configure shrank maximized/tiled geometry");i=i+1;}
    store64(p+16,1);store64(c+104,0);store64(array,0);let generation=load64(p+24);h_assert(wt_pending(c,900,600,array) && wt_configured(c) && !load64(c+104) && load64(p+24)==generation,"Pre-remap configure crossed the sync barrier");store64(p+16,0);h_assert(wt_pending(c,0,0,array) && wt_configured(c) && load64(c+72)==700,"Fresh remap configure failed");
    bytes_store32(states,999);store64(array,4);h_assert(wt_pending(c,0,0,array) && wt_configured(c) && !load64(p+48),"Unknown optional state was not ignored");store64(p+80,0);store64(array,0);h_assert(wt_pending(c,1000,700,array) && wt_configured(c) && load64(c+72)==700 && load64(c+80)==460,"Normal configure changed a fixed-size client");store64(array,3);h_assert(!wt_pending(c,0,0,array) && load64(c+112),"Misaligned state array accepted");store64(c+112,0);store64(array,260);h_assert(!wt_pending(c,0,0,array),"Oversized state array accepted");store64(array,0);h_assert(!wt_pending(c,0xffffffff,1,array),"Negative compositor size accepted");h_assert(!wt_pending(c,16384,16384,array),"Oversized compositor area accepted");
    wt_close(c);syscall(11,c,512,0,0,0,0);syscall(11,title,32,0,0,0,0);syscall(11,too_long,4098,0,0,0,0);syscall(11,array,24,0,0,0,0);syscall(11,states,32,0,0,0,0);h_print(1,"PASS native toplevel configure transactions, hidden/title ownership, natural/restore sizes, remap barrier and bounds\n");return 0;
}
