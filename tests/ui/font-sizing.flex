import "../../libs/gui/draw.flex";
import "../../scripts/lib/json.flex";
fn main(argc,argv){
    h_environment(argc,argv);h_assert(argc==5,"oracle.so scalable.ttf emoji.ttf output-prefix");let lib=ffi_open(load64(argv+8));let oracle=ffi_symbol(lib,"oracle_font_size");h_assert(lib && oracle,"Missing font-size oracle");let window=gui_open("Font size fixture",360,220,GUI_HIDDEN);h_assert(window && gui_canvas_open(window,0),gui_error);let w=gui_pixel_width(window);let h=gui_pixel_height(window);h_assert(gui_canvas_size(window,w,h),gui_error);let bytes=w*h*4;let pixels=alloc(bytes);let expected=alloc(48);let rows=j_array();let sizes=alloc(5*8);store64(sizes,12);store64(sizes+8,20);store64(sizes+16,32);store64(sizes+24,64);store64(sizes+32,109);let i=0;
    while i<5{let size=load64(sizes+i*8);let kind=0;while kind<2{let path=load64(argv+16);let text="Ag ä";if kind{path=load64(argv+24);text="👋";}let font=gui_font_open(path,size,0);h_assert(font,gui_error);h_assert(ffi_call_i32(oracle,path,size,text,expected,gui__native,0),"Independent font-size oracle failed");let height=gui_font_height(font);let ascent=gui_font_ascent(font);let width=gui_text_width(font,text);h_assert(height==load64(expected) && ascent==load64(expected+8) && width==load64(expected+16),"Requested font metrics differ from independent oracle");h_assert(!gui_text_width(font,"") && gui_font_has(font,65*(1-kind)+0x1f44b*kind),"Font coverage/empty metrics differ");
        if kind{h_assert(load64(expected+32)>0 && !load64(expected+40),"Fixture is not a non-scalable bitmap face");h_assert(gui_clear(window,0) && gui_text_draw(window,font,text,0xffffff,8,8),gui_error);h_assert(gui_read_pixels(window,pixels,w*4,bytes),gui_error);let left=w;let top=h;let right=-1;let bottom=-1;let y=0;while y<h{let x=0;while x<w{let p=pixels+(y*w+x)*4;if load8(p)>16 || load8(p+1)>16 || load8(p+2)>16{if x<left{left=x;}if x>right{right=x;}if y<top{top=y;}if y>bottom{bottom=y;}}x=x+1;}y=y+1;}h_assert(right>=left && bottom>=top && right-left+1<=width+2 && bottom-top+1<=height+2 && right-left+1>=size/2 && bottom-top+1>=size/2,"Bitmap glyph is blank, clipped or rendered at its strike size");h_save_bytes(h_cat3(load64(argv+32),h_int(size),".rgba"),pixels,bytes,420);}
        let row=j_object();j_set(row,"pixels",j_int(size));j_set(row,"bitmap",j_bool(kind));j_set(row,"height",j_int(height));j_set(row,"ascent",j_int(ascent));j_set(row,"width",j_int(width));j_set(row,"raster_pixels",j_int(load64(expected+24)));j_push(rows,row);gui_font_close(font);kind=kind+1;
    }i=i+1;}
    h_assert(!gui_font_open("/not/an/existing/font.ttf",16,0),"Invalid font file was accepted");i=0;while i<64{let font=gui_font_fallback("sans-serif",12+i%20,0,0x1f44b);h_assert(font && gui_font_has(font,0x1f44b),gui_error);gui_font_close(font);i=i+1;}if gui__native{h_assert(h_find(h_read("/proc/self/maps"),"libSDL2")<0,"Native font fixture or independent oracle loaded SDL");}let report=j_object();j_set(report,"backend",j_string(gui_backend_name()));j_set(report,"pixel_width",j_int(w));j_set(report,"pixel_height",j_int(h));j_set(report,"cases",rows);h_save(h_cat(load64(argv+32),"report.json"),j_dump(report));gui_close(window);gui_quit();ffi_close(lib);syscall(11,pixels,bytes,0,0,0,0);syscall(11,expected,48,0,0,0,0);syscall(11,sizes,40,0,0,0,0);h_print(1,"PASS bitmap requested sizes, independent metrics, pixels, scalable-font preservation, fallback and repeated release\n");return 0;
}
