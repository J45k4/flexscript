// Synthetic Codex app-server peer, compiled for native login lifecycle checks.
import "../../apps/collie/desktop/host/system.flex";
fn nl_send(packet){h_print(1,j_dump(packet));h_print(1,"\n");return 0;}
fn nl_reply(id,result){let packet=j_object();j_set(packet,"id",id);j_set(packet,"result",result);return nl_send(packet);}
fn nl_completed(id,success){let params=j_object();sh_s(params,"loginId",id);sh_b(params,"success",success);let packet=j_object();sh_s(packet,"method","account/login/completed");j_set(packet,"params",params);return nl_send(packet);}
fn main(argc,argv){h_environment(argc,argv);let home=h_getenv("CODEX_HOME");let mode=h_getenv("COLLIE_LOGIN_MODE");if !mode{mode="wait";}let environment=j_object();sh_b(environment,"isolated",1);sh_b(environment,"api_key_present",h_getenv("OPENAI_API_KEY")!=0);sh_save_json(h_join(home,"environment.json"),environment);let line=h_buffer();let byte=h_take(1);while syscall(0,0,byte,1,0,0,0)==1{if load8(byte)!=10{h_append(line,byte,1);}else{let request=sj_parse(h_data(line));line=h_buffer();let method=cj_text(request,"method");let id=cj_get(request,"id");if h_equal(method,"initialize"){nl_reply(id,sh_s(j_object(),"userAgent","synthetic"));}else if h_equal(method,"account/login/start"){let kind=cj_text(cj_get(request,"params"),"type");let url="https://auth.openai.com/oauth/authorize?state=synthetic";if h_equal(kind,"chatgptDeviceCode"){url="https://auth.openai.com/codex/device";}if h_equal(mode,"invalid-url"){url="https://unexpected.example/login";}if h_equal(mode,"start-error"){let error=j_object();sh_n(error,"code",-1);sh_s(error,"message","private synthetic error");let packet=j_object();j_set(packet,"id",id);j_set(packet,"error",error);nl_send(packet);}else{let result=j_object();sh_s(result,"type",kind);sh_s(result,"loginId","synthetic-login");if h_equal(kind,"chatgptDeviceCode"){sh_s(result,"verificationUrl",url);sh_s(result,"userCode","TEST-CODE");}else{sh_s(result,"authUrl",url);}nl_reply(id,result);if h_equal(mode,"complete") || h_equal(mode,"early"){let auth=sh_read(h_getenv("COLLIE_LOGIN_AUTH_FILE"),1048576);sh_atomic(h_join(home,"auth.json"),auth,h_file_size);nl_completed("another-attempt",0);nl_completed("synthetic-login",1);}else if h_equal(mode,"failure"){nl_completed("synthetic-login",0);}else if h_equal(mode,"no-auth"){nl_completed("synthetic-login",1);}else if h_equal(mode,"exit"){return 0;}}}else if h_equal(method,"account/login/cancel"){nl_reply(id,sh_s(j_object(),"status","canceled"));if h_equal(mode,"late"){let auth=sh_read(h_getenv("COLLIE_LOGIN_AUTH_FILE"),1048576);sh_atomic(h_join(home,"auth.json"),auth,h_file_size);nl_completed("synthetic-login",1);}}}}return 0;}
