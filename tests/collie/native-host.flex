import "../../apps/collie/desktop/host/commands.flex";
// This isolated adapter harness never starts the service task loop. The
// imported multi-chat host also references the service's shutdown hook.
fn sv_shutdown_tasks(){return 0;}
fn nh_check(ok,message){h_assert(ok,message);h_print(1,h_cat3("PASS ",message,"\n"));return 0;}
fn main(argc,argv){h_environment(argc,argv);h_assert(argc==2,"native-host CONFIG");let options=sj_parse(h_read(load64(argv+8)));sh_libc=ffi_open("libc.so.6");sv=j_object();sv_input=alloc(8388609);let pipe=h_take(8);syscall(293,pipe,0x80000,0,0,0,0);syscall(33,load64(pipe)&0xffffffff,0,0,0,0,0);syscall(72,0,4,2048,0,0,0);sh_s(sv,"data",cj_text(options,"root"));sh_s(sv,"root",cj_text(options,"root"));sh_s(sv,"engine",cj_text(options,"engine"));sh_s(sv,"project_id","");sh_s(sv,"model","gpt-6.1-sol");j_set(sv,"permissions",j_parse("{\"network\":true,\"internet\":true,\"files_read\":true,\"files_write\":true}"));j_set(sv,"tasks",j_object());h_mkdir(h_join(sv_s("root"),"files"));
    nh_check(!sj_parse("{bad}") && !sj_parse("[1,]") && !sj_parse("{\"x\":1,\"x\":2}") && !sj_parse("\"\\u0000\"") && !sj_parse("\"\\ud800\""),"malformed saved/remote JSON is recoverable");nh_check(sj_parse("{\"text\":\"中文 \\ud83d\\udc4b\",\"number\":1.25e-3}"),"JSON Unicode, surrogate pairs and numeric metadata parse");
    nh_check(h_equal(j_dump(sj_parse("[1.25e-3,9223372036854775808]")),"[1.25e-3,9223372036854775808]"),"numeric metadata survives persistence/compaction");
    let resolved=sp_hardware(sv_s("root"),"net_resolve",j_parse("[\"default\",\"localhost\"]"));nh_check(resolved && j_count(resolved)>0,"native Linux DNS inventory");
    let args=j_array();j_push(args,j_string("default"));j_push(args,j_string("127.0.0.1"));j_push(args,j_int(cj_int(options,"tcp")));j_push(args,j_int(2000));let handle=sp_hardware(sv_s("root"),"net_tcp_connect",args);nh_check(handle && !se,"native TCP connection");let io=j_array();j_push(io,handle);j_push(io,j_string("hello"));let written=sp_hardware(sv_s("root"),"device_write",io);nh_check(written && j_value(written)==5,"bounded native TCP write");io=j_array();j_push(io,handle);j_push(io,j_int(32));j_push(io,j_int(2000));let read=sp_hardware(sv_s("root"),"device_read",io);nh_check(read && h_equal(cj_text(read,"$bytes"),"aGVsbG8="),"bounded native TCP read");nh_check(!sp_handle("different-session",j_value(handle)),"resource ownership is isolated by conversation");se=0;sp_close(sv_s("root"),"network");nh_check(!sp_handle(sv_s("root"),j_value(handle)),"revocation closes native resource handles");se=0;
    handle=sp_hardware(sv_s("root"),"net_udp_open",j_parse("[\"default\",0]"));nh_check(handle && !se,"native UDP socket");args=j_array();j_push(args,handle);j_push(args,j_string("127.0.0.1"));j_push(args,j_int(cj_int(options,"udp")));j_push(args,j_string("datagram"));written=sp_hardware(sv_s("root"),"net_udp_send",args);nh_check(written && j_value(written)==8,"bounded native UDP send");args=j_array();j_push(args,handle);j_push(args,j_int(32));j_push(args,j_int(2000));read=sp_hardware(sv_s("root"),"net_udp_receive",args);nh_check(read && h_equal(cj_text(cj_get(read,"data"),"$bytes"),"ZGF0YWdyYW0="),"native UDP receive and peer metadata");sp_close(0,0);
    let url=cj_text(options,"url");let response=sp_http(h_cat(url,"/ok"),2000,0);nh_check(response && cj_int(response,"status")==200 && h_equal(cj_text(response,"body"),"native TLS"),"Flexscript HTTP client verifies the trusted fixture certificate");response=sp_http(h_cat(url,"/large"),2000,1);nh_check(response && c_flag(response,"truncated") && h_len(cj_text(cj_get(response,"body"),"$bytes"))==43692,"HTTPS truncation stops at the 32 KiB guest limit");response=sp_http(h_cat(url,"/redirect"),2000,0);nh_check(response && h_equal(cj_text(response,"body"),"native TLS"),"guest HTTPS follows bounded HTTPS redirects");let request=cn_start(h_cat(url,"/redirect"),sh_s(j_object(),"Authorization","Bearer synthetic"),"{}",1024,2000,0);while request && !load64(request+32){cn_pump();h_sleep(1);}nh_check(request && cn_status(request)==302 && cn_error(request),"authenticated HTTPS never follows a redirect");cn_close(request);nh_check(!cn_start("http://127.0.0.1/",0,0,1024,1000,0),"unencrypted guest/provider URLs are rejected");se=0;
    let stream_headers=sh_s(j_object(),"Authorization","Bearer synthetic");sh_s(stream_headers,"Accept-Encoding","identity");sh_s(stream_headers,"Content-Type","application/json");let stream=cn_start(h_cat(url,"/stream"),stream_headers,"{}",4096,2000,0);let partial=0;while stream && !load64(stream+32){cn_pump();if load64(stream+16)>0 && !load64(stream+32){partial=1;}h_sleep(1);}nh_check(stream && !cn_error(stream) && partial && h_equal(load64(stream+8),"data: first\n\ndata: second\n\n"),"native HTTP transport streams authenticated chunked SSE incrementally");cn_close(stream);
    nh_check(!cn_start(h_cat(url,"/ok"),sh_s(j_object(),"Authorization","synthetic\r\nInjected: value"),0,1024,2000,0),"provider header values reject injected fields");se=0;
    nh_check(h_find(h_read("/proc/self/maps"),"libcurl.so")<0,"native HTTPS does not load libcurl");
    let source="fn main(){let h=net_tcp_connect(\"default\",\"127.0.0.1\",";source=h_cat(source,h_cat(h_int(cj_int(options,"tcp")),",2000);if(!h){return 7;}device_close(h);return 0;}"));let requestvm=j_object();sh_s(requestvm,"source",source);sh_s(requestvm,"call_id","native-platform");j_set(requestvm,"history",j_array());let observation=sv_call(3,0,requestvm);nh_check(observation && cj_int(observation,"exit_code")==0 && !h_len(cj_text(observation,"stderr")),"actual checked VM uses the Flexscript platform socket broker");
    let bytes="host file";nh_check(sh_write_project(h_join(sv_s("root"),"files"),"safe/note.txt",bytes,9),"native atomic project writes create directories");nh_check(!sh_write_project(h_join(sv_s("root"),"files"),"../outside.txt",bytes,9),"project writes reject traversal");se=0;let outside=h_join(sv_s("root"),"outside");h_mkdir(outside);syscall(88,outside,h_join(h_join(sv_s("root"),"files"),"linked"),0,0,0,0);nh_check(!sh_write_project(h_join(sv_s("root"),"files"),"linked/no.txt",bytes,9),"project writes reject symbolic-link components");se=0;
    cn_shutdown();h_print(1,"PASS native host adapters and TLS\n");return 0;
}
