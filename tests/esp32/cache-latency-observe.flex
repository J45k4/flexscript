// RAM-only timing observation. Mode selects GNU load alignment,not fault type.
// Both buses are globally disabled;GNU records all visible ARs before callbacks.
import "cache-access-body.flex";
import "../../lib/platform/esp32-radio-clock.flex";
fn main(){let bus=lt_bus();let mode=lt_mode();ci_line("CACHE LATENCY START ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();let ps=esp32_irq_save();esp32_irq_mask(0);esp32_store32(0x3ff005a0,0);if lt_clock()==160{esp_radio_clock_init();esp_radio_cpu160();}ci_disable();ci_flush();esp32_call32(0x400095a4,0,0,0,0,0,0,0,0);let pins=esp32_call32(0x40008658,0,0,0,0,0,0,0,0);esp32_call32(0x40062a6c,pins,0,0,0,0,0,0,0);ci_setup();ci_check(esp32_load32(0x3f401234)==lt_word(1) && esp32_load32(0x400d1234)==lt_word(1),1);let source=(esp32_load32(0x3ff48070)>>27)&3;let period=esp32_load32(0x3ff0003c)&3;let divider=esp32_load32(0x3ff66000)&1023;let rom_ticks=esp32_load32(0x3ffe01e0);ci_line("CLOCK SNAP SOURCE ",source);ci_line(" PERIOD ",period);ci_line(" DIV ",divider);ci_line(" ROMTICKS ",rom_ticks);esp_uart_write("\r\n");if lt_clock()==160{ci_check(source==1 && period==1 && divider==0 && rom_ticks==160,2);}else{ci_check(source==0 && period==0 && divider==0 && rom_ticks==13,3);}let address=0x3f401234;let enable=1<<15;if bus{address=0x400d1234;enable=1<<19;}ci_disable();let state=alloc(256);ci_check(state>0,4);let i=0;while i<256{esp32_store32(state+i,0);i=i+4;}esp32_store32(0x3ff00214,1);let value=esp32_call32(esp32_external("cr_run"),address,state,enable,0,0,0,0,0);esp32_irq_save();esp32_store32(0x3ff005a0,0);esp32_store32(0x3ff00214,6);let count=esp32_load32(state);let kind=esp32_load32(state+180);
 ci_line("CACHE LATENCY BUS ",bus);ci_line(" MODE ",mode);ci_line(" CLOCK ",lt_clock());ci_line(" SOURCE ",source);ci_line(" PERIOD ",period);ci_line(" DIV ",divider);ci_line(" ROMTICKS ",rom_ticks);ci_line(" KIND ",kind);ci_line(" ALIGN ",esp32_load32(state+176));ci_line(" VALUE ",value);ci_line(" SEEN ",count);ci_line(" PC ",esp32_load32(state+4));ci_line(" BARRIER ",esp32_load32(state+44));ci_line(" LOAD ",esp32_load32(state+48));ci_line(" NEXT ",esp32_load32(state+52));ci_line(" TAIL ",esp32_load32(state+56));ci_line(" AR8 ",esp32_load32(state+96));ci_line(" AR9 ",esp32_load32(state+100));ci_line(" FINAL9 ",esp32_load32(state+132));ci_line(" CAUSE ",esp32_load32(state+8));ci_line(" PRO0 ",esp32_load32(state+20)&1);ci_line(" PRO3 ",esp32_load32(state+24)&0x4400);ci_line(" EN ",esp32_load32(state+28));ci_line(" PENDING ",esp32_load32(state+16));ci_line(" AFTER ",esp32_load32(state+32));ci_line(" MMUACK ",esp32_load32(state+36)&1);if kind>=5{ci_line(" STARTCC ",esp32_load32(state+112));ci_line(" IRQCC ",esp32_load32(state+192));}esp_uart_write("\r\n");esp_uart_flush();ci_check(value==0xbad00bad && esp32_load32(state+128)==value && esp32_load32(state+132)==2+((kind==1) || (kind>=3))*7 && esp32_load32(state+136)==1,5);ci_check(count==1 && esp32_load32(state+8)==4 && esp32_load32(state+16)==2 && !esp32_load32(state+32),6);ci_check(esp32_load32(state+72)==address && esp32_load32(state+76)==state && esp32_load32(state+176)==mode && kind<=6,7);ci_check(!(esp32_load32(state+20)&1) && (esp32_load32(state+24)&0x4400)==(1<<(10+bus*4)) && esp32_load32(state+28)==enable && !(esp32_load32(state+36)&1),8);ci_disable();esp32_irq_restore(ps);ci_line("CACHE LATENCY COMPLETE ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();return 0;}
