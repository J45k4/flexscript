// Original ESP32 open-bus FIFO reads and12 native I2C completion callbacks.
// No peer is required. GPIO25 is released for the existing21-to25 jumper.
import "../../lib/platform/esp32-i2c.flex";
import "../../lib/platform/esp32-irq.flex";
global ii_bus=0;global ii_count=0;global ii_size=0;global ii_seen=0;global ii_bad=0;global ii_stop=0;
fn ii_check(ok,code){if !ok{esp_uart_write("I2C IRQ FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn ii_interrupt(source){let base=esp_i2c_base(ii_bus);let status=esp32_load32(base+44);if source!=49+ii_bus || !(status&128) || (status&0x524) || ((esp32_load32(base+8)>>8)&63)!=ii_size || !(esp32_load32(base+88+ii_stop*4)&0x80000000){ii_bad=ii_bad+1;}else{ii_seen=ii_seen+1;}esp32_store32(base+36,8191);return 0;}
fn main(){esp_gpio_input(25,0);let bus=0;while bus<2{let step=0;let rate=10000;while step<3{ii_check(esp_i2c_init(bus,21,22,rate)==0,1);ii_bus=bus;let base=esp_i2c_base(bus);ii_check(esp_irq_attach(49+bus,esp32_callback(ii_interrupt))==0,2);let choice=0;while choice<2{let size=1;if choice{size=32;}ii_size=size;esp32_store32(base+24,3<<12);esp32_store32(base+24,0);let i=0;while i<16{esp_i2c_command(base,i,4,0,0);i=i+1;}ei_tx_byte(bus,0xa5);let cmd=esp_i2c_command(base,0,0,0,0);cmd=esp_i2c_command(base,cmd,1,1,0);if size>1{cmd=esp_i2c_command(base,cmd,2,size-1,0);}cmd=esp_i2c_command(base,cmd,2,1,1024);ii_stop=cmd;esp_i2c_command(base,cmd,3,0,0);esp32_store32(base+36,8191);esp32_store32(base+40,128);let old=ii_seen;let ps=esp32_irq_save();esp_reg_update(base+4,32,32);while ii_seen==old && !ii_bad{esp32_wait();esp32_irq_save();}esp32_irq_restore(ps);ii_check(!ii_bad && ii_seen==old+1,3);i=0;while i<size{ii_check(ei_rx_byte(base)==255,4);i=i+1;}ii_check(!((esp32_load32(base+8)>>8)&63),5);esp32_store32(base+40,0);ii_count=ii_count+1;choice=choice+1;}ii_check(esp_irq_detach(49+bus)==0 && esp_i2c_deinit(bus)==0,6);step=step+1;if step==1{rate=100000;}else{rate=400000;}}bus=bus+1;}ii_check(ii_count==12 && ii_seen==12 && !ii_bad,7);esp_uart_write("PASS: I2C0/1 open-bus FIFO reads,12 native WAITI completion callbacks\r\n");esp_uart_flush();return 0;}
