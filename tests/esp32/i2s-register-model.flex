 n=0;while n<72{let f=im_ref+32+52*8+n*128;let bus=load64(f);let mode=load64(f+8);let bits=load64(f+16);let hz=load64(f+24);let expected=load64(f+112);let actual=0;
 if mode==3{actual=esp_i2s_init_duplex(bus,22,4,21,25,hz,bits);}else{let pin=25;if mode==2{pin=21;}actual=esp_i2s_init(bus,mode-1,22,4,pin,hz,bits);}im_check(actual==expected,20);let base=im_v(bus);
 im_check(im_get(base+im_v(6))==load64(f+32),21);im_check(im_get(base+im_v(10))==load64(f+40),22);im_check(im_get(base+im_v(15))==load64(f+48) && im_get(base+im_v(16))==load64(f+56),23);im_check(im_get(base+im_v(18))==load64(f+64) && im_get(base+im_v(19))==load64(f+72),24);im_check(im_get(base+im_v(17))==0 && im_get(base+im_v(20))==0 && im_get(base+im_v(8))==0,25);
 im_check(im_get(im_v(51)+22*4)==(load64(f+96)|1024) && im_get(im_v(51)+4*4)==(load64(f+104)|1024),26);if mode&2{im_check(im_get(im_v(51)+21*4)==(load64(f+80)|1024),27);}if mode&1{im_check(im_get(im_v(50)+load64(f+88)*4)==(25|128),28);}im_check((im_get(im_v(2))&im_v(4+bus)) && !(im_get(im_v(3))&im_v(4+bus)),29);
 im_check(esp_i2s_init_duplex(bus,22,4,21,25,hz,bits)== -16,30);let direction=0;while direction<2{if mode&(1<<direction){let desc=rd;let buf=rx;if direction{desc=td;buf=tx;}let size=bits/4;let round=0;while round<3{im_mode=0;im_check(esp_i2s_transfer(bus,direction,desc,buf,size,1000)==size,40);im_check(!(im_u32(desc)&0x80000000),41);if !direction{let k=0;while k<size{im_check(load8(buf+k)==((k*29+bus*47+0x59)&255),42);k=k+1;}}if round==0{size=256;}else{size=4088;if bits==16{size=4092;}}round=round+1;}
