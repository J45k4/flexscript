 let data=im_u32(desc+4);if !direction{im_check(im_get(base+im_v(11))==size/4,103);let n=size;if im_mode==4{n=size-4;}let i=0;while i<n{store8(data+i,(i*29+bus*47+0x59)&255);i=i+1;}head=(head&~(4095<<12))|(n<<12);}
