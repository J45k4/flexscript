fn im_v(n){return load64(im_ref+32+n*8);}
fn im_check(ok,id){im_checks=im_checks+1;if !ok{let p=alloc(16);store64(p,id);store64(p+8,im_checks);syscall(1,2,p,16,0,0,0);syscall(60,1,0,0,0,0,0);}return 0;}
fn im_index(address){let i=0;while i<im_count{if load64(im_regs+i*16)==address{return i;}i=i+1;}store64(im_regs+i*16,address);im_count=i+1;return i;}
