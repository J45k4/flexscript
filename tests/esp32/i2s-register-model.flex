fn im_read(path,size){let p=alloc(size);let fd=syscall(2,path,0,0,0,0,0);if fd<0 || syscall(0,fd,p,size,0,0,0)!=size{return 0;}syscall(3,fd,0,0,0,0,0);return p;}
