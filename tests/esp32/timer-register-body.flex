import "../../scripts/lib/host.flex";
global tm_meta=0;global tm_regs=0;global tm_count=0;global tm_checks=0;global tm_case=0;global tm_ops=0;global tm_stall=0;global tm_cycles=0;global tm_ram=0;
fn tm_check(ok,message){tm_checks=tm_checks+1;if !ok{h_print(2,h_cat3("Timer case ",h_int(tm_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn tm_m(i){return load64(tm_meta+i*8);}
fn tm_base(id){return tm_m(2+id/2)+(id&1)*tm_m(4);}
fn tm_index(address){let i=0;while i<tm_count{if load64(tm_regs+i*16)==address{return i;}i=i+1;}store64(tm_regs+i*16,address);tm_count=tm_count+1;return i;}
fn tm_get(address){return load64(tm_regs+tm_index(address)*16+8);}
fn tm_put(address,value){store64(tm_regs+tm_index(address)*16+8,value&0xffffffff);return 0;}
fn esp32_irq_save(){return 0;}
fn esp32_irq_restore(ps){return 0;}
fn esp32_cycles(){tm_cycles=(tm_cycles+400000)&0xffffffff;return tm_cycles;}
fn esp32_load32(address){tm_ops=tm_ops+1;if address>=tm_ram && address<tm_ram+4096{return load8(address)|(load8(address+1)<<8)|(load8(address+2)<<16)|(load8(address+3)<<24);}return tm_get(address);}
fn esp32_store32(address,value){tm_ops=tm_ops+1;value=value&0xffffffff;if address>=tm_ram && address<tm_ram+4096{let i=0;while i<4{store8(address+i,value>>(i*8));i=i+1;}return 0;}tm_put(address,value);let id=0;while id<4{let b=tm_base(id);if address==b+tm_m(10){tm_put(b+tm_m(5),tm_get(b+tm_m(8)));tm_put(b+tm_m(6),tm_get(b+tm_m(9))&tm_m(14));}if address==b+tm_m(7) && !tm_stall{tm_put(address,0);}id=id+1;}return 0;}
fn tm_words(buffer,lo,hi){tm_check(esp32_load32(buffer)==lo && esp32_load32(buffer+4)==hi,"packed32-bit output and full-word bit preservation");return 0;}
fn tm_invalid(id,buffer){let before=tm_ops;tm_check(esp_timer_set_words(id,-1,0)== -22 && esp_timer_set_words(id,0x100000000,0)== -22 && esp_timer_set_words(id,0,-1)== -22 && esp_timer_set_words(id,0,0x100000000)== -22,"invalid set words");tm_check(esp_timer_alarm_words(id,-1,0,0)== -22 && esp_timer_alarm_words(id,0x100000000,0,0)== -22 && esp_timer_alarm_words(id,0,-1,0)== -22 && esp_timer_alarm_words(id,0,0x100000000,0)== -22 && esp_timer_alarm_words(id,0,0,-1)== -22 && esp_timer_alarm_words(id,0,0,2)== -22,"invalid alarm words");tm_check(esp_timer_set(id,-1)== -22 && esp_timer_set(id,-110)== -22 && esp_timer_alarm(id,0,0)== -22 && esp_timer_alarm(id,-22,0)== -22 && esp_timer_alarm(id,1,2)== -22,"signed compatibility input errors");tm_check(esp_timer_read_words(id,buffer+1)== -22 && esp_timer_read_words(id,0)== -22 && esp_timer_read_words(id,tm_ram-4)== -22 && esp_timer_read_words(id,tm_end()-4)== -22,"invalid read buffers,alignment and final word bounds");tm_check(tm_ops==before,"invalid operations perform no MMIO or memory writes");return 0;}
fn main(argc,argv){h_environment(argc,argv);tm_check(argc==2,"C metadata and vectors required");tm_meta=h_read(load64(argv+8));tm_check(load64(tm_meta)==0x54494d4552570001 && tm_m(22)==23 && h_file_size==184+tm_m(21)*20,"C reference shape");tm_ram=tm_start();tm_check(syscall(9,tm_ram,4096,3,0x100022,-1,0)==tm_ram,"fixed safe DRAM test mapping");tm_regs=alloc(16384);let buffer=tm_ram+64;let id=0;while id<4{tm_invalid(id,buffer);let b=tm_base(id);tm_check(esp_timer_base(id)==b && esp_timer_init(id,80,0)==0,"all4 SDK-derived counter addresses");let row=0;while row<tm_m(21){tm_case=id*1600+row;let p=tm_meta+184+row*20;let lo=load8(p)|(load8(p+1)<<8)|(load8(p+2)<<16)|(load8(p+3)<<24);let hi=load8(p+4)|(load8(p+5)<<8)|(load8(p+6)<<16)|(load8(p+7)<<24);let ok=load8(p+8);let scalar=load8(p+12);let alarm=load8(p+16);let value=lo|(hi<<32);let before=tm_ops;let result=esp_timer_set_words(id,lo,hi);if ok{tm_check(result==0 && tm_get(b+tm_m(8))==lo && tm_get(b+tm_m(9))==hi && tm_get(b+tm_m(10))==1,"C full-width set vector and load pulse");esp32_store32(buffer-4,0xaabbccdd);esp32_store32(buffer+8,0x12345678);tm_check(esp_timer_read_words(id,buffer)==0,"successful read returns separate status");tm_words(buffer,lo,hi);tm_check(esp32_load32(buffer-4)==0xaabbccdd && esp32_load32(buffer+8)==0x12345678,"read destination guards intact");tm_check(esp_timer_read(id)==value,"legacy raw signed read includes errno-shaped values");}else{tm_check(result== -22 && tm_ops==before,"S3 high words rejected atomically");}before=tm_ops;result=esp_timer_set(id,value);tm_check((scalar && result==0) || (!scalar && result== -22 && tm_ops==before),"signed scalar setter accepts whole representable target range");before=tm_ops;result=esp_timer_alarm_words(id,lo,hi,row&1);if ok{tm_check(result==0 && tm_get(b+tm_m(11))==lo && tm_get(b+tm_m(12))==hi,"absolute alarm threshold preserves high bits,includingzero");tm_check((tm_get(b)&tm_m(17)) && ((tm_get(b)&tm_m(18))!=0)==((row&1)!=0) && (tm_get(tm_m(2+id/2)+tm_m(13))&(1<<(id&1))),"alarm/reload bits and per-timer group interrupt enable");}else{tm_check(result== -22 && tm_ops==before,"invalid alarm words have no MMIO side effects");}before=tm_ops;result=esp_timer_alarm(id,value,0);tm_check((alarm && result==0) || (!alarm && result== -22 && tm_ops==before),"signed alarm wrapper keeps zero/negative errors and expands original width");row=row+1;}
 // A failed capture must leave both destination words and guards unchanged.
 esp32_store32(buffer,0xdeadbeef);esp32_store32(buffer+4,0x89abcdef);tm_cycles=0xfff80000;tm_stall=1;tm_check(esp_timer_read_words(id,buffer)== -110,"snapshot timeout handles CCOUNT rollover");tm_words(buffer,0xdeadbeef,0x89abcdef);tm_stall=0;
 // Even if an S3 register bus reports reserved high bits,setters retain their
 // narrow contract and both reads mask the snapshot using the SDK width.
 tm_put(b+tm_m(5),0xabcdef12);tm_put(b+tm_m(6),0xffffffff);tm_check(esp_timer_read_words(id,buffer)==0,"reserved-bit read fixture");tm_words(buffer,0xabcdef12,tm_m(14));id=id+1;}
 let before=tm_ops;tm_check(esp_timer_set_words(-1,0,0)== -22 && esp_timer_set_words(4,0,0)== -22 && esp_timer_alarm_words(-1,0,0,0)== -22 && esp_timer_alarm_words(4,0,0,0)== -22 && esp_timer_read_words(-1,buffer)== -22 && esp_timer_read_words(4,buffer)== -22 && esp_timer_read(-1)== -22 && esp_timer_read(4)== -22 && esp_timer_set(4,0)== -22 && esp_timer_alarm(4,1,0)== -22,"all API families reject invalid IDs");tm_check(tm_ops==before,"invalid timer IDs never reach MMIO");syscall(11,tm_ram,4096,0,0,0,0);h_print(1,h_cat3("Timer adapter: ",h_int(tm_checks)," checks passed\n"));return 0;}
