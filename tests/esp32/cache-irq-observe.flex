// Independent GNU load/RSR validation with settling intervals per enable.
import "cache-access-body.flex";
fn cq_read(address){let value=esp32_load32(address);ci_check(value==esp32_call32(esp32_external("ci_ref_read"),address,0,0,0,0,0,0,0),4);return value;}
fn cq_pending(){let value=esp32_irq_pending()&2;let reference=esp32_call32(esp32_external("ci_ref_pending"),0,0,0,0,0,0,0,0)&2;ci_check(value==reference,5);return value;}
fn cq_state(){ci_line(" PRO0 ",cq_read(0x3ff003f0)&127);ci_line(" PRO3 ",cq_read(0x3ff003fc));ci_line(" APP0 ",cq_read(0x3ff00418)&127);ci_line(" APP3 ",cq_read(0x3ff00424));return 0;}
fn cq_scan(){let result=0;let bit=0;while bit<28{esp32_store32(0x3ff005a0,0);esp_delay_cycles(256);ci_check(cq_pending()==0,6);esp32_store32(0x3ff005a0,1<<bit);esp_delay_cycles(256);ci_check(cq_read(0x3ff005a0)==1<<bit,7);if cq_pending(){result=result|(1<<bit);}bit=bit+1;}esp32_store32(0x3ff005a0,0);esp_delay_cycles(256);ci_check(!cq_pending(),8);return result;}
fn main(){esp_uart_write("START: GNU cache IRQ observation\r\n");let ps=esp32_irq_save();esp32_irq_mask(0);esp32_store32(0x3ff00214,1);esp32_store32(0x3ff005a0,0);ci_disable();ci_flush();esp32_call32(0x400095a4,0,0,0,0,0,0,0,0);let pins=esp32_call32(0x40008658,0,0,0,0,0,0,0,0);esp32_call32(0x40062a6c,pins,0,0,0,0,0,0,0);ci_setup();ci_check(ci_hash(0x3f401234)==ci_expected() && ci_hash(0x400d1234)==ci_expected(),1);esp_uart_write("IRQ BASE");cq_state();ci_line(" ENABLES ",cq_scan());esp_uart_write("\r\n");
 let bus=0;while bus<2{ci_setup();ci_check(ci_hash(0x3f401234)==ci_expected() && ci_hash(0x400d1234)==ci_expected(),2);ci_disable();let address=0x3f401234;if bus{address=0x400d1234;}let value=esp32_load32(address);ci_check(value==0xbad00bad && cq_read(address)==value,3);ci_line("IRQ DISABLED BUS ",bus);cq_state();ci_line(" ENABLES ",cq_scan());ci_enable();ci_line(" AFTER ENABLE MASK ",cq_scan());esp_uart_write("\r\n");bus=bus+1;}
 esp32_store32(0x3ff005a0,0);esp32_store32(0x3ff00214,6);ci_disable();esp32_irq_restore(ps);esp_uart_write("PASS: GNU cache reads and5 settled28-bit IRQ scans\r\n");esp_uart_flush();return 0;}
