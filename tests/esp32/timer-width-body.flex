// Actual counter snapshots and short alarm distances at high absolute values.
// Use the same image in our emulator,QEMU,and original-chip RAM hardware.
global tw_seen=0;global tw_id=0;global tw_cases=0;global tw_alarms=0;
fn tw_check(ok,code){if !ok{esp_uart_write("TIMER FAIL ");esp_uart_hex(code);esp_uart_write(" ID ");esp_uart_hex(tw_id);esp_uart_write(" ALARMS ");esp_uart_hex(tw_alarms);esp_uart_write(" COUNT ");esp_uart_hex(esp_timer_read(tw_id));esp_uart_write(" CFG ");esp_uart_hex(esp32_load32(esp_timer_base(tw_id)));esp_uart_write(" RAW ");esp_uart_hex(esp_timer_pending(tw_id));esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn tw_low(i){if !i{return 0;}if i==1{return 1;}if i==2{return 0xffffffff;}if i==3{return 0xffffffea;}if i==4{return 0xffffff92;}if i==5{return 0x80000000;}if i==6{return 0x89abcdef;}return 0x12345678;}
fn tw_high(i){if !i{return 0;}if i==1{return 0xffffffff;}if i==2{return 0x7fffffff;}if i==3{return 0x003fffff;}if i==4{return 0x00400000;}return 1<<(i-5);}
fn tw_irq(source){if source==esp_timer_source(tw_id) && esp_timer_pending(tw_id)>0{esp_timer_ack(tw_id,0);tw_seen=tw_seen+1;}return 0;}
fn tw_alarm(id,lo,hi,data){let saved=esp32_irq_save();let low=lo-5000;let high=hi;if low<0{low=low+0x100000000;high=(high-1)&tw_mask();}esp_timer_stop(id);esp_timer_ack(id,0);tw_check(esp_timer_set_words(id,low,high)==0,100);tw_check(esp_timer_alarm_words(id,lo,hi,0)==0,101);tw_id=id;tw_seen=0;let begin=esp32_cycles();tw_check(esp_timer_start(id)==0,102);while !tw_seen{tw_check(((esp32_cycles()-begin)&0xffffffff)<10000000,103);esp32_wait();esp32_irq_save();}esp_timer_stop(id);tw_check(esp_timer_read_words(id,data)==0 && tw_seen==1 && !esp_timer_pending(id),104);let delta=(esp32_load32(data)| (esp32_load32(data+4)<<32))-(lo|(hi<<32));if tw_mask()!=0xffffffff{delta=delta&0x3fffffffffffff;}tw_check(delta>=0 && delta<100000,105);tw_alarms=tw_alarms+1;esp32_irq_restore(saved);return 0;}
fn main(){esp_uart_write("START: timer width\r\n");let data=alloc(16);let id=0;while id<4{tw_check(esp_timer_init(id,80,0)==0,1);let i=0;while i<37{let hi=tw_high(i);let j=0;while j<8{let lo=tw_low(j);if hi<=tw_mask(){tw_check(esp_timer_set_words(id,lo,hi)==0,10);tw_check(esp_timer_read_words(id,data)==0,11);tw_check(esp32_load32(data)==lo && esp32_load32(data+4)==hi,12);tw_check(esp_timer_read(id)==(lo|(hi<<32)),13);let v=lo|(hi<<32);if v>=0{tw_check(esp_timer_set(id,v)==0 && esp_timer_read(id)==v,14);}else{tw_check(esp_timer_set(id,v)== -22,15);}tw_check(esp_timer_alarm_words(id,lo,hi,j&1)==0,16);let base=esp_timer_base(id);tw_check(esp32_load32(base+16)==lo && esp32_load32(base+20)==hi,17);if v>0{tw_check(esp_timer_alarm(id,v,0)==0,18);}tw_cases=tw_cases+1;}else{tw_check(esp_timer_set_words(id,lo,hi)== -22 && esp_timer_alarm_words(id,lo,hi,0)== -22,19);}j=j+1;}i=i+1;}tw_check(esp_timer_set(id,-1)== -22 && esp_timer_alarm(id,0,0)== -22,20);tw_check(esp_timer_read_words(id,data+1)== -22 && esp_timer_read_words(id,0)== -22,21);tw_check(esp_timer_set_words(id,-1,0)== -22 && esp_timer_set_words(id,0,0x100000000)== -22,22);tw_check(esp_timer_alarm_words(id,0,0,2)== -22,23);tw_check(esp_irq_attach(esp_timer_source(id),esp32_callback(tw_irq))==0,24);let k=0;while k<8{let lo=0x100000;let hi=0;if k==1{lo=0;hi=1;}if k==2{hi=tw_mask();}if k==3{hi=(tw_mask()+1)/2;}if k==4{lo=0;hi=(tw_mask()+1)/2;}if k==5{lo=0;hi=0;}if k==6{hi=0x003fffff;}if k==7{lo=0xffffffff;hi=tw_mask();}tw_alarm(id,lo,hi,data);k=k+1;}tw_check(esp_irq_detach(esp_timer_source(id))==0,25);id=id+1;}esp_uart_write("PASS: timer width cases ");esp_uart_hex(tw_cases);esp_uart_write(" alarms ");esp_uart_hex(tw_alarms);esp_uart_write("\r\n");esp_uart_flush();return 0;}
