// Calls actual original-chip ROM instructions through the ordinary C bridge.
// Updating the ROM delay multiplier does not change the emulated CPU clock.
import "../../lib/platform/esp32.flex";
fn er_check(ok,code){if !ok{esp_uart_write("ROM SERVICE FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn main(){esp_uart_write("START: actual ROM services\r\n");er_check(esp32_load32(0x3ffae0c0)==0x3ffae0c4,1);er_check(esp32_load32(0x3ffae0c4+156)==0x40004168,2);let f=0;while f<4{let freq=40;if f==1{freq=80;}if f==2{freq=160;}if f==3{freq=240;}esp32_call32(esp32_external("ets_update_cpu_frequency_rom"),freq,0,0,0,0,0,0,0);er_check(esp32_load32(0x3ffe01e0)==freq,3);er_check(esp32_call32(esp32_external("ets_get_cpu_frequency"),0,0,0,0,0,0,0,0)==freq,4);let d=0;while d<4{let delay=0;if d==1{delay=1;}if d==2{delay=160;}if d==3{delay=1000;}let start=esp32_cycles();esp32_call32(esp32_external("ets_delay_us"),delay,0,0,0,0,0,0,0);er_check(((esp32_cycles()-start)&0xffffffff)>=delay*freq,5);d=d+1;}f=f+1;}esp32_call32(esp32_external("ets_update_cpu_frequency_rom"),80,0,0,0,0,0,0,0);er_check(esp32_load32(0x3ffe01e0)==80,6);esp_uart_write("PASS: actual ROM data and16 frequency/delay cases\r\n");esp_uart_flush();return 0;}
