// Constant matrix input; no GPIO output routing or external wiring required.
fn pd_base(bus){if pd_s3(){return 0x60024000+(bus-2)*4096;}return 0x3ff64000+(bus-2)*4096;}
fn pd_length(i){if i==0{return 1;}if i==1{return 7;}if i==2{return 8;}if i==3{return 9;}if i==4{return 15;}if i==5{return 16;}if i==6{return 17;}if i==7{return 24;}if i==8{return 31;}if i==9{return 32;}if i==10{return 33;}if i==11{return 63;}if i==12{return 64;}if i==13{return 65;}if i==14{return 255;}if i==15{return 256;}if i==16{return 257;}return 512;}
fn pd_word(i){return (0xa5963cc3^(i*0x01030507))&0xffffffff;}
fn pd_print(n){esp_uart_hex(n);esp_uart_putc(32);return 0;}
fn main(){let total=0;let bus=2;while bus<=3{let base=pd_base(bus);esp_clock_enable(0,6+(bus-2)*10);let user=28;let clock=24;let misc=52;let fifo=128;let matrix=0x3ff44130;let signal=9;if bus==3{signal=64;}if pd_s3(){user=16;clock=12;misc=32;fifo=152;matrix=0x60004154;signal=102;if bus==3{signal=67;}esp32_store32(base+232,7);esp32_store32(base+48,0);esp32_store32(base+224,0);}else{esp32_store32(base+20,0);esp32_store32(base+56,0);}esp32_store32(base+clock,(1<<18)|((40-1)<<12)|((20-1)<<6)|(40-1));let disabled=7;if pd_s3(){disabled=63;}esp32_store32(base+misc,disabled);esp32_store32(base+user+4,0);esp32_store32(base+user+8,0);let order=0;while order<2{let shift=25;if pd_s3(){shift=23;}esp32_store32(base+8,order<<shift);let high=0;while high<2{let constant=0;while constant<2{let input=48;if pd_s3(){input=60;}if constant{input=56;}esp32_store32(matrix+signal*4,128|input);let test=0;while test<18{let n=pd_length(test);if !high || n<=256{esp32_store32(base+user,(1<<28)|(high<<24));let i=0;while i<16{esp32_store32(base+fifo+i*4,pd_word(i));i=i+1;}let raw=56;let done=16;let usr=1<<18;if pd_s3(){raw=0;done=1<<24;usr=1<<24;esp32_store32(base+28,n-1);esp32_store32(base,1<<23);if esp_wait_mask(base,1<<23,0,1000000){return 1;}esp32_store32(base+56,4096);}else{esp32_store32(base+44,n-1);esp32_store32(base+56,0);}esp32_store32(base,usr);let expected=done;if pd_s3(){expected=0;}if esp_wait_mask(base+raw,done,expected,10000000){esp_uart_write("FIFO FAIL\r\n");esp_uart_flush();return 2;}let last=(high*8)+(n-1)/32;let next=last+1;if next>=16{next=0;}esp_uart_write("FIFO ");pd_print(bus);pd_print(order);pd_print(high);pd_print(constant);pd_print(n);pd_print(last);pd_print(esp32_load32(base+fifo));pd_print(esp32_load32(base+fifo+last*4));pd_print(esp32_load32(base+fifo+next*4));pd_print(esp32_load32(base+fifo+60));esp_uart_write("\r\n");total=total+1;}test=test+1;}constant=constant+1;}high=high+1;}order=order+1;}bus=bus+1;}if total!=272{return 3;}esp_uart_write("PASS: SPI FIFO padding capture272 cases\r\n");esp_uart_flush();return 0;}
