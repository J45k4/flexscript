// Fixed independent reference vectors: Python integers, Random(82032).
// Signed division truncates toward zero; results wrap modulo 2^64.
global word_checks=0;
fn vector_word(text) {
    let value=0;let i=0;while i<16 {let c=load8(text+i);let d=c-48;if c>=97 {d=c-87;}value=(value<<4)|d;i=i+1;}return value;
}
fn vector_op(a,b,op) {
    if op==0 {return a+b;}if op==1 {return a-b;}if op==2 {return a*b;}
    if op==3 {return a/b;}if op==4 {return a%b;}if op==5 {return a&b;}
    if op==6 {return a|b;}if op==7 {return a^b;}if op==8 {return a<<b;}
    if op==9 {return a>>b;}if op==10 {return a<b;}if op==11 {return a>b;}
    if op==12 {return a<=b;}if op==13 {return a>=b;}if op==14 {return a==b;}return a!=b;
}
fn word_vectors() {
    let table="";
    let row=0;while row<54 {
        let start=table+row*288;let a=vector_word(start);let b=vector_word(start+16);let op=0;
        while op<16 {
            if !((op==3 || op==4) && (!b || (a==(-9223372036854775807-1) && b== -1))) {
                let actual=vector_op(a,b,op);let expected=vector_word(start+32+op*16);
                if actual!=expected {return row*32+op+1;}word_checks=word_checks+1;
            }op=op+1;
        }row=row+1;
    }return 0;
}
