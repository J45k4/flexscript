import "../../lib/platform/esp32-radio-clock.flex";
fn ti_line(key,value){esp_uart_write(key);esp_uart_hex(value);return 0;}
fn ti_fail(code){ti_line("TIMIRQ FAIL ",code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();return 0;}
fn main(){let old=esp32_irq_save();esp32_irq_mask(0);if ti_clock()==160{esp_radio_clock_init();esp_radio_cpu160();}
ti_line("TIMIRQ START CLOCK ",ti_clock());ti_line(" SOURCE ",(esp32_load32(0x3ff48070)>>27)&3);ti_line(" PERIOD ",esp32_load32(0x3ff0003c)&3);ti_line(" DIV ",esp32_load32(0x3ff66000)&1023);ti_line(" ROMTICKS ",esp32_load32(0x3ffe01e0));esp_uart_write("\r\n");esp_uart_flush();
let state=alloc(256);let records=alloc(5120);if state<=0 || records<=0{ti_fail(1);}let row=0;let selector=0;while selector<10{let repeat=0;while repeat<2{let i=0;while i<64{esp32_store32(state+i*4,0);i=i+1;}if esp32_call32(esp32_external("ti_measure"),state,selector,0,0,0,0,0,0){ti_fail(2);}i=0;while i<64{esp32_store32(records+row*256+i*4,esp32_load32(state+i*4));i=i+1;}row=row+1;repeat=repeat+1;}selector=selector+1;}
if esp32_call32(esp32_external("ti_ready"),records,row,0,0,0,0,0,0){ti_fail(3);}row=0;while row<20{let p=records+row*256;ti_line("TIMIRQ CASE ",row/2);ti_line(" REPEAT ",row&1);
ti_line(" CC0 ",esp32_load32(p+0));
ti_line(" CCEND ",esp32_load32(p+4));
ti_line(" BEFOREPS ",esp32_load32(p+8));
ti_line(" AFTERPS ",esp32_load32(p+12));
ti_line(" PENDING ",esp32_load32(p+16));
ti_line(" INTEN ",esp32_load32(p+20));
ti_line(" COUNT ",esp32_load32(p+24));
ti_line(" VBASE ",esp32_load32(p+28));
ti_line(" TRIGGER ",esp32_load32(p+32));
ti_line(" RESUME ",esp32_load32(p+36));
ti_line(" MARKER ",esp32_load32(p+40));
ti_line(" PHASE ",esp32_load32(p+44));
ti_line(" CAUSE ",esp32_load32(p+48));
ti_line(" FINALCAUSE ",esp32_load32(p+52));
ti_line(" BASEPS ",esp32_load32(p+56));
ti_line(" SELECTOR ",esp32_load32(p+60));
ti_line(" E0_LEVEL ",esp32_load32(p+64));
ti_line(" E0_CC ",esp32_load32(p+68));
ti_line(" E0_PS ",esp32_load32(p+72));
ti_line(" E0_EPS ",esp32_load32(p+76));
ti_line(" E0_EPC ",esp32_load32(p+80));
ti_line(" E0_PENDING ",esp32_load32(p+84));
ti_line(" E0_INTEN ",esp32_load32(p+88));
ti_line(" E0_CAUSE ",esp32_load32(p+92));
ti_line(" E0_MARKER ",esp32_load32(p+96));
ti_line(" E0_VBASE ",esp32_load32(p+100));
ti_line(" E0_COMPARE ",esp32_load32(p+104));
ti_line(" E0_ACKPENDING ",esp32_load32(p+108));
ti_line(" E0_PHASE ",esp32_load32(p+112));
ti_line(" E0_NESTED ",esp32_load32(p+116));
ti_line(" E0_RETCC ",esp32_load32(p+120));
ti_line(" E0_TAG ",esp32_load32(p+124));
ti_line(" E1_LEVEL ",esp32_load32(p+128));
ti_line(" E1_CC ",esp32_load32(p+132));
ti_line(" E1_PS ",esp32_load32(p+136));
ti_line(" E1_EPS ",esp32_load32(p+140));
ti_line(" E1_EPC ",esp32_load32(p+144));
ti_line(" E1_PENDING ",esp32_load32(p+148));
ti_line(" E1_INTEN ",esp32_load32(p+152));
ti_line(" E1_CAUSE ",esp32_load32(p+156));
ti_line(" E1_MARKER ",esp32_load32(p+160));
ti_line(" E1_VBASE ",esp32_load32(p+164));
ti_line(" E1_COMPARE ",esp32_load32(p+168));
ti_line(" E1_ACKPENDING ",esp32_load32(p+172));
ti_line(" E1_PHASE ",esp32_load32(p+176));
ti_line(" E1_NESTED ",esp32_load32(p+180));
ti_line(" E1_RETCC ",esp32_load32(p+184));
ti_line(" E1_TAG ",esp32_load32(p+188));
ti_line(" E2_LEVEL ",esp32_load32(p+192));
ti_line(" E2_CC ",esp32_load32(p+196));
ti_line(" E2_PS ",esp32_load32(p+200));
ti_line(" E2_EPS ",esp32_load32(p+204));
ti_line(" E2_EPC ",esp32_load32(p+208));
ti_line(" E2_PENDING ",esp32_load32(p+212));
ti_line(" E2_INTEN ",esp32_load32(p+216));
ti_line(" E2_CAUSE ",esp32_load32(p+220));
ti_line(" E2_MARKER ",esp32_load32(p+224));
ti_line(" E2_VBASE ",esp32_load32(p+228));
ti_line(" E2_COMPARE ",esp32_load32(p+232));
ti_line(" E2_ACKPENDING ",esp32_load32(p+236));
ti_line(" E2_PHASE ",esp32_load32(p+240));
ti_line(" E2_NESTED ",esp32_load32(p+244));
ti_line(" E2_RETCC ",esp32_load32(p+248));
ti_line(" E2_TAG ",esp32_load32(p+252));
esp_uart_write("\r\n");row=row+1;}ti_line("TIMIRQ COMPLETE CLOCK ",ti_clock());esp_uart_write("\r\n");esp_uart_flush();esp32_irq_restore(old);return 0;}
