// Requires GPIO21 <-> GPIO19 jumper (MOSI -> MISO). GPIO23 is software CS.
// Radio SRAM layout supplies space for a64KiB in-place buffer below the stack.
import "../../lib/platform/esp32-spi.flex";
fn sc(ok,code){if !ok{esp_uart_write("SPI FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn spi_case(bus,tx,rx,n,seed){let i=0;while i<n{store8(tx+i,(i*31+seed)&255);if tx!=rx {store8(rx+i,0);}i=i+1;}esp_gpio_write(23,0);sc(esp_gpio_read(23)==0,1);let result=esp_spi_transfer(bus,tx,rx,n,2000000000);esp_gpio_write(23,1);sc(esp_gpio_read(23)==1,2);if result!=n{esp_uart_write("RESULT ");esp_uart_hex(result);esp_uart_write("\r\n");}sc(result==n,3);i=0;while i<n{if load8(rx+i)!=((i*31+seed)&255){esp_uart_write("BYTE ");esp_uart_hex(i);esp_uart_write(" ACTUAL ");esp_uart_hex(load8(rx+i));esp_uart_write("\r\n");}sc(load8(rx+i)==((i*31+seed)&255),4);i=i+1;}return 0;}
fn main(){esp_uart_write("WIRED SPI MATRIX PROBE\r\n");esp_gpio_write(23,1);esp_gpio_output(23);let tx=alloc(256);let rx=alloc(256);let total=0;let bus=2;while bus<=3{let mode=0;while mode<4{let step=0;let rate=100000;while step<4{let actual=esp_spi_init(bus,18,21,19,rate,mode);sc(actual>0 && actual<=rate,5);spi_case(bus,tx,rx,1,mode);spi_case(bus,tx,rx,63,mode+7);spi_case(bus,tx,rx,64,mode+13);spi_case(bus,tx,rx,65,mode+29);spi_case(bus,tx,rx,130,mode+31);total=total+5;sc(esp_spi_deinit(bus)==0,6);step=step+1;if step==1{rate=1000000;}else if step==2{rate=5000000;}else {rate=20000000;}}
 sc(esp_spi_init(bus,18,21,19,1000000,mode)==1000000,7);spi_case(bus,0x3ffc8000,0x3ffc8000,65536,mode+bus*17);total=total+1;
 esp_gpio_write(23,0);let timeout=esp_spi_transfer(bus,tx,rx,1,1);esp_gpio_write(23,1);sc(timeout== -110,8);spi_case(bus,tx,rx,130,mode+41);total=total+1;sc(esp_spi_deinit(bus)==0,9);esp_uart_write("SPI MATRIX PASS BUS ");esp_uart_hex(bus);esp_uart_write(" MODE ");esp_uart_hex(mode);esp_uart_write(" CASES ");esp_uart_hex(total);esp_uart_write("\r\n");mode=mode+1;}bus=bus+1;}
 sc(total==176,10);esp_gpio_input(23,0);esp_uart_write("PEER PASS\r\n");esp_uart_flush();return 0;}
