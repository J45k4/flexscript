// Native interrupt-path fixture for the emulator's explicit80MHz PLL profile.
// Raw register programming keeps this separate from the polling audio adapter.
import "../../lib/platform/esp32-irq.flex";
global ni_bus=0;global ni_seen=0;global ni_count=0;global ni_bad=0;global ni_cases=0;
fn ni_check(ok,code){if !ok{esp_uart_write("I2S IRQ FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn ni_irq(source){let base=0x3ff4f000+ni_bus*122880;let raw=esp32_load32(base+12);if source!=32+ni_bus || !(raw&0x1200) || (raw&0x6400){ni_bad=ni_bad+1;}ni_seen=ni_seen|(raw&0x1200);ni_count=ni_count+1;esp32_store32(base+24,0x1200);return 0;}
fn main(){let tx=alloc(264);let rx=alloc(256);let td=alloc(16);let rd=alloc(16);let bus=0;while bus<2{ni_bus=bus;let base=0x3ff4f000+bus*122880;let bit=4+bus*17;esp32_store32(0x3ff000c0,esp32_load32(0x3ff000c0)|(1<<bit));esp32_store32(0x3ff000c4,1<<bit);esp32_store32(0x3ff000c4,0);esp_gpio_route_output(22,23+bus);esp_gpio_route_output(4,25+bus);esp_gpio_route_output(21,163+bus*26);esp_gpio_open_drain(21,0);esp_gpio_input(25,0);esp_gpio_open_drain(25,0);esp_gpio_route_input(25,155+bus*26);ni_check(esp_irq_attach(32+bus,esp32_callback(ni_irq))==0,1);let bits=16;while bits<=32{let clock=20;while clock<=40{let choice=0;while choice<2{let frame=bits/4;let size=frame*2;if choice{size=128;}let bytes=size+frame;let i=0;while i<bytes{let value=0;if i>=frame{value=((i-frame)*37+bits*3+bus*19+clock)^0xa6;}store8(tx+i,value);i=i+1;}i=0;while i<size{store8(rx+i,0x55);i=i+1;}
 esp32_store32(base+8,15);esp32_store32(base+0x60,15);esp32_store32(base+8,0);esp32_store32(base+0x60,0x1140);esp32_store32(base+0xa0,0x188);esp32_store32(base+0xac,(1<<20)|(1<<14)|clock);esp32_store32(base+0xb0,4|(4<<6)|(bits<<12)|(bits<<18));let fifo=0x181820;if bits==32{fifo=fifo|(2<<13)|(2<<16);}esp32_store32(base+0x20,fifo);esp32_store32(base+0x2c,0);esp32_store32(base+0x1c,0);esp32_store32(base+0xa8,0);esp32_store32(base+0xb4,0);let conf=(1<<18)|(1<<11)|(1<<10)|128;if bits==16{conf=conf|(1<<17)|(1<<16);}esp32_store32(base+8,conf);
 esp32_store32(td+4,tx);esp32_store32(td+8,0);esp32_store32(td,0xc0000000|bytes|(bytes<<12));esp32_store32(rd+4,rx);esp32_store32(rd+8,0);esp32_store32(rd,0x80000000|size);esp32_store32(base+0x24,size/4);esp32_store32(base+24,0x1ffff);ni_seen=0;let previous=ni_count;esp32_store32(base+20,0x1200);esp32_store32(base+0x34,(rd&0xfffff)|(1<<29));esp32_store32(base+0x30,(td&0xfffff)|(1<<29));let ps=esp32_irq_save();esp32_store32(base+8,conf|48);while ni_seen!=0x1200 && !ni_bad{esp32_wait();esp32_irq_save();}esp32_irq_restore(ps);ni_check(!ni_bad && ni_seen==0x1200 && ni_count>previous,2);esp32_store32(base+20,0);esp32_store32(base+8,conf);esp32_store32(base+0x30,1<<28);esp32_store32(base+0x34,1<<28);ni_check(!(esp32_load32(td)&0x80000000) && !(esp32_load32(rd)&0x80000000) && ((esp32_load32(rd)>>12)&4095)==size,3);i=0;while i<size{ni_check(load8(rx+i)==load8(tx+frame+i),4);i=i+1;}ni_cases=ni_cases+1;choice=choice+1;}clock=clock+20;}bits=bits+16;}ni_check(esp_irq_detach(32+bus)==0,5);esp32_store32(0x3ff000c0,esp32_load32(0x3ff000c0)&~(1<<bit));bus=bus+1;}
 ni_check(ni_cases==16 && ni_count>=16 && ni_count<=32 && !ni_bad,6);esp_uart_write("PASS: I2S0/1,16 native WAITI completion pairs\r\n");esp_uart_flush();return 0;}
