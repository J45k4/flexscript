// Sustained full circular PCM matrix;common body is also used by recovery tests.
import "i2s-stream-body.flex";
fn main(){sr_step_entry=esp32_iram_callback(sr_step);esp_gpio_input(25,0);esp_gpio_output(21);esp_gpio_write(21,0);esp_delay_cycles(1000);sr_check(esp_gpio_read(25)==0,1);esp_gpio_write(21,1);esp_delay_cycles(1000);sr_check(esp_gpio_read(25)==1,2);esp_radio_clock_init();let n=4;let bytes=512;let tx=alloc(n*(bytes+32));let rx=alloc(n*(bytes+32));let td=alloc(n*16);let rd=alloc(n*16);let tb=alloc(n*8);let rb=alloc(n*8);let bus=0;while bus<2{sr_bus=bus;sr_check(esp_irq_attach(esp_i2s_source(bus),esp32_iram_callback(sr_handler))==0,19);let bits=16;while bits<=32{sr_bits=bits;sr_check(esp_i2s_init_duplex(bus,22,4,21,25,8000,bits)>0,20);sr_normal(tx,rx,td,rd,tb,rb,n,bytes,8);sr_check(esp_i2s_deinit(bus)==0,21);bits=bits+16;}sr_check(esp_irq_detach(esp_i2s_source(bus))==0,22);bus=bus+1;}sr_check(sr_done==4 && sr_irq>0 && sr_waits>0,23);esp_uart_write("PASS: I2S0/1 streams,4 PCM profiles,32 ring wraps,IRQ refill\r\n");esp_uart_flush();return 0;}
