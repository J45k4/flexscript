// Same GNU state-transfer image for native emulation,QEMU,and RAM hardware.
import "../../lib/platform/esp32.flex";
fn fs_fail(code){esp_uart_write("FPU FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();return 0;}
fn main(){esp_uart_write("START: GNU FPU state\r\n");let data=alloc(4096);let count=42;esp32_store32(data,count);let i=0;while i<count{let v=0;if i==1{v=0xffffffff;}if i>=2 && i<34{v=1<<(i-2);}if i==34{v=0x80000000;}if i==35{v=0x7f800000;}if i==36{v=0xff800000;}if i==37{v=0x7fc12345;}if i==38{v=0x7f812345;}if i==39{v=0x3f800000;}if i==40{v=0x12345678;}if i==41{v=0xabcdef01;}esp32_store32(data+4+i*4,v);i=i+1;}let ps=esp32_irq_save();if esp32_call32(esp32_external("c_fpu_state"),data,0,0,0,0,0,0,0)!=0{fs_fail(1);}esp32_irq_restore(ps);i=0;while i<count{esp_uart_write("STATE ");esp_uart_hex(esp32_load32(data+4+i*4));let r=0;while r<22{esp_uart_write(" ");esp_uart_hex(esp32_load32(data+192+i*88+r*4));r=r+1;}esp_uart_write("\r\n");i=i+1;}i=0;while i<6{let cause=esp32_load32(data+192+count*88+i*4);esp_uart_write("CPDIS ");esp_uart_hex(cause);esp_uart_write("\r\n");if cause!=32{fs_fail(10+i);}i=i+1;}esp_uart_write("PASS: GNU FPU state and6 disabled exceptions\r\n");esp_uart_flush();return 0;}
