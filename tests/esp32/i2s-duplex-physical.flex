// Both original I2S controllers, actual PCM through GPIO21-to-GPIO25.
import "../../lib/platform/esp32-i2s.flex";
import "../../lib/platform/esp32-radio-clock.flex";
global ix_cases=0;
fn ix_check(ok,code){if !ok{esp_uart_write("I2S EXCHANGE FAIL ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn main(){esp_gpio_input(25,0);esp_gpio_output(21);esp_gpio_open_drain(21,0);esp_gpio_write(21,0);esp_delay_cycles(1000);ix_check(esp_gpio_read(25)==0,1);esp_gpio_write(21,1);esp_delay_cycles(1000);ix_check(esp_gpio_read(25)==1,2);let boot_pll=(esp32_load32(0x3ff48070)&(3<<27))==(1<<27);let initial=esp_i2s_init_duplex(0,22,4,21,25,16000,16);if boot_pll{ix_check(initial>0,9);ix_check(esp_i2s_deinit(0)==0,10);}else{ix_check(initial== -19,9);}esp_radio_clock_init();
 let tx=alloc(4096);let rx=alloc(4096);let td=alloc(16);let rd=alloc(16);let workspace=alloc(4096);let bus=0;while bus<2{let bits=16;while bits<=32{let choice=0;while choice<4{let hz=8000;if choice==1{hz=44100;}if choice==2{hz=96000;}if choice==3{hz=192000;}let actual=esp_i2s_init_duplex(bus,22,4,21,25,hz,bits);ix_check(actual>0 && actual>=hz*99/100 && actual<=hz*101/100,3);let size=bits/4;let round=0;while round<4{let i=0;while i<size{store8(tx+i,((i*37+bits*3+bus*19+choice*7)^0xa6)&255);store8(rx+i,0x55);i=i+1;}
 let result=esp_i2s_exchange(bus,rd,rx,td,tx,size,workspace,16000000);esp_uart_write("EXCHANGE BUS ");esp_uart_hex(bus);esp_uart_write(" BITS ");esp_uart_hex(bits);esp_uart_write(" RATE ");esp_uart_hex(actual);esp_uart_write(" SIZE ");esp_uart_hex(size);esp_uart_write(" RESULT ");esp_uart_hex(result);esp_uart_write("\r\n");ix_check(result==size,4);i=0;while i<size{if load8(rx+i)!=load8(tx+i){esp_uart_write("MISMATCH AT ");esp_uart_hex(i);esp_uart_write(" RX ");esp_uart_hex(load8(rx+i));esp_uart_write(" TX ");esp_uart_hex(load8(tx+i));esp_uart_write("\r\n");}ix_check(load8(rx+i)==load8(tx+i),5);i=i+1;}ix_check(!(esp32_load32(rd)&0x80000000) && !(esp32_load32(td)&0x80000000),6);ix_cases=ix_cases+1;size=64;if round==1{size=512;}if round==2{size=4092-bits/4;if bits==32{size=4080;}}round=round+1;}ix_check(esp_i2s_deinit(bus)==0,7);choice=choice+1;}bits=bits+16;}bus=bus+1;}
 ix_check(ix_cases==64,8);esp_uart_write("PASS: I2S0/1 DMA,64 exact PCM exchanges,16/32-bit\r\n");esp_uart_flush();return 0;}
