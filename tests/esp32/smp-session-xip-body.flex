fn oc_report(case_number,step,byte,actual,expected) {esp_uart_write("SMP OWNER FAIL ");esp_uart_hex(case_number);esp_uart_hex(step);esp_uart_hex(byte);esp_uart_hex(actual);esp_uart_hex(expected);esp_uart_write("\r\n");return 0;}
fn main() {let r=oc_run(esp32_external("smp_owner_cases"),esp32_external("smp_owner_cases_size"));if r {esp_uart_write("SMP OWNER RETURN ");esp_uart_hex(r);esp_uart_write("\r\n");esp_uart_flush();return r;}esp_uart_write("PASS: SMP owner ");esp_uart_hex(oc_checks);esp_uart_write(" independent observations\r\n");esp_uart_flush();return 0;}
