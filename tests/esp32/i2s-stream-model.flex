// Independent host DMA scheduler. C/SDK register metadata and real Xtensa ABI
// descriptor vectors are external inputs; this does not import the CPU model.
import "../../lib/platform/esp32-i2s.flex";
import "../../scripts/lib/host.flex";
global is_heads=0;global ic_ref=0;global ic_abi=0;global ic_regs=0;global ic_count=0;global ic_checks=0;global ic_case=0;global ic_ps=0;global ic_ticks=0;global ic_writes=0;global ic_active=0;
fn ic_check(ok,message){ic_checks=ic_checks+1;if !ok{h_print(2,h_cat3("I2S stream case ",h_int(ic_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn ic_v(n){return load64(ic_ref+32+n*8);}
fn ic_u32(p){return load8(p)|(load8(p+1)<<8)|(load8(p+2)<<16)|(load8(p+3)<<24);}
fn ic_w32(p,v){let i=0;while i<4{store8(p+i,v>>(i*8));i=i+1;}return 0;}
fn ic_index(address){let i=0;while i<ic_count{if load64(ic_regs+i*16)==address{return i;}i=i+1;}store64(ic_regs+i*16,address);ic_count=i+1;return i;}
fn ic_get(a){return load64(ic_regs+ic_index(a)*16+8);}
fn ic_set(a,v){store64(ic_regs+ic_index(a)*16+8,v&0xffffffff);return 0;}
fn esp32_irq_save(){let ps=ic_ps;ic_ps=15;return ps;}
fn esp32_irq_restore(ps){ic_ps=ps;return 0;}
fn esp32_cycles(){ic_ticks=(ic_ticks+17)&0xffffffff;return ic_ticks;}
fn esp32_load32(a){if a>=0x3ffb0000 && a<0x3ffe0000{return ic_u32(a);}let b=0;while b<2{if a==ic_v(b)+0x10{return ic_get(ic_v(b)+ic_v(7))&ic_get(ic_v(b)+ic_v(8));}b=b+1;}return ic_get(a);}
fn esp32_store32(a,v){ic_writes=ic_writes+1;v=v&0xffffffff;if a>=0x3ffb0000 && a<0x3ffe0000{ic_w32(a,v);return 0;}ic_set(a,v);let bus=0;while bus<2{let base=ic_v(bus);if a==base+ic_v(9){ic_set(base+ic_v(7),ic_get(base+ic_v(7))&~v);}let d=0;while d<2{let bit=1<<(bus*2+d);if a==base+ic_v(14-d){if v&ic_v(29){ic_active=ic_active&~bit;}if v&ic_v(28){ic_active=ic_active|bit;store64(is_heads+(bus*2+d)*8,0x3ff00000|(v&0xfffff));}}if a==base+ic_v(15) && (v&ic_v(25-d)){ic_active=ic_active&~bit;}d=d+1;}bus=bus+1;}return 0;}
fn ic_table(table,count,offset){let i=0;while i<count{ic_w32(table+i*8,0x3ffb4000+i*256+offset);ic_w32(table+i*8+4,8*(1+i%31));i=i+1;}return 0;}
fn ic_return(desc,table,count,direction,mode){let i=0;while i<count{let head=ic_u32(desc+i*16);let size=ic_u32(table+i*8+4);head=head&0x7fffffff;if !direction{head=(head&~0xfff000)|(size<<12);}if mode==1 && i==count/2{head=head|0x80000000;}if mode==2 && !direction && i==count/2{head=(head&~0xfff000)|((size-4)<<12);}ic_w32(desc+i*16,head);i=i+1;}return 0;}
fn ic_released(desc,count){let i=0;while i<count{ic_check(!(ic_u32(desc+i*16)&0x80000000),"all descriptor owners returned on completion/error/cancel");i=i+1;}return 0;}

// Independent hardware walker uses only packed descriptors and MMIO links.
fn tick(bus,direction,count){let bit=1<<(bus*2+direction);let at=is_heads+(bus*2+direction)*8;let step=0;let base=ic_v(bus);while step<count && (ic_active&bit){let desc=load64(at);ic_check(desc>=0x3ffb0000 && desc<=0x3ffdfff0,"independent DMA descriptor is in bounded SRAM");let word=ic_u32(desc);if !(word&0x80000000){ic_set(base+ic_v(7),ic_get(base+ic_v(7))|(1<<(13+direction)));ic_active=ic_active&~bit;return 0;}let size=word&4095;ic_check(size==32,"independent uniform descriptor capacity");word=word&0x7fffffff;if !direction{word=(word&~0xfff000)|(size<<12)|0x40000000;}ic_w32(desc,word);ic_set(base+ic_v(7),ic_get(base+ic_v(7))|(1<<(9+direction*3)));store64(at,ic_u32(desc+8));step=step+1;}return 0;}
fn table(at,count,offset){let i=0;while i<count{ic_w32(at+i*8,0x3ffb4000+i*256+offset);ic_w32(at+i*8+4,32);i=i+1;}return 0;}
fn matrix(bus,direction,desc,blocks){let n=2;while n<=64{ic_case=bus*200+direction*100+n;table(blocks,n,0);ic_check(esp_i2s_stream_start(bus,direction,desc,blocks,n)==0,"circular stream starts");let i=0;while i<n{let reference=ic_abi+16+(direction*4096+(n-1)*64+i)*12;let byte=0;while byte<12{ic_check(load8(desc+i*16+byte)==load8(reference+byte),"every circular descriptor byte equals GNU ABI vector");byte=byte+1;}ic_check(ic_u32(desc+i*16+12)==0,"descriptor padding");i=i+1;}if !direction{ic_check(ic_get(ic_v(bus)+ic_v(11))==8,"RX generates EOF for each block in words");}ic_check(esp_i2s_stream_status(bus,direction)==1 && esp_i2s_stream_take(bus,direction)==0,"stream is running but DMA-owned data cannot be claimed");ic_check(esp_i2s_poll(bus,direction)== -16 && esp_i2s_wait(bus,direction,1)== -16 && esp_i2s_deinit(bus)== -16,"finite completion cannot consume a ring");let last=0;let step=0;while step<n*4{tick(bus,direction,1);let token=esp_i2s_stream_take(bus,direction);ic_check(token>last && ((token-1)&63)==step%n,"strict DMA order and monotonic unique lease");last=token;let index=step%n;ic_check(esp_i2s_stream_buffer(bus,direction,token)==0x3ffb4000+index*256 && esp_i2s_stream_bytes(bus,direction,token)==32,"lease getters expose only the completed copied block");ic_check(esp_i2s_stream_buffer(bus,direction,token+256)== -22 && esp_i2s_stream_release(bus,direction,token+256)== -22,"invented or stale generation cannot publish DMA ownership");ic_check(esp_i2s_stream_release(bus,direction,token)==0,"refill/reclaim returns ownership");ic_check(ic_u32(desc+index*16)&0x80000000,"release publishes owner");ic_check(esp_i2s_stream_release(bus,direction,token)== -22 && esp_i2s_stream_buffer(bus,direction,token)== -22,"consumed lease cannot be reused");step=step+1;}
 ic_check(esp_i2s_stream_counter(bus,direction,0)==n*4 && esp_i2s_stream_counter(bus,direction,1)==n*4,"exact progress after four complete wraps");tick(bus,direction,2);let first=esp_i2s_stream_take(bus,direction);let second=esp_i2s_stream_take(bus,direction);ic_check(first>last && second>first,"multiple completed blocks can be leased");ic_check(esp_i2s_stream_release(bus,direction,second)== -11 && !(ic_u32(desc+16)&0x80000000),"out-of-order release applies backpressure without touching ownership");ic_check(esp_i2s_stream_release(bus,direction,first)==0 && esp_i2s_stream_release(bus,direction,second)==0,"ordered refill recovers from backpressure");ic_check(esp_i2s_cancel(bus,direction)==0 && esp_i2s_stream_status(bus,direction)==0,"cancel stops stream");ic_released(desc,n);ic_check(esp_i2s_stream_buffer(bus,direction,first)== -22,"cancel invalidates all leases");n=n+1;}return 0;}
fn faults(bus,direction,desc,blocks){ic_case=1000+bus*2+direction;table(blocks,3,0);ic_check(esp_i2s_stream_start(bus,direction,desc,blocks,3)==0,"starvation fixture");tick(bus,direction,1);let old=esp_i2s_stream_take(bus,direction);ic_check(old>0,"completed block may be deliberately held by application");tick(bus,direction,3);let expected= -75;if direction{expected= -32;}ic_check(esp_i2s_stream_status(bus,direction)==expected,"unreclaimed ring reports RX overrun or TX underrun");ic_released(desc,3);ic_check(!(ic_active&(1<<(bus*2+direction))) && esp_i2s_stream_take(bus,direction)==expected,"error stops hardware and remains visible");ic_check(esp_i2s_stream_release(bus,direction,old)== -22,"error invalidates leases without republishing buffers");ic_check(esp_i2s_stream_counter(bus,direction,2)>0,"terminal faults are counted");ic_check(esp_i2s_stream_start(bus,direction,desc,blocks,3)==0,"same bounded pool restarts after starvation");tick(bus,direction,1);let next=esp_i2s_stream_take(bus,direction);ic_check(next>old && esp_i2s_stream_release(bus,direction,old)== -22,"restart never revives old tokens");ic_check(esp_i2s_stream_release(bus,direction,next)==0 && esp_i2s_cancel(bus,direction)==0,"recovered stream returns ownership");
 ic_check(esp_i2s_stream_start(bus,direction,desc,blocks,3)==0,"corruption fixture");tick(bus,direction,1);ic_w32(desc+8,0);ic_check(esp_i2s_stream_take(bus,direction)== -5,"broken circular topology is rejected before CPU claim");ic_released(desc,3);ic_check(esp_i2s_stream_start(bus,direction,desc,blocks,3)==0,"restart rebuilds descriptor topology");tick(bus,direction,1);if direction{ic_w32(desc,(ic_u32(desc)&~0xfff000)|(4<<12));}else{ic_w32(desc,(ic_u32(desc)&~0xfff000)|(28<<12));}ic_check(esp_i2s_stream_take(bus,direction)== -5,"short/mutated descriptor data is not reported as a whole block");ic_released(desc,3);return 0;}
fn edges(bus,desc,blocks){ic_case=2000+bus;table(blocks,3,0);let writes=ic_writes;ic_check(esp_i2s_stream_start(bus,0,desc,blocks,1)== -22 && esp_i2s_stream_start(bus,0,desc,blocks,65)== -22,"ring count is2..64");ic_check(esp_i2s_stream_start(bus,2,desc,blocks,3)== -22 && esp_i2s_stream_start(2,0,desc,blocks,3)== -22,"controller/direction bounds");ic_check(esp_i2s_stream_start(bus,0,desc+1,blocks,3)== -22 && esp_i2s_stream_start(bus,0,desc,blocks+1,3)== -22 && ic_writes==writes,"invalid workspace fails without MMIO writes");ic_w32(blocks+12,64);ic_check(esp_i2s_stream_start(bus,1,desc,blocks,3)== -22,"RX/TX blocks are uniform");table(blocks,3,0);ic_w32(blocks+8,ic_u32(blocks));ic_check(esp_i2s_stream_start(bus,1,desc,blocks,3)== -22,"mutable circular TX blocks cannot alias");table(blocks,3,0);ic_check(esp_i2s_stream_start(bus,0,desc,blocks,3)==0,"RX resource fixture");ic_w32(blocks,0x3ffbd000);let td=0x3ffb3000;let tb=0x3ffb3800;table(tb,3,32768);ic_w32(tb,0x3ffb4000);ic_check(esp_i2s_stream_start(bus,1,td,tb,3)== -22 && esp_i2s_submit(bus,1,td,0x3ffb4000,32)== -22,"peer overlap is checked against private copied buffers even if caller corrupts table");table(tb,3,32768);ic_check(esp_i2s_stream_start(bus,1,td,tb,3)==0,"disjoint simultaneous streams");tick(bus,1,1);let peer=esp_i2s_stream_take(bus,1);ic_check(peer>0 && esp_i2s_cancel(bus,0)==0 && eis_active(eia_state(bus),1),"RX cancellation preserves TX stream");ic_check(esp_i2s_stream_release(bus,1,peer)==0 && esp_i2s_cancel(bus,1)==0,"TX remains usable after opposite cancellation");return 0;}
fn dual(){ic_case=3000;ic_check(esp_i2s_init_duplex(0,22,4,21,25,48000,32)>0 && esp_i2s_init_duplex(1,22,4,21,25,48000,32)>0,"two-controller ring init");let d0=0x3ffb1000;let b0=0x3ffb2000;let d1=0x3ffb3000;let b1=0x3ffb3800;table(b0,3,0);table(b1,2,32768);ic_check(esp_i2s_stream_start(0,0,d0,b0,3)==0 && esp_i2s_stream_start(1,1,d1,b1,2)==0,"independent rings on both controllers");tick(1,1,1);let token=esp_i2s_stream_take(1,1);ic_check(token>0 && esp_i2s_cancel(0,0)==0 && esp_i2s_stream_status(1,1)==1,"controller0 cancellation preserves controller1");ic_check(esp_i2s_stream_release(1,1,token)==0 && esp_i2s_cancel(1,1)==0,"controller1 lease remains valid");ic_check(esp_i2s_deinit(0)==0 && esp_i2s_deinit(1)==0,"dual-controller cleanup");return 0;}
fn exhaustion(){ic_case=3100;ic_check(esp_i2s_init_duplex(0,22,4,21,25,48000,32)>0,"lease limit init");let desc=0x3ffb1000;let blocks=0x3ffb2000;table(blocks,2,0);ic_check(esp_i2s_stream_start(0,1,desc,blocks,2)==0,"lease limit stream");let p=eis_control(eia_state(0),1);let old=load64(p+8);store64(p+8,0x7ffffffffffffd);tick(0,1,1);let token=esp_i2s_stream_take(0,1);ic_check(token>0 && token<0x7fffffffffffffff,"last supported lease remains a positive signed word");ic_check(esp_i2s_stream_release(0,1,token)==0,"last lease returns ownership");tick(0,1,1);ic_check(esp_i2s_stream_take(0,1)== -75,"lease exhaustion stops before signed token overflow");ic_released(desc,2);let writes=ic_writes;ic_check(esp_i2s_stream_start(0,1,desc,blocks,2)== -75 && ic_writes==writes,"exhausted control cannot start new DMA");store64(p+8,old);ic_check(esp_i2s_deinit(0)==0,"lease limit cleanup");return 0;}
fn scoped_leases(){ic_case=3200;ic_check(esp_i2s_init_duplex(0,22,4,21,25,48000,32)>0 && esp_i2s_init_duplex(1,22,4,21,25,48000,32)>0,"fresh four-channel lease scope init");let tokens=alloc(32);let channel=0;while channel<4{let desc=0x3ffb1000+channel*2048;let blocks=0x3ffb3000+channel*256;table(blocks,2,channel*16384);ic_check(esp_i2s_stream_start(channel/2,channel&1,desc,blocks,2)==0,"four disjoint live rings");tick(channel/2,channel&1,1);let token=esp_i2s_stream_take(channel/2,channel&1);ic_check(token>0 && (((token-1)>>6)&3)==channel,"lease identifies its controller/direction");store64(tokens+channel*8,token);channel=channel+1;}
 channel=0;while channel<4{let other=0;while other<4{if other!=channel{ic_check(esp_i2s_stream_buffer(other/2,other&1,load64(tokens+channel*8))== -22 && esp_i2s_stream_release(other/2,other&1,load64(tokens+channel*8))== -22,"cross-channel token cannot expose or publish a different active block");}other=other+1;}ic_check(esp_i2s_stream_release(channel/2,channel&1,load64(tokens+channel*8))==0,"original scoped lease remains valid");ic_check(esp_i2s_cancel(channel/2,channel&1)==0,"scoped ring cancel");channel=channel+1;}ic_check(esp_i2s_deinit(0)==0 && esp_i2s_deinit(1)==0,"scoped lease cleanup");return 0;}
fn internal_ranges(){ic_case=3300;ic_check(esp_i2s_init_duplex(0,22,4,21,25,48000,32)>0,"internal protection init");let saved=esp_i2s_states;let state=0x3ffd0000;let pool=0x3ffd1000;let original=eis_control(eia_state(0),1);let i=0;while i<512{store8(state+i,load8(saved+i));i=i+1;}i=0;while i<2176{store8(pool+i,load8(original+i));i=i+1;}esp_i2s_states=state;store64(state+168,pool);let desc=0x3ffb1000;let blocks=0x3ffb2000;table(blocks,3,0);let writes=ic_writes;ic_check(esp_i2s_submit(0,1,pool,0x3ffb4000,32)== -22 && esp_i2s_submit(0,1,desc,pool,32)== -22 && ic_writes==writes,"single-buffer submit cannot overwrite retained stream metadata");ic_check(esp_i2s_submit_chain(0,1,pool,blocks,3)== -22 && esp_i2s_submit_chain(0,1,desc,pool,3)== -22 && ic_writes==writes,"finite chain cannot overwrite retained descriptors orblock metadata");ic_w32(blocks,pool);ic_check(esp_i2s_submit_chain(0,1,desc,blocks,3)== -22 && ic_writes==writes,"finite payload cannot alias private ring control");table(blocks,3,0);ic_check(esp_i2s_exchange(0,desc,0x3ffb4000,0x3ffb3000,0x3ffbc000,32,pool,1000)== -22 && ic_writes==writes,"exchange preflights private scratch alias before copying orstarting DMA");ic_check(load64(pool)==load64(original) && load64(pool+8)==load64(original+8),"private control survives rejected calls");esp_i2s_states=saved;ic_check(esp_i2s_deinit(0)==0,"internal protection cleanup");return 0;}
fn main(argc,argv){h_environment(argc,argv);ic_check(argc==3,"SDK and GNU ring vectors");ic_ref=h_read(load64(argv+8));ic_check(h_file_size==9664,"SDK metadata size");ic_abi=h_read(load64(argv+16));ic_check(h_file_size==98320 && ic_u32(ic_abi)==0x5354524d && ic_u32(ic_abi+4)==12,"GNU circular descriptor layout");ic_regs=alloc(65536);is_heads=alloc(32);ic_check(syscall(9,0x3ffb0000,196608,3,0x100022,-1,0)==0x3ffb0000,"bounded RAM fixture");ic_set(0x3ff48070,1<<27);scoped_leases();let desc=0x3ffb1000;let blocks=0x3ffb2000;let bus=0;while bus<2{ic_check(esp_i2s_init_duplex(bus,22,4,21,25,48000,32)>0,"duplex init");ic_check(esp_i2s_stream_interrupts(bus,1,1)==0,"stream IRQ enables EOF anderrors");let direction=0;while direction<2{matrix(bus,direction,desc,blocks);faults(bus,direction,desc,blocks);direction=direction+1;}edges(bus,desc,blocks);ic_check(esp_i2s_deinit(bus)==0 && !ic_active && ic_ps==0,"balanced IRQ state andcomplete cleanup");bus=bus+1;}dual();exhaustion();internal_ranges();h_print(1,h_cat3("I2S streams: ",h_int(ic_checks)," checks passed\n"));return 0;}
