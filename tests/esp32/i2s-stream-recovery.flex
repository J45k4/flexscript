// Real circular DMA starvation/cancel/restart. No external codec is required.
import "i2s-stream-body.flex";
global rc_faults=0;global rc_held=0;
fn rc_wait_take(direction){let start=esp32_cycles();let token=0;while !token{token=esp_i2s_stream_take(sr_bus,direction);sr_check(token>=0 && ((esp32_cycles()-start)&0xffffffff)<160000000,30);}return token;}
fn rc_owners(desc,n){let i=0;while i<n{sr_check(!(esp32_load32(desc+i*16)&0x80000000),31);i=i+1;}return 0;}
fn rc_tx(tx,rx,td,rd,tb,rb,n,bytes){sr_phase=1;sr_bad=0;sr_prepare(tx,rx,td,rd,tb,rb,n,bytes);let ps=esp32_irq_save();sr_check(esp_i2s_stream_interrupts(sr_bus,0,1)==0 && esp_i2s_stream_start(sr_bus,1,td,tb,n)==0,32);esp32_irq_restore(ps);let token=rc_wait_take(1);let start=esp32_cycles();let status=1;while status==1{status=esp_i2s_stream_status(sr_bus,1);sr_check(((esp32_cycles()-start)&0xffffffff)<160000000,33);}sr_check(status== -32 && esp_i2s_stream_take(sr_bus,1)== -32,34);sr_check(esp_i2s_stream_release(sr_bus,1,token)== -22,35);rc_owners(td,n);sr_check(esp_i2s_stream_counter(sr_bus,1,2)>0 && esp_i2s_stream_interrupts(sr_bus,0,0)==0,36);rc_faults=rc_faults+1;return 0;}
fn rc_rx(tx,rx,td,rd,tb,rb,n,bytes){sr_phase=2;sr_bad=0;sr_prepare(tx,rx,td,rd,tb,rb,n,bytes);let ps=esp32_irq_save();sr_check(esp_i2s_stream_interrupts(sr_bus,1,1)==0,37);sr_check(esp_i2s_stream_start(sr_bus,0,rd,rb,n)==0 && esp_i2s_stream_start(sr_bus,1,td,tb,n)==0,38);esp32_irq_restore(ps);let held=0;let held_buffer=0;let snapshot=alloc(bytes);sr_check(snapshot>0,51);let produced=0;let status=1;let start=esp32_cycles();while status==1{let token=esp_i2s_stream_take(sr_bus,1);sr_check(token>=0,39);if token>0{let p=esp_i2s_stream_buffer(sr_bus,1,token);sr_check(p>0,40);sr_fill(p,bytes,(n+produced)*bytes);sr_check(esp_i2s_stream_release(sr_bus,1,token)==0,41);produced=produced+1;}status=esp_i2s_stream_status(sr_bus,0);if !held && status==1{held=esp_i2s_stream_take(sr_bus,0);sr_check(held>=0,42);if held>0{held_buffer=esp_i2s_stream_buffer(sr_bus,0,held);sr_check(held_buffer>0,52);let at=0;while at<bytes{store64(snapshot+at,load64(held_buffer+at));at=at+8;}}}sr_check(((esp32_cycles()-start)&0xffffffff)<160000000,43);}
 sr_check(status== -75 && held>0,44);let at=0;while at<bytes{sr_check(load64(held_buffer+at)==load64(snapshot+at),53);at=at+8;}rc_held=rc_held+1;sr_check(esp_i2s_stream_release(sr_bus,0,held)== -22 && esp_i2s_stream_status(sr_bus,1)==1,45);rc_owners(rd,n);ps=esp32_irq_save();sr_check(esp_i2s_stream_interrupts(sr_bus,0,0)==0 && esp_i2s_cancel(sr_bus,1)==0,46);esp32_irq_restore(ps);rc_owners(td,n);rc_faults=rc_faults+1;return 0;}
fn main(){sr_step_entry=esp32_iram_callback(sr_step);esp_gpio_input(25,0);esp_gpio_output(21);esp_gpio_write(21,0);esp_delay_cycles(1000);sr_check(esp_gpio_read(25)==0,1);esp_gpio_write(21,1);esp_delay_cycles(1000);sr_check(esp_gpio_read(25)==1,2);esp_radio_clock_init();let n=4;let bytes=512;let tx=alloc(n*(bytes+32));let rx=alloc(n*(bytes+32));let td=alloc(n*16);let rd=alloc(n*16);let tb=alloc(n*8);let rb=alloc(n*8);let bus=0;while bus<2{sr_bus=bus;sr_check(esp_irq_attach(esp_i2s_source(bus),esp32_iram_callback(sr_handler))==0,19);let bits=16;while bits<=32{sr_bits=bits;sr_check(esp_i2s_init_duplex(bus,22,4,21,25,8000,bits)>0,20);rc_tx(tx,rx,td,rd,tb,rb,n,bytes);rc_rx(tx,rx,td,rd,tb,rb,n,bytes);sr_normal(tx,rx,td,rd,tb,rb,n,bytes,2);sr_check(esp_i2s_deinit(bus)==0,21);bits=bits+16;}sr_check(esp_irq_detach(esp_i2s_source(bus))==0,22);bus=bus+1;}sr_check(rc_faults==8 && rc_held==4 && sr_done==4,47);esp_uart_write("PASS: I2S rings,8 starvation faults,4 held RX blocks,4 PCM recoveries\r\n");esp_uart_flush();return 0;}
