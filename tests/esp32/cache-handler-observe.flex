// Original ESP32 RAM-only cache-error IRQ probe. Wrapper supplies ch_bus(),
// ch_mode() andch_word(page). Each image starts froma separateboard reset.
import "cache-access-body.flex";
import "../../lib/platform/esp32-irq.flex";
global ch_seen=0;global ch_source= -1;global ch_pc=0;
global ch_before0=0;global ch_before3=0;global ch_enable=0;
global ch_pending=0;global ch_after=0;global ch_after0=0;
fn ch_handler(source){let pc=esp32_irq_pc();ch_pc=pc;ch_source=source;ch_before0=esp32_load32(0x3ff003f0)&1;ch_before3=esp32_load32(0x3ff003fc)&0x4400;ch_enable=esp32_load32(0x3ff005a0);ch_pending=esp32_irq_pending()&2;if ch_mode()==2{esp32_store32(0x3ff00044,esp32_load32(0x3ff00044)|8192);}else{esp32_store32(0x3ff005a0,0);}esp_delay_cycles(256);ch_after=esp32_irq_pending()&2;ch_after0=esp32_load32(0x3ff003f0)&1;ch_seen=ch_seen+1;return 0;}
fn main(){let bus=ch_bus();let mode=ch_mode();ci_line("CACHE HANDLER START ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();let ps=esp32_irq_save();esp32_irq_mask(0);esp32_store32(0x3ff005a0,0);ci_disable();ci_flush();esp32_call32(0x400095a4,0,0,0,0,0,0,0,0);let pins=esp32_call32(0x40008658,0,0,0,0,0,0,0,0);esp32_call32(0x40062a6c,pins,0,0,0,0,0,0,0);ci_setup();ci_check(esp32_load32(0x3f401234)==ch_word(1) && esp32_load32(0x400d1234)==ch_word(1),1);ci_check(esp_irq_attach(68,esp32_callback(ch_handler))==0,2);let address=0x3f401234;let entry=0x3ff10000;let enable=1<<15;let mask=16;if bus{address=0x400d1234;entry=0x3ff10134;enable=1<<19;mask=1;}
 if mode==0{ci_disable();}if mode==1 || mode==2{ci_disable();esp32_store32(entry,256);ci_flush();ci_enable();enable=1<<21;}if mode==3{esp32_store32(0x3ff00044,esp32_load32(0x3ff00044)|mask);}esp32_store32(0x3ff005a0,enable);esp_delay_cycles(256);ci_check(!(esp32_irq_pending()&2) && !ch_seen,3);esp_irq_enable();let value=esp32_load32(address);let start=esp32_cycles();let wait=1000000;if mode==3{wait=65536;}while !ch_seen && ((esp32_cycles()-start)&0xffffffff)<wait{}esp32_irq_save();esp32_store32(0x3ff005a0,0);esp_delay_cycles(256);let live0=esp32_load32(0x3ff003f0)&1;let live3=esp32_load32(0x3ff003fc)&0x4400;let pending=esp32_irq_pending()&2;
 ci_line("CACHE HANDLER BUS ",bus);ci_line(" MODE ",mode);ci_line(" VALUE ",value);ci_line(" SEEN ",ch_seen);ci_line(" SOURCE ",ch_source);ci_line(" PRO0 ",ch_before0);ci_line(" PRO3 ",ch_before3);ci_line(" EN ",ch_enable);ci_line(" PENDING ",ch_pending);ci_line(" AFTER ",ch_after);ci_line(" MMUACK ",ch_after0);ci_line(" PC ",ch_pc);ci_line(" LIVE0 ",live0);ci_line(" LIVE3 ",live3);ci_line(" LIVEIRQ ",pending);esp_uart_write("\r\n");esp_uart_flush();
 let expected=0xbad00bad;if mode==1 || mode==2{expected=ch_word(0);}ci_check(value==expected,4);if mode==3{ci_check(ch_seen==0 && !live0 && !live3 && !pending,5);}else{ci_check(ch_seen==1 && ch_source==68 && ch_pc>=0x40080000 && ch_pc<0x400a0000 && ch_pending==2 && !ch_after && !pending && ch_enable==enable,6);let status=0;if mode==0{status=1<<(10+bus*4);}ci_check(ch_before0==(mode!=0) && ch_before3==status && live3==status,7);ci_check(ch_after0==(mode==1) && live0==(mode==1),8);}ci_check(esp_irq_detach(68)==0,9);ci_disable();esp32_irq_restore(ps);ci_line("CACHE HANDLER COMPLETE ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();return 0;}
