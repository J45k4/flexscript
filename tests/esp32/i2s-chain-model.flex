// Independent host DMA scheduler. C/SDK register metadata and real Xtensa ABI
// descriptor vectors are external inputs; this does not import the CPU model.
import "../../lib/platform/esp32-i2s.flex";
import "../../scripts/lib/host.flex";
global ic_ref=0;global ic_abi=0;global ic_regs=0;global ic_count=0;global ic_checks=0;global ic_case=0;global ic_ps=0;global ic_ticks=0;global ic_writes=0;global ic_active=0;
fn ic_check(ok,message){ic_checks=ic_checks+1;if !ok{h_print(2,h_cat3("I2S chain case ",h_int(ic_case),h_cat3(": ",message,"\n")));syscall(60,1,0,0,0,0,0);}return 0;}
fn ic_v(n){return load64(ic_ref+32+n*8);}
fn ic_u32(p){return load8(p)|(load8(p+1)<<8)|(load8(p+2)<<16)|(load8(p+3)<<24);}
fn ic_w32(p,v){let i=0;while i<4{store8(p+i,v>>(i*8));i=i+1;}return 0;}
fn ic_index(address){let i=0;while i<ic_count{if load64(ic_regs+i*16)==address{return i;}i=i+1;}store64(ic_regs+i*16,address);ic_count=i+1;return i;}
fn ic_get(a){return load64(ic_regs+ic_index(a)*16+8);}
fn ic_set(a,v){store64(ic_regs+ic_index(a)*16+8,v&0xffffffff);return 0;}
fn esp32_irq_save(){let ps=ic_ps;ic_ps=15;return ps;}
fn esp32_irq_restore(ps){ic_ps=ps;return 0;}
fn esp32_cycles(){ic_ticks=(ic_ticks+17)&0xffffffff;return ic_ticks;}
fn esp32_load32(a){if a>=0x3ffb0000 && a<0x3ffe0000{return ic_u32(a);}let b=0;while b<2{if a==ic_v(b)+0x10{return ic_get(ic_v(b)+ic_v(7))&ic_get(ic_v(b)+ic_v(8));}b=b+1;}return ic_get(a);}
fn esp32_store32(a,v){ic_writes=ic_writes+1;v=v&0xffffffff;if a>=0x3ffb0000 && a<0x3ffe0000{ic_w32(a,v);return 0;}ic_set(a,v);let bus=0;while bus<2{let base=ic_v(bus);if a==base+ic_v(9){ic_set(base+ic_v(7),ic_get(base+ic_v(7))&~v);}let d=0;while d<2{let bit=1<<(bus*2+d);if a==base+ic_v(14-d){if v&ic_v(29){ic_active=ic_active&~bit;}if v&ic_v(28){ic_active=ic_active|bit;}}if a==base+ic_v(15) && (v&ic_v(25-d)){ic_active=ic_active&~bit;}d=d+1;}bus=bus+1;}return 0;}
fn ic_table(table,count,offset){let i=0;while i<count{ic_w32(table+i*8,0x3ffb4000+i*256+offset);ic_w32(table+i*8+4,8*(1+i%31));i=i+1;}return 0;}
fn ic_return(desc,table,count,direction,mode){let i=0;while i<count{let head=ic_u32(desc+i*16);let size=ic_u32(table+i*8+4);head=head&0x7fffffff;if !direction{head=(head&~0xfff000)|(size<<12);}if mode==1 && i==count/2{head=head|0x80000000;}if mode==2 && !direction && i==count/2{head=(head&~0xfff000)|((size-4)<<12);}ic_w32(desc+i*16,head);i=i+1;}return 0;}
fn ic_released(desc,count){let i=0;while i<count{ic_check(!(ic_u32(desc+i*16)&0x80000000),"all descriptor owners returned on completion/error/cancel");i=i+1;}return 0;}
fn ic_edges(bus,desc,table){ic_case=1000+bus;ic_table(table,65,0);let writes=ic_writes;ic_check(esp_i2s_submit_chain(bus,0,desc,table,0)== -22 && esp_i2s_submit_chain(bus,0,desc,table,65)== -22,"bounded descriptor counts");ic_check(esp_i2s_submit_chain(bus,0,desc+1,table,2)== -22 && esp_i2s_submit_chain(bus,0,desc,table+1,2)== -22 && esp_i2s_submit_chain(bus,0,0,table,2)== -22 && esp_i2s_submit_chain(bus,0,desc,0,2)== -22,"alignment and full workspace/table bounds");ic_check(esp_i2s_submit_chain(bus,2,desc,table,2)== -22 && esp_i2s_submit_chain(2,0,desc,table,2)== -22,"invalid controller/direction");ic_check(esp_i2s_submit_chain(bus,0,desc,desc,2)== -22 && ic_writes==writes,"descriptor/table alias rejected without writes");ic_table(desc,1,0);ic_check(esp_i2s_submit_chain(bus,0,desc,desc,1)== -22 && ic_writes==writes,"valid metadata may not alias descriptor workspace");let bad=0;while bad<7{ic_table(table,2,0);if bad==0{ic_w32(table+4,0);}if bad==1{ic_w32(table+4,4096);}if bad==2{ic_w32(table+4,12);}if bad==3{ic_w32(table,0x3ffdfffc);ic_w32(table+4,8);}if bad==4{ic_w32(table,desc+16);}if bad==5{ic_w32(table,table+8);}if bad==6{ic_w32(table+8,ic_u32(table)+4);}writes=ic_writes;ic_check(esp_i2s_submit_chain(bus,0,desc,table,2)== -22 && ic_writes==writes,"bad payload,frame,bounds or overlapping RX blocks leave state untouched");bad=bad+1;}
 // Immutable TX may intentionally repeat one payload.
 ic_table(table,2,0);ic_w32(table+8,ic_u32(table));ic_check(esp_i2s_submit_chain(bus,1,desc,table,2)==0 && esp_i2s_cancel(bus,1)==0,"overlapping immutable TX blocks are supported");ic_table(table,2,0);ic_check(esp_i2s_submit_chain(bus,0,desc,table,2)==0,"active RX resource fixture");let td=0x3ffb3000;let tb=0x3ffb3800;ic_table(tb,3,32768);writes=ic_writes;ic_check(esp_i2s_submit(bus,1,desc+16,0x3ffbc000,32)== -22 && esp_i2s_submit(bus,1,td,0x3ffb4104,32)== -22,"single-buffer submissions see every active peer node and payload");ic_check(esp_i2s_submit_chain(bus,1,td,table,2)== -22,"new chain cannot overwrite active peer metadata");ic_w32(tb,desc+16);ic_check(esp_i2s_submit_chain(bus,1,td,tb,3)== -22 && ic_writes==writes,"new chain cannot overwrite active peer descriptors");ic_table(tb,3,32768);ic_check(esp_i2s_submit_chain(bus,1,td,tb,3)==0,"disjoint simultaneous RX/TX chains");let base=ic_v(bus);ic_set(base+ic_v(7),ic_v(30)|ic_v(31));ic_check(esp_i2s_cancel(bus,0)==0 && (ic_active&(1<<(bus*2+1))) && (ic_get(base+ic_v(7))&ic_v(30)),"cancel preserves opposite active DMA and IRQ flags");ic_released(desc,2);ic_check(ic_u32(td)&0x80000000,"peer descriptor ownership survives cancellation");ic_return(td,tb,3,1,0);ic_set(base+ic_v(21),ic_v(34));ic_check(esp_i2s_poll(bus,1)==48,"opposite chain completes normally after cancellation");writes=ic_writes;ic_check(esp_i2s_interrupts(bus,-1,0)== -22 && esp_i2s_interrupts(bus,0,2)== -22 && esp_i2s_ack(bus,-1)== -22 && esp_i2s_ack(bus,0x20000)== -22 && ic_writes==writes,"invalid interrupt inputs do not write MMIO");return 0;}
fn ic_dual_bus(){ic_case=1100;let d0=0x3ffb1000;let b0=0x3ffb2000;let d1=0x3ffb3000;let b1=0x3ffb3800;ic_check(esp_i2s_init_duplex(0,22,4,21,25,48000,32)>0,"independent controller0 init");ic_table(b0,3,0);ic_check(esp_i2s_submit_chain(0,0,d0,b0,3)==0,"controller0 remains active");ic_check(esp_i2s_init_duplex(1,22,4,21,25,48000,32)>0,"controller1 init preserves active controller0 state");ic_table(b1,2,32768);ic_check(esp_i2s_submit_chain(1,1,d1,b1,2)==0,"both controllers own independent chains");ic_check(load64(eia_state(0)+128)==3 && load64(eia_state(1)+136)==2 && ic_u32(d0)&0x80000000 && ic_u32(d1)&0x80000000,"independent metadata and owner bits on both controllers");ic_check(esp_i2s_cancel(0,0)==0 && (ic_active&8) && (ic_u32(d1)&0x80000000),"controller0 cancellation preserves controller1");ic_check(esp_i2s_cancel(1,1)==0 && esp_i2s_deinit(0)==0 && esp_i2s_deinit(1)==0,"dual-controller cleanup");return 0;}
fn main(argc,argv){h_environment(argc,argv);ic_check(argc==3,"SDK and Xtensa ABI vector files");ic_ref=h_read(load64(argv+8));ic_check(h_file_size==9664,"SDK metadata size");ic_abi=h_read(load64(argv+16));ic_check(h_file_size==98320 && ic_u32(ic_abi)==0x49433238 && ic_u32(ic_abi+4)==12 && ic_u32(ic_abi+8)==4 && ic_u32(ic_abi+12)==8,"32-bit GNU lldesc ABI");ic_regs=alloc(65536);ic_check(syscall(9,0x3ffb0000,196608,3,0x100022,-1,0)==0x3ffb0000,"bounded mapped DRAM");ic_set(0x3ff48070,1<<27);let desc=0x3ffb1000;let table=0x3ffb2000;let bus=0;while bus<2{ic_check(esp_i2s_init_duplex(bus,22,4,21,25,48000,32)>0,"duplex initialization");let base=ic_v(bus);let direction=0;while direction<2{let count=1;while count<=64{ic_case=bus*128+direction*64+count;ic_table(table,count,0);ic_check(esp_i2s_submit_chain(bus,direction,desc,table,count)==0,"submit finite chain");let total=0;let i=0;while i<count{let expected=ic_abi+16+(direction*4096+(count-1)*64+i)*12;let j=0;while j<12{ic_check(load8(desc+i*16+j)==load8(expected+j),"every descriptor byte equals GNU C ABI vector");j=j+1;}ic_check(ic_u32(desc+i*16+12)==0,"descriptor slot padding remainszero");total=total+ic_u32(table+i*8+4);i=i+1;}ic_check(load64(eia_state(bus)+72+direction*16)==total,"whole-chain byte count");if !direction{ic_check(ic_get(base+ic_v(11))==total/4,"RX EOF covers the full chain");}ic_check(esp_i2s_poll(bus,direction)==0,"nonblocking poll does not consume pending DMA");let writes=ic_writes;ic_check(esp_i2s_submit_chain(bus,direction,desc,table,count)== -16 && ic_writes==writes,"busy submission preserves active descriptors");ic_return(desc,table,count,direction,0);ic_set(base+ic_v(7),ic_get(base+ic_v(7))|ic_v(31-direction));if direction{ic_set(base+ic_v(21),0);ic_check(esp_i2s_poll(bus,direction)==0,"TX waits for physical shift idle");ic_set(base+ic_v(21),ic_v(34));}ic_check(esp_i2s_poll(bus,direction)==total,"whole chain completes once");ic_released(desc,count);ic_check(esp_i2s_poll(bus,direction)== -22 && !(ic_active&(1<<(bus*2+direction))),"completed chain cannot be consumed twice");ic_check(!load64(eia_state(bus)+128+direction*8) && !load64(eia_state(bus)+144+direction*8),"metadata ownership cleared");
 let fault=0;while fault<4{ic_check(esp_i2s_submit_chain(bus,direction,desc,table,count)==0,"resubmit after terminal state");let result= -5;if fault==0{ic_check(esp_i2s_cancel(bus,direction)==0 && esp_i2s_cancel(bus,direction)==0,"cancel is idempotent");}else if fault==1{ic_set(base+ic_v(7),ic_get(base+ic_v(7))|ic_v(33-direction));ic_check(esp_i2s_poll(bus,direction)== -5,"descriptor error returns errno");}else if fault==2{ic_return(desc,table,count,direction,1);ic_set(base+ic_v(7),ic_get(base+ic_v(7))|ic_v(31-direction));if direction{ic_set(base+ic_v(21),ic_v(34));}ic_check(esp_i2s_poll(bus,direction)== -5,"any owned middle node rejects premature completion");}else{ic_ticks=0xfffffff0;ic_check(esp_i2s_wait(bus,direction,100)== -110,"whole-chain wait timeout and CCOUNT rollover");}ic_released(desc,count);ic_check(!load64(eia_state(bus)+8),"terminal outcome releases direction");fault=fault+1;}
 if !direction{ic_check(esp_i2s_submit_chain(bus,direction,desc,table,count)==0,"short RX fixture");ic_return(desc,table,count,direction,2);ic_set(base+ic_v(7),ic_get(base+ic_v(7))|ic_v(31));ic_check(esp_i2s_poll(bus,direction)== -5,"short middle RX descriptor is an error");ic_released(desc,count);}count=count+1;}direction=direction+1;}
 ic_check(esp_i2s_interrupts(bus,1,1)==0 && ic_get(base+ic_v(8))==(ic_v(30)|ic_v(31)|ic_v(32)|ic_v(33)|(1<<10)),"DMA EOF/error IRQ masks");ic_set(base+ic_v(7),ic_v(30)|ic_v(31));ic_check(esp_i2s_pending(bus)==(ic_v(30)|ic_v(31)),"masked pending status");ic_check(esp_i2s_ack(bus,ic_v(30))==0 && esp_i2s_pending(bus)==ic_v(31),"ack preserves opposite direction");ic_check(esp_i2s_ack(bus,ic_v(31))==0 && esp_i2s_pending(bus)==0,"all selected status acknowledged");ic_check(esp_i2s_interrupts(bus,0,0)==0,"disable interrupts");ic_edges(bus,desc,table);ic_check(esp_i2s_deinit(bus)==0 && ic_ps==0,"release peripheral and restore PS");bus=bus+1;}ic_dual_bus();h_print(1,h_cat3("I2S finite chains: ",h_int(ic_checks)," checks passed\n"));return 0;}
