// RAM-only IRQ restart observation withan independentGNU load andraw AR save.
// Wrapper supplies cr_bus(),cr_mode(),cr_word(page).
import "cache-access-body.flex";
fn main(){let bus=cr_bus();let mode=cr_mode();ci_line("CACHE RESTART START ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();let ps=esp32_irq_save();esp32_irq_mask(0);esp32_store32(0x3ff005a0,0);ci_disable();ci_flush();esp32_call32(0x400095a4,0,0,0,0,0,0,0,0);let pins=esp32_call32(0x40008658,0,0,0,0,0,0,0,0);esp32_call32(0x40062a6c,pins,0,0,0,0,0,0,0);ci_setup();ci_check(esp32_load32(0x3f401234)==cr_word(1) && esp32_load32(0x400d1234)==cr_word(1),1);let address=0x3f401234;let entry=0x3ff10000;let enable=1<<15;let mask=16;if bus{address=0x400d1234;entry=0x3ff10134;enable=1<<19;mask=1;}if mode==0{ci_disable();}if mode==1 || mode==2{ci_disable();esp32_store32(entry,256);ci_flush();ci_enable();enable=1<<21;}if mode==3{esp32_store32(0x3ff00044,esp32_load32(0x3ff00044)|mask);}let state=alloc(256);ci_check(state>0,2);let i=0;while i<256{esp32_store32(state+i,0);i=i+4;}esp32_store32(state+148,mode);esp32_store32(0x3ff00214,1);let value=esp32_call32(esp32_external("cr_run"),address,state,enable,0,0,0,0,0);esp32_irq_save();esp32_store32(0x3ff005a0,0);esp32_store32(0x3ff00214,6);let count=esp32_load32(state);let before0=esp32_load32(state+20)&1;let before3=esp32_load32(state+24)&0x4400;let after0=esp32_load32(state+36)&1;
 ci_line("CACHE RESTART BUS ",bus);ci_line(" MODE ",mode);ci_line(" VALUE ",value);ci_line(" SEEN ",count);ci_line(" PC ",esp32_load32(state+4));ci_line(" BARRIER ",esp32_load32(state+44));ci_line(" LOAD ",esp32_load32(state+48));ci_line(" NEXT ",esp32_load32(state+52));ci_line(" TAIL ",esp32_load32(state+56));ci_line(" AR8 ",esp32_load32(state+96));ci_line(" AR9 ",esp32_load32(state+100));ci_line(" FINAL9 ",esp32_load32(state+132));ci_line(" CAUSE ",esp32_load32(state+8));ci_line(" PRO0 ",before0);ci_line(" PRO3 ",before3);ci_line(" EN ",esp32_load32(state+28));ci_line(" PENDING ",esp32_load32(state+16));ci_line(" AFTER ",esp32_load32(state+32));ci_line(" MMUACK ",after0);esp_uart_write("\r\n");esp_uart_flush();let expected=0xbad00bad;if mode==1 || mode==2{expected=cr_word(0);}ci_check(value==expected && esp32_load32(state+128)==expected && esp32_load32(state+132)==2 && esp32_load32(state+136)==1,3);if mode==3{ci_check(!count && !esp32_load32(state+4),4);}else{ci_check(count==1 && esp32_load32(state+8)==4 && esp32_load32(state+16)==2 && !esp32_load32(state+32),5);ci_check(esp32_load32(state+72)==address && esp32_load32(state+76)==state && esp32_load32(state+164)==0x13579bdf,6);ci_check(before0==(mode!=0) && before3==((mode==0)*(1<<(10+bus*4))) && after0==(mode==1),7);}ci_disable();esp32_irq_restore(ps);ci_line("CACHE RESTART COMPLETE ",bus);ci_line(" MODE ",mode);esp_uart_write("\r\n");esp_uart_flush();return 0;}
