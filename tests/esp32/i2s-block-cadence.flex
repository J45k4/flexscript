// Independent transfer cadence around raw DMA start;no per-sample CPU work.
import "../../lib/platform/esp32-i2s.flex";
import "../../lib/platform/esp32-radio-clock.flex";
import "../../lib/platform/esp32-xip.flex";
global cd_bus=0;global cd_bits=0;global cd_bytes=0;global cd_cases=0;
fn cd_check(ok,code){if !ok{esp_uart_write("I2S CADENCE FAIL ");esp_uart_hex(code);esp_uart_write(" BUS ");esp_uart_hex(cd_bus);esp_uart_write(" BITS ");esp_uart_hex(cd_bits);esp_uart_write(" BYTES ");esp_uart_hex(cd_bytes);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn main(){esp_radio_clock_init();cd_check((esp32_load32(0x3ff0003c)&3)==0 && (esp32_load32(0x3ff48070)&(3<<27))==(1<<27),1);let tx=alloc(4096);let rx=alloc(4096);let td=alloc(16);let rd=alloc(16);let i=0;while i<4096{store8(tx+i,0);store8(rx+i,0x55);i=i+1;}let bus=0;while bus<2{cd_bus=bus;let bits=16;while bits<=32{cd_bits=bits;let bytes=512;while bytes<=2048{cd_bytes=bytes;cd_check(esp_i2s_init_duplex(bus,22,4,21,25,8000,bits)>0,2);let base=esp_i2s_base(bus);let frame=bits>>2;let expected=(80000000*((bytes/frame)+1))/8000;cd_check(esp_dma_descriptor(td,tx,bytes+frame,bytes+frame,0,1)==0 && esp_dma_descriptor(rd,rx,bytes,0,0,1)==0,3);esp32_store32(base+0x24,bytes>>2);esp32_store32(base+0x18,0x1ffff);esp32_store32(base+0x34,(rd&0xfffff)|(1<<29));esp32_store32(base+0x30,(td&0xfffff)|(1<<29));let conf=esp32_load32(base+8);let ps=esp32_irq_save();let start=esp32_cycles();esp32_store32(base+8,conf|48);while !(esp32_load32(base+12)&512){if ((esp32_cycles()-start)&0xffffffff)>=160000000{cd_check(0,4);}}let elapsed=(esp32_cycles()-start)&0xffffffff;esp32_store32(base+8,conf);esp32_store32(base+0x30,1<<28);esp32_store32(base+0x34,1<<28);esp32_irq_restore(ps);cd_check(!(esp32_load32(rd)&0x80000000) && ((esp32_load32(rd)>>12)&4095)==bytes,5);if elapsed<expected*95/100 || elapsed>expected*105/100{esp_uart_write("CADENCE CYCLES ");esp_uart_hex(elapsed);esp_uart_write(" EXPECTED ");esp_uart_hex(expected);esp_uart_write("\r\n");cd_check(0,6);}cd_check(esp_i2s_deinit(bus)==0,7);cd_cases=cd_cases+1;bytes=bytes*2;}bits=bits+16;}bus=bus+1;}cd_check(cd_cases==12,8);esp_uart_write("PASS: I2S cadence,12 raw transfers at80MHz/8kHz\r\n");esp_uart_flush();return 0;}
