// Sustained original-chip PCM through the confirmed GPIO21-to-GPIO25 jumper.
// Explicit cached target:full driver/IRQ code is larger than128KiB RAM-only.
import "../../lib/platform/esp32-i2s.flex";
import "../../lib/platform/esp32-irq.flex";
import "../../lib/platform/esp32-radio-clock.flex";
import "../../lib/platform/esp32-xip.flex";
global sr_step_entry=0;global sr_work_max=0;global sr_waits=0;global sr_bus=0;global sr_irq=0;global sr_phase=0;global sr_bad=0;global sr_bits=0;global sr_rx=0;global sr_tx=0;global sr_done=0;
fn sr_check(ok,code){if !ok{esp_uart_write("I2S STREAM FAIL ");esp_uart_hex(code);esp_uart_write(" BUS ");esp_uart_hex(sr_bus);esp_uart_write(" BITS ");esp_uart_hex(sr_bits);esp_uart_write(" PHASE ");esp_uart_hex(sr_phase);esp_uart_write(" RX ");esp_uart_hex(sr_rx);esp_uart_write(" TX ");esp_uart_hex(sr_tx);esp_uart_write(" BAD ");esp_uart_hex(sr_bad);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn sr_handler(source){if source!=esp_i2s_source(sr_bus){return 0;}sr_irq=sr_irq+1;let rx=esp_i2s_stream_status(sr_bus,0);let tx=esp_i2s_stream_status(sr_bus,1);if sr_phase==0 && (rx<0 || tx<0){sr_bad=1;}return 0;}
fn sr_byte(at){return ((at*37+(at>>8)*19+sr_bits*3+sr_bus*47)^0xa6)&255;}
// Eight-byte comparisons still check every PCM bit; only CPU test overhead
// changes. The canonical physical fixture uses512-byte aligned blocks.
fn sr_fill(p,n,at){sr_check(!(n&7),48);let seed=sr_bits*3+sr_bus*47;let i=0;while i<n{let word=(at+i)>>2;let lo=((word*2654435761)^((word>>7)*73244475)^seed)&0xffffffff;word=word+1;let hi=((word*2654435761)^((word>>7)*73244475)^seed)&0xffffffff;store64(p+i,lo|(hi<<32));i=i+8;}return 0;}

fn sr_prepare(tx,rx,td,rd,tb,rb,n,bytes){let i=0;while i<n{esp32_store32(tb+i*8,tx+i*(bytes+32)+16);esp32_store32(tb+i*8+4,bytes);esp32_store32(rb+i*8,rx+i*(bytes+32)+16);esp32_store32(rb+i*8+4,bytes);let j=0;while j<bytes+32{store8(tx+i*(bytes+32)+j,0x5a);store8(rx+i*(bytes+32)+j,0x5a);j=j+1;}sr_fill(tx+i*(bytes+32)+16,bytes,i*bytes);i=i+1;}return 0;}
// Entire bounded service closure lives in IRAM;cached helpers alone miss
// the steady16/8ms block deadlines on the original80MHz board.
fn sr_step(context){let seed=sr_bits*3+sr_bus*47;let bytes=load64(context);let n=load64(context+8);let rd=load64(context+16);let work_start=esp32_cycles();let progress=0;let token=esp_i2s_stream_take(sr_bus,1);sr_check(token>=0,6);if token>0{let buffer=esp_i2s_stream_buffer(sr_bus,1,token);sr_check(buffer>0 && esp_i2s_stream_bytes(sr_bus,1,token)==bytes,7);sr_fill(buffer,bytes,(n+sr_tx)*bytes);sr_check(esp_i2s_stream_release(sr_bus,1,token)==0,8);sr_tx=sr_tx+1;progress=1;}
 token=esp_i2s_stream_take(sr_bus,0);sr_check(token>=0,9);if token>0{let buffer=esp_i2s_stream_buffer(sr_bus,0,token);sr_check(buffer>0 && esp_i2s_stream_bytes(sr_bus,0,token)==bytes,10);let expected_at=sr_rx*bytes+(sr_bits>>2);let i=0;while i<bytes{let word=(expected_at+i)>>2;let lo=((word*2654435761)^((word>>7)*73244475)^seed)&0xffffffff;word=word+1;let hi=((word*2654435761)^((word>>7)*73244475)^seed)&0xffffffff;let expected=lo|(hi<<32);if load64(buffer+i)!=expected{esp_uart_write("STREAM MISMATCH BYTE ");esp_uart_hex(i);esp_uart_write("\r\n");sr_check(0,11);}i=i+8;}i=0;while i<16{if load8(buffer-16+i)!=0x5a || load8(buffer+bytes+i)!=0x5a{sr_check(0,12);}i=i+1;}let released=esp_i2s_stream_release(sr_bus,0,token);if released{esp_uart_write("SERVICE CYCLES ");esp_uart_hex((esp32_cycles()-work_start)&0xffffffff);esp_uart_write(" RX RELEASE ");esp_uart_hex(released);esp_uart_write(" RAW ");esp_uart_hex(esp32_load32(esp_i2s_base(sr_bus)+12));esp_uart_write(" DESC ");esp_uart_hex(esp32_load32(rd));esp_uart_write("\r\n");}sr_check(released==0,13);sr_rx=sr_rx+1;progress=1;}
 let worked=(esp32_cycles()-work_start)&0xffffffff;if worked>sr_work_max{sr_work_max=worked;}if worked>=load64(context+24){esp_uart_write("SERVICE BUDGET ");esp_uart_hex(worked);esp_uart_write(" LIMIT ");esp_uart_hex(load64(context+24));esp_uart_write("\r\n");sr_check(0,49);}return progress;}
fn sr_normal(tx,rx,td,rd,tb,rb,n,bytes,rounds){sr_phase=0;sr_bad=0;sr_rx=0;sr_tx=0;let irq_start=sr_irq;let wait_start=sr_waits;sr_work_max=0;let context=alloc(32);sr_check(context>0 && sr_step_entry>0,50);store64(context,bytes);store64(context+8,n);store64(context+16,rd);store64(context+24,(80000000*bytes)/(8000*(sr_bits>>2)));sr_prepare(tx,rx,td,rd,tb,rb,n,bytes);let ps=esp32_irq_save();sr_check(esp_i2s_stream_interrupts(sr_bus,1,1)==0,3);sr_check(esp_i2s_stream_start(sr_bus,0,rd,rb,n)==0,4);sr_check(esp_i2s_stream_start(sr_bus,1,td,tb,n)==0,5);esp32_irq_restore(ps);let start=esp32_cycles();let goal=n*rounds;
 while sr_rx<goal{ps=esp32_irq_save();let progress=esp32_call(sr_step_entry,context);sr_check(!sr_bad && ((esp32_cycles()-start)&0xffffffff)<160000000,14);if !progress{sr_waits=sr_waits+1;esp32_wait();}esp32_irq_restore(ps);}
 ps=esp32_irq_save();sr_check(esp_i2s_stream_interrupts(sr_bus,0,0)==0,15);sr_check(esp_i2s_cancel(sr_bus,0)==0 && esp_i2s_cancel(sr_bus,1)==0,16);esp32_irq_restore(ps);sr_check(esp_i2s_stream_counter(sr_bus,0,0)==goal && esp_i2s_stream_counter(sr_bus,0,1)==goal,17);let i=0;while i<n{sr_check(!(esp32_load32(rd+i*16)&0x80000000) && !(esp32_load32(td+i*16)&0x80000000),18);i=i+1;}sr_check(sr_irq>irq_start && sr_waits>wait_start,24);sr_done=sr_done+1;esp_uart_write("STREAM PROFILE PASS ");esp_uart_hex(sr_bus);esp_uart_write(" ");esp_uart_hex(sr_bits);esp_uart_write("\r\n");return 0;}
