// Original I2S0/1 DMA chains through the confirmed GPIO21-to-GPIO25 jumper.
import "../../lib/platform/esp32-i2s.flex";
import "../../lib/platform/esp32-irq.flex";
import "../../lib/platform/esp32-radio-clock.flex";
global ch_bus=0;global ch_rx=0;global ch_tx=0;global ch_bad=0;global ch_calls=0;global ch_cases=0;
fn ch_check(ok,code){if !ok{esp_uart_write("I2S CHAIN FAIL ");esp_uart_hex(code);esp_uart_write(" BUS ");esp_uart_hex(ch_bus);esp_uart_write(" CASES ");esp_uart_hex(ch_cases);esp_uart_write(" RX ");esp_uart_hex(ch_rx);esp_uart_write(" TX ");esp_uart_hex(ch_tx);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn ch_irq(source){if source!=esp_i2s_source(ch_bus) || esp_i2s_pending(ch_bus)<=0{return 0;}ch_calls=ch_calls+1;if !ch_rx{let n=esp_i2s_poll(ch_bus,0);if n{ch_rx=n;}}if !ch_tx{let n=esp_i2s_poll(ch_bus,1);if n{ch_tx=n;}}if ch_rx<0 || ch_tx<0{ch_bad=1;esp_i2s_interrupts(ch_bus,0,0);}return 0;}
fn ch_count(i){if i==0{return 1;}if i==1{return 2;}if i==2{return 3;}if i==3{return 7;}if i==4{return 15;}if i==5{return 31;}return 63;}
fn main(){esp_gpio_input(25,0);esp_gpio_output(21);esp_gpio_open_drain(21,0);esp_gpio_write(21,0);esp_delay_cycles(1000);ch_check(esp_gpio_read(25)==0,1);esp_gpio_write(21,1);esp_delay_cycles(1000);ch_check(esp_gpio_read(25)==1,2);esp_radio_clock_init();let tx=alloc(8192);let rx=alloc(8192);let td=alloc(1024);let rd=alloc(1024);let tb=alloc(512);let rb=alloc(512);let bus=0;while bus<2{ch_bus=bus;ch_check(esp_irq_attach(esp_i2s_source(bus),esp32_callback(ch_irq))==0,3);let bits=16;while bits<=32{let frame=bits/4;let rate=16000;if bits==32{rate=96000;}ch_check(esp_i2s_init_duplex(bus,22,4,21,25,rate,bits)>0,4);let choice=0;while choice<7{let count=ch_count(choice);let total=0;let i=0;while i<frame{store8(tx+i,0);i=i+1;}esp32_store32(tb,tx);esp32_store32(tb+4,frame);i=0;while i<count{let size=(1+i%15)*frame;esp32_store32(tb+(i+1)*8,tx+frame+i*128);esp32_store32(tb+(i+1)*8+4,size);esp32_store32(rb+i*8,rx+i*128);esp32_store32(rb+i*8+4,size);let j=0;while j<128{store8(rx+i*128+j,0x55);if j<size{store8(tx+frame+i*128+j,((total+j)*37+bits*3+bus*19+choice*7)^0xa6);}j=j+1;}total=total+size;i=i+1;}
 let ps=esp32_irq_save();ch_rx=0;ch_tx=0;ch_bad=0;ch_check(esp_i2s_interrupts(bus,1,1)==0,5);ch_check(esp_i2s_submit_chain(bus,0,rd,rb,count)==0,6);ch_check(esp_i2s_submit_chain(bus,1,td,tb,count+1)==0,7);while (!ch_rx || !ch_tx) && !ch_bad{esp32_wait();esp32_irq_save();}esp_i2s_interrupts(bus,0,0);esp32_irq_restore(ps);ch_check(!ch_bad && ch_rx==total && ch_tx==total+frame,8);i=0;while i<count{let size=esp32_load32(rb+i*8+4);let j=0;while j<size{if load8(rx+i*128+j)!=load8(tx+frame+i*128+j){esp_uart_write("MISMATCH NODE ");esp_uart_hex(i);esp_uart_write(" BYTE ");esp_uart_hex(j);esp_uart_write("\r\n");}ch_check(load8(rx+i*128+j)==load8(tx+frame+i*128+j),9);j=j+1;}j=size;while j<128{ch_check(load8(rx+i*128+j)==0x55,10);j=j+1;}ch_check(!(esp32_load32(rd+i*16)&0x80000000) && !(esp32_load32(td+i*16)&0x80000000),11);i=i+1;}ch_check(!(esp32_load32(td+count*16)&0x80000000),12);ch_cases=ch_cases+1;choice=choice+1;}ch_check(esp_i2s_deinit(bus)==0,13);bits=bits+16;}ch_check(esp_irq_detach(esp_i2s_source(bus))==0,14);bus=bus+1;}ch_check(ch_cases==28 && ch_calls>=28,15);esp_uart_write("PASS: I2S chains,28 exact PCM cases and IRQ completion\r\n");esp_uart_flush();return 0;}
