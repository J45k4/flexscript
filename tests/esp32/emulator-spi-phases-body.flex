// Register-only phase probe; MISO is routed to the matrix constant-one input.
// No external peripheral or jumper change is needed. SPI0/1 stay untouched.
global pp_seen=0;
global pp_bad=0;
global pp_bus=2;
global pp_case=0;
fn pp_base(bus){if ph_s3(){return 0x60024000+(bus-2)*4096;}return 0x3ff64000+(bus-2)*4096;}
fn pp_user(){if ph_s3(){return 16;}return 28;}
fn pp_fifo(){if ph_s3(){return 152;}return 128;}
fn pp_source(bus){if ph_s3(){return 19+bus;}return 28+bus;}
fn pp_ack(base){if ph_s3(){esp32_store32(base+56,4096);}else{esp32_store32(base+56,512);}return 0;}
fn pp_irq(source){let base=pp_base(pp_bus);let offset=56;let done=16;if ph_s3(){offset=60;done=4096;}if source!=pp_source(pp_bus) || !(esp32_load32(base+offset)&done){pp_bad=pp_bad+1;}else{pp_ack(base);pp_seen=pp_seen+1;}return 0;}
fn pp_check(ok,code){if !ok{esp_uart_write("PHASE FAIL CASE ");esp_uart_hex(pp_case);esp_uart_write(" CODE ");esp_uart_hex(code);esp_uart_write("\r\n");esp_uart_flush();esp32_halt();}return 0;}
fn pp_reset(bus){let clock=0x3ff000c0;let reset=0x3ff000c4;if ph_s3(){clock=0x600c0018;reset=0x600c0020;}let bit=1<<(6+(bus-2)*10);esp_reg_update(clock,bit,bit);esp_reg_update(reset,bit,bit);esp_reg_update(reset,bit,0);return 0;}
fn pp_reset_words(bus){let base=pp_base(bus);let user=pp_user();pp_reset(bus);let ctrl=0x0020a400;let uv=0x80000040;let u1=0x5c000007;let u2=0x70000000;let clock=24;let misc=52;let mv=30;let slave=56;let sv=512;if ph_s3(){ctrl=0x003c0000;uv=0x800000c0;u1=0xb8410007;u2=0x78000000;clock=12;misc=32;mv=62;slave=224;sv=0x02800000;}
 esp_uart_write("RESET WORDS ");esp_uart_hex(bus);esp_uart_write(" ");esp_uart_hex(esp32_load32(base+8));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+user));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+user+4));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+user+8));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+clock));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+misc));esp_uart_write(" ");esp_uart_hex(esp32_load32(base+slave));if !ph_s3(){esp_uart_write(" ");esp_uart_hex(esp32_load32(base+20));}esp_uart_write("\r\n");esp_uart_flush();
 // Named fields are independently assembled with SDK C bitfields. PIN[4:3]
 // are reserved in the SDK but read1 after reset on the verified rev3 chip.
 pp_check(esp32_load32(base+8)==ctrl,1);pp_check(esp32_load32(base+user)==uv,2);pp_check(esp32_load32(base+user+4)==u1,3);pp_check(esp32_load32(base+user+8)==u2,4);pp_check(esp32_load32(base+clock)==0x80003043,5);pp_check(esp32_load32(base+misc)==mv,6);pp_check(esp32_load32(base+slave)==sv,7);if !ph_s3(){esp32_store32(base+misc,0);esp_uart_write("PIN WRITE0 ");esp_uart_hex(esp32_load32(base+misc));esp32_store32(base+misc,24);esp_uart_write(" WRITE18 ");esp_uart_hex(esp32_load32(base+misc));esp_uart_write("\r\n");esp32_store32(base+misc,mv);}if !ph_s3(){pp_check(esp32_load32(base+20)==0x11,8);}else{pp_check(esp32_load32(base+232)==0,8);}return 0;}
fn pp_swap32(x){return ((x>>24)&255)|((x>>8)&65280)|((x<<8)&16711680)|((x<<24)&4278190080);}
fn pp_pack(base,cmd,cmdlen,address,addrlen,lsb){let command=cmd;if !lsb && cmdlen{command=pp_swap32(cmd<<(32-cmdlen));}let u2=command&65535;if cmdlen{u2=u2|((cmdlen-1)<<28);}esp32_store32(base+pp_user()+8,u2);
 if addrlen{let high=0;let low=0;if lsb{if ph_s3(){high=pp_swap32(address);}else{high=pp_swap32(address);low=pp_swap32(address>>32);}}else{if addrlen>32{high=address>>(addrlen-32);low=address<<(64-addrlen);}else{high=address<<(32-addrlen);}}esp32_store32(base+4,high);if !ph_s3(){esp32_store32(base+48,low);}}return 0;}
fn pp_transaction(bus,mode,lsb,scenario){let base=pp_base(bus);let command=0;let address=0;let dummy=0;let tx=0;let rx=0;let half=1;let idle=0;let setup=2;let hold=3;
 if scenario==0{command=9;}if scenario==1{command=8;address=32;dummy=8;rx=17;}if scenario==2{command=3;address=8;tx=9;rx=17;}if scenario==3{command=2;address=7;tx=17;rx=17;half=0;setup=0;}if scenario==4{dummy=1;idle=1;}if scenario==5{command=16;address=64;if ph_s3(){address=32;}}if scenario==6{dummy=256;rx=512;}if scenario==7{command=1;address=1;tx=511;}if ph_s3() && tx && rx{rx=tx;}
 let user=!half;let edge=7;let clock=24;let misc=52;let setupbit=32;let holdbit=16;let addrshift=26;let txshift=26;let rxshift=25;let disabled=6;if ph_s3(){edge=9;clock=12;misc=32;setupbit=128;holdbit=64;addrshift=27;txshift=25;rxshift=23;disabled=62;esp32_store32(base+232,7);esp32_store32(base+48,0);}
 let divider=(1<<18)|((40-1)<<12)|((20-1)<<6)|(40-1);esp32_store32(base+clock,divider);esp32_store32(base+8,(lsb<<txshift)|(lsb<<rxshift));esp32_store32(base+misc,disabled|((mode>>1)<<29));if ((mode&1)^(mode>>1)){user=user|(1<<edge);}if command{user=user|(1<<31);}if address{user=user|(1<<30);}if dummy{user=user|(1<<29);}if tx{user=user|(1<<27);}if rx{user=user|(1<<28);}if idle{user=user|(1<<26);}if setup{user=user|setupbit;}if hold{user=user|holdbit;}
 let u1=0;if address{u1=(address-1)<<addrshift;}if dummy{u1=u1|(dummy-1);}if ph_s3(){u1=u1|((setup-1)<<17)|(hold<<22);if !setup{u1=u1&~(31<<17);}}else{esp32_store32(base+20,(setup-1)|(hold<<4));if !setup{esp32_store32(base+20,hold<<4);}}
 esp32_store32(base+pp_user(),user);esp32_store32(base+pp_user()+4,u1);pp_pack(base,0x96a5,command,0x9a5c371e24b5d0f1,address,lsb);let length=tx;if !length{length=rx;}if !length{length=1;}if ph_s3(){esp32_store32(base+28,length-1);}else{esp32_store32(base+40,length-1);let rlen=rx;if !rlen{rlen=1;}esp32_store32(base+44,rlen-1);}
 let i=0;while i<16{let word=0;if !i{word=0x00563cc3;}esp32_store32(base+pp_fifo()+i*4,word);i=i+1;}if ph_s3(){esp32_store32(base,1<<23);pp_check(esp_wait_mask(base,1<<23,0,1000000)==0,9);}let old=pp_seen;let ps=esp32_irq_save();pp_ack(base);if ph_s3(){esp32_store32(base+52,4096);}let usr=1<<18;if ph_s3(){usr=1<<24;}esp32_store32(base,usr);while pp_seen==old{esp32_wait();esp32_irq_save();}esp32_irq_restore(ps);pp_check(pp_seen==old+1 && !pp_bad,10);pp_check(esp32_load32(base)==0,11);
 i=0;while i<64{let original=0;if i<3{original=(0x00563cc3>>(i*8))&255;}let want=original;if !ph_s3() && i<(rx+7)/8{want=0;}let n=rx-i*8;if n>8{n=8;}if n>0{let mask=(1<<n)-1;if !lsb{mask=mask<<(8-n);}want=want|mask;}let actual=(esp32_load32(base+pp_fifo()+(i/4)*4)>>((i&3)*8))&255;if actual!=want{esp_uart_write("RX BYTE ");esp_uart_hex(i);esp_uart_write(" ACTUAL ");esp_uart_hex(actual);esp_uart_write(" EXPECTED ");esp_uart_hex(want);esp_uart_write(" WORD ");esp_uart_hex(esp32_load32(base+pp_fifo()+(i/4)*4));esp_uart_write("\r\n");}pp_check(actual==want,12);i=i+1;}return 0;}
fn main(){let bus=2;while bus<=3{pp_bus=bus;pp_reset_words(bus);let clk=8;let mosi=10;let miso=9;let cs=11;let inputs=0x3ff44130;if bus==3{clk=63;mosi=65;miso=64;cs=68;}if ph_s3(){inputs=0x60004154;clk=101;mosi=103;miso=102;cs=110;if bus==3{clk=66;mosi=68;miso=67;cs=71;}}
 esp_gpio_route_output(18,clk);esp_gpio_route_output(21,mosi);esp_gpio_route_output(4,cs);esp32_store32(inputs+miso*4,128|56);pp_check(esp_irq_attach(pp_source(bus),esp32_callback(pp_irq))==0,13);let mode=0;while mode<4{let order=0;while order<2{let scenario=0;while scenario<8{esp_uart_write("PHASE CASE ");esp_uart_hex(pp_case);esp_uart_write("\r\n");pp_transaction(bus,mode,order,scenario);pp_case=pp_case+1;scenario=scenario+1;}order=order+1;}mode=mode+1;}esp_irq_detach(pp_source(bus));pp_reset(bus);esp_gpio_input(18,0);esp_gpio_input(21,0);esp_gpio_input(4,0);bus=bus+1;}
 pp_check(pp_seen==128 && pp_case==128 && !pp_bad,14);esp_uart_write("PASS: SPI phase/reset probe,128 completion callbacks\r\n");esp_uart_flush();return 0;}
