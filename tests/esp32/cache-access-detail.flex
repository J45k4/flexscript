// Second independent silicon observation:read-only MMU bit8/page selection,
// sticky cache flags andwhich enable bits expose them as source68 pending.
import "cache-access-body.flex";
fn ci_scan(){let found=0;let bit=0;while bit<28{esp32_store32(0x3ff005a0,0);esp_delay_cycles(256);esp32_store32(0x3ff005a0,1<<bit);esp_delay_cycles(256);if esp32_irq_pending()&2{found=found|(1<<bit);}bit=bit+1;}esp32_store32(0x3ff005a0,0);esp_delay_cycles(256);return found;}
fn main(){esp_uart_write("START: RAM-only cache detail\r\n");let ps=esp32_irq_save();esp32_irq_mask(0);esp32_store32(0x3ff00214,1);esp32_store32(0x3ff005a0,0);ci_disable();ci_flush();esp32_call32(0x400095a4,0,0,0,0,0,0,0,0);let pins=esp32_call32(0x40008658,0,0,0,0,0,0,0,0);esp32_call32(0x40062a6c,pins,0,0,0,0,0,0,0);ci_setup();ci_check(ci_hash(0x3f401234)==ci_expected(),1);
 let bus=0;while bus<2{let address=0x3f401234;let entry=0x3ff10000;if bus{address=0x400d1234;entry=0x3ff10134;}let invalid=0;while invalid<2{let page=0;while page<3{ci_setup();ci_line("PRIME BUS ",bus);ci_line(" ENTRY ",page+invalid*256);esp_uart_write("\r\n");esp_uart_flush();ci_check(ci_hash(address)==ci_expected(),3);ci_disable();esp32_store32(entry,page+invalid*256);ci_flush();ci_enable();ci_line("DETAIL BEGIN BUS ",bus);ci_line(" ENTRY ",page+invalid*256);ci_line(" BEFORE0 ",esp32_load32(0x3ff003f0)&127);esp_uart_write("\r\n");esp_uart_flush();let got=esp32_load32(address);ci_check(got==ci_page_word(page),2);ci_line("MMU DETAIL BUS ",bus);ci_line(" ENTRY ",page+invalid*256);ci_line(" PAGE WORD OK ",1);ci_line(" DBG0 ",esp32_load32(0x3ff003f0)&127);ci_line(" DBG3 ",esp32_load32(0x3ff003fc)&0xfe00);esp_uart_write("\r\n");page=page+1;}invalid=invalid+1;}
 ci_setup();ci_line("CLEAR BEFORE0 ",esp32_load32(0x3ff003f0)&127);let cfg=esp32_load32(0x3ff00044);esp32_store32(0x3ff00044,cfg|8192);esp32_store32(0x3ff00044,cfg&~8192);ci_line(" AFTER0 ",esp32_load32(0x3ff003f0)&127);esp_uart_write("\r\n");ci_disable();let value=esp32_load32(address);ci_line("DISABLED BUS ",bus);ci_line(" VALUE ",value);ci_line(" CTRL ",esp32_load32(0x3ff00040));ci_line(" CFG ",esp32_load32(0x3ff00044));ci_line(" DBG0 ",esp32_load32(0x3ff003f0)&127);ci_line(" DBG3 ",esp32_load32(0x3ff003fc)&0xfe00);ci_line(" ENABLES ",ci_scan());ci_line(" PENDING OFF ",esp32_irq_pending()&2);ci_enable();ci_line(" AFTER ENABLE3 ",esp32_load32(0x3ff003fc)&0xfe00);ci_line(" AFTER ENABLE MASK ",ci_scan());esp_uart_write("\r\n");bus=bus+1;}
 esp32_store32(0x3ff005a0,0);esp32_store32(0x3ff00214,6);ci_disable();esp32_irq_restore(ps);esp_uart_write("PASS: cache detail,12 page words and28-bit enable scans\r\n");esp_uart_flush();return 0;}
