import "cad/author.flex";
import "cad/project-access.flex";

import "cad/project-access.flex";
fn main() {
    let sk="native-sketch-1";let p=cad_project_new("Semicircle");let coords=cg_array();
    cg_push(coords,cg_v(10000000,0,0));cg_push(coords,cg_v(0,10000000,0));cg_push(coords,cg_v(-10000000,0,0));
    let arc=cad_project_add_curve(p,sk,"arc",coords);m_assert(arc,cg_error);
    let id=j_string(arc,"id");let report=cad_project_line_sketch(p,sk);
    m_assert(j_integer(report,"degrees_of_freedom")==5,"Arc center, radius, start and sweep are initially free");
    p=cad_project_set_curve_dimension(p,sk,id,"radius","1 cm");m_assert(p,cg_error);
    m_assert(cad_project_add_primitive(p,sk,"line",cg_v(-10000000,0,0),cg_v(10000000,0,0)),cg_error);
    p=cad_project_add_extrusion(p,sk,1,8000000,"newBody");m_assert(p,cg_error);
    p=cad_project_edit_line_variable(p,sk,"","turn","90 deg");m_assert(p,cg_error);
    let saved=j_encode(p);
    m_assert(!cad_project_set_curve_dimension(p,sk,id,"arcSweep","0"),"Sweep excludes zero");
    m_assert(!cad_project_set_curve_dimension(p,sk,id,"arcSweep","360 deg"),"Sweep excludes full turns");
    m_assert(!cad_project_set_curve_dimension(p,sk,id,"arcSweep","5 mm"),"Length cannot drive an angle");
    m_assert(!cad_project_set_curve_dimension(p,sk,id,"arcSweep","-60"),"Opening a downstream profile fails atomically");
    m_assert(m_eq(j_encode(p),saved),"Failed edits retain source");
    p=cad_project_set_curve_dimension(p,sk,id,"arcSweep","-2 * #turn");m_assert(p,cg_error);
    let nodes=pc_nodes(cad_project_part(p));let curve=pc_find(nodes,id);
    m_assert(pc_circle_measure(curve,"arcSweep")==-180000000 && pc_circle_measure(curve,"radius")==10000000,"Sweep preserves radius");
    let rel=load64(pc_first(j_get(pc_find(nodes,sk),"relations"))+24);let key=j_string(rel,"id");
    p=cad_project_edit_line_variable(p,sk,"turn","half","-90 deg");m_assert(p,cg_error);
    nodes=pc_nodes(cad_project_part(p));rel=pc_find(j_get(pc_find(nodes,sk),"relations"),key);
    m_assert(m_eq(j_string(rel,"expression"),"-2 * #half") && pc_pose_number(j_get(rel,"value"))==180000000,"Variable updates signed sweep");
    let stale=j_parse(j_encode(p));nodes=pc_nodes(cad_project_part(stale));
    cg_j_set(pc_curve_geometry(pc_find(nodes,id)),"sweep",pc_arc_json_angle(0xBFF921FB54442D18));
    m_assert(j_get(cad_project_mesh(stale),"error"),"Manufacturing rejects stale arc sweep");
    let before=cad_project_line_sketch(p,sk);
    p=cad_project_toggle_curve_reference(p,sk,id,"arcSweep");m_assert(p,cg_error);
    report=cad_project_line_sketch(p,sk);m_assert(j_integer(report,"degrees_of_freedom")==j_integer(before,"degrees_of_freedom")+1,"Reference releases one DOF");
    p=cad_project_remove_curve_dimension(p,sk,id,"arcSweep");m_assert(p,cg_error);
    let ellipse=cad_project_new("Elliptic arc");nodes=pc_nodes(cad_project_part(ellipse));
    j_add(nodes,0,j_parse("{\"id\":\"ell\",\"sketchId\":\"native-sketch-1\",\"type\":\"sketchPrimitive\",\"primitive\":{\"id\":\"ell\",\"type\":\"ellipticArc\",\"center\":{\"x\":2,\"y\":3},\"width\":20,\"height\":12,\"rotation\":30,\"segments\":64,\"startAngle\":0.25,\"sweep\":1}}"));
    ellipse=cad_project_set_curve_dimension(ellipse,sk,"ell","arcSweep","-1 rad");m_assert(ellipse,cg_error);
    let geom=pc_curve_geometry(pc_find(pc_nodes(cad_project_part(ellipse)),"ell"));
    m_assert(cg_abs(pc_serial_number(j_get(geom,"sweep"),12,1000000000000,7)+1000000000000)<10000 && j_integer(geom,"rotation")==30,"Rotated ellipse accepts radians");
    m_assert(!cad_project_set_curve_dimension(ellipse,sk,"ell","radius","10"),"An ellipse has two axes");
    ellipse=cad_project_set_curve_dimension(ellipse,sk,"ell","height","1.6 cm");m_assert(ellipse,cg_error);
    ellipse=cad_project_set_curve_dimension(ellipse,sk,"ell","rotation","-0.5 rad");m_assert(ellipse,cg_error);
    report=cad_project_line_sketch(ellipse,sk);
    m_assert(j_integer(report,"degrees_of_freedom")==4,"Three independent elliptic arc drivers");
    m_assert(cg_j_count(j_get(report,"radial"))==4,"Elliptic arc exposes sweep, both axes and rotation");
    let plate=cad_project_new("Elliptical washer");let pts=cg_array();
    cg_push(pts,cg_v(0,0,0));cg_push(pts,cg_v(15000000,20000000,0));cg_push(pts,cg_v(-5000000,10000000,0));
    let outer=cad_project_add_curve(plate,sk,"ellipse",pts);m_assert(outer,cg_error);let oval=j_string(outer,"id");
    m_assert(cad_project_add_primitive(plate,sk,"circle",cg_v(0,0,0),cg_v(4000000,0,0)),cg_error);
    plate=cad_project_add_extrusion(plate,sk,1,10000000,"newBody");m_assert(plate,cg_error);
    m_assert(j_integer(cad_project_line_sketch(plate,sk),"degrees_of_freedom")==8,"Free ellipse and circle");
    plate=cad_project_edit_line_variable(plate,sk,"","span","3 cm");m_assert(plate,cg_error);
    plate=cad_project_set_curve_dimension(plate,sk,oval,"width","2 * #span");m_assert(plate,cg_error);
    plate=cad_project_set_curve_dimension(plate,sk,oval,"height","24 mm");m_assert(plate,cg_error);
    plate=cad_project_set_curve_dimension(plate,sk,oval,"rotation","-30 deg");m_assert(plate,cg_error);
    plate=cad_project_edit_line_variable(plate,sk,"span","half","3.5 cm");m_assert(plate,cg_error);
    nodes=pc_nodes(cad_project_part(plate));let measured=pc_find(nodes,oval);
    m_assert(pc_circle_measure(measured,"width")==70000000 && pc_circle_measure(measured,"rotation")==-30000000,"Named width and signed rotation update geometry");
    m_assert(j_integer(cad_project_line_sketch(plate,sk),"degrees_of_freedom")==5,"Independent ellipse fields remove three degrees of freedom");
    saved=j_encode(plate);
    let crossed=cad_project_set_curve_dimension(plate,sk,oval,"height","6 mm");
    m_assert(crossed && j_value(j_get(cad_project_mesh(crossed),"closed")),"Resizing through bore subdivides into closed cuts");
    m_assert(!cad_project_set_curve_dimension(plate,sk,oval,"rotation","2 cm"),"Length cannot drive rotation");
    m_assert(m_eq(j_encode(plate),saved),"Invalid ellipse edit changed the input");
    stale=j_parse(saved);cg_j_int(pc_curve_geometry(pc_find(pc_nodes(cad_project_part(stale)),oval)),"height",25);
    m_assert(j_get(cad_project_mesh(stale),"error"),"Stale axis blocks manufacturing");
    plate=cad_project_toggle_curve_reference(plate,sk,oval,"width");m_assert(plate,cg_error);
    m_assert(j_integer(cad_project_line_sketch(plate,sk),"degrees_of_freedom")==6,"Reference width releases one DOF");
    plate=cad_project_set_curve_dimension(plate,sk,oval,"rotation","0");m_assert(plate,cg_error);
    plate=cad_project_remove_curve_dimension(plate,sk,oval,"height");m_assert(plate,cg_error);
    m_assert(j_integer(cad_project_line_sketch(plate,sk),"degrees_of_freedom")==7,"Removing height keeps geometry");
    let legacy=cad_project_new("Graph axes");let part=cad_project_part(legacy);nodes=pc_nodes(part);
    m_assert(cad_project_add_curve(legacy,sk,"ellipse",pts),cg_error);
    j_add(nodes,0,j_parse("{\"id\":\"size\",\"type\":\"sketchConstraint\",\"sketchId\":\"native-sketch-1\",\"label\":\"outside\",\"constraint\":{\"type\":\"rectangleWidth\",\"entityId\":\"native-entity-1\",\"value\":50,\"units\":\"mm\"}}"));
    let data=j_get(part,"data");j_add(j_get(j_get(data,"tree"),"orderedNodeIds"),0,j_text("size"));
    j_add(j_get(j_get(data,"cad"),"rootNodeIds"),0,j_text("size"));
    report=cad_project_line_sketch(legacy,sk);
    m_assert(report && m_eq(j_string(pc_first(j_get(report,"radial")),"relationId"),"size"),"Read existing graph constraint ID");
    legacy=cad_project_set_curve_dimension(legacy,sk,oval,"width","52");m_assert(legacy,cg_error);
    nodes=pc_nodes(cad_project_part(legacy));let graph=pc_find(nodes,"size");
    m_assert(pc_pose_number(j_get(j_get(graph,"constraint"),"value"))==52000000,"Plain edit retains graph dimension");
    stale=j_parse(j_encode(legacy));nodes=pc_nodes(cad_project_part(stale));
    cg_j_int(pc_curve_geometry(pc_find(nodes,oval)),"width",48);
    m_assert(j_get(cad_project_inspect_source(j_encode(stale)),"readOnly"),"A stale width-only sketch opens read-only");
    let promoted=cad_project_set_curve_dimension(legacy,sk,oval,"width","6 cm");m_assert(promoted,cg_error);
    nodes=pc_nodes(cad_project_part(promoted));rel=pc_find(j_get(pc_find(nodes,sk),"relations"),"size");
    m_assert(!pc_find(nodes,"size") && m_eq(j_string(rel,"type"),"width") && m_eq(j_string(rel,"label"),"outside") && m_eq(j_string(rel,"units"),"mm"),"Expression migration retains ID and metadata");
    let removed=cad_project_remove_curve_dimension(legacy,sk,oval,"width");m_assert(removed,cg_error);
    data=j_get(cad_project_part(removed),"data");
    m_assert(cg_j_count(j_get(j_get(data,"cad"),"rootNodeIds"))==4 && cg_j_count(j_get(j_get(data,"tree"),"orderedNodeIds"))==1,"Remove graph dimension from both indices");
    return 0;
}
