import "cad/author.flex";
import "../project-lines.flex";

fn main() {
    let sheet=cad_project_new("Conics");let points=cg_array();let sk="native-sketch-1";
    cg_push(points,cg_v(2000000,3000000,0));cg_push(points,cg_v(17000000,23000000,0));
    let before_shapes=j_encode(sheet);
    m_assert(!cad_project_add_curve(sheet,sk,"ellipse",points),"Incomplete ellipse");
    cg_begin();cg_push(points,cg_v(32000000,43000000,0));
    m_assert(!cad_project_add_curve(sheet,sk,"ellipse",points),"Zero minor axis");
    m_assert(!cad_project_add_curve(sheet,sk,"threePointCircle",points),"Collinear circle points");
    m_assert(m_eq(before_shapes,j_encode(sheet)),"Rejected profiles changed the sketch");
    cg_begin();store64(points,2);cg_push(points,cg_v(-3000000,13000000,0));
    let ellipse=j_get(cad_project_add_curve(sheet,sk,"ellipse",points),"primitive");m_assert(ellipse,cg_error);
    m_assert(pc_pose_number(j_get(ellipse,"width"))==50000000 && pc_pose_number(j_get(ellipse,"height"))==20000000,"Height uses perpendicular projection");
    m_assert(pc_pose_number(j_get(ellipse,"rotation"))==53130102,"Ellipse axis angle");
    let mirrored=cad_project_new("Mirrored");store64(points,2);cg_push(points,cg_v(13000000,1000000,0));
    let opposite=j_get(cad_project_add_curve(mirrored,sk,"ellipse",points),"primitive");
    m_assert(m_eq(j_encode(ellipse),j_encode(opposite)),"Either side of first axis creates the same ellipse");
    let perimeter=cg_array();cg_push(perimeter,cg_v(-2000000,3000000,0));cg_push(perimeter,cg_v(2000000,7000000,0));cg_push(perimeter,cg_v(6000000,3000000,0));
    let circle=j_get(cad_project_add_curve(sheet,sk,"threePointCircle",perimeter),"primitive");m_assert(circle,cg_error);
    m_assert(pc_pose_number(j_get(circle,"radius"))==4000000 && j_integer(circle,"segments")==64 && m_eq(j_encode(j_get(circle,"center")),j_encode(j_get(ellipse,"center"))),"Circumcircle through its three points");
    let washer=cad_project_add_extrusion(sheet,sk,1,10000000,"newBody");m_assert(washer,"Extrude ellipse with a circular hole");
    let saved_washer=j_encode(washer);
    m_assert(!cad_project_add_curve(washer,sk,"ellipse",points),"Overlapping ellipse breaks existing extrusion");
    m_assert(m_eq(saved_washer,j_encode(washer)),"Failed dependent extrusion left a sketch entity");
    let project=cad_project_new("Plate \"A\"");let part=cad_project_part(project);
    m_assert(m_eq(j_string(part,"name"),"Plate \"A\""),"Project name");
    let sketch="native-sketch-1";let origin=cg_v(0,0,0);let a=cg_v(-20000000,-10000000,0);let b=cg_v(20000000,10000000,0);
    m_assert(cad_project_add_primitive(project,sketch,"rectangle",a,b),"Create rectangle");
    m_assert(cad_project_add_primitive(project,sketch,"circle",origin,cg_v(4000000,0,0)),"Create hole");
    let all=j_parse("[\"native-entity-1\",\"native-entity-2\"]");let circle_only=j_parse("[\"native-entity-2\"]");
    let hole_guide=cad_project_toggle_construction(project,sketch,circle_only);m_assert(hole_guide,cg_error);
    let mixed=cad_project_toggle_construction(hole_guide,sketch,all);m_assert(mixed,cg_error);
    let selected_nodes=pc_nodes(cad_project_part(mixed));
    let rect=pc_find(selected_nodes,"native-entity-1");let disk=pc_find(selected_nodes,"native-entity-2");
    m_assert(j_value(j_get(rect,"construction")) && j_value(j_get(j_get(disk,"primitive"),"construction")),"Canonical construction flag locations");
    cg_j_set(disk,"construction",j_new(5,1));
    let restored=cad_project_toggle_construction(mixed,sketch,all);
    m_assert(m_eq(j_encode(restored),j_encode(project)),"Clear both legacy and canonical flags on restore");
    let solid=cad_project_add_extrusion(hole_guide,sketch,1,10000000,"newBody");m_assert(solid,cg_error);
    let snapshot=j_encode(solid);
    m_assert(!cad_project_toggle_construction(solid,sketch,all),"Cannot remove the last profile of an extrusion");
    m_assert(!cad_project_toggle_construction(solid,sketch,j_parse("[\"native-entity-2\",\"plane-top\"]")),"Foreign entity");
    m_assert(!cad_project_toggle_construction(solid,sketch,j_parse("[\"native-entity-2\",\"native-entity-2\"]")),"Duplicate entity");
    m_assert(!cad_project_toggle_construction(solid,sketch,j_array()) && m_eq(snapshot,j_encode(solid)),"Rejected edits preserve drawing");
    let curves=cad_project_new("Guide curves");
    m_assert(cad_project_add_curve(curves,sketch,"arc",perimeter) && cad_project_add_curve(curves,sketch,"fit",perimeter),"Create guide curves");
    let guides=cad_project_toggle_construction(curves,sketch,all);let curve_nodes=pc_nodes(cad_project_part(guides));
    m_assert(j_value(j_get(j_get(pc_find(curve_nodes,"native-entity-1"),"arc"),"construction")) && j_value(j_get(j_get(pc_find(curve_nodes,"native-entity-2"),"spline"),"construction")),"Arc and spline flags belong to their geometry records");
    m_assert(m_eq(j_encode(cad_project_toggle_construction(guides,sketch,all)),j_encode(curves)),"Restore arc and spline data");
    let before=j_encode(project);
    m_assert(!cad_project_add_primitive(project,sketch,"rectangle",origin,origin),"Degenerate rectangle");
    m_assert(!cad_project_add_extrusion(project,sketch,-1,10000000,"newBody"),"Invalid profile");
    m_assert(!cad_project_add_extrusion(project,sketch,2,10000000,"newBody"),"Missing profile");
    m_assert(!cad_project_add_extrusion(project,sketch,1,10000000,"cut"),"Missing cut target");
    m_assert(m_eq(j_encode(project),before),"Rejected edits changed the sketch");
    let output=cad_project_add_extrusion(project,sketch,1,10000000,"newBody");m_assert(output,cg_error);
    m_assert(m_eq(j_encode(project),before),"Source sketch was mutated by extrusion");
    let data=j_get(cad_project_part(output),"data");let cad=j_get(data,"cad");let tree=j_get(data,"tree");
    m_assert(cg_j_count(j_get(cad,"nodes"))==7 && cg_j_count(j_get(cad,"rootNodeIds"))==5 && cg_j_count(j_get(tree,"orderedNodeIds"))==2,"Graph links");
    m_assert(!cad_project_add_extrusion(output,sketch,1,8000000,"newBody"),"Duplicate profile extrusion");
    let saved=j_encode(output);
    m_assert(!cad_project_add_primitive(output,sketch,"circle",b,cg_v(22000000,10000000,0)),"Crossing addition broke dependent extrusion");
    m_assert(m_eq(j_encode(output),saved),"Failed dependent rebuild changed the graph");
    let reopened=cad_project_open(saved);let mesh=cad_project_mesh(reopened);
    m_assert(j_value(j_get(mesh,"closed")) && cad_project_stls(mesh),"Reopen and export");
    let triangle=cad_project_new("Triangle");
    let corner=cg_v(20000000,-10000000,0);
    m_assert(!cad_project_add_primitive(triangle,sketch,"line",a,a),"Zero length line");
    m_assert(cad_project_add_primitive(triangle,sketch,"line",a,b),"First line");
    m_assert(cad_project_add_primitive(triangle,sketch,"line",corner,b),"Reversed second line");
    m_assert(!cad_project_add_extrusion(triangle,sketch,1,5000000,"newBody"),"Open contour");
    m_assert(cad_project_add_primitive(triangle,sketch,"line",corner,a),"Close triangle");
    m_assert(cad_project_add_extrusion(triangle,sketch,1,5000000,"newBody"),"Extrude triangle");
    let blank=cad_project_add_item(output,"part");let blank_part=cad_project_part(blank);
    m_assert(m_eq(j_string(blank_part,"id"),"native-part-2") && pc_find(pc_nodes(blank_part),sketch),"New part and sketch");
    let assembly=cad_project_add_item(blank,"assembly");let item=cad_project_item(assembly);
    m_assert(m_eq(j_string(item,"id"),"native-assembly-1") && !cad_project_part(assembly),"Select new assembly");
    let empty=j_encode(assembly);
    m_assert(!cad_project_insert_instance(assembly,"native-part-2"),"Empty part cannot supply a body");
    m_assert(!cad_project_insert_instance(assembly,"missing"),"Missing prototype");
    let placed=cad_project_insert_instance(assembly,"native-part-1");m_assert(placed,cg_error);
    placed=cad_project_insert_instance(placed,"native-part-1");m_assert(placed,cg_error);
    let list=j_get(j_get(cad_project_item(placed),"data"),"instances");let left=pc_first(list);let right=load64(left+24);
    m_assert(m_eq(j_string(left,"partId"),j_string(right,"partId")) && !m_eq(j_string(left,"id"),j_string(right,"id")),"Distinct occurrences");
    m_assert(pc_pose_number(j_get(j_get(j_get(right,"transform"),"translation"),"x"))==50000000,"Second occurrence spacing");
    m_assert(m_eq(j_encode(assembly),empty) && m_eq(j_encode(output),saved),"Input graphs preserved");
    let sparse=cad_project_new("Missing Front plane");let sparse_part=cad_project_part(sparse);let nodes=pc_nodes(sparse_part);
    let top=pc_find(nodes,"plane-top");let old_front=pc_find(nodes,"plane-front");
    store64(top+24,load64(old_front+24));
    let top_root=pc_first(j_get(j_get(j_get(sparse_part,"data"),"cad"),"rootNodeIds"));
    store64(top_root+24,load64(load64(top_root+24)+24));
    let before_plane=j_encode(sparse);
    let front=cad_project_add_plane_sketch(sparse,"XZ");m_assert(front,cg_error);
    let authored=pc_nodes(cad_project_part(front));
    let frame=pc_find(authored,"plane-front");let sketch2=pc_find(authored,"native-sketch-2");
    m_assert(m_eq(j_string(frame,"plane"),"XZ") && m_eq(j_string(sketch2,"targetId"),"plane-front"),"Create and attach missing standard plane");
    let second=cad_project_add_plane_sketch(front,"XZ");m_assert(second,cg_error);
    m_assert(m_eq(j_string(pc_find(pc_nodes(cad_project_part(second)),"native-sketch-3"),"targetId"),"plane-front"),"Reuse canonical plane");
    m_assert(!cad_project_add_plane_sketch(sparse,"ZX") && m_eq(j_encode(sparse),before_plane),"Invalid axis preserves input");
    let profiles=cad_project_new("Profile tools");let k="native-sketch-1";let picks=cg_array();
    cg_push(picks,cg_v(-3000000,-4000000,0));cg_push(picks,cg_v(3000000,4000000,0));
    let disk_guide=j_get(cad_project_add_curve(profiles,k,"diameterCircle",picks),"primitive");
    m_assert(pc_pose_number(j_get(disk_guide,"radius"))==5000000 && load64(pc_uv(j_get(disk_guide,"center")))==0,"Diagonal diameter");
    let center_rect=j_get(cad_project_add_curve(profiles,k,"centerRectangle",picks),"primitive");
    m_assert(pc_pose_number(j_get(center_rect,"width"))==12000000 && pc_pose_number(j_get(center_rect,"height"))==16000000,"Center and corner rectangle");
    cg_push(picks,cg_v(5000000,-2000000,0));
    let edge_rect=j_get(cad_project_add_curve(profiles,k,"threePointRectangle",picks),"primitive");
    let edge_center=pc_uv(j_get(edge_rect,"center"));
    m_assert(pc_pose_number(j_get(edge_rect,"height"))==5200000 && load64(edge_center)==2080000 && load64(edge_center+8)== -1560000,"First edge and signed height");
    let centered=cad_project_new("Centered profile");store64(picks,0);
    cg_push(picks,cg_v(0,0,0));cg_push(picks,cg_v(15000000,20000000,0));cg_push(picks,cg_v(-8000000,6000000,0));
    let ellipse_rect=j_get(cad_project_add_curve(centered,k,"threePointCenterRectangle",picks),"primitive");
    m_assert(pc_pose_number(j_get(ellipse_rect,"width"))==50000000 && pc_pose_number(j_get(ellipse_rect,"height"))==20000000,"Centered width and height");
    m_assert(pc_pose_number(j_get(ellipse_rect,"rotation"))==53130102,"Centered rotation");
    let resized=cad_project_set_curve_dimension(centered,k,"native-entity-1","width","60");m_assert(resized,cg_error);
    let solid_box=cad_project_add_extrusion(resized,k,1,10000000,"newBody");m_assert(solid_box,cg_error);
    let prior=j_encode(centered);store64(picks,2);cg_push(picks,cg_v(30000000,40000000,0));
    m_assert(!cad_project_add_curve(centered,k,"threePointCenterRectangle",picks) && m_eq(prior,j_encode(centered)),
        "Reject collinear height without changing the document");
    let patterned_profile=cad_project_new("Polygon and slot");store64(picks,0);
    cg_push(picks,cg_v(0,0,0));cg_push(picks,cg_v(15000000,20000000,0));
    m_assert(cad_project_add_curve(patterned_profile,k,"polygon",picks),"Create six-sided polygon");
    store64(picks,0);cg_push(picks,cg_v(-6000000,0,0));cg_push(picks,cg_v(6000000,0,0));
    cg_push(picks,cg_v(0,3000000,0));
    m_assert(cad_project_add_curve(patterned_profile,k,"capsule",picks),"Create profile from slot centers and wall");
    let old_profiles=j_encode(patterned_profile);
    m_assert(!cad_project_set_profile_parameter(patterned_profile,k,"native-entity-1","2"),"Reject invalid side count");
    m_assert(!cad_project_set_profile_parameter(patterned_profile,k,"native-entity-2","2+2"),"Slot width remains a literal property");
    m_assert(m_eq(j_encode(patterned_profile),old_profiles),"Invalid edits leave original profile intact");
    let octagon=cad_project_set_profile_parameter(patterned_profile,k,"native-entity-1","8");m_assert(octagon,cg_error);
    let wide_slot=cad_project_set_profile_parameter(octagon,k,"native-entity-2","8");m_assert(wide_slot,cg_error);
    let driven=cad_project_set_curve_dimension(wide_slot,k,"native-entity-1","radius","24");m_assert(driven,cg_error);
    let curves1=pc_nodes(cad_project_part(driven));let polygon=j_get(pc_find(curves1,"native-entity-1"),"primitive");
    let slot=j_get(pc_find(curves1,"native-entity-2"),"primitive");
    m_assert(j_integer(polygon,"sides")==8 && pc_pose_number(j_get(polygon,"rotation"))==53130102 && pc_pose_number(j_get(polygon,"radius"))==24000000,"Preserve polygon placement and update dimensions");
    m_assert(pc_pose_number(j_get(slot,"width"))==8000000 && j_integer(slot,"arcSegments")==48,"Update only slot width");
    let report=cad_project_line_sketch(driven,k);
    m_assert(j_integer(report,"degrees_of_freedom")==8,"Eight remaining freedoms include the independent slot");
    m_assert(cad_project_add_extrusion(driven,k,1,10000000,"newBody"),cg_error);
    return 0;
}
