import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
extend "../schema.flex";
extend "../compile.flex" with "wanted";
database Archive {table Segment {id:rowid;number:i64;payload:blob;}}
fn wanted(row,n) {return Segment_number(row)>=n;}
fn raw(n,random) {let p=h_take(n+1);let x=123456789;let i=0;let pattern="{\"device\":\"bus-42\",\"level\":\"info\",\"message\":\"engine telemetry ok\",\"reading\":123.45}\n";let width=fd_len(pattern);while i<n {let b=load8(pattern+i%width);if random {x=(x^(x<<13))&4294967295;x=x^(x>>17);x=(x^(x<<5))&4294967295;b=x&255;}store8(p+i,b);i=i+1;}return p;}
fn put(t,p,n,number) {let db=load64(t);let q=flexdb_query(db);let values=Segment_values(q,number,p,n);let id=flexdb_insert(t,values);flexdb_query_close(q);h_assert(id,"insert blob");return id;}
fn file_size(path) {let s=h_take(144);h_assert(syscall(4,path,s,0,0,0,0)==0,"stat");return load64(s+48);}
fn stream(v,p) {let r=flexdb_blob_reader_sequential(v);h_assert(r,"stream reader");let out=h_take(70000);let n=flexdb_bytes(v);let at=0;let turn=0;while at<n {let count=70000;if turn%3==0 {count=513;}let got=flexdb_blob_reader_read(r,out,count);h_assert(got>0 && got<=count && fd_bytes(out,p+at,got),"incremental bytes");at=at+got;turn=turn+1;}h_assert(flexdb_blob_reader_read(r,out,70000)==0 && flexdb_blob_reader_read(r,out,0)==0 && flexdb_blob_reader_close(r),"stream EOF/close");return 1;}
fn ranges(v,p) {stream(v,p);let n=flexdb_bytes(v);let out=h_take(70001);let off=0;while off<n {let count=n-off;if count>70000 {count=70000;}h_assert(flexdb_blob_read(v,off,out,count)==count && fd_bytes(out,p+off,count),"range bytes across decoder blocks");off=off+count;}h_assert(flexdb_blob_read(v,n,out,0)==0 && flexdb_blob_read(v,n,out,1)==(-1) && flexdb_blob_read(v,-1,out,1)==(-1),"range bounds");if flexdb_blob_external(v) {h_assert(!load64(load64(v+8)+64),"stream reads retain no materialized buffer");}return 1;}
fn roundtrip(path) {
 let db=Archive_open(path);h_assert(db && flexdb_begin(db),"blob begin");let t=Segment_table(db);let p=raw(2097152,0);let noise=raw(1048576,1);put(t,p,0,0);put(t,p,4095,1);put(t,p,4096,2);put(t,p,4097,3);put(t,p,2097152,4);put(t,noise,1048576,5);h_assert(flexdb_commit(db),"blob commit");let big=Segment_payload_value(flexdb_get(t,5));let blob_id=flexdb_blob_id(big);h_assert(!load64(load64(big+8)+56) && !load64(load64(big+8)+88),"commit releases anonymous compression staging");h_assert(!flexdb_blob_external(Segment_payload_value(flexdb_get(t,1))) && !flexdb_blob_external(Segment_payload_value(flexdb_get(t,2))) && flexdb_blob_external(Segment_payload_value(flexdb_get(t,3))),"4 KiB inline boundary");h_assert(flexdb_blob_codec(big)==1 && flexdb_blob_stored_bytes(big)<2097152/20,"log compression");let noisy=Segment_payload_value(flexdb_get(t,6));h_assert(flexdb_blob_codec(noisy)==0 && flexdb_blob_stored_bytes(noisy)==1048576,"incompressible raw fallback");ranges(big,p);ranges(noisy,noise);h_assert(flexdb_checkpoint(db),"blob checkpoint");let before=file_size(path);let original=flexdb_get(t,5);let i=0;while i<20 {h_assert(flexdb_begin(db),"metadata begin");let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,i));flexdb_add(db,v,big);h_assert(flexdb_update(t,5,v) && flexdb_commit(db),"metadata-only update");i=i+1;}h_assert(flexdb_blob_id(Segment_payload_value(flexdb_get(t,5)))==blob_id && Segment_number(original)==4,"stable blob/immutable row");h_assert(flexdb_checkpoint(db) && file_size(path)-before<12000,"metadata/checkpoints do not duplicate payloads");h_assert(close_flexdb(db),"blob close");
 db=Archive_open(path);h_assert(db,"blob reopen");t=Segment_table(db);h_assert(load64(db+184)==0,"lazy metadata open");h_assert(wanted_count(t,0)==6 && wanted_count(t,4)==2 && load64(db+184)==0,"compiled metadata count validates references without hydrating blobs/rows");big=Segment_payload_value(flexdb_get(t,5));noisy=Segment_payload_value(flexdb_get(t,6));h_assert(flexdb_blob_id(big)==blob_id && !load64(load64(big+8)+56),"payload not mapped on row lookup");ranges(big,p);ranges(noisy,noise);
 // A deleted, unread captured value must remain readable after replacement of
 // the source file. It is excluded from the compacted live archive.
 let cold=Segment_payload_value(flexdb_get(t,4));h_assert(!load64(load64(cold+8)+56),"cold captured blob");h_assert(flexdb_begin(db) && flexdb_delete(t,4) && flexdb_commit(db),"delete cold captured row");h_assert(flexdb_compact(db),"blob compact");let out=h_take(4097);h_assert(flexdb_blob_read(cold,0,out,4097)==4097 && fd_bytes(out,p,4097),"deleted captured blob after compact");ranges(big,p);h_assert(flexdb_blob_id(big)==blob_id && flexdb_integrity(db),"ID/integrity after relocation");h_assert(close_flexdb(db),"compact close");db=Archive_open(path);h_assert(db && !flexdb_get(Segment_table(db),4),"compacted deletion reopen");big=Segment_payload_value(flexdb_get(Segment_table(db),5));ranges(big,p);let full=Segment_payload(flexdb_get(Segment_table(db),5));h_assert(full && fd_bytes(full,p,2097152),"typed blob getter materializes exact bytes");h_assert(close_flexdb(db),"finish roundtrip");return 1;
}
fn rollback(path) {
 let db=Archive_open(path);let t=Segment_table(db);let p=raw(10000,0);let before=h_sha(path);h_assert(flexdb_begin(db),"rollback begin");let id=put(t,p,10000,1);let row=flexdb_get(t,id);let value=Segment_payload_value(row);let reader=flexdb_blob_reader(value);h_assert(reader,"reader over pending blob");h_assert(flexdb_rollback(db) && fd_same(before,h_sha(path)) && !flexdb_get(t,id),"rollback writes no payload bytes");let pending_out=h_take(10000);h_assert(flexdb_blob_reader_read(reader,pending_out,10000)==10000 && fd_bytes(pending_out,p,10000) && flexdb_blob_reader_close(reader),"pending reader survives rollback");ranges(value,p);h_assert(flexdb_begin(db),"reuse rolled-back blob");let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,2));flexdb_add(db,v,value);h_assert(flexdb_insert(t,v),"reinsert captured rolled-back value");let committed=Segment_payload_value(flexdb_get(t,1));reader=flexdb_blob_reader(committed);h_assert(reader && flexdb_commit(db) && load64(load64(committed+8)+88),"commit pins an active reader staging buffer");h_assert(flexdb_blob_reader_read(reader,pending_out,10000)==10000 && fd_bytes(pending_out,p,10000) && flexdb_blob_reader_close(reader) && !load64(load64(committed+8)+88),"last reader releases committed staging");h_assert(flexdb_integrity(db) && close_flexdb(db),"rollback close");return 1;
}
fn save(path,p,n) {let fd=syscall(2,path,0x80241,384,0,0,0);h_assert(fd>=0 && fd_io(fd,p,n,0,1),"fixture write");syscall(3,fd,0,0,0,0,0);return 1;}
fn recovery(work) {
 let path=h_join(work,"blob-recovery-source.db");let db=Archive_open(path);let t=Segment_table(db);h_assert(flexdb_checkpoint(db),"base checkpoint");let base=file_size(path);let p=raw(10000,0);h_assert(flexdb_begin(db),"recovery begin");put(t,p,10000,1);h_assert(flexdb_commit(db),"recovery commit");let end=file_size(path);close_flexdb(db);let image=h_read(path);let size=h_file_size;h_assert(size==end,"no extra close checkpoint");let fixture=h_join(work,"blob-recovery.db");let cut=base;
 while cut<end {save(fixture,image,cut);db=open_flexdb(fixture);h_assert(db && !flexdb_get(flexdb_table(db,"Segment"),1),"every torn blob/transaction prefix preserves base");h_assert(load64(db+56)==base,"orphan extent truncates with incomplete transaction");close_flexdb(db);cut=cut+1;}
 save(fixture,image,end);db=open_flexdb(fixture);h_assert(db && flexdb_get(flexdb_table(db,"Segment"),1) && flexdb_integrity(db) && close_flexdb(db),"complete blob transaction recovers");
 // Complete corrupt data is an error, never a torn-write truncation.
 let copy=h_take(size);h_copy(copy,image,size);store8(copy+base+64,load8(copy+base+64)^1);save(fixture,copy,size);let hash=h_sha(fixture);h_assert(!open_flexdb(fixture) && fd_same(hash,h_sha(fixture)),"corrupt complete extent fails without rewrite");
 // A checkpoint skips historical payload validation; accessing its lazy blob
 // detects corruption before a byte is returned and poisons the connection.
 db=open_flexdb(path);h_assert(db && flexdb_checkpoint(db) && close_flexdb(db),"lazy corruption checkpoint");image=h_read(path);size=h_file_size;copy=h_take(size);h_copy(copy,image,size);store8(copy+base+64,load8(copy+base+64)^1);save(fixture,copy,size);hash=h_sha(fixture);db=open_flexdb(fixture);h_assert(db,"lazy blob corruption open");let row=flexdb_get(flexdb_table(db,"Segment"),1);let out=h_take(1);h_assert(row && flexdb_blob_read(Segment_payload_value(row),0,out,1)==(-1) && load64(db+48)==2,"lazy blob checksum failure");close_flexdb(db);h_assert(fd_same(hash,h_sha(fixture)),"lazy corrupt file unchanged");db=open_flexdb(fixture);h_assert(db,"corrupt sequential reopen");row=flexdb_get(flexdb_table(db,"Segment"),1);h_assert(row && !flexdb_blob_reader_sequential(Segment_payload_value(row)) && load64(db+48)==2,"fresh buffered reader validates CRC before returning output");close_flexdb(db);h_assert(fd_same(hash,h_sha(fixture)),"buffered corruption check leaves file unchanged");return 1;
}
fn compact_recovery(work) {
 let path=h_join(work,"compact-blob-recovery-source.db");let db=Archive_open(path);let t=Segment_table(db);let p=raw(10000,0);h_assert(flexdb_begin(db),"compact recovery begin");put(t,p,10000,1);h_assert(flexdb_commit(db) && flexdb_compact(db),"compact blob base");let base=file_size(path);h_assert(flexdb_begin(db),"compact tail begin");put(t,p,10000,2);h_assert(flexdb_commit(db),"compact tail commit");let end=file_size(path);h_assert(close_flexdb(db),"compact tail close");let image=h_read(path);let fixture=h_join(work,"compact-blob-recovery.db");let cut=base;while cut<end {save(fixture,image,cut);db=open_flexdb(fixture);h_assert(db && flexdb_get(flexdb_table(db,"Segment"),1) && !flexdb_get(flexdb_table(db,"Segment"),2) && load64(db+56)==base && close_flexdb(db),"torn blob tail on mandatory compacted base");cut=cut+1;}
 let cuts=h_args("32","63","64","80",h_int(base-48),h_int(base-1));let i=0;while i<h_count(cuts) {cut=h_number(h_at(cuts,i));save(fixture,image,cut);let before=h_sha(fixture);h_assert(!open_flexdb(fixture) && fd_same(before,h_sha(fixture)),"incomplete compacted blob base fails unchanged");i=i+1;}return 1;
}
fn schema_blobs(path) {
 let db=open_flexdb(path);h_assert(db && flexdb_begin(db),"schema blob base");let cols=flexdb_schema(db);flexdb_column(db,cols,"n",1,0);let t=flexdb_create(db,"t",cols);let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,1));h_assert(flexdb_insert(t,v) && flexdb_commit(db),"schema base row");let original=flexdb_get(t,1);let p=raw(2097152,0);let next=flexdb_schema(db);flexdb_column(db,next,"n",1,0);flexdb_column(db,next,"payload",3,0);v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,1));flexdb_add(db,v,flexdb_blob(db,p,2097152));let rows=fd_vec(db);fd_push(db,rows,fd_row_refs(db,1,v));h_assert(flexdb_begin(db) && fd_replace_schema(t,next,rows) && flexdb_commit(db),"new large schema value externalizes");h_assert(load64(original+8)==1 && load64(flexdb_get(t,1)+8)==2,"schema preserves captured version");v=Segment_payload_value(flexdb_get(t,1));h_assert(flexdb_blob_external(v),"schema blob reference");ranges(v,p);h_assert(flexdb_begin(db),"insert after blob schema");put(t,p,2097152,2);h_assert(flexdb_commit(db) && Segment_number(flexdb_get(t,1))==1 && close_flexdb(db),"new blob flag and schema value ownership");db=open_flexdb(path);h_assert(db && flexdb_integrity(db),"external schema replay");ranges(Segment_payload_value(flexdb_get(flexdb_table(db,"t"),2)),p);h_assert(close_flexdb(db),"schema blob finish");return 1;
}
fn codec_fallback(path) {
 let p=raw(10000,0);let db=Archive_open(path);let t=Segment_table(db);h_assert(db && flexdb_begin(db),"codec begin");put(t,p,10000,1);h_assert(flexdb_commit(db),"compressed codec seed");let compressed=Segment_payload_value(flexdb_get(t,1));h_assert(flexdb_blob_codec(compressed)==1,"compressed seed");let library=fd_zstd;fd_zstd=-1;let out=h_take(1);h_assert(flexdb_blob_read(compressed,0,out,1)==(-1) && !flexdb_blob_reader(compressed) && load64(db+48)==0 && h_has(flexdb_error(db),"libzstd"),"missing codec gives retryable read error");h_assert(flexdb_begin(db),"raw fallback begin");put(t,p,10000,2);h_assert(flexdb_commit(db),"raw fallback commit");let fallback=Segment_payload_value(flexdb_get(t,2));h_assert(flexdb_blob_codec(fallback)==0 && flexdb_blob_stored_bytes(fallback)==10000,"missing codec stores exact raw bytes");ranges(fallback,p);fd_zstd=library;ranges(compressed,p);h_assert(flexdb_integrity(db) && close_flexdb(db),"codec fallback close");return 1;
}
fn large(path) {
 let n=18*1048576;let p=raw(n,1);let db=Archive_open(path);h_assert(db && flexdb_blob_options(db,4096,6) && !flexdb_blob_options(db,4096,20) && flexdb_begin(db),"large options/begin");put(Segment_table(db),p,n,18);h_assert(flexdb_commit(db) && flexdb_checkpoint(db),"payload exceeds 16 MiB transaction/checkpoint bound");h_assert(file_size(path)<n+4096,"one raw payload copy plus small metadata");h_assert(close_flexdb(db),"large close");db=Archive_open(path);h_assert(db && load64(load64(db+232)+8)==6,"options persist");let v=Segment_payload_value(flexdb_get(Segment_table(db),1));let out=h_take(10000);h_assert(flexdb_bytes(v)==n && flexdb_blob_read(v,n-10000,out,10000)==10000 && fd_bytes(out,p+n-10000,10000) && !load64(load64(v+8)+64),"large bounded lazy read");h_assert(flexdb_compact(db) && file_size(path)<n+4096 && close_flexdb(db),"large compact single copy");return 1;
}
fn release_pages(path) {
	let db=Archive_open(path);let t=Segment_table(db);let p=raw(1048576,0);let noise=raw(1048576,1);let out=h_take(2097152);
	h_assert(db && flexdb_begin(db),"release pages begin");put(t,p,1048576,1);put(t,noise,1048576,2);put(t,p,10,3);
	let pending=Segment_payload_value(flexdb_get(t,1));let reader=flexdb_blob_reader_sequential(pending);h_assert(reader && flexdb_blob_release_pages(pending),"pending staging is not discarded");
	h_assert(flexdb_commit(db) && flexdb_blob_release_pages(pending) && flexdb_blob_reader_read(reader,out,1048576)==1048576 && fd_bytes(out,p,1048576) && flexdb_blob_reader_close(reader),"committed pinned staging remains readable");
	h_assert(!flexdb_blob_release_pages(0) && !flexdb_blob_release_pages(flexdb_int(db,1)) && flexdb_blob_release_pages(Segment_payload_value(flexdb_get(t,3))),"release validates types; inline is a no-op");
	let compressed=Segment_payload_value(flexdb_get(t,1));let raw_value=Segment_payload_value(flexdb_get(t,2));h_assert(!load64(load64(raw_value+8)+56) && flexdb_blob_release_pages(raw_value) && !load64(load64(raw_value+8)+56),"release never maps an unread blob");
	reader=flexdb_blob_reader_sequential(compressed);let other=flexdb_blob_reader(compressed);h_assert(reader && other && flexdb_blob_reader_read(reader,out,513)==513 && fd_bytes(out,p,513),"two independent readers");
	let mapped=load64(load64(compressed+8)+56);h_assert(flexdb_blob_release_pages(compressed) && mapped==load64(load64(compressed+8)+56),"release preserves mapping and active readers");
	h_assert(flexdb_blob_reader_read(reader,out,1048576)==1048576-513 && fd_bytes(out,p+513,1048576-513) && flexdb_blob_reader_close(reader),"reader resumes after page release");
	h_assert(flexdb_blob_reader_read(other,out,1048576)==1048576 && fd_bytes(out,p,1048576) && flexdb_blob_reader_close(other),"second reader survives release");
	h_assert(flexdb_blob_release_pages(compressed) && flexdb_blob_release_pages(compressed) && flexdb_blob_read(compressed,0,out,1048576)==1048576 && fd_bytes(out,p,1048576),"repeat release and reread compressed");
	reader=flexdb_blob_reader_sequential(raw_value);h_assert(reader && flexdb_blob_reader_read(reader,out,513)==513 && fd_bytes(out,noise,513) && flexdb_blob_reader_read(reader,out,1048576)==1048576-513 && fd_bytes(out,noise+513,1048576-513) && flexdb_blob_reader_close(reader),"sequential raw partial reads release consumed pages");
	let materialized=flexdb_blob_data(compressed);h_assert(materialized && flexdb_blob_release_pages(compressed) && fd_bytes(materialized,p,1048576),"materialized pointer survives release");
	h_assert(flexdb_blob_read(raw_value,0,out,1048576)==1048576 && fd_bytes(out,noise,1048576) && flexdb_blob_release_pages(raw_value),"raw file pages released");
	h_assert(flexdb_begin(db) && flexdb_delete(t,2) && flexdb_commit(db) && flexdb_compact(db),"compact while captured deleted value exists");
	h_assert(flexdb_blob_release_pages(raw_value) && flexdb_blob_read(raw_value,0,out,1048576)==1048576 && fd_bytes(out,noise,1048576),"released old inode faults back after compaction");
	h_assert(flexdb_blob_release_pages(compressed) && flexdb_blob_read(compressed,0,out,1048576)==1048576 && fd_bytes(out,p,1048576),"live relocated descriptor releases its actual mapping");
	let mixed=raw(2097152,1);fd_copy(mixed+1048576,p,1048576);h_assert(flexdb_begin(db),"mixed file stream begin");let id=put(t,mixed,2097152,4);h_assert(flexdb_commit(db),"mixed file stream commit");let fresh=Segment_payload_value(flexdb_get(t,id));
	h_assert(flexdb_blob_codec(fresh)==1 && flexdb_blob_stored_bytes(fresh)>65536 && !load64(load64(fresh+8)+56),"multi-buffer compressed source");
	let probe=syscall(72,load64(db+24),1030,0,0,0,0);h_assert(probe>=0,"fd leak baseline");syscall(3,probe,0,0,0,0,0);
	stream(fresh,mixed);h_assert(!load64(load64(fresh+8)+56),"sequential file reader never maps payload");
	let after=syscall(72,load64(db+24),1030,0,0,0,0);h_assert(after==probe,"sequential reader closes pinned fd");syscall(3,after,0,0,0,0,0);
	reader=flexdb_blob_reader_sequential(fresh);h_assert(reader && flexdb_blob_reader_read(reader,out,513)==513 && fd_bytes(out,mixed,513),"open file reader before replacement");
	h_assert(flexdb_begin(db) && flexdb_delete(t,id) && flexdb_commit(db) && flexdb_compact(db),"compact removes actively read source extent");
	h_assert(flexdb_blob_reader_read(reader,out,2097152)==2097152-513 && fd_bytes(out,mixed+513,2097152-513) && flexdb_blob_reader_close(reader),"owned file fd preserves original offset/inode across compaction");
	h_assert(close_flexdb(db),"release pages close");return 1;
}
fn main(argc,argv) {h_environment(argc,argv);h_assert(argc==2,"blob fixture directory");let work=load64(argv+8);roundtrip(h_join(work,"blobs.db"));rollback(h_join(work,"blob-rollback.db"));recovery(work);compact_recovery(work);large(h_join(work,"large-blob.db"));schema_blobs(h_join(work,"schema-blobs.db"));codec_fallback(h_join(work,"codec-fallback.db"));release_pages(h_join(work,"release-pages.db"));h_print(1,"FlexDB external blobs: threshold, Zstd/raw ratios, streaming, stable IDs, metadata-only writes, rollback, captured versions, compaction, corruption and every torn prefix pass\n");return 0;}
