import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
extend "../schema.flex";
extend "../compile.flex" with "number";
extend "../compile.flex" with "named";
extend "../compile.flex" with "nullable";
extend "../compile.flex" with "broad";
database App {table Person {id: rowid; n: i64; name: text; maybe: i64?;}}
fn alias(row) {let r=row;return Person_n(r);}
fn number(row,n) {return n==alias(row);}
fn named(row,name) {return fd_same(Person_name(row),name);}
fn nullable(row,n) {return Person_maybe(row)==n;}
fn broad(row,n) {return Person_n(row)>=n;}
fn values(db,n,name) {let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,n));flexdb_add(db,v,flexdb_text(db,name));flexdb_add(db,v,flexdb_null(db));return v;}
fn matches(t,key) {let n=0;let i=0;while i<fd_size(load64(t+24)) {let row=fd_table_row(t,i);if load64(row+8) && number(row,key) {n=n+1;}i=i+1;}return n;}
fn bounds(db) {
 flexdb_begin(db);let schema=flexdb_schema(db);flexdb_column(db,schema,"n",1,0);let t=flexdb_create(db,"bounds",schema);let v=flexdb_values(db);let value=flexdb_int(db,0);flexdb_add(db,v,value);let i=0;while i<512 {store64(value+8,i%32);flexdb_insert(t,v);i=i+1;}flexdb_commit(db);i=0;while i<80 {h_assert(number_count(t,12)==16,"duplicate bounds learning");i=i+1;}let x=fd_auto_find(t,0);h_assert(x && load64(x+176) && load64(x+160)==0 && load64(x+168)==31,"learned conservative integer bounds");h_assert(number_count(t,-1)==0 && number_count(t,32)==0,"bounds reject out-of-range keys");let q=flexdb_query(db);h_assert(flexdb_count(number_query(q,t,32))==0,"query bounds miss");flexdb_query_close(q);
 flexdb_begin(db);store64(value+8,1<<63);flexdb_update(t,1,v);store64(value+8,9223372036854775807);flexdb_insert(t,v);h_assert(number_count(t,1<<63)==1 && number_count(t,9223372036854775807)==1,"transaction scans keys outside existing bounds");flexdb_rollback(db);h_assert(number_count(t,1<<63)==0 && number_count(t,9223372036854775807)==0 && load64(x+160)==0 && load64(x+168)==31,"rollback preserves bounds");
 flexdb_begin(db);store64(value+8,1<<63);flexdb_update(t,1,v);store64(value+8,9223372036854775807);flexdb_insert(t,v);flexdb_commit(db);h_assert(number_count(t,1<<63)==1 && number_count(t,9223372036854775807)==1 && load64(x+160)==(1<<63) && load64(x+168)==9223372036854775807,"committed updates and inserts widen signed bounds");flexdb_begin(db);flexdb_delete(t,1);flexdb_delete(t,513);flexdb_commit(db);h_assert(number_count(t,1<<63)==0 && number_count(t,9223372036854775807)==0 && number_count(t,12)==16 && flexdb_integrity(db),"deletes keep conservative bounds and invalidate count memo");return 1;
}
fn avoid_useless(db) {
 h_assert(flexdb_begin(db),"unhelpful index schema");let schema=flexdb_schema(db);flexdb_column(db,schema,"n",1,0);let tiny=flexdb_create(db,"tiny",schema);let broad=flexdb_create(db,"broad",schema);let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,0));let i=0;while i<1024 {h_assert(flexdb_insert(broad,v),"broad insert");if i<32 {h_assert(flexdb_insert(tiny,v),"tiny insert");}i=i+1;}h_assert(flexdb_commit(db),"unhelpful commit");i=0;while i<40 {h_assert(number_count(tiny,0)==32 && number_count(broad,0)==1024,"unhelpful query results");i=i+1;}h_assert(flexdb_index_state(tiny,0)==1 && flexdb_index_state(broad,0)==1,"avoid small and low-selectivity indexes");return 0;
}
fn collision_and_policy(db) {
 h_assert(flexdb_begin(db),"collision schema");let schema=flexdb_schema(db);flexdb_column(db,schema,"name",2,0);let t=flexdb_create(db,"collision",schema);let prefix=h_take(65);let i=0;while i<64 {store8(prefix+i,120);i=i+1;}store8(prefix+64,0);i=0;
 while i<1024 {let v=flexdb_values(db);flexdb_add(db,v,flexdb_text(db,h_cat(prefix,h_int(10000+i))));h_assert(flexdb_insert(t,v),"collision insert");i=i+1;}h_assert(flexdb_commit(db),"collision commit");
 let p=fd_auto_policy(db);let old_limit=load64(p+48);store64(p+48,1);let key=h_cat(prefix,"10512");i=0;while i<40 {let x=fd_auto_prepare(t,0,2,key);h_assert(!x,"bounded build abort falls back");fd_auto_done(t,0,1,1);i=i+1;}h_assert(flexdb_index_state(t,0)==1,"deadline abandons cache only");store64(p+48,old_limit);store64(fd_auto_find(t,0)+104,0);let x=fd_auto_prepare(t,0,2,key);h_assert(x && fd_auto_integrity(t),"collision index builds correctly");
 let hash=fd_auto_hash(2,key);let slot=hash&(load64(x+56)-1);let left=load64(x+56);let found=0;while left {let id=fd_auto_bucket(x,slot,hash);if !id {left=1;}else if id>0 {let row=flexdb_get(t,id);if fd_same(flexdb_word(flexdb_cell(row,0)),key) {found=found+1;}}slot=(slot+1)&(load64(x+56)-1);left=left-1;}h_assert(found==1,"hash collisions require full predicate recheck");
 // LRU eviction is physical only, and old entries eventually expire.
 store64(p+8,32768);h_assert(fd_auto_room(db,0,0) && flexdb_index_bytes(db)<=32768,"LRU enforces total byte budget");store64(p,load64(p)+2048);fd_auto_expire(db);h_assert(flexdb_index_bytes(db)==0,"unused cache expires");store64(p+8,8388608);return 0;
}
fn corrupt_index(path,db,t) {
 h_assert(flexdb_checkpoint(db),"corruption seed checkpoint");let x=fd_auto_find(t,0);h_assert(x && load64(x+48),"corruption seed index");let offset=0;let mapped=load64(db+128);if !load64(x+96) {offset=load64(x+48)-mapped;}close_flexdb(db);
 // Reopen obtains the persisted bucket offset, even if the source was RAM.
 db=App_open(path);t=Person_table(db);x=fd_auto_find(t,0);offset=load64(x+48)-load64(db+128);let cp=load64(db+144);h_assert(offset>0,"mapped bucket offset");close_flexdb(db);let all=h_read(path);let size=h_file_size;let legacy=h_take(size);h_copy(legacy,all,size);fd_copy(legacy+cp,"FLEXCP02",8);let meta=load64(legacy+cp+32);let crc=fd_crc(fd_crc(4294967295,legacy+cp,24),legacy+cp+32,meta)^4294967295;store64(legacy+cp+24,crc|((fd_crc(4294967295,legacy+cp,24)^4294967295)<<32));let oldpath=h_cat(path,".old-hash");let oldfd=syscall(2,oldpath,0x80241,384,0,0,0);h_assert(oldfd>=0 && fd_io(oldfd,legacy,size,0,1),"CP02 fixture write");syscall(3,oldfd,0,0,0,0,0);db=App_open(oldpath);t=Person_table(db);h_assert(db && flexdb_index_state(t,0)==1 && !flexdb_index_bytes(db),"CP02 rows/statistics open without restoring obsolete hash caches");h_assert(flexdb_auto_budget(db,0) && number_count(t,42)==matches(t,42),"old checkpoint counts match original rows");close_flexdb(db);let fixture=h_cat(path,".bad-index");store8(all+offset,load8(all+offset)^1);let fd=syscall(2,fixture,0x80241,384,0,0,0);h_assert(fd>=0 && fd_io(fd,all,size,0,1),"corruption fixture");syscall(3,fd,0,0,0,0,0);let before=h_sha(fixture);db=App_open(fixture);h_assert(db && !flexdb_integrity(db) && load64(db+48)==2 && h_has(flexdb_error(db),"index"),"bucket corruption poisons on integrity check");close_flexdb(db);h_assert(fd_same(before,h_sha(fixture)),"corruption never rewrites data");return 0;
}
fn omitted_cache(path) {
 let db=open_flexdb(path);h_assert(db && flexdb_begin(db),"large cache open");let schema=flexdb_schema(db);flexdb_column(db,schema,"n",1,0);let t=flexdb_create(db,"large",schema);let v=flexdb_values(db);let value=flexdb_int(db,0);flexdb_add(db,v,value);let i=0;
 while i<262144 {store64(value+8,i);h_assert(flexdb_insert(t,v)==i+1,"large cache insert");i=i+1;}h_assert(flexdb_commit(db),"large cache commit");let x=0;i=0;while i<5 {x=fd_auto_prepare(t,0,1,42);fd_auto_done(t,0,1,!x);i=i+1;}h_assert(x && flexdb_index_bytes(db)==8388608,"maximum default cache");h_assert(flexdb_checkpoint(db) && close_flexdb(db),"data checkpoint fits by omitting optional buckets");
 db=open_flexdb(path);t=flexdb_table(db,"large");h_assert(db && flexdb_index_state(t,0)==1 && flexdb_index_queries(t,0)==5 && !load64(db+184),"omitted cache retains usage and lazy rows");h_assert(flexdb_word(flexdb_cell(flexdb_get(t,43),0))==42 && flexdb_integrity(db),"omitted cache preserves all rows");close_flexdb(db);return 0;
}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"autoindex path");let db=App_open(load64(argv+8));h_assert(db,"open");let t=Person_table(db);h_assert(number_plan()==2 && named_plan()==2 && nullable_plan()==2 && broad_plan()==0,"compiler recognizes equality helpers");
 h_assert(flexdb_begin(db),"begin");let i=0;while i<10000 {h_assert(flexdb_insert(t,values(db,i%1000,h_int(i%1000))),"insert");i=i+1;}h_assert(flexdb_insert(t,values(db,1<<63,"minimum")) && flexdb_insert(t,values(db,9223372036854775807,"maximum")),"extreme integer keys");h_assert(flexdb_commit(db),"commit");
 i=0;while i<8 {h_assert(number_count(t,42)==10,"numeric learning");h_assert(named_count(t,"42")==10,"text learning");i=i+1;}h_assert(flexdb_index_state(t,0)==2 && flexdb_index_state(t,1)==2,"learned indexes active");h_assert(flexdb_index_bytes(db)==1048576+4096*24,"bounded bucket bytes");h_assert(number_count(t,1<<63)==1 && number_count(t,9223372036854775807)==1,"extreme signed integer hashing");
 let q=flexdb_query(db);let r=number_query(q,t,42);i=0;while i<10 {h_assert(flexdb_rowid(flexdb_at(r,i))==43+i*1000,"indexed ordering");i=i+1;}flexdb_query_close(q);
 h_assert(nullable_count(t,0)==10002 && flexdb_index_state(t,2)==0,"nullable raw zero keeps scan semantics");
 h_assert(flexdb_begin(db),"edit begin");h_assert(flexdb_update(t,43,values(db,-9,"changed")),"update");h_assert(number_count(t,42)==9 && number_count(t,-9)==1,"transaction uses current rows");h_assert(flexdb_rollback(db),"rollback");h_assert(number_count(t,42)==10 && named_count(t,"42")==10,"rollback preserves index");
 h_assert(flexdb_begin(db),"edit begin");h_assert(flexdb_update(t,43,values(db,-9,"changed")),"update");h_assert(flexdb_update(t,43,values(db,-10,"changed twice")),"repeat update");h_assert(flexdb_delete(t,1043),"delete");h_assert(flexdb_insert(t,values(db,42,"42")),"append");h_assert(flexdb_commit(db),"edit commit");h_assert(number_count(t,42)==9 && named_count(t,"42")==9 && number_count(t,-10)==1 && named_count(t,"changed twice")==1,"maintained indexes");
 i=0;while i<80 {let key=(i*71)%1000;h_assert(number_count(t,key)==matches(t,key),"indexed results equal scan");i=i+1;}h_assert(flexdb_index_hits(t,0)>70,"actual indexed lookups");
 // A deterministic mixed-key batch checks incremental maintenance against scans.
 h_assert(flexdb_begin(db),"model batch");let seed=17;i=0;while i<180 {seed=(seed*1103515245+12345)&2147483647;let id=seed%10000+1;if flexdb_get(t,id) {let n=(seed/17)%1300-150;h_assert(flexdb_update(t,id,values(db,n,h_int(n))),"model update");if i%11==0 {h_assert(flexdb_update(t,id,values(db,n+1,h_int(n+1))),"model repeated update");}}i=i+1;}h_assert(flexdb_rollback(db),"model rollback");h_assert(number_count(t,42)==9,"model rollback retains buckets");
 // Reopening reuses mapped buckets and decodes only matching rows.
 h_assert(flexdb_checkpoint(db) && close_flexdb(db),"persist learned indexes");db=App_open(load64(argv+8));t=Person_table(db);h_assert(db && load64(db+184)==0 && flexdb_index_state(t,0)==2 && flexdb_index_state(t,1)==2,"reopen learned indexes lazily");h_assert(number_count(t,42)==9 && load64(db+184)==9,"indexed reopen hydrates only matches");
 h_assert(flexdb_begin(db),"mapped edit");h_assert(flexdb_update(t,2043,values(db,-11,"mapped update")) && flexdb_commit(db),"copy mapped buckets on commit");h_assert(number_count(t,42)==8 && named_count(t,"mapped update")==1 && flexdb_integrity(db),"mapped maintenance and integrity");
 h_assert(flexdb_compact(db) && close_flexdb(db),"compact learned indexes");db=App_open(load64(argv+8));t=Person_table(db);h_assert(db && !load64(db+184) && number_count(t,42)==8,"compacted index survives reopen");
 h_assert(flexdb_begin(db),"committed model batch");i=0;while i<120 {let id=5000+(i*31)%4000;if id%1000==43 {id=id+1;}let n=(i*113)%1300-150;if n==42 {n=41;}h_assert(flexdb_update(t,id,values(db,n,h_int(n))),"committed model update");i=i+1;}h_assert(flexdb_commit(db),"model commit");i=0;while i<120 {let key=(i*71)%1300-150;h_assert(number_count(t,key)==matches(t,key),"committed model matches scan");i=i+1;}h_assert(flexdb_integrity(db),"committed model index integrity");
 // Simulate a durable transaction followed by process exit before checkpoint.
 h_assert(flexdb_begin(db) && flexdb_update(t,3043,values(db,-12,"tail update")) && flexdb_commit(db),"tail commit");store64(db+224,0);store64(db+152,load64(db+56));h_assert(close_flexdb(db),"tail-only close fixture");db=App_open(load64(argv+8));t=Person_table(db);h_assert(db && flexdb_index_state(t,0)==2 && number_count(t,42)==7 && named_count(t,"tail update")==1,"tail replay maintains derived buckets without rebuilding");h_assert(flexdb_integrity(db),"tail integrity");
 h_assert(flexdb_auto_budget(db,0),"disable budget");h_assert(flexdb_index_bytes(db)==0 && number_count(t,42)==7 && flexdb_index_state(t,0)==0,"disable frees indexes");h_assert(flexdb_auto_budget(db,8388608),"enable");i=0;while i<6 {number_count(t,42);i=i+1;}h_assert(flexdb_index_state(t,0)==2,"relearn");
 h_assert(flexdb_begin(db) && fd_replace_schema(t,load64(t+16),load64(t+24)),"schema replacement");h_assert(flexdb_index_state(t,0)==0 && flexdb_rollback(db) && number_count(t,42)==7,"schema rollback safely forgets caches");
 bounds(db);avoid_useless(db);collision_and_policy(db);i=0;while i<8 {number_count(t,42);i=i+1;}store64(fd_auto_find(t,0)+104,0);number_count(t,42);h_assert(flexdb_index_state(t,0)==2,"relearn after eviction");corrupt_index(load64(argv+8),db,t);omitted_cache(h_cat(load64(argv+8),".omitted"));h_print(1,"FlexDB adaptive indexes: compiler, learning, ordering, commits, rollback and budgets pass\n");return 0;
}
