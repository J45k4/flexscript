import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
extend "../schema.flex";
fn json_upgrade(db,v) {return flexdb_json(db,flexdb_word(v));}
database JsonTest {table JsonDocs {id: rowid; name: text; document: json using json_upgrade; optional: json?;}}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"JSON fixture path");let db=JsonTest_open(load64(argv+8));h_assert(db,"open JSON schema");let q=flexdb_query(db);
 let invalid=h_args("", "{", "[1,]", "{\"a\":}", "01", "1.");h_add(invalid,"1e");h_add(invalid,"NaN");h_add(invalid,"true false");h_add(invalid,"\"\\uD800\"");h_add(invalid,"\"\\uDC00\"");h_add(invalid,"\"\\x00\"");let i=0;while i<h_count(invalid) {h_assert(!flexdb_json(q,h_at(invalid,i)),"invalid JSON rejected without terminating caller");i=i+1;}
 let bad=h_take(6);store8(bad,34);store8(bad+1,192);store8(bad+2,128);store8(bad+3,34);h_assert(!flexdb_json(q,bad),"overlong UTF-8 rejected");
 let deep=h_take(140);let di=0;while di<66 {store8(deep+di,91);store8(deep+66+di,93);di=di+1;}h_assert(!flexdb_json(q,deep),"nesting depth bounded");
 h_assert(fd_same(flexdb_word(flexdb_json_get(q,flexdb_json(q,"{\"\":1,\"x\":2,\"x\":3}"),"/x")),"3"),"duplicate names select last member");
 let value=flexdb_json(q," { \"name\" : \"Puppy\\u0043orp\", \"arr\": [1,{\"name\":\"Mira\"}], \"a/b\": {\"~key\": 7}, \"nil\":null, \"yes\":true, \"zero\":\"\\u0000\", \"min\":-9223372036854775808, \"tooBig\":9223372036854775808, \"emoji\":\"\\uD83D\\uDC36\" } ");h_assert(value && flexdb_kind(value)==5,"native JSON type");
 h_assert(fd_same(flexdb_word(flexdb_json_text(q,value,"/name")),"PuppyCorp"),"decode escaped string");h_assert(fd_same(flexdb_word(flexdb_json_text(q,value,"/arr/1/name")),"Mira"),"nested array/object query");h_assert(flexdb_word(flexdb_json_int(q,value,"/a~1b/~0key"))==7,"RFC 6901 escaped keys");h_assert(flexdb_word(flexdb_json_int(q,value,"/min"))==0x8000000000000000,"signed minimum");h_assert(!flexdb_kind(flexdb_json_int(q,value,"/tooBig")),"integer overflow is SQL NULL");h_assert(!flexdb_kind(flexdb_json_get(q,value,"/missing")),"missing is SQL NULL");h_assert(flexdb_kind(flexdb_json_get(q,value,"/nil"))==5,"JSON null distinct from SQL NULL");h_assert(!flexdb_kind(flexdb_json_get(q,value,"/arr/01")),"array indices reject leading zero");h_assert(!flexdb_json_get(q,value,"/bad~2escape"),"bad pointer rejected");h_assert(!flexdb_kind(flexdb_json_text(q,value,"/zero")),"NUL text requires raw JSON extraction");h_assert(flexdb_bytes(flexdb_json_text(q,value,"/emoji"))==4,"surrogate-pair UTF-8 extraction");
 h_assert(flexdb_begin(db),"begin");let t=JsonDocs_table(db);let values=JsonDocs_values(q,"first",flexdb_word(value),flexdb_null(q));h_assert(flexdb_insert(t,values)==1,"insert JSON");values=JsonDocs_values(q,"second","{\"arr\":[2],\"nil\":false}",flexdb_json(q,"null"));h_assert(flexdb_insert(t,values)==2 && flexdb_commit(db),"commit");
 let all=flexdb_scan(q,t);h_assert(flexdb_count(flexdb_where_json(q,all,1,"/arr/0",flexdb_ge(),flexdb_int(q,2)))==1,"integer path filter");h_assert(flexdb_count(flexdb_where_json(q,all,1,"/arr/1/name",flexdb_eq(),flexdb_text(q,"Mira")))==1,"text path filter");h_assert(flexdb_count(flexdb_where_json(q,all,1,"/nil",flexdb_eq(),flexdb_json(q,"null")))==1,"JSON-null path filter excludes missing");
 flexdb_query_close(q);h_assert(close_flexdb(db),"close transaction log");db=JsonTest_open(load64(argv+8));h_assert(db,"replay JSON log");t=JsonDocs_table(db);q=flexdb_query(db);h_assert(flexdb_kind(flexdb_cell(flexdb_get(t,1),1))==5,"replayed JSON tag");
 h_assert(flexdb_begin(db),"rollback begin");values=JsonDocs_values(q,"third","{}",flexdb_null(q));h_assert(flexdb_insert(t,values)==3 && flexdb_rollback(db) && !flexdb_get(t,3),"rollback JSON insert");h_assert(flexdb_checkpoint(db),"checkpoint JSON");flexdb_query_close(q);h_assert(close_flexdb(db),"close");
 db=JsonTest_open(load64(argv+8));h_assert(db && flexdb_integrity(db),"reopen checkpoint integrity");t=JsonDocs_table(db);q=flexdb_query(db);h_assert(fd_same(flexdb_word(flexdb_json_text(q,flexdb_cell(flexdb_get(t,1),1),"/name")),"PuppyCorp"),"JSON survives checkpoint reopen");
 h_assert(flexdb_compact(db) && flexdb_integrity(db),"JSON survives compaction");flexdb_query_close(q);h_assert(close_flexdb(db),"close compacted");db=JsonTest_open(load64(argv+8));h_assert(db && flexdb_kind(flexdb_cell(flexdb_get(JsonDocs_table(db),2),2))==5,"optional JSON null survives compact reopen");close_flexdb(db);
 // Cross the native-packing threshold: JSON tables must use the safe fallback.
 db=JsonTest_open(load64(argv+8));t=JsonDocs_table(db);q=flexdb_query(db);h_assert(flexdb_begin(db),"bulk JSON begin");let bulk=0;while bulk<140 {h_assert(flexdb_insert(t,JsonDocs_values(q,"bulk","{\"n\":42}",flexdb_null(q))),"bulk JSON insert");bulk=bulk+1;}h_assert(flexdb_commit(db) && flexdb_checkpoint(db),"large JSON checkpoint packing");flexdb_query_close(q);close_flexdb(db);db=JsonTest_open(load64(argv+8));q=flexdb_query(db);all=flexdb_scan(q,JsonDocs_table(db));h_assert(flexdb_count(flexdb_where_json(q,all,1,"/n",flexdb_eq(),flexdb_int(q,42)))==140 && flexdb_integrity(db),"large JSON checkpoint decode and filter");flexdb_query_close(q);close_flexdb(db);
 let migration=h_cat(load64(argv+8),".migration");db=open_flexdb(migration);h_assert(flexdb_begin(db),"seed text schema");let schema=flexdb_schema(db);flexdb_column(db,schema,"name",2,0);flexdb_column(db,schema,"document",2,0);flexdb_column(db,schema,"optional",5,1);t=flexdb_create(db,"JsonDocs",schema);let vals=flexdb_values(db);flexdb_add(db,vals,flexdb_text(db,"legacy"));flexdb_add(db,vals,flexdb_text(db,"{\"n\":7}"));flexdb_add(db,vals,flexdb_null(db));h_assert(flexdb_insert(t,vals) && flexdb_commit(db) && JsonTest_init(db),"text to native JSON reconciliation");h_assert(flexdb_kind(flexdb_cell(flexdb_get(t,1),1))==5,"migration persists JSON tag");close_flexdb(db);
 h_print(1,"FlexDB JSON passed: validation, UTF-8, pointers, filters, NULL distinction, transactions, checkpoint and compaction\n");return 0;
}
