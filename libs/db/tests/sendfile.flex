import "db/flexdb.flex";
import "monolith/support.flex";
fn check(ok,msg) {if !ok {m_print(2,msg);m_print(2,"\n");syscall(60,1,0,0,0,0,0);}return 0;}
fn put(db,table,bytes,n) {let q=flexdb_query(db);let values=flexdb_values(q);flexdb_add(q,values,flexdb_blob(q,bytes,n));let id=flexdb_insert(table,values);flexdb_query_close(q);return id;}
fn main(argc,argv) {
 check(argc==2,"path");let db=open_flexdb(load64(argv+8));check(db && flexdb_begin(db),"open");let cols=flexdb_schema(db);flexdb_column(db,cols,"data",3,0);let table=flexdb_create(db,"files",cols);check(table && flexdb_commit(db),"schema");
 let n=524288;let input=alloc(n);let seed=123456789;let i=0;while i<n {seed=seed^(seed<<13);seed=seed^(seed>>7);seed=seed^(seed<<17);store8(input+i,seed);i=i+1;}
 check(flexdb_begin(db),"begin");let id=put(db,table,input,n);let pending=flexdb_cell(flexdb_get(table,id),0);let position=alloc(8);let pair=alloc(8);check(syscall(53,1,1|0x800,0,pair,0,0)==0,"socketpair");let write=load64(pair)&4294967295;let read=load64(pair)>>32;
 check(flexdb_blob_sendfile(table,id,0,write,0,1,position)==(-95),"pending fallback");check(flexdb_commit(db),"commit");let blob=flexdb_cell(flexdb_get(table,id),0);check(flexdb_blob_external(blob) && !flexdb_blob_codec(blob),"raw blob");
 let out=alloc(16384);let at=0;while at<n {let want=16384;if n-at<want {want=n-at;}let sent=flexdb_blob_sendfile(table,id,0,write,at,want,position);check(sent>0 && sent<=want,"sendfile");let got=0;while got<sent {let readn=syscall(0,read,out+got,sent-got,0,0,0);check(readn>0,"read socket");got=got+readn;}i=0;while i<sent {check(load8(out+i)==load8(input+at+i),"bytes");i=i+1;}at=at+sent;if at==262144 {check(!load64(load64(blob+8)+56),"sendfile does not retain blob mapping");check(flexdb_compact(db),"compact during transfer");}}
 check(flexdb_blob_release_pages(blob),"release");check(flexdb_blob_sendfile(table,id,0,write,n+1,1,position)==(-22),"range");check(flexdb_begin(db) && flexdb_delete(table,id) && flexdb_commit(db) && flexdb_compact(db),"delete and compact");check(flexdb_blob_sendfile(table,id,0,write,0,1,position)==(-22),"deleted row is unavailable");check(flexdb_begin(db),"zeros begin");let zeros=alloc(n);id=put(db,table,zeros,n);check(flexdb_commit(db),"zeros commit");blob=flexdb_cell(flexdb_get(table,id),0);check(flexdb_blob_codec(blob)==1 && flexdb_blob_sendfile(table,id,0,write,0,1,position)==(-95),"compressed fallback");check(flexdb_begin(db),"corruption begin");let corrupt_id=put(db,table,input,n);check(flexdb_commit(db),"corruption commit");let corrupt=flexdb_cell(flexdb_get(table,corrupt_id),0);let disk_offset=load64(load64(corrupt+8)+16)+64;check(close_flexdb(db),"close");let file=syscall(2,load64(argv+8),2,0,0,0,0);check(file>=0,"open corrupt fixture");let byte=alloc(1);store8(byte,load8(input)^1);check(syscall(18,file,byte,1,disk_offset,0,0)==1,"corrupt fixture");syscall(3,file,0,0,0,0,0);db=open_flexdb(load64(argv+8));check(db,"reopen corrupt fixture");table=flexdb_table(db,"files");check(flexdb_blob_sendfile(table,corrupt_id,0,write,0,1,position)==(-5),"checksum blocks corrupt sendfile");close_flexdb(db);m_print(1,"FlexDB verified raw sendfile, compaction, corruption and compressed/pending fallback passed\n");return 0;
}
