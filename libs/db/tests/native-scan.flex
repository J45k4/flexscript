import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
fn wide_value(db,i,j,kind,nullable) {
 if nullable && (i+j)%5==0 {return flexdb_null(db);}if kind==1 {let word=-i*100-j;if i%7==0 {word=1<<63;}if i%11==0 {word=9223372036854775807;}return flexdb_int(db,word);}if kind==2 {return flexdb_text(db,h_cat("utf8 ä ",h_int(i+j)));}if kind==3 {return flexdb_blob(db,"\0x\0y\0",5);}return flexdb_real(db,0x7ff8000000000001);
}
fn compare(t,col) {
 let db=load64(t);let native=fd_crc_code;h_assert(native>0,"native CRC available for native scan checks");fd_cp_cache_clear(t);let view=fd_cp_scalar_cache(t,col);let n=load64(t+80);h_assert(view,"native wide scalar view");let copy=h_take(n*16);h_copy(copy,load64(view+24),n*16);fd_cp_cache_clear(t);fd_crc_code=-1;view=fd_cp_scalar_cache(t,col);h_assert(view && fd_bytes(copy,load64(view+24),n*16),"native/Flexscript scalar views match every bit/live flag");fd_crc_code=native;fd_cp_cache_clear(t);return 1;
}
fn guarded(path) {
 let db=open_flexdb(path);let s=flexdb_schema(db);flexdb_column(db,s,"n",1,0);let t=fd_table_new(db,"guard",s);let rows=load64(t+24);store64(rows,8);store64(rows+8,8);store64(rows+16,fd_alloc(db,8));store64(t+32,2);let p=syscall(9,0,8192,3,34,-1,0);h_assert(p>0 && syscall(10,p+4096,4096,0,0,0,0)==0,"native scan guard page");store64(p+4080,0);store64(p+4088,99);let directory=fd_alloc(db,16);store64(directory,4080);store64(directory+8,16|((fd_crc(4294967295,p+4080,16)^4294967295)<<32));let checks=fd_alloc(db,8);store64(checks,fd_crc(4294967295,directory,16)^4294967295);store64(t+64,directory);store64(t+72,p);store64(t+80,1);store64(t+88,checks);store64(t+96,fd_alloc(db,1));store64(t+104,4096);store64(t+112,16);let view=fd_cp_scalar_cache(t,0);h_assert(view && load64(load64(view+24))==99 && load64(load64(view+24)+8)==1,"native row ends exactly at inaccessible page");compare(t,0);close_flexdb(db);syscall(11,p,8192,0,0,0,0);return 1;
}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"native scan path");let path=load64(argv+8);let db=open_flexdb(path);h_assert(db && flexdb_begin(db),"wide seed begin");let s=flexdb_schema(db);let j=0;while j<64 {let kind=1+j%4;if j==63 {kind=1;}let nullable=j%3!=0;if j==0 || j==63 {nullable=1;}h_assert(flexdb_column(db,s,h_int(j),kind,nullable)>=0,"wide column");j=j+1;}let t=flexdb_create(db,"wide",s);let required=flexdb_schema(db);j=0;while j<64 {let c=fd_at(s,j);let nullable=load64(c+16);if j==63 {nullable=0;}flexdb_column(db,required,h_int(j),load64(c+8),nullable);j=j+1;}let r=flexdb_create(db,"required",required);let i=0;while i<320 {let v=flexdb_values(db);j=0;while j<64 {let c=fd_at(s,j);flexdb_add(db,v,wide_value(db,i,j,load64(c+8),load64(c+16)));j=j+1;}h_assert(flexdb_insert(t,v),"wide seed row");fd_put(v,63,wide_value(db,i,63,1,0));h_assert(flexdb_insert(r,v),"required high-bit seed row");i=i+1;}h_assert(flexdb_delete(t,17) && flexdb_delete(t,270) && flexdb_commit(db) && flexdb_checkpoint(db) && close_flexdb(db),"wide checkpoint");db=open_flexdb(path);t=flexdb_table(db,"wide");h_assert(db && flexdb_get(t,1) && flexdb_get(t,300),"known RAM rows skipped by views");compare(t,0);compare(t,63);r=flexdb_table(db,"required");compare(r,0);compare(r,63);h_assert(load64(db+184)==2,"scalar scans never hydrate unrelated rows");close_flexdb(db);guarded(h_cat(path,".guard"));
 h_print(1,"FlexDB native scans: 64 mixed fields, nullable high bit, extreme integers, multi-page directories, tombstones, RAM rows, reference parity and guard page pass\n");return 0;
}
