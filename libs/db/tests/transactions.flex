import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
fn values(db,n) {let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,n));return v;}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"transaction fixture path");let path=load64(argv+8);let db=open_flexdb(path);h_assert(db && flexdb_begin(db),"seed begin");let schema=flexdb_schema(db);flexdb_column(db,schema,"n",1,0);let t=flexdb_create(db,"t",schema);h_assert(t && flexdb_insert(t,values(db,7)) && flexdb_commit(db),"seed commit");let before=h_sha(path);let sequence=load64(db+64);let old=flexdb_get(t,1);let i=0;
 while i<100 {h_assert(flexdb_begin(db) && !load64(db+72) && !flexdb_begin(db) && load64(db+48)==1,"empty begin is allocation-free and nested begin rejected");h_assert(flexdb_word(flexdb_cell(flexdb_get(t,1),0))==7 && flexdb_commit(db),"read/empty commit");h_assert(flexdb_begin(db) && flexdb_rollback(db),"empty rollback");i=i+1;}h_assert(load64(db+64)==sequence && fd_same(before,h_sha(path)),"empty transactions append nothing");
 h_assert(flexdb_begin(db),"invalid mutation begin");let invalid=flexdb_values(db);flexdb_add(db,invalid,flexdb_text(db,"wrong"));h_assert(!flexdb_update(t,1,invalid) && !load64(db+72) && flexdb_commit(db),"rejected value before preparation remains empty");h_assert(flexdb_begin(db) && !fd_command(db,16777217) && load64(db+72) && flexdb_commit(db),"prepared but rejected command commits no stale frame");h_assert(load64(db+64)==sequence && fd_same(before,h_sha(path)),"invalid empty mutations preserve file and sequence");
 let current=7;i=0;while i<100 {h_assert(flexdb_begin(db) && flexdb_update(t,1,values(db,100+i)),"reused transaction first update");h_assert(flexdb_update(t,1,values(db,200+i)) && flexdb_insert(t,values(db,300+i)) && flexdb_delete(t,1),"reused undo and insert batch");if i%2 {h_assert(flexdb_rollback(db) && flexdb_word(flexdb_cell(flexdb_get(t,1),0))==current,"reused arena rollback restores exact original row");}else {h_assert(flexdb_rollback(db),"mixed rollback");h_assert(flexdb_begin(db) && flexdb_update(t,1,values(db,i)) && flexdb_commit(db),"reused arena durable commit");current=i;}h_assert(!flexdb_get(t,2) && load64(t+32)==2,"reused snapshots preserve next ID");i=i+1;}
 h_assert(flexdb_word(flexdb_cell(old,0))==7,"captured row is independent of transaction arena reuse");before=h_sha(path);h_assert(flexdb_begin(db) && close_flexdb(db),"close untouched active transaction");h_assert(fd_same(before,h_sha(path)),"untouched close writes nothing");db=open_flexdb(path);t=flexdb_table(db,"t");h_assert(db && flexdb_word(flexdb_cell(flexdb_get(t,1),0))==current,"pooled committed rows replay");h_assert(flexdb_begin(db) && flexdb_update(t,1,values(db,999)) && close_flexdb(db),"close prepared uncommitted transaction");h_assert(fd_same(before,h_sha(path)),"prepared close rolls back on disk");db=open_flexdb(path);t=flexdb_table(db,"t");h_assert(db && flexdb_word(flexdb_cell(flexdb_get(t,1),0))==current,"prepared close retains acknowledged value");close_flexdb(db);
 h_print(1,"FlexDB transactions: lazy begin, empty/invalid commits, reused snapshots/undo, immutable rows and active close pass\n");return 0;
}
