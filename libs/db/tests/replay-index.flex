import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
extend "../compile.flex" with "number";
extend "../compile.flex" with "named";
fn number(row,key) {return flexdb_word(flexdb_cell(row,0))==key;}
fn named(row,key) {return fd_same(flexdb_word(flexdb_cell(row,1)),key);}
fn values(db,key,name) {let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,key));flexdb_add(db,v,flexdb_text(db,name));return v;}
fn write_file(path,p,n) {let fd=syscall(2,path,0x80241,384,0,0,0);h_assert(fd>=0 && fd_io(fd,p,n,0,1),"replay fixture write");syscall(3,fd,0,0,0,0,0);return 1;}
fn tail_close(db) {store64(db+224,0);store64(db+152,load64(db+56));return close_flexdb(db);}
fn malformed_tail(path,bytes,size,base_size) {
 let copy=h_take(size);h_copy(copy,bytes,size);let n=load64(copy+base_size+8);store64(copy+base_size+32,2);let payload=copy+base_size+32;let frame_crc=fd_crc(fd_crc(4294967295,copy+base_size,24),payload,n)^4294967295;store64(copy+base_size+24,frame_crc|((fd_crc(4294967295,copy+base_size,24)^4294967295)<<32));let test=h_cat(path,".semantic-error");write_file(test,copy,size);let before=h_sha(test);
 // The first operation is a valid indexed update. The false operation count
 // fails only after changing disposable caches; failed-open cleanup must not
 // checkpoint this partially replayed state over any bytes of the source file.
 h_assert(!open_flexdb(test) && fd_same(before,h_sha(test)),"semantic error after index replay never rewrites file");return 1;
}
fn corruption(path,bytes,size,base_size,index_offset,touched,untouched) {
 let copy=h_take(size);h_copy(copy,bytes,size);store8(copy+index_offset+touched*4096,load8(copy+index_offset+touched*4096)^1);let test=h_cat(path,".touched");write_file(test,copy,size);let before=h_sha(test);h_assert(!open_flexdb(test),"replay rejects corrupt source page before editing it");h_assert(fd_same(before,h_sha(test)),"rejected replay leaves corrupt file unchanged");
 let committed=h_cat(path,".commit-error");write_file(committed,copy,base_size);let broken=open_flexdb(committed);let table=flexdb_table(broken,"items");h_assert(broken && flexdb_begin(broken) && flexdb_update(table,8,values(broken,10000,"changed")),"prepare edit of unchecked corrupt index");h_assert(!flexdb_commit(broken) && load64(broken+48)==2 && h_has(flexdb_error(broken),"index"),"post-fsync maintenance failure retains poisoned state");before=h_sha(committed);h_assert(number_count(table,10000)==(-1),"poisoned connection rejects reads");close_flexdb(broken);h_assert(fd_same(before,h_sha(committed)),"poisoned close does not checkpoint or rewrite");
 h_copy(copy,bytes,size);store8(copy+index_offset+untouched*4096,load8(copy+index_offset+untouched*4096)^1);test=h_cat(path,".untouched");write_file(test,copy,size);before=h_sha(test);let db=open_flexdb(test);h_assert(db,"untouched corrupt page remains lazy during replay");h_assert(!flexdb_integrity(db) && load64(db+48)==2 && h_has(flexdb_error(db),"index"),"integrity checks untouched source before copying");close_flexdb(db);h_assert(fd_same(before,h_sha(test)),"lazy corruption leaves file unchanged");return 1;
}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"replay index path");let path=load64(argv+8);let db=open_flexdb(path);h_assert(db && flexdb_begin(db),"seed open");let s=flexdb_schema(db);flexdb_column(db,s,"key",1,0);flexdb_column(db,s,"name",2,0);let t=flexdb_create(db,"items",s);let i=0;
 while i<4096 {h_assert(flexdb_insert(t,values(db,i%32,h_int(i%32))),"seed row");i=i+1;}h_assert(flexdb_commit(db),"seed commit");i=0;while i<12 {h_assert(number_count(t,7)==128 && named_count(t,"7")==128,"learn duplicate indexes");i=i+1;}h_assert(flexdb_index_state(t,0)==2 && flexdb_index_state(t,1)==2 && flexdb_checkpoint(db) && close_flexdb(db),"persist indexes");
 db=open_flexdb(path);t=flexdb_table(db,"items");let x=fd_auto_find(t,0);let source=load64(x+48);let index_offset=source-load64(db+128);let base_size=load64(db+136);let snapshot=h_take(base_size);h_copy(snapshot,load64(db+128),load64(db+136));let old=flexdb_get(t,8);h_assert(!load64(x+96),"mapped index starts read only");flexdb_begin(db);flexdb_update(t,8,values(db,10000,"changed"));h_assert(number_count(t,10000)==1 && flexdb_rollback(db) && !load64(x+96),"rollback does not copy or edit persisted buckets");
 h_assert(flexdb_begin(db) && flexdb_update(t,8,values(db,10000,"changed")) && flexdb_commit(db),"first mapped edit");h_assert(load64(x+96)<0 && load64(x+88)==source && load64(x+48)!=source,"first edit owns sparse writable copy");let pages=(load64(x+56)*16+4095)/4096;let copied=0;let untouched=-1;i=0;while i<pages {let state=load8(load64(x+120)+i);if state==2 {copied=copied+1;}else if !state {untouched=i;}i=i+1;}h_assert(copied>0 && copied<pages && untouched>=0,"edit copies only accessed logical pages");let touched=(fd_auto_hash(1,7)&(load64(x+56)-1))/256;
 h_assert(fd_bytes(snapshot,load64(db+128),load64(db+136)) && flexdb_word(flexdb_cell(old,0))==7,"source mapping and captured row stay immutable");h_assert(tail_close(db),"leave committed tail without checkpoint");let bytes=h_read(path);let size=h_file_size;malformed_tail(path,bytes,size,base_size);corruption(path,bytes,size,base_size,index_offset,touched,untouched);
 db=open_flexdb(path);t=flexdb_table(db,"items");h_assert(db && flexdb_index_state(t,0)==2 && flexdb_index_state(t,1)==2 && load64(db+184)==1,"replay retains indexes and decodes only edited row");h_assert(number_count(t,7)==127 && number_count(t,10000)==1 && named_count(t,"changed")==1,"first post-replay queries use maintained indexes");
 h_assert(flexdb_begin(db),"mixed tail begin");h_assert(flexdb_update(t,8,values(db,-100,"twice")) && flexdb_update(t,8,values(db,-101,"final")) && flexdb_delete(t,9),"repeated update/delete");i=0;while i<20 {h_assert(flexdb_insert(t,values(db,-101,"final")),"typed batch inserts");i=i+1;}h_assert(flexdb_commit(db) && tail_close(db),"mixed tail durable");
 db=open_flexdb(path);t=flexdb_table(db,"items");h_assert(db && flexdb_index_state(t,0)==2 && flexdb_index_state(t,1)==2,"mixed replay keeps both indexes");h_assert(number_count(t,7)==127 && number_count(t,8)==127 && number_count(t,10000)==0 && number_count(t,-101)==21 && named_count(t,"changed")==0 && named_count(t,"final")==21 && !flexdb_get(t,9),"all replay mutations reflected including batch and duplicate keys");h_assert(flexdb_integrity(db),"sparse page copies satisfy whole index integrity");
 h_assert(flexdb_begin(db),"exhaust persisted capacity");i=0;while i<2500 {h_assert(flexdb_insert(t,values(db,-101,"final")),"grow index beyond capacity");i=i+1;}h_assert(flexdb_commit(db) && flexdb_index_state(t,0)==1 && flexdb_index_state(t,1)==1 && tail_close(db),"capacity exhaustion drops only derived caches");db=open_flexdb(path);t=flexdb_table(db,"items");h_assert(db && flexdb_index_state(t,0)==1 && number_count(t,-101)==2521 && named_count(t,"final")==2521 && flexdb_integrity(db),"capacity-exhausting replay preserves all committed rows");h_assert(flexdb_compact(db) && close_flexdb(db),"publish maintained indexes");db=open_flexdb(path);t=flexdb_table(db,"items");h_assert(db && !load64(db+184) && number_count(t,-101)==2521 && named_count(t,"final")==2521 && flexdb_integrity(db),"compacted copies reopen correctly");close_flexdb(db);
 h_print(1,"FlexDB replay indexes: sparse copies, rollback, source immutability, updates/deletes/batches, CRC failures and compaction pass\n");return 0;
}
