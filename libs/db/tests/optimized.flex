import "../flexdb.flex";
import "../../../scripts/lib/host.flex";
extend "../compile.flex" with "gte";
extend "../compile.flex" with "lte";
extend "../compile.flex" with "other";
fn other(row,n) {return flexdb_word(flexdb_cell(row,1))>=n;}
fn gte(row,n) {return flexdb_word(flexdb_cell(row,0))>=n;}
fn lte(row,n) {return n>=flexdb_word(flexdb_cell(row,0));}
fn strings() {
 let p=syscall(9,0,8192,3,34,-1,0);let r=syscall(9,0,8192,3,34,-1,0);h_assert(p>0 && r>0 && syscall(10,p+4096,4096,0,0,0,0)==0 && syscall(10,r+4096,4096,0,0,0,0)==0,"string guard pages");let n=0;
 while n<256 {let a=p+4095-n;let b=r+4095-n;let i=0;while i<n {let value=1+(i*37)%255;store8(a+i,value);store8(b+i,value);i=i+1;}store8(a+n,0);store8(b+n,0);h_assert(fd_len(a)==n && fd_same(a,b) && fd_bytes(a,b,n),"guarded strings and bytes");if n {store8(b+n-1,load8(b+n-1)^128);h_assert(!fd_same(a,b) && !fd_bytes(a,b,n),"guarded mismatches");}n=n+1;}
 syscall(11,p,8192,0,0,0,0);syscall(11,r,8192,0,0,0,0);return 1;
}
fn successor_build(db) {
    let cap=32;while cap<=512 {let x=fd_alloc(db,184);let y=fd_alloc(db,184);let t=fd_alloc(db,128);store64(t,db);store64(t+32,cap+1);store64(x+144,t);store64(y+144,t);store64(x+56,cap);store64(y+56,cap);store64(x+48,fd_alloc(db,cap*16));store64(y+48,fd_alloc(db,cap*16));let a=alloc(32);let parents=fd_alloc(a,cap*8);let i=0;while i<cap {store64(parents+i*8,i);i=i+1;}i=1;
        while i<=cap/2 {let hash=cap-1;if i%3==0 {hash=(i*37)&(cap-1);}if i%7==0 {hash=cap-2;}h_assert(fd_auto_insert_bucket(x,hash,i) && fd_auto_build_insert(y,parents,hash,i),"successor and ordinary insertion");h_assert(load64(x+64)==load64(y+64) && fd_bytes(load64(x+48),load64(y+48),cap*16),"successor produces exact linear-probing image across collisions/wrap");i=i+1;}fd_clear(a);syscall(11,a,32,0,0,0,0);cap=cap*2;}return 1;
}
fn hash_delete(db) {
 let t=fd_alloc(db,128);store64(t,db);store64(t+32,200);let x=fd_alloc(db,160);store64(x+144,t);store64(x+56,32);store64(x+48,fd_alloc(db,512));let i=1;while i<=20 {h_assert(fd_auto_insert_bucket(x,31+i*32,i),"wrapped probing insert");i=i+1;}i=1;
 while i<=20 {h_assert(fd_auto_remove_bucket(x,31+i*32,i),"wrapped backward shift");let j=i+1;while j<=20 {let slot=(31+j*32)&31;let left=32;let found=0;while left && !found {let e=load64(x+48)+slot*16;if !load64(e+8) {left=1;}else if load64(e+8)==j && load64(e)==31+j*32 {found=1;}slot=(slot+1)&31;left=left-1;}h_assert(found,"shift preserves later collision");j=j+1;}i=i+1;}h_assert(load64(x+64)==0,"shift deletes all");return 1;
}
fn values(db,n) {let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,n));return v;}
fn real_join(db) {
 flexdb_begin(db);let s=flexdb_schema(db);flexdb_column(db,s,"real",4,1);let t=flexdb_create(db,"real",s);let words=h_args(h_int(0),h_int(0),0,0,0,0);let i=0;while i<5 {let v=flexdb_values(db);let value=flexdb_real(db,0);if i==1 {value=flexdb_real(db,0x8000000000000000);}if i==2 {value=flexdb_real(db,0x7ff8000000000001);}if i==3 {value=flexdb_null(db);}if i==4 {value=flexdb_real(db,0x3ff0000000000000);}flexdb_add(db,v,value);flexdb_insert(t,v);i=i+1;}flexdb_commit(db);let q=flexdb_query(db);let all=flexdb_scan(q,t);let result=flexdb_join(q,all,0,all,0);h_assert(flexdb_count(result)==5,"hash join zero signs equal, NaN and null never match");flexdb_query_close(q);return 1;
}
fn scalar_views(path) {
 let db=open_flexdb(path);flexdb_begin(db);let schema=flexdb_schema(db);flexdb_column(db,schema,"n",1,0);flexdb_column(db,schema,"other",1,1);flexdb_column(db,schema,"text",2,0);let t=flexdb_create(db,"views",schema);let i=0;
 while i<100 {let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,i));let value=flexdb_int(db,i*2);if i%2==0 {value=flexdb_null(db);}flexdb_add(db,v,value);flexdb_add(db,v,flexdb_text(db,"unrelated payload"));flexdb_insert(t,v);i=i+1;}flexdb_delete(t,60);flexdb_commit(db);flexdb_checkpoint(db);close_flexdb(db);
 db=open_flexdb(path);t=flexdb_table(db,"views");h_assert(gte_count(t,40)==59 && load64(db+184)==0 && load64(t+56),"scalar view counts without row hydration");h_assert(other_count(t,100)==24 && load64(db+184)==0,"view switches columns, preserves null and tombstone semantics");h_assert(other_count(t,0)==99,"nullable getter zero matches existing semantics");
 let saved=flexdb_get(t,2);let v=flexdb_values(db);flexdb_add(db,v,flexdb_int(db,1000));flexdb_add(db,v,flexdb_int(db,2000));flexdb_add(db,v,flexdb_text(db,"updated"));flexdb_begin(db);flexdb_update(t,2,v);flexdb_delete(t,100);flexdb_insert(t,v);h_assert(gte_count(t,40)==60 && other_count(t,100)==25,"scalar view sees transaction edits, delete and insert");flexdb_rollback(db);h_assert(gte_count(t,40)==59 && flexdb_get(t,2)==saved && other_count(t,100)==24,"scalar view rollback and immutable captured row");
 flexdb_begin(db);flexdb_update(t,2,v);flexdb_commit(db);h_assert(gte_count(t,40)==60 && other_count(t,100)==25,"RAM edits override immutable checkpoint scalar view");h_assert(flexdb_compact(db) && !load64(t+56) && flexdb_word(flexdb_cell(saved,0))==1,"compaction releases private view and retains captured row");close_flexdb(db);db=open_flexdb(path);t=flexdb_table(db,"views");h_assert(gte_count(t,40)==60 && other_count(t,100)==25 && flexdb_integrity(db),"view values durable after compaction");close_flexdb(db);return 1;
}
fn scalar_corruption(path) {
 let db=open_flexdb(path);let t=flexdb_table(db,"views");let cp=load64(db+144);let dir=load64(t+64)-load64(db+128);let check=load64(t+88)-load64(db+128);let body=cp+32;let rows=load64(t+80);close_flexdb(db);let original=h_read(path);let size=h_file_size;let copy=h_take(size);let test=h_cat(path,".invalid");let mode=0;
 while mode<2 {h_copy(copy,original,size);let offset=load64(copy+dir);let packed=load64(copy+dir+8);let bytes=packed&4294967295;let p=copy+body+offset;if !mode {store64(p,load64(p)|1);}else {store64(p+16,1048577);}store64(copy+dir+8,bytes|((fd_crc(4294967295,p,bytes)^4294967295)<<32));let length=rows*16;if length>4096 {length=4096;}store64(copy+check,fd_crc(4294967295,copy+dir,length)^4294967295);let meta=load64(copy+body);let crc=fd_crc(fd_crc(4294967295,copy+cp,24),copy+body,meta)^4294967295;store64(copy+cp+24,crc|((fd_crc(4294967295,copy+cp,24)^4294967295)<<32));let fd=syscall(2,test,0x80241,384,0,0,0);h_assert(fd>=0 && fd_io(fd,copy,size,0,1),"invalid scalar-view fixture");syscall(3,fd,0,0,0,0,0);let before=h_sha(test);db=open_flexdb(test);h_assert(db && gte_count(flexdb_table(db,"views"),0)==(-1) && load64(db+48)==2 && h_has(flexdb_error(db),"row values"),"scalar view rejects required null and unrelated invalid text with valid checksums");close_flexdb(db);h_assert(fd_same(before,h_sha(test)),"scalar corruption leaves file unchanged");mode=mode+1;}return 1;
}
fn packed_decode(db) {
 let columns=flexdb_schema(db);let v=flexdb_values(db);let i=0;while i<64 {let kind=1+i%4;flexdb_column(db,columns,h_int(i),kind,1);let x=flexdb_int(db,i);if kind==2 {x=flexdb_text(db,"unaligned utf8 ä");}if kind==3 {x=flexdb_blob(db,"a\0b\0c",5);}if kind==4 {x=flexdb_real(db,0x8000000000000000);}if i==63 || i%11==0 {x=flexdb_null(db);}flexdb_add(db,v,x);i=i+1;}
 let row=fd_row(db,42,v);let a=alloc(32);let b=fd_vec(a);let bytes=fd_cp_row(a,b,row);let decoded=fd_cp_decode(db,42,columns,load64(b+16),bytes);h_assert(decoded && flexdb_rowid(decoded)==42,"direct checkpoint decoder 64 columns");i=0;while i<64 {let x=flexdb_cell(row,i);let y=flexdb_cell(decoded,i);h_assert(flexdb_kind(x)==flexdb_kind(y),"direct decoder type/null parity");if flexdb_kind(x)==2 || flexdb_kind(x)==3 {h_assert(flexdb_bytes(x)==flexdb_bytes(y) && fd_bytes(flexdb_word(x),flexdb_word(y),flexdb_bytes(x)) && !load8(flexdb_word(y)+flexdb_bytes(y)),"direct decoder owns terminated bytes incl embedded zeros");}else {h_assert(flexdb_word(x)==flexdb_word(y),"direct decoder scalar bits");}i=i+1;}
 h_assert(!fd_cp_decode(db,42,columns,load64(b+16),bytes-1) && load64(db+48)==2,"direct decoder rejects truncated encoding");store64(db+48,0);fd_word(a,b,123);h_assert(!fd_cp_decode(db,42,columns,load64(b+16),bytes+8),"direct decoder rejects trailing data");store64(db+48,0);fd_clear(a);syscall(11,a,32,0,0,0,0);return 1;
}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"optimized fixture path");strings();let views=h_cat(load64(argv+8),".views");scalar_views(views);scalar_corruption(views);let db=open_flexdb(load64(argv+8));h_assert(db,"open");successor_build(db);hash_delete(db);packed_decode(db);flexdb_begin(db);let s=flexdb_schema(db);flexdb_column(db,s,"n",1,0);let t=flexdb_create(db,"t",s);let i=0;while i<200 {flexdb_insert(t,values(db,i));i=i+1;}flexdb_delete(t,60);flexdb_commit(db);let q=flexdb_query(db);let all=gte_query(q,t,40);let expected=flexdb_limit(q,all,20,9);let actual=gte_page(q,t,20,9,40);h_assert(flexdb_count(actual)==9,"compiled page count");i=0;while i<9 {h_assert(flexdb_rowid(flexdb_at(actual,i))==flexdb_rowid(flexdb_at(expected,i)),"page matches complete filtering and limit with tombstone");i=i+1;}
 h_assert(lte_count(t,40)==41 && gte_count(t,40)==159,"reversed range predicate");h_assert(flexdb_count(gte_page(q,t,0,0,0))==0 && flexdb_count(gte_page(q,t,1000,9,0))==0 && !gte_page(q,t,-1,1,0),"empty/missing/invalid pages");flexdb_query_close(q);q=flexdb_query(db);let v=flexdb_values(q);flexdb_add(q,v,flexdb_int(q,99));h_assert(fd_size(v)==1,"pooled arena reinitializes containers");flexdb_query_close(q);real_join(db);close_flexdb(db);h_print(1,"FlexDB optimized: guarded string loads, backward shift, pages, query reuse and hash joins pass\n");return 0;
}
