import "../flexdb.flex";
extend "../schema.flex";
database Demo {table ArchiveSegment {id:rowid;data:blob;}}
fn need(db,ok){if !ok {let error=flexdb_error(db);syscall(1,2,error,fd_len(error),0,0,0);syscall(60,1,0,0,0,0,0);}return ok;}
fn main(argc,argv){let path="build/blob-demo.db";if argc>1 {path=load64(argv+8);}let db=Demo_open(path);need(db,db);let t=ArchiveSegment_table(db);if !flexdb_get(t,1) {let q=flexdb_query(db);let p=fd_alloc(q,65536);let line="INFO device=bus-42 engine telemetry ok\n";let length=fd_len(line);let i=0;while i<65536 {store8(p+i,load8(line+i%length));i=i+1;}need(db,flexdb_begin(db));need(db,flexdb_insert(t,ArchiveSegment_values(q,p,65536)));flexdb_query_close(q);need(db,flexdb_commit(db));}let value=ArchiveSegment_data_value(flexdb_get(t,1));need(db,flexdb_blob_external(value));let reader=flexdb_blob_reader(value);need(db,reader);let buffer=alloc(4096);need(db,buffer>0);let bytes=0;let count=flexdb_blob_reader_read(reader,buffer,4096);while count>0 {bytes=bytes+count;count=flexdb_blob_reader_read(reader,buffer,4096);}need(db,count==0 && bytes==65536);flexdb_blob_reader_close(reader);syscall(11,buffer,4096,0,0,0,0);need(db,flexdb_integrity(db) && flexdb_compact(db));close_flexdb(db);let message="Compressed blob round trip: 65536 bytes\n";syscall(1,1,message,fd_len(message),0,0,0);return 0;}
