// Both backends exchange the same codec-1 extents; native path works with C
// deliberately unavailable. Captured readers retain their backend selection.
import "../../db/flexdb.flex";
import "../../../scripts/lib/host.flex";
fn insert_blob(db,t,p,n) {let values=flexdb_values(db);flexdb_add(db,values,flexdb_blob(db,p,n));return flexdb_insert(t,values);}
fn verify_blob(v,p,n) {let out=alloc(65536);let reader=flexdb_blob_reader_sequential(v);h_assert(reader,"open blob reader");let total=0;let size=flexdb_blob_reader_read(reader,out,65536);while size>0 {h_assert(fd_bytes(out,p+total,size),"stream exact bytes");total=total+size;size=flexdb_blob_reader_read(reader,out,65536);}h_assert(!size && total==n && flexdb_blob_reader_close(reader),"stream completion");h_assert(flexdb_blob_read(v,n-997,out,997)==997 && fd_bytes(out,p+n-997,997),"range exact bytes");syscall(11,out,65536,0,0,0,0);return 1;}
fn main(argc,argv) {
 h_environment(argc,argv);h_assert(argc==2,"db fixture path");let n=2097152;let p=alloc(n);let i=0;while i<n {store8(p+i,(i/19+i%53)&255);i=i+1;}
 let db=open_flexdb(load64(argv+8));h_assert(db && flexdb_begin(db),"open DB");let schema=flexdb_schema(db);flexdb_column(db,schema,"payload",3,0);let table=flexdb_create(db,"Payload",schema);let c_id=insert_blob(db,table,p,n);h_assert(c_id && flexdb_commit(db),"C write");let c_blob=flexdb_cell(flexdb_get(table,c_id),0);
 h_assert(flexdb_blob_native_zstd(db,1) && flexdb_begin(db),"select native");let saved=fd_zstd;fd_zstd=-1;let native_id=insert_blob(db,table,p,n);h_assert(native_id && flexdb_commit(db),"native write without libzstd");let native_blob=flexdb_cell(flexdb_get(table,native_id),0);h_assert(flexdb_blob_codec(native_blob)==1,"native compressed extent");verify_blob(c_blob,p,n);verify_blob(native_blob,p,n);h_assert(flexdb_integrity(db),"native integrity without C");fd_zstd=saved;
 let reader=flexdb_blob_reader(native_blob);h_assert(reader && flexdb_blob_native_zstd(db,0),"change policy with native reader alive");let out=alloc(n);h_assert(flexdb_blob_reader_read(reader,out,n)==n && fd_bytes(out,p,n) && flexdb_blob_reader_close(reader),"reader keeps native backend");verify_blob(native_blob,p,n);
 h_assert(flexdb_checkpoint(db) && close_flexdb(db),"close native/C mixed file");db=open_flexdb(load64(argv+8));h_assert(db && !fd_codec_native(db),"backend policy is connection-local");table=flexdb_table(db,"Payload");verify_blob(flexdb_cell(flexdb_get(table,native_id),0),p,n);h_assert(flexdb_blob_native_zstd(db,1) && flexdb_integrity(db) && flexdb_compact(db) && close_flexdb(db),"reopen native integrity and compaction");
 db=open_flexdb(load64(argv+8));h_assert(db && flexdb_blob_native_zstd(db,1) && flexdb_blob_options(db,4096,6) && flexdb_begin(db),"native level test");table=flexdb_table(db,"Payload");h_assert(!insert_blob(db,table,p,n) && h_has(flexdb_error(db),"level 1"),"unsupported encoder strategy is explicit");h_assert(flexdb_rollback(db) && close_flexdb(db),"rollback rejected strategy");h_print(1,"Native/C Zstd FlexDB interchange passes\n");return 0;
}
