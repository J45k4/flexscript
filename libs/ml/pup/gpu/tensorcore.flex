    let i=0;while i<4 {let delta=0;if i>=2 {delta=8;}let row=h_cat3("(row+",h_int(delta),")");let kk=h_cat3("(kk+",h_int(i%2),")");cg_num("i",i);cg_line(cg_f2("let valid=(@0@<@m@)*(@1@<@reduction@);",row,kk));let address=cg_expand(cg_f2("((batch*@m@+@0@)*@reduction@+@1@)",row,kk));let source="input";if op==12 {address=cg_expand(cg_f3("((@0@*@m@+@1@)*@reduction@+@2@)",cg_r("batch",groups),row,kk));source="weights";}cg_line(cg_f2("let a@i@=gpu_load_u32(@0@+(@1@*valid)*4)&(0-valid);",source,address));i=i+1;}
    i=0;while i<2 {cg_num("i",i);let kk=h_cat3("(kk+",h_int(i),")");cg_line(cg_f1("let valid=(col<@n@)*(@0@<@reduction@);",kk));let address=0;let source="other";
        if op==12 {source="input";if k==1 && cg_param(node,1)==1 && cg_param(node,2)==0 {address=cg_expand(cg_f3("((@0@*@cin@+@1@*@inGroup@+@2@)*@n@+col)",cg_q("batch",groups),cg_r("batch",groups),kk));}
            else {cg_line(cg_f4("let iy=@0@*@stride@+@1@-@pad@;let ix=@2@*@stride@+@3@-@pad@;valid=valid*(iy>=0)*(iy<@ih@)*(ix>=0)*(ix<@iw@);",cg_q("col",ow),cg_r(cg_q(kk,k),k),cg_r("col",ow),cg_r(kk,k)));address=cg_expand(cg_f3("(((@0@*@cin@+@1@*@inGroup@+@2@)*@ih@+iy)*@iw@+ix)",cg_q("batch",groups),cg_r("batch",groups),cg_q(kk,k*k)));}}
        else {address=cg_expand(cg_f1("((batch*@reduction@+@0@)*@n@+col)",kk));}cg_line(cg_f2("let b@i@=gpu_load_u32(@0@+(@1@*valid)*4)&(0-valid);",source,address));i=i+1;
    }
