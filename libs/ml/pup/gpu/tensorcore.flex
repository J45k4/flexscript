    let part=0;while part<parts {cg_num("part",part);let i=0;while i<2 {cg_num("i",i);cg_line("let total@part@_@i@=0;");i=i+1;}part=part+1;}cg_num("weightBatch",m*reduction);if op==12 {cg_line(cg_f2("wr0=wr0+@0@*@weightBatch@;wr1=wr1+@1@*@weightBatch@;",cg_r("batch",groups),cg_r("batch",groups)));}else {cg_line("wr0=wr0+batch*@weightBatch@;wr1=wr1+batch*@weightBatch@;weights=input;");}
    let phase=0;while phase<phases {cg_num("phase",phase);cg_num("ky",phase/3);cg_num("kx",phase%3);part=0;while part<parts {cg_num("part",part);let column=h_cat3("(col+",h_int(part*8),")");cg_line(cg_f1("let valid=@0@<@n@;",column));let address=0;
        if op==12 && k==3 {cg_line(cg_f2("let iy=@0@*@stride@+@ky@-@pad@;let ix=@1@*@stride@+@kx@-@pad@;valid=valid*(iy>=0)*(iy<@ih@)*(ix>=0)*(ix<@iw@);",cg_q(column,ow),cg_r(column,ow)));address=cg_expand(cg_f2("(((@0@*@cin@+@1@*@inGroup@+lane_k)*@ih@+iy)*@iw@+ix)",cg_q("batch",groups),cg_r("batch",groups)));}
        else if op==12 {address=cg_expand(cg_f3("((@0@*@cin@+@1@*@inGroup@+lane_k)*@n@+@2@)",cg_q("batch",groups),cg_r("batch",groups),column));}
        else {address=cg_expand(cg_f1("((batch*@reduction@+lane_k)*@n@+@0@)",column));}cg_line(cg_f1("let lookup@phase@_@part@_0=(@0@*valid)|(valid<<31);",address));part=part+1;}phase=phase+1;}
    let limit=reduction;if phases==9 {limit=reduction/9;}cg_num("limit",limit);cg_line("while base<@limit@ {");phase=0;while phase<phases {cg_num("phase",phase);let weight_offset=0;if phases==9 {weight_offset=phase*(cin/groups);}cg_num("weightOffset",weight_offset);cg_line("let av0=gpu_load_u64(weights+(wr0+base+@weightOffset@)*4);let av1=gpu_load_u64(weights+(wr1+base+@weightOffset@)*4);");cg_line("let ah=gpu_f16_pair_hi(av0)|(gpu_f16_pair_hi(av1)<<32);let al=gpu_f16_pair_lo(av0)|(gpu_f16_pair_lo(av1)<<32);");
        part=0;while part<parts {cg_num("part",part);let image_stride=n;if op==12 {image_stride=ih*iw;}cg_num("imageStride",image_stride);cg_set("source","other");if op==12 {cg_set("source","input");}
            cg_line("let entry=lookup@phase@_@part@_0;let valid=entry>>31;let address=(base*@imageStride@+(entry&0x7fffffff))*valid;");cg_line("let b0=gpu_load_u32(@source@+address*4)&(0-valid);let b1=gpu_load_u32(@source@+(address+@imageStride@*valid)*4)&(0-valid);");cg_line("let bv=b0|(b1<<32);let bh=gpu_f16_pair_hi(bv);let bl=gpu_f16_pair_lo(bv);");
            cg_line("let cross0=gpu_mma_f16x4(al,bh,0,0,offset);let cross1=gpu_shared_load64(offset);");cg_line("cross0=gpu_mma_f16x4(ah,bl,cross0,cross1,offset);cross1=gpu_shared_load64(offset);");cg_line("total@part@_0=gpu_f32x2_fma(cross0,0x3a8000003a800000,total@part@_0);total@part@_1=gpu_f32x2_fma(cross1,0x3a8000003a800000,total@part@_1);");cg_line("total@part@_0=gpu_mma_f16x4(ah,bh,total@part@_0,total@part@_1,offset);total@part@_1=gpu_shared_load64(offset);");part=part+1;
