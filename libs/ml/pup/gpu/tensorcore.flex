fn cc_generate(node,silu) {
    cg_dimensions(node);cg_code=h_buffer();let op=load64(node);let k=cg_param(node,0);let groups=cg_param(node,3);let cin=load64(node+104);let ih=load64(node+112);let iw=load64(node+120);let ow=load64(node+88);let m=load64(node+80);let n=load64(node+88);let reduction=load64(node+120);let batches=cg_product(node+64,0,2);if op==12 {m=load64(node+72)/groups;n=load64(node+80)*ow;reduction=cin/groups*k*k;batches=load64(node+96)*groups;}else {groups=1;}
