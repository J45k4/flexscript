// Explicit experimental three-product FP16 approximation with FP32 accumulation.
// Strict FP32 kernels never enter this path.
import "element.flex";
fn cc_declarations() {return "\nfn gpu_f16_pair_hi(value) {return (value&65535)|((value>>16)&0xffff0000);}\nfn gpu_f16_pair_lo(value) {return ((value>>16)&65535)|((value>>32)&0xffff0000);}\nfn gpu_mma_f16x4(a,b,c,d,offset) {return 0;}\nfn gpu_f32x2_fma(a,b,c) {return 0;}\n";}
fn cc_scalar(node,silu,m,n,reduction,batches) {
    let op=load64(node);let k=cg_param(node,0);let groups=cg_param(node,3);if op!=12 {groups=1;}let cin=load64(node+104);let ow=load64(node+88);let mb=(m+15)/16;let nb=(n+31)/32;
