    if reduction%8 || (op==12 && k!=1 && k!=3) || (op==12 && k==3 && (cin/groups)%8) || (op==12 && k==1 && (cg_param(node,1)!=1 || cg_param(node,2)!=0)) {return cc_scalar(node,silu,m,n,reduction,batches);}
    let phases=1;if op==12 && k==3 {phases=9;}let mb=(m+15)/16;let parts=1;if n>=64 && batches*mb*((n+63)/64)>=72 {parts=2;}let nb=(n+32*parts-1)/(32*parts);cg_num("partsWidth",32*parts);cg_num("warpWidth",8*parts);
