// Platform-free named CNN graph. A training backend supplies kernel execution.
import "graph.flex";
import "inference.flex";
global pn_names=0;
global pn_name_count=0;
global pn_source=0;
global pn_length=0;
fn pn_name(node) {if load64(node)!=103 {pg_error("layer/config name must be a string");}let name=load64(node+80);if !pg_len(name) {pg_error("layer/config name must not be empty");}return name;}
fn pn_unique(name) {let i=0;while i<pn_name_count {if pg_eq(load64(pn_names+i*8),name) {pg_error("duplicate named layer");}i=i+1;}if pn_name_count>=2048 {pg_error("named layer limit exceeded");}store64(pn_names+pn_name_count*8,name);pn_name_count=pn_name_count+1;return 0;}
fn pn_integer(v) {let op=load64(v);if op==2 {return pg_integer(v);}if op>=3 && op<=6 && pg_rank(v)==0 {let a=pn_integer(load64(v+8));let b=pn_integer(load64(v+16));if op==3 {return a+b;}if op==4 {return a-b;}if op==5 {if a && (b>16777216/a || b< -16777216/a) {pg_error("static integer overflow");}return a*b;}if !b || a%b {pg_error("shape division must produce an integer");}return a/b;}pg_error("expected a static integer expression");return 0;}
fn pn_nchw(v) {if pg_rank(v)!=4 {pg_error("network layer requires NCHW input");}return 0;}
fn pn_conv(args,count,transpose) {
    if count!=7 && count!=8 {pg_error("conv2d/conv_transpose2d expects input,name,channels,kernel,stride,padding,bias[,groups]");}let x=load64(args);pn_nchw(x);let name=pn_name(load64(args+8));pn_unique(name);let c=pn_integer(load64(args+16));let k=pn_integer(load64(args+24));let s=pn_integer(load64(args+32));let p=pn_integer(load64(args+40));let bias=pn_integer(load64(args+48));let groups=1;if count==8 {groups=pn_integer(load64(args+56));}
    if c<1 || c>4096 || k<1 || k>31 || s<1 || s>32 || p<0 || p>31 || (bias!=0 && bias!=1) || groups<1 || pg_dim(x,1)%groups || c%groups {pg_error("invalid convolution dimensions/groups/bias");}let h=(pg_dim(x,2)+2*p-k)/s+1;let w=(pg_dim(x,3)+2*p-k)/s+1;if transpose {h=(pg_dim(x,2)-1)*s-2*p+k;w=(pg_dim(x,3)-1)*s-2*p+k;}else if pg_dim(x,2)+2*p<k || pg_dim(x,3)+2*p<k {pg_error("kernel exceeds padded input");}let shape=alloc(32);store64(shape,pg_dim(x,0));store64(shape+8,c);store64(shape+16,h);store64(shape+24,w);let meta=alloc(64);store64(meta,name);store64(meta+8,c);store64(meta+16,k);store64(meta+24,s);store64(meta+32,p);store64(meta+40,bias);store64(meta+48,groups);store64(meta+56,transpose);return pg_node(12,x,0,4,shape,meta,0);
}
fn pn_call(name,args,count) {
    let inference=pni_call(name,args,count);if inference {return inference;}
    if pg_eq(name,"config") && count==2 {let key=pn_name(load64(args));let value=load64(args+8);if load64(value)!=2 {pg_error("config default must be a numeric literal");}let node=pg_constant(load64(value+48),load64(value+88));store64(node+104,key);return node;}
    if pg_eq(name,"conv2d") {return pn_conv(args,count,0);}if pg_eq(name,"conv_transpose2d") {return pn_conv(args,count,1);}
    if pg_eq(name,"batchnorm") && count==2 {let x=load64(args);pn_nchw(x);let key=pn_name(load64(args+8));pn_unique(key);return pg_node(13,x,0,4,load64(x+40),key,0);}
    if pg_eq(name,"maxpool2d") && count==4 {let x=load64(args);pn_nchw(x);let k=pn_integer(load64(args+8));let s=pn_integer(load64(args+16));let p=pn_integer(load64(args+24));if k<1 || k>31 || s<1 || s>32 || p<0 || p>31 || pg_dim(x,2)+2*p<k || pg_dim(x,3)+2*p<k {pg_error("invalid maxpool dimensions");}let shape=alloc(32);store64(shape,pg_dim(x,0));store64(shape+8,pg_dim(x,1));store64(shape+16,(pg_dim(x,2)+2*p-k)/s+1);store64(shape+24,(pg_dim(x,3)+2*p-k)/s+1);let meta=alloc(24);store64(meta,k);store64(meta+8,s);store64(meta+16,p);return pg_node(14,x,0,4,shape,meta,0);}
    if (pg_eq(name,"hardswish") || pg_eq(name,"hardsigmoid") || pg_eq(name,"global_avgpool2d")) && count==1 {let x=load64(args);pn_nchw(x);let op=17;if pg_eq(name,"hardsigmoid") {op=18;}if pg_eq(name,"global_avgpool2d") {let shape=alloc(32);store64(shape,pg_dim(x,0));store64(shape+8,pg_dim(x,1));store64(shape+16,1);store64(shape+24,1);return pg_node(19,x,0,4,shape,0,0);}return pg_node(op,x,0,4,load64(x+40),0,0);}
    if pg_eq(name,"linear4d") && count==3 {let x=load64(args);pn_nchw(x);if pg_dim(x,2)!=1 || pg_dim(x,3)!=1 {pg_error("linear4d needs singleton spatial axes");}let key=pn_name(load64(args+8));pn_unique(key);let width=pn_integer(load64(args+16));if width<1 || width>4096 {pg_error("linear4d output width outside 1..4096");}let shape=alloc(32);store64(shape,pg_dim(x,0));store64(shape+8,width);store64(shape+16,1);store64(shape+24,1);let meta=alloc(16);store64(meta,key);store64(meta+8,width);return pg_node(20,x,0,4,shape,meta,0);}
    if pg_eq(name,"checkpoint_alias") && count==3 {let optimizer=load64(args);if load64(optimizer)!=16 && load64(optimizer)!=21 {pg_error("checkpoint_alias requires an optimizer handle");}let from=pn_name(load64(args+8));let to=pn_name(load64(args+16));let meta=alloc(16);store64(meta,from);store64(meta+8,to);return pg_node(21,optimizer,0,0,0,meta,0);}
    if pg_eq(name,"spatial_balanced_bce") && count==2 {let logits=load64(args);let target=load64(args+8);pn_nchw(logits);pn_nchw(target);let i=0;while i<4 {if pg_dim(logits,i)!=pg_dim(target,i) {pg_error("loss target shape differs from logits");}i=i+1;}if pg_dim(logits,1)!=1 {pg_error("heatmap loss requires one channel");}return pg_node(15,logits,target,0,0,0,0);}
    if pg_eq(name,"adam") && (count==2 || count==3) {let loss=load64(args);if load64(loss)!=15 {pg_error("adam requires a supported scalar training objective");}let rate=load64(args+8);let head=rate;if count==3 {head=load64(args+16);}if load64(rate)!=2 || load64(head)!=2 {pg_error("adam rates must be scalar literals/config values");}let a=gpu_f32_unpack(load64(rate+48));let b=gpu_f32_unpack(load64(head+48));if !f64_gt(a,0) || f64_gt(a,f64_from_i64(1)) || !f64_gt(b,0) || f64_gt(b,f64_from_i64(1)) {pg_error("adam learning rates must be in (0,1]");}let meta=alloc(16);store64(meta,rate);store64(meta+8,head);return pg_node(16,loss,0,0,0,meta,0);}
    return 0;
}
fn pn_plan() {if !pg_output_count {pg_error("missing network output");}let i=0;while i<pg_output_count {store64(load64(pg_outputs+i*8)+112,1);i=i+1;}i=pg_count;while i {i=i-1;let node=load64(pg_nodes+i*8);if load64(node+112) {if load64(node+8) {store64(load64(node+8)+112,1);}if load64(node+16) {store64(load64(node+16)+112,1);}if load64(node)==16 {let meta=load64(node+48);store64(load64(meta)+112,1);store64(load64(meta+8)+112,1);}}}return 0;}
fn pn_emit(text) {let size=pg_len(text);if pn_length+size>=2097152 {pg_error("network factory exceeds 2 MiB");}pg_copy(pn_source+pn_length,text,size);pn_length=pn_length+size;return 0;}
fn pn_variable(node) {return pg_cat("v",pg_num(load64(node+120)));}
fn pn_scalar(node) {let op=load64(node);if op==2 {let key=load64(node+104);if key {return pg_cat(pg_cat(pg_cat("pup_config_f32(\"",key),"\","),pg_cat(pg_num(load64(node+48)),")"));}return pg_num(load64(node+48));}let name="gpu_f32_add";if op==4 {name="gpu_f32_sub";}else if op==5 {name="gpu_f32_mul";}else if op==6 {name="gpu_f32_div";}else {pg_error("unsupported network dimension expression");}return pg_cat(pg_cat(pg_cat(pg_cat(name,"("),pn_scalar(load64(node+8))),","),pg_cat(pn_scalar(load64(node+16)),")"));}
fn pn_dimension(node) {return pg_cat(pg_cat("pup_i64(",pn_scalar(node)),")");}
fn pn_lower_host(function_name) {
    pn_source=alloc(2097152);pn_length=0;pn_emit(pg_cat(pg_cat("fn ",function_name),"(){\nlet inputs=h_vec();let outputs=h_vec();\n"));let i=0;
    while i<pg_count {let node=load64(pg_nodes+i*8);let op=load64(node);if load64(node+112) && (op!=2 || pn_inference_mode) && op<100 {pn_emit(pg_cat(pg_cat("let ",pn_variable(node)),"="));let a=load64(node+8);let b=load64(node+16);
        if pn_inference_mode {pni_emit(node);}
        else if op==1 {if pg_rank(node)!=4 {pg_error("network inputs currently require NCHW");}pn_emit(pg_cat(pg_cat("pup_input(\"",load64(node+80)),"\","));let syntax=load64(node+96);let axis=0;while axis<4 {if axis {pn_emit(",");}pn_emit(pn_dimension(load64(load64(syntax+56)+axis*8)));axis=axis+1;}pn_emit(");\n");pn_emit(pg_cat(pg_cat("h_add(inputs,h_args(\"",load64(node+80)),"\","));pn_emit(pn_variable(node));pn_emit(",0,0,0,0));\n");}
        else if op==3 {let axis=0;if pg_rank(a)!=pg_rank(b) {pg_error("network residual ranks differ");}while axis<pg_rank(a) {if pg_dim(a,axis)!=pg_dim(b,axis) {pg_error("network add currently requires equal shapes");}axis=axis+1;}pn_emit(pg_cat(pg_cat(pg_cat("pup_add(",pn_variable(a)),","),pg_cat(pn_variable(b),");\n")));}
        else if op==7 && load64(b)==2 && load64(b+48)==0 {pn_emit(pg_cat(pg_cat("pup_relu(",pn_variable(a)),");\n"));}
        else if op==12 {let meta=load64(node+48);pn_emit(pg_cat(pg_cat("pup_conv2d(",pn_variable(a)),",\""));pn_emit(load64(meta));pn_emit("\"");let word=1;while word<8 {pn_emit(",");pn_emit(pg_num(load64(meta+word*8)));word=word+1;}pn_emit(");\n");}
        else if op==13 {pn_emit(pg_cat(pg_cat("pup_batchnorm(",pn_variable(a)),",\""));pn_emit(load64(node+48));pn_emit("\");\n");}
        else if op==14 {pn_emit(pg_cat(pg_cat("pup_maxpool2d(",pn_variable(a)),","));let meta=load64(node+48);pn_emit(pg_num(load64(meta)));pn_emit(",");pn_emit(pg_num(load64(meta+8)));pn_emit(",");pn_emit(pg_num(load64(meta+16)));pn_emit(");\n");}
        else if op==24 || op==25 || op==26 {let operation="pup_sigmoid";if op==25 {operation="pup_concat";}if op==26 {operation="pup_slice";}pn_emit(operation);pn_emit("(");pn_emit(pn_variable(a));if b {pn_emit(",");pn_emit(pn_variable(b));}if op!=24 {pn_emit(",");pn_emit(pg_num(load64(node+48)));}if op==26 {pn_emit(",");pn_emit(pg_num(load64(node+56)));pn_emit(",");pn_emit(pg_num(pg_dim(node,load64(node+48))));}pn_emit(");\n");}
        else if op==5 {pn_nchw(a);pn_nchw(b);if pg_dim(a,0)!=pg_dim(b,0) || pg_dim(a,1)!=pg_dim(b,1) || (pg_dim(b,2)!=1 || pg_dim(b,3)!=1) && (pg_dim(a,2)!=pg_dim(b,2) || pg_dim(a,3)!=pg_dim(b,3)) {pg_error("network multiply needs matching NCHW tensors or channel gates");}pn_emit(pg_cat(pg_cat(pg_cat("pup_channel_mul(",pn_variable(a)),","),pg_cat(pn_variable(b),");\n")));}
        else if op==17 || op==18 || op==19 {let operation="pup_hardswish";if op==18 {operation="pup_hardsigmoid";}else if op==19 {operation="pup_global_avgpool2d";}pn_emit(pg_cat(pg_cat(pg_cat(operation,"("),pn_variable(a)),");\n"));}
        else if op==20 {let meta=load64(node+48);pn_emit(pg_cat(pg_cat("pup_linear4d(",pn_variable(a)),",\""));pn_emit(load64(meta));pn_emit("\",");pn_emit(pg_num(load64(meta+8)));pn_emit(");\n");}
        else if op==21 {let meta=load64(node+48);pn_emit(pg_cat(pg_cat("pup_checkpoint_alias(",pn_variable(a)),",\""));pn_emit(load64(meta));pn_emit("\",\"");pn_emit(load64(meta+8));pn_emit("\");\n");}
        else if op==15 {pn_emit(pg_cat(pg_cat(pg_cat("pup_spatial_balanced_bce(",pn_variable(a)),","),pg_cat(pn_variable(b),");\n")));}
        else if op==16 {let meta=load64(node+48);pn_emit(pg_cat(pg_cat("pup_adam(",pn_variable(a)),","));pn_emit(pn_scalar(load64(meta)));pn_emit(",");pn_emit(pn_scalar(load64(meta+8)));pn_emit(");\n");}
        else {pg_error("operation is not supported by the native network training backend");}
    }i=i+1;}i=0;while i<pg_output_count {pn_emit(pg_cat(pg_cat("h_add(outputs,",pn_variable(load64(pg_outputs+i*8))),");\n"));i=i+1;}pn_emit("return pup_finish(inputs,outputs);\n}\n");return pn_source;
}
