import "../parser.flex";
global pnt_checks=0;
fn pnt_assert(ok) {if !ok {pg_error("Pup network test failed");}pnt_checks=pnt_checks+1;return 0;}
fn main() {
    let text="batch=config(\"batch\",2)\nsize=config(\"image_size\",32)\nx=input(\"images\",[batch,3,size,size])\nt=input(\"targets\",[batch,1,size/2,size/2])\nc=conv2d(x,\"stem\",4,3,2,1,0)\nn=batchnorm(c,\"norm\")\nr=relu(n)\np=maxpool2d(r,3,2,1)\nu=conv_transpose2d(p,\"up\",1,4,2,1,0)\nl=spatial_balanced_bce(u,t)\no=adam(l,config(\"learning_rate\",0.0001))\noutput u,l,o\n";
    pup_parse_network(text,pg_len(text),"network-test.pup");pnt_assert(pg_network_mode==1 && pg_output_count==3 && pg_param_count==2);let output=load64(pg_outputs);pnt_assert(pg_rank(output)==4 && pg_dim(output,0)==2 && pg_dim(output,1)==1 && pg_dim(output,2)==16 && pg_dim(output,3)==16);pnt_assert(load64(load64(pg_outputs+8))==15 && load64(load64(pg_outputs+16))==16);pnt_assert(pn_name_count==3);let factory=pn_lower_host("test_model");pnt_assert(pg_len(factory)>400);let found=0;let i=0;while i<pn_length {if pg_eq(factory+i,"pup_finish(inputs,outputs);\n}\n") {found=1;}i=i+1;}pnt_assert(found);
    text="x=input(\"images\",[2,4,8,8])\ny=conv2d(x,\"depthwise\",4,3,1,1,0,4)\ns=hardswish(y)\na=global_avgpool2d(s)\nb=linear4d(a,\"se.fc1\",2)\nc=linear4d(relu(b),\"se.fc2\",4)\nz=s*hardsigmoid(c)\nlogits=conv2d(z,\"head\",1,1,1,0,1)\nt=input(\"targets\",[2,1,8,8])\nl=spatial_balanced_bce(logits,t)\no=adam(l,.0001)\nq=checkpoint_alias(o,\"depthwise.\",\"legacy.\")\noutput logits,l,q\n";
    pup_parse_network(text,pg_len(text),"mobile-ops.pup");pnt_assert(pg_dim(load64(pg_outputs),2)==8 && pg_dim(load64(pg_outputs),1)==1);pnt_assert(load64(load64(pg_outputs+16))==21);pnt_assert(pn_name_count==4);factory=pn_lower_host("mobile_ops");pnt_assert(pg_len(factory)>800);let ops=0;i=0;while i<pg_count {let op=load64(load64(pg_nodes+i*8));if op==17 || op==18 || op==19 || op==20 {ops=ops+1;}i=i+1;}pnt_assert(ops==5);
    text="x=input(\"images\",[2,4,8,8])\ns=x*sigmoid(x)\na=slice(s,1,0,2)\nb=slice(s,1,2,4)\nz=concat(a,b,1)\ny=conv2d(z,\"head\",1,1,1,0,1)\nt=input(\"targets\",[2,1,8,8])\nl=spatial_balanced_bce(y,t)\no=adam(l,.0001)\noutput y,l,o\n";pup_parse_network(text,pg_len(text),"yolo-routing.pup");factory=pn_lower_host("yolo_routing");pnt_assert(pg_dim(load64(pg_outputs),0)==2 && pg_dim(load64(pg_outputs),1)==1);pnt_assert(pg_len(factory)>500);ops=0;i=0;while i<pg_count {let op=load64(load64(pg_nodes+i*8));if op==24 || op==25 || op==26 {ops=ops+1;}i=i+1;}pnt_assert(ops==4);
    // The ordinary static-inference path retains its original primitive graph.
    text="x=input(\"x\",[2,3])\noutput x+1\n";pup_parse(text,pg_len(text),"primitive-test.pup");pnt_assert(pg_network_mode==0 && pg_stage_count==1 && pg_param_count==1);let memory=alloc(pg_words*8);let parameter=load64(pg_params);i=0;while i<6 {store64(memory+(load64(parameter+64)+i)*8,gpu_f32_from_i64(i));i=i+1;}pg_execute(memory);output=load64(pg_outputs);pnt_assert(load64(memory+(load64(output+64)+5)*8)==gpu_f32_from_i64(6));return 0;
}
