import "protocol.flex";
global ws_crypto=0;
fn ws_crypto_init() {if !ws_crypto {ws_crypto=ffi_open("libcrypto.so.3");}return ws_crypto!=0;}
fn ws_b64_value(c) {if c>=65 && c<=90 {return c-65;}if c>=97 && c<=122 {return c-97+26;}if c>=48 && c<=57 {return c-48+52;}if c==43 {return 62;}if c==47 {return 63;}return -1;}
fn ws_b64(out,p,n) {if !ws_crypto_init() {return 0;}let size=ffi_call_i32(ffi_symbol(ws_crypto,"EVP_EncodeBlock"),out,p,n,0,0,0);return size>=0;}
fn websocket_client_key(out) {let p=alloc(16);if p<=0 {return 0;}let ok=ws_random(p,16) && ws_b64(out,p,16);syscall(11,p,16,0,0,0,0);return ok;}
fn ws_key_valid(key) {if !key || net_length(key)!=24 || load8(key+22)!=61 || load8(key+23)!=61 {return 0;}let i=0;while i<22 {if ws_b64_value(load8(key+i))<0 {return 0;}i=i+1;}return !(ws_b64_value(load8(key+21))&15);}
// out requires 29 bytes; client keys require 25 bytes. Both include termination.
fn websocket_accept_key(key,out) {if !ws_key_valid(key) || !out || !ws_crypto_init() {return 0;}let p=alloc(96);if p<=0 {return 0;}net_copy(p,key,24);net_copy(p+24,"258EAFA5-E914-47DA-95CA-C5AB0DC85B11",36);let ok=ffi_call(ffi_symbol(ws_crypto,"SHA1"),p,60,p+64,0,0,0)!=0;if ok {ok=ws_b64(out,p+64,20);}syscall(11,p,96,0,0,0,0);return ok;}
fn ws_equal(a,b) {if !a || !b {return 0;}let n=net_length(a);if n!=net_length(b) {return 0;}let i=0;while i<n {let x=load8(a+i);let y=load8(b+i);if x>=65 && x<=90 {x=x+32;}if y>=65 && y<=90 {y=y+32;}if x!=y {return 0;}i=i+1;}return 1;}
fn ws_token(c) {if (c>=48 && c<=57)||(c>=65 && c<=90)||(c>=97 && c<=122) {return 1;}let chars="!#$%&'*+-.^_`|~";let i=0;while load8(chars+i) {if load8(chars+i)==c {return 1;}i=i+1;}return 0;}
fn ws_same(a,b) {return a && b && net_equal(a,b);}
fn ws_has_token(value,wanted) {if !value || !wanted {return 0;}let n=net_length(value);let at=0;while at<n {while at<n && (load8(value+at)==32 || load8(value+at)==9) {at=at+1;}let start=at;while at<n && ws_token(load8(value+at)) {at=at+1;}let finish=at;while at<n && (load8(value+at)==32 || load8(value+at)==9) {at=at+1;}if at<n && load8(value+at)!=44 {return 0;}let size=finish-start;if size==net_length(wanted) {let i=0;let same=1;while i<size {let x=load8(value+start+i);let y=load8(wanted+i);if x>=65 && x<=90 {x=x+32;}if y>=65 && y<=90 {y=y+32;}if x!=y {same=0;}i=i+1;}if same {return 1;}}if finish==start {return 0;}at=at+1;}return 0;}
fn websocket_header_size(p,n) {if !p || n<0 {return -1;}let i=0;while i+3<n && i<16384 {if load8(p+i)==13 && load8(p+i+1)==10 && load8(p+i+2)==13 && load8(p+i+3)==10 {if i+4>16384 {return -1;}return i+4;}i=i+1;}if n>=16384 {return -1;}return 0;}
// Parse into caller-owned scratch (at least header_size*2+1024 bytes).
// Pairs: key, value, next; header record: first_line, first_pair, count.
fn ws_headers(p,n,scratch) {let end=websocket_header_size(p,n);if end<=0 {return 0;}let at=0;while at+1<end && !(load8(p+at)==13 && load8(p+at+1)==10) {if load8(p+at)<32 || load8(p+at)>126 {return 0;}at=at+1;}if !at {return 0;}store64(scratch+8,0);store64(scratch+16,0);store64(scratch+24,0);let text=scratch+32;net_copy(text,p,at);store8(text+at,0);store64(scratch,text);text=text+at+1;at=at+2;let previous=0;let count=0;
    while at<end-2 {let start=at;while at<end && ws_token(load8(p+at)) {at=at+1;}if at==start || load8(p+at)!=58 || count>=128 {return 0;}let key=text;net_copy(key,p+start,at-start);store8(key+at-start,0);text=text+at-start+1;at=at+1;while at<end && (load8(p+at)==32 || load8(p+at)==9) {at=at+1;}start=at;while at+1<end && !(load8(p+at)==13 && load8(p+at+1)==10) {let c=load8(p+at);if (c<32 && c!=9)||c==127 {return 0;}at=at+1;}let finish=at;while finish>start && (load8(p+finish-1)==32 || load8(p+finish-1)==9) {finish=finish-1;}let value=text;net_copy(value,p+start,finish-start);store8(value+finish-start,0);text=text+finish-start+1;let pair=text;store64(pair,key);store64(pair+8,value);store64(pair+16,0);text=text+24;if previous {store64(previous+16,pair);}else {store64(scratch+8,pair);}previous=pair;count=count+1;at=at+2;
    }store64(scratch+16,count);return scratch;
}
fn ws_header(headers,key) {let pair=load64(headers+8);let found=0;while pair {if ws_equal(load64(pair),key) {if found {store64(headers+24,1);return 0;}found=load64(pair+8);}pair=load64(pair+16);}return found;}
fn ws_upgrade_valid(headers) {return ws_equal(ws_header(headers,"upgrade"),"websocket") && ws_has_token(ws_header(headers,"connection"),"upgrade") && !ws_header(headers,"transfer-encoding") && (!ws_header(headers,"content-length") || ws_same(ws_header(headers,"content-length"),"0"));}
fn ws_emit(out,at,p,n,capacity) {if n<0 || at>capacity-n-1 {return -1;}net_copy(out+at,p,n);store8(out+at+n,0);return at+n;}
// 0 incomplete request, -1 invalid request/capacity, positive response byte length.
// Authorize the HTTP request before sending this response; this is protocol only.
fn websocket_server_upgrade(p,n,out,capacity) {let end=websocket_header_size(p,n);if end<=0 {return end;}let scratch=alloc(end*2+4096);if scratch<=0 {return -1;}let headers=ws_headers(p,end,scratch);let ok=headers!=0;let line=load64(scratch);let key=0;if ok {let size=net_length(line);ok=size>=14 && load8(line)==71 && load8(line+1)==69 && load8(line+2)==84 && load8(line+3)==32 && ws_same(line+size-9," HTTP/1.1") && load8(line+4)==47;let i=4;while i<size-9 {let c=load8(line+i);if c<=32 || c>=127 || c==35 {ok=0;}i=i+1;}key=ws_header(headers,"sec-websocket-key");ok=ok && ws_upgrade_valid(headers) && ws_header(headers,"host") && net_length(ws_header(headers,"host"))>0 && ws_same(ws_header(headers,"sec-websocket-version"),"13") && ws_key_valid(key);}
    let result=-1;if ok {let accept=scratch+end*2+4000;if !load64(headers+24) && websocket_accept_key(key,accept) {let prefix="HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ";let at=ws_emit(out,0,prefix,net_length(prefix),capacity);if at>=0 {at=ws_emit(out,at,accept,28,capacity);}if at>=0 {result=ws_emit(out,at,"\r\n\r\n",4,capacity);}}}syscall(11,scratch,end*2+4096,0,0,0,0);return result;
}
fn websocket_client_request(host,path,key,extra,out,capacity) {if !host || !path || !ws_key_valid(key) || load8(path)!=47 {return -1;}let n=net_length(host);if !n || n>512 {return -1;}let i=0;while i<n {let c=load8(host+i);if c<=32 || c>=127 || c==47 || c==92 {return -1;}i=i+1;}n=net_length(path);if n>8192 {return -1;}i=0;while i<n {let c=load8(path+i);if c<=32 || c>=127 || c==35 {return -1;}i=i+1;}
    if !extra {extra="";}n=net_length(extra);if n>8192 {return -1;}i=0;while i<n {let start=i;while i<n && ws_token(load8(extra+i)) {i=i+1;}if i==start || load8(extra+i)!=58 {return -1;}let len=i-start;let name=alloc(len+1);if name<=0 {return -1;}net_copy(name,extra+start,len);store8(name+len,0);let forbidden=ws_equal(name,"host") || ws_equal(name,"connection") || ws_equal(name,"upgrade") || ws_equal(name,"content-length") || ws_equal(name,"transfer-encoding") || ws_equal(name,"sec-websocket-key") || ws_equal(name,"sec-websocket-version") || ws_equal(name,"sec-websocket-extensions") || ws_equal(name,"sec-websocket-protocol");syscall(11,name,len+1,0,0,0,0);if forbidden {return -1;}i=i+1;while i<n && load8(extra+i)!=13 {let c=load8(extra+i);if (c<32 && c!=9)||c==127 {return -1;}i=i+1;}if i+1>=n || load8(extra+i+1)!=10 {return -1;}i=i+2;}
    let at=ws_emit(out,0,"GET ",4,capacity);if at>=0 {at=ws_emit(out,at,path,net_length(path),capacity);}if at>=0 {at=ws_emit(out,at," HTTP/1.1\r\nHost: ",17,capacity);}if at>=0 {at=ws_emit(out,at,host,net_length(host),capacity);}let middle="\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: ";if at>=0 {at=ws_emit(out,at,middle,net_length(middle),capacity);}if at>=0 {at=ws_emit(out,at,key,24,capacity);}if at>=0 {at=ws_emit(out,at,"\r\n",2,capacity);}if at>=0 {at=ws_emit(out,at,extra,n,capacity);}if at>=0 {at=ws_emit(out,at,"\r\n",2,capacity);}return at;
}
fn websocket_client_verify(p,n,key) {let end=websocket_header_size(p,n);if end<=0 {return end;}let scratch=alloc(end*2+4096);if scratch<=0 {return -1;}let headers=ws_headers(p,end,scratch);let ok=headers!=0;if ok {let line=load64(headers);ok=net_length(line)>=12;let prefix="HTTP/1.1 101";let i=0;while i<12 {if load8(line+i)!=load8(prefix+i) {ok=0;}i=i+1;}ok=ok && (load8(line+12)==0 || load8(line+12)==32) && ws_upgrade_valid(headers) && !ws_header(headers,"sec-websocket-extensions") && !ws_header(headers,"sec-websocket-protocol");let expected=scratch+end*2+4000;ok=ok && websocket_accept_key(key,expected) && ws_same(ws_header(headers,"sec-websocket-accept"),expected) && !load64(headers+24);}syscall(11,scratch,end*2+4096,0,0,0,0);if ok {return end;}return -1;}
