import "../../websocket.flex";
import "../../../scripts/lib/host.flex";
fn ws_check(ok,label) {h_assert(ok,label);return 0;}
fn main(argc,argv) {
    h_environment(argc,argv);let server=websocket_new(1,1048576);let client=websocket_new(0,1048576);h_assert(server && client,"create client/server codec");
    let key=h_take(25);let accept=h_take(29);h_assert(websocket_accept_key("dGhlIHNhbXBsZSBub25jZQ==",accept) && net_equal(accept,"s3pPLMBiTxaQ9kYGzzhZRbK+xOo="),"RFC handshake vector");h_assert(!websocket_accept_key("dGhlIHNhbXBsZSBub25jZR==",accept),"reject noncanonical key pad bits");h_assert(websocket_client_key(key) && ws_key_valid(key),"random client key");
    let wire=h_take(16385);let reply=h_take(1024);let request=websocket_client_request("localhost:80","/socket?x=1",key,"X-Example: value\r\n",wire,16385);h_assert(request>0,"client request");let response=websocket_server_upgrade(wire,request,reply,1024);h_assert(response>0 && websocket_client_verify(reply,response,key)==response,"upgrade round trip");h_assert(websocket_client_verify(reply,response-1,key)==0,"incremental handshake");h_assert(websocket_client_request("localhost","/",key,"Connection: close\r\n",wire,16385)<0,"framing header override rejected");
    h_assert(websocket_frame(client,1,"Hello",5),"client masked text");let i=0;while i<websocket_output_size(client) {h_assert(websocket_feed(server,websocket_output(client)+i,1)==1,"incremental frame feed");let event=websocket_next(server);if i+1<websocket_output_size(client) {h_assert(event==0,"incomplete frame");}else {h_assert(event==1 && websocket_size(server)==5 && net_equal(websocket_data(server),"Hello"),"received text");}i=i+1;}
    let bytes=h_take(70000);i=0;while i<70000 {store8(bytes+i,i%256);i=i+1;}let lengths=h_args(0,0,0,0,0,0);h_add(lengths,0);h_add(lengths,125);h_add(lengths,126);h_add(lengths,65535);h_add(lengths,65536);h_add(lengths,70000);i=0;while i<h_count(lengths) {let n=h_at(lengths,i);h_assert(websocket_frame(server,2,bytes,n) && websocket_feed(client,websocket_output(server),websocket_output_size(server))==websocket_output_size(server) && websocket_next(client)==2 && websocket_size(client)==n,"binary short/extended/64-bit length");let k=0;while k<n {h_assert(load8(websocket_data(client)+k)==k%256,"binary exact bytes including NUL");k=k+1;}i=i+1;}
    // Continuation and interleaved ping, sent as deliberately fragmented frames.
    h_assert(websocket_frame(client,1,"hi",2),"first fragment");store8(websocket_output(client),1);websocket_feed(server,websocket_output(client),websocket_output_size(client));h_assert(!websocket_next(server),"retain incomplete message");websocket_frame(client,9,"p",1);websocket_feed(server,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(server)==9 && websocket_size(server)==1,"interleaved ping");websocket_frame(client,1,"there",5);store8(websocket_output(client),128);websocket_feed(server,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(server)==1 && net_equal(websocket_data(server),"hithere"),"fragment reassembly");
    let bad=websocket_new(1,125);websocket_frame(server,1,"x",1);websocket_feed(bad,websocket_output(server),websocket_output_size(server));h_assert(websocket_next(bad)==-1 && websocket_close_code(bad)==1002,"wrong mask direction rejected");websocket_free(bad);
    bad=websocket_new(1,125);websocket_frame(client,2,"x",1);store8(websocket_output(client),128);websocket_feed(bad,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(bad)==-1,"orphan continuation rejected");websocket_free(bad);
    let invalid=h_take(2);store8(invalid,192);store8(invalid+1,128);h_assert(!websocket_frame(client,1,invalid,2),"outbound invalid UTF-8 rejected");websocket_frame(client,2,invalid,2);store8(websocket_output(client),129);bad=websocket_new(1,125);websocket_feed(bad,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(bad)==-1 && websocket_close_code(bad)==1007,"inbound invalid UTF-8 rejected");websocket_free(bad);
    // Malformed frames must fail before reading an oversized declared payload.
    let malformed=h_take(20);store8(malformed,130);store8(malformed+1,255);store8(malformed+7,1);bad=websocket_new(1,125);websocket_feed(bad,malformed,10);h_assert(websocket_next(bad)==-1 && websocket_close_code(bad)==1009,"oversized 64-bit length rejected without payload");websocket_free(bad);
    let flags=h_args(0,0,0,0,0,0);h_add(flags,193);h_add(flags,131);h_add(flags,9);let fi=0;while fi<h_count(flags) {websocket_frame(client,2,"x",1);store8(websocket_output(client),h_at(flags,fi));bad=websocket_new(1,125);websocket_feed(bad,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(bad)==-1 && websocket_close_code(bad)==1002,"RSV, reserved opcode and fragmented control rejected");websocket_free(bad);fi=fi+1;}
    bad=websocket_new(1,125);websocket_frame(client,2,bytes,100);store8(websocket_output(client),2);websocket_feed(bad,websocket_output(client),websocket_output_size(client));h_assert(!websocket_next(bad),"first bounded fragment");websocket_frame(client,2,bytes,100);store8(websocket_output(client),128);websocket_feed(bad,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(bad)==-1 && websocket_close_code(bad)==1009,"aggregate fragmented message limit");websocket_free(bad);
    let upgrades=h_args("GET / HTTP/1.1\r\nHost: localhost\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", "GET / HTTP/1.0\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n",0,0,0,0);fi=0;while fi<h_count(upgrades) {let raw=h_at(upgrades,fi);h_assert(websocket_server_upgrade(raw,h_len(raw),reply,1024)==-1,"missing Connection or HTTP/1.0 rejected");fi=fi+1;}
    let duplicate="GET / HTTP/1.1\r\nHost: localhost\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nTransfer-Encoding: chunked\r\nTransfer-Encoding: chunked\r\n\r\n";h_assert(websocket_server_upgrade(duplicate,h_len(duplicate),reply,1024)==-1,"duplicate forbidden framing header rejected");
    let close=h_take(4);store8(close,3);store8(close+1,232);h_assert(websocket_frame(client,8,close,2),"close frame");websocket_feed(server,websocket_output(client),websocket_output_size(client));h_assert(websocket_next(server)==8 && websocket_close_code(server)==1000 && !websocket_frame(client,1,"x",1),"close handshake state");h_assert(websocket_frame(server,8,websocket_data(server),websocket_size(server)),"close echo allowed");websocket_free(server);websocket_free(client);h_print(1,"WebSocket core passed: upgrades, masking, incremental framing, binary lengths, fragmentation, UTF-8 and close\n");return 0;
}
