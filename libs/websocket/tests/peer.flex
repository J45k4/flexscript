import "../../websocket.flex";
import "../../../scripts/lib/host.flex";
fn next_data(w) {let kind=websocket_stream_receive(w,5000);while kind==9 || kind==10 {kind=websocket_stream_receive(w,5000);}return kind;}
fn main(argc,argv) {
    h_environment(argc,argv);h_assert(argc>=4,"peer client HOST PORT [CA CERT KEY] | server HOST PORT");let host=load64(argv+16);let port=load64(argv+24);let limit=1048576;
    if net_equal(load64(argv+8),"client") {let options=0;if argc>=5 {let cert=0;let key=0;if argc>=7 {cert=load64(argv+40);key=load64(argv+48);}options=websocket_tls_options(load64(argv+32),cert,key);}let w=websocket_connect(host,port,"/echo?native=1","X-Native: yes\r\n",5000,limit,options);websocket_tls_options_free(options);h_assert(w,"native client upgrade/TLS verification");h_assert(websocket_stream_send(w,1,"native 🐶",11,5000),"send UTF-8");h_assert(next_data(w)==1 && net_equal(websocket_data(w),"hello native 🐶"),"receive fragmented UTF-8 with interleaved ping");let bytes=h_take(70000);let i=0;while i<70000 {store8(bytes+i,i%256);i=i+1;}h_assert(websocket_stream_send(w,2,bytes,70000,5000),"send binary");h_assert(next_data(w)==2 && websocket_size(w)==70000,"receive binary");i=0;while i<70000 {h_assert(load8(websocket_data(w)+i)==i%256,"binary round trip");i=i+1;}let close=h_take(2);store8(close,3);store8(close+1,232);h_assert(websocket_stream_send(w,8,close,2,5000) && next_data(w)==8,"graceful close handshake");websocket_free(w);h_print(1,"Native WebSocket client passed\n");return 0;}
    let listener=tcp_listen(host,port,8);h_assert(listener>=0,net_message);h_print(1,"WebSocket fixture listening\n");let fd=tcp_accept(listener,net_now()+10000);h_assert(fd>=0,net_message);let bytes=h_take(16385);let used=0;let end=0;while !end {let n=tcp_read(fd,bytes+used,16384-used,net_now()+5000);h_assert(n>0,"read upgrade request");used=used+n;end=websocket_header_size(bytes,used);h_assert(end>=0,"bounded upgrade request");}let reply=h_take(1024);let n=websocket_server_upgrade(bytes,used,reply,1024);h_assert(n>0 && tcp_write(fd,reply,n,net_now()+5000),"server upgrade");let w=websocket_new(1,limit);h_assert(websocket_stream_adopt(w,fd,0),"adopt accepted socket");if used>end {h_assert(websocket_feed(w,bytes+end,used-end)==used-end,"pipelined first frame");}let running=1;while running {let kind=websocket_stream_receive(w,5000);h_assert(kind>0,"server receives valid frame");if kind==1 || kind==2 {h_assert(websocket_stream_send(w,kind,websocket_data(w),websocket_size(w),5000),"echo data");}if kind==8 {running=0;}}websocket_free(w);tcp_close(listener);h_print(1,"Native WebSocket server passed\n");return 0;
}
