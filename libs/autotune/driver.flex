// Native generation, compilation and benchmark orchestration. Every process
// uses an argv vector; paths/options are never evaluated by a shell.
import "tiles.flex";
fn at_option(options,key,fallback) {let p=j_get(options,key);if p {return j_value(p);}return fallback;}
fn at_number_option(options,key,fallback,min,max) {let text=at_option(options,key,0);if !text {return fallback;}let p=j_parse(text);h_assert(j_kind(p)==1 && j_value(p)>=min && j_value(p)<=max,"integer option out of range");return j_value(p);}
fn at_parse(argc,argv) {
    let options=j_object();let i=2;while i<argc {let flag=load64(argv+i*8);h_assert(i+1<argc,"missing option value");h_assert(h_equal(flag,"--repo") || h_equal(flag,"--compiler") || h_equal(flag,"--config") || h_equal(flag,"--output") || h_equal(flag,"--manifest") || h_equal(flag,"--sweep") || h_equal(flag,"--candidates") || h_equal(flag,"--samples") || h_equal(flag,"--warmup") || h_equal(flag,"--target"),h_cat("unknown option: ",flag));h_assert(!j_get(options,flag),h_cat("duplicate option: ",flag));j_set(options,flag,j_string(load64(argv+(i+1)*8)));i=i+2;}return options;
}
fn at_candidate(candidates,tile) {
    h_assert(j_kind(tile)==4,"candidate object expected");let name=j_s(tile,"name");h_assert(at_name(name),"invalid candidate name");let i=0;while i<j_count(candidates) {h_assert(!h_equal(name,j_s(j_at(candidates,i),"name")),"duplicate candidate name");i=i+1;}h_assert(j_count(candidates)<128,"candidate count exceeds 128");
    let family=j_s(tile,"family");h_assert(h_equal(family,"gemm") || h_equal(family,"deconv4x4s2"),"unsupported kernel family");if j_get(tile,"precision") {h_assert(h_equal(j_s(tile,"precision"),"fp32"),"unsupported precision");}if j_get(tile,"bucket") {h_assert(h_equal(j_s(tile,"bucket"),"compute"),"unsupported optimization bucket");}j_set(tile,"precision",j_string("fp32"));j_set(tile,"bucket",j_string("compute"));at_tile(tile);j_push(candidates,tile);return tile;
}
fn at_candidates(config,sweep) {
    h_assert(at_integer(config,"version",1,1)==1,"unsupported config version");let input=j_need(config,"candidates");h_assert(j_kind(input)==3 && j_count(input)>0 && j_count(input)<=128,"invalid candidates");let result=j_array();let i=0;while i<j_count(input) {at_candidate(result,j_at(input,i));i=i+1;}
    h_assert(h_equal(sweep,"production") || h_equal(sweep,"compute"),"sweep must be production or compute");
    if h_equal(sweep,"compute") {let m=32;while m<=64 {let n=64;while n<=128 {let k=16;while k<=64 {let lc=8;while lc<=16 {let tile=j_object();let name=h_cat3("gemm-",h_int(m),h_cat3("x",h_int(n),h_cat3("-k",h_int(k),h_cat("-lc",h_int(lc)))));j_set(tile,"name",j_string(name));j_set(tile,"family",j_string("gemm"));j_set(tile,"m",j_int(m));j_set(tile,"n",j_int(n));j_set(tile,"k",j_int(k));j_set(tile,"threads",j_int(128));j_set(tile,"laneColumns",j_int(lc));if at_tile_valid(tile) {at_candidate(result,tile);}lc=lc*2;}k=k*2;}n=n*2;}m=m*2;}}
    return result;
}
fn at_sources(repo) {let hashes=j_object();let names=h_args("libs/autotune/common.flex","libs/autotune/tiles.flex","libs/autotune/driver.flex","libs/autotune/gemm-bench.flex","libs/autotune/kernels/fill.flex","libs/autotune/kernels/merge.flex");let i=0;while i<h_count(names) {let name=h_at(names,i);j_set(hashes,name,j_string(h_sha(h_join(repo,name))));i=i+1;}return hashes;}
fn at_generate(repo,config_path,output,manifest_path,sweep,target,check) {
    h_assert(h_equal(target,"hip") || h_equal(target,"rdna-gfx1201"),"target must be hip or rdna-gfx1201");let config=j_parse(h_read(config_path));let candidates=at_candidates(config,sweep);if !check {h_mkdir(output);}output=h_real(output);let gpu_import=at_relative(output,h_join(repo,"lib/gpu.flex"));let i=0;
    while i<j_count(candidates) {let tile=j_at(candidates,i);let name=j_s(tile,"name");let source=h_join(output,h_cat(name,".flex"));let extension=".hip";if !h_equal(target,"hip") {extension=".hsaco";}j_set(tile,"source",j_string(source));j_set(tile,"image",j_string(h_join(output,h_cat(name,extension))));
        let mark=h_mark();let code=at_kernel(tile,gpu_import);if check {h_assert(h_exists(source) && h_equal(h_read(source),code),h_cat("generated kernel differs: ",source));}else {h_save(source,code);}h_reset(mark);j_set(tile,"sourceSha256",j_string(h_sha(source)));i=i+1;
    }
    if !check {let manifest=j_object();j_set(manifest,"version",j_int(1));j_set(manifest,"target",j_string(target));j_set(manifest,"configSha256",j_string(h_sha(config_path)));j_set(manifest,"generatorSources",at_sources(repo));j_set(manifest,"candidates",candidates);h_mkdir(h_dir(manifest_path));j_save(manifest_path,manifest);}
    let action="Generated ";if check {action="Verified ";}h_print(1,h_cat3(action,h_int(j_count(candidates)),h_cat(" kernels in ",h_cat(output,"\n"))));return 0;
}
fn at_selected(names,name) {if !names {return 1;}let i=0;let start=0;while 1 {if !load8(names+i) || load8(names+i)==44 {if h_equal(h_slice(names+start,i-start),name) {return 1;}if !load8(names+i) {return 0;}start=i+1;}i=i+1;}return 0;}
fn at_shape(shape) {h_assert(at_name(j_s(shape,"name")),"invalid workload name");at_integer(shape,"m",1,16777216);at_integer(shape,"n",1,16777216);at_integer(shape,"k",1,1048576);at_integer(shape,"flags",0,3);at_integer(shape,"groups",1,128);at_integer(shape,"chunk",0,1048576);return shape;}
fn at_bench(repo,compiler,config_path,manifest_path,output,names,samples,warmup) {
    let manifest=j_parse(h_read(manifest_path));h_assert(at_integer(manifest,"version",1,1)==1,"unsupported manifest version");let target=j_s(manifest,"target");h_assert(h_equal(target,"hip") || h_equal(target,"rdna-gfx1201"),"unsupported target");h_assert(h_equal(h_sha(config_path),j_s(manifest,"configSha256")),"configuration differs from generation manifest");let config=j_parse(h_read(config_path));let shapes=j_need(config,"shapes");h_assert(j_kind(shapes)==3 && j_count(shapes)>0 && j_count(shapes)<=64,"invalid workloads");let candidates=j_need(manifest,"candidates");h_assert(j_kind(candidates)==3 && j_count(candidates)>0 && j_count(candidates)<=128,"invalid manifest candidates");let selected=j_array();let i=0;
    while i<j_count(candidates) {let tile=j_at(candidates,i);let declared_shared=j_n(tile,"sharedBytes");let declared_alignment=j_n(tile,"splitChunkAlignment");at_tile(tile);h_assert(declared_shared==j_n(tile,"sharedBytes") && declared_alignment==j_n(tile,"k"),"manifest launch contract differs from tile");h_assert(at_name(j_s(tile,"name")),"invalid manifest candidate name");if h_equal(j_s(tile,"family"),"gemm") && at_selected(names,j_s(tile,"name")) {j_push(selected,tile);}i=i+1;}h_assert(j_count(selected)>0,"no GEMM candidates selected");
    if names {let start=0;let more=1;i=0;while more {if !load8(names+i) || load8(names+i)==44 {let name=h_slice(names+start,i-start);h_assert(at_name(name),"invalid candidate selection");let found=0;let j=0;while j<j_count(selected) {if h_equal(name,j_s(j_at(selected,j),"name")) {found=1;}j=j+1;}h_assert(found,"unknown or non-GEMM candidate");if !load8(names+i) {more=0;}else {start=i+1;}}i=i+1;}}
    i=0;while i<j_count(shapes) {at_shape(j_at(shapes,i));let j=0;while j<i {h_assert(!h_equal(j_s(j_at(shapes,i),"name"),j_s(j_at(shapes,j),"name")),"duplicate workload name");j=j+1;}i=i+1;}
    // Verify the launch ABI against generated source before compiling or
    // executing a candidate. A source hash alone cannot bind tile metadata.
    i=0;while i<j_count(selected) {let tile=j_at(selected,i);let source=j_s(tile,"source");h_assert(h_equal(j_s(tile,"precision"),"fp32") && h_equal(j_s(tile,"bucket"),"compute"),"unsupported candidate mode");h_assert(h_equal(h_sha(source),j_s(tile,"sourceSha256")),"generated source changed after manifest");let mark=h_mark();let expected=at_kernel(tile,at_relative(h_dir(source),h_join(repo,"lib/gpu.flex")));h_assert(h_equal(h_read(source),expected),"manifest tile does not match generated source");h_reset(mark);i=i+1;}
    h_mkdir(output);output=h_real(output);let binary=h_join(output,"gemm-bench");let fill=h_join(output,"fill.image");let merge=h_join(output,"merge.image");at_run(h_args(compiler,h_join(repo,"libs/autotune/gemm-bench.flex"),"-o",binary,0,0),h_join(output,"build-bench.log"));at_run(h_args(compiler,"--target",target,h_join(repo,"libs/autotune/kernels/fill.flex"),"-o",fill),h_join(output,"build-fill.log"));at_run(h_args(compiler,"--target",target,h_join(repo,"libs/autotune/kernels/merge.flex"),"-o",merge),h_join(output,"build-merge.log"));
    let report=j_object();j_set(report,"version",j_int(1));j_set(report,"scope",j_string("isolated FP32 GEMM including split merge; not whole-step MFU"));j_set(report,"timing_unit",j_string("nanoseconds"));j_set(report,"throughput_unit",j_string("GFLOP/s, integer"));j_set(report,"target",j_string(target));j_set(report,"compilerSha256",j_string(h_sha(compiler)));j_set(report,"manifestSha256",j_string(h_sha(manifest_path)));j_set(report,"configSha256",j_string(h_sha(config_path)));j_set(report,"harnessSources",at_sources(repo));j_set(report,"samples",j_int(samples));j_set(report,"warmup",j_int(warmup));let results=j_array();j_set(report,"results",results);let winners=j_object();j_set(report,"bestByShape",winners);
    i=0;while i<j_count(selected) {let tile=j_at(selected,i);let name=j_s(tile,"name");let source=j_s(tile,"source");let image=j_s(tile,"image");h_assert(h_equal(h_sha(source),j_s(tile,"sourceSha256")),"generated source changed after manifest");at_run(h_args(compiler,"--target",target,source,"-o",image),h_join(output,h_cat3("build-",name,".log")));let j=0;
        while j<j_count(shapes) {let shape=j_at(shapes,j);let request=j_parse(j_dump(shape));j_set(request,"tile",tile);j_set(request,"image",j_string(image));j_set(request,"fill",j_string(fill));j_set(request,"merge",j_string(merge));j_set(request,"samples",j_int(samples));j_set(request,"warmup",j_int(warmup));let path=h_join(output,h_cat3(name,"-",h_cat(j_s(shape,"name"),".json")));j_save(path,request);let raw=at_run(h_args(binary,path,0,0,0,0),h_cat(path,".log"));let measured=j_parse(raw);let stats=at_stats(j_need(measured,"nanoseconds"));let median=j_n(stats,"median_ns");let row=j_object();j_set(row,"candidate",j_string(name));j_set(row,"shape",shape);j_set(row,"measurements",measured);j_set(row,"statistics",stats);j_set(row,"gflops",j_int(j_n(measured,"flops")/median));j_set(row,"sourceSha256",j_string(h_sha(source)));j_set(row,"imageSha256",j_string(h_sha(image)));j_push(results,row);
            let best=j_get(winners,j_s(shape,"name"));if !best || median<j_n(j_need(best,"statistics"),"median_ns") {j_set(winners,j_s(shape,"name"),row);}j_save(h_join(output,"results.json"),report);h_print(1,h_cat3(name," ",h_cat3(j_s(shape,"name"),": ",h_cat3(h_int(median)," ns; GFLOP/s ",h_cat(h_int(j_n(row,"gflops")),"; CPU reference passed\n")))));j=j+1;
        }i=i+1;
    }return 0;
}
fn at_main(argc,argv) {
    h_environment(argc,argv);h_timeout=300000;
    if argc<2 || h_equal(load64(argv+8),"--help") {h_print(1,"Native Flexscript autotune\n  autotune generate|check --repo PATH --config FILE --output DIR [--sweep production|compute] [--target hip|rdna-gfx1201] [--manifest FILE]\n  autotune bench --repo PATH --config FILE --manifest FILE --output DIR [--compiler FILE] [--candidates NAME,NAME] [--samples 10] [--warmup 5]\n");return 0;}
    let action=load64(argv+8);h_assert(h_equal(action,"generate") || h_equal(action,"check") || h_equal(action,"bench"),"unknown autotune command");let options=at_parse(argc,argv);let repo=h_real(at_option(options,"--repo","."));h_assert(h_exists(h_join(repo,"lib/gpu.flex")) && h_exists(h_join(repo,"libs/autotune/tiles.flex")),"--repo must name Flexscript source root");let config=h_real(at_option(options,"--config",h_join(repo,"libs/autotune/examples/gemm.json")));let default_output=h_join(repo,"build/autotune/candidates");if h_equal(action,"bench") {default_output=h_join(repo,"build/autotune/results");}let output=at_option(options,"--output",default_output);let default_manifest=h_join(output,"manifest.json");if h_equal(action,"bench") {default_manifest=h_join(repo,"build/autotune/candidates/manifest.json");}let manifest=at_option(options,"--manifest",default_manifest);
    if !h_equal(action,"bench") {return at_generate(repo,config,output,manifest,at_option(options,"--sweep","production"),at_option(options,"--target","hip"),h_equal(action,"check"));}
    let compiler=h_real(at_option(options,"--compiler",h_join(repo,"build/flex")));return at_bench(repo,compiler,config,h_real(manifest),output,at_option(options,"--candidates",0),at_number_option(options,"--samples",10,1,100),at_number_option(options,"--warmup",5,0,100));
}
