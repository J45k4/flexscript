}
fn at_value(values,key,value) {return j_set(values,h_cat3("@",key,"@"),j_int(value));}
fn at_line(out,text,values) {let fields=j_value(values);let i=0;while i<h_count(fields) {let pair=h_at(fields,i);let key=load64(pair);if h_find(text,key)>=0 {text=h_replace(text,key,h_int(j_value(load64(pair+8))));}i=i+1;}h_text(out,text);h_text(out,"\n");return 0;}
fn at_kernel(tile,gpu_import) {
    h_assert(at_tile_valid(tile),"invalid kernel tile");let family=j_s(tile,"family");let deconv=h_equal(family,"deconv4x4s2");h_assert(deconv || h_equal(family,"gemm"),"unsupported kernel family");
    let M=j_n(tile,"m");let N=j_n(tile,"n");let K=j_n(tile,"k");let T=j_n(tile,"threads");let LC=j_n(tile,"laneColumns");let LR=T/LC;let R=M/LR;let C=N/LC;let values=j_object();
