if deconv {
at_line(out,"let ci=kk>>2;let ty=(kk>>1)&1;let tx=kk&1;let ky=(py^1)+ty*2;let kx=(px^1)+tx*2;let offset=((ci*m+r)*4+ky)*4+kx;v0=gpu_load_u32(a+offset*4);if kk+1<k {v1=gpu_load_u32(a+(offset+2)*4);}",values);
}else {
