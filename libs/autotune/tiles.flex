let t=0;while t<K {at_value(values,"t",t);at_value(values,"TK",t/2);at_value(values,"TS",(t%2)*32);at_line(out,"{",values);
r=0;while r<R {at_value(values,"r",r);at_value(values,"RR",r*LR);at_line(out,"let a@r@=(gpu_shared_load64(((lr+@RR@)*@AS@+@TK@)*8)>>@TS@)&4294967295;",values);
r=r+1;}let c=0;while c<C/2 {at_value(values,"c",c);at_value(values,"CC",c*LC);at_value(values,"C0",c*2);at_value(values,"C1",c*2+1);at_line(out,"let p@c@=gpu_shared_load64(@BS@+(@t@*@NB@+lc/2+@CC@)*8);let b@C0@=p@c@&4294967295;let b@C1@=p@c@>>32;",values);
c=c+1;}r=0;while r<R {c=0;while c<C {at_value(values,"r",r);at_value(values,"c",c);at_line(out,"s@r@_@c@=gpu_f32_fma(a@r@,b@c@,s@r@_@c@);",values);
c=c+1;}r=r+1;}at_line(out,"}",values);
