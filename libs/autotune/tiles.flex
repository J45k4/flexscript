// Reusable FP32 packed-LDS tile generator. No application/runtime imports.
import "common.flex";
fn at_tile_valid(tile) {
    let m=j_n(tile,"m");let n=j_n(tile,"n");let k=j_n(tile,"k");let threads=j_n(tile,"threads");let lc=j_n(tile,"laneColumns");
