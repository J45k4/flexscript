}
at_line(out,"}gpu_shared_store64(at*8,v0|(v1<<32));at=at+@T@;}at=lane;while at<@BL@ {let kk=base+at/@NB@;let c=(block%tiles)*@N@+(at%@NB@)*2;let dest=at;",values);
if !deconv {
at_line(out,"if flags&2 {kk=base+at%@K@;c=(block%tiles)*@N@+(at/@K@)*2;dest=(at%@K@)*@NB@+at/@K@;}",values);
}
at_line(out,"let v0=0;let v1=0;if c<n && kk<k {",values);
if deconv {
at_line(out,"let ci=kk>>2;let ty=(kk>>1)&1;let tx=kk&1;let bn=c>>(lw+lh);let y=((c>>lw)&(ih-1))+py-ty;let x=(c&(iw-1))+px-tx;if y>=0 && y<ih && x>=0 && x<iw {v0=gpu_load_u32(b+(((bn*cin+ci)*ih+y)*iw+x)*4);}let next=c+1;if next<n {bn=next>>(lw+lh);y=((next>>lw)&(ih-1))+py-ty;x=(next&(iw-1))+px-tx;if y>=0 && y<ih && x>=0 && x<iw {v1=gpu_load_u32(b+(((bn*cin+ci)*ih+y)*iw+x)*4);}}",values);
}else {
