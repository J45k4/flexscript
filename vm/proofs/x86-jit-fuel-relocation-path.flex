// The proof gate loads the production fuel relocation profile and the
// selected exhaustion path before checking this root. Only the meter's
// four displacement bytes are supplied by relocation. The other code bytes,
// frame and context grants, and address layout are premises.
requires start>=0 && start<=67108864-23;
requires slot>=-32776 && slot<=-8;
requires (target-(start+14)-4)>=6 && (target-(start+14)-4)<=67108864;
requires (output+start)>=0 && (output+start)<=0x7fffffffffffffff-67108882;
requires readable_bytes((output+start),23);
requires readable_bytes(rbp+slot,8);
requires load64(rbp+slot)==vm_jit_context;
requires writable_bytes(vm_jit_context+8,8);
requires load64(vm_jit_context+8)==0;
requires disjoint_bytes(vm_jit_context+8,8,(output+start),23);
requires disjoint_bytes(vm_jit_context+8,8,rbp+slot,8);
requires load8((output+start)+0)==76;
requires load8((output+start)+1)==139;
requires load8((output+start)+2)==157;
requires load8((output+start)+7)==73;
requires load8((output+start)+8)==131;
requires load8((output+start)+9)==123;
requires load8((output+start)+10)==8;
requires load8((output+start)+11)==0;
requires load8((output+start)+12)==15;
requires load8((output+start)+13)==132;
requires load8((output+start)+18)==73;
requires load8((output+start)+19)==131;
requires load8((output+start)+20)==107;
requires load8((output+start)+21)==8;
requires load8((output+start)+22)==1;
requires load8((output+start)+3)==((slot>>0)&255);
requires load8((output+start)+4)==((slot>>8)&255);
requires load8((output+start)+5)==((slot>>16)&255);
requires load8((output+start)+6)==((slot>>24)&255);
requires (output+target)>=0 && (output+target)<=0x7fffffffffffffff-22;
requires rbp>=32776 && rbp<=0x7fffffffffffffff-16;
requires readable_bytes((output+target),22);
requires readable_bytes(rbp,16);
requires writable_bytes(vm_jit_context+16,8);
requires disjoint_bytes(vm_jit_context+16,8,rbp,16);
requires disjoint_bytes(vm_jit_context+16,8,rbp+slot,8);
requires disjoint_bytes(vm_jit_context+16,8,(output+target),22);
requires load8((output+target)+0)==76;
requires load8((output+target)+1)==139;
requires load8((output+target)+2)==157;
requires load8((output+target)+7)==73;
requires load8((output+target)+8)==199;
requires load8((output+target)+9)==67;
requires load8((output+target)+10)==16;
requires load8((output+target)+11)==1;
requires load8((output+target)+12)==0;
requires load8((output+target)+13)==0;
requires load8((output+target)+14)==0;
requires load8((output+target)+15)==184;
requires load8((output+target)+16)==0;
requires load8((output+target)+17)==0;
requires load8((output+target)+18)==0;
requires load8((output+target)+19)==0;
requires load8((output+target)+20)==201;
requires load8((output+target)+21)==195;
requires load8((output+target)+3)==((slot>>0)&255);
requires load8((output+target)+4)==((slot>>8)&255);
requires load8((output+target)+5)==((slot>>16)&255);
requires load8((output+target)+6)==((slot>>24)&255);
requires (output+target)==(output+start)+18+(target-(start+14)-4);
requires disjoint_bytes(vm_jit_context+8,8,(output+target),22);
requires disjoint_bytes(vm_jit_context+8,8,rbp,16);
requires disjoint_bytes(vm_jit_context+16,8,vm_jit_context+8,8);
requires readable_bytes(vm_jit_context+8,16);
requires fuel>=0;
requires vm_steps>=0 && vm_steps<=0x7fffffffffffffff-fuel;
requires vm_jit_calls>=0 && vm_jit_calls<0x7fffffffffffffff;
requires vm_mode==0;
requires row>=0 && row<32768;
requires (start+14)>=2 && (start+14)<=67108860;
requires target>=(start+14)+4 && target<=67108864;
requires output+(start+14)>=2 && output+(start+14)<=9223372036854775803;
requires writable_bytes(output+(start+14),4);
requires readable_bytes(output+(start+14)-2,2);
requires load8(output+(start+14)-2)==15 && load8(output+(start+14)-1)==132;
requires readable_bytes(vm_jit_errors+row*16,16);
requires load64(vm_jit_errors+row*16)==(start+14) && load64(vm_jit_errors+row*16+8)==1;
requires disjoint_bytes(output+(start+14),4,vm_jit_errors+row*16,16);
requires disjoint_bytes(output+(start+14),4,output+(start+14)-2,2);
requires disjoint_bytes(output+(start+14),4,(output+start),14);
requires disjoint_bytes(output+(start+14),4,(output+start)+18,5);
requires disjoint_bytes(output+(start+14),4,(output+target),22);
requires disjoint_bytes(output+(start+14),4,rbp+slot,8);
requires disjoint_bytes(output+(start+14),4,rbp,16);
requires disjoint_bytes(output+(start+14),4,vm_jit_context+8,16);
modifies x86_meter_r11,x86_fuel_return_rax,x86_fuel_return_r11,x86_fuel_return_rbp,x86_fuel_return_rsp,x86_fuel_path_rip,
    vm_acc,vm_fuel,vm_error,vm_steps,vm_jit_calls,vm_depth,vm_pc,vm_local_base,vm_local_top,vm_sp,vm_finished,
    bytes(vm_jit_context+8,8),bytes(vm_jit_context+16,8),bytes(output+(start+14),4);
ensures x86_fuel_path_rip==old(load64(rbp+8));
ensures x86_fuel_return_rbp==old(load64(rbp));
ensures x86_fuel_return_rsp==rbp+16;
ensures x86_fuel_return_r11==vm_jit_context && x86_fuel_return_rax==0;
ensures result==1 && vm_error==1 && vm_acc==0 && vm_fuel==0;
ensures load64(vm_jit_context+8)==0 && load64(vm_jit_context+16)==1;
ensures vm_steps==old(vm_steps)+fuel && vm_jit_calls==old(vm_jit_calls)+1;
ensures vm_depth==old(vm_depth) && vm_pc==old(vm_pc);
ensures vm_local_base==old(vm_local_base) && vm_local_top==old(vm_local_top);
ensures vm_sp==old(vm_sp) && vm_finished==old(vm_finished);
fn x86_relocate_and_exhaust_fuel(start,rbp,slot,fuel,row,target) {
    vm_jit_patch_fuel_record(row,row,(start+14),0,target,0,0,0);
    return x86_fuel_exhaustion_path((output+start),(output+target),rbp,slot,(target-(start+14)-4),fuel);
}
