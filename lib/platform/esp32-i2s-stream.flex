// Original-chip circular I2S DMA. Imported by esp32-i2s.flex.
// Per direction state pointer at common+160/168. Retained2176-byte control:
// active0,next lease8,take cursor16,error24,count32,descriptors40,block bytes48,
// takes56,releases64,faults72,publish cursor80;64 records at128,stride32:
// copied buffer0,bytes8,current lease16,claimed24. Pools are reused,never freed.
// Caller owns descriptors,immutable packed block table and disjoint payloads.
// A positive take result is a unique lease;getters expose only that CPU-owned
// block. Release is ordered and publishes ownership last. IRQs serialize CPU0.
fn eis_control(state,direction){if !state{return 0;}return load64(state+160+direction*8);}
fn eis_active(state,direction){let p=eis_control(state,direction);return p && load64(p);}
fn eis_stopped(state,direction){let p=eis_control(state,direction);if p && load64(p){store64(p,0);let i=0;while i<load64(p+32){store64(p+128+i*32+16,0);store64(p+128+i*32+24,0);i=i+1;}}return 0;}
fn eis_internal_overlap(address,size){if esp_i2s_states && eia_overlap(address,size,esp_i2s_states,512){return 1;}let bus=0;while bus<2{let state=eia_state(bus);let direction=0;while state && direction<2{let p=eis_control(state,direction);if p && eia_overlap(address,size,p,2176){return 1;}direction=direction+1;}bus=bus+1;}return 0;}
fn eis_resource_overlap(state,direction,address,size){let p=eis_control(state,direction);let count=load64(p+32);if eia_overlap(address,size,load64(p+40),count*16) || eia_overlap(address,size,load64(state+144+direction*8),count*8) || eia_overlap(address,size,p,2176){return 1;}let i=0;while i<count{let item=p+128+i*32;if eia_overlap(address,size,load64(item),load64(item+8)){return 1;}i=i+1;}return 0;}
fn eis_error_mask(direction){if direction{return (1<<14)|(1<<16);}return (1<<10)|(1<<13)|(1<<15);}
fn eis_fail(bus,direction,state,p,error){store64(p+24,error);store64(p+72,load64(p+72)+1);eia_stop(bus,direction,state);return error;}
fn eis_node_valid(p,direction,index,completed){let n=load64(p+32);let desc=load64(p+40)+index*16;let item=p+128+index*32;let size=load64(item+8);let word=esp32_load32(desc);let next=load64(p+40)+((index+1)%n)*16;
 if (word&4095)!=size || esp32_load32(desc+4)!=load64(item) || esp32_load32(desc+8)!=next || esp32_load32(desc+12){return 0;}let used=(word>>12)&4095;if direction && (used!=size || !(word&0x40000000)){return 0;}if !direction && (used>size || (completed && (used!=size || !(word&0x40000000)))){return 0;}return 1;}
fn eis_service(bus,direction,state,p){if !load64(p){return load64(p+24);}let base=esp_i2s_base(bus);let status=esp32_load32(base+0xc);if status&eis_error_mask(direction){let error= -5;let cpu_owned=0;let valid=1;let i=0;while i<load64(p+32){if !eis_node_valid(p,direction,i,0){valid=0;}if !(esp32_load32(load64(p+40)+i*16)&0x80000000){cpu_owned=1;}i=i+1;}let owner_error=(status&(1<<(13+direction)))!=0;if valid && cpu_owned && owner_error{error= -75;if direction{error= -32;}}return eis_fail(bus,direction,state,p,error);}esp32_store32(base+0x18,status&eia_status_mask(direction));return 0;}
fn esp_i2s_stream_interrupts(bus,rx,tx){let base=esp_i2s_base(bus);if !base || rx<0 || rx>1 || tx<0 || tx>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}esp32_store32(base+0x14,rx*(eia_irq_mask(0)|(1<<15))|tx*(eia_irq_mask(1)|(1<<16)));return 0;}
fn esp_i2s_stream_start(bus,direction,descriptors,blocks,count){let base=esp_i2s_base(bus);if !base || direction<0 || direction>1 || count<2 || count>64 || (descriptors&3) || (blocks&3) || !esp_buffer_valid(descriptors,count*16) || !esp_buffer_valid(blocks,count*8){return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let ps=esp32_irq_save();let total=eia_chain_validate(state,direction,descriptors,blocks,count);if total<0{esp32_irq_restore(ps);return total;}
 if eis_internal_overlap(descriptors,count*16) || eis_internal_overlap(blocks,count*8){esp32_irq_restore(ps);return -22;}let bytes=esp32_load32(blocks+4);let i=0;while i<count{let data=esp32_load32(blocks+i*8);if esp32_load32(blocks+i*8+4)!=bytes || eis_internal_overlap(data,bytes){esp32_irq_restore(ps);return -22;}let j=0;while j<i{if eia_overlap(data,bytes,esp32_load32(blocks+j*8),bytes){esp32_irq_restore(ps);return -22;}j=j+1;}i=i+1;}
 if (esp32_load32(base+0x60)&0x1140)!=0x1140{esp32_irq_restore(ps);return -95;}let p=eis_control(state,direction);if !p{p=alloc(2176);if p<=0{esp32_irq_restore(ps);return -12;}i=0;while i<2176{store8(p+i,0);i=i+1;}store64(state+160+direction*8,p);}if load64(p){esp32_irq_restore(ps);return -16;}if load64(p+8)>=0x7ffffffffffffe{esp32_irq_restore(ps);return -75;}
 store64(p+16,0);store64(p+24,0);store64(p+32,count);store64(p+40,descriptors);store64(p+48,bytes);store64(p+56,0);store64(p+64,0);store64(p+80,0);i=0;while i<count{let item=p+128+i*32;store64(item,esp32_load32(blocks+i*8));store64(item+8,bytes);store64(item+16,0);store64(item+24,0);i=i+1;}
 store64(state+8,load64(state+8)|(1<<direction));store64(state+64+direction*16,descriptors);store64(state+72+direction*16,total);store64(state+96+direction*8,esp32_load32(blocks));store64(state+128+direction*8,count);store64(state+144+direction*8,blocks);store64(p,1);
 i=0;while i<count{let used=0;if direction{used=bytes;}let next=descriptors+((i+1)%count)*16;let error=esp_dma_descriptor(descriptors+i*16,load64(p+128+i*32),bytes,used,next,1);if error{eis_fail(bus,direction,state,p,error);esp32_irq_restore(ps);return error;}i=i+1;}
 let reset=1<<(1-direction);let fifo=1<<(3-direction);esp_reg_update(base+8,reset|fifo,reset|fifo);esp_reg_update(base+8,reset|fifo,0);esp_reg_update(base+0x60,1<<direction,1<<direction);esp_reg_update(base+0x60,1<<direction,0);esp32_store32(base+0x18,eia_status_mask(direction));if !direction{esp32_store32(base+0x24,bytes/4);}esp32_store32(base+0x34-direction*4,(descriptors&0xfffff)|(1<<29));esp_reg_update(base+8,1<<(5-direction),1<<(5-direction));esp32_irq_restore(ps);return 0;
}
// Status:1 running,0 stopped,negative terminal error. Service acknowledges only
// this direction;ownership is reclaimed only by take,never by an IRQ count.
fn esp_i2s_stream_status(bus,direction){if !esp_i2s_base(bus) || direction<0 || direction>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let p=eis_control(state,direction);if !p{return -19;}let ps=esp32_irq_save();let error=eis_service(bus,direction,state,p);let result=load64(p);if error{result=error;}esp32_irq_restore(ps);return result;}
fn esp_i2s_stream_take(bus,direction){if !esp_i2s_base(bus) || direction<0 || direction>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let p=eis_control(state,direction);if !p{return -19;}let ps=esp32_irq_save();let error=eis_service(bus,direction,state,p);if error || !load64(p){esp32_irq_restore(ps);if error{return error;}return -19;}let index=load64(p+16);let item=p+128+index*32;let desc=load64(p+40)+index*16;if load64(item+24) || (esp32_load32(desc)&0x80000000){esp32_irq_restore(ps);return 0;}if !eis_node_valid(p,direction,index,1){error=eis_fail(bus,direction,state,p,-5);esp32_irq_restore(ps);return error;}if load64(p+8)>=0x7ffffffffffffe{error=eis_fail(bus,direction,state,p,-75);esp32_irq_restore(ps);return error;}
 let id=load64(p+8)+1;let token=id*256+(bus*2+direction)*64+index+1;store64(p+8,id);store64(item+16,token);store64(item+24,1);store64(p+16,(index+1)%load64(p+32));store64(p+56,load64(p+56)+1);esp32_irq_restore(ps);return token;}
fn eis_lease(state,direction,token){let p=eis_control(state,direction);if !p || !load64(p) || token<=0{return 0;}let channel=(((state-esp_i2s_states)>>8)*2)+direction;if (((token-1)>>6)&3)!=channel{return 0;}let index=(token-1)&63;if index>=load64(p+32){return 0;}let item=p+128+index*32;if !load64(item+24) || load64(item+16)!=token{return 0;}return item;}
fn esp_i2s_stream_buffer(bus,direction,token){if !esp_i2s_base(bus) || direction<0 || direction>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let ps=esp32_irq_save();let item=eis_lease(state,direction,token);let value= -22;if item{value=load64(item);}esp32_irq_restore(ps);return value;}
fn esp_i2s_stream_bytes(bus,direction,token){if !esp_i2s_base(bus) || direction<0 || direction>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let ps=esp32_irq_save();let item=eis_lease(state,direction,token);let value= -22;if item{value=load64(item+8);}esp32_irq_restore(ps);return value;}
fn esp_i2s_stream_release(bus,direction,token){if !esp_i2s_base(bus) || direction<0 || direction>1{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let p=eis_control(state,direction);let ps=esp32_irq_save();let item=eis_lease(state,direction,token);if !item{esp32_irq_restore(ps);return -22;}let error=eis_service(bus,direction,state,p);if error{esp32_irq_restore(ps);return error;}let index=(token-1)&63;if index!=load64(p+80){esp32_irq_restore(ps);return -11;}if !eis_node_valid(p,direction,index,1) || (esp32_load32(load64(p+40)+index*16)&0x80000000){error=eis_fail(bus,direction,state,p,-5);esp32_irq_restore(ps);return error;}
 let used=0;if direction{used=load64(item+8);}let next=load64(p+40)+((index+1)%load64(p+32))*16;error=esp_dma_descriptor(load64(p+40)+index*16,load64(item),load64(item+8),used,next,1);if error{error=eis_fail(bus,direction,state,p,error);esp32_irq_restore(ps);return error;}store64(item+16,0);store64(item+24,0);store64(p+80,(index+1)%load64(p+32));store64(p+64,load64(p+64)+1);esp32_irq_restore(ps);return 0;}
fn esp_i2s_stream_counter(bus,direction,which){if !esp_i2s_base(bus) || direction<0 || direction>1 || which<0 || which>2{return -22;}let state=eia_state(bus);if !state || !load64(state){return -19;}let p=eis_control(state,direction);if !p{return -19;}return load64(p+56+which*8);}
