// Original ESP32 RMT, independent of compiler encoders and platform drivers.
// State262144..263167 (8*128), shared SRAM263168..265215,
// register bank265216..265471, active TX/RX masks265472/265480.
// Functional APB/REF_TICK timing; carrier, FIFO access and TX looping/wrap
// remain explicit unsupported operations. S3 has a different peripheral.
fn se_rmt(s,ch){return s+262144+ch*128;}
fn se_rmt_get(s,offset){return em_u32(s+265216+offset);}
fn se_rmt_put(s,offset,value){em_put32(s+265216+offset,value);return 0;}
fn se_rmt_c0(s,ch){return se_rmt_get(s,32+ch*8);}
fn se_rmt_c1(s,ch){return se_rmt_get(s,36+ch*8);}
fn se_rmt_running(s){return !se_chip(s) && se_enabled(s,9) && (se_rmt_c0(s,0)&0xc0000000)==0x80000000;}
fn se_rmt_divider(s,ch){let n=se_rmt_c0(s,ch)&255;if !n{n=256;}if !(se_rmt_c1(s,ch)&(1<<17)){n=n*80;}else{n=n*se_apb_factor(s);}return n;}
fn se_rmt_capacity(s,ch){let blocks=(se_rmt_c0(s,ch)>>24)&15;if blocks<1 || blocks>8-ch{return -95;}return blocks*128;}
fn se_rmt_event(s,ch,kind){se_rmt_put(s,160,se_rmt_get(s,160)|(1<<(ch*3+kind)));return 0;}
fn se_rmt_idle(s,ch){let c=se_rmt_c1(s,ch);if c&32{return se_gpio_peripheral(s,87+ch,0,0);}let level=load64(s+226000+(87+ch)*16)&1;if c&(1<<19){level=(c>>18)&1;}return se_gpio_peripheral(s,87+ch,level,1);}
fn se_rmt_stop_rx(s,ch){store64(se_rmt(s,ch)+24,0);store64(s+265480,load64(s+265480)&~(1<<ch));return 0;}
fn se_rmt_stop_tx(s,ch){store64(se_rmt(s,ch),0);store64(s+265472,load64(s+265472)&~(1<<ch));return se_rmt_idle(s,ch);}
fn se_rmt_error(s,ch,status){se_rmt_put(s,96+ch*4,se_rmt_get(s,96+ch*4)|status);se_rmt_stop_rx(s,ch);let result=se_rmt_stop_tx(s,ch);se_rmt_event(s,ch,2);return result;}
fn se_rmt_reset(s){em_zero(s+262144,1024);em_zero(s+265216,272);let ch=0;while ch<8{se_rmt_put(s,32+ch*8,0x31100002);se_rmt_put(s,36+ch*8,0x00000f20);se_rmt_put(s,176+ch*4,0x00400040);se_rmt_put(s,208+ch*4,128);se_gpio_peripheral(s,87+ch,0,0);ch=ch+1;}se_rmt_put(s,252,0x16022600);return 0;}
fn se_rmt_rx_word(s,ch,half){let p=se_rmt(s,ch);let index=load64(p+56);let cap=se_rmt_capacity(s,ch);if index>=cap{return se_rmt_error(s,ch,1<<28);}let at=s+263168+ch*256+(index/2)*4;let old=em_u32(at);let shift=(index&1)*16;em_put32(at,(old&~(65535<<shift))|((half&65535)<<shift));store64(p+56,index+1);let status=se_rmt_get(s,96+ch*4);se_rmt_put(s,96+ch*4,(status&~1023)|(ch*64+(index+1)/2));return 0;}
fn se_rmt_rx_end(s,ch){let p=se_rmt(s,ch);let n=load64(p+56);if n<se_rmt_capacity(s,ch){let result=se_rmt_rx_word(s,ch,0);if result{return result;}}se_rmt_stop_rx(s,ch);se_rmt_event(s,ch,1);return 0;}
fn se_rmt_accept(s,ch,level,when){let p=se_rmt(s,ch);if !load64(p+24) || level==load64(p+40){return 0;}if load64(p+32){let duration=(when-load64(p+48))/se_rmt_divider(s,ch);if duration>32767{return se_rmt_error(s,ch,1<<28);}if duration>0{let result=se_rmt_rx_word(s,ch,duration|(load64(p+40)<<15));if result || !load64(p+24){return result;}}}else{store64(p+32,1);}store64(p+40,level);store64(p+48,when);store64(p+64,when+((se_rmt_c0(s,ch)>>8)&65535)*se_rmt_divider(s,ch));return 0;}
fn se_rmt_rx_due(s,ch){let p=se_rmt(s,ch);let now=load64(s+16);if !load64(p+24){return 0;}if load64(p+64)<=now{return se_rmt_rx_end(s,ch);}if load64(p+88) && load64(p+88)<=now{let when=load64(p+88);store64(p+88,0);return se_rmt_accept(s,ch,load64(p+80),when);}return 0;}
fn se_rmt_inputs(s){if se_chip(s) || !load64(s+265480) || !se_rmt_running(s){return 0;}let ch=0;while ch<8{let p=se_rmt(s,ch);if load64(p+24){let result=se_rmt_rx_due(s,ch);if result{return result;}if load64(p+24){let level=se_gpio_signal(s,83+ch);if level<0{return level;}if level!=load64(p+72){store64(p+72,level);let cfg=se_rmt_c1(s,ch);let filter=0;if cfg&128{filter=(cfg>>8)&255;}if filter && level!=load64(p+40){store64(p+80,level);store64(p+88,load64(s+16)+filter*se_apb_factor(s));}else{store64(p+88,0);if !filter{result=se_rmt_accept(s,ch,level,load64(s+16));if result{return result;}}}}}}ch=ch+1;}return 0;}
fn se_rmt_start_rx(s,ch){let p=se_rmt(s,ch);let cap=se_rmt_capacity(s,ch);if cap<0{return cap;}if !(se_rmt_c1(s,ch)&32){return se_rmt_error(s,ch,1<<27);}if load64(p){return -95;}let level=se_gpio_signal(s,83+ch);if level<0{return level;}let idle=(se_rmt_c0(s,ch)>>8)&65535;if !idle || idle>32767{return -95;}store64(p+24,1);store64(p+32,0);store64(p+40,level);store64(p+48,load64(s+16));store64(p+64,load64(s+16)+idle*se_rmt_divider(s,ch));store64(p+72,level);store64(p+88,0);store64(s+265480,load64(s+265480)|(1<<ch));return 0;}
fn se_rmt_tx_next(s,ch,when){let p=se_rmt(s,ch);let index=load64(p+16);let cap=se_rmt_capacity(s,ch);if index>=cap{return se_rmt_error(s,ch,1<<29);}let word=em_u32(s+263168+ch*256+(index/2)*4);let half=(word>>((index&1)*16))&65535;let duration=half&32767;
 if !duration{if !(se_rmt_c1(s,ch)&(1<<19)){let edge=se_gpio_peripheral(s,87+ch,half>>15,1);if edge{return edge;}}let result=se_rmt_stop_tx(s,ch);se_rmt_event(s,ch,0);return result;}
 let status=se_rmt_get(s,96+ch*4);se_rmt_put(s,96+ch*4,(status&~(1023<<12))|((ch*64+index/2)<<12));if !(index&1) && index/2==se_rmt_get(s,208+ch*4){se_rmt_put(s,160,se_rmt_get(s,160)|(1<<(24+ch)));}
 store64(p+8,when+duration*se_rmt_divider(s,ch));return se_gpio_peripheral(s,87+ch,half>>15,1);
}
fn se_rmt_start_tx(s,ch){let p=se_rmt(s,ch);let cap=se_rmt_capacity(s,ch);if cap<0{return cap;}let c1=se_rmt_c1(s,ch);if c1&32{return se_rmt_error(s,ch,1<<27);}if (se_rmt_c0(s,ch)&(1<<28)) || (c1&64) || (se_rmt_get(s,240)&2) || load64(p+24){return -95;}if load64(p){return -16;}store64(p,1);store64(s+265472,load64(s+265472)|(1<<ch));return se_rmt_tx_next(s,ch,load64(s+16));}
fn se_rmt_tick(s,delta){if se_chip(s) || !(load64(s+265472)|load64(s+265480)){return 0;}let ch=0;if !se_rmt_running(s){while ch<8{let p=se_rmt(s,ch);if load64(p){store64(p+8,load64(p+8)+delta);}if load64(p+24){store64(p+48,load64(p+48)+delta);store64(p+64,load64(p+64)+delta);if load64(p+88){store64(p+88,load64(p+88)+delta);}}ch=ch+1;}return 0;}
 while ch<8{let p=se_rmt(s,ch);let result=se_rmt_rx_due(s,ch);if result{return result;}if load64(p) && load64(p+8)<=load64(s+16){let when=load64(p+8);store64(p+16,load64(p+16)+1);result=se_rmt_tx_next(s,ch,when);if result{return result;}}ch=ch+1;}return 0;}
fn se_rmt_deadline(s){if se_chip(s) || !(load64(s+265472)|load64(s+265480)) || !se_rmt_running(s){return -1;}let next= -1;let ch=0;while ch<8{let p=se_rmt(s,ch);let at= -1;if load64(p){at=load64(p+8);}if load64(p+24){let rx=load64(p+64);if load64(p+88) && load64(p+88)<rx{rx=load64(p+88);}if at<0 || rx<at{at=rx;}}if at>=0{let wait=at-load64(s+16);if wait<1{wait=1;}if next<0 || wait<next{next=wait;}}ch=ch+1;}return next;}
fn se_rmt_irq(s){return !se_chip(s) && se_enabled(s,9) && (se_rmt_get(s,160)&se_rmt_get(s,168));}
fn se_rmt_bus(s,address,writing,value){if !se_enabled(s,9){return -5;}let offset=address-0x3ff56000;
 if offset>=2048 && offset<4096{if !se_rmt_running(s){return -5;}if !(se_rmt_get(s,240)&1){return -95;}let at=s+263168+offset-2048;if writing{em_put32(at,value);}return em_u32(at);}
 if offset<32{return -95;}if offset>=32 && offset<96{let ch=(offset-32)/8;let sub=(offset-32)&7;let old=se_rmt_get(s,offset);if !writing{return old;}if sub==0{if (load64(se_rmt(s,ch)) || load64(se_rmt(s,ch)+24)) && ((old^value)&(0xffffffff^((ch==0)*0xc0000000))){return -16;}se_rmt_put(s,offset,value);return 0;}if value&~0xfffff{return -95;}
 let p=se_rmt(s,ch);if (value&65536) && (load64(p) || load64(p+24)){return -95;}se_rmt_put(s,offset,value&~1);if value&4{store64(p+56,0);se_rmt_put(s,96+ch*4,(se_rmt_get(s,96+ch*4)&~(1023|(1<<28)|(1<<27)))|(ch*64));}if value&8{store64(p+16,0);se_rmt_put(s,96+ch*4,(se_rmt_get(s,96+ch*4)&~(1023<<12))|((ch*64)<<12));}if !(value&2){se_rmt_stop_rx(s,ch);}if (value&2) && !(old&2){let result=se_rmt_start_rx(s,ch);if result{return result;}}if value&1{let result=se_rmt_start_tx(s,ch);if result{return result;}}if !load64(p){return se_rmt_idle(s,ch);}return 0;}
 if offset>=96 && offset<128{if writing{return -13;}let ch=(offset-96)/4;let p=se_rmt(s,ch);let state=0;if load64(p){state=1;}else if load64(p+24){state=4;if load64(p+32){state=3;}}return (se_rmt_get(s,offset)&~(7<<24))|(state<<24);}if offset>=128 && offset<160{if writing{return -95;}return 0;}if offset==160 || offset==164{if writing{return -13;}let raw=se_rmt_get(s,160);if offset==164{raw=raw&se_rmt_get(s,168);}return raw;}if offset==168{if writing{se_rmt_put(s,168,value);}return se_rmt_get(s,168);}if offset==172{if writing{se_rmt_put(s,160,se_rmt_get(s,160)&~value);}return 0;}
 if offset>=176 && offset<240{if writing{if offset>=208 && value>511{return -22;}se_rmt_put(s,offset,value);}return se_rmt_get(s,offset);}if offset==240{if writing{if value&~3{return -95;}se_rmt_put(s,offset,value);}return se_rmt_get(s,offset);}if offset==252{if writing{se_rmt_put(s,offset,value);}return se_rmt_get(s,offset);}return -95;
}
