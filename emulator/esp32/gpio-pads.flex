// Numeric pad metadata from pinned ESP-IDF v5.5.1 C tables; no driver code.
// Per pin14 words: mux address,valid/output flags,RTC+1,pad address,mux mask,
// RTC function shift,IE,pullup,pulldown,hold,force hold,digital hold,sleep IE/OE.
fn se_gpio_pad_count(chip){if chip{return 49;}return 40;}
fn se_gpio_pad_data(chip){if chip{return "";}return "";}
fn se_gpio_pad_decode(s){let chip=load64(s+8);let text=se_gpio_pad_data(chip);let i=0;while i<se_gpio_pad_count(chip)*14{let value=0;let j=0;while j<8{let digit=load8(text+i*8+j)-48;if digit>9{digit=digit-39;}value=(value<<4)|digit;j=j+1;}store64(s+236000+i*8,value);i=i+1;}return 0;}
fn se_gpio_desc(s,pin,field){if pin<0 || pin>=se_gpio_pad_count(load64(s+8)) || field<0 || field>=14{return 0;}return load64(s+236000+(pin*14+field)*8);}
