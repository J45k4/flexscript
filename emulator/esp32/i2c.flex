 if oldclock && !clock{if ack==1{store64(p+216,2);return se_i2c_out(s,bus,1,load64(p+232));}if ack==3{store64(p+216,0);store64(p+184,0);store64(p+192,0);if phase==1{if !load64(p+200){store64(p+176,4);return se_i2c_out(s,bus,1,1);}if load64(p+208){store64(p+176,3);return se_i2c_slave_tx(s,bus);}store64(p+176,2);}return se_i2c_out(s,bus,1,1);}if phase==3{if ack==4{store64(p+304,load64(p+304)|64);se_i2c_irq_set(s,bus,16);if load64(p+232){store64(p+176,4);store64(p+216,0);return se_i2c_out(s,bus,1,1);}return se_i2c_slave_tx(s,bus);}if bit==8{store64(p+216,4);return se_i2c_out(s,bus,1,1);}return se_i2c_out(s,bus,1,se_i2c_tx_bit(load64(p+224),bit,(ctrl>>6)&1));}}
