fn se_i2c_abort(s,bus,raw){let p=se_i2c(s,bus);store64(p,0);store64(p+88,0);let status=0;if raw&256{status=4;}if raw&32{status=8;}if raw&1024{status=1;}store64(p+304,load64(p+304)|status);se_i2c_irq_set(s,bus,raw);se_i2c_put(s,bus,4,se_i2c_get(s,bus,4)&~32);return se_i2c_release(s,bus);}
fn se_i2c_cmd_done(s,bus){let p=se_i2c(s,bus);let index=load64(p+24);se_i2c_put(s,bus,88+index*4,se_i2c_get(s,bus,88+index*4)|0x80000000);store64(p+24,index+1);return 0;}
fn se_i2c_master_byte(s,bus){let p=se_i2c(s,bus);let op=load64(p+56);store64(p+40,0);store64(p+48,0);if op==1{let byte=se_i2c_tx_pop(s,bus);if byte<0{return se_i2c_abort(s,bus,256);}store64(p+48,byte);}store64(p+16,4);let hold=em_u32(p+1280+48);store64(p+8,load64(s+16)+hold);return 0;}
fn se_i2c_command(s,bus){let p=se_i2c(s,bus);let index=load64(p+24);if index>=16{return -95;}let command=em_u32(p+1152+index*4);let op=(command>>11)&7;if op>4{return -95;}store64(p+56,op);store64(p+96,command);if op==1 || op==2{store64(p+32,command&255);if !(command&255){se_i2c_cmd_done(s,bus);return se_i2c_command(s,bus);}return se_i2c_master_byte(s,bus);}if op==4{se_i2c_cmd_done(s,bus);se_i2c_irq_set(s,bus,8);store64(p,0);se_i2c_put(s,bus,4,se_i2c_get(s,bus,4)&~32);return 0;}
 if !op{let result=se_i2c_out(s,bus,1,1);if result{return result;}let wait=0;if !load64(p+256){wait=em_u32(p+1280)+se_apb_factor(s);}store64(p+16,1);store64(p+8,load64(s+16)+wait);return 0;}let result=se_i2c_out(s,bus,0,0);if result{return result;}result=se_i2c_out(s,bus,1,0);if result{return result;}store64(p+16,7);store64(p+8,load64(s+16)+em_u32(p+1280+0)+se_apb_factor(s));return 0;}
