 if !oldclock && clock{if ack==2{store64(p+216,3);return 0;}if ack==4{store64(p+304,(load64(p+304)&~1)|data);store64(p+232,data);if data{se_i2c_irq_set(s,bus,1024);}return 0;}if phase==3{store64(p+184,bit+1);return 0;}
