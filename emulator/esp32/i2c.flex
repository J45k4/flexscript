// Independent original ESP32 I2C wire engines. No driver/compiler imports.
// Two4096-byte contexts at270336. Metadata512, registers512, TX1024,
// RX1088, latched commands1152, latched timings1280. GPIO observers use a
// reentrancy guard278528; protected DPORT FIFO reads consume token278536.
fn se_i2c(s,bus){return s+270336+bus*4096;}
fn se_i2c_base(bus){return 0x3ff53000+bus*81920;}
fn se_i2c_reg(s,bus,offset){return se_i2c(s,bus)+512+offset;}
fn se_i2c_get(s,bus,offset){return em_u32(se_i2c_reg(s,bus,offset));}
fn se_i2c_put(s,bus,offset,value){em_put32(se_i2c_reg(s,bus,offset),value);return 0;}
fn se_i2c_signal(bus,data){if bus{return 95+data;}return 29+data;}
fn se_i2c_enabled(s,bus){return !se_chip(s) && se_enabled(s,7+bus*11);}
fn se_i2c_running(s,bus){return se_i2c_enabled(s,bus) && (se_i2c_get(s,bus,4)&256);}
fn se_i2c_irq_set(s,bus,mask){se_i2c_put(s,bus,32,se_i2c_get(s,bus,32)|mask);return 0;}
fn se_i2c_raw(s,bus){let p=se_i2c(s,bus);let conf=se_i2c_get(s,bus,24);let raw=se_i2c_get(s,bus,32);if load64(p+120)>(conf&31){raw=raw|1;}if load64(p+136)<=((conf>>5)&31){raw=raw|2;}return raw;}
fn se_i2c_irq(s,bus){if !se_i2c_running(s,bus){return 0;}return se_i2c_raw(s,bus)&se_i2c_get(s,bus,40);}
fn se_i2c_out(s,bus,data,value){let p=se_i2c(s,bus);let field=p+256+data*8;let changed=load64(field)!=value;store64(field,value);if !data && changed && load64(p){let timeout=em_u32(p+1280+12);if timeout{store64(p+80,load64(s+16)+timeout);}}return se_gpio_peripheral(s,se_i2c_signal(bus,data),value,1);}
fn se_i2c_release(s,bus){let result=se_i2c_out(s,bus,0,1);if result{return result;}return se_i2c_out(s,bus,1,1);}
fn se_i2c_reset(s,bus){let p=se_i2c(s,bus);em_zero(p,4096);store64(p+160,1);store64(p+168,1);store64(p+256,1);store64(p+264,1);se_i2c_put(s,bus,4,3);se_i2c_put(s,bus,24,(21<<20)|(21<<14)|(4<<5)|11);se_i2c_put(s,bus,64,8);se_i2c_put(s,bus,68,8);se_i2c_put(s,bus,80,8);se_i2c_put(s,bus,84,8);se_i2c_put(s,bus,248,0x16042000);let result=se_gpio_peripheral(s,se_i2c_signal(bus,0),1,0);if result{return result;}return se_gpio_peripheral(s,se_i2c_signal(bus,1),1,0);}
fn se_i2c_tx_pop(s,bus){let p=se_i2c(s,bus);if !load64(p+136){return -1;}let head=load64(p+128);let value=load8(p+1024+head);store64(p+128,(head+1)&31);store64(p+136,load64(p+136)-1);return value;}
fn se_i2c_rx_push(s,bus,value){let p=se_i2c(s,bus);let count=load64(p+120);if count==32{se_i2c_irq_set(s,bus,4);return -28;}store8(p+1088+((load64(p+112)+count)&31),value);store64(p+120,count+1);return 0;}
fn se_i2c_tx_bit(byte,bit,lsb){let shift=7-bit;if lsb{shift=bit;}return (byte>>shift)&1;}
fn se_i2c_slave_tx(s,bus){let p=se_i2c(s,bus);let byte=se_i2c_tx_pop(s,bus);store64(p+184,0);store64(p+216,0);if byte<0{store64(p+296,1);let result=se_i2c_out(s,bus,1,1);if result{return result;}return se_i2c_out(s,bus,0,0);}store64(p+296,0);store64(p+224,byte);let result=se_i2c_out(s,bus,1,se_i2c_tx_bit(byte,0,(se_i2c_get(s,bus,4)>>6)&1));if result{return result;}return se_i2c_out(s,bus,0,1);}
fn se_i2c_slave_edge(s,bus,oldclock,olddata,clock,data){let p=se_i2c(s,bus);let ctrl=se_i2c_get(s,bus,4);if !se_i2c_running(s,bus){return 0;}
 if oldclock && clock && data!=olddata{store64(p+240,!data);if ctrl&16{return 0;}if (ctrl&3)!=3 || (se_i2c_get(s,bus,80)&8) || (se_i2c_get(s,bus,84)&8){return -95;}if !data{store64(p+240,1);store64(p+176,1);store64(p+184,0);store64(p+192,0);store64(p+200,0);store64(p+208,0);store64(p+216,0);se_i2c_irq_set(s,bus,512);return se_i2c_out(s,bus,1,1);}store64(p+240,0);if load64(p+200){se_i2c_irq_set(s,bus,128);}store64(p+176,0);store64(p+200,0);store64(p+216,0);store64(p+296,0);return se_i2c_release(s,bus);}
