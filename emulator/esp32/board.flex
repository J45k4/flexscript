fn se_deadline(s){let next=se_clock_deadline(s);let cache=se_cache_deadline(s);if cache>=0 && (next<0 || cache<next){next=cache;}let flash=se_flash_deadline(s);if flash>=0 && (next<0 || flash<next){next=flash;}let id=0;while id<4{let t=se_timer(s,id);if (load64(t)&(1<<31)) && (load64(t)&(1<<10)) && se_enabled(s,13+(id/2)*2){let distance=se_timer_distance(s,t);let divider=se_timer_divider(s,t);if distance>=0 && distance<0x1000000000000{let wait=distance*divider-load64(t+40);if wait<1{wait=1;}if next<0 || wait<next{next=wait;}}}id=id+1;}id=0;while id<3{let u=se_uart(s,id);if load64(u) && se_uart_tx_enabled(s,id){let wait=load64(u+64)-load64(s+16);if wait<1{wait=1;}if next<0 || wait<next{next=wait;}}id=id+1;}id=2;while id<=3{let p=se_spi(s,id);if load64(p) && se_spi_running(s,id){let wait=(load64(p+8)+1)/2-load64(s+16);if wait<1{wait=1;}if next<0 || wait<next{next=wait;}}id=id+1;}let i2c=se_i2c_deadline(s);if i2c>=0 && (next<0 || i2c<next){next=i2c;}let audio=se_i2s_deadline(s);if audio>=0 && (next<0 || audio<next){next=audio;}let rmt=se_rmt_deadline(s);if rmt>=0 && (next<0 || rmt<next){next=rmt;}return next;}
fn se_awake(s){return xt_irq_level(load64(s))!=0;}
