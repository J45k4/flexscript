fn se_timer_wake(s){let cpu=load64(s);if se_chip(s) || !load64(cpu+328){return 0;}let level=xt_irq_level(cpu);if !level{return 0;}let active=xt_sr(cpu,226)&xt_sr(cpu,228)&xt_irq_mask(level);return active && !(active&~0x18040);}
