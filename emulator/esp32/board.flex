import "../xtensa/cpu.flex";
import "gpio.flex";
import "spi.flex";
import "rmt.flex";
import "i2c.flex";
import "i2s.flex";
import "clock.flex";
import "cache.flex";
// Deterministic ESP32/S3 board devices around the independent Xtensa decoder.
// Virtual CPU/APB=80MHz, XTAL=40MHz; one retired instruction is one CPU tick.
// Device models never import platform drivers or compiler instruction encoders.
// Unknown MMIO fails explicitly. Partial mode coverage is documented in
// docs/esp32-emulator.md. Explicit ROM-service/flash-MMU profiles exist;
// full ROM boot,radio,cache/NOR protocol and full parity remain unfinished.
// Board allocation307200: header, IRQ matrix1024, timers2048, UARTs3072/TX phase3520,
// GPIO cfg4096/input-matrix4608/output-matrix6656/mux7168/external7680/wires8192,
// sparse configuration9024, RX12288, TX12800, three bounded TX traces16384.
fn se_chip(s){return load64(s+8);}
fn se_gpio_base(s){if se_chip(s){return 0x60004000;}return 0x3ff44000;}
fn se_timer_base(s){if se_chip(s){return 0x6001f000;}return 0x3ff5f000;}
fn se_clock_address(s){if se_chip(s){return 0x600c0018;}return 0x3ff000c0;}
fn se_reset_address(s){if se_chip(s){return 0x600c0020;}return 0x3ff000c4;}
fn se_matrix_base(s){if se_chip(s){return 0x600c2000;}return 0x3ff00104;}

fn se_timer(s,id){return s+2048+id*128;}
fn se_uart(s,id){return s+3072+id*128;}
fn se_uart_base(s,id){if se_chip(s){if id==2{return 0x6002e000;}return 0x60000000+id*65536;}if id==2{return 0x3ff6e000;}return 0x3ff40000+id*65536;}
fn se_raw(s,address,writing,value){let i=0;while i<load64(s+72){let p=s+9024+i*16;if load64(p)==address{if writing{store64(p+8,value&0xffffffff);}return load64(p+8);}i=i+1;}if !writing{return 0;}if i==128{return -12;}store64(s+9024+i*16,address);store64(s+9032+i*16,value&0xffffffff);store64(s+72,i+1);return value&0xffffffff;}
fn se_fail(s,error,address){if !load64(s+32){store64(s+32,error);store64(s+40,address);}return -1;}
fn se_enabled(s,bit){return (se_raw(s,se_clock_address(s),0,0)&(1<<bit)) && !(se_raw(s,se_reset_address(s),0,0)&(1<<bit));}
fn se_uart_clock(s,id){if !id{return 2;}if id==1{return 5;}if se_chip(s){return 9;}return 23;}
fn se_uart_reset(s,id){let u=se_uart(s,id);let history=load64(u+8);em_zero(u,128);em_zero(s+3520+id*128,128);store64(u+8,history);let cfg=0x0800001c;if se_chip(s){cfg=0x1c;se_raw(s,se_uart_base(s,id)+0x78,1,0x03701000);}store64(u+72,cfg);store64(u+80,694);let idle=0x40;if se_chip(s){idle=0x48;}se_raw(s,se_uart_base(s,id)+idle,1,0x00a40100);return 0;}

fn se_timer_reset(s,group){em_zero(se_timer(s,group*2),256);let i=0;while i<2{store64(se_timer(s,group*2+i),0x60002000);i=i+1;}store64(s+288+group*16,0);store64(s+296+group*16,0);return 0;}
fn se_create(cpu,chip){if !cpu || (chip!=0 && chip!=9){return 0;}let s=alloc(307200);if s<0{return 0;}em_zero(s,307200);store64(s,cpu);store64(s+8,chip);se_gpio_pad_decode(s);store64(s+24,load64(cpu+176));let i=0;while i<99{store64(s+1024+i*8,6);i=i+1;}i=0;while i<49{store64(s+7680+i*8,-1);store64(s+8192+i*8,-1);store64(s+6656+i*8,256);i=i+1;}while i<se_gpio_register_pins(s){store64(s+6656+i*8,256);i=i+1;}se_raw(s,se_clock_address(s),1,4);se_timer_reset(s,0);se_timer_reset(s,1);i=0;while i<3{se_uart_reset(s,i);i=i+1;}if chip{se_raw(s,se_uart_base(s,0)+0x78,1,0x03500000);}se_spi_reset(s,2);se_spi_reset(s,3);if !chip{se_rmt_reset(s);se_i2c_reset(s,0);se_i2c_reset(s,1);se_i2s_reset(s,0);se_i2s_reset(s,1);}let idle=0x40;if chip{idle=0x48;}se_raw(s,se_uart_base(s,0)+idle,1,0);if !chip{se_clock_profile(s,0);xt_cycle_profile(cpu,1);xt_timer_config(cpu,1);}return s;}
fn se_close(s){if s{se_cache_close(s);syscall(11,s,307200,0,0,0,0);}return 0;}
fn se_timer_mask(s){if se_chip(s){return 0x3fffffffffffff;}return -1;}
fn se_timer_divider(s,t){let cfg=load64(t);let d=(cfg>>13)&65535;if !d{d=65536;}else if d<2{d=2;}if se_chip(s) && (cfg&512){d=d*2;}if !se_chip(s){d=d*se_apb_factor(s);}return d;}
fn se_timer_distance(s,t){let distance=load64(t+32)-load64(t+8);if !(load64(t)&(1<<30)){distance= -distance;}return distance&se_timer_mask(s);}
fn se_timer_tick(s,id,delta){let t=se_timer(s,id);let cfg=load64(t);if !(cfg&(1<<31)) || !se_enabled(s,13+(id/2)*2){return 0;}let divider=se_timer_divider(s,t);let phase=load64(t+40)+delta;let count=phase/divider;store64(t+40,phase%divider);if !count{return 0;}let counter=load64(t+8);let distance=se_timer_distance(s,t);let hit=(cfg&(1<<10)) && distance>=0 && distance<=count;
 if hit{cfg=cfg&~(1<<10);store64(t,cfg);if se_chip(s) || (cfg&(1<<11)){let p=s+288+(id/2)*16;store64(p,load64(p)|(1<<(id&1)));}if cfg&(1<<29){counter=load64(t+24);count=count-distance;}}
 if cfg&(1<<30){counter=counter+count;}else{counter=counter-count;}store64(t+8,counter&se_timer_mask(s));return 0;}
// TX state in u: phase0 (idle),1 (frame),2 (post-transfer idle); emitted8,
// byte16, RX head/count24/32, frame-start tick40, TX head/count48/56,
// next event64, conf0/baud72/80, latched IRQ88, IRQ-enable96, frame-conf104.
// Extra128 bytes at3520+id*128: start fraction0,end floor8,end fraction16,
// bit period in1/32 ticks24. Fractional endpoints carry between queued frames.
fn se_uart_extra(s,id){return s+3520+id*128;}
fn se_uart_tx_enabled(s,id){if !se_enabled(s,se_uart_clock(s,id)){return 0;}if se_chip(s){let clock=se_raw(s,se_uart_base(s,id)+0x78,0,0);return (clock&0x01400000)==0x01400000 && !(clock&0x04800000);}return 1;}
fn se_uart_rx_enabled(s,id){if !se_enabled(s,se_uart_clock(s,id)){return 0;}if se_chip(s){let clock=se_raw(s,se_uart_base(s,id)+0x78,0,0);return (clock&0x02400000)==0x02400000 && !(clock&0x08800000);}return 1;}
fn se_uart_factor(s,id){let u=se_uart(s,id);if !se_chip(s){if load64(u+72)&(1<<27){return se_apb_factor(s);}return 80;}let clock=se_raw(s,se_uart_base(s,id)+0x78,0,0);let source=(clock>>20)&3;let ratio=0;if source==1{ratio=1;}if source==3{ratio=2;}if !ratio || (clock&4095){return -95;}return ratio*(1+((clock>>12)&255));}
fn se_uart_bit_period(s,id){let value=load64(se_uart(s,id)+80);let mask=0xfffff;if se_chip(s){mask=4095;}let divider=((value&mask)<<4)|((value>>20)&15);if !divider{return -22;}let factor=se_uart_factor(s,id);if factor<0{return factor;}return divider*factor*2;}
fn se_uart_halfbits(cfg){let stop=(cfg>>4)&3;let half=2;if stop==2{half=3;}if stop==3{half=4;}return 2*(1+5+((cfg>>2)&3)+((cfg>>1)&1))+half;}
fn se_uart_period(s,id){let bit=se_uart_bit_period(s,id);if bit<0{return bit;}return (bit*se_uart_halfbits(load64(se_uart(s,id)+72))+63)/64;}
fn se_uart_deadline(s,id,start,fraction,numerator){let u=se_uart(s,id);let x=se_uart_extra(s,id);let end=start+(fraction+numerator)/32;let rest=(fraction+numerator)%32;store64(u+40,start);store64(x,fraction);store64(x+8,end);store64(x+16,rest);store64(u+64,end+(rest!=0));return 0;}
fn se_uart_kick(s,id,start,fraction){let u=se_uart(s,id);if load64(u) || !load64(u+56) || !se_uart_tx_enabled(s,id) || (load64(u+72)&(1<<18)){return 0;}let bit=se_uart_bit_period(s,id);if bit<0{return se_fail(s,bit,se_uart_base(s,id));}let cfg=load64(u+72);let head=load64(u+48);let byte=load8(s+12800+id*128+head)&((1<<(5+((cfg>>2)&3)))-1);store64(u+16,byte);store64(u+48,(head+1)&127);store64(u+56,load64(u+56)-1);store64(u,1);store64(u+104,cfg);store64(se_uart_extra(s,id)+24,bit);return se_uart_deadline(s,id,start,fraction,bit*se_uart_halfbits(cfg)/2);}
fn se_uart_fsm(s,id){let u=se_uart(s,id);if !load64(u){return 0;}if load64(u)==2{return 13;}let x=se_uart_extra(s,id);let elapsed=(load64(s+16)-load64(u+40))*32-load64(x);let index=elapsed/load64(x+24);let cfg=load64(u+104);let data=5+((cfg>>2)&3);if index<=0{return 1;}if index<=data{return index+1;}if (cfg&2) && index==data+1{return 10;}let stop=data+1+((cfg>>1)&1);if index<=stop{return 11;}return 12;}
fn se_uart_line(s,id){let u=se_uart(s,id);let value=1;let cfg=load64(u+72);if load64(u)==1{cfg=load64(u+104);let x=se_uart_extra(s,id);let index=((load64(s+16)-load64(u+40))*32-load64(x))/load64(x+24);let data=5+((cfg>>2)&3);if !index{value=0;}else if index<=data{value=(load64(u+16)>>(index-1))&1;}else if (cfg&2) && index==data+1{let parity=cfg&1;let i=0;while i<data{parity=parity^((load64(u+16)>>i)&1);i=i+1;}value=parity;}}return value^((cfg>>22)&1);}

fn se_uart_tick(s,id,delta){let u=se_uart(s,id);let x=se_uart_extra(s,id);if !se_uart_tx_enabled(s,id){if load64(u){store64(u+40,load64(u+40)+delta);store64(u+64,load64(u+64)+delta);store64(x+8,load64(x+8)+delta);}return 0;}if !load64(u){se_uart_kick(s,id,load64(s+16),0);}while load64(u) && load64(u+64)<=load64(s+16){let floor=load64(x+8);let fraction=load64(x+16);let phase=load64(u);store64(u,0);if phase==1{let n=load64(u+8);if n>=65536{return se_fail(s,-75,se_uart_base(s,id));}store8(s+16384+id*65536+n,load64(u+16));store64(u+8,n+1);if load64(u+104)&(1<<14){se_uart_feed(s,id,u+16,1);}}
 if load64(u+56){se_uart_kick(s,id,floor,fraction);}else{let idle=0;if phase==1{let offset=0x40;if se_chip(s){offset=0x48;}idle=(se_raw(s,se_uart_base(s,id)+offset,0,0)>>10)&1023;}if idle{store64(u,2);se_uart_deadline(s,id,floor,fraction,load64(x+24)*idle);}else{store64(u+88,load64(u+88)|(1<<14));}}}return 0;}

fn se_uart_raw(s,id){let u=se_uart(s,id);let raw=load64(u+88);let conf=load64(u+112);let mask=127;let shift=8;if se_chip(s){mask=1023;shift=10;}let rx=conf&mask;if !rx{rx=1;}let tx=(conf>>shift)&mask;if load64(u+32)>=rx{raw=raw|1;}if load64(u+56)<=tx{raw=raw|2;}return raw;}
fn se_source_mask(s,source){let count=69;if se_chip(s){count=99;}if source<0 || source>=count{return 0;}let line=load64(s+1024+source*8);if line<0 || line>31{return 0;}if se_chip(s){if line==1{return 2;}return 0;}return (1<<line)&xt_irq_external();}
fn se_source(s,source,active){return active && se_source_mask(s,source)!=0;}
fn se_irqs(s){let active=0;let id=0;while id<4{let source=14+(id/2)*4+(id&1);if se_chip(s){source=50+(id/2)*3+(id&1);}let status=load64(s+288+(id/2)*16)&load64(s+296+(id/2)*16)&(1<<(id&1));if se_source(s,source,status){active=active|se_source_mask(s,source);}id=id+1;}let source=22;if se_chip(s){source=16;}if se_source(s,source,se_gpio_cpu_status(s,0,0)){active=active|se_source_mask(s,source);}id=0;while id<3{source=34+id;if se_chip(s){source=27+id;}let u=se_uart(s,id);if se_enabled(s,se_uart_clock(s,id)) && se_source(s,source,se_uart_raw(s,id)&load64(u+96)){active=active|se_source_mask(s,source);}id=id+1;}id=2;while id<=3{source=28+id;if se_chip(s){source=19+id;}if se_source(s,source,se_spi_irq(s,id)){active=active|se_source_mask(s,source);}id=id+1;}if !se_chip(s) && se_source(s,47,se_rmt_irq(s)){active=active|se_source_mask(s,47);}if !se_chip(s){id=0;while id<2{if se_source(s,49+id,se_i2c_irq(s,id)){active=active|se_source_mask(s,49+id);}if se_source(s,32+id,se_i2s_irq(s,id)){active=active|se_source_mask(s,32+id);}id=id+1;}}if !se_chip(s) && se_source(s,68,se_cache_irq(s)){active=active|se_source_mask(s,68);}xt_interrupt(load64(s),active);return active;}
fn se_advance_step(s,delta){if delta<0 || delta>0x100000000000000 || load64(s+16)>0x7fffffffffffffff-delta{return -22;}store64(s+16,load64(s+16)+delta);se_flash_tick(s);let analog=se_clock_analog_tick(s);if analog{return se_fail(s,analog,0x6000e010);}let i=0;while i<4{se_timer_tick(s,i,delta);i=i+1;}i=0;while i<3{se_uart_tick(s,i,delta);i=i+1;}let rmt=se_rmt_tick(s,delta);if rmt{return se_fail(s,rmt,0x3ff56000);}se_spi_tick(s,2,delta);se_spi_tick(s,3,delta);if !se_chip(s){let bus=0;while bus<2{let result=se_i2c_tick(s,bus,delta);if result{return se_fail(s,result,se_i2c_base(bus));}result=se_i2s_tick(s,bus,delta);if result{return se_fail(s,result,se_i2s_base(bus));}bus=bus+1;}}se_irqs(s);if load64(s+32){return load64(s+32);}return 0;}
// RMT consumes transitions produced by other devices. Interleave deadlines
// while it is active so a large advance cannot collapse multiple edges.
fn se_advance(s,delta){if delta<0 || delta>0x100000000000000 || load64(s+16)>0x7fffffffffffffff-delta{return -22;}if se_chip(s) || !(load64(s+265472)|load64(s+265480)|load64(se_i2c(s,0))|load64(se_i2c(s,1))|se_i2s_active(s)|load64(se_clock(s)+64)|se_flash_pending(s)){return se_advance_step(s,delta);}let end=load64(s+16)+delta;let once=1;while once || load64(s+16)<end{once=0;let step=end-load64(s+16);let wait=se_deadline(s);if wait>=0 && wait<step{step=wait;}let result=se_advance_step(s,step);if result{return result;}}return 0;}
fn se_sync(s){let cpu=load64(s);let retired=load64(cpu+176);let delta=retired-load64(s+24);store64(s+24,retired);return se_advance(s,se_clock_retired(s,delta));}






fn se_uart_feed(s,id,bytes,count){if id<0 || id>2 || !bytes || count<0 || count>128{return -22;}let u=se_uart(s,id);if !se_uart_rx_enabled(s,id){return -5;}if load64(u+72)&(1<<17){return 0;}if count>128-load64(u+32){store64(u+88,load64(u+88)|16);se_irqs(s);return -28;}let i=0;while i<count{let index=(load64(u+24)+load64(u+32)+i)&127;store8(s+12288+id*128+index,load8(bytes+i));i=i+1;}store64(u+32,load64(u+32)+count);se_irqs(s);return count;}
fn se_uart_bus(s,id,offset,writing,value){let u=se_uart(s,id);if !se_enabled(s,se_uart_clock(s,id)){return -5;}if offset==0{if writing{if load64(u+72)&(1<<18){return 0;}if load64(u+56)>=128{return -28;}let index=(load64(u+48)+load64(u+56))&127;store8(s+12800+id*128+index,value);store64(u+56,load64(u+56)+1);se_uart_kick(s,id,load64(s+16),0);return 0;}if !load64(u+32){return 0;}let head=load64(u+24);let byte=load8(s+12288+id*128+head);store64(u+24,(head+1)&127);store64(u+32,load64(u+32)-1);return byte;}
 if offset==4{if writing{return -13;}return se_uart_raw(s,id);}if offset==8{if writing{return -13;}return se_uart_raw(s,id)&load64(u+96);}if offset==12{if writing{if value&~16403{return -95;}store64(u+96,value);}return load64(u+96);}if offset==16{if writing{store64(u+88,load64(u+88)&~value);}return 0;}if offset==20{if writing{let mask=0x00ffffff;if se_chip(s){mask=0x00f00fff;}store64(u+80,value&mask);}return load64(u+80);}if offset==28{if writing{return -13;}let status=load64(u+32)|(load64(u+56)<<16)|(se_uart_line(s,id)<<31);if !se_chip(s){status=status|(se_uart_fsm(s,id)<<24);}return status;}
 if offset==32{if writing{if !se_chip(s) && (value&(1<<17)){return -95;}store64(u+72,value);if value&(1<<17){store64(u+24,0);store64(u+32,0);}if value&(1<<18){store64(u+48,0);store64(u+56,0);if !se_chip(s) && id==1{let other=se_uart(s,2);store64(other+48,0);store64(other+56,0);}}se_uart_kick(s,id,load64(s+16),0);}return load64(u+72);}if offset==36{if writing{store64(u+112,value);}return load64(u+112);}
 if se_chip(s) && offset==0x6c{if writing{return -13;}return se_uart_fsm(s,id)<<4;}
 let idle=0x40;if se_chip(s){idle=0x48;}if offset==idle{return se_raw(s,se_uart_base(s,id)+offset,writing,value);}
 if se_chip(s) && offset==0x78{if writing{let source=(value>>20)&3;if (source!=1 && source!=3) || (value&4095){return -95;}se_raw(s,se_uart_base(s,id)+offset,1,value);if value&0x04800000{store64(u,0);store64(u+48,0);store64(u+56,0);}if value&0x08800000{store64(u+24,0);store64(u+32,0);}se_uart_kick(s,id,load64(s+16),0);}return se_raw(s,se_uart_base(s,id)+offset,0,0);}return -95;}

fn se_timer_bus(s,group,offset,writing,value){let interrupt=0x98;if se_chip(s){interrupt=0x70;}let raw=s+288+group*16;let ena=raw+8;if offset>=interrupt && offset<=interrupt+12{let index=offset-interrupt;if !index{if writing{if value&~3{return -95;}store64(ena,value);}return load64(ena);}if index==4{if writing{return -13;}return load64(raw);}if index==8{if writing{return -13;}return load64(raw)&load64(ena);}if writing{store64(raw,load64(raw)&~value);}return 0;}
 if offset>=72{return -95;}let t=se_timer(s,group*2+offset/36);let index=offset%36;if !index{if writing{if !se_chip(s) && (value&(1<<12)){return -95;}store64(t,value&0xffffffff);}return load64(t);}if index==4 || index==8{if writing{return -13;}let value=load64(t+16);if index==8{value=value>>32;}return value&0xffffffff;}if index==12{if writing{store64(t+16,load64(t+8));}return 0;}
 let field=t+32;if index==24 || index==28{field=t+24;}if index==16 || index==20 || index==24 || index==28{let high=index==20 || index==28;if writing{let old=load64(field);if high{store64(field,((old&0xffffffff)|(value<<32))&se_timer_mask(s));}else{store64(field,((old&~0xffffffff)|value)&se_timer_mask(s));}}let result=load64(field);if high{result=result>>32;}return result&0xffffffff;}if index==32{if writing{store64(t+8,load64(t+24));store64(t+40,0);}return 0;}return -95;}
fn se_watchdog(s,address,writing,value){let rtc=0x3ff48000;let protect=0xa4;let config=0x8c;if se_chip(s){rtc=0x60008000;protect=0xb0;config=0x98;}if address==rtc+protect{return se_raw(s,address,writing,value);}if address==rtc+config{if writing && se_raw(s,rtc+protect,0,0)==0x50d83aa1{if value&(1<<31){return -95;}return se_raw(s,address,1,value);}return se_raw(s,address,0,0);}if se_chip(s) && address==rtc+0xb8{return se_raw(s,address,writing,value);}if se_chip(s) && address==rtc+0xb4{if writing && se_raw(s,rtc+0xb8,0,0)==0x8f1d312a{if !(value&(1<<31)){return -95;}return se_raw(s,address,1,value);}return se_raw(s,address,0,0);}let group=0;while group<2{let base=se_timer_base(s)+group*4096;if address==base+0x64{return se_raw(s,address,writing,value);}if address==base+0x48{if writing && se_raw(s,base+0x64,0,0)==0x50d83aa1{if value&(1<<31){return -95;}return se_raw(s,address,1,value);}return se_raw(s,address,0,0);}group=group+1;}return -95;}
