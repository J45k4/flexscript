fn se_run_slice(s,run,fuel,limit){if !s || !run{return -1;}let cpu=load64(s);if load64(s+32){return -1;}while load64(cpu+176)<limit{se_sync(s);let cache=se_cache(s);if cache && load64(cache+1632)==1{let address=load64(cache+1616);let reply=se_cache_data(s,address,load64(cache+1624),0);se_irqs(s);if reply<0{return se_fail(s,reply,address);}if reply==0x100000000{return 11;}store64(cache+1632,0);store64(run+40,reply);store64(s+216,load64(s+216)+1);}let preflight=se_cache_preflight(s);if preflight{return preflight;}if load64(s+208){if !se_awake(s){let wait=se_deadline(s);let cycles=se_cpu_deadline_cycles(s);if wait<0 && cycles<0{return 5;}let result=0;if cycles>=0 && (wait<0 || se_clock_cycle_units(s,cycles)<=wait*6){result=se_clock_idle_cycles(s,cycles);}else{result=se_clock_idle(s,wait);}if result{return -1;}store64(s+208,2);if !se_awake(s){if se_deadline(s)<0 && se_cpu_deadline_cycles(s)<0{return 5;}return 10;}}if load64(s+208)==1 && load64(cpu+488) && !se_chip(s) && load64(cpu+328){if se_clock_idle_cycles(s,3){return -1;}}if load64(s+208)==2 && se_timer_wake(s){if se_clock_idle_cycles(s,1){return -1;}}store64(cpu+488,0);store64(s+208,0);}
