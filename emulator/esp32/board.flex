fn se_uart_drain(s,id){if !s || id<0 || id>2{return -22;}let u=se_uart(s,id);let i=0;while (load64(u) || load64(u+56)) && i<260{if !se_uart_tx_enabled(s,id){return -5;}se_uart_tick(s,id,0);if load64(u){let wait=load64(u+64)-load64(s+16);if wait<0{wait=0;}let cpu=load64(s);let result=se_clock_idle(s,wait);if result{return result;}}i=i+1;}if load64(u) || load64(u+56){return -110;}return 0;}
