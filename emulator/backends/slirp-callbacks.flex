// Generated from slirp-callbacks.S; verified byte-for-byte by its test.
fn sn_helpers(code) {
    let hex="";let i=0;while load8(hex+i*2) {let a=load8(hex+i*2);let b=load8(hex+i*2+1);if a>=97 {a=a-87;}else {a=a-48;}if b>=97 {b=b-87;}else {b=b-48;}store8(code+i,a*16+b);i=i+1;}return syscall(10,code,4096,5,0,0,0)==0;
}
