#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Output {uint pixels[];};
void main() {
    uvec2 p=gl_GlobalInvocationID.xy;
    vec2 xy=(vec2(p)+0.5)/64.0*4.0-2.0;
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,scene,gl_RayFlagsOpaqueEXT,255,
                          vec3(xy,1.0),0.0,vec3(0,0,-1),10.0);
    while(rayQueryProceedEXT(ray)) {}
    bool hit=rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    pixels[p.y*64+p.x]=hit?0xff20c060u:0xff181820u;
}
