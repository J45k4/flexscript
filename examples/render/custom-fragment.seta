plugin demo.custom_fragment v1 {}
shader fragment {
    input world: vec3f location(0)
    input surface_normal: vec3f location(1)
    input shadow_position: vec4f location(2)
    output pixel: vec4f location(0)
    texture shadow_map binding(3)
    uniform tint: vec4f binding(5)
    fn main() -> void {
        let n = normalize(surface_normal)
        let light = normalize(vec3f(-3.0, 6.0, 4.0))
        let q = shadow_position.xyz * (0.5 / shadow_position.w) + vec3f(0.5)
        let depth = sample(shadow_map, q.xy).x
        let inside = q.x > 0.0 and q.x < 1.0 and q.y > 0.0 and q.y < 1.0 and q.z < 1.0
        let shadow = 1.0
        if inside and q.z - 0.003 > depth { shadow = 0.3 }
        // A caller-owned procedural material, compiled from SetaScript.
        let bands = 0.80 + 0.20 * sin((world.x + world.z) * 11.0)
        let illumination = 0.28 + max(dot(n, light), 0.0) * 0.72 * shadow
        pixel = vec4f(tint.xyz * bands * illumination, tint.w)
    }
}
